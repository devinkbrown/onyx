{
  "name": "onyx",
  "version": "0.1.3",
  "description": "Elm web client for Onyx Server with local-first history, end-to-end encrypted direct messages, and Cadence voice.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node tools/serve.mjs --build",
    "build": "bash elm/tools/build.sh && node tools/build-site.mjs",
    "preview": "node tools/serve.mjs",
    "lint": "eslint --cache",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "bash elm/tools/smokes.sh",
    "site:check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "site:workbench": "node tools/site-workbench.mjs",
    "check:server-contract": "node tools/check-server-contract.mjs ../onyx-server/docs/reference/protocol/onyx-client-contract.v1.json",
    "check:server-contract-v2": "node tools/check-server-contract-v2.mjs ../onyx-server/docs/reference/protocol/onyx-client-contract.v2.json",
    "announce": "python3 tools/announce_bot.py",
    "desktop:validate": "native validate app.zon",
    "desktop:doctor": "native doctor --manifest app.zon",
    "desktop:check": "native check",
    "desktop:build": "node tools/desktop-zig.mjs build",
    "desktop:test": "node tools/desktop-zig.mjs build test",
    "desktop:dev": "node tools/desktop-zig.mjs build dev",
    "desktop:build:null": "node tools/desktop-zig.mjs build -Dplatform=null",
    "desktop:test:null": "node tools/desktop-zig.mjs build test -Dplatform=null",
    "desktop:build:linux": "node tools/desktop-zig.mjs build -Dplatform=linux",
    "desktop:test:linux": "node tools/desktop-zig.mjs build test -Dplatform=linux",
    "desktop:build:windows": "node tools/desktop-zig.mjs build -Dplatform=windows -Dtarget=x86_64-windows",
    "desktop:package:windows": "node tools/desktop-zig.mjs build package -Dplatform=windows -Dtarget=x86_64-windows",
    "desktop:release:windows": "node tools/release-windows.mjs",
    "desktop:package:linux": "node tools/desktop-zig.mjs build package -Dplatform=linux",
    "desktop:release:linux": "node tools/release-unix.mjs linux",
    "desktop:build:freebsd": "node tools/desktop-zig.mjs build bsd-host -Dbsd-os=freebsd",
    "desktop:build:openbsd": "node tools/desktop-zig.mjs build bsd-host -Dbsd-os=openbsd",
    "desktop:test:bsd": "node tools/desktop-zig.mjs build bsd-test",
    "desktop:release:freebsd": "node tools/release-unix.mjs freebsd",
    "desktop:release:openbsd": "node tools/release-unix.mjs openbsd",
    "desktop:package:macos": "node tools/desktop-zig.mjs build package -Dplatform=macos",
    "desktop:release:macos": "node tools/release-unix.mjs macos",
    "desktop:stage-release-downloads": "node tools/stage-release-downloads.mjs",
    "desktop:stage-release-downloads:publish": "node tools/stage-release-downloads.mjs --require",
    "desktop:stage-bsd-downloads": "node tools/stage-bsd-downloads.mjs",
    "desktop:stage-bsd-downloads:publish": "node tools/stage-bsd-downloads.mjs --require"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.1.7",
    "esbuild": "^0.27.7",
    "eslint": "^9",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.7",
    "@native-sdk/cli": "0.6.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "@native-sdk/cli@0.6.2": "patches/@native-sdk__cli@0.6.2.patch"
    }
  }
}
