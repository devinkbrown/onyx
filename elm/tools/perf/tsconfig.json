{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "./playwright.config.ts",
    "./fixtures.ts",
    "./receipt.ts",
    "../../../tests/e2e/elm-performance*.ts",
    "../../../tests/e2e/elm-stress*.ts"
  ]
}
