                    , \_ -> Expect.equal "Founders" (audienceLabel (Just '!'))
                    , \_ -> Expect.equal "Owners" (audienceLabel (Just '.'))
                    , \_ -> Expect.equal "" (audienceTitle Nothing)
                    , \_ -> Expect.equal "Only visible to ops" (audienceTitle (Just '@'))
                    ]
