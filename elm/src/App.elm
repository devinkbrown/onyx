{-| Post-update call-media settle (spec §2.6, §2.13): the
dominant-speaker fold, stable tile order, pin validity, page clamp and
the quality hysteresis (with its one-shot ladder toast), all on the
call clock. Idle resets the per-call state.
-}
settleCallMedia : Model -> Model
settleCallMedia model =
    if model.calls.lifecycle == Media.Idle then
        if
            Dict.isEmpty model.callPeers
                && List.isEmpty model.callTileOrder
                && model.callQuality == CallMedia.blankQuality
                && model.callSpeaker == CallMedia.blankSpeaker
                && model.callPinned == Nothing
                && model.callShareOptOut == Nothing
                && model.callPage == 0
                && model.callStageSize == CallMedia.SizeCompact
        then
            model

        else
            { model
                | callPeers = Dict.empty
                , callTileOrder = []
                , callQuality = CallMedia.blankQuality
                , callSpeaker = CallMedia.blankSpeaker
                , callPinned = Nothing
                , callShareOptOut = Nothing
                , callPage = 0
                , callStageSize = CallMedia.SizeCompact
            }

    else
        let
            now =
                max model.nowMs model.callClockMs

            selfKey =
                String.toLower model.ourNick

            roster =
                CallUi.callRoster model.media model.calls
                    |> List.map String.toLower

            peerSet pick =
                model.callPeers
                    |> Dict.filter (\_ p -> pick p)
                    |> Dict.keys
                    |> Set.fromList

            speaking =
                Set.union model.media.speaking (peerSet .speaking)

            muted =
                Set.union model.media.muted (peerSet .muted)
                    |> (\s ->
                            if model.callSelfMuted then
                                Set.insert selfKey s

                            else
                                s
                       )

            present =
                selfKey :: List.filter ((/=) selfKey) roster

            speaker =
                CallMedia.stepSpeaker now (CallMedia.speakerSamples present speaking muted) model.callSpeaker

            order =
                CallMedia.reconcileOrder
                    { selfKey = selfKey
                    , roster = roster
                    , dominant = speaker.dominant
                    , pinned = model.callPinned
                    , speaking = speaking
                    }
                    model.callTileOrder

            pinned =
                model.callPinned
                    |> Maybe.andThen
                        (\p ->
                            if List.member p order then
                                Just p

                            else
                                Nothing
                        )

            ( quality, notice ) =
                CallMedia.advanceQuality
                    { nowMs = now, tier = model.callLocal.tier, camera = model.callLocal.camera }
                    model.callQuality

            settled =
                { model
                    | callSpeaker = speaker
                    , callTileOrder = order
                    , callPinned = pinned
                    , callPage = CallMedia.clampPage (List.length order) model.callPage
                    , callQuality = quality
                }
        in
        case notice of
            Just n ->
                let
                    copy =
                        CallMedia.noticeCopy n
                in
                addToast
                    { variant = ToastInfo
                    , title = copy.title
                    , description = Just copy.description
                    , duration = Just 4500
                    , groupKey = Just "call-quality"
                    , undo = Nothing
                    }
                    now
                    settled

            Nothing ->
                settled


-- v3/calls-c1
{-| Display casing for a lowercased call roster key: the call room's
member nick, the DM peer as reported, else the key itself.
-}
callDisplayName : Model -> String -> String
callDisplayName model key =
    let
        lower =
            String.toLower key

        fromMembers =
            model.calls.channel
                |> Maybe.andThen (\c -> Dict.get (String.toLower c) model.channels)
                |> Maybe.andThen (\ch -> Dict.get lower ch.members)
                |> Maybe.map .nick
    in
    case fromMembers of
        Just nick ->
            nick

        Nothing ->
            if String.toLower model.calls.withPeer == lower && not (String.isEmpty lower) then
                model.calls.withPeer

            else
                key


updateCore : Msg -> Model -> ( Model, List Outbound )
updateCore msg model =
    case msg of
        LinkClicked urlRequest ->
            case urlRequest of
                Browser.Internal url ->
                    -- v3/rx-public: a same-origin file (download notice,
                    -- checksum, OnyxOS source) is a document load, never
                    -- an SPA route (it would render the 404 terminus).
                    if isStaticFilePath url.path then
                        ( model, [ LoadUrl (Url.toString url) ] )

                    else
                        ( model, [ PushUrl (Url.toString url) ] )

                Browser.External href ->
                    ( model, [ LoadUrl href ] )

        UrlChanged url ->
            -- Navigation closes the public menu (mirroring the
            -- oracle's close-on-navigate), records the path for
            -- route chrome that needs it (the 404 app-miss action),
            -- syncs the roadmap priority from the fragment
            -- (mirroring the hash bridge), and re-parses the invite
            -- query (mirroring the route `card` memo): a suggested
            -- guest name seats itself, otherwise typed text survives.
            -- Entering the status route starts the feed fetch
            -- (mirroring the resource mount).
            let
                params =
                    Invite.parseQueryParams (Maybe.withDefault "" url.query)

                reseeded =
                    case ( Route.fromUrl url, Invite.parseGuestName (Dict.get "as" params) ) of
                        ( Route.Invite, Just suggested ) ->
                            suggested

                        _ ->
                            model.inviteName

                navigatedRaw =
                    { model | route = Route.fromUrl url, navMenuOpen = False, navPath = url.path, roadmapPriority = priorityFromFragment url.fragment, inviteParams = params, inviteName = reseeded, inviteNameError = Nothing, inviteCopy = CopyIdle }

                -- Leaving the appearance route unmounts the studio
                -- (mirroring the component cleanup): session vars
                -- drop and the base palette re-applies once, whatever
                -- the destination route fetches next.
                leavingStudio =
                    model.route == Route.Appearance && navigatedRaw.route /= Route.Appearance

                navigated =
                    if leavingStudio then
                        studioResetSession navigatedRaw

                    else
                        navigatedRaw

                leaveOut =
                    if leavingStudio then
                        [ appearanceApplyFor navigated ]

                    else
                        []

                -- v3/rx-public: a page change starts at the top (or at
                -- its #fragment, focused), and arriving at /app from a
                -- public page honours the invite/deep-link query.
                pageOut =
                    pageNavigationOut model url

                arrived =
                    if navigated.route == Route.App && model.route /= Route.App then
                        seedAppQuery url navigated

                    else
                        navigated
            in
            if arrived.route == Route.Appearance then
                -- Remount semantics: the staged candidate reseats on
                -- the stored background and any preview clears.
                ( { arrived | backgroundCandidate = arrived.backgroundId, backgroundPreview = Nothing }, leaveOut ++ pageOut )

            else
                let
                    ( entered, entryOut ) =
                        routeEntry url arrived
                in
                ( entered, entryOut ++ leaveOut ++ pageOut )

        -- v3/rx-public: the cold-load half of route entry (Main.init
        -- sends it once), so /download, /status and /stats share links
        -- fetch and seed on a direct visit, not only after navigation.
        RouteEntered url ->
            let
                ( entered, entryOut ) =
                    routeEntry url model

                fragmentOut =
                    case ( url.fragment, model.route ) of
                        ( _, Route.App ) ->
                            []

                        ( Just fragment, _ ) ->
                            if String.isEmpty fragment then
                                []

                            else
                                [ PageNavigated { fragment = fragment } ]

                        _ ->
                            []
            in
            ( entered, entryOut ++ fragmentOut )

        -- v3/rx-public: landing board tabs rove with the arrow keys.
        BoardTabKey { key } ->
            let
                ids =
                    [ "public-room", "bring-people", "learn" ]

                next =
                    rovingStep ids model.landingBoardTab key
            in
            if next == model.landingBoardTab then
                ( model, [] )

            else
                ( { model | landingBoardTab = next }, [ PrefsFocus { id = "board-tab-" ++ next } ] )

        WsLineReceived line ->
            foldParsed model (Wire.parseIrcMessage line)

        NodesProbed { wss, sessionToken, meshToken, meshExpiresAtMs } ->
            -- Node-probe winner (mirrors `selectBestNode` falling
            -- through to `initialNode`): connect to the winner and
            -- adopt its stored resume holdings, but only when the
            -- flag-provided holdings are empty — live tokens are
            -- never overwritten by a stale probe response.
            let
                holdings =
                    model.sessionTokens

                adopted =
                    if holdings.sessionToken == Nothing && holdings.meshToken == Nothing then
                        { sessionToken = sessionToken
                        , meshToken = meshToken
                        , meshTokenExpiresAt = meshExpiresAtMs
                        }

                    else
                        holdings
            in
            ( { model | sessionTokens = adopted }, [ WsConnect { url = wss } ] )

        WsBatchReceived batch ->
            -- The receipt stamp keeps the clock honest between Ticks
            -- (PONG latency resolves against receipt ms, not the last
            -- tick); monotonic via max so a skewed stamp never rewinds
            -- a timer.
            List.foldl
                (\line ( acc, outs ) ->
                    let
                        ( next, out ) =
                            foldParsed acc (Wire.parseIrcMessage line)
                    in
                    ( next, outs ++ out )
                )
                ( { model | nowMs = max model.nowMs (toFloat batch.at) }, [] )
                batch.lines

        WsOpened { url } ->
            case model.connection of
                Offline ->
                    -- A new socket is a new connection: the publisher
                    -- generation turns over (the account itself survives,
                    -- so re-registration republishes without waiting for a
                    -- fresh 900, mirroring the oracle).
                    let
                        nextEndpoint =
                            case learnEndpoint model.endpoint url of
                                Just ep ->
                                    ep

                                Nothing ->
                                    model.publisher.endpoint

                        pub =
                            model.publisher

                        ( nextPublisher, pubFx ) =
                            GroupPublisher.connected { pub | endpoint = nextEndpoint }
                    in
                    ( resetChannelListTransport
                        { model
                            | connection = Registering
                            -- A fresh socket consumes any countdown (its
                            -- fire redialed us here); the attempt budget
                            -- resets at 001 on success, matching the
                            -- oracle's connected assignment.
                            -- A new socket is a new LIST transport: the
                            -- old timeout/quarantine die with it.
                            , reconnectIn = 0
                            , reconnectDueMs = 0
                        , endpoint = learnEndpoint model.endpoint url
                        , publisher = nextPublisher
                        , capAvailable = []
                        , capReqPending = 0
                        , capReqNames = []
                        , capNegotiating = True
                        , nickAliasTryIdx = 0
                        , sessionCommandsSent = False
                        , connectNick = model.ourNick
                        , saslMechs = []
                        , sasl = SaslIdle
                        , saslAuthenticated = False
                        }
                    , [ SendLine (Wire.formatIrcLine "CAP" [ "LS", "302" ])
                      , SendLine (Wire.formatIrcLine "NICK" [ model.ourNick ])
                      , SendLine (Wire.formatIrcLine "USER" [ "webchat", "0", "*", model.ourNick ++ " (webchat)" ])
                      ]
                        ++ runPublisherEffects pubFx
                    )

                _ ->
                    ( model, [] )

        WsClosed close ->
            -- A close strands every in-flight label (no echo/ACK/FAIL
            -- can still arrive), so confirm those rows in place and
            -- drop the registry — mirroring `_clearPendingLabeledSends`.
            -- Tracked echo-batch refs die with the connection too.
            -- Open history batches die with it as well (mirroring the
            -- reconnect collector clear), and a pending server search
            -- errors instead of sticking: its batch will never arrive.
            -- The close itself records like the oracle `onClose`: a
            -- `Disconnected: <reason>` system inbox row plus the same
            -- line in the service log.
            let
                cleared =
                    { model
                        | connection = Offline
                        -- The socket died, so any pending identify reply
                        -- dies with it: a 464 arriving on the next socket
                        -- belongs to no live attempt. A reclaim dialog is
                        -- moot without its socket too. A claim sheet is
                        -- likewise moot: its reply contexts die and
                        -- captured credentials are forgotten.
                        , identifyReplyAccount = Nothing
                        , registerReplyAccount = Nothing
                        , verifyReplyAccount = Nothing
                        , totpReplyAccount = Nothing
                        , keytransReplyAccount = Nothing
                        , certReplyAccount = Nothing
                        , vhostReplyAccount = Nothing
                        , accountInfoReplyAccount = Nothing
                        , motdCollecting = False
                        , motdBuffer = ""
                        , registerPending = False
                        , reclaimOpen = False
                        , reclaimPassword = ""
                        , nickReclaimTarget = Nothing
                        , pendingUnban = Nothing
                        , publisher = GroupPublisher.disconnected model.publisher
                        -- The socket died: attribution timers and
                        -- in-flight signing belong to the old
                        -- connection (mirroring the oracle `stop`;
                        -- the epoch floor survives for the next one).
                        , attribution = Attribution.resetSession model.attribution
                        , capNegotiating = False
                        , capReqPending = 0
                        , capReqNames = []
                        , sasl = SaslIdle
                        , saslAuthenticated = False
                        , ownEchoBatches = Set.empty
                        , historyBatches = Dict.empty
                        , serverSearchPending = Nothing
                        , staleServerSearches = Dict.empty
                        , historyTargetsPending = False
                        , historyTargetsBatchRef = Nothing
                        , historyTargetsStartedAt = Nothing
                        , historyLoading = Set.empty
                        , pendingDiscoveries = Dict.empty
                        , pendingPins = Dict.empty
                        , pendingTravel = Nothing
                        , historyMerging = False
                        , serverSearchStatus =
                            if model.serverSearchStatus == ServerSearchPending then
                                ServerSearchError

                            else
                                model.serverSearchStatus
                        , serverSearchError =
                            if model.serverSearchStatus == ServerSearchPending then
                                Just "No response from the server. Late results will be discarded."

                            else
                                model.serverSearchError
                    }

                down =
                    promoteAllLabeled (clearBanTransport cleared)

                -- A disconnect strands every in-flight labeled
                -- scheduled send: its verdict can never arrive, so the
                -- rows keep their durable claims (never auto-replayed,
                -- like the oracle's uncertain claims) and one
                -- uncertainty toast names the outcome.
                unlabeled =
                    { down | scheduledLabels = Dict.empty }

                uncertainCount =
                    Dict.size down.scheduledLabels

                unmarked =
                    if uncertainCount == 0 then
                        unlabeled

                    else
                        addToast (scheduledUncertainToast uncertainCount) unlabeled.nowMs unlabeled

                scheduled =
                    scheduleReconnect unmarked

                noticed =
                    addNotification (logService scheduled ("Disconnected: " ++ close.reason))
                        { kind = NotifSystem
                        , text = "Disconnected: " ++ close.reason
                        , from = Nothing
                        , channel = Nothing
                        , topic = Nothing
                        }
            in
            ( resetGuestClaim noticed, [] )

        VaultRowsReceived { target, rows, status } ->
            -- The open media panel claims its target's rows (dropping
            -- owner-stale responses unpainted); normal hydration still
            -- runs.
            let
                claimed =
                    if model.mediaIndexOpen && String.toLower target == model.mediaIndexTarget then
                        if mediaOwnerKey model == model.mediaIndexOwner then
                            { model
                                | mediaIndexVault = rows
                                , mediaIndexVaultState =
                                    if status == "ok" then
                                        MediaVaultReady

                                    else
                                        MediaVaultFailed
                            }

                        else
                            { model | mediaIndexVault = [], mediaIndexVaultState = MediaVaultFailed }

                    else
                        model
            in
            if status /= "ok" then
                case Dict.get (String.toLower target) claimed.channels of
                    Just channel ->
                        if List.isEmpty channel.messages then
                            ( logService (rememberVaultIds claimed rows) "Local history is unavailable on this device.", [] )

                        else
                            ( rememberVaultIds claimed rows, [] )

                    Nothing ->
                        ( rememberVaultIds claimed rows, [] )

            else
                ( rememberVaultIds (mergeVaultRows claimed target rows) rows, [] )

        VaultRowsAroundReceived { target, at, rows, status } ->
            if status /= "ok" then
                ( logService model "Local history is unavailable on this device.", [] )

            else
                ( mergeVaultAround model target at rows, [] )

        VaultSearched { rows, status, seq, mode } ->
            -- A newer query or a close supersedes this response (mirrors
            -- the `vaultSeq`/abort guard); a missing database resolves
            -- empty-done like the oracle, anything else errors. The
            -- echoed mode labels the resolved batch even when the user
            -- retoggled mid-flight.
            if seq /= model.vaultSearchSeq then
                ( model, [] )

            else if status == "ok" then
                ( { model | vaultRawHits = List.filterMap (vaultHitFromRow model model.vaultSearchQuery) rows, vaultStatus = VaultSearchDone, vaultSearchModeShown = parseVaultSearchMode mode }, [] )

            else if status == "unavailable" then
                ( { model | vaultRawHits = [], vaultStatus = VaultSearchDone, vaultSearchModeShown = parseVaultSearchMode mode }, [] )

            else
                ( { model | vaultRawHits = [], vaultStatus = VaultSearchError, vaultSearchModeShown = parseVaultSearchMode mode }, [] )

        VaultDmPrivacyClassified { target, privacy } ->
            -- A host proof scan settled (mirroring the async
            -- `classifyVaultDmSearchPrivacy` commit: plain unblocks the
            -- next retry, encrypted designates the DM, unknown keeps
            -- withholding until the user retries).
            ( foldVaultDmPrivacy model target privacy, [] )

        VaultOpenHit { target, at } ->
            -- Navigate to the hit's conversation and hydrate around its
            -- stamp (mirrors `openVaultResult`: navigate + travelTo +
            -- close; the travel merge sets `historyLanding`). The panel
            -- closes, invalidating any scheduled scan.
            let
                ( navigated, navOut ) =
                    update (ChannelSelect target) (invalidateVaultSearch { model | searchOpen = False })
            in
            ( navigated, navOut ++ [ VaultFetchAround { target = String.toLower target, at = at, limit = keepMessages } ] )

        VaultExported { targets, messages } ->
            ( logService
                -- v3/prefs — the Preferences sheet echoes the export result.
                { model
                    | prefsTransferStatus =
                        Just ("Exported " ++ PrefsPanel.countLabel messages "message" ++ " from " ++ PrefsPanel.countLabel targets "conversation" ++ ".")
                }
                ("Vault exported (" ++ String.fromInt messages ++ " messages, " ++ String.fromInt targets ++ " targets).")
            , []
            )

        VaultStored _ ->
            ( model, [] )

        VaultImportFile { json } ->
            -- A picked export file lands as text: validate it as a
            -- vault snapshot and merge the projected rows through the
            -- normal persist path (whose trim already applies the
            -- destination retention policy, matching the oracle's
            -- import-obeys-policy order). Storage itself stays async
            -- behind `vaultPut`, so the notice reports validated rows
            -- handed to the store, not confirmed commits.
            if String.isEmpty (String.trim json) then
                ( model, [] )

            else
                case Decode.decodeString Decode.value json of
                    Err _ ->
                        ( logService model "Vault import file could not be read as JSON.", [] )

                    Ok value ->
                        case VaultImport.parseVaultExport value of
                            Nothing ->
                                ( logService model "Vault import file held no valid vault snapshot.", [] )

                            Just snap ->
                                -- v3/gap-import: validated rows are staged for
                                -- review (V47) instead of merging at once; the
                                -- confirm writes through `historyImportPersist`.
                                case HistoryImport.fromVaultSnapshot 0 snap of
                                    Nothing ->
                                        ( logService model "Vault import file held no importable messages.", [] )

                                    Just staged ->
                                        let
                                            ( opened, openOut ) =
                                                historyImportShowTransfer model

                                            ( reviewed, reviewOut ) =
                                                historyImportUpdate (HistoryImport.GotSnapshot staged) opened
                                        in
                                        ( logService reviewed
                                            ("Vault import file staged for review ("
                                                ++ String.fromInt (List.sum (List.map .count staged.conversations))
                                                ++ " messages, "
                                                ++ String.fromInt (List.length staged.conversations)
                                                ++ " conversations)."
                                            )
                                        , openOut ++ reviewOut
                                        )

        OutboxQueued entry ->
            if List.any (\row -> row.id == entry.id) model.outbox then
                ( model, [] )

            else
                let
                    placeholder =
                        { id = model.messageSeq
                        , from = model.ourNick
                        , body = entry.text
                        , whisper = False
                        , audience = Nothing
                        , highlight = False
                        , plaintext = Nothing
                        , outboxId = Just entry.id
                        , pending = False
                        , at = floor model.nowMs
                        , msgid = Nothing
                        , reactions = []
                        , edited = False
                        , deleted = False
                        , redacted = False
                        , topic = ""
                        , msgType = "msg"
                        , replyTo = Nothing
                        }

                    withRow =
                        updateChannel model entry.target
                            (\c ->
                                { c
                                    | messages =
                                        List.take keepMessages (placeholder :: c.messages)
                                }
                            )
                in
                -- The commit clears the visible draft when it still
                -- shows the queued text, and drops the stored
                -- per-target draft whenever it still holds the queued
                -- text (a room switch in between must not resurrect
                -- it; newer typing in either place is kept).
                ( { withRow
                    | messageSeq = withRow.messageSeq + 1
                    , outbox = { id = entry.id, target = entry.target, text = entry.text, queuedAt = entry.queuedAt } :: withRow.outbox
                    , composerDrafts =
                        if Dict.get (String.toLower entry.target) withRow.composerDrafts == Just entry.text then
                            Dict.remove (String.toLower entry.target) withRow.composerDrafts

                        else
                            withRow.composerDrafts
                    , composer =
                        if withRow.composer == entry.text then
                            ""

                        else
                            withRow.composer
                  }
                , []
                )

        OutboxQueueFailed { target } ->
            -- Mirrors the oracle's "could not be queued" toast: the
            -- draft is kept, nothing is stored, nothing is sent (the
            -- service-log line stays alongside the toast).
            ( addToast
                { variant = ToastError
                , title = "Offline"
                , description = Just "Message could not be queued on this device."
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                (logService model ("Message to " ++ target ++ " could not be queued on this device."))
            , []
            )

        OutboxFlushed { sent, uncertain, dropped, rows, sentLabels, waiting, pruneFailed, expiredPruneFailed, admittedPruneFailed, walkOk } ->
            let
                -- Only well-formed reported labels correlate; anything
                -- else falls back to the unlinked paths below.
                validLabels =
                    List.filter (\pair -> Labels.isValidLabel pair.label) sentLabels

                labeledIds =
                    List.map .id validLabels

                -- Labeled sent rows stay: their placeholders render
                -- pending until the server's echo, ACK, or FAIL
                -- resolves them (mirroring the oracle, which keeps the
                -- `outbox:<id>` UI row until the labeled reply).
                gone =
                    List.filter (\id -> not (List.member id labeledIds)) sent ++ dropped

                dropPlaceholder message =
                    case message.outboxId of
                        Just oid ->
                            not (List.member oid gone)

                        Nothing ->
                            True

                settled =
                    { model
                        | channels = Dict.map (\_ c -> { c | messages = List.filter dropPlaceholder c.messages }) model.channels
                        , outbox = rows
                        , outboxUncertain = uncertain
                    }

                correlated =
                    registerFlushedLabels settled validLabels

                -- Terminal classification is pure: a mid-flush
                -- connection drop defers (keeps durable rows, no
                -- false deliveryFailed) rather than burning
                -- auto-retry budget; reconnect 001 re-arms.
                terminal =
                    Outbox.decideFlushTerminal
                        { waiting = toFloat waiting
                        , pruneFailed = toFloat pruneFailed
                        , retriesUsed = toFloat model.outboxRetries
                        , maxAutoRetries = Nothing
                        , retryDelayMs = Nothing
                        , connected = model.connection == Live
                        }

                -- Flush outcome toasts mirror the oracle drain
                -- summaries (a broken walk reports empty counts, so
                -- nothing fires there).
                announced =
                    announceFlushOutcome correlated
                        { sent = List.length sent
                        , dropped = List.length dropped
                        , uncertain = List.length uncertain
                        , expiredPruneFailed = expiredPruneFailed
                        , admittedPruneFailed = admittedPruneFailed
                        }
            in
            case ( walkOk, terminal ) of
                ( False, _ ) ->
                    -- The walk itself broke before reading a row
                    -- (transaction/cursor/IDB error): never
                    -- masquerade as a clean empty — mark delivery
                    -- failed loudly, mirroring the oracle's flush
                    -- catch. The budget is untouched. The toast fires
                    -- only on the transition into failed, like the
                    -- oracle's `if (!outboxDeliveryFailed)` guard.
                    let
                        failed =
                            { announced | outboxFailed = True }

                        withToast =
                            if model.outboxFailed then
                                failed

                            else
                                addToast
                                    { variant = ToastWarning
                                    , title = "Queued messages still waiting"
                                    , description = Just "Could not finish sending from this device. Retry from Home or the composer."
                                    , duration = Nothing
                                    , groupKey = Nothing
                                    , undo = Nothing
                                    }
                                    failed.nowMs
                                    failed
                    in
                    ( logService withToast
                        "Queued messages still waiting — Could not finish sending from this device. Retry from Home or the composer."
                    , []
                    )

                ( True, Outbox.ClearFailed ) ->
                    ( { announced | outboxFailed = False }, [] )

                ( True, Outbox.Defer ) ->
                    ( announced, [] )

                ( True, Outbox.ScheduleRetry { nextRetries, delayMs } ) ->
                    ( { announced | outboxRetries = nextRetries, outboxFailed = False }
                    , [ OutboxRetryTimer { delayMs = delayMs } ]
                    )

                ( True, Outbox.MarkFailed { deliveryWaiting } ) ->
                    let
                        failed =
                            { announced | outboxFailed = True }

                        -- The still-waiting toast mirrors the oracle's
                        -- mark-failed arm (warning, exact singular/plural
                        -- copy) and fires only on the transition into
                        -- failed — prune-failure rows already got their
                        -- honest storage toast above, so only
                        -- never-on-the-wire rows toast here.
                        withToast =
                            if model.outboxFailed || deliveryWaiting <= 0 then
                                failed

                            else
                                addToast
                                    { variant = ToastWarning
                                    , title =
                                        if deliveryWaiting == 1 then
                                            "Queued message still waiting"

                                        else
                                            String.fromInt deliveryWaiting ++ " queued messages still waiting"
                                    , description = Just "Could not send yet. Open Home or retry from the composer."
                                    , duration = Nothing
                                    , groupKey = Nothing
                                    , undo = Nothing
                                    }
                                    failed.nowMs
                                    failed
                    in
                    if deliveryWaiting > 0 then
                        ( logService withToast
                            (if deliveryWaiting == 1 then
                                "Queued message still waiting — Could not send yet. Open Home or retry from the composer."

                             else
                                String.fromInt deliveryWaiting ++ " queued messages still waiting — Could not send yet. Open Home or retry from the composer."
                            )
                        , []
                        )

                    else
                        ( withToast, [] )

        OutboxFlushRequest ->
            ( model, [ flushRequest model ] )

        OutboxRetryFired ->
            -- Ports-side auto-retry timer fired: walk the durable
            -- queue again. Offline the flush reports back waiting and
            -- the terminal fold defers without burning budget.
            ( model, [ flushRequest model ] )

        ScheduleMessage input ->
            requestScheduleMessage model input

        CancelScheduledMessage { id } ->
            requestCancelScheduledMessage model id

        ScheduledFenceResult result ->
            foldScheduledFenceResult model result

        ScheduledAddResult result ->
            foldScheduledAddResult model result

        ScheduledDispatchResult result ->
            foldScheduledDispatchResult model result

        ScheduledCancelResult result ->
            foldScheduledCancelResult model result

        ScheduledPersisted { ok } ->
            ( { model | scheduledProjectionDegraded = not ok }, [] )

        SetShowScheduledMessages visible ->
            ( { model | showScheduledMessages = visible }, [] )

        SetAccountOpen True ->
            openAccountPanel model

        SetAccountOpen False ->
            ( { model | accountOpen = False }, [] )

        ScheduleOpen ->
            openSchedulePopover model

        ScheduleClose ->
            ( { model | scheduleOpen = False, scheduleError = Nothing }, [] )

        ScheduleViewQueue ->
            -- Mirroring the popover's queue button: the popover closes
            -- (keeping the custom field for next open) and the sheet
            -- opens on the owned queue.
            ( { model | scheduleOpen = False, scheduleError = Nothing, showScheduledMessages = True }, [] )

        ScheduleWhenInput value ->
            ( { model | scheduleWhen = value, scheduleError = Nothing }, [] )

        SchedulePresetClicked { id } ->
            case List.filter (\preset -> preset.id == id) Schedule.schedulePresets of
                [ preset ] ->
                    case schedulePresetEpoch model preset of
                        Just epoch ->
                            if Schedule.isSchedulable epoch (floor model.nowMs) then
                                submitScheduleAt model epoch

                            else
                                ( { model | scheduleError = Just "Pick a time at least a minute from now." }, [] )

                        Nothing ->
                            -- The clock answer has not landed yet; the
                            -- composer greys this preset out, so reaching
                            -- here refuses silently.
                            ( model, [] )

                _ ->
                    ( model, [] )

        ScheduleCustomSubmit ->
            ( model, [ ScheduleParseRequest { value = model.scheduleWhen } ] )

        ScheduleClockReceived result ->
            ( { model
                | schedulePresetEpochs = Dict.insert "tomorrow-9" result.tomorrow9 model.schedulePresetEpochs
                , scheduleMinLocal = result.minLocal
              }
            , []
            )

        ScheduleParseReceived result ->
            if result.value /= model.scheduleWhen then
                -- Typed on while the bridge parsed: the answer belongs
                -- to a stale field value, so it is dropped.
                ( model, [] )

            else
                case result.epoch of
                    Just epoch ->
                        if Schedule.isSchedulable epoch (floor model.nowMs) then
                            submitScheduleAt model epoch

                        else
                            -- The oracle's parser folds an out-of-window
                            -- instant into the same null as garbage, so a
                            -- parseable-but-near instant reads the custom
                            -- copy, never the preset copy.
                            ( { model | scheduleError = Just "Enter a valid time at least a minute from now." }, [] )

                    Nothing ->
                        ( { model | scheduleError = Just "Enter a valid time at least a minute from now." }, [] )

        PingDue ->
            -- Ports-side 25s idle timer fired (and armed the 15s pong
            -- timeout in the same tick): send the keepalive probe.
            ( model, [ SendLine (Wire.formatIrcLine "PING" [ "keepalive" ]) ] )

        Tick posix ->
            -- The status page polls every 30s (mirroring the route
            -- interval); a missing sample on the route fetches too,
            -- covering a direct boot onto `/status`. The debounced
            -- vault scan also fires here (1s Tick cadence, so the
            -- 200ms debounce resolves on the first tick past due).
            let
                -- The LIST watchdog resolves on this cadence (the 1s
                -- Tick stands in for the oracle's 15s timer).
                watched =
                    fireChannelListTimeout (toFloat (Time.posixToMillis posix)) model

                joinWatched =
                    fireBrowserJoinTimeout (toFloat (Time.posixToMillis posix)) model

                createWatched =
                    firePendingCreateRoomTimeout (toFloat (Time.posixToMillis posix)) model

                ticked =
                    { model
                        | nowMs = toFloat (Time.posixToMillis posix)
                        -- Expired typists fall off on the 1s cadence
                        -- (the oracle rebuild-prunes on every typing
                        -- event; the Tick covers quiet rooms).
                        , typingUsers = pruneTypingUsers model.typingUsers (toFloat (Time.posixToMillis posix))
                        -- Expired NAMES bursts (lost 366s) fall off
                        -- here; live lookups TTL-check either way.
                        , namesBursts = pruneNamesBursts (toFloat (Time.posixToMillis posix)) model.namesBursts
                        -- Toast auto-dismiss resolves here (the 1s Tick
                        -- stands in for the renderer's per-toast
                        -- `setTimeout`; `Just 0` stays sticky).
                        , toasts =
                            .toasts (expireToasts (toFloat (Time.posixToMillis posix)) model)
                        , channelList = watched.channelList
                        , channelListLoading = watched.channelListLoading
                        , channelListRequest = watched.channelListRequest
                        , channelListGen = watched.channelListGen
                        , channelListQuarantined = watched.channelListQuarantined
                        , channelListCommitted = watched.channelListCommitted
                        -- A silent join flips pending to uncertain on
                        -- the 1s Tick (the oracle's 8s timer).
                        , browserPendingJoin = joinWatched.browserPendingJoin
                        , browserJoinPhase = joinWatched.browserJoinPhase
                        -- An unanswered room creation disarms on the 1s
                        -- Tick (the oracle's 15s timer).
                        , pendingCreateRoom = createWatched.pendingCreateRoom
                    }

                ( polled, pollOut ) =
                    if ticked.nowMs - ticked.lastRosterPollMs >= rosterPollMs then
                        pollChannelRosters ticked

                    else
                        ( ticked, [] )

                ( reclaimed, reclaimOut ) =
                    fireNickReclaim polled

                ( redialed, redialOut ) =
                    fireReconnect reclaimed

                ( searched, vaultOut ) =
                    vaultSearchFire redialed

                ( pinged, pingOut ) =
                    fireLatencyPing searched

                ( dispatched, dispatchOut ) =
                    fireScheduledDispatch pinged
                        |> withScheduledDmLookups

                -- A lapsed residence proof re-signs on the 1s Tick
                -- (standing in for the oracle's refresh timer).
                ( attributed, attrOut ) =
                    fireAttribution (\session -> Attribution.tickRefresh session dispatched.nowMs) dispatched

                searchOut =
                    vaultOut ++ pollOut ++ reclaimOut ++ redialOut ++ pingOut ++ dispatchOut ++ attrOut

                timed =
                    expireServerSearch attributed

                stale =
                    case timed.statusFetchedAt of
                        Nothing ->
                            True

                        Just fetchedAt ->
                            timed.nowMs - fetchedAt >= 30000
            in
            if timed.route == Route.Status && not timed.statusLoading && stale then
                let
                    ( statused, statusOut ) =
                        requestStatus timed
                in
                ( statused, searchOut ++ statusOut )

            else
                let
                    reverted =
                        { timed
                            | downloadCopies = downloadCopiesReverted ticked
                            , studioExportCopied = studioCopyKept ticked ticked.studioExportRevertAt ticked.studioExportCopied
                            , studioSeedCopied = studioCopyKept ticked ticked.studioSeedRevertAt ticked.studioSeedCopied
                            , studioShareCopied = studioCopyKept ticked ticked.studioShareRevertAt ticked.studioShareCopied
                            , studioExportRevertAt = studioRevertKept ticked ticked.studioExportRevertAt
                            , studioSeedRevertAt = studioRevertKept ticked ticked.studioSeedRevertAt
                            , studioShareRevertAt = studioRevertKept ticked ticked.studioShareRevertAt
                        }

                    statsStale =
                        case reverted.statsFetchedAt of
                            Nothing ->
                                True

                            Just fetchedAt ->
                                reverted.nowMs - fetchedAt >= 30000
                in
                if reverted.route == Route.Stats && not reverted.statsLoading && statsStale then
                    let
                        ( withIndex, indexOut ) =
                            requestStatsIndex False reverted
                    in
                    if String.isEmpty withIndex.statsDetailRequested then
                        ( withIndex, searchOut ++ indexOut )

                    else
                        let
                            ( withDetail, detailOut ) =
                                requestStatsDetailFor withIndex withIndex.statsDetailRequested
                        in
                        ( withDetail, searchOut ++ indexOut ++ detailOut )

                else
                    ( reverted, searchOut )

        ConnectModeSet mode ->
            if mode == model.connectForm.mode || connectPhase model == ConnectConnecting then
                ( model, [] )

            else
                ( setConnectForm
                    (\f ->
                        { f
                            | mode = mode
                            , recoveryOpen = False
                            , nickError = Nothing
                            , passwordError = Nothing
                            , emailError = Nothing
                            , confirmError = Nothing
                            , roomError = Nothing
                        }
                    )
                    model
                , []
                )

        ConnectNickInput value ->
            ( setConnectForm (\f -> { f | nick = String.left 64 value, nickError = Nothing }) model, [] )

        ConnectPasswordInput value ->
            ( setConnectForm (\f -> { f | password = value, passwordError = Nothing }) model, [] )

        ConnectEmailInput value ->
            ( setConnectForm (\f -> { f | email = String.left 254 value, emailError = Nothing }) model, [] )

        ConnectConfirmInput value ->
            ( setConnectForm (\f -> { f | confirm = value, confirmError = Nothing }) model, [] )

        ConnectRoomInput value ->
            ( setConnectForm (\f -> { f | room = String.left 64 value, roomError = Nothing }) model, [] )

        ConnectRecoveryToggle ->
            ( setConnectForm (\f -> { f | recoveryOpen = not f.recoveryOpen, recoveryCode = "", passwordError = Nothing }) model, [] )

        ConnectRecoveryCodeInput value ->
            ( setConnectForm (\f -> { f | recoveryCode = String.left 64 value, passwordError = Nothing }) model, [] )

        ConnectSubmit ->
            submitConnect model

        -- v3/rx-public
        RememberedListed value ->
            rememberedListed (Remembered.decodeListing value) model

        RememberedReady ready ->
            rememberedReady ready model

        RememberedSelect id ->
            rememberedSelect id model

        RememberedAct ->
            rememberedAct model

        RememberedForget id ->
            rememberedForget id model

        RememberedDismiss ->
            ( mapRemembered (\r -> { r | dismissed = True }) model, [] )

        ConnectStaySignedIn on ->
            ( mapRemembered (\r -> { r | stay = on }) model, [] )

        ConnectSignInAs ->
            -- "Sign in as X" after a guest join hit an account's name
            -- (or a name in use): the same name, a fresh sign-in door,
            -- focus on the password. Signing in reclaims the name (the
            -- post-900 NICK reclaim takes it back from a ghost alias).
            if connectPhase model == ConnectConnecting then
                ( model, [] )

            else
                ( setConnectForm
                    (\f ->
                        { f
                            | mode = ConnectSignIn
                            , attempted = False
                            , password = ""
                            , recoveryOpen = False
                            , nickError = Nothing
                            , passwordError = Nothing
                            , roomError = Nothing
                        }
                    )
                    model
                , [ PrefsFocus { id = "conn-password" } ]
                )

        ConnectCancel ->
            -- Abandon a dial in flight: the socket (if any) closes and the
            -- form returns to idle rather than reporting a failure.
            ( { model | autoReconnect = False }
                |> setConnectForm (\f -> { f | dialing = False, attempted = False, pendingRegister = Nothing })
            , [ WsDisconnect ]
            )

        -- v3/dm-key-hold
        DmSendUnencrypted peer ->
            -- Explicit, per-peer consent to send without encryption
            -- while the key lookup is unanswered; the held draft sends.
            updateCore ComposerSend
                { model
                    | dmPlainConfirmed = Set.insert (String.toLower peer) model.dmPlainConfirmed
                    , dmKeyHold = Nothing
                    , composerError = Nothing
                }

        SessionDisconnect ->
            -- Deliberate disconnect, mirroring the oracle `disconnect`
            -- behind the shell's Leave control: auto-reconnect disarms so
            -- the close returns to the connect form instead of the
            -- reconnect banner.
            ( { model | autoReconnect = False, connectGate = True, reconnectIn = 0, reconnectDueMs = 0 }
                |> setConnectForm (\f -> { f | dialing = False, attempted = False, pendingRegister = Nothing })
            , [ WsDisconnect ]
            )

        SaslCredentialsProvided { account, password, hasClientCert } ->
            -- A sign-in form hands the secret to the ports side, which
            -- holds it for the exchange; the model keeps only the
            -- account plus the fact that a credential exists. The
            -- password value itself never rests in Elm state.
            ( { model
                | saslAccount = Just account
                , saslPasswordHeld = not (String.isEmpty password)
                , saslClientCert = hasClientCert
              }
            , [ SaslCredentialsStored { account = account, password = password, hasClientCert = hasClientCert } ]
            )

        SaslPayload { payload } ->
            -- Ports-side crypto answered a challenge: chunk the blob
            -- into 400-byte `AUTHENTICATE` lines. A payload arriving
            -- with no exchange in flight is dropped, never sent.
            case model.sasl of
                SaslIdle ->
                    ( model, [] )

                SaslPending _ ->
                    ( model
                    , List.map
                        (\chunk -> SendLine (Wire.formatIrcLine "AUTHENTICATE" [ chunk ]))
                        (Wire.chunkSaslPayload payload)
                    )

        SaslFailed { reason } ->
            failSasl model
                (if String.isEmpty (String.trim reason) then
                    "SASL authentication failed"

                 else
                    reason
                )

        SaslTimeout ->
            failSasl model "SASL authentication timed out"

        SearchRowsReceived { rows, status } ->
            -- Ports-side list answer: replace the visible list with
            -- strictly decoded rows. Anything the boundary rejects
            -- never reaches the list; an unavailable store keeps the
            -- last known rows.
            if status /= "ok" then
                ( model, [] )

            else
                ( { model | savedSearches = List.filterMap (\raw -> SavedSearches.decodeSavedSearch raw model.nowMs) rows }
                , []
                )

        SearchSavedReceived { search } ->
            -- Ports-side save answer: upsert the verified row by id
            -- (ports-side upsert-by-label reuses the id). A failed
            -- save arrives null and changes nothing.
            case SavedSearches.decodeSavedSearch search model.nowMs of
                Nothing ->
                    ( model, [] )

                Just row ->
                    ( { model
                        | savedSearches =
                            row
                                :: List.filter (\existing -> existing.id /= row.id) model.savedSearches
                      }
                    , []
                    )

        SearchDeletedReceived { id, deleted } ->
            if deleted then
                ( { model | savedSearches = List.filter (\row -> row.id /= id) model.savedSearches }
                , []
                )

            else
                ( model, [] )

        SearchClearedReceived { cleared } ->
            if cleared then
                ( { model | savedSearches = [] }, [] )

            else
                ( model, [] )

        SearchExportedReceived { json } ->
