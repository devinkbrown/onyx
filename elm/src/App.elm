{-| Oracle `MAX_MOTD_TEXT_LENGTH` (64 KiB): MOTD buffer bound. -}
maxMotdTextLength : Int
maxMotdTextLength =
    64 * 1024


{- Append one MOTD line to the buffer (mirrors `_appendMotdLine`:
per-line system-event bound, 64 KiB buffer cap with surrogate-safe
truncation, `\n`-joined; a line that contributes nothing leaves the
buffer alone).
-}
appendMotdLine : String -> String -> String
appendMotdLine buffer value =
    let
        line =
            boundSystemEventText value
    in
    if String.isEmpty line || String.length buffer >= maxMotdTextLength then
        buffer

    else
        let
            separator =
                if String.isEmpty buffer then
                    ""

                else
                    "\n"

            remaining =
                maxMotdTextLength - String.length buffer - String.length separator
        in
        if remaining <= 0 then
            buffer

        else
            let
                bounded =
                    dropTrailingHighSurrogate (String.slice 0 remaining line)
            in
            if String.isEmpty bounded then
                buffer

            else
                buffer ++ separator ++ bounded


{- `375 RPL_MOTDSTART` (mirrors the oracle: a new MOTD epilogue
resets the buffer and opens collection).
-}
startMotd : Model -> Model
startMotd model =
    { model | motdBuffer = "", motdCollecting = True }


{- `372 RPL_MOTD` with the line body (mirrors the oracle: ignored
outside collection; otherwise the line appends to the buffer and is
mirrored into the service log so it stays browsable).
-}
appendMotd : Model -> String -> Model
appendMotd model line =
    if not model.motdCollecting then
        model

    else
        logService
            { model | motdBuffer = appendMotdLine model.motdBuffer line }
            (boundSystemEventText line)


{- `376 RPL_ENDOFMOTD` (mirrors the oracle: a stray end only clears
the buffer; otherwise collection closes and the buffer commits to
`motd`, opening the flag exactly when the buffer is non-empty — the
oracle's `!suppress && buffer` with a suppress key no client path
ever writes, so the read side is a constant false and no ports
round-trip is owed).
-}
finishMotd : Model -> Model
finishMotd model =
    if not model.motdCollecting then
        { model | motdBuffer = "" }

    else if String.isEmpty model.motdBuffer then
        { model | motdCollecting = False, motd = Just model.motdBuffer }

    else
        { model | motdCollecting = False, motd = Just model.motdBuffer, showMotd = True }


{-| Dismiss the MOTD flag (mirrors `closeMotd`; the buffer stays for
the session).
-}
closeMotd : Model -> Model
closeMotd model =
    { model | showMotd = False }


{-| Pure fold: one parsed line in, new model plus outbound lines out.
`update` sends the outbound lines through `wsSend`.
-}
foldLine : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldLine model message =
    case message.command of
        "005" ->
            let
                supported =
                    foldIsupportLine model message
            in
            -- A fresh `ACCOUNTRESIDENCE` node re-runs attribution
            -- (same node is a no-op inside the fold, mirroring the
            -- oracle `setNode` guard).
            case supported.isupport.attributionNode of
                Nothing ->
                    ( supported, [] )

                Just node ->
                    fireAttribution (\session -> Attribution.foldNode session node) supported

        "004" ->
            -- RPL_MYINFO carries the server version at params[2]
            -- (mirrors the oracle `serverVersion` write; unset when
            -- empty, like the oracle's falsy guard).
            case message.params of
                _ :: _ :: version :: _ ->
                    if String.isEmpty version then
                        ( model, [] )

                    else
                        ( { model | serverVersion = Just version }, [] )

                _ ->
                    ( model, [] )

        "375" ->
            ( startMotd model, [] )

        "372" ->
            case message.params of
                _ :: line :: _ ->
                    ( appendMotd model line, [] )

                _ ->
                    ( model, [] )

        "376" ->
            ( finishMotd model, [] )

        "353" ->
            ( foldNames model message, [] )

        "366" ->
            let
                settled =
                    settleNamesBurst model message
            in
            ( settled, requestPropsOnNamesEnd model message )

        "315" ->
            ( logNumeric model message, [] )

        "352" ->
            foldWhoReply model message

        "354" ->
            -- WHOX rows follow the requested selector's field order, so a
            -- stateless client cannot parse them positionally. The oracle
            -- keeps no 354 fold either — rows surface via the default
            -- numeric log rule below.
            ( logNumeric model message, [] )

        "524" ->
            ( logNumeric model message, [] )

        "704" ->
            ( logNumeric model message, [] )

        "705" ->
            ( logNumeric model message, [] )

        "706" ->
            ( logNumeric model message, [] )

        "710" ->
            -- KNOCK sent (contract §11): neither client tracks
            -- knock state — the notice text is the whole signal —
            -- so this stays on the generic numeric log.
            ( logNumeric model message, [] )

        "711" ->
            -- KNOCK delivered: same generic-log rule.
            ( logNumeric model message, [] )

        "713" ->
            -- KNOCK errors (no such channel / already there):
            -- same generic-log rule.
            ( logNumeric model message, [] )

        "714" ->
            -- KNOCK errors (continued): same generic-log rule.
            ( logNumeric model message, [] )

        "JOIN" ->
            case divertReplayEvent model message of
                Just replayed ->
                    -- A replayed JOIN renders into scrollback, never
                    -- touching the live roster, fetch, or WHO.
                    ( replayed, [] )

                Nothing ->
                    case message.params of
                        chan :: _ ->
                            case message.nick of
                                Just nick ->
                                    if String.isEmpty nick || String.toLower nick /= String.toLower model.ourNick then
                                        ( foldJoin model message, [] )

                                    else if channelJoinRefused model chan then
                                        -- The room working set is full
                                        -- (mirroring the
                                        -- `MAX_LIVE_CHANNELS` break: no
                                        -- entry, no fetch, no WHO).
                                        ( model, [] )

                                    else if model.historyMerging then
                                        -- Untagged merges never touch live
                                        -- sync either.
                                        ( foldJoin model message, [] )

                                    else
                                        let
                                            ( fetched, outs ) =
                                                requestJoinHistory (foldJoin model message) chan
                                        in
                                        -- Fetch WHO data for away status on
                                        -- every self-join, like the oracle.
                                        -- Opt into the server activity
                                        -- stream too, so typing events
                                        -- arrive as ACTIVITY even when
                                        -- TAGMSG caps differ.
                                        -- A confirmed self-join settles a
                                        -- matching browser attempt (pending
                                        -- or uncertain), mirroring the
                                        -- browser's join effects. It also
                                        -- settles a matching pending room
                                        -- creation (TOPIC + first line).
                                        let
                                            browserSettled =
                                                settleBrowserJoin (clearJoinPromptFor fetched chan) chan

                                            ( created, createOuts ) =
                                                settlePendingCreateRoom browserSettled chan

                                            -- A self-JOIN echo for the pending
                                            -- `?join=` room opens it (whole
                                            -- room — Elm has no topic-slice
                                            -- surface, so a `?topic=` label
                                            -- cannot narrow further) and
                                            -- clears the triple.
                                            ( linked, linkOuts ) =
                                                case created.pendingDeepLinkJoin of
                                                    Just pending ->
                                                        if String.toLower pending == String.toLower chan then
                                                            -- The echo opens the room; a `?at=`
                                                            -- moment then travels (vault
                                                            -- first, server AROUND after),
                                                            -- mirroring the oracle's
                                                            -- post-join travelTo.
                                                            let
                                                                ( opened, openOuts ) =
                                                                    selectChannel (clearPendingDeepLink created) chan

                                                                travelAt =
                                                                    Maybe.andThen (parseDeepLinkAt opened.nowMs) created.pendingDeepLinkAt

                                                                ( traveled, travelOuts ) =
                                                                    case travelAt of
                                                                        Just at ->
                                                                            requestTravelTo opened chan at

                                                                        Nothing ->
                                                                            ( opened, [] )
                                                            in
                                                            ( traveled, openOuts ++ travelOuts )

                                                        else
                                                            ( created, [] )

                                                    Nothing ->
                                                        ( created, [] )
                                        in
                                        ( linked
                                        , outs
                                            ++ createOuts
                                            ++ linkOuts
                                            ++ [ SendLine (Wire.formatIrcLine "WHO" [ chan ]) ]
                                            ++ (case activitySubscribeLine "SUBSCRIBE" chan of
                                                    Just line ->
                                                        [ SendLine line ]

                                                    Nothing ->
                                                        []
                                               )
                                            ++ namesAfterSelfJoin fetched chan
                                        )

                                Nothing ->
                                    ( foldJoin model message, [] )

                        [] ->
                            ( foldJoin model message, [] )

        "PART" ->
            case divertReplayEvent model message of
                Just replayed ->
                    ( replayed, [] )

                Nothing ->
                    -- The fold owns the whole line: guards, the room
                    -- drop, the row/event, and the self-part activity
                    -- UNSUBSCRIBE.
                    foldPart model message

        "QUIT" ->
            case divertReplayEvent model message of
                Just replayed ->
                    ( replayed, [] )

                Nothing ->
                    ( foldQuit model message, [] )

        "NICK" ->
            case divertReplayEvent model message of
                Just replayed ->
                    ( replayed, [] )

                Nothing ->
                    foldNick model message

        "MODE" ->
            case divertReplayEvent model message of
                Just replayed ->
                    ( replayed, [] )

                Nothing ->
                    let
                        updated =
                            foldMode model message
                    in
                    ( updated, fetchBansOnOpGrant model updated message )

        "KICK" ->
            case divertReplayEvent model message of
                Just replayed ->
                    ( replayed, [] )

                Nothing ->
                    ( foldKick model message, [] )

        "RENAME" ->
            -- Channel renames are live state, never replay payloads:
            -- the oracle diverts no RENAME into history batches.
            foldRename model message

        "REGISTER" ->
            foldRegisterCommand model message

        "VERIFY" ->
            foldVerifyCommand model message

        "INVITE" ->
            foldInvite model message

        "TOPIC" ->
            case divertReplayEvent model message of
                Just replayed ->
                    ( replayed, [] )

                Nothing ->
                    let
                        updated =
                            foldLiveTopic model message
                    in
                    ( updated, persistTopicHistory model updated )

        "PRIVMSG" ->
            foldChat model message False

        "NOTICE" ->
            -- Attribution confirmations observe every server NOTICE
            -- first (a pre-pass: unrelated lines leave no outbounds
            -- and keep flowing to chat, mirroring the oracle
            -- `observe` running alongside normal handling).
            let
                ( withAttr, attrOut ) =
                    observeAttributionNotice model message

                ( folded, out ) =
                    case foldSessionTokenNotice withAttr message of
                        Just captured ->
                            captured

                        Nothing ->
                            case directoryNoticeBody withAttr message of
                                Just body ->
                                    foldDirectoryNotice withAttr body

                                Nothing ->
                                    case foldOperReplayThenSession withAttr message of
                                        Just captured ->
                                            captured

                                        Nothing ->
                                            case foldTotpNotice withAttr message of
                                                Just settled ->
                                                    settled

                                                Nothing ->
                                                    case foldRecoveryCodesNotice withAttr message of
                                                        Just settled ->
                                                            settled

                                                        Nothing ->
                                                            case foldKeytransNotice withAttr message of
                                                                Just settled ->
                                                                    settled

                                                                Nothing ->
                                                                    case foldCertNotice withAttr message of
                                                                            Just settled ->
                                                                                settled

                                                                            Nothing ->
                                                                                case foldVhostNotice withAttr message of
                                                                                    Just settled ->
                                                                                        settled

                                                                                    Nothing ->
                                                                                        case foldAccountInfoNotice withAttr message of
                                                                                            Just settled ->
                                                                                                settled

                                                                                            Nothing ->
                                                                                                case foldWebhookNotice withAttr message of
                                                                                                    Just settled ->
                                                                                                        settled

                                                                                                    Nothing ->
                                                                                                        foldChat withAttr message True
            in
            ( folded, attrOut ++ out )

        "CHATHISTORY" ->
            -- TARGETS discovery rows collect into the open reply
            -- batch; any other replay shape stays ahead with the
            -- history-fetch infrastructure.
            ( collectHistoryTarget model message, [] )

        "332" ->
            let
                updated =
                    foldTopic model message
            in
            ( updated, persistTopicHistory model updated )

        "331" ->
            -- RPL_NOTOPIC carries no topic: the oracle logs it and
            -- leaves the current topic (and its history) alone.
            ( logNumeric model message, [] )

        "321" ->
            -- RPL_LISTSTART resets partial rows (mirroring the
            -- oracle's `_listPending` reset; the committed directory
            -- is untouched until 323).
            ( foldListStart model, [] )

        "322" ->
            -- RPL_LIST rows merge into the in-flight directory
            -- request (stray rows never populate retained UI).
            foldListRow model message

        "323" ->
            -- RPL_LISTEND commits the in-flight request (or releases
            -- a timeout quarantine).
            foldListEnd model

        "PING" ->
            ( model
            , [ SendLine (Wire.formatIrcLine "PONG" (List.filterMap identity [ List.head (List.reverse message.params) ])) ]
            )

        "PONG" ->
            -- Any PONG re-arms the ports-side keepalive (clear pong
            -- timeout + schedule the next ping), mirroring the oracle
            -- exactly — including PONGs answering server PINGs. A
            -- PONG echoing the live probe cookie also samples RTT.
            ( foldLatencyPong model (secondOrFirst message.params), [ PingObserved ] )

        "221" ->
            -- Own umodes (contract §11): the oracle keeps no 221
            -- fold — the modes surface reads 005/324 instead — so
            -- this stays on the generic numeric log.
            ( logNumeric model message, [] )

        "251" ->
            foldLusers model message

        "252" ->
            foldLusers model message

        "254" ->
            foldLusers model message

        "255" ->
            -- RPL_LUSERME duplicates 251; the oracle ignores it (it
            -- never reaches the numeric log).
            ( model, [] )

        "ERROR" ->
            -- The oracle surfaces these as connection errors, never
            -- silently. The trailing param carries the reason.
            -- v3/gap-shell: inbox row, banner/gate reason, and kills or
            -- bans stop auto-reconnect.
            ( foldServerError model (trailingParam message.params), [] )

        "KILL" ->
            -- v3/gap-shell: `:<oper> KILL <you> :<reason>`.
            ( foldKill model message, [] )

        "001" ->
            -- Registration enters IRCX mode first (before any
            -- store-driven JOIN), mirroring the oracle's bare `IRCX`
            -- ahead of its store notify, then publishes this device's
            -- E2EE point (ports-side key) so peers can seal to us,
            -- mirroring the oracle's pref-gated `publishDeviceKey` on
            -- 001, and marks the group publisher registered (it still
            -- waits for the 900 account before it projects). The
            -- server prefix is learned first-wins: a duplicate or
            -- forged 001 can never retarget trusted directory
            -- dispatch. The once-per-socket session commands run last:
            -- a resumed socket reclaims before any store-driven JOIN.
            let
                ( nextPublisher, pubFx ) =
                    GroupPublisher.registered model.publisher

                publishFx =
                    if model.e2eeDms then
                        [ DmPublishKey ]

                    else
                        []

                assignedNick =
                    Maybe.withDefault "" (List.head message.params)

                welcomeGiven =
                    Maybe.withDefault "" (List.head (List.drop 1 message.params))

                welcomeText =
                    if String.isEmpty assignedNick then
                        ""

                    else if String.isEmpty (String.trim welcomeGiven) then
                        "Welcome, " ++ assignedNick ++ "."

                    else
                        welcomeGiven

                priorProps =
                    model.props

                based =
                    logService
                        { model
                            | connection = Live
                            -- Registration names us: the server-assigned
                            -- nick wins (mirroring the oracle `ourNick`
                            -- write); an empty assignment never
                            -- clobbers the connected nick.
                            , ourNick =
                                if String.isEmpty assignedNick then
                                    model.ourNick

                                else
                                    assignedNick
                            -- Voice/video is available to any registered
                            -- member with no cap to gate on, mirroring
                            -- the oracle.
                            , mediaAvailable = True
                            -- A new registration resets channel-registry
                            -- sync, mirroring the oracle.
                            , props = { priorProps | synced = Set.empty }
                        -- Registration proves the socket: auto-reconnect
                        -- arms and the attempt budget resets, mirroring
                        -- the oracle connect-success assignment.
                        , autoReconnect = True
                        , reconnectAttempts = 0
                        , reconnectIn = 0
                        , reconnectDueMs = 0
                        -- Registration after a non-live stretch starts the
                        -- Back-online notice window, mirroring the oracle
                        -- `connected && recovering` gate; a 001 while
                        -- already live leaves the stamp untouched.
                        , backOnlineAt =
                            -- v3/polish: only a recovery (a 001 after
                            -- an earlier live session) says Back online.
                            if model.connection /= Live && model.polish.hasBeenLive then
                                model.nowMs

                            else
                                model.backOnlineAt
                        , serverPrefix = learnServerPrefix model.serverPrefix message.prefix
                        , publisher = nextPublisher
                        -- Reconnect re-arms the outbox auto-retry
                        -- budget and clears sticky failure chrome;
                        -- the OutboxFlush below replays the queue.
                        , outboxRetries = 0
                        , outboxFailed = False
                        -- Successful registration ends alias rotation.
                        , nickAliasTryIdx = 0
                        }
                        welcomeText

                baseOutbound =
                    SendLine (Wire.formatIrcLine "IRCX" [])
                        :: publishFx
                        ++ runPublisherEffects pubFx
                        ++ [ flushRequest model
                           -- Subscribe to live voice/video presence,
                           -- mirroring the oracle's `EVENT ADD MEDIA *`
                           -- on 001 (a re-subscribe after reconnect is
                           -- a harmless server-ignored duplicate).
                           , SendLine (Wire.formatIrcLine "EVENT" [ "ADD", "MEDIA", "*" ])
                           -- Server stats for the home widget, mirroring
                           -- the oracle's `LUSERS` on 001.
                           , SendLine (Wire.formatIrcLine "LUSERS" [])
                           ]

                ( final, sessionOutbound ) =
                    maybeSendSessionCommands based

                -- A 001 landing with rooms still shown is a
                -- reconnect: re-JOIN every live room (suppressed
                -- under `onyx/session-sync`, vacuous on a first
                -- registration), mirroring the oracle
                -- `onConnected` storm.
                ( rejoined, rejoinOutbound ) =
                    rejoinLiveChannels final

                ( swept, targetsOutbound ) =
                    requestHistoryTargetDiscovery rejoined

                -- Registration (re)loads the owner's identity
                -- profile, mirroring the oracle's owned-memory load
                -- on connect. The desired nick is the SASL account,
                -- else the nick we connected with: landing elsewhere
                -- means registration fell back to an alias, so flag
                -- it — and when a SASL account names the desire,
                -- reclaim it now (retrying until the zombie releases
                -- it), mirroring the welcome desired-nick path.
                ( withProfile, profileOutbound ) =
                    requestIdentityProfile model.identityProfileOwner swept

                desired =
                    Maybe.withDefault model.connectNick model.saslAccount

                flagged =
                    { withProfile
                        | currentNickIsAlias =
                            String.toLower withProfile.ourNick /= String.toLower desired
                    }

                ( welcomed, welcomeOut ) =
                    case model.saslAccount of
                        Just account ->
                            startNickReclaim flagged account

                        Nothing ->
                            ( flagged, [] )
                -- Registration landing live with a moderated room open
                -- loads its block list, mirroring the ban panel's
                -- connected-and-op fetch effect.
                ( withBans, banOutbound ) =
                    case welcomed.activeChannel of
                        Just open ->
                            if isChannelOp welcomed open then
                                requestBanList welcomed open

                            else
                                ( welcomed, [] )

                        Nothing ->
                            ( welcomed, [] )
                -- Registration flushes a Connect-queued recovery-code
                -- login once, mirroring the oracle's
                -- `_pendingRecoveryLogin` flush on 001.
                ( withRecovery, recoveryOutbound ) =
                    flushPendingRecoveryLogin withBans

                -- A new socket owns no server-side MONITOR state:
                -- resubscribe this identity's contact union without
                -- trusting stale local flags, mirroring the oracle's
                -- 001 `_replaceOwnedMonitorContacts(clearRemote=false)`.
                ( withMonitor, monitorOutbound ) =
                    syncMonitorContacts False withRecovery

                -- A `?join=` deep link joins its room once the
                -- session settles, mirroring the oracle's
                -- pending-deep-link JOIN on 001.
                ( withLink, linkOutbound ) =
                    firePendingDeepLinkJoin withMonitor
            in
            ( withLink
            , baseOutbound ++ sessionOutbound ++ rejoinOutbound ++ targetsOutbound ++ profileOutbound ++ welcomeOut ++ banOutbound ++ recoveryOutbound ++ monitorOutbound ++ linkOutbound
            )

        "900" ->
            -- RPL_LOGGEDIN carries the authenticated account at params[2]
            -- (four parameters minimum); the two-parameter IRCX error
            -- also numbered 900 proves nothing and is ignored, mirroring
            -- the oracle's account-attribution gate.
            if List.length message.params < 4 then
                ( model, [] )

            else
                case List.drop 2 message.params of
                    account :: _ ->
                        if String.isEmpty account then
                            ( model, [] )

                        else
                            let
                                ( nextPublisher, pubFx ) =
                                    GroupPublisher.setAccount (Just account) model.publisher

                                -- IDENTIFY can switch accounts on an
                                -- already-registered socket. The old
                                -- Bearer [REDACTED] a row owned by the old account,
                                -- so never replay them into the new
                                -- account's SESSION generation: drop the
                                -- live holdings and re-arm the
                                -- once-per-socket commands.
                                switched =
                                    case model.accountName of
                                        Just current ->
                                            String.toLower current /= String.toLower account

                                        Nothing ->
                                            False

                                -- A guest login (no account yet) is an
                                -- owner change too, mirroring the oracle
                                -- 900 arm (`_accountKey(null)` never equals
                                -- the new account) — but unlike an
                                -- account switch it keeps the live resume
                                -- tokens: neither oracle reset touches
                                -- them, so a login still resumes the
                                -- session it proves.
                                loggedIn =
                                    model.accountName == Nothing

                                ownerChanged =
                                    switched || loggedIn

                                -- A 900 that changes the schedule owner
                                -- retires the outgoing identity's rows
                                -- so their plaintext bodies never linger
                                -- in storage (mirroring the oracle's
                                -- scheduled purge on 900, which keys off
                                -- the account-or-nick owner — including a
                                -- guest-to-account login, where Elm's
                                -- narrower `switched` stays false and the
                                -- rest of that reset stays ahead).
                                ( unpurged, purgeOut ) =
                                    let
                                        outgoing =
                                            scheduleOwner model

                                        incoming =
                                            scheduleOwner { model | accountName = GroupPublisher.canonicalAccount (Just account) }
                                    in
                                    if incoming /= outgoing then
                                        purgeScheduledForOwner model outgoing

                                    else
                                        ( model, [] )

                                quarantined =
                                    quarantineOwnerChange unpurged

                                cleared =
                                    if switched then
                                        -- An account switch owns a new
                                        -- session: live resume tokens and the
                                        -- once-per-socket commands never
                                        -- cross it (the outbox budget, alias
                                        -- rotation, and everything else the
                                        -- oracle resets rides the
                                        -- quarantine).
                                        { quarantined
                                            | sessionTokens = { sessionToken = Nothing, meshToken = Nothing, meshTokenExpiresAt = Nothing }
                                            , sessionCommandsSent = False
                                        }

                                    else if loggedIn then
                                        quarantined

                                    else
                                        unpurged

                                based =
                                    { cleared
                                        | accountName = GroupPublisher.canonicalAccount (Just account)
                                        , publisher = nextPublisher
                                        -- Accepted login drops any pending
                                        -- identify reply context so a later
                                        -- unrelated 464 cannot be attributed
                                        -- to it.
                                        , identifyReplyAccount = Nothing
                                        , currentNickIsAlias = String.toLower cleared.ourNick /= String.toLower account
                                    }

                                -- The canonical account can change on a live
                                -- socket (900/IDENTIFY): a live transition
                                -- is a full attribution-owner boundary,
                                -- forcing a new enrollment and residence
                                -- proof even on the same node (mirroring
                                -- the oracle `observe` 900 arm).
                                -- Server-originated only: a
                                -- user-originated line carries a nick and
                                -- is ignored outright (the store fold
                                -- above still trusts the line, exactly
                                -- like the oracle).
                                ( withAttr, attrOut ) =
                                    if message.nick /= Nothing then
                                        ( based, [] )

                                    else
                                        fireAttribution (\session -> Attribution.foldAccount session (Just account)) based

                                ( final, sessionOutbound ) =
                                    maybeSendSessionCommands withAttr

                                -- A new authenticated account owns a new
                                -- device-memory namespace: reload the
                                -- identity profile, mirroring the
                                -- oracle's owned-memory load on 900.
                                -- Registration may have fallen back to
                                -- a temporary nick after 433: once 900
                                -- proves the account, reclaim it now
                                -- and retry until the zombie releases
                                -- it — or stop a stale reclaim when the
                                -- nick already matches.
                                ( withProfile, profileOutbound ) =
                                    requestIdentityProfile model.identityProfileOwner final

                                ( reclaimed, reclaimOut ) =
                                    startNickReclaim withProfile account

                                -- An owner change (switch or fresh login)
                                -- quarantines the old identity's MONITOR
                                -- subscriptions: clear remote and
                                -- resubscribe the new union, mirroring the
                                -- oracle's clearRemote replace on identity
                                -- change.
                                ( switchedMonitor, monitorOut ) =
                                    if ownerChanged then
                                        syncMonitorContacts True reclaimed

                                    else
                                        ( reclaimed, [] )

                                -- A login may change the push owner:
                                -- refresh the browser bit (recovery with
                                -- intent follows from the reply, mirroring
                                -- the oracle recovery effect).
                                ( withPush, pushOut ) =
                                    requestWebPushCheck switchedMonitor
                            in
                            -- Any login hides the claim affordance and
                            -- forgets captured credentials, mirroring
                            -- the prompt's sign-in effect.
                            ( resetGuestClaim withPush
                            , purgeOut ++ runPublisherEffects pubFx ++ attrOut ++ sessionOutbound ++ profileOutbound ++ reclaimOut ++ monitorOut ++ pushOut
                            )

                    _ ->
                        ( model, [] )

        "ACCOUNT" ->
            -- IRCv3 account-notify: only our own ACCOUNT describes
            -- the top-bar identity; a peer's is ignored.
            foldAccount model message

        "901" ->
            -- RPL_LOGGEDOUT: the account proof is gone, so the name,
            -- the publisher account, the live resume tokens, and the
            -- session-commands flag all clear with it, mirroring the
            -- oracle.
            let
                ( nextPublisher, pubFx ) =
                    GroupPublisher.setAccount Nothing model.publisher
            in
            let
                -- Logout retires the outgoing identity's scheduled
                -- rows (mirroring the oracle's logout purge, which
                -- runs before the account clears, so an account 901
                -- drops the account's rows and a guest 901 drops the
                -- nick's rows).
                ( unpurged, purgeOut ) =
                    purgeScheduledForOwner model (scheduleOwner model)

                quarantined901 =
                    quarantineOwnerChange unpurged

                cleared =
                    stopNickReclaim
                        -- Logout drops back to the nick-owned namespace:
                        -- the whole owner-bound working set quarantines
                        -- first (mirroring the oracle 901 arm); what
                        -- stays in the update is logout-specific.
                        { quarantined901
                            | accountName = Nothing
                            , saslAccount = Nothing
                            , totpReplyAccount = Nothing
                            , keytransReplyAccount = Nothing
                            , certReplyAccount = Nothing
                            , vhostReplyAccount = Nothing
                            , personaClaimHost = ""
                            , vhostRefreshAccount = Nothing
                            , accountInfoReplyAccount = Nothing
                            , totpCodeInput = ""
                            , certFingerprint = ""
                            , totpSecretCopy = TotpCopyIdle
                            , totpOtpauthCopy = TotpCopyIdle
                            , recoveryPassword = ""
                            , recoveryGenerateArmed = False
                            , passkeyLabel = ""
                            , passkeyRenamingId = Nothing
                            , passkeyRenameValue = ""
                            , passkeyRemoveArmed = Nothing
                            , accountEmail = ""
                            , accountEmailPassword = ""
                            , accountEmailError = Nothing
                            , accountNewPassword = ""
                            , accountConfirmPassword = ""
                            , accountCurrentPassword = ""
                            , accountPasswordError = Nothing
                            , dropConfirm = ""
                            , dropPassword = ""
                            , dropArmed = False
                            , e2eePublishBusy = False
                            , publisher = nextPublisher
                            , sessionTokens = { sessionToken = Nothing, meshToken = Nothing, meshTokenExpiresAt = Nothing }
                            , sessionCommandsSent = False
                            , saslAuthenticated = False
                        }
                        |> clearLinkPreviews

                -- Logout drops back to the nick-owned namespace.
                ( withProfile, profileOutbound ) =
                    requestIdentityProfile model.identityProfileOwner cleared

                -- A logout that changes the device-memory owner
                -- quarantines the old subscriptions too, mirroring
                -- the oracle's owner-change replace on 901.
                ( loggedOut, logoutMonitorOut ) =
                    if deviceMemoryOwner model /= deviceMemoryOwner withProfile then
                        syncMonitorContacts True withProfile

                    else
                        ( withProfile, [] )
            in
            ( loggedOut
            , purgeOut ++ runPublisherEffects pubFx ++ profileOutbound ++ logoutMonitorOut
            )

        "432" ->
            foldNickError model message

        "433" ->
            foldNickError model message

        "437" ->
            foldNickError model message

        "CAP" ->
            foldCap model message

        "AUTHENTICATE" ->
            foldAuthenticate model message

        "903" ->
            -- RPL_SASLSUCCESS only while an exchange is actually in
            -- flight: 903 is reused by the IRCX layer
            -- post-registration, so an idle 903 stays on the numeric
            -- log path like the oracle's pass-through.
            if model.sasl /= SaslIdle then
                let
                    ( ended, fx ) =
                        finishCapIfReady
                            { model | sasl = SaslIdle, saslAuthenticated = True }
                in
                ( ended, SaslTimerCleared :: fx )

            else
                ( logNumeric model message, [] )

        "904" ->
            -- ERR_SASLFAIL (and its 905 sibling) only while an
            -- exchange is in flight; otherwise ordinary numerics.
            -- v3/gap-shell: the server's reason (two-step, storage) is kept.
            if model.sasl /= SaslIdle then
                failSasl model (saslFailReason message)

            else
                ( logNumeric model message, [] )

