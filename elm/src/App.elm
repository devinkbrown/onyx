{-| What the view renders for a message: decrypted plaintext when we
hold it, the locked placeholder for unopened envelopes (which also
covers vault-replayed ciphertext), otherwise the raw body. The vault
only ever sees `body`, so E2EE persistence stays ciphertext-only.
-}
deletedPlaceholder : String
deletedPlaceholder =
    "[message deleted]"


{-| Body stored on a REDACTED row (capital-M wire copy, mirroring the
oracle fold; rendering lowercases it via `deletedPlaceholder`). -}
redactedBody : String
redactedBody =
    "[Message deleted]"


displayBody : ChatMessage -> String
displayBody message =
    if message.redacted || message.deleted then
        deletedPlaceholder

    else if GroupEnvelope.isGroupEnvelope message.body then
        GroupEnvelope.groupMessageDisplayText message.body message.plaintext

    else
        case message.plaintext of
            Just plain ->
                plain

            Nothing ->
                if DmCipher.isEnvelope message.body then
                    DmCipher.lockedPlaceholder

                else
                    message.body


{-| True for an unopened envelope: ciphertext held, no plaintext yet.
-}
messageLocked : ChatMessage -> Bool
messageLocked message =
    message.plaintext
        == Nothing
        && (DmCipher.isEnvelope message.body || GroupEnvelope.isGroupEnvelope message.body)


