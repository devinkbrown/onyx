        ComposerAssistIntent intent ->
            -- Suggestion lists and Tab completion (mirroring the
            -- composer `completeCommand` / `completeNick` / Tab-cycle
            -- arms): a written draft lands like typed text without
            -- re-arming the dismissed list or signalling typing.
            let
                outcome =
                    ComposerAssist.applyIntent (composerAssistInputs model) intent model.composerAssist
            in
            case outcome.draft of
                Just draft ->
                    ( setComposerDraft { model | composerAssist = outcome.assist } draft, [] )

                Nothing ->
                    ( { model | composerAssist = outcome.assist }, [] )

