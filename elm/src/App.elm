        TopicHistoryLoaded value ->
            -- An owned-namespace load replaces the live map wholesale,
            -- mirroring the oracle's `_loadOwnedTopicHistory` assignment.
            ( { model | topicHistory = parseTopicHistoryValue value }, [] )

        TopicReadLoaded value ->
            -- An owned-namespace load replaces the live ledger wholesale
            -- (re-validated fail-closed), then re-projects every loaded
            -- room the ledger names so badges agree with the cursors.
            let
                loaded =
                    { model | topicReadLedger = TopicRead.parseTopicReadLedger value }

                rooms =
                    List.foldl
                        (\marker acc ->
                            if Dict.member marker.channel loaded.channels then
                                Set.insert marker.channel acc

                            else
                                acc
                        )
                        Set.empty
                        loaded.topicReadLedger
            in
            ( List.foldl (\channel acc -> reconcileChannelTopicUnread acc channel) loaded (Set.toList rooms), [] )

        NickAliasesLoaded value ->
            -- An owned-namespace load normalizes the list against the
            -- current canonical identity (fail-closed: a non-array
            -- payload keeps the session list), mirroring
            -- `parseNickAliases` + `normalizeNickAliases`.
            let
                raw =
                    case Decode.decodeValue (Decode.list Decode.string) value of
                        Ok strings ->
                            strings

                        Err _ ->
                            model.nickAliases

                canonical =
                    Maybe.withDefault "" (Maybe.map .identity (deviceMemoryOwner model))
            in
            ( { model | nickAliases = normalizeNickAliases raw canonical }, [] )

        FriendsLoaded value ->
            -- An owned-namespace load replaces the live map wholesale
            -- (a bad payload loads empty, mirroring the oracle's
            -- throw/oversize arms in `_loadOwnedFriends`), then
            -- re-subscribes the friend/watch union additively: the
            -- oracle reloads owned contacts synchronously before its
            -- MONITOR replace, while the bridge answers asynchronously
            -- here, so an owner change converges once its reloads land.
            syncMonitorContacts False { model | friends = decodeFriends value }

        WatchListLoaded value ->
            -- Same wholesale replace for the WATCH list, mirroring
            -- `_loadOwnedWatchList`, with the same additive MONITOR
            -- convergence as the friends load.
            syncMonitorContacts False { model | watchList = decodeWatchList value }

        CtcpConfigLoaded value ->
            -- Owned-namespace CTCP config (mirroring
            -- `loadCtcpConfig`: bad payloads fall back to the
            -- defaults field-by-field, never into garbage).
            let
                loaded =
                    decodeCtcpConfig value
            in
            ( { model | ctcpVersionReply = loaded.versionReply, ctcpTimeEnabled = loaded.timeEnabled }, [] )

