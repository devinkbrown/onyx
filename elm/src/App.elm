        MessageQuote { target, from, body } ->
            -- A quote for another conversation selects it first (which
            -- swaps the per-target drafts) and the merged prefix lands
            -- in the draft the send will use, stored and visible alike.
            -- Caret/focus motion stays a narrowing (no caret state).
            let
                insert =
                    ComposerInject.formatQuoteInsert from body

                injectInto composer =
                    (ComposerInject.mergeComposerInsert composer insert ComposerInject.InjectPrefix).text

                toasted current =
                    let
                        merged =
                            injectInto current.composer
                    in
                    ( addToast
                        { variant = ToastInfo
                        , title = "Quoted into composer"
                        , description = Just ("Prefixed a quote from " ++ from ++ ".")
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        { current
                            | composer = merged
                            , composerDrafts = Dict.insert (String.toLower target) merged current.composerDrafts
                            , messageMenu = Nothing
                        }
                    , []
                    )
            in
            if Maybe.map String.toLower model.activeChannel == Just (String.toLower target) then
                toasted model

            else
                let
                    ( switched, outs ) =
                        selectChannel model target

                    ( quoted, _ ) =
                        toasted switched
                in
                ( quoted, outs )

        ReplyArm { target, msgid } ->
            -- Edit wins over reply and vice versa (mirroring the
            -- mutual-exclusivity rule in both setters); either arm
            -- dismisses the message menu that offered it.
            let
                armed =
                    armReply model target msgid
            in
            ( { armed | editingMessage = Nothing, messageMenu = Nothing }, [] )

        ReplyCancel ->
            -- Backing out of a reply stops the typing signal
            -- (mirroring the oracle `cancelReply`).
            sendTyping { model | replyingTo = Nothing } (Maybe.withDefault "" model.activeChannel) False

        EditArm { target, msgid } ->
            if canEditRow model target msgid then
                case Dict.get (String.toLower target) model.channels of
                    Nothing ->
                        ( model, [] )

                    Just channel ->
                        case List.filter (\m -> m.msgid == Just msgid) channel.messages |> List.head of
                            Nothing ->
                                ( model, [] )

                            Just row ->
                                -- The pre-arm draft stashes on the arm so
                                -- cancel can restore it (mirroring the
                                -- oracle per-target draft restore within
                                -- the single-draft Elm composer).
                                ( { model | editingMessage = Just { target = String.toLower target, msgid = msgid, draft = model.composer }, replyingTo = Nothing, composer = row.body, messageMenu = Nothing }, [] )

            else
                ( model, [] )

        EditCancel ->
            -- Backing out of an edit stops the typing signal and
            -- restores the current conversation's stored draft
            -- (mirroring the oracle `cancelEdit` draft restore; the
            -- arm stash is the fallback when nothing is stored).
            case model.editingMessage of
                Nothing ->
                    ( model, [] )

                Just edit ->
                    let
                        restored =
                            case model.activeChannel of
                                Nothing ->
                                    edit.draft

                                Just current ->
                                    let
                                        stored =
                                            Dict.get (String.toLower current) model.composerDrafts
                                    in
                                    Maybe.withDefault edit.draft stored
                    in
                    sendTyping { model | editingMessage = Nothing, composer = restored } (Maybe.withDefault "" model.activeChannel) False

        MessageMenuOpen { target, msgid } ->
            -- The per-message menu toggles on its own row (mirroring
            -- the oracle popover open state); unknown rows never open
            -- it, and opening one row closes any other.
            case reactionRow model target msgid of
                Nothing ->
                    ( model, [] )

                Just _ ->
                    -- Opening a row starts that row from idle
                    -- (mirroring the oracle per-menu invalidation: a
                    -- reopened menu never resumes an older request,
                    -- so its late completion drops on arrival).
                    -- Other rows' entries are untouched.
                    case model.messageMenu of
                        Just open ->
                            if String.toLower open.target == String.toLower target && open.msgid == msgid then
                                -- Toggling closed unmounts the menu and
                                -- its translation with it.
                                ( { model | messageMenu = Nothing, translations = Dict.remove msgid model.translations }, [] )

                            else
                                ( { model | messageMenu = Just { target = String.toLower target, msgid = msgid, confirmDelete = False }, reactionPicker = Nothing, translations = Dict.remove msgid model.translations }, [] )

                        Nothing ->
                            ( { model | messageMenu = Just { target = String.toLower target, msgid = msgid, confirmDelete = False }, reactionPicker = Nothing, translations = Dict.remove msgid model.translations }, [] )

        MessageMenuClose ->
            case model.messageMenu of
                Nothing ->
                    ( model, [] )

                Just open ->
                    ( { model | messageMenu = Nothing, translations = Dict.remove open.msgid model.translations }, [] )

        ReactionPickerOpen { target, msgid } ->
            -- The reaction picker opens on its own row and is
            -- mutually exclusive with the overflow menu
            -- (mirroring the oracle popover open state): an
            -- unknown row never opens it, and opening one layer
            -- closes the other.
            case reactionRow model target msgid of
                Nothing ->
                    ( model, [] )

                Just _ ->
                    case model.reactionPicker of
                        Just open ->
                            if String.toLower open.target == String.toLower target && open.msgid == msgid then
                                ( { model | reactionPicker = Nothing }, [] )

                            else
                                ( { model | reactionPicker = Just { target = String.toLower target, msgid = msgid, query = "" }, messageMenu = Nothing }, [] )

                        Nothing ->
                            ( { model | reactionPicker = Just { target = String.toLower target, msgid = msgid, query = "" }, messageMenu = Nothing }, [] )

        ReactionPickerClose ->
            case model.reactionPicker of
                Nothing ->
                    ( model, [] )

                Just _ ->
                    ( { model | reactionPicker = Nothing }, [] )

        ReactionPickerSearch text ->
            case model.reactionPicker of
                Nothing ->
                    ( model, [] )

                Just open ->
                    ( { model | reactionPicker = Just { open | query = text } }, [] )

        ReactionPickerChoose emoji ->
            -- Choosing emits the bounded react through the
            -- shared send path (mirroring the oracle react
            -- popover choose) and closes the picker.
            case model.reactionPicker of
                Nothing ->
                    ( model, [] )

                Just open ->
                    Tuple.mapFirst (\m -> { m | reactionPicker = Nothing }) (sendReaction model open.target open.msgid emoji)

        -- v3/boost
        JumpToDateOpen ->
            -- Opening seeds today at noon UTC (mirroring the
            -- oracle sheet seeding defaults on open).
            ( { model | showJumpToDate = True, jumpDate = Boost.formatUtcDate model.nowMs, jumpTime = "12:00", jumpError = Nothing }, [] )

        JumpToDateClose ->
            ( { model | showJumpToDate = False, jumpError = Nothing }, [] )

        JumpToDateInputDate text ->
            ( { model | jumpDate = text, jumpError = Nothing }, [] )

        JumpToDateInputTime text ->
            ( { model | jumpTime = text, jumpError = Nothing }, [] )

        JumpToDatePreset daysAgo ->
            ( { model | jumpDate = Boost.utcDateDaysAgo daysAgo model.nowMs, jumpTime = "12:00", jumpError = Nothing }, [] )

        JumpToDateSubmit ->
            -- Jumping reuses the time-travel machinery
            -- (mirroring the oracle sheet `jump`: travel, then
            -- close whatever the travel fold decided).
            case model.activeChannel of
                Nothing ->
                    ( { model | jumpError = Just "Open a room or DM first." }, [] )

                Just target ->
                    case Boost.dateTimeAtUtc model.jumpDate model.jumpTime of
                        Nothing ->
                            ( { model | jumpError = Just "Enter a valid UTC date and time." }, [] )

                        Just at ->
                            Tuple.mapFirst
                                (\traveled -> { traveled | showJumpToDate = False, jumpError = Nothing })
                                (requestTravelTo model target at)

        JumpToDateCopyMoment ->
            -- Copying shares the menu moment-link path
            -- (same `moment` clipboard tag and toasts).
            case model.activeChannel of
                Nothing ->
                    ( { model | jumpError = Just "Open a room or DM first." }, [] )

                Just target ->
                    case Boost.dateTimeAtUtc model.jumpDate model.jumpTime of
                        Nothing ->
                            ( { model | jumpError = Just "Enter a valid UTC date and time." }, [] )

                        Just at ->
                            case Invite.buildMomentLink model.origin target at of
                                Just link ->
                                    ( model, [ ClipboardCopy { text = link, tag = "moment" } ] )

                                Nothing ->
                                    ( addToast
                                        { variant = ToastError
                                        , title = "Copy failed"
                                        , description = Just "Moment link is unavailable."
                                        , duration = Nothing
                                        , groupKey = Nothing
                                        , undo = Nothing
                                        }
                                        model.nowMs
                                        model
                                    , []
                                    )

        MessageMenuDeleteAsk ->
            -- The destructive action arms a confirm step first
            -- (mirroring the oracle inline delete confirmation).
            case model.messageMenu of
                Nothing ->
                    ( model, [] )

                Just open ->
                    ( { model | messageMenu = Just { open | confirmDelete = True } }, [] )

        MessageMenuCopy { target, msgid } ->
            -- Menu text copy resolves the live row (never retained
            -- text) and reports through the tagged clipboard result
            -- with the oracle copy; a gone row just closes the menu.
            case reactionRow model target msgid of
                Nothing ->
                    ( { model | messageMenu = Nothing }, [] )

                Just row ->
                    case loadedActionText row of
                        Nothing ->
                            ( { model | messageMenu = Nothing }, [] )

                        Just text ->
                            ( { model | messageMenu = Nothing }
                            , [ ClipboardCopy { text = text, tag = "message-copy" } ]
                            )

        MessageSearchText { text } ->
            -- Menu search opens the panel carrying the message text
            -- (mirroring the oracle search-this-text action).
            ( scheduleVaultSearch { model | messageMenu = Nothing, searchOpen = True, searchQuery = Search.boundQueryInput text, searchIndex = 0 }, [] )

        TranslationConfig { available, target, browserLang } ->
            -- On-device translator probe result (mirroring
            -- `localTranslationReadiness` plus the stored target and
            -- the browser fallback language).
            ( { model | translationAvailable = available, translationTarget = target, translationBrowserLang = browserLang }, [] )

        TranslationTargetSet { target } ->
            -- Persist the on-device translation target (mirroring
            -- `setTranslationTarget`: normalised to its primary
            -- subtag; an unchanged value stays silent).
            let
                next =
                    Translate.normalizeLang target
            in
            if next == model.translationTarget then
                ( model, [] )

            else
                ( { model | translationTarget = next }
                , [ TranslationTargetSave { target = next } ]
                )

        MessageTranslate { target, msgid } ->
            -- Menu on-device translation (mirroring
            -- `translateOnDevice`: unknown rows, missing text, and an
            -- unavailable translator refuse silently; an in-flight
            -- request is never duplicated; past four concurrent
            -- translations the new one reports busy).
            case reactionRow model target msgid of
                Nothing ->
                    ( model, [] )

                Just row ->
                    case loadedActionText row of
                        Nothing ->
                            ( model, [] )

                        Just source ->
                            if not model.translationAvailable then
                                ( model, [] )

                            else
                                case Dict.get msgid model.translations of
                                    Just existing ->
                                        if existing.status == TranslationPending then
                                            ( model, [] )

                                        else
                                            startTranslation model msgid source

                                    Nothing ->
                                        startTranslation model msgid source

        TranslationResult { msgid, lang, source, ok, text } ->
            -- Stale completions (wrong row, language, or source, or
            -- nothing pending) never land — mirroring the oracle
            -- epoch guards.
            case Dict.get msgid model.translations of
                Nothing ->
                    ( model, [] )

                Just entry ->
                    if entry.status /= TranslationPending || entry.lang /= lang || entry.source /= source then
                        ( model, [] )

                    else if ok then
                        ( { model | translations = Dict.insert msgid { entry | status = TranslationDone, text = text } model.translations }, [] )

                    else
                        ( { model | translations = Dict.insert msgid { entry | status = TranslationFailed } model.translations }, [] )

        MessageTranslationDismiss { msgid } ->
            ( { model | translations = Dict.remove msgid model.translations }, [] )

        MessageTranslationCopy { msgid } ->
            -- Translation copy (mirroring `copyTranslatedText`: done
            -- state only, one copy at a time).
            case Dict.get msgid model.translations of
                Nothing ->
                    ( model, [] )

                Just entry ->
                    if entry.status /= TranslationDone || model.translationCopyPending /= Nothing then
                        ( model, [] )

                    else
                        ( { model
                            | translations = Dict.insert msgid { entry | copy = TranslationCopyPending } model.translations
                            , translationCopyPending = Just { msgid = msgid, lang = entry.lang }
                          }
                        , [ ClipboardCopy { text = entry.text, tag = "translation-copy" } ]
                        )

        MessagePinToggle { target, msgid } ->
            -- Menu pin toggle (mirroring `togglePin`: channel-target
            -- plus op only; anything else closes silently).
            if not (isChannelName model target && isChannelOp model target) then
                ( { model | messageMenu = Nothing }, [] )

            else if List.member msgid (channelPins model target) then
                Tuple.mapFirst (\m -> { m | messageMenu = Nothing }) (unpinMessage model target msgid)

            else
                Tuple.mapFirst (\m -> { m | messageMenu = Nothing }) (pinMessage model target msgid)

        MessageCollapseToggle { nick } ->
            -- Per-view flood control (mirroring `toggleNickCollapse`:
            -- device-local, session-only, with the oracle toasts; an
            -- empty nick is a no-op).
            let
                key =
                    String.toLower (String.trim nick)
            in
            if String.isEmpty key then
                ( model, [] )

            else if Set.member key model.collapsedNicks then
                ( addToast
                    { variant = ToastInfo
                    , title = "Showing " ++ String.trim nick
                    , description = Just "Their messages are visible in the feed again."
                    , duration = Nothing
                    , groupKey = Nothing
                    , undo = Nothing
                    }
                    model.nowMs
                    { model | collapsedNicks = Set.remove key model.collapsedNicks, messageMenu = Nothing }
                , []
                )

            else
                ( addToast
                    { variant = ToastInfo
                    , title = "Hiding " ++ String.trim nick
                    , description = Just "Their lines are hidden in this feed until you expand them. Device-only; not an ignore."
                    , duration = Nothing
                    , groupKey = Nothing
                    , undo = Nothing
                    }
                    model.nowMs
                    { model | collapsedNicks = Set.insert key model.collapsedNicks, messageMenu = Nothing }
                , []
                )

        MessageStartTopic { target, msgid } ->
            -- Mirror the menu topic-start: a usable label focuses the
            -- conversation on it and arms the message as the reply;
            -- otherwise a warning toast and no state change.
            case Dict.get (String.toLower target) model.channels of
                Nothing ->
                    ( model, [] )

                Just channel ->
                    case List.filter (\m -> m.msgid == Just msgid) channel.messages |> List.head of
                        Nothing ->
                            ( model, [] )

                        Just row ->
                            case Maybe.andThen suggestTopicLabel (loadedActionText row) of
                                Nothing ->
                                    ( addToast
                                        { variant = ToastWarning
                                        , title = "Topic not started"
                                        , description = Just "This message does not contain a usable topic label."
                                        , duration = Nothing
                                        , groupKey = Nothing
                                        , undo = Nothing
                                        }
                                        model.nowMs
                                        { model | messageMenu = Nothing }
                                    , []
                                    )

                                Just topic ->
                                    let
                                        armed =
                                            armReply model target msgid
                                    in
                                    ( { armed
                                        | activeChannelTopics = Dict.insert (String.toLower target) topic model.activeChannelTopics
                                        , messageMenu = Nothing
                                      }
                                    , []
                                    )

        MessageCopyMoment { target, at } ->
            case Invite.buildMomentLink model.origin target (toFloat at) of
                Just link ->
                    ( { model | messageMenu = Nothing }, [ ClipboardCopy { text = link, tag = "moment" } ] )

                Nothing ->
                    ( addToast
                        { variant = ToastError
                        , title = "Copy failed"
                        , description = Just "Moment link is unavailable."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        { model | messageMenu = Nothing }
                    , []
                    )

        ZoneReceived zone ->
            ( { model | zone = zone }, [] )

        ComposerSend ->
            case model.activeChannel of
                Nothing ->
                    ( model, [] )

                Just target ->
                    case activeEditFor model target of
                        Just edit ->
                            -- Edit mode: send becomes save (mirror the
                            -- oracle `handleSend` edit branch; edit
                            -- mode never carries staged attachments —
                            -- the send button is disabled there, and an
                            -- empty draft cannot save).
                            if String.isEmpty (String.trim model.composer) then
                                ( model, [] )

                            else
                                let
                                    ( edited, out ) =
                                        requestEdit model target edit.msgid model.composer
                                in
                                if List.isEmpty out then
                                    -- Refused (cap, transport, or the row
                                    -- changed under us): like the oracle
                                    -- `editMessage` refused path, the arm
                                    -- and the draft stay for retry and the
                                    -- refusal copy coaches (Elm has no
                                    -- admit-uncertain tier — every refusal
                                    -- here is a pre-send gate).
                                    ( { edited | composerError = Just "Edit was refused. Your replacement text is still here." }, [] )

                                else
                                    ( { edited | editingMessage = Nothing, composer = "", composerDrafts = Dict.remove (String.toLower target) edited.composerDrafts }, out )

                        Nothing ->
                            if not (List.isEmpty model.attachments) then
                                sendWithAttachments model target

                            else if String.isEmpty (String.trim model.composer) then
                                ( model, [] )

                            else
                                let
                                    trimmed =
                                        String.trim model.composer

                            -- Text-only conveniences (`/shrug` family)
                            -- expand to ordinary text first, mirroring the
                            -- oracle composer (`expandSlashTextCommand`
                            -- over the trimmed draft); anything else
                                -- passes through byte-identical.
                                    outgoing =
                                        if String.startsWith "/" trimmed then
                                            expandSlashTextCommand trimmed

                                        else
                                            model.composer

                                    sending =
                                        { model | composer = outgoing }
                                in
                                if isBlockedDmTarget sending target then
                                    -- A DM to a locally blocked nick refuses before
                                    -- anything else (mirroring the oracle composer
                                    -- gate): the draft stays for unblock-and-send.
                                    refuseBlockedDm sending target

                                else if sending.composerAudience /= Nothing && composerSendTarget sending target == Nothing then
                                    -- A set audience that can no longer be honored
                                    -- (room left, prefix withdrawn) refuses instead of
                                    -- widening an ops-only message to everyone.
                                    ( logService sending "Status audience unavailable here — message not sent.", [] )

                                else if String.startsWith "/" outgoing && sending.connection /= Live then
                                    -- Real commands never queue from the offline
                                    -- outbox (mirroring the oracle composer
                                    -- guard): the draft stays, the inline error
                                    -- coaches, nothing emits.
                                    ( { model | composerError = Just "Commands can't be queued. Reconnect to run this command." }, [] )

                                else
                                    -- v3/gap-commands: translated verbs, then local
                                    -- verbs, then the raw wire fallthrough.
                                    dispatchComposerSlash sending target outgoing

        ChannelLinkClicked raw ->
            -- A `#channel` link in a message body (mirrors the oracle
            -- `navigate({ kind: 'channel' })`): a known room opens; an
            -- unknown, valid one joins and opens on the self-JOIN echo
            -- through the pending-join triple. Offline or invalid names
            -- do nothing.
            case parseDeepLinkJoin raw of
                Nothing ->
                    ( model, [] )

                Just channel ->
                    if Dict.member (String.toLower channel) model.channels then
                        updateCore (ChannelSelect channel) model

                    else if model.connection /= Live then
                        ( model, [] )

                    else
                        ( { model | pendingDeepLinkJoin = Just channel }
                        , [ SendLine (Wire.formatIrcLine "JOIN" [ channel ]) ]
                        )

        -- v3/home
        HomeMarkAllCaughtUp ->
            homeMarkAllCaughtUp model

        HomeCoachDismiss ->
            -- v3/polish: the dismissal persists in `onyx:first-hour-seen`
            -- (mirroring `markFirstHourSeen`).
            let
                firstHour =
                    model.polish
            in
            ( { model | homeCoachDismissed = True, polish = { firstHour | firstHourPersisted = True } }
            , if firstHour.firstHourPersisted then
                []

              else
                [ PolishFlagSave { key = Polish.firstHourSeenKey } ]
            )

        -- v3/polish
        PolishMsg pmsg ->
            polishUpdate pmsg model

        HomeInviteCopy ->
            ( model, [ ClipboardCopy { text = homeInviteUrl model, tag = "home-invite" } ] )

        ChannelSelect name ->
            -- A context switch dismisses the message menu and its
            -- translation with it, then re-opens a pinned forum
            -- with topics (mirroring the pinned-forum effect). An open
            -- media panel re-targets and refetches instead of flashing
            -- the previous room.
            let
                ( selected, selectOuts ) =
                    selectChannel model name

                switched =
                    openPinnedForum
                        { selected | messageMenu = Nothing, reactionPicker = Nothing, translations = Dict.empty }
                        name
            in
            if switched.mediaIndexOpen then
                let
                    key =
                        String.toLower name
                in
                ( { switched
                    | mediaIndexTarget = key
                    , mediaIndexVault = []
                    , mediaIndexVaultState = MediaVaultLoading
                    , mediaIndexOwner = mediaOwnerKey switched
                  }
                , selectOuts ++ [ VaultFetch { target = key, limit = keepMessages } ]
                )

            else
                ( switched, selectOuts )

        ChannelTopicSelect { channel, topic } ->
            -- Named-conversation selection (mirrors
            -- `openChannelConversation`: validated topics select,
            -- stale/invalid topics fall back to the whole room).
            let
                key =
                    String.toLower channel
            in
            case topic of
                Nothing ->
                    -- Falling back to the whole room persists every
                    -- consumed named boundary first (mirroring the
                    -- `navigate` whole-room arm).
                    let
                        ( marked, markOuts ) =
                            markAllChannelTopicsRead model channel
                    in
                    ( { marked | activeChannelTopics = Dict.remove key marked.activeChannelTopics }, markOuts )

                Just requested ->
                    case resolveKnownChannelTopic model channel requested of
                        Just valid ->
                            -- Selecting a named conversation persists its
                            -- consumed boundary (mirroring
                            -- `openExistingTopic`: mark latest, then
                            -- re-project the parent room).
                            let
                                inserted =
                                    { model | activeChannelTopics = Dict.insert key valid model.activeChannelTopics }

                                ( marked, markOuts ) =
                                    markLatestChannelTopicRead inserted channel valid
                            in
                            ( reconcileChannelTopicUnread marked key, markOuts )

                        Nothing ->
                            ( { model | activeChannelTopics = Dict.remove key model.activeChannelTopics }, [] )

        PinnedMessageRequest req ->
            requestPinnedMessage model req.channel req.messageId

        PinnedMessagesOpen ->
            ( { model | showPinnedMessages = True, pinsLoadFeedback = "" }, [] )

        PinnedMessagesClose ->
            ( { model | showPinnedMessages = False }, [] )

        PinnedMessageJump req ->
            jumpToPinned model req.channel req.messageId

        PinnedMessagePin req ->
            pinMessage model req.channel req.messageId

        PinnedMessageUnpin req ->
            unpinMessage model req.channel req.messageId

        ThreadShowEarlier ->
            -- Reveal older rows without losing the live tail
            -- (mirroring `showEarlierMessages`: grow the tail
            -- capacity by one step while pinned to it, otherwise
            -- page the window back by one rendered screen; a
            -- leftover unread divider never steals the window
            -- back afterwards).
            case model.activeChannel of
                Nothing ->
                    ( model, [] )

                Just name ->
                    case Dict.get (String.toLower name) model.channels of
                        Nothing ->
                            ( model, [] )

                        Just channel ->
                            let
                                win =
                                    threadWindowFor model channel
                            in
                            if win.hiddenBefore <= 0 then
                                -- Window shows the oldest buffered row:
                                -- page further back from the server
                                -- (mirrors `loadHistory` rewind).
                                requestRewindHistory model name

                            else if win.hiddenAfter == 0 && model.threadWindowSize < MessageWindow.maxWindowRows then
                                ( { model
                                    | threadWindowSize = min MessageWindow.maxWindowRows (model.threadWindowSize + threadWindowStep)
                                    , ignoreUnreadAnchor = True
                                  }
                                , []
                                )

                            else
                                ( { model
                                    | threadPageStart = Just (max 0 (win.start - win.rendered))
                                    , ignoreUnreadAnchor = True
                                  }
                                , []
                                )

        ThreadShowLatest ->
            -- Jump back to the live tail (mirroring the latest
            -- pill: trailing window, and no leftover unread divider
            -- steals it back).
            let
                trailed =
                    resetThreadWindow model
            in
            ( { trailed | ignoreUnreadAnchor = True }, [] )

        -- v3/transcript
        TranscriptScrolled report ->
            -- Fold one `scrollState` report: the newest row time of
            -- the reported conversation is the "new below" baseline.
            let
                latestAt =
                    Dict.get report.key model.channels
                        |> Maybe.andThen (.messages >> List.head)
                        |> Maybe.map .at
                        |> Maybe.withDefault 0

                next =
                    TranscriptRows.awayAfterReport report latestAt model.transcriptAway
            in
            if next == model.transcriptAway then
                ( model, [] )

            else
                ( { model | transcriptAway = next }, [] )

        TranscriptJumpLatest ->
            -- The "Jump to latest" pill: trailing window (like
            -- `ThreadShowLatest`), clear the away state, and ask the
            -- bridge to pin the log to the bottom.
            let
                trailed =
                    resetThreadWindow model
            in
            ( { trailed | ignoreUnreadAnchor = True, transcriptAway = Nothing }
            , case model.activeChannel of
                Just name ->
                    [ TranscriptScroll { action = "bottom", key = TranscriptRows.scrollKey name } ]

                Nothing ->
                    []
            )

        IgnoreUser _ ->
            foldBlocklistAction model msg

