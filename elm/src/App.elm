type alias RetentionReadScope =
    { kind : String
    , policyRevision : Maybe String
    , lastSyncMs : Maybe Float
    }


type alias RetentionScopeEntry =
    { conversationId : String
    , scope : RetentionReadScope
    }


unknownRetentionReadScope : RetentionReadScope
unknownRetentionReadScope =
    { kind = "unknown", policyRevision = Nothing, lastSyncMs = Nothing }


{-| SASL exchange state, mirroring the oracle's `_saslPending` /
`_saslMech`: idle, or one exchange of the selected mechanism in
flight. Secrets never enter the model — the password lives
ports-side; the model only knows one is held. -}
type SaslExchange
    = SaslIdle
    | SaslPending Wire.SaslMechanism


{-| Visible phase of the automatic resume handshake the client runs on
every `001` (`Session.planSessionReclaim`, mirroring the oracle's
`sessionReclaim` banner state). -}
type ReclaimPhase
    = Restoring
    | Reclaimed
    | ReclaimFailed
    | SignInAgain


{-| UI-facing projection of the reclaim decision: the phase plus which
Bearer [REDACTED] in play (present for `Restoring`/`Reclaimed` only).
-}
type alias SessionReclaimNotice =
    { phase : ReclaimPhase
    , kind : Maybe Session.ReclaimTokenKind
    , credentialKind : Maybe Session.CredentialKind
    , credentialRef : Maybe Ids.CredentialRef
    , outcome : Session.ResumeOutcome
    }


{-| A signature-verified delivery awaiting directory admission: the
routing needed to admit its signer once the directory marks trust.
-}
type alias PendingControl =
    { epoch : Int
    , signerB64 : String
    , fromAccount : String
    , fromDevice : String
    , toAccount : Maybe String
    , toDevice : Maybe String
    , payload : String
    , kind : GroupControl.ControlKind
    }


{-| Effect intentions for the `Main` port module to perform. -}
type AttachmentStatus
    = StagedReady
    | StagedUploading
    | StagedUploaded String
    | StagedFailed


type alias StagedAttachment =
    { id : Int
    , key : String
    , position : Int
    , name : String
    , size : Float
    , mime : String
    , status : AttachmentStatus
    , progress : Maybe Int
    }


