{-| Durable and inactive-target retention bound. This stays aligned with
`VAULT_KEEP = 400`; the active conversation has a separate larger in-memory
horizon so a live history session can hold 1,000 rows without expanding disk
retention.
-}
keepMessages : Int
keepMessages =
    400


{-| Active in-memory conversation horizon. The rendered message window remains
bounded separately by `View.Thread`.
-}
activeConversationKeep : Int
activeConversationKeep =
    1000


messageRetentionFor : Model -> String -> Int
messageRetentionFor model target =
    case model.activeChannel of
        Just active ->
            if String.toLower active == String.toLower target then
                activeConversationKeep

            else
                keepMessages

        _ ->
            keepMessages


{-| Server-log lines retained for WALLOPS and other unscoped notices.
Mirrors the oracle `serverLog` `.slice(-500)` cap. -}
maxServiceLog : Int
maxServiceLog =
    500


{-| Oracle `MAX_SERVER_AUX_TEXT_LENGTH` (4 KiB): server-log text bound. -}
maxSystemEventTextLength : Int
maxSystemEventTextLength =
    4 * 1024


{-| Mirror of the oracle `_boundedSystemEventText`: slice to
`maxSystemEventTextLength` UTF-16 code units (`String.slice` shares the
JS-string code-unit semantics) and drop a trailing lone high
surrogate. If Elm normalizes lone surrogates on iteration the range
check simply never fires — still safe. -}
dropTrailingHighSurrogate : String -> String
dropTrailingHighSurrogate text =
    -- A slice can strand the high half of an astral pair as the last
    -- UTF-16 unit (mirroring the oracle's `charCodeAt` repair). The
    -- tail must be read as a raw unit: decoding it to a Char first
    -- normalizes a lone surrogate to U+FFFD and the guard misses.
    -- String slicing and ordering both run on units, so a sliced
    -- lone unit compares exactly; the bounds are sliced off real
    -- pairs (`U+10000` → `D800`, `U+10FC00` → `DBFF`) because a lone
    -- surrogate is not a writable literal.
    let
        tail =
            String.right 1 text
    in
    if tail >= String.left 1 "\u{10000}" && tail <= String.left 1 "\u{10FC00}" then
        String.dropRight 1 text

    else
        text


boundSystemEventText : String -> String
boundSystemEventText value =
    dropTrailingHighSurrogate (String.slice 0 maxSystemEventTextLength value)


