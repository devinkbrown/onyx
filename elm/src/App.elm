        CertRemoveSubmitted ->
            -- Mirror the oracle's remove-cert submit: delete, then
            -- re-list; a refused delete (guest/offline/blank)
            -- leaves the input in place.
            let
                trimmed =
                    String.trim model.certFingerprint

                ( deleted, delOut ) =
                    requestCertDel model trimmed
            in
            if List.isEmpty delOut then
                -- Refused (guest/offline/blank): stay silent and keep
                -- the input for correction.
                ( deleted, [] )

            else
                let
                    ( listed, listOut ) =
                        requestCertList deleted
                in
                ( { listed | certFingerprint = "" }, delOut ++ listOut )

