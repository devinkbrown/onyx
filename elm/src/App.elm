{-| Resolve a slash-command by name or alias (mirroring
`findSlashCommand`: one leading `/` stripped, case-insensitive,
oper verbs resolve like any other). -}
findSlashCommand : String -> Maybe SlashCommand
findSlashCommand raw =
    let
        needle =
            String.toLower
                (if String.startsWith "/" raw then
                    String.dropLeft 1 raw

                 else
                    raw
                )
    in
    List.filter
        (\command -> command.name == needle || List.member needle command.aliases)
        slashCommands
        |> List.head


{-| The `/help` bare-list names (mirroring the oracle filter: the local
verbs summarized when no command is named). -}
localSlashCommandNames : List String
localSlashCommandNames =
    [ "clear", "search", "read", "star", "mute", "autojoin", "highlight", "snooze", "dnd", "color", "share", "export", "notify", "help", "ignore" ]


{-| The `/help` bare-list line (mirroring the oracle: registry order,
`/`-prefixed, ` · `-joined, with the composer-hint fallback). -}
localSlashCommandList : String
localSlashCommandList =
    let
        listed =
            List.filter (\command -> List.member command.name localSlashCommandNames) slashCommands
                |> List.map (\command -> "/" ++ command.name)
                |> String.join " · "
    in
    if String.isEmpty listed then
        "Type / in the composer for suggestions."

    else
        listed


maxEventTitleChars : Int
maxEventTitleChars =
    180


eventFutureWindowMs : Float
eventFutureWindowMs =
    366 * 24 * 60 * 60 * 1000


eventClockSkewMs : Float
eventClockSkewMs =
    5 * 60 * 1000


{-| Sanitize a channel-event title (mirroring `scheduleEvent`: every
maximal CR/LF run folds to one space, then trim and cap at 180 chars —
pre-existing spaces outside line breaks survive untouched). -}
sanitizeEventTitle : String -> String
sanitizeEventTitle raw =
    let
        step char ( out, inBreak ) =
            if char == '\u{000D}' || char == '\u{000A}' then
                if inBreak then
                    ( out, True )

                else
                    ( out ++ " ", True )

            else
                ( out ++ String.fromChar char, False )

        ( folded, _ ) =
            List.foldl step ( "", False ) (String.toList raw)
    in
    String.left maxEventTitleChars (String.trim folded)


{-| Days since the Unix epoch for a civil date (Howard Hinnant's
algorithm; inputs are digit-validated and non-negative, so truncating
`//` is exact). -}
civilToEpochDays : Int -> Int -> Int -> Int
civilToEpochDays year month day =
    let
        y =
            if month <= 2 then
                year - 1

            else
                year

        era =
            y // 400

        yoe =
            y - era * 400

        mp =
            if month > 2 then
                month - 3

            else
                month + 9

        doy =
            (153 * mp + 2) // 5 + day - 1

        doe =
            yoe * 365 + yoe // 4 - yoe // 100 + doy
    in
    era * 146097 + doe - 719468


isLeapYear : Int -> Bool
isLeapYear year =
    (modBy 4 year == 0 && modBy 100 year /= 0) || modBy 400 year == 0


daysInMonth : Int -> Int -> Int
daysInMonth year month =
    case month of
        1 ->
            31

        2 ->
            if isLeapYear year then
                29

            else
                28

        3 ->
            31

        4 ->
            30

        5 ->
            31

        6 ->
            30

        7 ->
            31

        8 ->
            31

        9 ->
            30

        10 ->
            31

        11 ->
            30

        12 ->
            31

        _ ->
            0


{-| Parse a fixed-width digit field (`Just` value on all-digits input). -}
parseDigitField : String -> Maybe Int
parseDigitField part =
    if String.isEmpty part || not (String.all Char.isDigit part) then
        Nothing

    else
        String.toInt part


{-| Split an ISO-8601 time tail into its clock part and zone suffix
(`Z`/`z`, `±hh:mm`, or `±hhmm`; anything else fails — the time tail
never carries `-` except in the zone, so the last sign wins). -}
splitIsoZone : String -> Maybe ( String, Int )
splitIsoZone tail =
    if String.isEmpty tail then
        Just ( "", 0 )

    else if String.endsWith "Z" tail || String.endsWith "z" tail then
        Just ( String.dropRight 1 tail, 0 )

    else
        let
            lastIndex sub =
                List.head (List.reverse (String.indexes sub tail))

            at =
                case ( lastIndex "+", lastIndex "-" ) of
                    ( Just plus, Just minus ) ->
                        Just (max plus minus)

                    ( Just plus, Nothing ) ->
                        Just plus

                    ( Nothing, Just minus ) ->
                        Just minus

                    ( Nothing, Nothing ) ->
                        Nothing
        in
        case at of
            Nothing ->
                Just ( tail, 0 )

            Just idx ->
                parseIsoZoneHours (String.left idx tail) (String.dropLeft idx tail)


{-| Resolve an ISO-8601 zone suffix to offset minutes. -}
parseIsoZoneHours : String -> String -> Maybe ( String, Int )
parseIsoZoneHours clock zone =
    case String.uncons zone of
        Just ( sign, rest ) ->
            if sign /= '+' && sign /= '-' then
                Nothing

            else
                let
                    digits =
                        String.filter Char.isDigit rest

                    -- Verified against V8: colon forms need exactly two
                    -- digits per field (`+2:30`, `+05:3` fail), the packed
                    -- form needs exactly four (`+0059` reads as `+00:59`),
                    -- and a bare `±hh` fails.
                    magnitude =
                        case String.split ":" rest of
                            [ hours, minutes ] ->
                                if String.length hours /= 2 || String.length minutes /= 2 then
                                    Nothing

                                else
                                    case ( parseDigitField hours, parseDigitField minutes ) of
                                        ( Just h, Just m ) ->
                                            if h > 23 || m > 59 then
                                                Nothing

                                            else
                                                Just (h * 60 + m)

                                        _ ->
                                            Nothing

                            [ _ ] ->
                                if String.length digits == 4 && String.length rest == 4 then
                                    case ( parseDigitField (String.left 2 digits), parseDigitField (String.dropLeft 2 digits) ) of
                                        ( Just h, Just m ) ->
                                            if h > 23 || m > 59 then
                                                Nothing

                                            else
                                                Just (h * 60 + m)

                                        _ ->
                                            Nothing

                                else
                                    Nothing

                            _ ->
                                Nothing
                in
                case magnitude of
                    Just mins ->
                        Just
                            ( clock
                            , if sign == '+' then
                                mins

                              else
                                -mins
                            )

                    Nothing ->
                        Nothing

        Nothing ->
            Nothing


{-| Parse an ISO-8601 calendar moment to epoch milliseconds (mirroring
the `Date.parse` fallback inside `parseEventTime`, narrowed to the
documented interchange forms: `YYYY-MM-DD` (UTC midnight) and
`YYYY-MM-DD[T ]hh:mm[:ss][.frac][zone]` with zones limited to `Z` /
`±hh:mm` / `±hhmm` (a bare `±hh` fails `Date.parse` too); zone-less
times read as UTC since Elm has no local-timezone API, and out-of-range
fields fail where the engine would coerce — see docs/COVERAGE.md). -}
parseIso8601Ms : String -> Maybe Float
parseIso8601Ms raw =
    let
        trimmed =
            String.trim raw

        ( datePart, timePart ) =
            case String.indexes "T" trimmed of
                at :: _ ->
                    ( String.left at trimmed, String.dropLeft (at + 1) trimmed )

                [] ->
                    case String.indexes " " trimmed of
                        at :: _ ->
                            ( String.left at trimmed, String.dropLeft (at + 1) trimmed )

                        [] ->
                            ( trimmed, "" )
    in
    case String.split "-" datePart of
        [ yearText, monthText, dayText ] ->
            if String.length yearText /= 4 || String.length monthText /= 2 || String.length dayText /= 2 then
                Nothing

            else
                case ( parseDigitField yearText, parseDigitField monthText, parseDigitField dayText ) of
                    ( Just year, Just month, Just day ) ->
                        if month < 1 || month > 12 || day < 1 || day > daysInMonth year month then
                            Nothing

                        else
                            parseIsoTime (toFloat (civilToEpochDays year month day) * 86400000) timePart True

                    _ ->
                        Nothing

        _ ->
            Nothing


{-| Parse the time tail of an ISO-8601 moment over a UTC-midnight base
(`dateOnly` allows the bare `YYYY-MM-DD` form; anything else needs a
clock). -}
parseIsoTime : Float -> String -> Bool -> Maybe Float
parseIsoTime dayMs tail dateOnly =
    if String.isEmpty tail then
        if dateOnly then
            Just dayMs

        else
            Nothing

    else
        case splitIsoZone tail of
            Nothing ->
                Nothing

            Just ( clock, offsetMins ) ->
                case String.split ":" clock of
                    [ hoursText, minutesText ] ->
                        combineIsoClock dayMs hoursText minutesText Nothing offsetMins

                    [ hoursText, minutesText, secondsText ] ->
                        let
                            ( wholeSeconds, fracMs ) =
                                case String.split "." secondsText of
                                    [ whole ] ->
                                        ( whole, 0 )

                                    whole :: frac :: _ ->
                                        ( whole
                                        , Maybe.withDefault 0
                                            (String.toInt (String.left 3 (frac ++ "000")))
                                        )

                                    [] ->
                                        ( "", 0 )
                        in
                        combineIsoClock dayMs hoursText minutesText (Just ( wholeSeconds, fracMs )) offsetMins

                    _ ->
                        Nothing


{-| Combine one validated ISO clock over the day base (seconds optional;
fractional seconds truncate to millisecond precision). -}
combineIsoClock : Float -> String -> String -> Maybe ( String, Int ) -> Int -> Maybe Float
combineIsoClock dayMs hoursText minutesText seconds offsetMins =
    if String.length hoursText /= 2 || String.length minutesText /= 2 then
        Nothing

    else
        case ( parseDigitField hoursText, parseDigitField minutesText ) of
            ( Just hours, Just minutes ) ->
                if hours > 23 || minutes > 59 then
                    Nothing

                else
                    case seconds of
                        Nothing ->
                            Just (dayMs + toFloat ((hours * 60 + minutes - offsetMins) * 60 * 1000))

                        Just ( wholeSeconds, fracMs ) ->
                            if String.length wholeSeconds /= 2 then
                                Nothing

                            else
                                case parseDigitField wholeSeconds of
                                    Just whole ->
                                        if whole > 59 then
                                            Nothing

                                        else
                                            Just (dayMs + toFloat ((hours * 60 + minutes - offsetMins) * 60 + whole) * 1000 + toFloat fracMs)

                                    Nothing ->
                                        Nothing

            _ ->
                Nothing


{-| Parse an event moment (mirroring `parseEventTime`: 1–10 digit unix
seconds, 11–14 digit unix milliseconds, else an ISO-8601 calendar
moment; the result must fall inside `[now - skew, now + 366d]`).
Returns unix seconds like the oracle hands to `scheduleEvent`. -}
parseEventTimeMs : Float -> String -> Maybe Int
parseEventTimeMs nowMs raw =
    let
        trimmed =
            String.trim raw

        moment =
            if String.isEmpty trimmed then
                Nothing

            else if String.all Char.isDigit trimmed then
                if String.length trimmed <= 10 then
                    Maybe.map (\secs -> toFloat secs * 1000) (String.toInt trimmed)

                else if String.length trimmed <= 14 then
                    String.toFloat trimmed

                else
                    parseIso8601Ms trimmed

            else
                parseIso8601Ms trimmed
    in
    case moment of
        Nothing ->
            Nothing

        Just ms ->
            if ms < nowMs - eventClockSkewMs || ms > nowMs + eventFutureWindowMs then
                Nothing

            else
                Just (floor (ms / 1000))


{-| Write one channel prop optimistically (mirroring
`_writeChannelProp`: normalized target/name, raw values over the live
cap drop, empty values delete through the bounded registry). -}
writeChannelProp : String -> String -> String -> Ircx.PropState -> Ircx.PropState
writeChannelProp channel key value props =
    if String.length value > Ircx.maxLivePropValueLength then
        props

    else
        case ( Ircx.normalizePropertyTarget (Just channel), Ircx.normalizePropertyName (Just key) ) of
            ( Just target, Just name ) ->
                case Ircx.updateBoundedProperties props.channelProps (String.toLower target) name (Ircx.boundedPropertyValue value) True of
                    Just next ->
                        { props | channelProps = next }

                    Nothing ->
                        props

            _ ->
                props


-- v3/gap-watch


{-| Watch Together reads the model through `WatchTogether.context`;
writing needs a live IRCX link (and, server-side, channel operator
status — the context carries that too). -}
watchCtx : Model -> WatchTogether.Ctx
watchCtx model =
    WatchTogether.context (model.connection == Live && model.isupport.ircx) model


{-| `WatchMsg`: run the feature update, then turn its effects into
outbound `PROP` lines, focus moves, the preference write and toasts. -}
watchUpdate : WatchTogether.Msg -> Model -> ( Model, List Outbound )
watchUpdate sub model =
    let
        ( next, effects ) =
            WatchTogether.update (watchCtx model) sub model.watch
    in
    watchEffects effects ( { model | watch = next }, [] )


watchEffects : List WatchTogether.Effect -> ( Model, List Outbound ) -> ( Model, List Outbound )
watchEffects effects acc =
    List.foldl watchEffect acc effects


watchEffect : WatchTogether.Effect -> ( Model, List Outbound ) -> ( Model, List Outbound )
watchEffect effect ( model, outs ) =
    case effect of
        WatchTogether.Publish channel value ->
            ( model, outs ++ [ SendLine (Wire.formatIrcLine "PROP" [ channel, WatchTogether.propKey, value ]) ] )

        WatchTogether.Remove channel ->
            -- An empty trailing value deletes (`PROP <#room> ocean.watch :`).
            ( model, outs ++ [ SendLine (Wire.formatIrcLine "PROP" [ channel, WatchTogether.propKey, "" ]) ] )

        WatchTogether.LocalDelete channel ->
            ( { model | props = watchDeleteLocal channel model.props }, outs )

        WatchTogether.Focus target ->
            ( model, outs ++ [ PrefsFocus { id = target } ] )

        WatchTogether.SetEnabled on ->
            let
                ( next, more ) =
                    updateCore
                        (AppearanceSetPref
                            { key = "watchTogether"
                            , value =
                                if on then
                                    "true"

                                else
                                    "false"
                            }
                        )
                        model
            in
            ( next, outs ++ more )

        WatchTogether.Toast tone title description ->
            ( addToast
                { variant =
                    case tone of
                        WatchTogether.Info ->
                            ToastInfo

                        WatchTogether.Problem ->
                            ToastError
                , title = title
                , description = Just description
                , duration = Nothing
                , groupKey = Just "watch-together"
                , undo = Nothing
                }
                model.nowMs
                model
            , outs
            )


{-| Drop a room's `ocean.watch` row (any key case) after the server
confirmed our delete with `819` — the setter gets no `PROP` echo. -}
watchDeleteLocal : String -> Ircx.PropState -> Ircx.PropState
watchDeleteLocal channel props =
    let
        key =
            String.toLower channel
    in
    case Dict.get key props.channelProps of
        Just entries ->
            let
                pruned =
                    Dict.filter (\k _ -> String.toLower k /= WatchTogether.propKey) entries
            in
            { props
                | channelProps =
                    if Dict.isEmpty pruned then
                        Dict.remove key props.channelProps

                    else
                        Dict.insert key pruned props.channelProps
            }

        Nothing ->
            props


{-| Every room's raw `ocean.watch` value. -}
watchRaws : Model -> List ( String, String )
watchRaws model =
    Dict.foldl
        (\channel entries acc ->
            case WatchTogether.rawIn entries of
                Just raw ->
                    ( channel, raw ) :: acc

                Nothing ->
                    acc
        )
        []
        model.props.channelProps


{-| Post-update: fold server answers into the in-flight change (`818`
/ `819` / `913` / `461`), time it out, retire room-scoped state when
the room or its value changes, close the More menu after its Watch
together entry, and anchor the shared clock of every newly seen value.
-}
settleStepWatch : Msg -> Model -> ( Model, List Outbound ) -> ( Model, List Outbound )
settleStepWatch msg prior ( m, outs ) =
    let
        ctx =
            watchCtx m

        lines =
            if m.watch.pending == Nothing then
                []

            else
                case msg of
                    WsLineReceived line ->
                        [ Wire.parseIrcMessage line ]

                    WsBatchReceived batch ->
                        List.map Wire.parseIrcMessage batch.lines

                    _ ->
                        []

        ( afterLines, lineFx ) =
            List.foldl (WatchTogether.settleLine ctx) ( m.watch, [] ) lines

        ticked =
            case msg of
                Tick _ ->
                    WatchTogether.settleTick ctx afterLines

                _ ->
                    afterLines

        ( roomed, roomFx ) =
            WatchTogether.settleRoom
                { channel = prior.activeChannel
                , raw = prior.activeChannel |> Maybe.andThen (watchCtx prior).rawFor
                }
                ctx
                ticked

        menuClosed =
            case msg of
                WatchMsg (WatchTogether.MenuSelect _) ->
                    { m | roomMenuOpen = False, watch = roomed }

                _ ->
                    { m | watch = roomed }

        ( applied, settledOuts ) =
            watchEffects (lineFx ++ roomFx) ( menuClosed, outs )
    in
    if prior.props.channelProps == applied.props.channelProps then
        ( applied, settledOuts )

    else
        ( { applied | watch = WatchTogether.reconcile applied.nowMs (watchRaws applied) applied.watch }, settledOuts )


{-| Cap on pinned msgids per channel (mirrors the `slice(-50)` in
`pinMessage`). -}
maxChannelPins : Int
maxChannelPins =
    50


{-| Pinned msgids for a channel, parsed from its IRCX `PINS` prop
oldest to newest (mirrors `selectChannelPins`: comma split, trim,
drop empties). -}
channelPins : Model -> String -> List String
channelPins model channel =
    case Dict.get (String.toLower channel) model.props.channelProps of
        Nothing ->
            []

        Just props ->
            case Dict.get "PINS" props of
                Nothing ->
                    []

                Just raw ->
                    List.filterMap
                        (\id ->
                            let
                                clean =
                                    String.trim id
                            in
                            if String.isEmpty clean then
                                Nothing

                            else
                                Just clean
                        )
                        (String.split "," raw)


{-| Rewrite a channel's `PINS` prop locally and publish it
(mirrors `_writePins` through `_writeChannelProp`: the whole list
publishes as one `PROP SET`, with the optimistic local update the
drawer reacts to). -}
writePins : Model -> String -> List String -> ( Model, List Outbound )
writePins model channel msgids =
    let
        updated =
            { model | props = writeChannelProp channel "PINS" (String.join "," msgids) model.props }

        wire =
            if model.connection == Live && model.isupport.ircx then
                [ SendLine (Wire.formatIrcLine "PROP" [ channel, "PINS", String.join "," msgids ]) ]

            else
                []
    in
    ( updated, wire )


{-| Pin a message (mirrors `pinMessage`: dup pins no-op, newest
appends with the 50-newest cap). -}
pinMessage : Model -> String -> String -> ( Model, List Outbound )
pinMessage model channel msgid =
    let
        current =
            channelPins model channel
    in
    if List.member msgid current then
        ( model, [] )

    else
        writePins model channel (List.drop (List.length current + 1 - maxChannelPins) (current ++ [ msgid ]))


{-| Unpin a message (mirrors `unpinMessage`: filter + whole-list
rewrite). -}
unpinMessage : Model -> String -> String -> ( Model, List Outbound )
unpinMessage model channel msgid =
    writePins model channel (List.filter (\id -> id /= msgid) (channelPins model channel))


type PinnedMessageState
    = PinDeleted
    | PinLocked
    | PinVisible


{-| Transcript-boundary state of a pinned row (mirrors
`pinnedMessageDisplayState`: withdrawn rows stay deleted, unopened
envelopes stay locked — never a second path to the screen). -}
pinnedMessageState : ChatMessage -> PinnedMessageState
pinnedMessageState message =
    if message.deleted || message.redacted then
        PinDeleted

    else if messageLocked message then
        PinLocked

    else
        PinVisible


{-| State badge copy (mirrors `pinnedMessageStateLabel`). -}
pinnedMessageStateLabel : PinnedMessageState -> String
pinnedMessageStateLabel state =
    case state of
        PinDeleted ->
            "Deleted"

        PinLocked ->
            "Locked"

        PinVisible ->
            "Loaded locally"


{-| Reuse the feed scroll/pulse landing (mirrors `focusMessage`:
whatever id sits here is what the thread scrolls to). -}
focusMessage : Model -> String -> Model
focusMessage model messageId =
    { model | historyLanding = Just messageId }


{-| Jump to a pinned message (mirrors the drawer `jumpTo`: a loaded
row focuses through the landing machinery and closes the drawer;
an unloaded row requests its window from history and closes on
admission, while a refused request leaves the drawer open with
feedback). -}
jumpToPinned : Model -> String -> String -> ( Model, List Outbound )
jumpToPinned model channel messageId =
    case reactionRow model channel messageId of
        Just _ ->
            let
                focused =
                    focusMessage model messageId
            in
            ( { focused | showPinnedMessages = False, pinsLoadFeedback = "" }, [] )

        Nothing ->
            let
                ( requested, out ) =
                    requestPinnedMessage model channel messageId
            in
            if List.isEmpty out then
                ( { requested | pinsLoadFeedback = "Pinned message could not be loaded from history. Try again." }, [] )

            else
                ( { requested | showPinnedMessages = False, pinsLoadFeedback = "" }, out )


{-| Device-vault fetch state for the media panel (mirrors the oracle
`RecentHistoryStatus`: Elm's bridge reports `ok` vs anything else, so
`partial` has no source and rides with failure — the recovered rows
still list).
-}
type MediaVaultState
    = MediaVaultLoading
    | MediaVaultReady
    | MediaVaultFailed


{-| Owner scope key recorded when the media panel fetches (mirrors the
oracle `mediaScopeKey`: responses crossing an owner change are
dropped, never painted). -}
mediaOwnerKey : Model -> String
mediaOwnerKey model =
    case deviceMemoryOwner model of
        Just owner ->
            owner.serverUrl ++ "\u{0000}" ++ owner.identity

        Nothing ->
            ""


{-| A live row mapped onto the media index (message ids dedupe
replays; envelope-shaped bodies gate as encrypted). -}
mediaRowOf : ChatMessage -> RoomMedia.MediaRow
mediaRowOf message =
    { id = Maybe.withDefault ("row:" ++ String.fromInt message.id) message.msgid
    , from = message.from
    , body = message.body
    , plaintext = message.plaintext
    , msgType = message.msgType
    , at = message.at
    , deleted = message.deleted
    , redacted = message.redacted
    , encrypted = isEncryptedRow message
    }


{-| A vault row mapped onto the media index (no transient plaintext
rides the vault, so envelope-shaped bodies gate as encrypted). -}
mediaRowOfVault : VaultRow -> RoomMedia.MediaRow
mediaRowOfVault row =
    { id = row.id
    , from = row.from
    , body = row.body
    , plaintext = Nothing
    , msgType = row.rowType
    , at = row.at
    , deleted = row.deleted
    , redacted = row.redacted
    , encrypted = DmCipher.isEnvelope row.body || GroupEnvelope.isGroupEnvelope row.body
    }


{-| The media index for the panel target: live rows merged under
recovered vault rows (mirrors the oracle `index` memo). Vault rows
carry `target:seq` ids while live rows carry msgids or `row:N`, so
the id merge cannot collapse a hydrated row with its vault twin the
way the oracle's shared id space does: vault rows repeating live
content collapse too, live winning. -}
mediaIndexFor : Model -> RoomMedia.RoomMediaIndex
mediaIndexFor model =
    let
        live =
            case Dict.get model.mediaIndexTarget model.channels of
                Just channel ->
                    List.map mediaRowOf channel.messages

                Nothing ->
                    []

        liveKeys =
            Set.fromList (List.map mediaContentKey live)

        vault =
            List.map mediaRowOfVault model.mediaIndexVault
                |> List.filter (\row -> not (Set.member (mediaContentKey row) liveKeys))
    in
    RoomMedia.indexRoomMedia (RoomMedia.mergeRoomHistory live vault)


{-| Content identity for live/vault twin collapse. -}
mediaContentKey : RoomMedia.MediaRow -> String
mediaContentKey row =
    row.from ++ "\u{0000}" ++ row.body ++ "\u{0000}" ++ String.fromInt row.at


{-| Jump to a media item: a loaded row focuses through the landing
machinery and closes the panel; anything else travels to the item's
stamp through the history machinery and closes too (vault rows carry
no wire msgid to pin by). -}
jumpToMedia : Model -> String -> String -> Int -> ( Model, List Outbound )
jumpToMedia model target messageId at =
    case reactionRow model target messageId of
        Just _ ->
            let
                focused =
                    focusMessage model messageId
            in
            ( closeMediaIndex focused, [] )

        Nothing ->
            let
                ( travelled, out ) =
                    requestTravelTo model target (toFloat at)
            in
            ( closeMediaIndex travelled, out )


{-| Clear every media-panel field. -}
closeMediaIndex : Model -> Model
closeMediaIndex model =
    { model
        | mediaIndexOpen = False
        , mediaIndexFilter = RoomMedia.Pictures
        , mediaIndexTarget = ""
        , mediaIndexVault = []
        , mediaIndexVaultState = MediaVaultLoading
        , mediaIndexOwner = ""
        , mediaPictureAllowed = Set.empty
    }


{-| Schedule a channel event (mirroring `scheduleEvent`: the title
sanitizes here, an empty title is a silent no-op, otherwise the
`ocean.event` prop lands locally and publishes as
`PROP <channel> ocean.event <unix>|<title>` on a live IRCX link). -}
scheduleChannelEvent : Model -> String -> Int -> String -> ( Model, List Outbound )
scheduleChannelEvent model channel unix rawTitle =
    let
        clean =
            sanitizeEventTitle rawTitle
    in
    if String.isEmpty clean then
        ( model, [] )

    else
        let
            value =
                String.fromInt unix ++ "|" ++ clean

            updated =
                { model | props = writeChannelProp channel "ocean.event" value model.props }

            wire =
                if model.connection == Live && model.isupport.ircx then
                    [ SendLine (Wire.formatIrcLine "PROP" [ channel, "ocean.event", value ]) ]

                else
                    []
        in
        ( updated, wire )


{-| Clear a channel event (mirroring `clearChannelEvent`: the prop
deletes locally and publishes the empty trailing value on a live IRCX
link — `PROP <channel> ocean.event :`). -}
clearChannelEvent : Model -> String -> ( Model, List Outbound )
clearChannelEvent model channel =
    let
        updated =
            { model | props = writeChannelProp channel "ocean.event" "" model.props }

        wire =
            if model.connection == Live && model.isupport.ircx then
                [ SendLine (Wire.formatIrcLine "PROP" [ channel, "ocean.event", "" ]) ]

            else
                []
    in
    ( updated, wire )


{-| Run `/event` (mirroring the oracle arm: offline the dispatch never
runs so only the consumed draft clears; outside a room the verb falls
through as a raw `EVENT` line; in a room an empty tail or
`clear`/`off` removes the event, otherwise `<when> <title>` schedules
it — success is silent, while a bad moment or a missing title warns
with `Event not set`). The tail re-splits from the composer so the
oracle's exact empty-arg edges survive. -}
runSlashEvent : Model -> String -> ( Model, List Outbound )
runSlashEvent model target =
    if model.connection /= Live then
        ( { model | composer = "" }, [] )

    else if not (isChannelName model target) then
        let
            params =
                case String.split " " (String.dropLeft 1 model.composer) of
                    _ :: args ->
                        args

                    [] ->
                        []
        in
        ( { model | composer = "" }, [ SendLine (Wire.formatIrcLine "EVENT" params) ] )

    else
        case String.split " " (String.dropLeft 1 model.composer) of
            _ :: args ->
                let
                    first =
                        String.toLower (Maybe.withDefault "" (List.head args))
                in
                if List.isEmpty args || first == "clear" || first == "off" then
                    let
                        ( updated, out ) =
                            clearChannelEvent model target
                    in
                    ( { updated | composer = "" }, out )

                else
                    let
                        title =
                            String.trim (String.join " " (Maybe.withDefault [] (List.tail args)))

                        moment =
                            parseEventTimeMs model.nowMs (Maybe.withDefault "" (List.head args))

                        warn =
                            ( addToast
                                { variant = ToastWarning
                                , title = "Event not set"
                                , description = Just "Use /event <YYYY-MM-DDThh:mmZ> <title>."
                                , duration = Nothing
                                , groupKey = Nothing
                                , undo = Nothing
                                }
                                model.nowMs
                                { model | composer = "" }
                            , []
                            )
                    in
                    case moment of
                        Just unix ->
                            if String.isEmpty title then
                                warn

                            else
                                let
                                    ( updated, out ) =
                                        scheduleChannelEvent model target unix title
                                in
                                ( { updated | composer = "" }, out )

                        Nothing ->
                            warn

            [] ->
                ( { model | composer = "" }, [] )


{-| One operator-desk intent (mirroring `OperDeskIntent`: the UI never
hand-rolls a wire line — every verb answers the validator below). -}
type OperDeskIntent
    = OperBroadcast String
    | OperEventSubscribe String
    | OperEventUnsubscribe String
    | OperEventList
    | OperObserve { mask : String, actions : List String }
    | OperObserveList
    | OperObserveOff
    | OperRehash
    | OperPrivs
    | OperKill { target : String, reason : String }


{-| A validated operator command, ready to send (mirroring
`OperDeskCommand`). -}
type alias OperDeskCommand =
    { command : String
    , params : List String
    , summary : String
    , destructive : Bool
    }


maxBroadcastLength : Int
maxBroadcastLength =
    400


maxObserveMaskLength : Int
maxObserveMaskLength =
    256


maxKillReasonLength : Int
maxKillReasonLength =
    400


maxOperNickLength : Int
maxOperNickLength =
    50


{-| Event Spine categories the daemon publishes (mirroring
`OPER_EVENT_CATEGORIES`). -}
operEventCategories : List String
operEventCategories =
    [ "CONNECT", "DISCONNECT", "SERVER_LINK", "FLOOD", "ERROR", "ANNOUNCE", "OPER_ACTION", "KILL", "SPAM", "DEBUG", "POLICY", "SERVICE", "SECURITY" ]


{-| OBSERVE action filters (mirroring `OPER_OBSERVE_ACTIONS`, the
documented wire order). -}
operObserveActions : List String
operObserveActions =
    [ "connect", "quit", "nick", "join", "part", "host", "oper" ]


{-| Whether a value names an Event Spine category (mirroring
`isOperEventCategory`: trimmed, uppercased). -}
isOperEventCategory : String -> Bool
isOperEventCategory value =
    List.member (String.toUpper (String.trim value)) operEventCategories


{-| Whether a value names an OBSERVE action (mirroring
`isOperObserveAction`: trimmed, lowercased). -}
isOperObserveAction : String -> Bool
isOperObserveAction value =
    List.member (String.toLower (String.trim value)) operObserveActions


{-| IRC whitespace for mask/nick validation (mirroring `/\s/`: ASCII
whitespace plus the non-ASCII spaces the engine also rejects). -}
isIrcSpace : Char -> Bool
isIrcSpace char =
    List.member char [ ' ', '\u{0009}', '\u{000A}', '\u{000B}', '\u{000C}', '\u{000D}' ]
        || char == '\u{00A0}'
        || char == '\u{1680}'
        || (char >= '\u{2000}' && char <= '\u{200A}')
        || List.member char [ '\u{2028}', '\u{2029}', '\u{202F}', '\u{205F}', '\u{3000}', '\u{FEFF}' ]


{-| Whether a value carries C0 controls or DEL (mirroring
`CONTROL_CHARS`). -}
hasControlChars : String -> Bool
hasControlChars value =
    String.any (\c -> Char.toCode c <= 0x1F || Char.toCode c == 0x7F) value


{-| Validate an Event Spine category (mirroring `normalizeCategory`). -}
normalizeOperCategory : String -> Maybe String
normalizeOperCategory value =
    let
        upper =
            String.toUpper (String.trim value)
    in
    if List.member upper operEventCategories then
        Just upper

    else
        Nothing


{-| Validate OBSERVE actions (mirroring `normalizeObserveActions`:
every action must be known — one bad action fails the set — and the
wire order follows the documented list, not the input order). -}
normalizeObserveActions : List String -> Maybe (List String)
normalizeObserveActions raws =
    let
        cleaned =
            List.map (\raw -> String.toLower (String.trim raw)) raws
    in
    if List.all (\action -> List.member action operObserveActions) cleaned then
        Just (List.filter (\action -> List.member action cleaned) operObserveActions)

    else
        Nothing


{-| Validate an OBSERVE mask (mirroring `normalizeMask`: bounded, no
controls or whitespace, no leading colon, and not pure wildcards —
a `*` alone would flood the session with the whole network). -}
normalizeObserveMask : String -> Maybe String
normalizeObserveMask value =
    let
        mask =
            String.trim value
    in
    if String.isEmpty mask then
        Nothing

    else if String.length mask > maxObserveMaskLength then
        Nothing

    else if hasControlChars mask then
        Nothing

    else if String.any isIrcSpace mask then
        Nothing

    else if String.startsWith ":" mask then
        Nothing

    else if String.isEmpty (String.filter (\c -> not (List.member c [ '*', '?', '!', '@', '.' ])) mask) then
        Nothing

    else
        Just mask


{-| Validate an operator nick (mirroring `normalizeNick`: bounded, no
controls, and none of whitespace, `,`, `:`, or nick wildcards). -}
normalizeOperNick : String -> Maybe String
normalizeOperNick value =
    let
        nick =
            String.trim value
    in
    if String.isEmpty nick then
        Nothing

    else if String.length nick > maxOperNickLength then
        Nothing

    else if hasControlChars nick then
        Nothing

    else if String.any (\c -> isIrcSpace c || List.member c [ ',', ':', '*', '?', '!', '@' ]) nick then
        Nothing

    else
        Just nick


{-| Validate free text (mirroring `normalizeFreeText`: controls refuse
with their own message, blank yields `Nothing` for the caller default,
overlong refuses with the keep-under message). -}
normalizeOperFreeText : String -> Int -> String -> Maybe (Result String String)
normalizeOperFreeText value max label =
    if hasControlChars value then
        Just (Err ("The " ++ label ++ " cannot include line breaks or control characters."))

    else
        let
            text =
                String.trim value
        in
        if String.isEmpty text then
            Nothing

        else if String.length text > max then
            Just (Err ("Keep the " ++ label ++ " under " ++ String.fromInt max ++ " characters."))

        else
            Just (Ok text)


{-| Map a composer slash verb to an operator intent (mirroring
`parseOperSlashCommand`, `Nothing` when the verb is not an operator
command and the caller falls through to generic handling). -}
parseOperSlashCommand : String -> List String -> Maybe OperDeskIntent
parseOperSlashCommand name args =
    let
        verb =
            String.toLower (String.trim name)

        rest =
            String.join " " args

        first =
            String.toLower (String.trim (Maybe.withDefault "" (List.head args)))
    in
    case verb of
        "broadcast" ->
            Just (OperBroadcast rest)

        "wallops" ->
            Just (OperBroadcast rest)

        "kill" ->
            Just (OperKill { target = Maybe.withDefault "" (List.head args), reason = String.join " " (Maybe.withDefault [] (List.tail args)) })

        "rehash" ->
            Just OperRehash

        "privs" ->
            Just OperPrivs

        "events" ->
            if first == "add" then
                Just (OperEventSubscribe (Maybe.withDefault "" (args |> List.drop 1 |> List.head)))

            else if first == "del" || first == "remove" then
                Just (OperEventUnsubscribe (Maybe.withDefault "" (args |> List.drop 1 |> List.head)))

            else
                Just OperEventList

        "observe" ->
            if first == "" || first == "list" then
                Just OperObserveList

            else if first == "off" || first == "clear" then
                Just OperObserveOff

            else
                Just (OperObserve { mask = Maybe.withDefault "" (List.head args), actions = Maybe.withDefault [] (List.tail args) })

        _ ->
            Nothing


{-| Validate an operator intent into its exact wire command (mirroring
`planOperAction`: fail-closed, `Err` carries the desk copy and nothing
sends). -}
planOperAction : OperDeskIntent -> Result (List String) OperDeskCommand
planOperAction intent =
    case intent of
        OperBroadcast text ->
            case normalizeOperFreeText text maxBroadcastLength "broadcast" of
                Nothing ->
                    Err [ "Write the announcement first." ]

                Just (Err message) ->
                    Err [ message ]

                Just (Ok clean) ->
                    Ok { command = "EVENT", params = [ "BROADCAST", clean ], summary = "Announce to operators subscribed to ANNOUNCE: \u{201C}" ++ clean ++ "\u{201D}.", destructive = True }

        OperEventSubscribe category ->
            case normalizeOperCategory category of
                Nothing ->
                    Err [ "Pick a category from the Event Spine list." ]

                Just known ->
                    Ok { command = "EVENT", params = [ "ADD", known ], summary = "Receive " ++ known ++ " events from every node on the network.", destructive = False }

        OperEventUnsubscribe category ->
            case normalizeOperCategory category of
                Nothing ->
                    Err [ "Pick a category from the Event Spine list." ]

                Just known ->
                    Ok { command = "EVENT", params = [ "DEL", known ], summary = "Stop receiving " ++ known ++ " events.", destructive = False }

        OperEventList ->
            Ok { command = "EVENT", params = [ "LIST" ], summary = "List the Event Spine categories this session is subscribed to.", destructive = False }

        OperObserve { mask, actions } ->
            case normalizeObserveMask mask of
                Nothing ->
                    Err [ "Enter a nick!user@host mask, wildcards allowed." ]

                Just clean ->
                    case normalizeObserveActions actions of
                        Nothing ->
                            Err [ "Pick from connect, quit, nick, join, part, host, or oper." ]

                        Just ordered ->
                            Ok
                                { command = "EVENT"
                                , params = [ "OBSERVE", clean ] ++ ordered
                                , summary =
                                    if List.isEmpty ordered then
                                        "Watch " ++ clean ++ " network-wide. Their real host is revealed to you."

                                    else
                                        "Watch " ++ clean ++ " network-wide for " ++ String.join ", " ordered ++ ". Their real host is revealed to you."
                                , destructive = False
                                }

        OperObserveList ->
            Ok { command = "EVENT", params = [ "OBSERVE", "LIST" ], summary = "List the standing OBSERVE masks on this session.", destructive = False }

        OperObserveOff ->
            Ok { command = "EVENT", params = [ "OBSERVE", "OFF" ], summary = "Clear every standing OBSERVE mask on this session.", destructive = False }

        OperRehash ->
            Ok { command = "REHASH", params = [], summary = "Ask this node to reload its configuration (382 confirms).", destructive = True }

        OperPrivs ->
            Ok { command = "PRIVS", params = [], summary = "Show the operator privileges this session holds (270).", destructive = False }

        OperKill { target, reason } ->
            let
                errors =
                    case normalizeOperNick target of
                        Nothing ->
                            [ "Enter the nickname to disconnect." ]

                        Just _ ->
                            []
            in
            case normalizeOperFreeText reason maxKillReasonLength "reason" of
                Just (Err message) ->
                    Err (errors ++ [ message ])

                Just (Ok clean) ->
                    case normalizeOperNick target of
                        Nothing ->
                            Err errors

                        Just nick ->
                            Ok { command = "KILL", params = [ nick, clean ], summary = "Disconnect " ++ nick ++ " from the network with the reason \u{201C}" ++ clean ++ "\u{201D}.", destructive = True }

                Nothing ->
                    if List.isEmpty errors then
                        Err [ "A reason is required — it is recorded network-wide." ]

                    else
                        Err errors


{-| Run an operator slash verb (mirroring the oracle arm plus the shared
`operAction` choke point: offline the dispatch never runs so only the
draft clears; a failed plan warns with `Operator command`; without oper
status the session refuses instead of leaking intent; otherwise the
planned line sends. Success is silent. The admission-queue nuance
(`uncertain`/`refused` toasts) has no Elm port — a `Live` link sends;
see docs/COVERAGE.md). -}
runSlashOper : Model -> String -> ( Model, List Outbound )
runSlashOper model verb =
    if model.connection /= Live then
        ( { model | composer = "" }, [] )

    else
        let
            args =
                case String.split " " (String.dropLeft 1 model.composer) of
                    _ :: rest ->
                        rest

                    [] ->
                        []
        in
        case parseOperSlashCommand verb args of
            Nothing ->
                ( { model | composer = "" }, [ SendLine (Wire.formatIrcLine (String.toUpper verb) args) ] )

            Just intent ->
                case planOperAction intent of
                    Err errors ->
                        ( addToast
                            { variant = ToastWarning
                            , title = "Operator command"
                            , description = Just (String.join " " errors)
                            , duration = Nothing
                            , groupKey = Nothing
                            , undo = Nothing
                            }
                            model.nowMs
                            { model | composer = "" }
                        , []
                        )

                    Ok command ->
                        if not model.isOper then
                            ( addToast
                                { variant = ToastError
                                , title = "Operator access required"
                                , description = Just "This network grants operator status from the signed-in account."
                                , duration = Nothing
                                , groupKey = Nothing
                                , undo = Nothing
                                }
                                model.nowMs
                                { model | composer = "" }
                            , []
                            )

                        else
                            ( { model | composer = "" }, [ SendLine (Wire.formatIrcLine command.command command.params) ] )


{-| Run `/star` / `/unstar` (mirroring the oracle arm: the room resolves
like mute, invalid rooms coach with `Star a room`, and the toggle
unstars when asked or already starred — checking both the lowered and
the raw key exactly like the oracle. Success is silent (no toast);
only the consumed draft clears). -}
runSlashStar : Model -> String -> String -> Maybe String -> ( Model, List Outbound )
runSlashStar model verb target nickArg =
    case slashChannelTarget model target nickArg of
        Nothing ->
            ( addToast
                { variant = ToastWarning
                , title = "Star a room"
                , description = Just "Use /star in a room, or /star #room."
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                { model | composer = "" }
            , []
            )

        Just ch ->
            if verb == "unstar" || Set.member (String.toLower ch) model.starredChannels || Set.member ch model.starredChannels then
                let
                    ( updated, out ) =
                        unstarChannel model ch
                in
                ( { updated | composer = "" }, out )

            else
                let
                    ( updated, out ) =
                        starChannel model ch
                in
                ( { updated | composer = "" }, out )


{-| Run `/snooze [minutes]` / `/dnd on|off|minutes` (mirroring the
oracle arm: `off`/`0`/`clear` clears both axes, `on`/empty sets manual
DND, otherwise a 1–1440 minute timer lands on `dndUntil` with manual
DND off; out-of-range or unparseable input only coaches. `String.toFloat`
does not read hex the way JS `Number` does — exotic inputs warn
instead of snoozing (documented narrowing). -}
runSlashDnd : Model -> String -> ( Model, List Outbound )
runSlashDnd model raw =
    if raw == "off" || raw == "0" || raw == "clear" then
        let
            ( updated, out ) =
                setDnd model False Nothing
        in
        ( addToast
            { variant = ToastInfo
            , title = "Do not disturb off"
            , description = Just "Desktop and sound alerts resume (quiet hours still apply)."
            , duration = Nothing
            , groupKey = Nothing
            , undo = Nothing
            }
            model.nowMs
            { updated | composer = "" }
        , out
        )

    else if raw == "on" || raw == "" then
        let
            ( updated, out ) =
                setDnd model True Nothing
        in
        ( addToast
            { variant = ToastInfo
            , title = "Do not disturb on"
            , description = Just "Alerts are silenced until you turn DND off."
            , duration = Nothing
            , groupKey = Nothing
            , undo = Nothing
            }
            model.nowMs
            { updated | composer = "" }
        , out
        )

    else
        case String.toFloat raw of
            Just mins ->
                if isNaN mins || isInfinite mins || mins <= 0 || mins > 1440 then
                    ( slashSnoozeCoaching model, [] )

                else
                    let
                        whole =
                            floor mins

                        ( updated, out ) =
                            setDnd model False (Just (floor model.nowMs + whole * 60000))
                    in
                    ( addToast
                        { variant = ToastInfo
                        , title = "Snoozed " ++ String.fromInt whole ++ "m"
                        , description = Just "Alerts pause until the timer ends."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        { updated | composer = "" }
                    , out
                    )

            Nothing ->
                ( slashSnoozeCoaching model, [] )


{-| Snooze range coaching (mirroring the oracle warning). -}
slashSnoozeCoaching : Model -> Model
slashSnoozeCoaching model =
    addToast
        { variant = ToastWarning
        , title = "Snooze"
        , description = Just "Use /snooze <minutes> (1\u{2013}1440), or /dnd on|off."
        , duration = Nothing
        , groupKey = Nothing
        , undo = Nothing
        }
        model.nowMs
        { model | composer = "" }


{-| Run a local slash command (mirroring the oracle `/ignore` /
`/unignore` / `/read` / `/clear` / `/whois` / `/highlight` / `/unhighlight` / `/snooze` / `/dnd` arms: silent folds — the fold's own
`Blocked`/`Unblocked` undo toast would double-chrome here — plus the
slash info toast, and the draft clears since the command is consumed.
The bare `/ignore` lists the set in codepoint order where the oracle
uses `localeCompare('en')` (same documented caveat as the blocklist
catalogue); a corrupt-draft `/` alone keeps the PRIVMSG path. -}
runSlashLocal : Model -> String -> String -> Maybe String -> ( Model, List Outbound )
runSlashLocal model target verb nickArg =
    case ( verb, nickArg ) of
        ( "ignore", Just nick ) ->
            let
                ( updated, out ) =
                    applyBlocklistAction False model (IgnoreUser nick)
            in
            ( addToast
                { variant = ToastInfo
                , title = "Ignoring " ++ nick
                , description = Just "Their messages are hidden on this device. Notifications are silenced too."
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                { updated | composer = "" }
            , out
            )

        ( "unignore", Just nick ) ->
            let
                ( updated, out ) =
                    applyBlocklistAction False model (UnignoreUser nick)
            in
            ( addToast
                { variant = ToastInfo
                , title = "Unignored " ++ nick
                , description = Just "Messages and notifications from this name resume on this device."
