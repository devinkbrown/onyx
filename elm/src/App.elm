    , { name = "tableflip", usage = "/tableflip", description = "Insert a table flip.", kind = SlashText, aliases = [], insertText = Just "(╯°□°）╯︵ ┻━┻", oper = False }
    , { name = "unflip", usage = "/unflip", description = "Insert a table restore.", kind = SlashText, aliases = [], insertText = Just "┬─┬ ノ( ゜-゜ノ)", oper = False }
    , { name = "lenny", usage = "/lenny", description = "Insert a lenny face.", kind = SlashText, aliases = [], insertText = Just "( ͡° ͜ʖ ͡°)", oper = False }
    , { name = "disapprove", usage = "/disapprove", description = "Insert a look of disapproval.", kind = SlashText, aliases = [], insertText = Just "ಠ_ಠ", oper = False }
    ]


{-| Resolve a slash-command by name or alias (mirroring
`findSlashCommand`: one leading `/` stripped, case-insensitive,
oper verbs resolve like any other). -}
findSlashCommand : String -> Maybe SlashCommand
findSlashCommand raw =
    let
        needle =
            String.toLower
                (if String.startsWith "/" raw then
                    String.dropLeft 1 raw

                 else
                    raw
                )
    in
    List.filter
        (\command -> command.name == needle || List.member needle command.aliases)
        slashCommands
        |> List.head


{-| The `/help` bare-list names (mirroring the oracle filter: the local
verbs summarized when no command is named). -}
localSlashCommandNames : List String
localSlashCommandNames =
    [ "clear", "search", "read", "star", "mute", "autojoin", "highlight", "snooze", "dnd", "color", "share", "export", "notify", "help", "ignore" ]


{-| The `/help` bare-list line (mirroring the oracle: registry order,
`/`-prefixed, ` · `-joined, with the composer-hint fallback). -}
localSlashCommandList : String
localSlashCommandList =
    let
        listed =
            List.filter (\command -> List.member command.name localSlashCommandNames) slashCommands
                |> List.map (\command -> "/" ++ command.name)
                |> String.join " · "
    in
    if String.isEmpty listed then
        "Type / in the composer for suggestions."

    else
        listed


slashSuggestCommand : SlashCommand -> SlashSuggest.Command
slashSuggestCommand command =
    { name = command.name
    , usage = command.usage
    , description = command.description
    , aliases = command.aliases
    , insertText = command.insertText
    , oper = command.oper
    , textCommand = command.kind == SlashText
    }


slashSuggestionCommands : Model -> List SlashCommand
slashSuggestionCommands model =
    if model.slashDismissed then
        []

    else
        SlashSuggest.suggestions (List.map slashSuggestCommand slashCommands) model.composer 8 model.isOper
            |> List.filterMap (\suggested -> List.filter (\command -> command.name == suggested.name) slashCommands |> List.head)


nickSuggestionMatches : Model -> List String
nickSuggestionMatches model =
    if model.nickDismissed then
        []

    else
        case NickComplete.nickTokenAt model.composer (String.length model.composer) of
            Nothing ->
                []

            Just token ->
                if not token.at && String.isEmpty token.query then
                    []

                else if not (List.isEmpty (slashSuggestionCommands model)) then
                    []

                else
                    NickComplete.rankNickCompletions token.query (composerNickCandidates model) 8


composerNickCandidates : Model -> List String
composerNickCandidates model =
    case model.activeChannel of
        Nothing ->
            []

        Just name ->
            if isChannelName model name then
                case Dict.get (String.toLower name) model.channels of
                    Just channel ->
                        List.map .nick (Dict.values channel.members)

                    Nothing ->
                        []

            else
                name :: [ model.ourNick ]


maxEventTitleChars : Int
maxEventTitleChars =
    180


eventFutureWindowMs : Float
eventFutureWindowMs =
    366 * 24 * 60 * 60 * 1000


eventClockSkewMs : Float
eventClockSkewMs =
    5 * 60 * 1000


{-| Sanitize a channel-event title (mirroring `scheduleEvent`: every
maximal CR/LF run folds to one space, then trim and cap at 180 chars —
pre-existing spaces outside line breaks survive untouched). -}
sanitizeEventTitle : String -> String
sanitizeEventTitle raw =
    let
        step char ( out, inBreak ) =
            if char == '\u{000D}' || char == '\u{000A}' then
                if inBreak then
                    ( out, True )

                else
                    ( out ++ " ", True )

            else
                ( out ++ String.fromChar char, False )

        ( folded, _ ) =
            List.foldl step ( "", False ) (String.toList raw)
    in
    String.left maxEventTitleChars (String.trim folded)


{-| Days since the Unix epoch for a civil date (Howard Hinnant's
algorithm; inputs are digit-validated and non-negative, so truncating
`//` is exact). -}
civilToEpochDays : Int -> Int -> Int -> Int
civilToEpochDays year month day =
    let
        y =
            if month <= 2 then
                year - 1

            else
                year

        era =
            y // 400

        yoe =
            y - era * 400

        mp =
            if month > 2 then
                month - 3

            else
                month + 9

        doy =
            (153 * mp + 2) // 5 + day - 1

        doe =
            yoe * 365 + yoe // 4 - yoe // 100 + doy
    in
    era * 146097 + doe - 719468


isLeapYear : Int -> Bool
isLeapYear year =
    (modBy 4 year == 0 && modBy 100 year /= 0) || modBy 400 year == 0


daysInMonth : Int -> Int -> Int
daysInMonth year month =
    case month of
        1 ->
            31

        2 ->
            if isLeapYear year then
                29

            else
                28

        3 ->
            31

        4 ->
            30

        5 ->
            31

        6 ->
            30

        7 ->
            31

        8 ->
            31

        9 ->
            30

        10 ->
            31

        11 ->
            30

        12 ->
            31

        _ ->
            0


{-| Parse a fixed-width digit field (`Just` value on all-digits input). -}
parseDigitField : String -> Maybe Int
parseDigitField part =
    if String.isEmpty part || not (String.all Char.isDigit part) then
        Nothing

    else
        String.toInt part


{-| Split an ISO-8601 time tail into its clock part and zone suffix
(`Z`/`z`, `±hh:mm`, or `±hhmm`; anything else fails — the time tail
never carries `-` except in the zone, so the last sign wins). -}
splitIsoZone : String -> Maybe ( String, Int )
splitIsoZone tail =
    if String.isEmpty tail then
        Just ( "", 0 )

    else if String.endsWith "Z" tail || String.endsWith "z" tail then
        Just ( String.dropRight 1 tail, 0 )

    else
        let
            lastIndex sub =
                List.head (List.reverse (String.indexes sub tail))

            at =
                case ( lastIndex "+", lastIndex "-" ) of
                    ( Just plus, Just minus ) ->
                        Just (max plus minus)

                    ( Just plus, Nothing ) ->
                        Just plus

                    ( Nothing, Just minus ) ->
                        Just minus

                    ( Nothing, Nothing ) ->
                        Nothing
        in
        case at of
            Nothing ->
                Just ( tail, 0 )

            Just idx ->
                parseIsoZoneHours (String.left idx tail) (String.dropLeft idx tail)


{-| Resolve an ISO-8601 zone suffix to offset minutes. -}
parseIsoZoneHours : String -> String -> Maybe ( String, Int )
parseIsoZoneHours clock zone =
    case String.uncons zone of
        Just ( sign, rest ) ->
            if sign /= '+' && sign /= '-' then
                Nothing

            else
                let
                    digits =
                        String.filter Char.isDigit rest

                    -- Verified against V8: colon forms need exactly two
                    -- digits per field (`+2:30`, `+05:3` fail), the packed
                    -- form needs exactly four (`+0059` reads as `+00:59`),
                    -- and a bare `±hh` fails.
                    magnitude =
                        case String.split ":" rest of
                            [ hours, minutes ] ->
                                if String.length hours /= 2 || String.length minutes /= 2 then
                                    Nothing

                                else
                                    case ( parseDigitField hours, parseDigitField minutes ) of
                                        ( Just h, Just m ) ->
                                            if h > 23 || m > 59 then
                                                Nothing

                                            else
                                                Just (h * 60 + m)

                                        _ ->
                                            Nothing

                            [ _ ] ->
                                if String.length digits == 4 && String.length rest == 4 then
                                    case ( parseDigitField (String.left 2 digits), parseDigitField (String.dropLeft 2 digits) ) of
                                        ( Just h, Just m ) ->
                                            if h > 23 || m > 59 then
                                                Nothing

                                            else
                                                Just (h * 60 + m)

                                        _ ->
                                            Nothing

                                else
                                    Nothing

                            _ ->
                                Nothing
                in
                case magnitude of
                    Just mins ->
                        Just
                            ( clock
                            , if sign == '+' then
                                mins

                              else
                                -mins
                            )

                    Nothing ->
                        Nothing

        Nothing ->
            Nothing


{-| Parse an ISO-8601 calendar moment to epoch milliseconds (mirroring
the `Date.parse` fallback inside `parseEventTime`, narrowed to the
documented interchange forms: `YYYY-MM-DD` (UTC midnight) and
`YYYY-MM-DD[T ]hh:mm[:ss][.frac][zone]` with zones limited to `Z` /
`±hh:mm` / `±hhmm` (a bare `±hh` fails `Date.parse` too); zone-less
times read as UTC since Elm has no local-timezone API, and out-of-range
fields fail where the engine would coerce — see docs/COVERAGE.md). -}
parseIso8601Ms : String -> Maybe Float
parseIso8601Ms raw =
    let
        trimmed =
            String.trim raw

        ( datePart, timePart ) =
            case String.indexes "T" trimmed of
                at :: _ ->
                    ( String.left at trimmed, String.dropLeft (at + 1) trimmed )

                [] ->
                    case String.indexes " " trimmed of
                        at :: _ ->
                            ( String.left at trimmed, String.dropLeft (at + 1) trimmed )

                        [] ->
                            ( trimmed, "" )
    in
    case String.split "-" datePart of
        [ yearText, monthText, dayText ] ->
            if String.length yearText /= 4 || String.length monthText /= 2 || String.length dayText /= 2 then
                Nothing

            else
                case ( parseDigitField yearText, parseDigitField monthText, parseDigitField dayText ) of
                    ( Just year, Just month, Just day ) ->
                        if month < 1 || month > 12 || day < 1 || day > daysInMonth year month then
                            Nothing

                        else
                            parseIsoTime (toFloat (civilToEpochDays year month day) * 86400000) timePart True

                    _ ->
                        Nothing

        _ ->
            Nothing


{-| Parse the time tail of an ISO-8601 moment over a UTC-midnight base
(`dateOnly` allows the bare `YYYY-MM-DD` form; anything else needs a
clock). -}
parseIsoTime : Float -> String -> Bool -> Maybe Float
parseIsoTime dayMs tail dateOnly =
    if String.isEmpty tail then
        if dateOnly then
            Just dayMs

        else
            Nothing

    else
        case splitIsoZone tail of
            Nothing ->
                Nothing

            Just ( clock, offsetMins ) ->
                case String.split ":" clock of
                    [ hoursText, minutesText ] ->
                        combineIsoClock dayMs hoursText minutesText Nothing offsetMins

                    [ hoursText, minutesText, secondsText ] ->
                        let
                            ( wholeSeconds, fracMs ) =
                                case String.split "." secondsText of
                                    [ whole ] ->
                                        ( whole, 0 )

                                    whole :: frac :: _ ->
                                        ( whole
                                        , Maybe.withDefault 0
                                            (String.toInt (String.left 3 (frac ++ "000")))
                                        )

                                    [] ->
                                        ( "", 0 )
                        in
                        combineIsoClock dayMs hoursText minutesText (Just ( wholeSeconds, fracMs )) offsetMins

                    _ ->
                        Nothing


{-| Combine one validated ISO clock over the day base (seconds optional;
fractional seconds truncate to millisecond precision). -}
combineIsoClock : Float -> String -> String -> Maybe ( String, Int ) -> Int -> Maybe Float
combineIsoClock dayMs hoursText minutesText seconds offsetMins =
    if String.length hoursText /= 2 || String.length minutesText /= 2 then
        Nothing

    else
        case ( parseDigitField hoursText, parseDigitField minutesText ) of
            ( Just hours, Just minutes ) ->
                if hours > 23 || minutes > 59 then
                    Nothing

                else
                    case seconds of
                        Nothing ->
                            Just (dayMs + toFloat ((hours * 60 + minutes - offsetMins) * 60 * 1000))

                        Just ( wholeSeconds, fracMs ) ->
                            if String.length wholeSeconds /= 2 then
                                Nothing

                            else
                                case parseDigitField wholeSeconds of
                                    Just whole ->
                                        if whole > 59 then
                                            Nothing

                                        else
                                            Just (dayMs + toFloat ((hours * 60 + minutes - offsetMins) * 60 + whole) * 1000 + toFloat fracMs)

                                    Nothing ->
                                        Nothing

            _ ->
                Nothing


{-| Parse an event moment (mirroring `parseEventTime`: 1–10 digit unix
seconds, 11–14 digit unix milliseconds, else an ISO-8601 calendar
moment; the result must fall inside `[now - skew, now + 366d]`).
Returns unix seconds like the oracle hands to `scheduleEvent`. -}
parseEventTimeMs : Float -> String -> Maybe Int
parseEventTimeMs nowMs raw =
    let
        trimmed =
            String.trim raw

        moment =
            if String.isEmpty trimmed then
                Nothing

            else if String.all Char.isDigit trimmed then
                if String.length trimmed <= 10 then
                    Maybe.map (\secs -> toFloat secs * 1000) (String.toInt trimmed)

                else if String.length trimmed <= 14 then
                    String.toFloat trimmed

                else
                    parseIso8601Ms trimmed

            else
                parseIso8601Ms trimmed
    in
    case moment of
        Nothing ->
            Nothing

        Just ms ->
            if ms < nowMs - eventClockSkewMs || ms > nowMs + eventFutureWindowMs then
                Nothing

            else
                Just (floor (ms / 1000))


{-| Write one channel prop optimistically (mirroring
`_writeChannelProp`: normalized target/name, raw values over the live
cap drop, empty values delete through the bounded registry). -}
writeChannelProp : String -> String -> String -> Ircx.PropState -> Ircx.PropState
writeChannelProp channel key value props =
    if String.length value > Ircx.maxLivePropValueLength then
        props

    else
        case ( Ircx.normalizePropertyTarget (Just channel), Ircx.normalizePropertyName (Just key) ) of
            ( Just target, Just name ) ->
                case Ircx.updateBoundedProperties props.channelProps (String.toLower target) name (Ircx.boundedPropertyValue value) True of
                    Just next ->
                        { props | channelProps = next }

                    Nothing ->
                        props

            _ ->
                props


{-| Cap on pinned msgids per channel (mirrors the `slice(-50)` in
`pinMessage`). -}
maxChannelPins : Int
maxChannelPins =
    50


{-| Pinned msgids for a channel, parsed from its IRCX `PINS` prop
oldest to newest (mirrors `selectChannelPins`: comma split, trim,
drop empties). -}
channelPins : Model -> String -> List String
channelPins model channel =
    case Dict.get (String.toLower channel) model.props.channelProps of
        Nothing ->
            []

        Just props ->
            case Dict.get "PINS" props of
                Nothing ->
                    []

                Just raw ->
                    parsePinList raw


parsePinList : String -> List String
parsePinList raw =
    List.filterMap
        (\id ->
            let
                clean =
                    String.trim id
            in
            if String.isEmpty clean then
                Nothing

            else
                Just clean
        )
        (String.split "," raw)


{-| Rewrite a channel's `PINS` prop locally and publish it
(mirrors `_writePins` through `_writeChannelProp`: the whole list
publishes as one `PROP SET`, with the optimistic local update the
drawer reacts to). -}
writePins : Model -> String -> List String -> ( Model, List Outbound )
writePins model channel msgids =
    requestPropWrite model channel "PINS" (String.join "," msgids)


{-| Key of one pending channel PROP write. -}
propWriteKey : String -> String -> String
propWriteKey channel name =
    String.toLower channel ++ "\n" ++ String.toLower name


{-| Ask the server to store a channel PROP. The committed `props` view
never changes here: the desired value waits in `pendingPropWrites`
until the server echo (`PROP`/818) writes it, and a `FAIL PROP` or 913
drops it. Offline or on a non-IRCX link nothing is sent and nothing is
recorded, so no local value can masquerade as server state. -}
requestPropWrite : Model -> String -> String -> String -> ( Model, List Outbound )
requestPropWrite model channel name value =
    if model.connection == Live && model.isupport.ircx then
        ( { model | pendingPropWrites = Dict.insert (propWriteKey channel name) value model.pendingPropWrites }
        , [ SendLine (Wire.formatIrcLine "PROP" [ channel, name, value ]) ]
        )

    else
        ( model, [] )


{-| Drop pending PROP writes the server answered (echo) or refused. A
refusal without a property name clears every pending write for the
channel. -}
settlePropWrite : Model -> String -> Maybe String -> Model
settlePropWrite model channel name =
    case name of
        Just prop ->
            { model | pendingPropWrites = Dict.remove (propWriteKey channel prop) model.pendingPropWrites }

        Nothing ->
            { model | pendingPropWrites = Dict.filter (\key _ -> not (String.startsWith (String.toLower channel ++ "\n") key)) model.pendingPropWrites }


{-| Pins the next write builds on: the pending desired list while a
write is in flight, else the committed server list. -}
desiredPins : Model -> String -> List String
desiredPins model channel =
    case Dict.get (propWriteKey channel "PINS") model.pendingPropWrites of
        Just raw ->
            parsePinList raw

        Nothing ->
            channelPins model channel


{-| Pin a message (mirrors `pinMessage`: dup pins no-op, newest
appends with the 50-newest cap). -}
pinMessage : Model -> String -> String -> ( Model, List Outbound )
pinMessage model channel msgid =
    let
        current =
            desiredPins model channel
    in
    if List.member msgid current then
        ( model, [] )

    else
        writePins model channel (List.drop (List.length current + 1 - maxChannelPins) (current ++ [ msgid ]))


{-| Unpin a message (mirrors `unpinMessage`: filter + whole-list
rewrite). -}
unpinMessage : Model -> String -> String -> ( Model, List Outbound )
unpinMessage model channel msgid =
    writePins model channel (List.filter (\id -> id /= msgid) (desiredPins model channel))


type PinnedMessageState
    = PinDeleted
    | PinLocked
    | PinVisible


{-| Transcript-boundary state of a pinned row (mirrors
`pinnedMessageDisplayState`: withdrawn rows stay deleted, unopened
envelopes stay locked — never a second path to the screen). -}
pinnedMessageState : ChatMessage -> PinnedMessageState
pinnedMessageState message =
    if message.deleted || message.redacted then
        PinDeleted

    else if messageLocked message then
        PinLocked

    else
        PinVisible


{-| State badge copy (mirrors `pinnedMessageStateLabel`). -}
pinnedMessageStateLabel : PinnedMessageState -> String
pinnedMessageStateLabel state =
    case state of
        PinDeleted ->
            "Deleted"

        PinLocked ->
            "Locked"

        PinVisible ->
            "Loaded locally"


{-| Reuse the feed scroll/pulse landing (mirrors `focusMessage`:
whatever id sits here is what the thread scrolls to). -}
focusMessage : Model -> String -> Model
focusMessage model messageId =
    invalidateVaultSearch { model | historyLanding = Just messageId, searchOpen = False }


{-| Jump to a pinned message (mirrors the drawer `jumpTo`: a loaded
row focuses through the landing machinery and closes the drawer;
an unloaded row requests its window from history and closes on
admission, while a refused request leaves the drawer open with
feedback). -}
jumpToPinned : Model -> String -> String -> ( Model, List Outbound )
jumpToPinned model channel messageId =
    case reactionRow model channel messageId of
        Just _ ->
            let
                focused =
                    focusMessage model messageId
            in
            ( { focused | showPinnedMessages = False, pinsLoadFeedback = "" }, [] )

        Nothing ->
            let
                ( requested, out ) =
                    requestPinnedMessage model channel messageId
            in
            if List.isEmpty out then
                ( { requested | pinsLoadFeedback = "Pinned message could not be loaded from history. Try again." }, [] )

            else
                ( { requested | showPinnedMessages = False, pinsLoadFeedback = "" }, out )


{-| Device-vault fetch state for the media panel (mirrors the oracle
`RecentHistoryStatus`: Elm's bridge reports `ok` vs anything else, so
`partial` has no source and rides with failure — the recovered rows
still list).
-}
type MediaVaultState
    = MediaVaultLoading
    | MediaVaultReady
    | MediaVaultFailed


{-| Owner scope key recorded when the media panel fetches (mirrors the
oracle `mediaScopeKey`: responses crossing an owner change are
dropped, never painted). -}
mediaOwnerKey : Model -> String
mediaOwnerKey model =
    case deviceMemoryOwner model of
        Just owner ->
            owner.serverUrl ++ "\u{0000}" ++ owner.identity

        Nothing ->
            ""


{-| A live row mapped onto the media index (message ids dedupe
replays; envelope-shaped bodies gate as encrypted). -}
mediaRowOf : ChatMessage -> RoomMedia.MediaRow
mediaRowOf message =
    { id = Maybe.withDefault ("row:" ++ String.fromInt message.id) message.msgid
    , from = message.from
    , body = message.body
    , plaintext = message.plaintext
    , msgType = message.msgType
    , at = message.at
    , deleted = message.deleted
    , redacted = message.redacted
    , encrypted = isEncryptedRow message
    }


{-| A vault row mapped onto the media index (no transient plaintext
rides the vault, so envelope-shaped bodies gate as encrypted). -}
mediaRowOfVault : VaultRow -> RoomMedia.MediaRow
mediaRowOfVault row =
    { id = row.id
    , from = row.from
    , body = row.body
    , plaintext = Nothing
    , msgType = row.rowType
    , at = row.at
    , deleted = row.deleted
    , redacted = row.redacted
    , encrypted = DmCipher.isEnvelope row.body || GroupEnvelope.isGroupEnvelope row.body
    }


{-| The media index for the panel target: live rows merged under
recovered vault rows (mirrors the oracle `index` memo). Vault rows
carry `target:seq` ids while live rows carry msgids or `row:N`, so
the id merge cannot collapse a hydrated row with its vault twin the
way the oracle's shared id space does: vault rows repeating live
content collapse too, live winning. -}
mediaIndexFor : Model -> RoomMedia.RoomMediaIndex
mediaIndexFor model =
    let
        live =
            case Dict.get model.mediaIndexTarget model.channels of
                Just channel ->
                    List.map mediaRowOf channel.messages

                Nothing ->
                    []

        liveKeys =
            Set.fromList (List.map mediaContentKey live)

        vault =
            List.map mediaRowOfVault model.mediaIndexVault
                |> List.filter (\row -> not (Set.member (mediaContentKey row) liveKeys))
    in
    RoomMedia.indexRoomMedia (RoomMedia.mergeRoomHistory live vault)


{-| Content identity for live/vault twin collapse. -}
mediaContentKey : RoomMedia.MediaRow -> String
mediaContentKey row =
    row.from ++ "\u{0000}" ++ row.body ++ "\u{0000}" ++ String.fromInt row.at


{-| Jump to a media item: a loaded row focuses through the landing
machinery and closes the panel; anything else travels to the item's
stamp through the history machinery and closes too (vault rows carry
no wire msgid to pin by). -}
jumpToMedia : Model -> String -> String -> Int -> ( Model, List Outbound )
jumpToMedia model target messageId at =
    case reactionRow model target messageId of
        Just _ ->
            let
                focused =
                    focusMessage model messageId
            in
            ( closeMediaIndex focused, [] )

        Nothing ->
            let
                ( travelled, out ) =
                    requestTravelTo model target (toFloat at)
            in
            ( closeMediaIndex travelled, out )


{-| Clear every media-panel field. -}
closeMediaIndex : Model -> Model
closeMediaIndex model =
    { model
        | mediaIndexOpen = False
        , mediaIndexFilter = RoomMedia.Pictures
        , mediaIndexTarget = ""
        , mediaIndexVault = []
        , mediaIndexVaultState = MediaVaultLoading
        , mediaIndexOwner = ""
        , mediaPictureAllowed = Set.empty
    }


{-| Schedule a channel event (mirroring `scheduleEvent`: the title
sanitizes here, an empty title is a silent no-op, otherwise the
`ocean.event` prop lands locally and publishes as
`PROP <channel> ocean.event <unix>|<title>` on a live IRCX link). -}
scheduleChannelEvent : Model -> String -> Int -> String -> ( Model, List Outbound )
scheduleChannelEvent model channel unix rawTitle =
    let
        clean =
            sanitizeEventTitle rawTitle
    in
    if String.isEmpty clean then
        ( model, [] )

    else
        requestPropWrite model channel "ocean.event" (String.fromInt unix ++ "|" ++ clean)


{-| Clear a channel event (mirroring `clearChannelEvent`: the prop
deletes locally and publishes the empty trailing value on a live IRCX
link — `PROP <channel> ocean.event :`). -}
clearChannelEvent : Model -> String -> ( Model, List Outbound )
clearChannelEvent model channel =
    requestPropWrite model channel "ocean.event" ""


{-| Run `/event` (mirroring the oracle arm: offline the dispatch never
runs so only the consumed draft clears; outside a room the verb falls
through as a raw `EVENT` line; in a room an empty tail or
`clear`/`off` removes the event, otherwise `<when> <title>` schedules
it — success is silent, while a bad moment or a missing title warns
with `Event not set`). The tail re-splits from the composer so the
oracle's exact empty-arg edges survive. -}
runSlashEvent : Model -> String -> ( Model, List Outbound )
runSlashEvent model target =
    if model.connection /= Live then
        ( { model | composer = "" }, [] )

    else if not (isChannelName model target) then
        let
            params =
                case String.split " " (String.dropLeft 1 model.composer) of
                    _ :: args ->
                        args

                    [] ->
                        []
        in
        ( { model | composer = "" }, [ SendLine (Wire.formatIrcLine "EVENT" params) ] )

    else
        case String.split " " (String.dropLeft 1 model.composer) of
            _ :: args ->
                let
                    first =
                        String.toLower (Maybe.withDefault "" (List.head args))
                in
                if List.isEmpty args || first == "clear" || first == "off" then
                    let
                        ( updated, out ) =
                            clearChannelEvent model target
                    in
                    ( { updated | composer = "" }, out )

                else
                    let
                        title =
                            String.trim (String.join " " (Maybe.withDefault [] (List.tail args)))

                        moment =
                            parseEventTimeMs model.nowMs (Maybe.withDefault "" (List.head args))

                        warn =
                            ( addToast
                                { variant = ToastWarning
                                , title = "Event not set"
                                , description = Just "Use /event <YYYY-MM-DDThh:mmZ> <title>."
                                , duration = Nothing
                                , groupKey = Nothing
                                , undo = Nothing
                                }
                                model.nowMs
                                { model | composer = "" }
                            , []
                            )
                    in
                    case moment of
                        Just unix ->
                            if String.isEmpty title then
                                warn

                            else
                                let
                                    ( updated, out ) =
                                        scheduleChannelEvent model target unix title
                                in
                                ( { updated | composer = "" }, out )

                        Nothing ->
                            warn

            [] ->
                ( { model | composer = "" }, [] )


{-| One operator-desk intent (mirroring `OperDeskIntent`: the UI never
hand-rolls a wire line — every verb answers the validator below). -}
type OperDeskIntent
    = OperBroadcast String
    | OperEventSubscribe String
    | OperEventUnsubscribe String
    | OperEventList
    | OperObserve { mask : String, actions : List String }
    | OperObserveList
    | OperObserveOff
    | OperRehash
    | OperPrivs
    | OperKill { target : String, reason : String }


{-| A validated operator command, ready to send (mirroring
`OperDeskCommand`). -}
type alias OperDeskCommand =
    { command : String
    , params : List String
    , summary : String
    , destructive : Bool
    }


maxBroadcastLength : Int
maxBroadcastLength =
    400


maxObserveMaskLength : Int
maxObserveMaskLength =
    256


maxKillReasonLength : Int
maxKillReasonLength =
    400


maxOperNickLength : Int
maxOperNickLength =
    50


{-| Event Spine categories the daemon publishes (mirroring
`OPER_EVENT_CATEGORIES`). -}
operEventCategories : List String
operEventCategories =
    [ "CONNECT", "DISCONNECT", "SERVER_LINK", "FLOOD", "ERROR", "ANNOUNCE", "OPER_ACTION", "KILL", "SPAM", "DEBUG", "POLICY", "SERVICE", "SECURITY" ]


{-| OBSERVE action filters (mirroring `OPER_OBSERVE_ACTIONS`, the
documented wire order). -}
operObserveActions : List String
operObserveActions =
    [ "connect", "quit", "nick", "join", "part", "host", "oper" ]


{-| Whether a value names an Event Spine category (mirroring
`isOperEventCategory`: trimmed, uppercased). -}
isOperEventCategory : String -> Bool
isOperEventCategory value =
    List.member (String.toUpper (String.trim value)) operEventCategories


{-| Whether a value names an OBSERVE action (mirroring
`isOperObserveAction`: trimmed, lowercased). -}
isOperObserveAction : String -> Bool
isOperObserveAction value =
    List.member (String.toLower (String.trim value)) operObserveActions


{-| IRC whitespace for mask/nick validation (mirroring `/\s/`: ASCII
whitespace plus the non-ASCII spaces the engine also rejects). -}
isIrcSpace : Char -> Bool
isIrcSpace char =
    List.member char [ ' ', '\u{0009}', '\u{000A}', '\u{000B}', '\u{000C}', '\u{000D}' ]
        || char == '\u{00A0}'
        || char == '\u{1680}'
        || (char >= '\u{2000}' && char <= '\u{200A}')
        || List.member char [ '\u{2028}', '\u{2029}', '\u{202F}', '\u{205F}', '\u{3000}', '\u{FEFF}' ]


{-| Whether a value carries C0 controls or DEL (mirroring
`CONTROL_CHARS`). -}
hasControlChars : String -> Bool
hasControlChars value =
    String.any (\c -> Char.toCode c <= 0x1F || Char.toCode c == 0x7F) value


{-| Validate an Event Spine category (mirroring `normalizeCategory`). -}
normalizeOperCategory : String -> Maybe String
normalizeOperCategory value =
    let
        upper =
            String.toUpper (String.trim value)
    in
    if List.member upper operEventCategories then
        Just upper

    else
        Nothing


{-| Validate OBSERVE actions (mirroring `normalizeObserveActions`:
every action must be known — one bad action fails the set — and the
wire order follows the documented list, not the input order). -}
normalizeObserveActions : List String -> Maybe (List String)
normalizeObserveActions raws =
    let
        cleaned =
            List.map (\raw -> String.toLower (String.trim raw)) raws
    in
    if List.all (\action -> List.member action operObserveActions) cleaned then
        Just (List.filter (\action -> List.member action cleaned) operObserveActions)

    else
        Nothing


{-| Validate an OBSERVE mask (mirroring `normalizeMask`: bounded, no
controls or whitespace, no leading colon, and not pure wildcards —
a `*` alone would flood the session with the whole network). -}
normalizeObserveMask : String -> Maybe String
normalizeObserveMask value =
    let
        mask =
            String.trim value
    in
    if String.isEmpty mask then
        Nothing

    else if String.length mask > maxObserveMaskLength then
        Nothing

    else if hasControlChars mask then
        Nothing

    else if String.any isIrcSpace mask then
        Nothing

    else if String.startsWith ":" mask then
        Nothing

    else if String.isEmpty (String.filter (\c -> not (List.member c [ '*', '?', '!', '@', '.' ])) mask) then
        Nothing

    else
        Just mask


{-| Validate an operator nick (mirroring `normalizeNick`: bounded, no
controls, and none of whitespace, `,`, `:`, or nick wildcards). -}
normalizeOperNick : String -> Maybe String
normalizeOperNick value =
    let
        nick =
            String.trim value
    in
    if String.isEmpty nick then
        Nothing

    else if String.length nick > maxOperNickLength then
        Nothing

    else if hasControlChars nick then
        Nothing

    else if String.any (\c -> isIrcSpace c || List.member c [ ',', ':', '*', '?', '!', '@' ]) nick then
        Nothing

    else
        Just nick


{-| Validate free text (mirroring `normalizeFreeText`: controls refuse
with their own message, blank yields `Nothing` for the caller default,
overlong refuses with the keep-under message). -}
normalizeOperFreeText : String -> Int -> String -> Maybe (Result String String)
normalizeOperFreeText value max label =
    if hasControlChars value then
        Just (Err ("The " ++ label ++ " cannot include line breaks or control characters."))

    else
        let
            text =
                String.trim value
        in
        if String.isEmpty text then
            Nothing

        else if String.length text > max then
            Just (Err ("Keep the " ++ label ++ " under " ++ String.fromInt max ++ " characters."))

        else
            Just (Ok text)


{-| Map a composer slash verb to an operator intent (mirroring
`parseOperSlashCommand`, `Nothing` when the verb is not an operator
command and the caller falls through to generic handling). -}
parseOperSlashCommand : String -> List String -> Maybe OperDeskIntent
parseOperSlashCommand name args =
    let
        verb =
            String.toLower (String.trim name)

        rest =
            String.join " " args

        first =
            String.toLower (String.trim (Maybe.withDefault "" (List.head args)))
    in
    case verb of
        "broadcast" ->
            Just (OperBroadcast rest)

        "wallops" ->
            Just (OperBroadcast rest)

        "kill" ->
            Just (OperKill { target = Maybe.withDefault "" (List.head args), reason = String.join " " (Maybe.withDefault [] (List.tail args)) })

        "rehash" ->
            Just OperRehash

        "privs" ->
            Just OperPrivs

        "events" ->
            if first == "add" then
                Just (OperEventSubscribe (Maybe.withDefault "" (args |> List.drop 1 |> List.head)))

            else if first == "del" || first == "remove" then
                Just (OperEventUnsubscribe (Maybe.withDefault "" (args |> List.drop 1 |> List.head)))

            else
                Just OperEventList

        "observe" ->
            if first == "" || first == "list" then
                Just OperObserveList

            else if first == "off" || first == "clear" then
                Just OperObserveOff

            else
                Just (OperObserve { mask = Maybe.withDefault "" (List.head args), actions = Maybe.withDefault [] (List.tail args) })

        _ ->
            Nothing


{-| Validate an operator intent into its exact wire command (mirroring
`planOperAction`: fail-closed, `Err` carries the desk copy and nothing
sends). -}
planOperAction : OperDeskIntent -> Result (List String) OperDeskCommand
planOperAction intent =
    let
        planned =
            case intent of
                OperBroadcast text ->
                    if hasControlChars text then
                        Err [ "The broadcast cannot include line breaks or control characters." ]

                    else
                        case normalizeOperFreeText text maxBroadcastLength "broadcast" of
                            Nothing ->
                                Err [ "Write the announcement first." ]

                            Just (Err message) ->
                                Err [ message ]

                            Just (Ok clean) ->
                                Ok { command = "EVENT", params = [ "BROADCAST", clean ], summary = "Announce to operators subscribed to ANNOUNCE: \u{201C}" ++ clean ++ "\u{201D}.", destructive = True }

                OperEventSubscribe category ->
                    if hasControlChars category then
                        Err [ "Pick a category from the Event Spine list." ]

                    else
                        case normalizeOperCategory category of
                            Nothing ->
                                Err [ "Pick a category from the Event Spine list." ]

                            Just known ->
                                Ok { command = "EVENT", params = [ "ADD", known ], summary = "Receive " ++ known ++ " events from every node on the network.", destructive = False }

                OperEventUnsubscribe category ->
                    if hasControlChars category then
                        Err [ "Pick a category from the Event Spine list." ]

                    else
                        case normalizeOperCategory category of
                            Nothing ->
                                Err [ "Pick a category from the Event Spine list." ]

                            Just known ->
                                Ok { command = "EVENT", params = [ "DEL", known ], summary = "Stop receiving " ++ known ++ " events.", destructive = False }

                OperEventList ->
                    Ok { command = "EVENT", params = [ "LIST" ], summary = "List the Event Spine categories this session is subscribed to.", destructive = False }

                OperObserve { mask, actions } ->
                    if hasControlChars mask || List.any hasControlChars actions then
                        Err [ "The OBSERVE mask and actions cannot include control characters." ]

                    else
                        case normalizeObserveMask mask of
                            Nothing ->
                                Err [ "Enter a nick!user@host mask, wildcards allowed." ]

                            Just clean ->
                                case normalizeObserveActions actions of
                                    Nothing ->
                                        Err [ "Pick from connect, quit, nick, join, part, host, or oper." ]

                                    Just ordered ->
                                        Ok
                                            { command = "EVENT"
                                            , params = [ "OBSERVE", clean ] ++ ordered
                                            , summary =
                                                if List.isEmpty ordered then
                                                    "Watch " ++ clean ++ " network-wide. Their real host is revealed to you."

                                                else
                                                    "Watch " ++ clean ++ " network-wide for " ++ String.join ", " ordered ++ ". Their real host is revealed to you."
                                            , destructive = False
                                            }

                OperObserveList ->
                    Ok { command = "EVENT", params = [ "OBSERVE", "LIST" ], summary = "List the standing OBSERVE masks on this session.", destructive = False }

                OperObserveOff ->
                    Ok { command = "EVENT", params = [ "OBSERVE", "OFF" ], summary = "Clear every standing OBSERVE mask on this session.", destructive = False }

                OperRehash ->
                    Ok { command = "REHASH", params = [], summary = "Ask this node to reload its configuration (382 confirms).", destructive = True }

                OperPrivs ->
                    Ok { command = "PRIVS", params = [], summary = "Show the operator privileges this session holds (270).", destructive = False }

                OperKill { target, reason } ->
                    let
                        errors =
                            if hasControlChars target then
                                [ "Enter the nickname to disconnect." ]

                            else
                                case normalizeOperNick target of
                                    Nothing ->
                                        [ "Enter the nickname to disconnect." ]

                                    Just _ ->
                                        []
                    in
                    case normalizeOperFreeText reason maxKillReasonLength "reason" of
                        Just (Err message) ->
                            Err (errors ++ [ message ])

                        Just (Ok clean) ->
                            if not (List.isEmpty errors) then
                                Err errors

                            else
                                case normalizeOperNick target of
                                    Nothing ->
                                        Err errors

                                    Just nick ->
                                        Ok { command = "KILL", params = [ nick, clean ], summary = "Disconnect " ++ nick ++ " from the network with the reason \u{201C}" ++ clean ++ "\u{201D}.", destructive = True }

                        Nothing ->
                            if List.isEmpty errors then
                                Err [ "A reason is required — it is recorded network-wide." ]

                            else
                                Err errors
    in
    planned
        |> Result.andThen
            (\command ->
                Wire.encodeIrcLine command.command command.params
                    |> Result.map (always command)
                    |> Result.mapError (always [ "The operator command could not be encoded safely." ])
            )

{-| Run an operator slash verb (mirroring the oracle arm plus the shared
`operAction` choke point: offline the dispatch never runs so only the
draft clears; a failed plan warns with `Operator command`; without oper
status the session refuses instead of leaking intent; otherwise the
planned line sends. Success is silent. The admission-queue nuance
(`uncertain`/`refused` toasts) has no Elm port — a `Live` link sends;
see docs/COVERAGE.md). -}
operAccessRequired : Model -> Model
operAccessRequired model =
    addToast
        { variant = ToastError
        , title = "Operator access required"
        , description = Just "This network grants operator status from the signed-in account."
        , duration = Nothing
        , groupKey = Nothing
        , undo = Nothing
        }
        model.nowMs
        model


runSlashOper : Model -> String -> ( Model, List Outbound )
runSlashOper model verb =
    if model.connection /= Live then
        ( { model | composer = "" }, [] )

    else
        let
            args =
                case String.split " " (String.dropLeft 1 model.composer) of
                    _ :: rest ->
                        rest

                    [] ->
                        []
        in
        case parseOperSlashCommand verb args of
            Nothing ->
                if not model.isOper then
                    -- The raw fallback is still an operator verb: it never
                    -- leaves without operator status.
                    ( operAccessRequired model, [] )

                else
                case Wire.encodeIrcLine (String.toUpper verb) args of
                    Ok line ->
                        ( { model | composer = "", composerError = Nothing }, [ SendLine line ] )

                    Err _ ->
                        ( { model | composerError = Just "The command could not be encoded safely; your draft was kept." }, [] )

            Just intent ->
                case planOperAction intent of
                    Err errors ->
                        ( addToast
                            { variant = ToastWarning
                            , title = "Operator command"
                            , description = Just (String.join " " errors)
                            , duration = Nothing
                            , groupKey = Nothing
                            , undo = Nothing
                            }
                            model.nowMs
                            model
                        , []
                        )

                    Ok command ->
                        if not model.isOper then
                            ( operAccessRequired model, [] )

                        else
                            case Wire.encodeIrcLine command.command command.params of
                                Ok line ->
                                    ( { model | composer = "", composerError = Nothing }, [ SendLine line ] )

                                Err _ ->
                                    ( { model | composerError = Just "The operator command could not be encoded safely; your draft was kept." }, [] )


{-| Run `/star` / `/unstar` (mirroring the oracle arm: the room resolves
like mute, invalid rooms coach with `Star a room`, and the toggle
unstars when asked or already starred — checking both the lowered and
the raw key exactly like the oracle. Success is silent (no toast);
only the consumed draft clears). -}
runSlashStar : Model -> String -> String -> Maybe String -> ( Model, List Outbound )
runSlashStar model verb target nickArg =
    case slashChannelTarget model target nickArg of
        Nothing ->
            ( addToast
                { variant = ToastWarning
                , title = "Star a room"
                , description = Just "Use /star in a room, or /star #room."
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                { model | composer = "" }
            , []
            )

        Just ch ->
            if verb == "unstar" || Set.member (String.toLower ch) model.starredChannels || Set.member ch model.starredChannels then
                let
                    ( updated, out ) =
                        unstarChannel model ch
                in
                ( { updated | composer = "" }, out )

            else
                let
                    ( updated, out ) =
                        starChannel model ch
                in
                ( { updated | composer = "" }, out )


{-| Run `/snooze [minutes]` / `/dnd on|off|minutes` (mirroring the
oracle arm: `off`/`0`/`clear` clears both axes, `on`/empty sets manual
DND, otherwise a 1–1440 minute timer lands on `dndUntil` with manual
DND off; out-of-range or unparseable input only coaches. `String.toFloat`
does not read hex the way JS `Number` does — exotic inputs warn
instead of snoozing (documented narrowing). -}
runSlashDnd : Model -> String -> ( Model, List Outbound )
runSlashDnd model raw =
    if raw == "off" || raw == "0" || raw == "clear" then
        let
            ( updated, out ) =
                setDnd model False Nothing
        in
        ( addToast
            { variant = ToastInfo
            , title = "Do not disturb off"
            , description = Just "Desktop and sound alerts resume (quiet hours still apply)."
            , duration = Nothing
            , groupKey = Nothing
            , undo = Nothing
            }
            model.nowMs
            { updated | composer = "" }
        , out
        )

    else if raw == "on" || raw == "" then
        let
            ( updated, out ) =
                setDnd model True Nothing
        in
        ( addToast
            { variant = ToastInfo
            , title = "Do not disturb on"
            , description = Just "Alerts are silenced until you turn DND off."
            , duration = Nothing
            , groupKey = Nothing
            , undo = Nothing
            }
            model.nowMs
            { updated | composer = "" }
        , out
        )

    else
        case String.toFloat raw of
            Just mins ->
                if isNaN mins || isInfinite mins || mins <= 0 || mins > 1440 then
                    ( slashSnoozeCoaching model, [] )

                else
                    let
                        whole =
                            floor mins

                        ( updated, out ) =
                            setDnd model False (Just (floor model.nowMs + whole * 60000))
                    in
                    ( addToast
                        { variant = ToastInfo
                        , title = "Snoozed " ++ String.fromInt whole ++ "m"
                        , description = Just "Alerts pause until the timer ends."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        { updated | composer = "" }
                    , out
                    )

            Nothing ->
                ( slashSnoozeCoaching model, [] )


{-| Snooze range coaching (mirroring the oracle warning). -}
slashSnoozeCoaching : Model -> Model
slashSnoozeCoaching model =
    addToast
        { variant = ToastWarning
        , title = "Snooze"
        , description = Just "Use /snooze <minutes> (1\u{2013}1440), or /dnd on|off."
        , duration = Nothing
        , groupKey = Nothing
        , undo = Nothing
        }
        model.nowMs
        { model | composer = "" }


{-| Run a local slash command (mirroring the oracle `/ignore` /
`/unignore` / `/read` / `/clear` / `/whois` / `/highlight` / `/unhighlight` / `/snooze` / `/dnd` arms: silent folds — the fold's own
`Blocked`/`Unblocked` undo toast would double-chrome here — plus the
slash info toast, and the draft clears since the command is consumed.
The bare `/ignore` lists the set in codepoint order where the oracle
uses `localeCompare('en')` (same documented caveat as the blocklist
catalogue); a corrupt-draft `/` alone keeps the PRIVMSG path. -}
runSlashLocal : Model -> String -> String -> Maybe String -> ( Model, List Outbound )
runSlashLocal model target verb nickArg =
    case ( verb, nickArg ) of
        ( "ignore", Just nick ) ->
            let
                ( updated, out ) =
                    applyBlocklistAction False model (IgnoreUser nick)
            in
            ( addToast
                { variant = ToastInfo
                , title = "Ignoring " ++ nick
                , description = Just "Their messages are hidden on this device. Notifications are silenced too."
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                { updated | composer = "" }
            , out
            )

        ( "unignore", Just nick ) ->
            let
                ( updated, out ) =
                    applyBlocklistAction False model (UnignoreUser nick)
            in
            ( addToast
                { variant = ToastInfo
                , title = "Unignored " ++ nick
                , description = Just "Messages and notifications from this name resume on this device."
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                { updated | composer = "" }
            , out
            )

        ( "ignore", Nothing ) ->
            let
                listed =
                    List.sort (Set.toList model.ignoredUsers)

                count =
                    List.length listed

                title =
                    if count == 0 then
                        "Ignore list empty"

                    else
                        "Ignoring " ++ String.fromInt count

                description =
                    if count == 0 then
                        "Use /ignore <nick>, the message menu, or Preferences → Conversation."

                    else
                        String.join ", " (List.take 12 listed)
                            ++ (if count > 12 then
                                    "…"

                                else
                                    ""
                               )
            in
            ( addToast
                { variant = ToastInfo
                , title = title
                , description = Just description
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                { model | composer = "" }
            , []
            )

        ( "clear", _ ) ->
            let
                cleared =
                    clearScrollback model target
            in
            ( addToast
                { variant = ToastInfo
                , title = "Scrollback cleared"
                , description = Just "Local history for this view was cleared on this device only."
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                { cleared | composer = "" }
            , []
            )

        ( "history", _ ) ->
            -- Opens the message-search panel (mirroring the oracle
            -- `/history` → `openMessageSearch`): the unified Elm panel
            -- covers live scrollback plus vault recall.
            ( scheduleVaultSearch { model | searchOpen = True, composer = "" }, [] )

        ( "search", queryArg ) ->
            -- Opens the message-search panel with the joined tail as
            -- the query (mirroring the oracle `/search` →
            -- `openMessageSearchWithQuery(q)`; empty opens bare,
            -- mirroring `openMessageSearch`).
            case queryArg of
                Nothing ->
                    ( scheduleVaultSearch { model | searchOpen = True, composer = "" }, [] )

                Just query ->
                    ( scheduleVaultSearch
                        { model
                            | searchOpen = True
                            , searchQuery = Search.boundQueryInput query
                            , searchIndex = 0
                            , composer = ""
                        }
                    , []
                    )

        ( "export", formatArg ) ->
            -- Local scrollback download for this view (mirroring the
            -- oracle `/export [txt|json]` → `buildConversationExport`
            -- + `downloadConversationExport`).
            runSlashExport model (Maybe.withDefault "txt" formatArg)

        ( "import", _ ) ->
            -- Snapshot import trigger (new surface: the `VaultImportPick`
            -- port has had no UI until now — the validated merge path
            -- behind it mirrors `importVault`).
            ( { model | composer = "" }, [ VaultImportPick ] )

        ( "read", _ ) ->
            let
                ( marked, out ) =
                    recordLocalReadMarker model target
            in
            ( addToast
                { variant = ToastInfo
                , title = "Marked read"
                , description = Just ("Unread badges for " ++ target ++ " were cleared on this device.")
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                { marked | composer = "" }
            , out
            )

        ( "whois", Just nick ) ->
            let
                ( queried, out ) =
                    requestWhois model nick
            in
            ( { queried | composer = "" }, out )

        ( "whois", Nothing ) ->
            ( addToast
                { variant = ToastWarning
                , title = "Profile details"
                , description = Just "Use /whois <nick>."
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                { model | composer = "" }
            , []
            )

        ( "modex", maybeTarget ) ->
            let
                ( queried, out ) =
                    requestModex model (Maybe.withDefault "" maybeTarget)
            in
            ( queried, out )

        ( "highlight", Just phrase ) ->
            let
                ( updated, out ) =
                    addHighlightWord model phrase
            in
            ( addToast
                { variant = ToastInfo
                , title = "Highlight added"
                , description = Just ("Messages containing \u{201C}" ++ phrase ++ "\u{201D} will highlight on this device.")
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                { updated | composer = "" }
            , out
            )

        ( "unhighlight", Just phrase ) ->
            let
                ( updated, out ) =
                    removeHighlightWord model phrase
            in
            ( addToast
                { variant = ToastInfo
                , title = "Highlight removed"
                , description = Just ("\u{201C}" ++ phrase ++ "\u{201D} will no longer force a highlight.")
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                { updated | composer = "" }
            , out
            )

        ( "highlight", Nothing ) ->
            ( slashWordCoaching model "highlight", [] )

        ( "unhighlight", Nothing ) ->
            ( slashWordCoaching model "unhighlight", [] )

        ( "snooze", Just raw ) ->
            runSlashDnd model raw

        ( "dnd", Just raw ) ->
            runSlashDnd model raw

        ( "mute", arg ) ->
            case slashChannelTarget model target arg of
                Just ch ->
                    let
                        ( updated, out ) =
                            setChannelNotify model ch "none"
                    in
                    ( addToast
                        { variant = ToastInfo
                        , title = "Muted " ++ ch
                        , description = Just "Notifications for this room are off on this device."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        { updated | composer = "" }
                    , out
                    )

                Nothing ->
                    ( addToast
                        { variant = ToastWarning
                        , title = "Mute a room"
                        , description = Just "Use /mute in a room, or /mute #room."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        { model | composer = "" }
                    , []
                    )

        ( "unmute", arg ) ->
            case slashChannelTarget model target arg of
                Just ch ->
                    let
                        ( updated, out ) =
                            setChannelNotify model ch "all"
                    in
                    ( addToast
                        { variant = ToastInfo
                        , title = "Unmuted " ++ ch
                        , description = Just "Room notifications resume (mentions still follow this room notify mode)."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        { updated | composer = "" }
                    , out
                    )

                Nothing ->
                    ( addToast
                        { variant = ToastWarning
                        , title = "Mute a room"
                        , description = Just "Use /mute in a room, or /mute #room."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        { model | composer = "" }
                    , []
                    )

        ( "notify", arg ) ->
            if not (isChannelName model target) then
                ( addToast
                    { variant = ToastWarning
                    , title = "Room notifications"
                    , description = Just "Use /notify all|mentions|mute inside a room."
                    , duration = Nothing
                    , groupKey = Nothing
                    , undo = Nothing
                    }
                    model.nowMs
                    { model | composer = "" }
                , []
                )

            else
                case String.toLower (Maybe.withDefault "" arg) of
                    "all" ->
                        runSlashNotifyMode model target "all" "all" ("Personal notification mode for " ++ target ++ " on this device.")

                    "mentions" ->
                        runSlashNotifyMode model target "mentions" "mentions" (target ++ " still badges @ on this device.")

                    "mute" ->
                        runSlashNotifyMode model target "mute" "none" (target ++ " is hard-silenced on this device. You will not be tapped.")

                    "none" ->
                        runSlashNotifyMode model target "mute" "none" (target ++ " is hard-silenced on this device. You will not be tapped.")

                    _ ->
                        ( addToast
                            { variant = ToastWarning
                            , title = "Notify mode"
                            , description = Just "Use /notify all, /notify mentions, or /notify mute."
                            , duration = Nothing
                            , groupKey = Nothing
                            , undo = Nothing
                            }
                            model.nowMs
                            { model | composer = "" }
                        , []
                        )

        ( "star", arg ) ->
            runSlashStar model "star" target arg

        ( "unstar", arg ) ->
            runSlashStar model "unstar" target arg

        ( "autojoin", arg ) ->
            case slashChannelTarget model target arg of
                Just ch ->
                    let
                        ( updated, out ) =
                            addAutoJoin model ch
                    in
                    ( addToast
                        { variant = ToastInfo
                        , title = "Auto-join " ++ ch
                        , description = Just "This room will be rejoined on this device after reconnect."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        { updated | composer = "" }
                    , out
                    )

                Nothing ->
                    ( addToast
                        { variant = ToastWarning
                        , title = "Auto-join"
                        , description = Just "Use /autojoin in a room, or /autojoin #room."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        { model | composer = "" }
                    , []
                    )

        ( "unautojoin", arg ) ->
            case slashChannelTarget model target arg of
                Just ch ->
                    let
                        ( updated, out ) =
                            removeAutoJoin model ch
                    in
                    ( addToast
                        { variant = ToastInfo
                        , title = "Removed auto-join for " ++ ch
                        , description = Just "Reconnect will no longer force-join this room from this device."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        { updated | composer = "" }
                    , out
                    )

                Nothing ->
                    ( addToast
                        { variant = ToastWarning
                        , title = "Auto-join"
                        , description = Just "Use /autojoin in a room, or /autojoin #room."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        { model | composer = "" }
                    , []
                    )

        ( "color", arg ) ->
            if not (isChannelName model target) then
                ( addToast
                    { variant = ToastWarning
                    , title = "Room color"
                    , description = Just "Use /color #hex in a room."
                    , duration = Nothing
                    , groupKey = Nothing
                    , undo = Nothing
                    }
                    model.nowMs
                    { model | composer = "" }
                , []
                )

            else
                let
                    raw =
                        Maybe.withDefault "" arg
                in
                if raw == "" || raw == "clear" || raw == "off" || raw == "reset" then
                    let
                        ( updated, out ) =
                            clearChannelColor model target
                    in
                    ( addToast
                        { variant = ToastInfo
                        , title = "Room color cleared"
                        , description = Just (target ++ " uses the default accent again.")
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        { updated | composer = "" }
                    , out
                    )

                else
                    let
                        ( updated, out ) =
                            setChannelColor model target raw
                    in
                    ( addToast
                        { variant = ToastInfo
                        , title = "Room color set"
                        , description = Just (target ++ " accent updated on this device.")
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        { updated | composer = "" }
                    , out
                    )

        ( "help", arg ) ->
            case String.toLower (Maybe.withDefault "" arg) of
                "" ->
                    ( addToast
                        { variant = ToastInfo
                        , title = "Local slash commands"
                        , description = Just localSlashCommandList
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        { model | composer = "" }
                    , []
                    )

                needle ->
                    case findSlashCommand needle of
                        Just hit ->
                            ( addToast
                                { variant = ToastInfo
                                , title = hit.usage
                                , description = Just hit.description
                                , duration = Nothing
                                , groupKey = Nothing
                                , undo = Nothing
                                }
                                model.nowMs
                                { model | composer = "" }
                            , []
                            )

                        Nothing ->
                            ( addToast
                                { variant = ToastWarning
                                , title = "Unknown command"
                                , description = Just ("No slash command named \u{201C}" ++ needle ++ "\u{201D}. Try /help.")
                                , duration = Nothing
                                , groupKey = Nothing
                                , undo = Nothing
                                }
                                model.nowMs
                                { model | composer = "" }
                            , []
                            )

        ( "event", _ ) ->
            runSlashEvent model target

        ( "broadcast", _ ) ->
            runSlashOper model "broadcast"

        ( "wallops", _ ) ->
            runSlashOper model "wallops"

        ( "kill", _ ) ->
            runSlashOper model "kill"

        ( "rehash", _ ) ->
            runSlashOper model "rehash"

        ( "privs", _ ) ->
            runSlashOper model "privs"

        ( "events", _ ) ->
            runSlashOper model "events"

        ( "observe", _ ) ->
            runSlashOper model "observe"

        _ ->
            ( addToast
                { variant = ToastWarning
                , title = "Unignore whom?"
                , description = Just "Use /unignore <nick>, or Preferences → Conversation."
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                { model | composer = "" }
            , []
            )


{-| Channel directory (`LIST` fold), mirroring the oracle `channelList`
slice: `refreshChannelList` sends `LIST` while live (offline keeps the
cached directory and never implies loading; a second refresh while one
is in flight, or while quarantined, is a no-op), `322` rows merge into
the in-flight request only while loading and unquarantined (stray rows
never populate retained UI state), and `323` commits the request over
the visible list.

`mergeChannelListRow` mirrors the oracle exactly: names must open with
`#`/`&` and carry no comma (plus the shared wire-token bound);
duplicates keep the first-seen name, take the max count, and fill a
blank topic only; the request caps at `maxChannelListEntries` (2048)
while duplicates always merge. Counts clamp at zero (Elm `Int` has no
non-safe-integer hole — `String.toInt` failure reads as 0, matching the
oracle's `parseInt || 0` fallback shape); topics bound at
`maxToastTextLength` like other system text.

The 15s watchdog mirrors the oracle timer on the 1s Tick (no new
ports): on expiry the generation turns, the socket quarantines (late
rows drop until its `323` releases it), and the visible list falls back
to the last committed directory. `_resetChannelListTransport` (connect
/ reconnect / ownership change) maps to `resetChannelListTransport`:
generation turns, the deadline clears, quarantine releases. The browser sheet (`View.Browser` / `openBrowser`) and room formation
(`View.Formation`) read this directory.
-}
type alias ChannelListEntry =
    { name : String
    , count : Int
    , topic : String
    }


maxChannelListEntries : Int
maxChannelListEntries =
    2048


channelListTimeoutMs : Float
channelListTimeoutMs =
    15000


mergeChannelListRow : List ChannelListEntry -> ChannelListEntry -> List ChannelListEntry
mergeChannelListRow rows next =
    let
        head =
            String.left 1 next.name

        -- A directory row is server-shaped: the shared wire-token gate
        -- (mirroring `_validInboundWireToken`, control class included)
        -- plus the channel sigil, exactly like the oracle merge.
        valid =
            validWireToken next.name 512 && (head == "#" || head == "&")
    in
    if not valid then
        rows

    else
        let
            key =
                String.toLower next.name

            normalized =
                { name = next.name
                , count = max 0 next.count
                , topic = boundSystemEventText next.topic
                }

            mergeInto existing =
                if String.toLower existing.name /= key then
                    existing

                else
                    { name = existing.name
                    , count = max existing.count normalized.count
                    , topic =
                        if String.isEmpty (String.trim existing.topic) then
                            normalized.topic

                        else
                            existing.topic
                    }
        in
        if List.any (\row -> String.toLower row.name == key) rows then
            List.map mergeInto rows

        else if List.length rows < maxChannelListEntries then
            rows ++ [ normalized ]

        else
            rows


parseChannelListRow : List String -> Maybe ChannelListEntry
parseChannelListRow params =
    case params of
        _ :: name :: countRaw :: rest ->
            if String.isEmpty name then
                Nothing

            else
                Just
                    { name = name
                    -- Member counts read like every other wire count
                    -- (mirroring `parseInt` + the safe-integer floor:
                    -- prefixes parse, garbage/overflow/negatives zero).
                    , count = Services.boundedNumber (Just countRaw)
                    , topic = trailingParam rest
                    }

        _ ->
            Nothing


openBrowser : Model -> ( Model, List Outbound )
openBrowser model =
    refreshChannelList { model | browserOpen = True, browserMode = BrowseMode }


statsRoomHref : String -> String
statsRoomHref channel =
    "/stats/?room=" ++ Url.percentEncode channel


{-| Room formation: Start-a-room loop (name + optional skin + share 3 people).

Mirrors `src/lib/rooms/createRoomFormation.ts`. Same joinable shape as
`?join=`: bare "friends" becomes "#friends". Elm owns validation and the
topic builder; the share sheet / clipboard stay behind ports.
-}


type RoomSkin
    = FriendsSkin
    | ClubSkin
    | CreatorSkin


type alias RoomSkinOption =
    { id : RoomSkin
    , label : String
    , blurb : String
    , topicSeed : String
    , firstLine : String
    }


roomSkins : List RoomSkinOption
roomSkins =
    [ { id = FriendsSkin
      , label = "Friends"
      , blurb = "People who already know each other."
      , topicSeed = "Friends hang"
      , firstLine = "hey — this is our room"
      }
    , { id = ClubSkin
      , label = "Club"
      , blurb = "A recurring hang — class, project, or club."
      , topicSeed = "Club hang"
      , firstLine = "first meeting — when can you do Saturday?"
      }
    , { id = CreatorSkin
      , label = "Creator"
      , blurb = "A place for an audience to gather."
      , topicSeed = "Creator room"
      , firstLine = "welcome in — say hi if you are here"
      }
    ]


roomSkinOption : Maybe RoomSkin -> Maybe RoomSkinOption
roomSkinOption maybeSkin =
    case maybeSkin of
        Nothing ->
            Nothing

        Just skin ->
            List.filter (\option -> option.id == skin) roomSkins
                |> List.head


defaultFirstLine : String
defaultFirstLine =
    "hey — this is our room"


suggestedFirstLine : Maybe RoomSkin -> String
suggestedFirstLine maybeSkin =
    roomSkinOption maybeSkin
        |> Maybe.map .firstLine
        |> Maybe.withDefault defaultFirstLine


{-| JS `\s` shape: ASCII whitespace plus the extra Unicode spaces. -}
isRoomSpaceChar : Char -> Bool
isRoomSpaceChar c =
    (let code = Char.toCode c in
        code == 0x20 || (code >= 0x09 && code <= 0x0D)
     )
        || (let code = Char.toCode c in
                code == 0x00A0
                    || code == 0x1680
                    || (code >= 0x2000 && code <= 0x200A)
                    || code == 0x2028
                    || code == 0x2029
                    || code == 0x202F
                    || code == 0x205F
                    || code == 0x3000
                    || code == 0xFEFF
           )


isJoinableRoomChar : Char -> Bool
isJoinableRoomChar c =
    let
        code =
            Char.toCode c
    in
    c /= ',' && code >= 0x20 && code /= 0x7F && not (isRoomSpaceChar c)


{-| Consumer create-room names: bare "friends" becomes "#friends". -}
normalizeCreateRoomName : String -> Maybe String
normalizeCreateRoomName raw =
    let
        trimmed =
            String.trim raw
    in
    if String.isEmpty trimmed then
        Nothing

    else
        let
            prefixed =
                if String.startsWith "#" trimmed || String.startsWith "&" trimmed then
                    trimmed

                else
                    "#" ++ trimmed

            normalized =
                String.toLower prefixed

            rest =
                String.dropLeft 1 normalized
        in
        if String.isEmpty rest || String.length rest > 63 then
            Nothing

        else if List.all isJoinableRoomChar (String.toList rest) then
            Just normalized

        else
            Nothing


createTopicMaxChars : Int
createTopicMaxChars =
    300


{-| Deep-link `?join=` handoff (`/app/?join=%23room&at=…&topic=…`),
mirroring `src/lib/deeplink.ts`: the raw query value is
percent-decoded, then validated against IRC channel-name rules
before it may reach a JOIN. Anything malformed is ignored — a bad
link never breaks the connect flow.
-}
parseDeepLinkJoin : String -> Maybe String
parseDeepLinkJoin raw =
    case Url.percentDecode raw of
        Nothing ->
            Nothing

        Just decoded ->
            let
                trimmed =
                    String.trim decoded
            in
            if String.length trimmed < 2 || String.length trimmed > 64 then
                Nothing

            else if not (String.startsWith "#" trimmed || String.startsWith "&" trimmed) then
                Nothing

            else if List.all isJoinableRoomChar (String.toList (String.dropLeft 1 trimmed)) then
                Just trimmed

            else
                Nothing


{-| Deep-link `?topic=` label (mirroring `parseTopicParam`: non-empty,
no control chars or commas, at most 50 UTF-8 bytes). -}
maxDeepLinkTopicBytes : Int
maxDeepLinkTopicBytes =
    50


parseDeepLinkTopic : String -> Maybe String
parseDeepLinkTopic raw =
    case Url.percentDecode raw of
        Nothing ->
            Nothing

        Just decoded ->
            let
                trimmed =
                    String.trim decoded
            in
            if String.isEmpty trimmed then
                Nothing

            else if List.any (\c -> isTopicControlChar c || c == ',') (String.toList trimmed) then
                Nothing

            else if utf8ByteLength trimmed > maxDeepLinkTopicBytes then
                Nothing

            else
                Just trimmed


{-| Deep-link `?at=` moment (mirroring `parseAtParam`: epoch seconds,
epoch milliseconds, or ISO-8601; sane range only). Result is epoch
milliseconds. -}
atParamMinMs : Float
atParamMinMs =
    1577836800000


atParamFutureSlackMs : Float
atParamFutureSlackMs =
    86400000


parseDeepLinkAt : Float -> String -> Maybe Float
parseDeepLinkAt nowMs raw =
    case Url.percentDecode raw of
        Nothing ->
            Nothing

        Just decoded ->
            let
                trimmed =
                    String.trim decoded

                parsed =
                    if not (String.isEmpty trimmed) && String.all Char.isDigit trimmed then
                        if String.length trimmed <= 10 then
                            Maybe.map (\s -> s * 1000) (String.toFloat trimmed)

                        else if String.length trimmed <= 14 then
                            String.toFloat trimmed

                        else
                            Nothing

                    else
                        parseIso8601Ms trimmed
            in
            case parsed of
                Nothing ->
                    Nothing

                Just ms ->
                    if ms >= atParamMinMs && ms <= nowMs + atParamFutureSlackMs then
                        Just ms

                    else
                        Nothing


{-| First-wins query lookup over a raw `?a=b&c=d` string. -}
deepLinkQueryValue : String -> String -> Maybe String
deepLinkQueryValue key query =
    List.foldl
        (\pair found ->
            case found of
                Just _ ->
                    found

                Nothing ->
                    case String.indexes "=" pair of
                        [] ->
                            Nothing

                        at :: _ ->
                            if String.left at pair == key then
                                Just (String.dropLeft (at + 1) pair)

                            else
                                Nothing
        )
        Nothing
        (String.split "&" query)


{-| Parsed deep-link handoff: `?join=` gates everything (mirroring
`setPendingDeepLinkJoin`, where `at`/`topic` clear without a
channel). `at` stays raw here — it parses against the live clock
when the link fires. -}
type alias DeepLinkQuery =
    { join : Maybe String
    , at : Maybe String
    , topic : Maybe String
    }


parseDeepLinkQuery : Maybe String -> DeepLinkQuery
parseDeepLinkQuery rawQuery =
    case Maybe.andThen (deepLinkQueryValue "join") rawQuery
        |> Maybe.andThen parseDeepLinkJoin of
        Nothing ->
            { join = Nothing, at = Nothing, topic = Nothing }

        Just channel ->
            { join = Just channel
            , at = Maybe.andThen (deepLinkQueryValue "at") rawQuery
            , topic =
                Maybe.andThen (deepLinkQueryValue "topic") rawQuery
                    |> Maybe.andThen parseDeepLinkTopic
            }


isTopicControlChar : Char -> Bool
isTopicControlChar c =
    let
        code =
            Char.toCode c
    in
    code < 0x20 || code == 0x7F


{-| Optional topic. Empty is allowed; control characters are not. -}
sanitizeCreateRoomTopic : String -> Maybe String
sanitizeCreateRoomTopic raw =
    let
        trimmed =
            String.trim raw
    in
    if String.isEmpty trimmed then
        Just ""

    else if String.length trimmed > createTopicMaxChars then
        Nothing

    else if List.any isTopicControlChar (String.toList trimmed) then
        Nothing

    else
        Just trimmed


isInviteeLeadChar : Char -> Bool
isInviteeLeadChar c =
    Char.isAlpha c
        || (let code = Char.toCode c in
                (code >= 0x5B && code <= 0x60) || (code >= 0x7B && code <= 0x7C)
           )


isInviteeChar : Char -> Bool
isInviteeChar c =
    isInviteeLeadChar c || Char.isDigit c || c == '-'


sanitizeCreateInvitee : String -> Maybe String
sanitizeCreateInvitee raw =
    let
        trimmed =
            String.trim raw
    in
    if String.isEmpty trimmed || String.length trimmed > 64 then
        Nothing

    else
        case String.toList trimmed of
            [] ->
                Nothing

            lead :: tail ->
                if isInviteeLeadChar lead && List.all isInviteeChar tail then
                    Just trimmed

                else
                    Nothing


type alias CreateRoomTopicInput =
    { skin : Maybe RoomSkin
    , topic : String
    , hangLabel : Maybe String
    }


buildCreateRoomTopic : CreateRoomTopicInput -> Maybe String
buildCreateRoomTopic input =
    let
        seedParts =
            case roomSkinOption input.skin of
                Just skin ->
                    [ skin.topicSeed ]

                Nothing ->
                    []
    in
    case sanitizeCreateRoomTopic input.topic of
        Nothing ->
            Nothing

        Just custom ->
            let
                withCustom =
                    if String.isEmpty custom then
                        seedParts

                    else
                        seedParts ++ [ custom ]
            in
            case Maybe.map String.trim input.hangLabel of
                Just hang ->
                    if String.isEmpty hang then
                        joinCreateTopicParts withCustom

                    else
                        case sanitizeCreateRoomTopic ("Next hang: " ++ hang) of
                            Nothing ->
                                Nothing

                            Just hangLine ->
                                joinCreateTopicParts
                                    (if String.isEmpty hangLine then
                                        withCustom

                                     else
                                        withCustom ++ [ hangLine ]
                                    )

                Nothing ->
                    joinCreateTopicParts withCustom


joinCreateTopicParts : List String -> Maybe String
joinCreateTopicParts parts =
    if List.isEmpty parts then
        Just ""

    else
        sanitizeCreateRoomTopic (String.join " · " parts)


formationInviteTarget : Int
formationInviteTarget =
    3


formationWindowHours : Int
formationWindowHours =
    48


formationCopy : String
formationCopy =
    "Rooms form when 3 people who know each other each send a message in the first two days."


canFinishCreateRoom : Bool -> Bool
canFinishCreateRoom sharedInvite =
    sharedInvite == True


addFormationInvitee : List String -> String -> Maybe (List String)
addFormationInvitee current raw =
    case sanitizeCreateInvitee raw of
        Nothing ->
            Nothing

        Just nick ->
            let
                key =
                    String.toLower nick
            in
            if List.any (\entry -> String.toLower entry == key) current then
                Just current

            else if List.length current >= formationInviteTarget then
                Just current

            else
                Just (current ++ [ nick ])


removeFormationInvitee : List String -> String -> List String
removeFormationInvitee current raw =
    let
        key =
            String.toLower (String.trim raw)
    in
    List.filter (\entry -> String.toLower entry /= key) current


{-| A shared-invite receipt is valid only for the exact invite payload that
was shared. Renaming the room (a new derived URL) requires a fresh receipt.
True when the stored receipt must be cleared.
-}
formationShareReset : String -> String -> Bool
formationShareReset lastUrl currentUrl =
    not (String.isEmpty lastUrl) && currentUrl /= lastUrl


{-| Skin change refreshes the first-line suggestion only when the composer
still holds an untouched suggestion (empty or one of the known seeds). -}
applySkinFirstLine : Maybe RoomSkin -> String -> String
applySkinFirstLine skin current =
    let
        known =
            List.map suggestedFirstLine [ Nothing, Just FriendsSkin, Just ClubSkin, Just CreatorSkin ]
    in
    if String.isEmpty current || List.member current known then
        suggestedFirstLine skin

    else
        current


{-| Pending room creation: the `createRoom` action arms a 15s window, sends
`JOIN` (which creates the room server-side when new), and settles on the
confirmed self-JOIN by sending `TOPIC` and prefilling the first line —
mirroring the oracle `_pendingCreateRoom` (channel match, expiry, prompt
clears on 471/473/474/475). Elm drops the client-generation/account guards:
a stale transport cannot arm one (WsOpened resets are terminal here).
-}
type alias PendingCreateRoom =
    { channel : String
    , topic : String
    , firstLine : String
    , dueMs : Float
    }


type alias CreateRoomRequest =
    { name : String
    , topic : String
    , firstLine : String
    }


pendingCreateRoomTimeoutMs : Float
pendingCreateRoomTimeoutMs =
    15000


createRoomOfflineError : String
createRoomOfflineError =
    "The room could not be started on this connection. Reconnect and try again; your form is still here."


{-| Arm a pending creation and send `JOIN`. Fails closed: an invalid name
or an offline transport arms nothing and admits nothing.
-}
startPendingCreateRoom : Model -> CreateRoomRequest -> ( Model, List Outbound, Bool )
startPendingCreateRoom model request =
    case normalizeCreateRoomName request.name of
        Nothing ->
            ( model, [], False )

        Just channel ->
            if model.connection /= Live then
                ( model, [], False )

            else
                ( { model
                    | pendingCreateRoom =
                        Just
                            { channel = channel
                            , topic = request.topic
                            , firstLine = String.trim request.firstLine
                            , dueMs = model.nowMs + pendingCreateRoomTimeoutMs
                            }
                    , createRoomError = Nothing
                  }
                , [ SendLine (Wire.formatIrcLine "JOIN" [ channel ]) ]
                , True
                )


{-| Settle a pending creation on the confirmed self-JOIN: send `TOPIC`
when one was built, land inside (closing the browser), and prefill the
first line — or just focus the composer when there is none. An expired
pending clears silently. A foreign room never settles ours.
-}
settlePendingCreateRoom : Model -> String -> ( Model, List Outbound )
settlePendingCreateRoom model channel =
    case model.pendingCreateRoom of
        Nothing ->
            ( model, [] )

        Just pending ->
            if String.toLower channel /= pending.channel then
                ( model, [] )

            else
                let
                    cleared =
                        { model | pendingCreateRoom = Nothing, browserOpen = False }
                in
                if cleared.nowMs >= pending.dueMs then
                    ( cleared, [] )

                else
                    let
                        topicOuts =
                            if String.isEmpty pending.topic then
                                []

                            else
                                [ SendLine (Wire.formatIrcLine "TOPIC" [ pending.channel, pending.topic ]) ]

                        ( selected, selectOuts ) =
                            update (ChannelSelect pending.channel) cleared

                        landed =
                            if String.isEmpty pending.firstLine then
                                selected

                            else
                                { selected | composer = pending.firstLine }
                    in
                    ( landed, topicOuts ++ selectOuts )


{-| A join prompt (471/473/474/475) for the pending room clears it —
mirroring the oracle prompt handlers.
-}
clearPendingCreateRoomFor : Model -> String -> Model
clearPendingCreateRoomFor model channel =
    case model.pendingCreateRoom of
        Just pending ->
            if String.toLower channel == pending.channel then
                { model | pendingCreateRoom = Nothing }

            else
                model

        Nothing ->
            model


{-| The 15s watchdog resolves on the 1s Tick (standing in for the
oracle's `setTimeout`): an unanswered creation simply disarms.
-}
firePendingCreateRoomTimeout : Float -> Model -> Model
firePendingCreateRoomTimeout nowMs model =
    case model.pendingCreateRoom of
        Just pending ->
            if nowMs >= pending.dueMs then
                { model | pendingCreateRoom = Nothing }

            else
                model

        Nothing ->
            model


{-| Channel-browser sheet mode, mirroring `channelBrowserMode`:
`BrowseMode` lists public rooms, `CreateMode` hosts the Start-a-room
formation loop.
-}
type BrowserMode
    = BrowseMode
    | CreateMode


openCreateRoom : Model -> Model
openCreateRoom model =
    { model | browserOpen = True, browserMode = CreateMode }


{-| Share URL for the current form name. `Nothing` until the name
normalizes — the preview then reads "Name the room to get a shareable
invite."
-}
createShareUrl : Model -> Maybe String
createShareUrl model =
    case normalizeCreateRoomName model.createName of
        Nothing ->
            Nothing

        Just channel ->
            Just
                (Invite.buildInviteLink
                    { channel = channel
                    , guestName = Nothing
                    , at = Nothing
                    , topic = Nothing
                    , reader = False
                    , inviter = Nothing
                    , faces = []
                    }
                    { network = "Onyx", origin = inviteOrigin model, appOrigin = "/app/" }
                    model.nowMs
                ).shareUrl


{-| A skin toggle also refreshes the first-line suggestion when it is
still untouched (empty or a known seed).
-}
toggleCreateSkin : Model -> RoomSkin -> Model
toggleCreateSkin model skin =
    let
        next =
            if model.createSkin == Just skin then
                Nothing

            else
                Just skin
    in
    { model
        | createSkin = next
        , createFirstLine = applySkinFirstLine next model.createFirstLine
    }


{-| Add the invitee draft. An invalid nick surfaces the verbatim form
error instead of touching the list.
-}
addCreateInvitee : Model -> Model
addCreateInvitee model =
    case addFormationInvitee model.createInvitees model.createInviteeDraft of
        Nothing ->
            { model | createInviteeError = "Enter a short name — letters or numbers, no spaces." }

        Just invitees ->
            { model | createInvitees = invitees, createInviteeDraft = "", createInviteeError = "" }


{-| Track the name input: renaming the room (a new derived URL) voids
the shared-invite receipt, mirroring the oracle payload effect.
-}
trackCreateNameInput : Model -> String -> Model
trackCreateNameInput model name =
    let
        renamed =
            { model | createName = name, createNameError = "" }

        currentUrl =
            Maybe.withDefault "" (createShareUrl renamed)
    in
    if formationShareReset renamed.createLastUrl currentUrl then
        { renamed
            | createLastUrl = currentUrl
            , createSharedInvite = False
            , createCopyStatus = "Room name changed. Share or copy the new invite before entering."
        }

    else
        { renamed | createLastUrl = currentUrl }


{-| Copy the invite link behind the clipboard port (single-flight, like
the invite route). The receipt lands on the `ClipboardResult`.
-}
requestCreateCopy : Model -> ( Model, List Outbound )
requestCreateCopy model =
    case createShareUrl model of
        Nothing ->
            ( model, [] )

        Just url ->
            if model.createCopyBusy then
                ( model, [] )

            else
                ( { model | createCopyBusy = True }
                , [ ClipboardCopy { text = url, tag = "create-invite" } ]
                )


{-| Settle the clipboard result for the creation invite: a copied link
is the shared-invite receipt for that exact payload.
-}
foldCreateCopyResult : Model -> Bool -> Model
foldCreateCopyResult model ok =
    if not model.createCopyBusy then
        model

    else if ok then
        { model
            | createCopyBusy = False
            , createSharedInvite = True
            , createSharedUrl = Maybe.withDefault "" (createShareUrl model)
            , createCopyStatus = "Invite link copied. Enter the room when you are ready."
        }

    else
        { model
            | createCopyBusy = False
            , createCopyStatus = "Copy failed. Select and copy the link shown above."
        }


{-| Submit the formation form: a valid name plus the shared-invite
receipt starts the pending creation. Either failure surfaces inline
and submits nothing.
-}
submitCreateRoom : Model -> ( Model, List Outbound )
submitCreateRoom model =
    case normalizeCreateRoomName model.createName of
        Nothing ->
            ( { model | createNameError = "Enter a short room name — letters or numbers, no spaces." }, [] )

        Just _ ->
            if not (canFinishCreateRoom model.createSharedInvite) then
                ( { model | createCopyStatus = "Copy or share the invite before entering the room." }, [] )

            else
                let
                    hangLabel =
                        if model.createIncludeHang && not (String.isEmpty (String.trim model.createHangLabel)) then
                            Just model.createHangLabel

                        else
                            Nothing
                in
                case buildCreateRoomTopic { skin = model.createSkin, topic = "", hangLabel = hangLabel } of
                    Nothing ->
                        ( { model | createRoomError = Just createRoomOfflineError }, [] )

                    Just topic ->
                        let
                            firstLine =
                                if model.createIncludeFirstLine then
                                    model.createFirstLine

                                else
                                    ""

                            ( started, outs, admitted ) =
                                startPendingCreateRoom
                                    model
                                    { name = model.createName, topic = topic, firstLine = firstLine }
                        in
                        if admitted then
                            ( { started | createNameError = "", createRoomError = Nothing }, outs )

                        else
                            ( { started | createRoomError = Just createRoomOfflineError }, outs )


{-| Account data verbs: the three honest You / Account jobs
(`src/lib/export/accountDataVerbs.ts`) — download what we store,
save this device's history (never re-importable), delete via the
existing DROP path. Elm owns the record builders; the DOM download
and the vault dump stay behind ports. Never a portable vault format.
-}


accountStoreRecordKind : String
accountStoreRecordKind =
    "onyx.account-store-record"


deviceHistoryCopyKind : String
deviceHistoryCopyKind =
    "onyx.device-history-copy"


accountDataVerbVersion : Int
accountDataVerbVersion =
    1


downloadWhatWeStoreHint : String
downloadWhatWeStoreHint =
    "Nick, email, and rooms you own. Not the chat."


deviceHistoryHint : String
deviceHistoryHint =
    "History lives on this device."


saveDeviceHistoryHint : String
saveDeviceHistoryHint =
    "The last ~400 messages per room on this device. You cannot load this back in."


isExportControl : Char -> Bool
isExportControl c =
    let
        code =
            Char.toCode c
    in
    (code <= 0x08) || code == 0x0B || code == 0x0C || (code >= 0x0E && code <= 0x1F) || code == 0x7F


scrubExportText : String -> Int -> String
scrubExportText text max =
    String.left max (String.filter (\c -> not (isExportControl c)) text)


safeExportFilenamePart : String -> String
safeExportFilenamePart raw =
    let
        cleaned =
            String.toList raw
                |> List.map
                    (\c ->
                        if Char.isAlphaNum c || c == '.' || c == '_' || c == '+' || c == '-' then
                            c

                        else
                            '_'
                    )
                |> String.fromList
                |> String.left 64
    in
    if String.isEmpty cleaned then
        "file"

    else
        cleaned


{-| Rooms where this nick holds founder (Q) or owner (q) on the client
roster — the exotic `PREFIX=(YQqov)` letters included.
-}
roomsOwnedByNick : List Channel -> String -> List String
roomsOwnedByNick rooms nick =
    let
        key =
            String.toLower (String.trim nick)
    in
    if String.isEmpty key then
        []

    else
        rooms
            |> List.filterMap
                (\room ->
                    let
                        name =
                            String.trim (scrubExportText room.name 256)
                    in
                    if String.isEmpty name then
                        Nothing

                    else
                        case Dict.get key room.members of
                            Just me ->
                                if Set.member 'Q' me.modes || Set.member 'q' me.modes then
                                    Just ( name, String.toLower name )

                                else
                                    Nothing

                            Nothing ->
                                Nothing
                )
            |> dedupeRooms
            |> List.map Tuple.first
            |> List.sort


dedupeRooms : List ( String, String ) -> List ( String, String )
dedupeRooms named =
    List.foldl
        (\( name, id ) ( seen, acc ) ->
            if Set.member id seen then
                ( seen, acc )

            else
                ( Set.insert id seen, acc ++ [ ( name, id ) ] )
        )
        ( Set.empty, [] )
        named
        |> Tuple.second


type alias AccountStoreRecord =
    { kind : String
    , version : Int
    , exportedAt : String
    , nick : String
    , account : String
    , email : Maybe String
    , registeredAt : Maybe String
    , roomsOwned : List String
    , note : String
    , historyNote : String
    }


type alias AccountStoreRecordInput =
    { nick : Maybe String
    , account : Maybe String
    , email : Maybe String
    , registeredAt : Maybe String
    , rooms : List Channel
    , exportedAt : String
    }


optionalScrubbed : Maybe String -> Int -> Maybe String
optionalScrubbed value max =
    case value of
        Nothing ->
            Nothing

        Just raw ->
            let
                next =
                    String.trim (scrubExportText raw max)
            in
            if String.isEmpty next then
                Nothing

            else
                Just next


buildAccountStoreRecord : AccountStoreRecordInput -> AccountStoreRecord
buildAccountStoreRecord input =
    let
        nick =
            Maybe.withDefault "" (optionalScrubbed input.nick 64)

        account =
            Maybe.withDefault nick (optionalScrubbed input.account 64)

        who =
            if String.isEmpty nick then
                account

            else
                nick
    in
    { kind = accountStoreRecordKind
    , version = accountDataVerbVersion
    , exportedAt = input.exportedAt
    , nick = nick
    , account = account
    , email = optionalScrubbed input.email 256
    , registeredAt = optionalScrubbed input.registeredAt 128
    , roomsOwned = roomsOwnedByNick input.rooms who
    , note = downloadWhatWeStoreHint
    , historyNote = deviceHistoryHint
    }


type alias DeviceHistoryCopyMessage =
    { id : String
    , time : String
    , from : String
    , type_ : String
    , text : String
    }


type alias DeviceHistoryCopyRoom =
    { target : String
    , messageCount : Int
    , messages : List DeviceHistoryCopyMessage
    }


type alias DeviceHistoryCopy =
    { kind : String
    , version : Int
    , exportedAt : String
    , reimportable : Bool
    , keepPerRoom : Int
    , note : String
    , rooms : List DeviceHistoryCopyRoom
    }


type alias HistoryCopySource =
    { id : String
    , at : Float
    , from : String
    , kind : String
    , body : String
    }


{-| Vault rows carry no message-kind slot, so they copy as the default
`msg` kind — mirroring `String(message.type ?? 'msg')`. Whatever the
vault stores is what copies (ciphertext for E2EE DMs, never transient
plaintext).
-}
vaultRowHistorySource : VaultRow -> HistoryCopySource
vaultRowHistorySource row =
    { id = row.id
    , at = toFloat row.at
    , from = row.from
    , kind = "msg"
    , body = row.body
    }


copyHistoryMessage : HistoryCopySource -> DeviceHistoryCopyMessage
copyHistoryMessage message =
    { id = scrubExportText message.id 128
    , time = millisToIso message.at
    , from = scrubExportText message.from 64
    , type_ = scrubExportText message.kind 32
    , text = scrubExportText message.body 8192
    }


buildDeviceHistoryCopy : String -> Int -> List { target : String, rows : List HistoryCopySource } -> DeviceHistoryCopy
buildDeviceHistoryCopy exportedAt keep targets =
    { kind = deviceHistoryCopyKind
    , version = accountDataVerbVersion
    , exportedAt = exportedAt
    , reimportable = False
    , keepPerRoom = keep
    , note = saveDeviceHistoryHint
    , rooms =
        List.map
            (\entry ->
                let
                    messages =
                        List.map copyHistoryMessage (takeLast keep entry.rows)
                in
                { target = scrubExportText entry.target 256
                , messageCount = List.length messages
                , messages = messages
                }
            )
            targets
    }


accountStoreRecordFilename : AccountStoreRecord -> String
accountStoreRecordFilename record =
    let
        day =
            String.left 10 record.exportedAt

        who =
            safeExportFilenamePart
                (if String.isEmpty record.account then
                    record.nick

                 else
                    record.account
                )
    in
    "onyx-account-record-" ++ who ++ "-" ++ (if String.isEmpty day then "export" else day) ++ ".json"


deviceHistoryCopyFilename : DeviceHistoryCopy -> String
deviceHistoryCopyFilename copy =
    let
        day =
            String.left 10 copy.exportedAt
    in
    "onyx-device-history-" ++ (if String.isEmpty day then "export" else day) ++ ".json"


{-| Which account-data verb owns the single-flight busy flag. -}
type AccountVerbsBusy
    = AccountStoreBusy
    | AccountHistoryBusy


encodeOptional : String -> Maybe String -> List ( String, Encode.Value )
encodeOptional key value =
    case value of
        Just text ->
            [ ( key, Encode.string text ) ]

        Nothing ->
            []


encodeAccountStoreRecord : AccountStoreRecord -> String
encodeAccountStoreRecord record =
    Encode.encode 2
        (Encode.object
            ([ ( "kind", Encode.string record.kind )
             , ( "version", Encode.int record.version )
             , ( "exportedAt", Encode.string record.exportedAt )
             , ( "nick", Encode.string record.nick )
             , ( "account", Encode.string record.account )
             ]
                ++ encodeOptional "email" record.email
                ++ encodeOptional "registeredAt" record.registeredAt
                ++ [ ( "roomsOwned", Encode.list Encode.string record.roomsOwned )
                   , ( "note", Encode.string record.note )
                   , ( "historyNote", Encode.string record.historyNote )
                   ]
            )
        )
        ++ "\n"


encodeDeviceHistoryMessage : DeviceHistoryCopyMessage -> Encode.Value
encodeDeviceHistoryMessage message =
    Encode.object
        [ ( "id", Encode.string message.id )
        , ( "time", Encode.string message.time )
        , ( "from", Encode.string message.from )
        , ( "type", Encode.string message.type_ )
        , ( "text", Encode.string message.text )
        ]


encodeDeviceHistoryCopy : DeviceHistoryCopy -> String
encodeDeviceHistoryCopy copy =
    Encode.encode 2
        (Encode.object
            [ ( "kind", Encode.string copy.kind )
            , ( "version", Encode.int copy.version )
            , ( "exportedAt", Encode.string copy.exportedAt )
            , ( "reimportable", Encode.bool copy.reimportable )
            , ( "keepPerRoom", Encode.int copy.keepPerRoom )
            , ( "note", Encode.string copy.note )
            , ( "rooms"
              , Encode.list
                    (\room ->
                        Encode.object
                            [ ( "target", Encode.string room.target )
                            , ( "messageCount", Encode.int room.messageCount )
                            , ( "messages", Encode.list encodeDeviceHistoryMessage room.messages )
                            ]
                    )
                    copy.rooms
              )
            ]
        )
        ++ "\n"


historyCopySourceDecoder : Decode.Decoder HistoryCopySource
historyCopySourceDecoder =
    Decode.map5 HistoryCopySource
        (Decode.field "id" Decode.string)
        (Decode.field "at" Decode.float)
        (Decode.field "from" Decode.string)
        (Decode.oneOf [ Decode.field "kind" Decode.string, Decode.succeed "msg" ])
        (Decode.field "body" Decode.string)


decodeHistoryCopyTargets : String -> Result Decode.Error (List { target : String, rows : List HistoryCopySource })
decodeHistoryCopyTargets json =
    Decode.decodeString
        (Decode.list
            (Decode.map2 (\target rows -> { target = target, rows = rows })
                (Decode.field "target" Decode.string)
                (Decode.field "rows" (Decode.list historyCopySourceDecoder))
            )
        )
        json


{-| The account record builds synchronously from live state (nick,
account, owned rooms; Elm tracks no stored email or registered stamp,
so those stay absent) and downloads through the JSON port.
-}
requestAccountRecordDownload : Model -> ( Model, List Outbound )
requestAccountRecordDownload model =
    if model.accountVerbsBusy /= Nothing then
        ( model, [] )

    else
        let
            record =
                buildAccountStoreRecord
                    { nick = Just model.ourNick
                    , account = model.accountName
                    , email = Nothing
                    , registeredAt = Nothing
                    , rooms = Dict.values model.channels
                    , exportedAt = millisToIso model.nowMs
                    }

            json =
                encodeAccountStoreRecord record
        in
        ( { model | accountVerbsStatus = "Downloaded the account record." }
        , [ AccountDownload { filename = accountStoreRecordFilename record, json = json } ]
        )


{-| Device history needs the vault dump, which lives ports-side: arm
the single-flight busy flag and ask for the rows. The seq guards a
stale answer like the oracle epoch.
-}
requestDeviceHistoryCopy : Model -> ( Model, List Outbound )
requestDeviceHistoryCopy model =
    if model.accountVerbsBusy /= Nothing then
        ( model, [] )

    else
        let
            seq =
                model.accountVerbsSeq + 1
        in
        ( { model | accountVerbsBusy = Just AccountHistoryBusy, accountVerbsSeq = seq }
        , [ DeviceHistoryCopyRequest { seq = seq } ]
        )


{-| Fold the ports-side vault rows into the history copy and download
it. A stale seq or undecodable rows report the verbatim failure and
disarm; the busy flag belongs to the matching request only.
-}
receiveDeviceHistoryRows : Model -> { seq : Int, exportedAt : String, json : String } -> ( Model, List Outbound )
receiveDeviceHistoryRows model answer =
    case model.accountVerbsBusy of
        Just AccountHistoryBusy ->
            if answer.seq /= model.accountVerbsSeq then
                ( model, [] )

            else
                case decodeHistoryCopyTargets answer.json of
                    Err _ ->
                        ( { model
                            | accountVerbsBusy = Nothing
                            , accountVerbsStatus = "Could not save this device's history."
                          }
                        , []
                        )

                    Ok targets ->
                        let
                            copy =
                                buildDeviceHistoryCopy answer.exportedAt keepMessages targets
                        in
                        ( { model
                            | accountVerbsBusy = Nothing
                            , accountVerbsStatus = "Saved this device's history."
                          }
                        , [ AccountDownload
                                { filename = deviceHistoryCopyFilename copy
                                , json = encodeDeviceHistoryCopy copy
                                }
                          ]
                        )

        _ ->
            ( model, [] )


refreshChannelList : Model -> ( Model, List Outbound )
refreshChannelList model =
    if model.connection /= Live then
        ( { model | channelListLoading = False }, [] )

    else if model.channelListLoading || model.channelListQuarantined then
        ( model, [] )

    else
        ( { model
            | channelListLoading = True
            , channelListRequest = Just []
            , channelListGen = model.channelListGen + 1
            , channelListDueMs = model.nowMs + channelListTimeoutMs
          }
        , [ SendLine (Wire.formatIrcLine "LIST" []) ]
        )


{-| RPL_LISTSTART: drop partial rows from the in-flight request,
mirroring the oracle clearing `_listPending.rows`/`seen`. Only an
in-flight, unquarantined collection resets — a stray 321 never
creates one, and the committed directory is untouched. -}
foldListStart : Model -> Model
foldListStart model =
    if not model.channelListLoading || model.channelListQuarantined then
        model

    else
        case model.channelListRequest of
            Nothing ->
                model

            Just _ ->
                { model | channelListRequest = Just [] }


foldListRow : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldListRow model message =
    if not model.channelListLoading || model.channelListQuarantined then
        ( model, [] )

    else
        case parseChannelListRow message.params of
            Nothing ->
                ( model, [] )

            Just row ->
                case model.channelListRequest of
                    Nothing ->
                        ( model, [] )

                    Just pending ->
                        let
                            merged =
                                mergeChannelListRow pending row
                        in
                        ( { model | channelListRequest = Just merged, channelList = merged }, [] )


foldListEnd : Model -> ( Model, List Outbound )
foldListEnd model =
    if model.channelListQuarantined then
        ( { model | channelListQuarantined = False }, [] )

    else if not model.channelListLoading then
        ( model, [] )

    else
        let
            committed =
                Maybe.withDefault model.channelList model.channelListRequest
        in
        ( { model
            | channelList = committed
            , channelListCommitted = committed
            , channelListLoading = False
            , channelListRequest = Nothing
            , channelListGen = model.channelListGen + 1
          }
        , []
        )


fireChannelListTimeout : Float -> Model -> Model
fireChannelListTimeout nowMs model =
    if not model.channelListLoading || model.channelListQuarantined then
        model

    else if nowMs < model.channelListDueMs then
        model

    else
        { model
            | channelList = model.channelListCommitted
            , channelListLoading = False
            , channelListRequest = Nothing
            , channelListGen = model.channelListGen + 1
            , channelListQuarantined = True
        }


resetChannelListTransport : Model -> Model
resetChannelListTransport model =
    { model
        | channelListGen = model.channelListGen + 1
        , channelListDueMs = 0
        , channelListQuarantined = False
    }


{-| Browse-directory presentation helpers, mirroring the pure half of
`ChannelBrowser.tsx` + `createRoomFormation.ts` (`isSoftLaunchRoom`,
`visibleBrowseRooms`, `browseMemberLabel`, the sort switch, and the
status line). One-member rooms are soft-launched: hidden from the
default hall (`SOFT_LAUNCH_MEMBER_MAX = 1`), marked `Just started`
when search finds them.

Name ordering reuses `Modes.compareNicks` (the same deterministic
case-folded codepoint order as the roster locale-sort slice —
`String.localeCompare` collation is undefinable in Elm). The status
copy is verbatim, curly quotes included. The join machine
(pending/uncertain/rejected + 8s timer) is `enterBrowserRoom`; the
sheet is `View.Browser` and room formation is `View.Formation`.
-}
softLaunchMemberMax : Int
softLaunchMemberMax =
    1


isSoftLaunchRoom : ChannelListEntry -> Bool
isSoftLaunchRoom row =
    row.count <= softLaunchMemberMax


type BrowseSort
    = SortLive
    | SortName


sortBrowseRooms : BrowseSort -> List ChannelListEntry -> List ChannelListEntry
sortBrowseRooms sort rows =
    case sort of
        SortName ->
            List.sortWith (\a b -> Modes.compareNicks a.name b.name) rows

        SortLive ->
            List.sortWith
                (\a b ->
                    let
                        softRank row =
                            if isSoftLaunchRoom row then
                                1

                            else
                                0
                    in
                    case compare (softRank a) (softRank b) of
                        EQ ->
                            case compare b.count a.count of
                                EQ ->
                                    Modes.compareNicks a.name b.name

                                counts ->
                                    counts

                        soft ->
                            soft
                )
                rows


visibleBrowseRooms : List ChannelListEntry -> String -> List ChannelListEntry
visibleBrowseRooms rows query =
    let
        q =
            String.toLower (String.trim query)
    in
    if String.isEmpty q then
        List.filter (\row -> not (isSoftLaunchRoom row)) rows

    else
        List.filter
            (\row ->
                String.contains q (String.toLower row.name)
                    || String.contains q (String.toLower row.topic)
            )
            rows


browseMemberLabel : ChannelListEntry -> String
browseMemberLabel row =
    if isSoftLaunchRoom row then
        "Just started"

    else
        String.fromInt row.count ++ (if row.count == 1 then " user" else " users")


type BrowserJoinPhase
    = BrowserJoinIdle
    | BrowserJoinPending
    | BrowserJoinUncertain
    | BrowserJoinRejected


browserJoinTimeoutMs : Float
browserJoinTimeoutMs =
    8000


enterBrowserRoom : Model -> String -> ( Model, List Outbound )
enterBrowserRoom model name =
    let
        target =
            String.toLower name
    in
    if Dict.member target model.channels then
        update (ChannelSelect name) model

    else if model.connection /= Live then
        ( model, [] )

    else if model.browserPendingJoin == Just target && model.browserJoinPhase == BrowserJoinPending then
        ( model, [] )

    else
        let
            cleared =
                clearChannelJoinPrompt model
        in
        ( { cleared
            | browserAttemptedJoin = Just target
            , browserPendingJoin = Just target
            , browserJoinPhase = BrowserJoinPending
            , browserJoinDueMs = cleared.nowMs + browserJoinTimeoutMs
          }
        , [ SendLine (Wire.formatIrcLine "JOIN" [ name ]) ]
        )


settleBrowserJoin : Model -> String -> Model
settleBrowserJoin model channel =
    let
        key =
            String.toLower channel
    in
    if not (Dict.member key model.channels) then
        model

    else if model.browserPendingJoin == Just key then
        { model | browserPendingJoin = Nothing, browserAttemptedJoin = Nothing, browserJoinPhase = BrowserJoinIdle }

    else if model.browserJoinPhase == BrowserJoinUncertain && model.browserAttemptedJoin == Just key then
        { model | browserAttemptedJoin = Nothing, browserJoinPhase = BrowserJoinIdle }

    else
        model


refuseBrowserJoin : Model -> Model
refuseBrowserJoin model =
    let
        target =
            case model.browserPendingJoin of
                Just pending ->
                    Just pending

                Nothing ->
                    if model.browserJoinPhase == BrowserJoinUncertain then
                        model.browserAttemptedJoin

                    else
                        Nothing
    in
    case ( target, model.channelJoinPrompt ) of
        ( Just wanted, Just prompt ) ->
            if String.toLower prompt.channel == wanted && model.browserAttemptedJoin == Just wanted then
                { model | browserPendingJoin = Nothing, browserAttemptedJoin = Just wanted, browserJoinPhase = BrowserJoinRejected }

            else
                model

        _ ->
            model


fireBrowserJoinTimeout : Float -> Model -> Model
fireBrowserJoinTimeout nowMs model =
    case model.browserPendingJoin of
        Nothing ->
            model

        Just _ ->
            if nowMs < model.browserJoinDueMs then
                model

            else
                { model | browserPendingJoin = Nothing, browserJoinPhase = BrowserJoinUncertain }


browserAdmissionMessage : Model -> String
browserAdmissionMessage model =
    case model.browserPendingJoin of
        Just target ->
            if model.browserJoinPhase == BrowserJoinPending then
                "Joining " ++ target ++ "… Waiting for server admission."

            else
                browserAttemptMessage model

        Nothing ->
            browserAttemptMessage model


browserAttemptMessage : Model -> String
browserAttemptMessage model =
    case model.browserAttemptedJoin of
        Nothing ->
            ""

        Just attempted ->
            if model.browserJoinPhase == BrowserJoinUncertain then
                "The server did not confirm joining " ++ attempted ++ ". You are still in this room browser; retry " ++ attempted ++ " when ready."

            else if model.browserJoinPhase == BrowserJoinRejected then
                case model.channelJoinPrompt of
                    Just prompt ->
                        if not (String.isEmpty prompt.error) then
                            "Could not join " ++ attempted ++ ": " ++ prompt.error ++ ". Choose Retry to try again."

                        else
                            "The server rejected joining " ++ attempted ++ ". Choose Retry to try again."

                    Nothing ->
                        "The server rejected joining " ++ attempted ++ ". Choose Retry to try again."

            else
                ""


type alias BrowseStatusInput =
    { createMode : Bool
    , offline : Bool
    , loading : Bool
    , listEmpty : Bool
    , disconnected : Bool
    , shown : Int
    , query : String
    }


browseStatusMessage : BrowseStatusInput -> String
browseStatusMessage input =
    let
        q =
            String.trim input.query
    in
    if input.createMode then
        ""

    else if input.offline then
        "Room discovery is unavailable offline. Reconnect to refresh and join."

    else if input.loading && input.listEmpty then
        "Loading rooms…"

    else if input.shown == 0 then
        if String.isEmpty q then
            "No rooms yet."

        else
            "No rooms match “" ++ q ++ "”."

    else if input.disconnected then
        String.fromInt input.shown
            ++ (if input.shown == 1 then " saved room offline. Reconnect to join." else " saved rooms offline. Reconnect to join.")

    else if not (String.isEmpty q) then
        String.fromInt input.shown
            ++ (if input.shown == 1 then " room matches “" ++ q ++ "”." else " rooms match “" ++ q ++ "”.")

    else
        String.fromInt input.shown
            ++ (if input.shown == 1 then " room you can join." else " rooms you can join.")


type alias ReconnectBanner =
    { title : String
    , detail : String
    , online : Bool
    }


reconnectBanner : Model -> Maybe ReconnectBanner
reconnectBanner model =
    case model.connection of
        Live ->
            if model.backOnlineAt > 0 && model.nowMs - model.backOnlineAt < backOnlineNoticeMs then
                Just { title = "Back online", detail = "", online = True }

            else
                Nothing

        Registering ->
            Just
                { title = "Connecting…"
                , detail = "Opening a secure session to Onyx Server."
                , online = False
                }

        Offline ->
            if model.reconnectDueMs > 0 || model.reconnectIn > 0 then
                Just
                    { title = "Reconnecting…"
                    , detail =
                        if model.reconnectIn > 0 then
                            "Retrying in " ++ String.fromInt model.reconnectIn ++ "s."

                        else
                            "Trying to restore your session."
                    , online = False
                    }

            else
                Just
                    { title = "Disconnected"
                    , detail =
                        if model.autoReconnect then
                            "Connection lost — Onyx will retry automatically."

                        else
                            "Reconnect when you are ready."
                    , online = False
                    }


{-| Manual retry, mirroring the oracle `reconnectNow` behind the
banner's Try-again button: the countdown clears, the attempt budget
resets, stale bursts/roster refresh stamps die with the old socket,
and a fresh `WsConnect` goes out.

Gated to `Offline`: firing while `Live` would drop a healthy session,
and redialing mid-handshake (`Registering`) is refused because
`WsOpened` only registers a fresh socket off `Offline` — a second
open arriving after an optimistic flip would be swallowed and the
handshake would stall. The oracle shows its button through
`connecting` too; Elm narrows the surface to the offline phases.
-}
reconnectNow : Model -> ( Model, List Outbound )
reconnectNow model =
    if model.connection /= Offline then
        ( model, [] )

    else
        case model.endpoint of
            Nothing ->
                ( { model | reconnectAttempts = 0, reconnectIn = 0, reconnectDueMs = 0 }, [] )

            Just url ->
                if String.isEmpty (String.trim url) then
                    ( { model | reconnectAttempts = 0, reconnectIn = 0, reconnectDueMs = 0 }, [] )

                else
                    ( { model
                        | reconnectAttempts = 0
                        , reconnectIn = 0
                        , reconnectDueMs = 0
                        , namesBursts = Dict.empty
                        , lastRosterRefresh = Dict.empty
                      }
                    , [ WsConnect { url = url } ]
                    )


{-| The `Message not delivered` error toast (mirroring
`_failLabeledPending` and the unlabeled messaging-FAIL arm: the
description carries the humanized failure bare, exactly like the
oracle — the `Message not delivered: ` prefix lives only on the
companion service-log line). -}
notDeliveredToast : Model -> String -> Model
notDeliveredToast model description =
    addToast
        { variant = ToastError
        , title = "Message not delivered"
        , description = Just description
        , duration = Nothing
        , groupKey = Nothing
        , undo = Nothing
        }
        model.nowMs
        model


{-| Fail an in-flight labeled send (mirroring `_failLabeledPending`:
the label takes the pending row, drops its optimistic rows, logs
`Message not delivered: <description>`, and raises the matching
error toast. Unknown/absent labels leave the model untouched; the
inbox row still records at the call site either way. -}
failLabeledSend : Model -> Wire.IrcMessage -> (PendingLabeledSend -> String) -> Model
failLabeledSend model message describe =
    case labelOf message of
        Nothing ->
            model

        Just label ->
            case pendingLabelFor model label of
                Nothing ->
                    model

                Just pending ->
                    let
                        removed =
                            updateChannel
                                { model
                                    | pendingLabels = Dict.remove label model.pendingLabels
                                    , uncertainLabels = Dict.remove label model.uncertainLabels
                                    , deliveryUnknownIds = List.foldl Set.remove model.deliveryUnknownIds pending.messageIds
                                }
                                pending.target
                                (\c ->
                                    { c
                                        | messages =
                                            List.filter (\m -> not (List.member m.id pending.messageIds)) c.messages
                                    }
                                )

                        description =
                            describe pending
                    in
                    notDeliveredToast
                        (logService removed (boundSystemEventText ("Message not delivered: " ++ description)))
                        description


{-| Toast the outcome counts of a ports-side outbox flush (mirroring
the oracle drain: one `Admission uncertain` error per uncertain row,
then the admitted/expired summary toasts and the two prune-failure
warnings — singular/plural exactly like the oracle). Toasts append in
oracle order, so the admitted toast lands first. -}
announceFlushOutcome : Model -> { sent : Int, dropped : Int, uncertain : Int, expiredPruneFailed : Int, admittedPruneFailed : Int } -> Model
announceFlushOutcome model counts =
    let
        plain variant title description acc =
            addToast
                { variant = variant
                , title = title
                , description = Just description
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                acc.nowMs
                acc

        uncertainOnce acc =
            plain ToastError
                "Admission uncertain / may have sent"
                "This queued message will not be retried automatically. Review it before taking recovery action."
                acc

        withUncertain =
            List.foldl (\_ acc -> uncertainOnce acc) model (List.range 1 counts.uncertain)

        withAdmitted =
            if counts.sent > 0 then
                plain ToastSuccess
                    (if counts.sent == 1 then
                        "Queued message admitted"

                     else
                        String.fromInt counts.sent ++ " queued messages admitted"
                    )
                    "Admitted to this device connection; recipient delivery confirmation pending."
                    withUncertain

            else
                withUncertain

        withExpired =
            if counts.dropped > 0 then
                plain ToastWarning
                    (if counts.dropped == 1 then
                        "Queued message expired"

                     else
                        String.fromInt counts.dropped ++ " queued messages expired"
                    )
                    "Older than a day — dropped instead of sent."
                    withAdmitted

            else
                withAdmitted

        withExpiredPrune =
            if counts.expiredPruneFailed > 0 then
                plain ToastWarning
                    (if counts.expiredPruneFailed == 1 then
                        "Expired queued message needs cleanup"

                     else
                        String.fromInt counts.expiredPruneFailed ++ " expired queued messages need cleanup"
                    )
                    "These messages were not sent, but could not be removed from device storage yet."
                    withExpired

            else
                withExpired

        withAdmittedPrune =
            if counts.admittedPruneFailed > 0 then
                plain ToastWarning
                    (if counts.admittedPruneFailed == 1 then
                        "Queued message stuck on this device"

                     else
                        String.fromInt counts.admittedPruneFailed ++ " queued messages stuck on this device"
                    )
                    "Admitted to this device connection, but storage prune is pending. Retry from Home if it reappears."
                    withExpiredPrune

            else
                withExpiredPrune
    in
    withAdmittedPrune


{-| Inbox rows for server error numerics (mirroring the oracle error
arms: verbatim text with raw params — empty params interpolate empty,
exactly like the template literals — recorded via `addNotification`,
which bounds and drops empties. 403/404 additionally fail a labeled
send in flight. 464 additionally logs a service notice; 482
additionally marks an in-flight ban fetch failed, gated on `BanLoading`
like the oracle's owned-request check. 464 additionally folds a live
in-session IDENTIFY attempt into `accountActionError` (terminal
`FAIL`/`WARN IDENTIFY` lands through `foldIdentifyReply`). -}
foldErrorNumeric : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldErrorNumeric model message =
    let
        params =
            message.params

        second =
            Maybe.withDefault "" (secondParam params)

        third =
            Maybe.withDefault "" (thirdParam params)

        error text =
            addNotification model { kind = NotifError, text = text, from = Nothing, channel = Nothing, topic = Nothing }
    in
    case message.command of
        "403" ->
            let
                failed =
                    failLabeledSend model
                        message
                        (\pending ->
                            "No such channel: "
                                ++ (if String.isEmpty second then
                                        pending.target

                                    else
                                        second
                                   )
                        )
            in
            ( addNotification failed { kind = NotifError, text = "No such channel: " ++ second, from = Nothing, channel = Nothing, topic = Nothing }, [] )

        "404" ->
            let
                failed =
                    failLabeledSend model
                        message
                        (\pending ->
                            let
                                target =
                                    if String.isEmpty second then
                                        pending.target

                                    else
                                        second
                            in
                            if String.isEmpty third then
                                "Cannot send to " ++ target

                            else
                                third
                        )
            in
            ( addNotification failed { kind = NotifError, text = "Cannot send to " ++ second ++ ": " ++ third, from = Nothing, channel = Nothing, topic = Nothing }, [] )

        "405" ->
            ( error "Too many channels", [] )

        "421" ->
            ( error ("Unknown command: " ++ second), [] )

        "431" ->
            ( error "No nickname given", [] )

        "441" ->
            ( error (second ++ " is not in " ++ third), [] )

        "442" ->
            ( error ("You're not in " ++ second), [] )

        "443" ->
            ( error (second ++ " is already in " ++ third), [] )

        "451" ->
            ( error "You need to register first", [] )

        "461" ->
            ( error ("Missing parameters for " ++ second), [] )

        "464" ->
            let
                text =
                    let
                        trailing =
                            trailingParam params
                    in
                    if String.isEmpty trailing then
                        "Invalid account or password"

                    else
                        trailing

                noticed =
                    logService (error text) ("Account: " ++ text)
            in
            -- A 464 answering a live in-session IDENTIFY folds into
            -- `accountActionError` so the claim prompt can leave
            -- `identifying` without disconnecting; any other 464 only
            -- notifies. Either way the context drops — a later
            -- unrelated 464 must never be misattributed.
            case model.identifyReplyAccount of
                Nothing ->
                    ( noticed, [] )

                Just _ ->
                    ( { noticed
                        | identifyReplyAccount = Nothing
                        , accountActionError = Just { command = "IDENTIFY", code = "464", description = text }
                      }
                    , []
                    )

        "467" ->
            ( error "Room key already set", [] )

        "471" ->
            ( setChannelJoinPrompt (error (second ++ " is full")) second "This room is full", [] )

        "473" ->
            ( setChannelJoinPrompt (error (second ++ " is invite-only")) second "Channel is invite-only", [] )

        "474" ->
            ( setChannelJoinPrompt (error ("You are banned from " ++ second)) second "You are banned from this room", [] )

        "475" ->
            -- No inbox row on either side — the prompt is the surface.
            ( setChannelJoinPrompt model second "Incorrect channel password", [] )

        "476" ->
            ( error ("Bad channel mask: " ++ second), [] )

        "482" ->
            let
                marked =
                    case normalizeBanChannel second of
                        Nothing ->
                            model

                        Just channel ->
                            case Dict.get channel model.banListMeta of
                                Just meta ->
                                    if meta.status == BanLoading then
                                        writeBanListMeta model channel (\prev -> { prev | status = BanError, error = Just "You need moderator permission to view this list." })

                                    else
                                        model

                                Nothing ->
                                    model
            in
            ( addNotification marked { kind = NotifError, text = "You need operator privileges in " ++ second, from = Nothing, channel = Nothing, topic = Nothing }, [] )

        _ ->
            ( logNumeric model message, [] )


trailingParam : List String -> String
trailingParam params =
    Maybe.withDefault "" (List.head (List.reverse params))


{-| Token-acceptance gate, mirroring `_canAcceptSessionToken` minus
the restore-generation path Elm has no equivalent of: writes must
be allowed (no terminal resume failure revoked them) and an
account proof must name the owner. A guest or revoked session
neither persists nor chats token notes. -}
sessionTokenGate : Model -> Bool
sessionTokenGate model =
    model.sessionTokenWritesAllowed && model.accountName /= Nothing


{-| Credential slot for the ports-side store: endpoint plus the
proven account (or current nick before proof). Subset of the
oracle's per-server/nick keying — no remembered-identities or
handoff machinery. -}
credentialSlot : Model -> { server : String, nick : String }
credentialSlot model =
    { server = Maybe.withDefault "" model.endpoint
    , nick =
        String.toLower
            (if model.credentialCanonicalOnly then
                Maybe.withDefault "" model.accountName

             else
                Maybe.withDefault model.ourNick model.accountName
            )
    }


{-| Persist a captured Bearer [REDACTED] ports-side and merge it into the live
holdings (merge, never clobber — mirroring `updateResumeTokens`).
`expiresAt` arrives as unix seconds off the wire; the mesh
deadline is kept as epoch ms like the oracle's client field. -}
storeSessionCredential : Model -> String -> Wire.SessionCredential -> ( Model, List Outbound )
storeSessionCredential model _ _ =
    -- Secret-bearing server records are consumed by the private runtime
    -- before they reach Elm; direct reducer calls remain fail-closed.
    ( model, [] )


{-| Run the once-per-socket post-authentication recovery plan after a
registered socket and account proof. The private runtime performs resume
and token rotation; Elm keeps only the opaque reference and typed status.
A malformed peer can send 001 more than once — never replay on the same
connection.
-}
maybeSendSessionCommands : Model -> ( Model, List Outbound )
maybeSendSessionCommands model =
    if model.sessionCommandsSent then
        ( model, [] )

    else if sessionRecoveryOwnsAutomaticResume model then
        ( { model | sessionCommandsSent = True }, [] )

    else if model.connection /= Live then
        ( model, [] )

    else if model.accountName == Nothing && not model.saslAuthenticated then
        ( model, [] )

    else
        case Session.planSessionReclaim model.sessionTokens { now = model.nowMs, authenticated = True } of
            Session.Attempt attempt ->
                let
                    prepared = { model | sessionCommandsSent = True, sessionReclaim = Just { phase = Restoring, kind = Just attempt.kind, credentialKind = Just attempt.credentialKind, credentialRef = Just attempt.credentialRef, outcome = Session.ResumePending } }
                    ( requested, commandOut ) = startSessionRecovery prepared (Ids.credentialRefToRuntime attempt.credentialRef) (RuntimeDomain.ResumeSession (Ids.credentialRefToRuntime attempt.credentialRef) False)
                in
                ( requested, commandOut ++ [ ReclaimTimerStarted { stage = "confirm" } ] )

            Session.Skip skipped ->
                ( { model
                    | sessionCommandsSent = True
                    , sessionReclaim =
                        case skipped.reason of
                            Session.Expired ->
                                Just { phase = SignInAgain, kind = Nothing, credentialKind = Nothing, credentialRef = Nothing, outcome = Session.ResumeUnknown }

                            _ ->
                                model.sessionReclaim
                  }
                , []
                )


sessionRecoveryOwnsAutomaticResume : Model -> Bool
sessionRecoveryOwnsAutomaticResume model =
    case ( model.sessionRecoveryView, model.sessionRecoveryExpectedAccount, model.runtimeOwnerStamp ) of
        ( Just view, Just intent, Just stamp ) ->
            view.requestId == intent.requestId
                && view.credentialRef == intent.credentialRef
                && intent.networkId == stamp.networkId
                && (stamp.accountId == Nothing || accountOwnerKey stamp.accountId == accountOwnerKey (Just intent.accountId))
                && List.member view.status [ "pending", "transport-admitted", "redirecting", "awaiting-authentication", "blocked", "rejected", "unknown" ]

        _ ->
            False


startSessionRecovery : Model -> String -> RuntimeDomain.Action -> ( Model, List Outbound )
startSessionRecovery model credentialRef action =
    case model.runtimeOwnerStamp of
        Nothing ->
            ( { model | composerError = Just "Session recovery is unavailable until private custody is ready." }, [] )

        Just stamp ->
            case
                ( ( Ids.requestIdFromRuntime ("recoveryRequest" ++ String.padLeft 12 '0' (String.fromInt (model.eventClock + 1)))
                  , Ids.ownerRefFromRuntime stamp.ownerRef
                  )
                , ( Ids.accountGenerationFromInt stamp.accountGeneration
                  , Ids.connectionGenerationFromInt stamp.connectionGeneration
                  )
                )
            of
                ( ( Just requestId, Just ownerRef ), ( Just accountGeneration, Just connectionGeneration ) ) ->
                    let
                        command = { requestId = requestId, ownerRef = ownerRef, accountGeneration = accountGeneration, connectionGeneration = connectionGeneration, action = action }
                    in
                    ( { model
                        | eventClock = model.eventClock + 1
                        , runtimeDomainPending = Just requestId
                        , runtimeDomainPendingAction = Just action
                        , runtimeDomainResult = Nothing
                        , sessionRecoveryView = Just { requestId = Ids.requestIdToRuntime requestId, credentialRef = credentialRef, status = "pending", outcome = Nothing, reason = Nothing, redirectNode = Nothing, hopCount = 0, transferFrom = Nothing }
                        , sessionRecoveryViewOwner = Just stamp
                        , sessionRecoveryExpectedAccount = sessionRecoveryIntentFor stamp (Ids.requestIdToRuntime requestId) credentialRef
                      }
                    , [ RuntimeDomainCommand command ]
                    )

                _ ->
                    ( { model | composerError = Just "Session recovery is unavailable until private custody is ready." }, [] )


sessionRecoveryIntentFor : RuntimeOwnerStamp -> String -> String -> Maybe SessionRecoveryIntent
sessionRecoveryIntentFor stamp requestId credentialRef =
    case stamp.accountId of
        Just accountId ->
            Just
                { networkId = stamp.networkId
                , accountId = accountId
                , requestId = requestId
                , credentialRef = credentialRef
                }

        Nothing ->
            Nothing


{-| Terminal rejection of the in-flight `SESSION RESUME`: retire only the
opaque credential selected by this attempt. Sibling credentials are separate
authority and remain available.
-}
revokeSessionTokens : Model -> ( Model, List Outbound )
revokeSessionTokens model =
    case model.sessionReclaim of
        Just attempt ->
            let
                commands =
                    attempt.credentialRef
                        |> Maybe.map (\credentialRef -> CredentialForgetRequested { credentialRef = credentialRef })
                        |> Maybe.map List.singleton
                        |> Maybe.withDefault []
            in
            ( { model | sessionReclaim = Just { phase = ReclaimFailed, kind = attempt.kind, credentialKind = attempt.credentialKind, credentialRef = Nothing, outcome = Session.ResumeInvalid } }
            , ReclaimTimersCleared :: commands
            )

        Nothing ->
            ( model, [] )


{-| Session failures are applied to an in-flight RESUME only. Other session
commands are held while that attempt is pending because these replies do not
carry a request label. Retryable outcomes preserve the selected credential.
-}
foldSessionReply : Model -> Wire.IrcMessage -> Wire.StandardReply -> ( Model, List Outbound )
foldSessionReply model message reply =
    if message.command /= "FAIL" then
        ( model, [] )

    else
        let
            errText =
                if String.isEmpty (String.trim reply.description) then
                    "SESSION " ++ reply.code

                else
                    reply.description
        in
        -- Recovery outcomes are consumed by the private runtime and arrive as
        -- owner-stamped typed domain events. A raw NOTICE/FAIL without that
        -- request correlation cannot revoke a credential or report success.
        ( logService model (boundSystemEventText errText), [] )


{-| Current-server NOTICE credential envelopes
(`:server NOTICE <nick> :SESSION TOKEN/MTOKEN …`), consumed before
chat handling. Server-source only (empty sender), non-channel
target, never CTCP — a peer PM mentioning SESSION can never plant
a bearer. Parse hits are always consumed (even gate-failed ones
stay silent, like the oracle's `break`). -}
foldSessionTokenNotice : Model -> Wire.IrcMessage -> Maybe ( Model, List Outbound )
foldSessionTokenNotice model message =
    case message.params of
        target :: _ ->
            if not (isTrustedPrivateServerNotice model message) || isChannelName model target then
                Nothing

            else if String.startsWith "\u{0001}" (trailingParam message.params) then
                Nothing

            else
                case Wire.parseSessionTokenNotice message of
                    Just cred ->
                        Just (storeSessionCredential model "token" cred)

                    Nothing ->
                        case Wire.parseSessionMeshTokenNotice message of
                            Just cred ->
                                Just (storeSessionCredential model "mtoken" cred)

                            Nothing ->
                                Nothing

        [] ->
            Nothing


{-| Resume notices are consumed by the private runtime and cannot settle
Elm's request without the correlated owner-stamped recovery projection.
-}
foldSessionResumeNotice : Model -> Wire.IrcMessage -> Maybe ( Model, List Outbound )
foldSessionResumeNotice _ _ =
    -- Resume confirmation is delivered only through the private runtime's
    -- request- and owner-stamped session-recovery projection.
    Nothing


recoveryOutcome : Model -> RuntimeDomain.SessionRecoveryView -> Session.ResumeOutcome
recoveryOutcome model view =
    case view.outcome of
        Just "exact-restored" ->
            Session.ExactRestored

        Just "logical-attached" ->
            Session.LogicalRestored

        Just "legacy-new-attachment" ->
            let
                explicitlyAccepted =
                    case model.runtimeDomainPendingAction of
                        Just (RuntimeDomain.ResumeSession _ True) ->
                            True

                        Just (RuntimeDomain.RetrySession _ True) ->
                            True

                        _ ->
                            False
            in
            if explicitlyAccepted then
                Session.NewLegacyAttachment

            else
                Session.ResumeUnknown

        Just "attachment-in-use" ->
            Session.AttachmentBusy

        Just "missing" ->
            Session.MissingAttachment

        Just "revoked" ->
            Session.ResumeRevoked

        Just "invalid" ->
            Session.ResumeInvalid

        Just "retryable" ->
            Session.ResumeRetryable

        _ ->
            case view.reason of
                Just "busy" ->
                    Session.AttachmentBusy

                Just "credential-unavailable" ->
                    Session.MissingAttachment

                Just "credential-expired" ->
                    Session.MissingAttachment

                Just "backpressure" ->
                    Session.ResumeRetryable

                Just "offline" ->
                    Session.ResumeRetryable

                Just "transport-error" ->
                    Session.ResumeRetryable

                Just "response-timeout" ->
                    Session.ResumeUnknown

                _ ->
                    Session.ResumeUnknown


sessionReclaimAfterRecoveryView : Model -> RuntimeDomain.SessionRecoveryView -> Maybe SessionReclaimNotice
sessionReclaimAfterRecoveryView model view =
    case model.sessionReclaim of
        Just notice ->
            if notice.phase /= Restoring || (Maybe.map Ids.credentialRefToRuntime notice.credentialRef) /= Just view.credentialRef then
                model.sessionReclaim

            else
                let
                    outcome =
                        recoveryOutcome model view
                in
                case view.status of
                    "pending" ->
                        Just { notice | outcome = Session.ResumePending }

                    "transport-admitted" ->
                        Just { notice | outcome = Session.ResumePending }

                    "redirecting" ->
                        Just { notice | outcome = Session.ResumePending }

                    "awaiting-authentication" ->
                        Just { notice | outcome = Session.ResumePending }

                    "accepted" ->
                        if List.member outcome [ Session.ExactRestored, Session.LogicalRestored, Session.NewLegacyAttachment ] then
                            Just { notice | phase = Reclaimed, outcome = outcome }

                        else
                            Just { notice | phase = ReclaimFailed, outcome = Session.ResumeUnknown }

                    "blocked" ->
                        Just { notice | phase = ReclaimFailed, outcome = outcome }

                    "rejected" ->
                        Just { notice | phase = ReclaimFailed, outcome = outcome }

                    "unknown" ->
                        Just { notice | phase = ReclaimFailed, outcome = Session.ResumeUnknown }

                    _ ->
                        model.sessionReclaim

        Nothing ->
            Nothing


recoveryViewSettlesRequest : RuntimeDomain.SessionRecoveryView -> Bool
recoveryViewSettlesRequest view =
    not (List.member view.status [ "pending", "transport-admitted" ])


recoveryViewClearsTimer : RuntimeDomain.SessionRecoveryView -> Bool
recoveryViewClearsTimer view =
    recoveryViewSettlesRequest view


updateResumeFailure : Model -> Session.ResumeOutcome -> ( Model, List Outbound )
updateResumeFailure model outcome =
    case model.sessionReclaim of
        Just notice ->
            if notice.phase == Restoring then
                ( { model | sessionReclaim = Just { notice | phase = ReclaimFailed, outcome = outcome } }, [] )

            else
                ( model, [] )

        Nothing ->
            ( model, [] )


{-| `SESSION LIST` / `DROP` account-roster replies live in the same
server-sourced NOTICE gate as the credential captures (empty sender,
non-channel target, no CTCP) so a peer PM can never rewrite the roster.
Mirrors the `SESSION LIST / DROP` arm of `src/lib/store/store.ts`:
row upsert sorted by index, end-of-list clears pending, DROP success
refreshes via a fresh `SESSION LIST`, free-form `FAIL SESSION` /
`SESSION:` errors surface (200-unit bound) except the end marker.
-}
foldAccountSessionNotice : Model -> Wire.IrcMessage -> Maybe ( Model, List Outbound )
foldAccountSessionNotice model message =
    case message.params of
        target :: _ ->
            if message.nick /= Nothing || isChannelName model target then
                Nothing

            else if String.startsWith "\u{0001}" (trailingParam message.params) then
                Nothing

            else
                foldAccountSessionBody model (trailingParam message.params)

        [] ->
            Nothing


foldAccountSessionBody : Model -> String -> Maybe ( Model, List Outbound )
foldAccountSessionBody model body =
    case Session.parseSessionListLine body of
        Just row ->
            Just
                ( { model
                    | accountSessions =
                        List.sortBy .index
                            (row :: List.filter (\r -> r.index /= row.index) model.accountSessions)
                    , accountSessionsError = Nothing
                  }
                , []
                )

        Nothing ->
            if Session.isSessionListEnd body then
                Just ( { model | accountSessionsPending = False }, [] )

            else
                case Session.parseSessionDropOk body of
                    Just dropped ->
                        Just
                            ( { model
                                | accountSessions = List.filter (\r -> r.index /= dropped) model.accountSessions
                                , accountSessionsPending = False
                                , accountSessionsError = Nothing
                              }
                            , []
                            )

                    Nothing ->
                        if Session.isSessionDropSuccess body then
                            Just
                                ( { model
                                    | accountSessionsPending = False
                                    , accountSessionsError = Nothing
                                  }
                                , []
                                )

                        else if isFailSessionText body || isSessionColonText body then
                            Just
                                ( { model
                                    | accountSessionsPending = False
                                    , accountSessionsError = Just (String.slice 0 200 body)
                                  }
                                , []
                                )

                        else
                            Nothing


{-| `SESSION DROP` target: the row's physical SID when known, else the
legacy 1-based LIST ordinal (`sid=<hex>` / `#<n>`). -}
sessionDropSelector : Maybe Session.AccountSessionRow -> Int -> String
sessionDropSelector maybeRow index =
    case Maybe.andThen .sid maybeRow of
        Just sid ->
            "sid=" ++ sid

        Nothing ->
            "#" ++ String.fromInt index


isFailSessionText : String -> Bool
isFailSessionText body =
    case String.words (String.trim body) of
        fail :: second :: _ ->
            String.toUpper fail == "FAIL"
                && String.left 7 (String.toUpper second) == "SESSION"

        _ ->
            False


isSessionColonText : String -> Bool
isSessionColonText body =
    let
        upper =
            String.toUpper (String.trim body)
    in
    if String.left 8 upper /= "SESSION:" then
        False

    else
        case String.uncons (String.dropLeft 8 upper) of
            Just ( c, _ ) ->
                -- Wire `\s` class (space, tab, CR, LF, VT, FF).
                c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == Char.fromCode 11 || c == Char.fromCode 12

            Nothing ->
                False


isRegisteredNickText : String -> Bool
isRegisteredNickText trailing =
    String.contains "nickname is registered; authenticate" (String.toLower trailing)


{-| Roster-sized ceiling for legacy WHO-away memory, mirroring
`_updateBoundedAwayNicks`: drop the nick's old entry plus invalid
ones, cap at 4096, re-add when away. (Elm sets sort; the oracle keeps
insertion order — observable only at the cap under adversarial
input.)
-}
maxAwayNicks : Int
maxAwayNicks =
    4096


updateBoundedAwayNicks : Set String -> String -> Bool -> Set String
updateBoundedAwayNicks source nick away =
    let
        key =
            String.toLower nick

        cleaned =
            Set.toList source
                |> List.filter (\n -> String.toLower n /= key && validWireToken n 256)
                |> List.take maxAwayNicks
                |> List.map String.toLower
                |> Set.fromList
    in
    if away && Set.size cleaned < maxAwayNicks then
        Set.insert key cleaned

    else
        cleaned


{-| AWAY notice fold: `:nick AWAY [:message]` marks the sender away in
every channel roster holding them; a param-less AWAY clears it.
Mirrors the oracle `AWAY` arm (`away: !!awayMsg` — an empty trailing
param counts as back). Unknown nicks touch nothing.
-}
foldAwayNotice : Model -> Wire.IrcMessage -> Model
foldAwayNotice model message =
    case message.nick of
        Nothing ->
            model

        Just sender ->
            if String.isEmpty sender then
                model

            else
                let
                    away =
                        case message.params of
                            [] ->
                                False

                            text :: _ ->
                                not (String.isEmpty text)

                    userKey =
                        String.toLower sender

                    markMember channel =
                        case Dict.get userKey channel.members of
                            Nothing ->
                                channel

                            Just user ->
                                if user.away == away then
                                    channel

                                else
                                    { channel | members = Dict.insert userKey { user | away = away } channel.members }
                in
                { model | channels = Dict.map (\_ channel -> markMember channel) model.channels }


{-| 005 ISUPPORT fold. A changed `PREFIX` map re-derives every roster
member's mode letters through the visible prefix (mirroring
`remapRosterPrefixModes` in the oracle): letters whose old prefix has
no same-prefix successor drop, the rest translate. Anything else in
the line folds exactly as before.
-}
foldIsupportLine : Model -> Wire.IrcMessage -> Model
foldIsupportLine model message =
    let
        oldSupport =
            model.isupport

        newSupport =
            Isupport.applyIsupportLine oldSupport message.params

        updated =
            { model | isupport = newSupport }
    in
    if newSupport.prefixToMode == oldSupport.prefixToMode then
        updated

    else
        { updated | channels = remapRosterPrefixModes updated.channels oldSupport.modeToPrefix newSupport.prefixToMode }


{-| Re-derive roster mode letters across every channel after ISUPPORT
PREFIX changes: each stored letter keeps its meaning through its old
visible prefix, translating to whichever new letter owns that prefix
— or dropping when no new letter does. Letters the old map never
declared ride through untouched.
-}
remapRosterPrefixModes : Dict String Channel -> Dict Char Char -> Dict Char Char -> Dict String Channel
remapRosterPrefixModes channels oldModeToPrefix newPrefixToMode =
    Dict.map
        (\_ channel ->
            { channel
                | members =
                    Dict.map
                        (\_ user -> { user | modes = remapMemberModes oldModeToPrefix newPrefixToMode user.modes })
                        channel.members
            }
        )
        channels


remapMemberModes : Dict Char Char -> Dict Char Char -> Set Char -> Set Char
remapMemberModes oldModeToPrefix newPrefixToMode modes =
    Set.foldl
        (\mode acc ->
            case Dict.get mode oldModeToPrefix of
                Nothing ->
                    Set.insert mode acc

                Just oldPrefix ->
                    case Dict.get oldPrefix newPrefixToMode of
                        Just nextMode ->
                            Set.insert nextMode acc

                        Nothing ->
                            acc
        )
        Set.empty
        modes


{-| 352 RPL_WHOREPLY away fold: `:server 352 me #chan user host
server nick flags :hop,real`. Only roster members move — unknown
channels and unknown nicks are ignored, exactly like the oracle.
-}
foldWhoReply : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldWhoReply model message =
    case message.params of
        _ :: chan :: _ :: _ :: _ :: nick :: flags :: _ ->
            let
                chanKey =
                    ircCaseKey model chan

                nickKey =
                    ircCaseKey model nick

                isAway =
                    String.startsWith "G" flags
            in
            if not (validWireToken chan 512) || not (isChannelName model chan) then
                ( model, [] )

            else if not (validWireToken nick 256) then
                ( model, [] )

            else
                case Dict.get chanKey model.channels of
                    Nothing ->
                        ( model, [] )

                    Just channel ->
                        case Dict.get nickKey channel.members of
                            Nothing ->
                                ( model, [] )

                            Just member ->
                                ( updateChannel model chan
                                    (\c ->
                                        { c
                                            | members =
                                                Dict.insert nickKey { member | away = isAway } c.members
                                        }
                                    )
                                    |> (\m -> { m | awayNicks = updateBoundedAwayNicks m.awayNicks nick isAway })
                                , []
                                )

        _ ->
            ( model, [] )


foldWallops : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldWallops model message =
    case Spine.foldWallops message of
        Nothing ->
            ( model, [] )

        Just line ->
            ( { model | serviceLog = List.take maxServiceLog (line :: model.serviceLog) }, [] )


{-| One offline-memo aggregate: how many memos arrived while the DM
stayed unopened plus the first row id (mirroring the oracle
`offlineMemo` entry; `order` is the LRU clock Elm uses because
`Dict` keeps no insertion order). -}
type alias OfflineMemoAgg =
    { count : Int
    , firstMsgId : Int
    , order : Int
    }


{-| Bound on memo aggregates (mirroring
`MAX_OFFLINE_MEMO_CONVERSATIONS = MAX_LIVE_DM_CONVERSATIONS`): overflow
forgets the least recently updated aggregate, never the new notice. -}
maxOfflineMemoConversations : Int
maxOfflineMemoConversations =
    256


{-| Per-sender memo cap (mirroring `MAX_OFFLINE_MEMO_COUNT`). -}
maxOfflineMemoCount : Int
maxOfflineMemoCount =
    9999


{-| Inbound message-text bound (mirroring
`MAX_VAULT_MESSAGE_TEXT_LENGTH = 64 KiB` with the trailing lone-high-
surrogate drop). -}


-- Vault target bound (mirrors `MAX_VAULT_TARGET_LENGTH`).
maxVaultTargetLength : Int
maxVaultTargetLength =
    512


-- Vault message-id bound (mirrors `MAX_VAULT_MESSAGE_ID_LENGTH`).
maxVaultMessageIdLength : Int
maxVaultMessageIdLength =
    512


maxVaultMessageTextLength : Int
maxVaultMessageTextLength =
    64 * 1024


{-| Mirror of the oracle `_boundedInboundMessageText`. -}
boundInboundMessageText : String -> String
boundInboundMessageText value =
    let
        sliced =
            String.slice 0 maxVaultMessageTextLength value

        lastCode =
            String.right 1 sliced
                |> String.toList
                |> List.head
                |> Maybe.map Char.toCode
                |> Maybe.withDefault 0
    in
    if lastCode >= 0xD800 && lastCode <= 0xDBFF then
        String.dropRight 1 sliced

    else
        sliced


{-| Split a NOTICE MEMO body (`from <nick> :<text>`) into
sender and text — mirroring the oracle's two regex alternatives
(colon form first, bare form second; either may carry empty text,
but the nick must be non-empty). -}
parseMemoBody : String -> Maybe ( String, String )
parseMemoBody body =
    if not (String.startsWith "from " body) then
        Nothing

    else
        let
            rest =
                String.dropLeft 5 body
        in
        case String.indexes " " rest of
            [] ->
                Nothing

            i :: _ ->
                let
                    nick =
                        String.left i rest

                    after =
                        String.dropLeft (i + 1) rest

                    text =
                        if String.startsWith ":" after then
                            String.dropLeft 1 after

                        else
                            after
                in
                if String.isEmpty nick then
                    Nothing

                else
                    Just ( nick, text )


{-| Offline-memo aggregate for a DM target, or `Nothing` (mirroring
`selectOfflineMemo`). -}
offlineMemoFor : Model -> String -> Maybe { count : Int, firstMsgId : Int }
offlineMemoFor model target =
    Maybe.map
        (\agg -> { count = agg.count, firstMsgId = agg.firstMsgId })
        (Dict.get (String.toLower target) model.offlineMemo)


{-| Drop a memo aggregate (mirroring `clearOfflineMemo`, called when
the DM opens). -}
clearOfflineMemo : Model -> String -> Model
clearOfflineMemo model target =
    { model | offlineMemo = Dict.remove (String.toLower target) model.offlineMemo }


{-| Audit-log entry kind (mirroring the oracle `AuditEntry` type
union). -}
type AuditKind
    = AuditKick
    | AuditBan
    | AuditUnban
    | AuditMode
    | AuditTopic
    | AuditJoin
    | AuditPart
    | AuditNick
    | AuditInvite


{-| One audit-log entry (mirroring `AuditEntry`: newest first,
capped at 500; `id` mints from the entry clock). -}
type alias AuditEntry =
    { id : String
    , at : Int
    , kind : AuditKind
    , actor : String
    , target : Maybe String
    , channel : Maybe String
    , detail : Maybe String
    }


{-| One moderation-log entry (mirroring the oracle row: newest first,
capped at 200; `action` stays open-ended like the oracle —
`BAN`/`UNBAN`/`KICK`/`GRANT +o`/`TAKE -o`/`MODE ±z`). -}
type alias ModerationEntry =
    { at : Int
    , action : String
    , target : String
    , by : String
    , channel : String
    }


{-| Channel-event kind (mirroring `ChannelEventType`). -}
type ChannelEventKind
    = EventJoin
    | EventPart
    | EventQuit
    | EventKick
    | EventMode
    | EventNick


{-| One channel event (mirroring `ChannelEvent`: oldest first per
channel, capped at 500; nick/text bounded like the oracle). -}
type alias ChannelEvent =
    { kind : ChannelEventKind
    , nick : String
    , text : String
    , at : Int
    }


{-| Per-channel event buffer with its insertion clock (Elm `Dict`
keeps no insertion order, so the 256-channel cap evicts by clock —
existing channels keep their original position like the oracle's
plain-object re-set). -}
type alias ChannelEventLog =
    { order : Int
    , events : List ChannelEvent
    }


{-| Audit-log cap (mirroring the oracle `.slice(0, 500)`). -}
maxAuditEntries : Int
maxAuditEntries =
    500


{-| Moderation-log cap (mirroring the oracle `.slice(0, 200)`). -}
maxModerationEntries : Int
maxModerationEntries =
    200


{-| Per-channel event cap (mirroring `MAX_LIVE_CHANNEL_MESSAGES`). -}
maxChannelEventEntries : Int
maxChannelEventEntries =
    500


{-| Channel-event channel cap (mirroring the oracle's 256-room
`slice(-MAX_LIVE_CHANNELS)` window). -}
maxEventChannels : Int
maxEventChannels =
    256


{-| Record an audit entry (mirroring `addAuditEntry`). -}
addAuditEntry : Model -> AuditKind -> String -> Maybe String -> Maybe String -> Maybe String -> Model
addAuditEntry model kind actor target channel detail =
    let
        entry =
            { id = "e" ++ String.fromInt model.entrySeq
            , at = floor model.nowMs
            , kind = kind
            , actor = actor
            , target = target
            , channel = channel
            , detail = detail
            }
    in
    { model
        | auditLog = List.take maxAuditEntries (entry :: model.auditLog)
        , entrySeq = model.entrySeq + 1
    }


{-| Record a moderation entry (mirroring `addModerationEntry`). -}
addModerationEntry : Model -> String -> String -> String -> String -> Model
addModerationEntry model action target by channel =
    let
        entry =
            { at = floor model.nowMs
            , action = action
            , target = target
            , by = by
            , channel = channel
            }
    in
    { model | moderationLog = List.take maxModerationEntries (entry :: model.moderationLog) }


{-| Record a channel event (mirroring `addChannelEvent`: bounded
nick/text, oldest-first buffer, newest channel wins the 256-room
window). -}
addChannelEvent : Model -> String -> ChannelEventKind -> String -> String -> Model
addChannelEvent model channel kind nick text =
    let
        key =
            String.trim (String.toLower channel)
    in
    if String.isEmpty key then
        model

    else
        let
            event =
                { kind = kind
                , nick = boundSystemEventText nick
                , text = boundSystemEventText text
                , at = floor model.nowMs
                }

            order =
                model.eventClock + 1

            prev =
                Dict.get key model.channelEvents

            log =
                { order = Maybe.withDefault order (Maybe.map .order prev)
                , events =
                    takeLast maxChannelEventEntries
                        (Maybe.withDefault [] (Maybe.map .events prev) ++ [ event ])
                }

            inserted =
                Dict.insert key log model.channelEvents

            trimmed =
                if Dict.size inserted > maxEventChannels then
                    case oldestEventChannel inserted of
                        Just oldest ->
                            Dict.remove oldest inserted

                        Nothing ->
                            inserted

                else
                    inserted
        in
        { model | channelEvents = trimmed, eventClock = order }


{-| Least-recently-opened event channel. -}
oldestEventChannel : Dict String ChannelEventLog -> Maybe String
oldestEventChannel logs =
    Dict.foldl
        (\key log found ->
            case found of
                Nothing ->
                    Just ( key, log.order )

                Just ( _, best ) ->
                    if log.order < best then
                        Just ( key, log.order )

                    else
                        found
        )
        Nothing
        logs
        |> Maybe.map Tuple.first


{-| Keep the newest N list items (mirroring `slice(-N)`). -}
takeLast : Int -> List a -> List a
takeLast n items =
    List.reverse (List.take n (List.reverse items))


{-| Drop one channel's events (mirroring `clearChannelEvents`). -}
clearChannelEvents : Model -> String -> Model
clearChannelEvents model channel =
    { model | channelEvents = Dict.remove (String.toLower channel) model.channelEvents }


{-| One ban-list entry (mirroring `BanListEntry`). -}
type alias BanEntry =
    { mask : String
    , setBy : Maybe String
    , setAt : Maybe Int
    }


{-| Ban-list request status (mirroring `BanListRequestStatus`). -}
type BanListStatus
    = BanIdle
    | BanLoading
    | BanReady
    | BanError
    | BanUnavailable


{-| Ban-list fetch metadata (mirroring `BanListMeta`: `generation`
guards send-failure races, `epoch` invalidates fetches across
disconnects). -}
type alias BanListMeta =
    { status : BanListStatus
    , updatedAt : Maybe Int
    , error : Maybe String
    , generation : Int
    , epoch : Int
    }


{-| One channel's ban list with its recency clock (the 32-channel
cap evicts by clock — existing lists refresh on commit like the
oracle's delete-then-set). -}
type alias BanChannelList =
    { order : Int
    , entries : List BanEntry
    }


{-| Idle ban-list metadata. -}
emptyBanListMeta : BanListMeta
emptyBanListMeta =
    { status = BanIdle
    , updatedAt = Nothing
    , error = Nothing
    , generation = 0
    , epoch = 0
    }


{-| Derived ban-list view for the room desk (mirroring
`describeBanListView`: protocol parsing stays in the folds, this only
describes what the UI may show). -}
type BanListView
    = BanViewIdle (List BanEntry)
    | BanViewLoading (List BanEntry)
    | BanViewPopulated (List BanEntry) (Maybe Int)
    | BanViewEmpty (Maybe Int)
    | BanViewError String (List BanEntry)
    | BanViewUnavailable String (List BanEntry)


{-| Notification kinds (mirroring the oracle `Notification['type']`:
mention, dm, follow, system, error). -}
type NotificationType
    = NotifMention
    | NotifDm
    | NotifFollow
    | NotifSystem
    | NotifError


{-| One inbox notification (mirroring the oracle `Notification`:
bounded text, optional wire-validated sender/room/topic, and a
millisecond stamp taken from the model clock at add time). -}
type alias InboxNotification =
    { id : String
    , kind : NotificationType
    , text : String
    , from : Maybe String
    , channel : Maybe String
    , topic : Maybe String
    , atMs : Float
    }


{-| Inbox filter (mirroring the oracle `InboxFilter`: all, needs-you,
other). -}
type InboxFilter
    = InboxAll
    | InboxAttention
    | InboxOther


{-| Cap on retained inbox notifications (mirroring
`MAX_NOTIFICATION_ENTRIES`). -}
maxNotificationEntries : Int
maxNotificationEntries =
    50


{-| Whether an inbox row needs attention (mirroring
`isAttentionNotification`: mentions, DMs, and followed
conversations — system and error rows never badge). -}
isAttentionNotification : InboxNotification -> Bool
isAttentionNotification note =
    note.kind == NotifMention || note.kind == NotifDm || note.kind == NotifFollow


{-| Human context for an inbox row (mirroring `notificationContext`:
`nick in #room`, else nick, else room, else the bare kind). -}
notificationContext : InboxNotification -> String
notificationContext note =
    case ( note.from, note.channel ) of
        ( Just from, Just channel ) ->
            from ++ " in " ++ channel

        ( Just from, Nothing ) ->
            from

        ( Nothing, Just channel ) ->
            channel

        ( Nothing, Nothing ) ->
            notificationKindLabel note.kind


{-| Short display label for a notification kind (mirroring the oracle
`TYPE_LABEL`: Mention, Direct message, Followed conversation, System,
Error). -}
notificationKindLabel : NotificationType -> String
notificationKindLabel kind =
    case kind of
        NotifMention ->
            "Mention"

        NotifDm ->
            "Direct message"

        NotifFollow ->
            "Followed conversation"

        NotifSystem ->
            "System"

        NotifError ->
            "Error"


{-| Glyph for a notification kind (mirroring the oracle `TYPE_GLYPH`). -}
notificationKindGlyph : NotificationType -> String
notificationKindGlyph kind =
    case kind of
        NotifMention ->
            "@"

        NotifDm ->
            "dm"

        NotifFollow ->
            "•"

        NotifSystem ->
            "·"

        NotifError ->
            "!"


{-| Validate an inbox sender/room (mirroring `_normalizeMetadataTarget`
/ `_normalizePropertyTarget`: wire-token shape with the sender/target
vault caps; the `__proto__`-family guard is vacuous for rendered text,
matching the existing `validMetadataTarget` precedent). -}
validInboxEntity : String -> Int -> Maybe String
validInboxEntity value maxLength =
    if validWireToken value maxLength then
        Just value

    else
        Nothing


{-| Normalize an inbox topic (mirroring the oracle topic gate: bounded
text is kept unless it carries C0/DEL control bytes, which drop it to
`Nothing`). -}
normalizeInboxTopic : Maybe String -> Maybe String
normalizeInboxTopic topic =
    case topic of
        Nothing ->
            Nothing

        Just raw ->
            let
                bounded =
                    boundSystemEventText raw

                hasControl =
                    String.any (\c -> Char.toCode c < 32 || Char.toCode c == 127) bounded
            in
            if String.isEmpty bounded || hasControl then
                Nothing

            else
                Just bounded


{-| Add an inbox notification (mirroring `addNotification`: empty text
after bounding stays dropped; sender/room keep their wire form when
valid; the list keeps the newest 50 and the read set prunes to
retained ids). Ids come from a model counter (`notif-<n>`) so folds
stay pure and deterministic. -}
addNotification :
    Model
    -> { kind : NotificationType, text : String, from : Maybe String, channel : Maybe String, topic : Maybe String }
    -> Model
addNotification model input =
    let
        text =
            boundSystemEventText input.text
    in
    if String.isEmpty text then
        model

    else
        let
            note =
                { id = "notif-" ++ String.fromInt model.notifSeq
                , kind = input.kind
                , text = text
                , from = Maybe.andThen (\raw -> validInboxEntity raw 256) input.from
                , channel = Maybe.andThen (\raw -> validInboxEntity raw 512) input.channel
                , topic = normalizeInboxTopic input.topic
                , atMs = model.nowMs
                }

            all =
                model.notifications ++ [ note ]

            kept =
                List.drop (List.length all - maxNotificationEntries) all

            retained =
                List.map .id kept |> Set.fromList
        in
        { model
            | notifications = kept
            , readNotificationIds = Set.filter (\id -> Set.member id retained) model.readNotificationIds
            , notifSeq = model.notifSeq + 1
        }


{-| Dismiss one inbox row (mirroring `dismissNotification`: unknown ids
are a no-op and the read mark leaves with the row). -}
dismissNotification : Model -> String -> Model
dismissNotification model id =
    let
        kept =
            List.filter (\note -> note.id /= id) model.notifications
    in
    if List.length kept == List.length model.notifications then
        model

    else
        { model
            | notifications = kept
            , readNotificationIds = Set.remove id model.readNotificationIds
        }


{-| Mark one inbox row read (mirroring `markNotificationRead`:
already-read or unknown ids are a no-op). -}
markNotificationRead : Model -> String -> Model
markNotificationRead model id =
    if Set.member id model.readNotificationIds || not (List.any (\note -> note.id == id) model.notifications) then
        model

    else
        { model | readNotificationIds = Set.insert id model.readNotificationIds }


{-| Mark every inbox row read (mirroring `markAllNotificationsRead`). -}
markAllNotificationsRead : Model -> Model
markAllNotificationsRead model =
    { model | readNotificationIds = List.map .id model.notifications |> Set.fromList }


{-| Activate an inbox row (mirroring `activateNotification`: navigate
only from the current record — a queued click on a removed row drops;
the row marks read and the inbox closes; a mention/follow target opens
its room, a DM target opens the peer conversation, anything else just
closes. A follow row opens the room and then applies its topic
(`openChannelConversation`); a stale topic falls back to the whole room. -}
activateNotification : Model -> String -> ( Model, List Outbound )
activateNotification model id =
    case List.filter (\note -> note.id == id) model.notifications of
        [] ->
            ( model, [] )

        note :: _ ->
            let
                read =
                    markNotificationRead model id

                marked =
                    { read | showNotificationCenter = False }

                target =
                    if (note.kind == NotifMention || note.kind == NotifFollow) && note.channel /= Nothing then
                        note.channel

                    else if note.kind == NotifDm && note.from /= Nothing then
                        note.from

                    else
                        Nothing
            in
            case target of
                Nothing ->
                    ( marked, [] )

                Just name ->
                    let
                        ( opened, openOuts ) =
                            update (ChannelSelect name) marked

                        ( settled, topicOuts ) =
                            if note.kind == NotifFollow && note.channel /= Nothing then
                                update (ChannelTopicSelect { channel = name, topic = note.topic }) opened

                            else
                                ( opened, [] )
                    in
                    ( settled, openOuts ++ topicOuts )


{-| Attention unread count for the bell badge (mirroring the oracle
`unreadCount`: unread attention rows only). -}
unreadAttentionCount : Model -> Int
unreadAttentionCount model =
    List.filter (\note -> isAttentionNotification note && not (Set.member note.id model.readNotificationIds)) model.notifications
        |> List.length


{-| Fetch the block list when a MODE newly grants moderation (mirroring
the ban panel's connected-and-op fetch effect: the effect refires when
moderator status flips on while viewing the room — a channel grant for
the open room, or a user-mode grant promoting the whole session. An
already-moderating room, a demotion, an offline socket, or a grant for
a background room stays quiet). -}
fetchBansOnOpGrant : Model -> Model -> Wire.IrcMessage -> List Outbound
fetchBansOnOpGrant before after message =
    case ( message.params, after.activeChannel ) of
        ( target :: _, Just open ) ->
            let
                room =
                    if isChannelName after target then
                        target

                    else
                        open
            in
            if String.toLower room /= String.toLower open then
                []

            else if after.connection /= Live then
                []

            else if isChannelOp before room || not (isChannelOp after room) then
                []

            else
                Tuple.second (requestBanList after room)

        _ ->
            []


{-| Whether we may moderate a channel (mirroring `selectIsChannelOp`:
network operators always; otherwise our own status modes must rank at
`o` or above on the shared `statusRank` scale). -}
isChannelOp : Model -> String -> Bool
isChannelOp model channel =
    -- Ranks come from the learned 005 PREFIX order (highest first):
    -- a mode the server never advertised ranks nothing, and a network
    -- without `o` grants no moderator rank. Operator status still
    -- needs the room: an oper outside a joined room gets no desk.
    case Dict.get (String.toLower channel) model.channels of
        Nothing ->
            False

        Just ch ->
            case Dict.get (String.toLower model.ourNick) ch.members of
                Nothing ->
                    False

                Just me ->
                    model.isOper
                        || (case learnedRankIndex model 'o' of
                                Just opIndex ->
                                    List.any
                                        (\mode ->
                                            case learnedRankIndex model mode of
                                                Just index ->
                                                    index <= opIndex

                                                Nothing ->
                                                    False
                                        )
                                        (Set.toList me.modes)

                                Nothing ->
                                    False
                           )


{-| Position of a status mode in the learned PREFIX order (0 = highest). -}
learnedRankIndex : Model -> Char -> Maybe Int
learnedRankIndex model mode =
    List.indexedMap Tuple.pair model.isupport.prefixOrder
        |> List.filter (\( _, candidate ) -> candidate == mode)
        |> List.head
        |> Maybe.map Tuple.first


{-| A pending review-first unban, with the authority it was captured
under (mirroring the oracle's `ModerationReviewAuthority`: the
account, server, and transport behind the review button must still be
current when the lift is confirmed). -}
type alias UnbanReview =
    { channel : String
    , mask : String
    , account : Maybe String
    , endpoint : Maybe String
    }


{-| Stage a review-first unban (mirroring `requestUnban`: gated on a
live connection and moderator status; captures the current authority
and replaces any earlier pending review). -}
requestUnbanReview : Model -> String -> String -> ( Model, List Outbound )
requestUnbanReview model channel mask =
    if model.connection /= Live || not (isChannelOp model channel) then
        ( model, [] )

    else
        ( { model
            | pendingUnban =
                Just
                    { channel = channel
                    , mask = mask
                    , account = model.accountName
                    , endpoint = model.endpoint
                    }
          }
        , []
        )


{-| Confirm a pending unban (mirroring `applyUnban`: the lift sends
`MODE <channel> -b <mask>` only when the connection is still live, we
still moderate the room, and the captured authority still matches —
account switch, server hop, or disconnect drops the review silently). -}
confirmUnbanReview : Model -> ( Model, List Outbound )
confirmUnbanReview model =
    case model.pendingUnban of
        Nothing ->
            ( model, [] )

        Just review ->
            let
                cleared =
                    { model | pendingUnban = Nothing }

                fresh =
                    model.connection == Live
                        && isChannelOp model review.channel
                        && model.accountName == review.account
                        && model.endpoint == review.endpoint
            in
            if fresh then
                ( cleared
                , [ SendLine (Wire.formatIrcLine "MODE" [ review.channel, "-b", review.mask ]) ]
                )

            else
                ( cleared, [] )


{-| Ban-list view for one channel (mirroring `selectBanListView` +
`describeBanListView`). -}
banListViewFor : Model -> String -> BanListView
banListViewFor model channel =
    let
        key =
            String.toLower channel

        entries =
            Maybe.withDefault [] (Maybe.map .entries (Dict.get key model.banList))

        meta =
            Maybe.withDefault emptyBanListMeta (Dict.get key model.banListMeta)

        connected =
            model.connection == Live
    in
    if not connected && meta.status == BanLoading then
        BanViewUnavailable (Maybe.withDefault "Reconnect to refresh the block list." meta.error) entries

    else if meta.status == BanLoading then
        BanViewLoading entries

    else if meta.status == BanError then
        BanViewError (Maybe.withDefault "The block list could not be loaded." meta.error) entries

    else if meta.status == BanUnavailable then
        BanViewUnavailable (Maybe.withDefault "The block list is unavailable." meta.error) entries

    else if meta.status == BanReady && List.isEmpty entries then
        case Dict.get key model.banList of
            Just _ ->
                BanViewEmpty meta.updatedAt

            Nothing ->
                BanViewIdle entries

    else if List.isEmpty entries then
        BanViewIdle entries

    else
        BanViewPopulated entries meta.updatedAt


{-| Cap on ban entries per channel (mirroring
`MAX_BAN_LIST_ENTRIES`). -}
maxBanListEntries : Int
maxBanListEntries =
    512


{-| Cap on channels holding ban lists (mirroring
`MAX_BAN_LIST_CHANNELS`, shared by the live map and the 367
accumulator). -}
maxBanListChannels : Int
maxBanListChannels =
    32


{-| Normalize a ban-list channel (mirroring `_normalizeBanChannel`:
trimmed, `#`/`&`-led, 256 chars, no control/space bytes). -}
normalizeBanChannel : String -> Maybe String
normalizeBanChannel value =
    let
        channel =
            String.trim value
    in
    case String.uncons channel of
        Nothing ->
            Nothing

        Just ( first, _ ) ->
            if String.length channel > 256 || (first /= '#' && first /= '&') || String.any (\c -> c <= ' ' || c == '\u{007F}') channel then
                Nothing

            else
                Just (String.toLower channel)


{-| Largest stamp the wire may carry exactly (mirroring
`Number.isSafeInteger`). -}
maxSafeBanStamp : Float
maxSafeBanStamp =
    9007199254740991


{-| Normalize one ban entry (mirroring `_normalizeBanEntry`: trimmed
512-char mask, optional 128-char setter, safe-integer non-negative
stamp; out-of-range stamps drop while the entry stays, exactly like
the oracle's `undefined` stamp). -}
normalizeBanEntry : String -> Maybe String -> Maybe Int -> Maybe BanEntry
normalizeBanEntry mask setBy setAt =
    let
        trimmed =
            String.slice 0 512 (String.trim mask)
    in
    if String.isEmpty trimmed || String.any (\c -> c <= '\u{001F}' || c == '\u{007F}') trimmed then
        Nothing

    else
        let
            setter =
                case Maybe.map (String.slice 0 128 << String.trim) setBy of
                    Just text ->
                        if String.isEmpty text || String.any (\c -> c <= '\u{001F}' || c == '\u{007F}') text then
                            Nothing

                        else
                            Just text

                    Nothing ->
                        Nothing

            stamp =
                case setAt of
                    Just n ->
                        -- Mirroring `Number.isSafeInteger && >= 0`: past
                        -- 2^53-1 the stamp drops but the entry stays.
                        if n >= 0 && toFloat n <= maxSafeBanStamp then
                            Just n

                        else
                            Nothing

                    Nothing ->
                        Nothing
        in
        Just { mask = trimmed, setBy = setter, setAt = stamp }


{-| Normalize a ban list (mirroring `_normalizeBanList`: first 512
valid entries win). -}
normalizeBanList : List BanEntry -> List BanEntry
normalizeBanList entries =
    List.take maxBanListEntries entries


{-| Merge a metadata patch over the previous entry (mirroring
`_writeBanListMeta`). -}
writeBanListMeta : Model -> String -> (BanListMeta -> BanListMeta) -> Model
writeBanListMeta model key patch =
    let
        prev =
            Maybe.withDefault emptyBanListMeta (Dict.get key model.banListMeta)
    in
    { model | banListMeta = Dict.insert key (patch prev) model.banListMeta }


{-| Commit an authoritative ban list (mirroring `setBanList`:
normalize, refresh recency so bounded eviction drops the least
recently completed list, mark ready when the commit answers this
epoch's loading fetch while connected). -}
setBanList : Model -> String -> List BanEntry -> Model
setBanList model channel bans =
    case normalizeBanChannel channel of
        Nothing ->
            model

        Just key ->
            let
                order =
                    model.banClock + 1

                listed =
                    Dict.insert key { order = order, entries = normalizeBanList bans } model.banList

                trimmed =
                    if Dict.size listed > maxBanListChannels then
                        case oldestBanChannel listed of
                            Just oldest ->
                                Dict.remove oldest listed

                            Nothing ->
                                listed

                    else
                        listed

                withList =
                    { model | banList = trimmed, banClock = order }

                prev =
                    Maybe.withDefault emptyBanListMeta (Dict.get key model.banListMeta)

                ready =
                    prev.status == BanLoading && prev.epoch == model.banEpoch && model.connection == Live
            in
            if ready then
                writeBanListMeta withList
                    key
                    (\m -> { m | status = BanReady, updatedAt = Just (floor model.nowMs), error = Nothing })

            else
                withList


{-| Apply a live `+b`/`-b` to the stored ban list (mirroring the
oracle MODE arm: the mask normalizes with the actor as setter and
now as stamp — an un-normalizable mask changes nothing, even for
removals — adds replace same-mask entries, removals filter, and the
32-channel window evicts the least recently completed list). -}
applyLiveBan : Model -> String -> Bool -> String -> String -> Model
applyLiveBan model channel adding mask setBy =
    case normalizeBanChannel channel of
        Nothing ->
            model

        Just key ->
            case normalizeBanEntry mask (Just setBy) (Just (floor (model.nowMs / 1000))) of
                Nothing ->
                    model

                Just normalized ->
                    let
                        existing =
                            Maybe.withDefault [] (Maybe.map .entries (Dict.get key model.banList))

                        next =
                            if adding then
                                normalizeBanList
                                    (List.filter (\b -> b.mask /= normalized.mask) existing ++ [ normalized ])

                            else
                                List.filter (\b -> b.mask /= normalized.mask) existing

                        order =
                            model.banClock + 1

                        listed =
                            Dict.insert key { order = order, entries = next } model.banList

                        trimmed =
                            if Dict.size listed > maxBanListChannels then
                                case oldestBanChannel listed of
                                    Just oldest ->
                                        Dict.remove oldest listed

                                    Nothing ->
                                        listed

                            else
                                listed
                    in
                    { model | banList = trimmed, banClock = order }


{-| Least-recently-completed ban-list channel. -}
oldestBanChannel : Dict String BanChannelList -> Maybe String
oldestBanChannel lists =
    Dict.foldl
        (\key log found ->
            case found of
                Nothing ->
                    Just ( key, log.order )

                Just ( _, best ) ->
                    if log.order < best then
                        Just ( key, log.order )

                    else
                        found
        )
        Nothing
        lists
        |> Maybe.map Tuple.first


{-| Request a room's ban list (mirroring `fetchBanList`: needs a live
connection and a live room, else the meta reads `unavailable`;
otherwise the fetch goes out as `MODE <room> +b` under a fresh
generation). -}
requestBanList : Model -> String -> ( Model, List Outbound )
requestBanList model channel =
    case normalizeBanChannel channel of
        Nothing ->
            ( model, [] )

        Just key ->
            if model.connection /= Live || not (Dict.member key model.channels) then
                ( writeBanListMeta model
                    key
                    (\m ->
                        { m
                            | status = BanUnavailable
                            , error =
                                Just
                                    (if model.connection == Live then
                                        "Join this room before loading its block list."

                                     else
                                        "Reconnect to refresh the block list."
                                    )
                        }
                    )
                , []
                )

            else
                let
                    generation =
                        (Maybe.withDefault emptyBanListMeta (Dict.get key model.banListMeta)).generation + 1

                    loading =
                        writeBanListMeta model
                            key
                            (\m ->
                                { m
                                    | status = BanLoading
                                    , error = Nothing
                                    , generation = generation
                                    , epoch = model.banEpoch
                                }
                            )
                in
                ( loading, [ SendLine (Wire.formatIrcLine "MODE" [ key, "+b" ]) ] )


{-| Fold a 367 burst row (mirroring `RPL_BANLIST`: live-room gate,
stale-epoch guard, 32-channel / 512-entry buffer caps, entry
normalize). -}
foldBanListRow : Model -> Wire.IrcMessage -> Model
foldBanListRow model message =
    case List.drop 1 message.params of
        channel :: mask :: rest ->
            case normalizeBanChannel channel of
                Nothing ->
                    model

                Just key ->
                    if not (Dict.member key model.channels) then
                        model

                    else
                        let
                            pending =
                                Maybe.withDefault emptyBanListMeta (Dict.get key model.banListMeta)
                        in
                        if pending.status == BanLoading && pending.epoch /= model.banEpoch then
                            model

                        else
                            case Dict.get key model.banBuffer of
                                Just buffer ->
                                    if List.length buffer >= maxBanListEntries then
                                        model

                                    else
                                        case normalizeBanEntry mask (List.head rest) (parseBanStamp (List.head (List.drop 1 rest))) of
                                            Just entry ->
                                                { model | banBuffer = Dict.insert key (buffer ++ [ entry ]) model.banBuffer }

                                            Nothing ->
                                                model

                                Nothing ->
                                    if Dict.size model.banBuffer >= maxBanListChannels then
                                        model

                                    else
                                        case normalizeBanEntry mask (List.head rest) (parseBanStamp (List.head (List.drop 1 rest))) of
                                            Just entry ->
                                                { model | banBuffer = Dict.insert key [ entry ] model.banBuffer }

                                            Nothing ->
                                                model

        _ ->
            model


{-| Parse a 367 setter stamp with `parseInt(text, 10)` semantics:
leading whitespace skipped, one optional sign, then the longest
ASCII-digit run — `0x10` yields 0, `123abc` yields 123, digit-free
text yields nothing. Magnitude gating is the caller's job
(`normalizeBanEntry` applies the safe-integer ceiling).
-}
parseBanStamp : Maybe String -> Maybe Int
parseBanStamp raw =
    case raw of
        Nothing ->
            Nothing

        Just text ->
            let
                trimmed =
                    String.trim text

                ( negative, unsigned ) =
                    case String.uncons trimmed of
                        Just ( '-', rest ) ->
                            ( True, rest )

                        Just ( '+', rest ) ->
                            ( False, rest )

                        _ ->
                            ( False, trimmed )

                digits =
                    takeAsciiDigits unsigned
            in
            if String.isEmpty digits then
                Nothing

            else
                case String.toInt digits of
                    Just n ->
                        Just
                            (if negative then
                                -n

                             else
                                n
                            )

                    Nothing ->
                        Nothing


takeAsciiDigits : String -> String
takeAsciiDigits text =
    text
        |> String.toList
        |> takeWhileDigit
        |> String.fromList


takeWhileDigit : List Char -> List Char
takeWhileDigit chars =
    case chars of
        [] ->
            []

        c :: rest ->
            if c >= '0' && c <= '9' then
                c :: takeWhileDigit rest

            else
                []


{-| Fold a 368 close (mirroring `RPL_ENDOFBANLIST`: stale-epoch loads
drop their buffer, otherwise the buffer commits when the room is
still live). -}
foldEndOfBanList : Model -> Wire.IrcMessage -> Model
foldEndOfBanList model message =
    case List.head (List.drop 1 message.params) of
        Nothing ->
            model

        Just channel ->
            case normalizeBanChannel channel of
                Nothing ->
                    model

                Just key ->
                    let
                        pending =
                            Maybe.withDefault emptyBanListMeta (Dict.get key model.banListMeta)
                    in
                    if pending.status == BanLoading && pending.epoch /= model.banEpoch then
                        { model | banBuffer = Dict.remove key model.banBuffer }

                    else
                        let
                            bans =
                                Maybe.withDefault [] (Dict.get key model.banBuffer)

                            drained =
                                { model | banBuffer = Dict.remove key model.banBuffer }
                        in
                        if not (Dict.member key drained.channels) then
                            drained

                        else
                            setBanList drained channel bans


{-| Send a MODEX named-mode list query (mirroring the query half
of the server `parseCommand`: a bare `MODEX <target>` with no
change tokens — an unparseable target is a usage toast, never a
malformed line). -}
requestModex : Model -> String -> ( Model, List Outbound )
requestModex model raw =
    let
        wanted =
            String.trim raw

        target =
            if String.isEmpty wanted then
                Maybe.withDefault "" model.activeChannel

            else
                wanted
    in
    case Modes.buildModexQuery target of
        Just line ->
            ( { model | composer = "" }, [ SendLine line ] )

        Nothing ->
            ( addToast
                { variant = ToastWarning
                , title = "Named modes"
                , description = Just "Use /modex #room (or /modex #room,nick)."
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                { model | composer = "" }
            , []
            )


{-| The retention policy in force (mirroring `policy()`). -}
currentRetention : Model -> Retention.RetentionPolicy
currentRetention model =
    model.retentionPolicy


{-| Option ids for one retention radio group (mirroring
`VAULT_KEEP_OPTIONS` / `VAULT_AGE_OPTIONS` with the `none` age). -}
retentionOptionIds : String -> List String
retentionOptionIds group =
    if group == "keep" then
        List.map String.fromInt Retention.keepOptions

    else
        "none" :: List.filterMap (\opt -> Maybe.map String.fromFloat opt) Retention.ageOptions


{-| Persist a retention choice (mirroring `applyPolicy` minus the
async prune: sanitize-then-hold locally, write through the storage
bridge, and park the in-flight status — the `RetentionPolicyApplied`
receipt settles it). -}
saveRetentionPolicy : Model -> Retention.RetentionPolicy -> ( Model, List Outbound )
saveRetentionPolicy model next =
    ( { model
        | retentionPolicy = next
        , retentionStatus = Just "Applying local history limit…"
      }
    , [ RetentionPolicySave { json = Encode.encode 0 (Retention.encodePolicy next) } ]
    )


{-| Download this view's local scrollback (mirroring the oracle
`/export` → `buildConversationExport` + `downloadConversationExport`:
`json` only on an exact `json` arg like the oracle's
`args[0] === 'json'`, newest-5000 tail, plaintext preferred, the
oracle toast copy, and the `TranscriptDownload` port in place of the
blob-anchor click). -}
runSlashExport : Model -> String -> ( Model, List Outbound )
runSlashExport model formatArg =
    let
        format =
            if formatArg == "json" then
                "json"

            else
                "txt"
    in
    case model.activeChannel of
        Nothing ->
            ( addToast
                { variant = ToastWarning
                , title = "Export scrollback"
                , description = Just "Open a room, then use /export to download its scrollback."
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                { model | composer = "" }
            , []
            )

        Just target ->
            let
                rows =
                    Maybe.withDefault []
                        (Maybe.map .messages (Dict.get (String.toLower target) model.channels))

                exportedAt =
                    millisToIso model.nowMs

                projectRow row =
                    { id = String.fromInt row.id
                    , time = millisToIso (toFloat row.at)
                    , from = Transcript.scrubExportText Transcript.maxExportSenderLength row.from
                    , type_ = Transcript.scrubExportText Transcript.maxExportTypeLength row.msgType
                    , text = Transcript.scrubExportText Transcript.maxExportTextLength (Maybe.withDefault row.body row.plaintext)
                    , edited = row.edited
                    }

                messages =
                    List.map projectRow (Transcript.chronologicalTail rows)

                doc =
                    { target = Transcript.scrubExportText Transcript.maxExportTargetLength target
                    , messageCount = List.length messages
                    , messages = messages
                    , exportedAt = exportedAt
                    , ourNick = Transcript.scrubExportText Transcript.maxExportSenderLength model.ourNick
                    }

                body =
                    if format == "json" then
                        Encode.encode 2 (Transcript.encodeTranscript doc) ++ "\n"

                    else
                        Transcript.transcriptToText doc

                countLine =
                    String.fromInt doc.messageCount
                        ++ " message"
                        ++ (if doc.messageCount == 1 then
                                ""

                            else
                                "s"
                           )
                        ++ " from this device ("
                        ++ format
                        ++ ")."
            in
            ( addToast
                { variant = ToastInfo
                , title = "Export started"
                , description = Just countLine
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                { model | composer = "" }
            , [ TranscriptDownload
                    { filename = Transcript.transcriptFilename target (String.left 10 exportedAt) format
                    , body = body
                    , mime =
                        if format == "json" then
                            "application/json"

                        else
                            "text/plain"
                    }
              ]
            )


{-| Fold an 826 `RPL_MODEXLIST` row (mirroring `writeModexList`:
params are the requester nick, the `#channel[,nick]` target, and
the space-separated named-mode list — rows accumulate under the
lowercased target until 827 commits them). -}
foldModexList : Model -> Wire.IrcMessage -> Model
foldModexList model message =
    case List.drop 1 message.params of
        target :: rest ->
            case Modes.parseModexTarget target of
                Nothing ->
                    model

                Just _ ->
                    let
                        key =
                            String.toLower target

                        names =
                            Modes.parseModexListRow (String.join " " rest)

                        prior =
                            Maybe.withDefault [] (Dict.get key model.modexPending)
                    in
                    { model | modexPending = Dict.insert key (prior ++ names) model.modexPending }

        [] ->
            model


{-| Fold an 827 `RPL_MODEXEND` close (mirroring `writeModexEnd`:
the pending rows commit as the target's named modes with one
service-log line — a close with no open rows is a silent no-op). -}
foldModexEnd : Model -> Wire.IrcMessage -> Model
foldModexEnd model message =
    case List.head (List.drop 1 message.params) of
        Nothing ->
            model

        Just target ->
            case Modes.parseModexTarget target of
                Nothing ->
                    model

                Just _ ->
                    let
                        key =
                            String.toLower target
                    in
                    case Dict.get key model.modexPending of
                        Nothing ->
                            model

                        Just names ->
                            let
                                notice =
                                    "Named modes for "
                                        ++ target
                                        ++ (if List.isEmpty names then
                                                ": none set"

                                            else
                                                ": " ++ String.join " " names
                                           )

                                logged =
                                    { model
                                        | modexModes = Dict.insert key names model.modexModes
                                        , modexPending = Dict.remove key model.modexPending
                                        , serviceLog = List.take maxServiceLog (notice :: model.serviceLog)
                                    }
                            in
                            logged


{-| Our presence status (mirroring the oracle `userStatus`:
drives the AWAY state on IRC). -}
type UserStatus
    = StatusOnline
    | StatusIdle
    | StatusDnd
    | StatusOffline


{-| LUSERS counts (mirroring the oracle `serverStats`, defaulting
every axis to zero and merging partial updates). -}
type alias ServerStats =
    { users : Int
    , channels : Int
    , servers : Int
    , opers : Int
    }


{-| One in-flight latency probe (mirroring the oracle
`_pingTimestamps` single-flight entry: cookie plus the ms clock when
its PING went out). -}
type alias PingProbe =
    { cookie : String
    , sentAt : Int
    }


{-| Zeroed LUSERS counts (mirroring the oracle `setServerStats`
spread over `{ users: 0, channels: 0, servers: 0, opers: 0 }`). -}
emptyServerStats : ServerStats
emptyServerStats =
    { users = 0, channels = 0, servers = 0, opers = 0 }


{-| Cap on retained latency samples (mirroring the oracle
`latencyHistory.slice(-59)` keep-newest-60). -}
maxLatencyHistory : Int
maxLatencyHistory =
    60


{-| Probe cadence in ms (mirroring the oracle 30s latency timer). -}
latencyProbeIntervalMs : Float
latencyProbeIntervalMs =
    30000


{-| Set our presence status (mirroring `setUserStatus`: the state
always lands; the AWAY line only goes out on a live connection —
`online` clears away, the rest set their message). -}
setUserStatus : Model -> UserStatus -> ( Model, List Outbound )
setUserStatus model status =
    let
        updated =
            { model | userStatus = status }
    in
    if model.connection /= Live then
        ( updated, [] )

    else
        case status of
            StatusOnline ->
                ( updated, [ SendLine (Wire.formatIrcLine "AWAY" []) ] )

            StatusIdle ->
                ( updated, [ SendLine (Wire.formatIrcLine "AWAY" [ "Away" ]) ] )

            StatusDnd ->
                ( updated, [ SendLine (Wire.formatIrcLine "AWAY" [ "Do Not Disturb" ]) ] )

            StatusOffline ->
                -- No true offline without disconnecting: the away
                -- message marks us unavailable instead.
                ( updated, [ SendLine (Wire.formatIrcLine "AWAY" [ "Invisible" ]) ] )


{-| Second param else first else empty (mirroring the oracle
`params[1] ?? params[0] ?? ''` used by PONG cookies and 251 text). -}
secondOrFirst : List String -> String
secondOrFirst params =
    case params of
        _ :: second :: _ ->
            second

        first :: _ ->
            first

        [] ->
            ""


{-| Cookie for the next latency probe (full ms clock; the oracle
uses `performance.now()|0`, a different epoch, so bytes cannot match
— the cookie is opaque and only equality matters). -}
latencyCookie : Int -> String
latencyCookie sentAt =
    "lat-" ++ String.fromInt sentAt


{-| Fire the single-flight latency probe on the 1s Tick (mirroring
`_scheduleLatencyPing`/`_sendLatencyPing`: Live only, one cookie at a
time, 30s cadence; a dead socket clears the stale cookie like
`_stopLatencyPing`, and the first Live tick arms the countdown so the
first probe goes out ~30s after connect). -}
fireLatencyPing : Model -> ( Model, List Outbound )
fireLatencyPing model =
    if model.connection /= Live then
        ( { model | pingPending = Nothing }, [] )

    else if model.lastPingAt <= 0 then
        ( { model | lastPingAt = model.nowMs }, [] )

    else
        case model.pingPending of
            Just _ ->
                ( model, [] )

            Nothing ->
                if model.nowMs - model.lastPingAt >= latencyProbeIntervalMs then
                    let
                        sentAt =
                            round model.nowMs

                        cookie =
                            latencyCookie sentAt
                    in
                    ( { model
                        | pingPending = Just { cookie = cookie, sentAt = sentAt }
                        , lastPingAt = model.nowMs
                      }
                    , [ SendLine (Wire.formatIrcLine "PING" [ cookie ]) ]
                    )

                else
                    ( model, [] )


{-| Resolve a PONG against the in-flight probe (mirroring the PONG
arm: only a Live `lat-` echo of the current cookie samples; anything
else leaves the probe alone). -}
foldLatencyPong : Model -> String -> Model
foldLatencyPong model cookie =
    case model.pingPending of
        Just pending ->
            if model.connection == Live && pending.cookie == cookie then
                let
                    rtt =
                        round model.nowMs - pending.sentAt
                in
                { model
                    | pingPending = Nothing
                    , latencyMs = Just rtt
                    , latencyHistory =
                        List.take maxLatencyHistory
                            (List.drop (List.length model.latencyHistory + 1 - maxLatencyHistory)
                                (model.latencyHistory ++ [ rtt ])
                            )
                }

            else
                model

        Nothing ->
            model


{-| Leading ASCII digit run. -}
takeLeadingDigits : List Char -> List Char
takeLeadingDigits chars =
    case chars of
        c :: rest ->
            if Char.isDigit c then
                c :: takeLeadingDigits rest

            else
                []

        [] ->
            []


{-| Trailing ASCII digit run. -}
takeTrailingDigits : List Char -> List Char
takeTrailingDigits chars =
    List.reverse (takeLeadingDigits (List.reverse chars))


{-| First `<digits><spaces><keyword>` count in the text (mirroring
the oracle `/(\d+)\s+users/`-style first match, case-sensitive, no
word-boundary requirement past the keyword). -}
parseLusersCount : String -> String -> Maybe Int
parseLusersCount keyword text =
    parseLusersAt (String.indexes keyword text) keyword text


parseLusersAt : List Int -> String -> String -> Maybe Int
parseLusersAt indexes keyword text =
    case indexes of
        [] ->
            Nothing

        idx :: rest ->
            let
                rawPrefix =
                    String.left idx text

                prefix =
                    String.trimRight rawPrefix

                digits =
                    takeTrailingDigits (String.toList prefix)

                -- The oracle `(\d+)\s+<keyword>` needs whitespace between
                -- the count and the keyword (but nothing before the count:
                -- `abc07  users` matches 7). The trim is exactly that gap,
                -- so a run survives only when trimming removed at least one
                -- char — a glued run (`100users`) falls through to later
                -- occurrences like the regex engine does.
                boundaryOk =
                    List.isEmpty digits
                        || String.length rawPrefix > String.length prefix
            in
            if not boundaryOk then
                parseLusersAt rest keyword text

            else
                case String.toInt (String.fromList digits) of
                    Just n ->
                        Just n

                    Nothing ->
                        parseLusersAt rest keyword text


{-| Lenient leading integer (mirroring JS `parseInt`: leading
whitespace skipped, optional sign, digit prefix; empty means NaN). -}
parseLenientInt : String -> Maybe Int
parseLenientInt value =
    let
        trimmed =
            String.trimLeft value

        ( sign, rest ) =
            case String.uncons trimmed of
                Just ( '+', tail ) ->
                    ( 1, tail )

                Just ( '-', tail ) ->
                    ( -1, tail )

                _ ->
                    ( 1, trimmed )

        digits =
            String.fromList (takeLeadingDigits (String.toList rest))
    in
    case String.toInt digits of
        Just n ->
            Just (sign * n)

        Nothing ->
            Nothing


{-| LUSERS folds (mirroring 251/252/254: partial merges over zeroed
axes; 251 only writes when something matched). -}
foldLusers : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldLusers model message =
    case message.command of
        "251" ->
            let
                text =
                    secondOrFirst message.params

                stats =
                    model.serverStats

                withUsers =
                    case parseLusersCount "users" text of
                        Just users ->
                            { stats | users = users }

                        Nothing ->
                            stats

                withServers =
                    case parseLusersCount "servers" text of
                        Just servers ->
                            { withUsers | servers = servers }

                        Nothing ->
                            withUsers
            in
            if withServers == stats then
                ( model, [] )

            else
                ( { model | serverStats = withServers }, [] )

        "252" ->
            case parseLenientInt (Maybe.withDefault "0" (secondParam message.params)) of
                Just opers ->
                    ( { model | serverStats = setOpers model.serverStats opers }, [] )

                Nothing ->
                    ( model, [] )

        "254" ->
            case parseLenientInt (Maybe.withDefault "0" (secondParam message.params)) of
                Just channels ->
                    ( { model | serverStats = setChannels model.serverStats channels }, [] )

                Nothing ->
                    ( model, [] )

        _ ->
            ( model, [] )


setOpers : ServerStats -> Int -> ServerStats
setOpers stats opers =
    { stats | opers = opers }


setChannels : ServerStats -> Int -> ServerStats
setChannels stats channels =
    { stats | channels = channels }


{-| Device-memory owner (mirroring `_scheduledMessageOwner`: the exact
endpoint plus the SASL account, falling back to our nick when no
account authenticated — lowercased; custom-status writes are refused
without one, exactly like the oracle's owner gate). -}
type alias DeviceMemoryOwner =
    { serverUrl : String
    , identity : String
    }


{-| One parsed rich-presence activity (mirroring `ParsedActivity`). -}
type alias UserActivity =
    { emoji : String
    , typeLabel : String
    , text : String
    }


{-| Maximum custom-status length (mirroring
`MAX_CUSTOM_STATUS_LENGTH`). -}
maxCustomStatusLength : Int
maxCustomStatusLength =
    256


{-| Validate a custom-status draft (mirroring `normalizeCustomStatus`:
trim, reject overlong or control-character text — `[\x00-\x1f\x7f]`.
The empty string stays valid: clearing the status is a real write). -}
normalizeCustomStatus : String -> Maybe String
normalizeCustomStatus value =
    let
        text =
            String.trim value
    in
    if String.length text > maxCustomStatusLength then
        Nothing

    else if String.any (\c -> let code = Char.toCode c in code < 0x20 || code == 0x7F) text then
        Nothing

    else
        Just text


{-| Validate a custom-status expiry epoch (mirroring
`normalizeCustomStatusExpiry`: null clears, a finite date lands — the
ports bridge parses ISO with `Date.parse`, so Elm only fails closed
on negative epochs, which no real date produces). -}
normalizeCustomStatusExpiry : Maybe Float -> Maybe Float
normalizeCustomStatusExpiry value =
    case value of
        Nothing ->
            Nothing

        Just ms ->
            if ms >= 0 then
                Just ms

            else
                Nothing


{-| Resolve the device-memory owner for this model (`Nothing` mirrors
the oracle refusing ownerless writes). -}
deviceMemoryOwner : Model -> Maybe DeviceMemoryOwner
deviceMemoryOwner model =
    let
        serverUrl =
            String.trim (Maybe.withDefault "" model.endpoint)

        -- An account owns its memory by name. A guest nick proves
        -- nothing (anyone can take a released guest nick), so guest
        -- memory is keyed by the physical runtime owner plus the nick:
        -- a reused nick on another owner never inherits topic-read,
        -- aliases, or contacts, and no owner stamp means no guest
        -- memory at all (fail closed).
        identity =
            case model.accountName of
                Just account ->
                    String.toLower (String.trim account)

                Nothing ->
                    case model.runtimeOwnerStamp of
                        Just stamp ->
                            if String.isEmpty (String.trim model.ourNick) || String.isEmpty (String.trim stamp.ownerRef) then
                                ""

                            else
                                "guest:" ++ String.trim stamp.ownerRef ++ ":" ++ String.toLower (String.trim model.ourNick)

                        Nothing ->
                            ""
    in
    if String.isEmpty serverUrl || String.isEmpty identity then
        Nothing

    else
        Just { serverUrl = serverUrl, identity = identity }


emojiActivities : List ( String, String )
emojiActivities =
    [ ( "🎮", "PLAYING A GAME" )
    , ( "💻", "CODING" )
    , ( "🎵", "LISTENING TO MUSIC" )
    , ( "📺", "WATCHING" )
    , ( "🔴", "LIVE ON STREAM" )
    , ( "📚", "STUDYING" )
    ]


{-| Compile a case-insensitive keyword pattern once (mirroring the
oracle's `/…/i` arms; a pattern that never compiles matches
nothing — fail closed). -}
keywordRegex : String -> Regex.Regex
keywordRegex pattern =
    Regex.fromStringWith { caseInsensitive = True, multiline = False } pattern
        |> Maybe.withDefault Regex.never


{-| First anchored match's capture groups for one keyword arm. -}
keywordGroups : Regex.Regex -> String -> Maybe (List (Maybe String))
keywordGroups regex status =
    case Regex.find regex status of
        first :: _ ->
            if first.index == 0 then
                Just first.submatches

            else
                Nothing

        [] ->
            Nothing


{-| Keyword arms in oracle order (mirroring `KEYWORD_PATTERNS`
exactly, including the `song by artist` em-dash join winning over the
plain listening arm). -}
keywordActivity : String -> Maybe UserActivity
keywordActivity status =
    let
        playing =
            keywordGroups (keywordRegex "^playing\\s+(.+)") status

        listeningBy =
            keywordGroups (keywordRegex "^listening(?:\\s+to)?\\s+(.+?)\\s+by\\s+(.+)") status

        listening =
            keywordGroups (keywordRegex "^listening(?:\\s+to)?\\s+(.+)") status

        watching =
            keywordGroups (keywordRegex "^watching\\s+(.+)") status

        coding =
            keywordGroups (keywordRegex "^coding(?:\\s+on)?\\s+(.+)") status

        streaming =
            keywordGroups (keywordRegex "^streaming\\s+(.+)") status
    in
    case playing of
        Just (Just text :: _) ->
            Just { emoji = "🎮", typeLabel = "PLAYING A GAME", text = text }

        _ ->
            case listeningBy of
                Just (Just song :: Just artist :: _) ->
                    Just { emoji = "🎵", typeLabel = "LISTENING TO MUSIC", text = song ++ " — " ++ artist }

                _ ->
                    case listening of
                        Just (Just text :: _) ->
                            Just { emoji = "🎵", typeLabel = "LISTENING TO MUSIC", text = text }

                        _ ->
                            case watching of
                                Just (Just text :: _) ->
                                    Just { emoji = "📺", typeLabel = "WATCHING", text = text }

                                _ ->
                                    case coding of
                                        Just (Just text :: _) ->
                                            Just { emoji = "💻", typeLabel = "CODING", text = text }

                                        _ ->
                                            case streaming of
                                                Just (Just text :: _) ->
                                                    Just { emoji = "🔴", typeLabel = "LIVE ON STREAM", text = text }

                                                _ ->
                                                    Nothing


{-| Parse rich-presence activity from a custom-status string (mirroring
`parseActivity`: emoji prefixes first — falling through to keywords
when nothing follows the emoji — then the case-insensitive keyword
arms in oracle order). -}
parseActivity : String -> Maybe UserActivity
parseActivity status =
    if String.isEmpty status then
        Nothing

    else
        let
            emojiHit =
                List.filterMap
                    (\( emoji, typeLabel ) ->
                        if String.startsWith emoji status then
                            let
                                text =
                                    String.trim (String.dropLeft (String.length emoji) status)
                            in
                            if String.isEmpty text then
                                Nothing

                            else
                                Just { emoji = emoji, typeLabel = typeLabel, text = text }

                        else
                            Nothing
                    )
                    emojiActivities
        in
        case emojiHit of
            first :: _ ->
                Just first

            [] ->
                keywordActivity status


{-| One-to-two-word badge truncation (mirroring `activityShort`). -}
activityShort : UserActivity -> String
activityShort activity =
    let
        words =
            String.words activity.text
    in
    String.join " " (List.take 2 words)
        ++ (if List.length words > 2 then
                "…"

            else
                ""
           )


{-| Project our own activity from the current custom status (mirroring
the oracle's local update: a parse hit sets our nick key, a miss
deletes it; `previousNick` drops the stale pre-rename key, mirroring
`_syncOwnCustomStatusActivity`). -}
syncOwnCustomStatusActivity : Model -> Maybe String -> Model
syncOwnCustomStatusActivity model previousNick =
    let
        dropped =
            case previousNick of
                Just old ->
                    Dict.remove (String.toLower old) model.userActivities

                Nothing ->
                    model.userActivities

        keyed =
            if String.isEmpty model.ourNick then
                dropped

            else
                case parseActivity model.customStatus of
                    Just activity ->
                        Dict.insert (String.toLower model.ourNick) activity dropped

                    Nothing ->
                        Dict.remove (String.toLower model.ourNick) dropped
    in
    { model | userActivities = keyed }


{-| Set our custom status (mirroring `setCustomStatus`: invalid text or
a missing device-memory owner is a silent no-op; the write lands in
state, persists owner-keyed, projects our activity immediately, and —
on a live IRCX connection — publishes `PROP * STATUS` plus the
idle-coupled `AWAY` when our presence is idle and the status is
non-empty). -}
setCustomStatus : Model -> String -> ( Model, List Outbound )
setCustomStatus model status =
    case ( normalizeCustomStatus status, deviceMemoryOwner model ) of
        ( Just normalized, Just owner ) ->
            let
                stored =
                    { model | customStatus = normalized }

                synced =
                    syncOwnCustomStatusActivity stored Nothing

                save =
                    IdentityProfileSave
                        { serverUrl = owner.serverUrl
                        , identity = owner.identity
                        , status = normalized
                        , expiryIso =
                            Maybe.map millisToIso synced.customStatusExpiry
                        }

                wire =
                    if model.connection /= Live || not model.isupport.ircx then
                        []

                    else
                        SendLine (Wire.formatIrcLine "PROP" [ "*", "STATUS", normalized ])
                            :: (if String.isEmpty normalized || model.userStatus /= StatusIdle then
                                    []

                                else
                                    [ SendLine (Wire.formatIrcLine "AWAY" [ "Idle — " ++ normalized ]) ]
                               )
            in
            ( synced, save :: wire )

        _ ->
            ( model, [] )


{-| Request the current owner's persisted state when the owner changed
(mirroring the oracle reloading owned identity memory and topic
history on connect, nick change, and auth change; `previous` is the
last requested owner, so a repeated transition never refires). -}
requestIdentityProfile : Maybe DeviceMemoryOwner -> Model -> ( Model, List Outbound )
requestIdentityProfile previous model =
    case deviceMemoryOwner model of
        Nothing ->
            ( model, [] )

        Just owner ->
            let
                ( withProfile, profileOutbound ) =
                    if previous == Just owner then
                        ( model, [] )

                    else
                        ( { model | identityProfileOwner = Just owner }
                        , [ IdentityProfileRequest { serverUrl = owner.serverUrl, identity = owner.identity }
                          , TopicHistoryRequest { serverUrl = owner.serverUrl, identity = owner.identity }
                          ]
                        )

                -- The alias list lives in the same owner namespace and
                -- loads on the same transitions (connect, registration,
                -- account switch), tracked separately so a profile-only
                -- re-request never refires it. The claim-chip dismissal
                -- rides the same owner transition (same namespace, same
                -- staleness rule).
                ( withAliases, aliasOutbound ) =
                    if withProfile.nickAliasesOwner == Just owner then
                        ( withProfile, [] )

                    else
                        ( { withProfile | nickAliasesOwner = Just owner }
                        , [ NickAliasesRequest { serverUrl = owner.serverUrl, identity = owner.identity }
                          , GuestClaimDismissRequest { serverUrl = owner.serverUrl, identity = owner.identity }
                          ]
                        )

                -- The friends and WATCH lists ride the same owner
                -- transition (same namespace, same staleness rule),
                -- mirroring the owned contact loads on 901/account
                -- switch.
                ( withContacts, contactsOutbound ) =
                    if withAliases.contactsOwner == Just owner then
                        ( withAliases, [] )

                    else
                        ( { withAliases | contactsOwner = Just owner }
                        , [ FriendsRequest { serverUrl = owner.serverUrl, identity = owner.identity }
                          , WatchListRequest { serverUrl = owner.serverUrl, identity = owner.identity }
                          ]
                        )

                -- The CTCP reply config rides the same owner
                -- transition (same namespace, same staleness rule),
                -- mirroring the owned `loadCtcpConfig` on
                -- 901/account switch.
                ( withCtcp, ctcpOutbound ) =
                    if withContacts.ctcpOwner == Just owner then
                        ( withContacts, [] )

                    else
                        ( { withContacts | ctcpOwner = Just owner }
                        , [ CtcpConfigRequest { serverUrl = owner.serverUrl, identity = owner.identity } ]
                        )
                -- The private identity journals ride the same owner
                -- transition (same namespace, same staleness rule),
                -- mirroring the owned override loads on
                -- connect/nick/auth change.
                ( withOverrides, overridesOutbound ) =
                    if withCtcp.identityOverridesOwner == Just owner then
                        ( withCtcp, [] )

                    else
                        ( { withCtcp | identityOverridesOwner = Just owner }
                        , [ IdentityOverridesRequest (identityOverridesKeysForOwner owner) ]
                        )
                -- The device-local topic cursors ride the same owner
                -- transition (same namespace, same staleness rule),
                -- mirroring the owned ledger reads on connect, nick
                -- change, and auth change.
                ( withTopics, topicsOutbound ) =
                    if withOverrides.topicReadOwner == Just owner then
                        ( withOverrides, [] )

                    else
                        ( { withOverrides | topicReadOwner = Just owner }
                        , [ TopicReadRequest { serverUrl = owner.serverUrl, identity = owner.identity } ]
                        )
            in
            ( withTopics, profileOutbound ++ aliasOutbound ++ contactsOutbound ++ ctcpOutbound ++ overridesOutbound ++ topicsOutbound )


{-| Set our custom-status expiry (mirroring `setCustomStatusExpiry`:
refused without an owner, or when a non-null expiry fails to
normalize; the write persists owner-keyed). -}
setCustomStatusExpiry : Model -> Maybe Float -> ( Model, List Outbound )
setCustomStatusExpiry model expiry =
    case deviceMemoryOwner model of
        Nothing ->
            ( model, [] )

        Just owner ->
            case ( expiry, normalizeCustomStatusExpiry expiry ) of
                ( Just _, Nothing ) ->
                    ( model, [] )

                _ ->
                    let
                        normalized =
                            normalizeCustomStatusExpiry expiry

                        updated =
                            { model | customStatusExpiry = normalized }
                    in
                    ( updated
                    , [ IdentityProfileSave
                            { serverUrl = owner.serverUrl
                            , identity = owner.identity
                            , status = model.customStatus
                            , expiryIso = Maybe.map millisToIso normalized
                            }
                      ]
                    )


{-| Fold a STATUS/ACTIVITY property row into activities (mirroring the
oracle's 818/live-PROP activity half: user targets only — channel
targets never project — a parse hit sets the lowercased nick key and
a miss clears it). Returns `Nothing` for non-activity rows so the
caller only touches the dict on STATUS/ACTIVITY user rows. -}
propActivity : String -> String -> String -> Maybe ( String, Maybe UserActivity )
propActivity name target value =
    if name /= "STATUS" && name /= "ACTIVITY" then
        Nothing

    else if String.isEmpty target then
        Nothing

    else
        Just ( String.toLower target, parseActivity value )


{-| The server echo of a PROP write (live `PROP` or 818) settles the
matching pending write; the fold above already stored the value. -}
settleEchoedPropWrite : Model -> Wire.IrcMessage -> Model
settleEchoedPropWrite model message =
    let
        offset =
            if message.command == "818" then
                1

            else
                0
    in
    case ( Ircx.paramAt offset message.params, Ircx.paramAt (offset + 1) message.params ) of
        ( Just channel, Just name ) ->
            settlePropWrite model channel (Just name)

        _ ->
            model


{-| Fold one property row — the 818 registry shape (`:server 818 me
target name :value`, value at index 3) and the live PROP shape
(`target name :value`, value at index 2); the trailing colon param
arrives verbatim from the wire parser, exactly like the oracle's
`params[3]`/`params[2]`.

Props and activity apply atomically: the activity projection lands
only when the bounded props update accepts the row, mirroring the
oracle's `if (!userProps) return {}` saturation gate (a valueless row
clears the activity via `parseActivity "" == Nothing`). -}
foldPropRow : Model -> Wire.IrcMessage -> Model
foldPropRow model message =
    let
        row =
            -- The value param is optional on the wire (`?? ''` in the
            -- oracle): only target + name gate the fold.
            case message.command of
                "818" ->
                    case ( Ircx.paramAt 1 message.params, Ircx.paramAt 2 message.params ) of
                        ( Just target, Just name ) ->
                            Just ( target, name, Maybe.withDefault "" (Ircx.paramAt 3 message.params) )

                        _ ->
                            Nothing

                "PROP" ->
                    case ( Ircx.paramAt 0 message.params, Ircx.paramAt 1 message.params ) of
                        ( Just target, Just name ) ->
                            Just ( target, name, Maybe.withDefault "" (Ircx.paramAt 2 message.params) )

                        _ ->
                            Nothing

                _ ->
                    Nothing

        nextProps =
            case message.command of
                "PROP" ->
                    Ircx.foldLivePropLine model.isupport.chantypes model.props message

                _ ->
                    Ircx.foldPropLine model.isupport.chantypes model.props message
    in
    case row of
        Nothing ->
            { model | props = nextProps }

        Just ( target, name, value ) ->
            case Ircx.normalizePropertyTarget (Just target) of
                Nothing ->
                    { model | props = nextProps }

                Just cleanTarget ->
                    if Ircx.isChanTarget model.isupport.chantypes cleanTarget then
                        { model | props = nextProps }

                    else
                        case Ircx.normalizePropertyName (Just name) of
                            Nothing ->
                                { model | props = nextProps }

                            Just cleanName ->
                                case propActivity cleanName cleanTarget (Ircx.boundedPropertyValue value) of
                                    Nothing ->
                                        { model | props = nextProps }

                                    Just ( key, maybeActivity ) ->
                                        -- The acceptance probe must use
                                        -- the same lowercased key as the
                                        -- props fold above.
                                        case Ircx.updateBoundedProperties model.props.userProps key cleanName (Ircx.boundedPropertyValue value) False of
                                            Nothing ->
                                                -- Saturated: the oracle
                                                -- touches neither props
                                                -- nor activities.
                                                model

                                            Just _ ->
                                                { model
                                                    | props = nextProps
                                                    , userActivities =
                                                        case maybeActivity of
                                                            Just activity ->
                                                                Dict.insert key activity model.userActivities

                                                            Nothing ->
                                                                Dict.remove key model.userActivities
                                                }


{-| One pending timed ban (mirroring `TempBanTimer`: the key binds
channel + mask, `retries` counts unban attempts, and the endpoint +
account snapshot binds the fire to the session that set it). -}
type alias TempBan =
    { channel : String
    , mask : String
    , retries : Int
    , endpoint : Maybe String
    , account : Maybe String
    }


{-| Cap on concurrent timed bans (mirroring
`MAX_TEMP_BAN_TIMERS`). -}
maxTempBanTimers : Int
maxTempBanTimers =
    128


{-| Timed-ban minute range (mirroring `MAX_TEMP_BAN_MINUTES` = 7
days; the 1-minute floor is the oracle's `minutes < 1` reject). -}
maxTempBanMinutes : Int
maxTempBanMinutes =
    7 * 24 * 60


{-| Unban retry cap (mirroring `MAX_TEMP_BAN_RETRIES`). -}
maxTempBanRetries : Int
maxTempBanRetries =
    20


{-| Unban retry delay (mirroring `TEMP_BAN_RETRY_MS`). -}
tempBanRetryMs : Int
tempBanRetryMs =
    30000


{-| Timer key for a timed ban (mirroring the oracle
`` `${channel}\\0${mask}` `` join). -}
tempBanKey : String -> String -> String
tempBanKey channel mask =
    channel ++ "\u{0000}" ++ String.toLower mask


{-| Request a timed ban (mirroring `tempBan`: live connection,
normalized channel, exact-trim mask, 1–10080 minutes, 128-timer
budget with same-key replacement; the `+b` goes out immediately
and the unban schedules behind the ports timer). -}
requestTempBan : Model -> String -> String -> Int -> ( Model, List Outbound )
requestTempBan model channel mask minutes =
    case normalizeBanChannel channel of
        Nothing ->
            ( model, [] )

        Just key ->
            let
                trimmed =
                    String.trim mask
            in
            case normalizeBanEntry mask Nothing Nothing of
                Nothing ->
                    ( model, [] )

                Just normalized ->
                    if
                        normalized.mask
                            /= trimmed
                            || model.connection
                            /= Live
                            || minutes
                            < 1
                            || minutes
                            > maxTempBanMinutes
                    then
                        ( model, [] )

                    else
                        let
                            banKey =
                                tempBanKey key normalized.mask
                        in
                        if Dict.size model.tempBans >= maxTempBanTimers && not (Dict.member banKey model.tempBans) then
                            ( model, [] )

                        else
                            ( { model
                                | tempBans =
                                    Dict.insert banKey
                                        { channel = key
                                        , mask = normalized.mask
                                        , retries = 0
                                        , endpoint = model.endpoint
                                        , account = model.accountName
                                        }
                                        model.tempBans
                              }
                            , [ SendLine (Wire.formatIrcLine "MODE" [ key, "+b", normalized.mask ])
                              , TempBanTimerStart { key = banKey, delayMs = minutes * 60 * 1000 }
                              ]
                            )


{-| Apply a ban-add field edit, clearing a stale submit error. -}
touchBanAdd : (BanAddForm -> BanAddForm) -> BanAddForm -> BanAddForm
touchBanAdd edit form =
    let
        edited =
            edit form
    in
    { edited | error = "" }


{-| Resolve the ban-add form to a mask (raw trimmed text, or the
extban builder output validated through `Modes.buildExtBan`). -}
resolveBanAddMask : BanAddForm -> Maybe String
resolveBanAddMask form =
    if form.useExtBan then
        let
            banType =
                case String.uncons form.extType of
                    Just ( t, _ ) ->
                        t

                    Nothing ->
                        'a'
        in
        Modes.buildExtBan form.extNegated banType (String.trim form.extPattern)

    else
        let
            mask =
                String.trim form.mask
        in
        if String.isEmpty mask then
            Nothing

        else
            Just mask


{-| Submit the moderation-desk ban-add form (feeds the timed-ban
core: bad minutes, an unresolvable mask, an unnormalizable entry,
or an offline link all report into the form instead of sending). -}
submitBanAdd : Model -> String -> ( Model, List Outbound )
submitBanAdd model channel =
    let
        form =
            model.banAdd

        fail message =
            ( { model | banAdd = { form | error = message } }, [] )
    in
    case String.toInt (String.trim form.minutes) of
        Nothing ->
            fail ("Enter minutes between 1 and " ++ String.fromInt maxTempBanMinutes ++ ".")

        Just minutes ->
            if minutes < 1 || minutes > maxTempBanMinutes then
                fail ("Enter minutes between 1 and " ++ String.fromInt maxTempBanMinutes ++ ".")

            else if model.connection /= Live then
                fail "You are offline — reconnect to add blocks."

            else
                case resolveBanAddMask form of
                    Nothing ->
                        fail
                            (if form.useExtBan then
                                "That extended ban does not validate — check the type and pattern."

                             else
                                "Enter a ban mask."
                            )

                    Just mask ->
                        case normalizeBanEntry mask Nothing Nothing of
                            Nothing ->
                                fail "Enter a ban mask."

                            Just _ ->
                                let
                                    ( sent, out ) =
                                        requestTempBan model channel mask minutes
                                in
                                ( { sent | banAdd = { blankBanAdd | minutes = form.minutes } }, out )


{-| Fire a timed-ban unban (mirroring the oracle `fire`: an unknown
key drops silently; a moved session or changed account deletes
without retry; a live session sends `-b` and clears; otherwise
retries reschedule until the cap). -}
fireTempBan : Model -> String -> ( Model, List Outbound )
fireTempBan model key =
    case Dict.get key model.tempBans of
        Nothing ->
            ( model, [] )

        Just entry ->
            if model.endpoint /= entry.endpoint || model.accountName /= entry.account then
                ( { model | tempBans = Dict.remove key model.tempBans }, [] )

            else if model.connection == Live then
                ( { model | tempBans = Dict.remove key model.tempBans }
                , [ SendLine (Wire.formatIrcLine "MODE" [ entry.channel, "-b", entry.mask ]) ]
                )

            else if entry.retries >= maxTempBanRetries then
                ( { model | tempBans = Dict.remove key model.tempBans }, [] )

            else
                ( { model
                    | tempBans =
                        Dict.insert key { entry | retries = entry.retries + 1 } model.tempBans
                  }
                , [ TempBanTimerStart { key = key, delayMs = tempBanRetryMs } ]
                )


{-| Drop in-flight ban buffers and invalidate their epochs
(mirroring `_clearBanListTransport` on disconnect / account change;
pending loads settle to `unavailable` like the oracle's disconnect
path). -}
clearBanTransport : Model -> Model
clearBanTransport model =
    let
        settled =
            Dict.map
                (\_ meta ->
                    if meta.status == BanLoading then
                        { meta | status = BanUnavailable, error = Just "Reconnect to refresh the block list." }

                    else
                        meta
                )
                model.banListMeta
    in
    { model | banBuffer = Dict.empty, banListMeta = settled, banEpoch = model.banEpoch + 1 }


{-| Fold one server NOTICE MEMO delivery (mirroring the oracle MEMO arm:
sender validated fail-closed, text bounded, DM row with the highlight
flag, unread/highlights counted unless the DM is open, muted, or the
sender ignored, then the aggregate folds with LRU refresh — and the
aggregate stays aligned with what the user can open, so a saturated
working set that refuses the shell records nothing). -}
foldMemoNotice : Model -> Wire.IrcMessage -> Maybe ( Model, List Outbound )
foldMemoNotice model message =
    case List.head (List.drop 1 message.params) of
        Nothing ->
            Nothing

        Just rawBody ->
            let
                body =
                    if String.startsWith "MEMO " rawBody then
                        String.dropLeft 5 rawBody

                    else
                        ""

                target =
                    List.head message.params |> Maybe.withDefault ""
            in
            case parseMemoBody body of
                Nothing ->
                    Nothing

                Just ( memoFrom, memoText ) ->
                    if message.command /= "NOTICE" || not (isTrustedPrivateServerNotice model message) || String.toLower target /= String.toLower model.ourNick || not (validWireToken memoFrom 256) then
                        Nothing

                    else
                        Just (deliverOfflineMemo model message memoFrom (boundInboundMessageText memoText))


{-| Private server notices that belong to typed runtime control or MEMO
delivery are consumed at the boundary. Only the first-wins 001 server
prefix and an exact self target qualify; peer NOTICE remains ordinary chat.
The Elm fold never treats these records as authority. -}
isPrivateServerControlNotice : Model -> Wire.IrcMessage -> Bool
isPrivateServerControlNotice model message =
    let
        body =
            trailingParam message.params
    in
    isTrustedPrivateServerNotice model message
        && (String.startsWith "SESSION " body
                || String.startsWith "SESSION:" body
                || String.startsWith "MEMO " body
                || String.startsWith "MEMO:" body
           )


isTrustedPrivateServerNotice : Model -> Wire.IrcMessage -> Bool
isTrustedPrivateServerNotice model message =
    case ( model.serverPrefix, message.prefix, message.params ) of
        ( Just trusted, Just source, target :: _ ) ->
            message.command == "NOTICE"
                && message.nick == Nothing
                && source == trusted
                && String.toLower target == String.toLower model.ourNick

        _ ->
            False


deliverOfflineMemo : Model -> Wire.IrcMessage -> String -> String -> ( Model, List Outbound )
deliverOfflineMemo model message memoFrom memoText =
    let
        key =
            String.toLower memoFrom

        ( room, admitted ) =
            case Dict.get key model.channels of
                Just _ ->
                    ( model, True )

                Nothing ->
                    ensureDmShellCapacity model memoFrom
    in
    if not admitted then
        ( room, [] )

    else
        let
            ignored =
                Set.member key room.ignoredUsers

            muted =
                Set.member key room.mutedDMs

            rowId =
                room.messageSeq

            row =
                { id = rowId
                , from = memoFrom
                , body =
                    if ignored then
                        "Message from ignored user"

                    else
                        memoText
                , whisper = False
                , audience = Nothing
                , highlight = True
                , outboxId = Nothing
                , pending = False
                , plaintext = Nothing
                , at = rowTime room message
                , msgid = Nothing
                , reactions = []
                , edited = False
                , deleted = False
                , redacted = False
                , topic = ""
                , msgType = "msg"
                , replyTo = Nothing
                }

            stored =
                updateChannel { room | messageSeq = rowId + 1 } memoFrom
                    (\c -> { c | messages = List.take (messageRetentionFor room memoFrom) (row :: c.messages) })

            counted =
                case stored.activeChannel of
                    Just active ->
                        if String.toLower active == key then
                            updateChannel stored memoFrom (\c -> { c | unread = 0, highlights = 0 })

                        else
                            countMemoRow stored memoFrom key rowId (not ignored && not muted)

                    Nothing ->
                        countMemoRow stored memoFrom key rowId (not ignored && not muted)

            ( aggregated, agg ) =
                trackOfflineMemo counted key rowId

            -- The offline-memo toast mirrors `OfflineMemoToast.tsx`
            -- (`Memo from <nick>` / `<n> memos from <nick>` with the
            -- catch-up description). Divergence note: the oracle
            -- listener reads `detail.from` while the store dispatches
            -- `detail.channel`, so the oracle toast never fires; Elm
            -- wires the dispatched channel (the evident intent) live.
            fromName =
                String.slice 0 64
                    (String.trim
                        (String.filter (\c -> let code = Char.toCode c in code >= 0x20 && code /= 0x7F) memoFrom)
                    )

            toasted =
                if String.isEmpty fromName then
                    aggregated

                else
                    addToast
                        { variant = ToastInfo
                        , title =
                            if agg.count == 1 then
                                "Memo from " ++ fromName

                            else
                                String.fromInt agg.count ++ " memos from " ++ fromName
                        , description = Just "Delivered while you were offline — open the DM to catch up."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        aggregated.nowMs
                        aggregated
        in
        ( toasted
        , [ OfflineMemoNotice { channel = memoFrom, count = agg.count, firstMsgId = agg.firstMsgId } ]
        )


{-| Count one memo row toward unread (mirroring `_addDMMessage`
counting: muted or ignored senders store without counting). -}
countMemoRow : Model -> String -> String -> Int -> Bool -> Model
countMemoRow model target key rowId worthy =
    if not worthy then
        model

    else
        let
            bumped =
                updateChannel model target (\c -> { c | unread = c.unread + 1, highlights = c.highlights + 1 })
        in
        case Dict.get key bumped.firstUnreadId of
            Just _ ->
                bumped

            Nothing ->
                { bumped | firstUnreadId = Dict.insert key rowId bumped.firstUnreadId }


{-| Fold the aggregate: count saturates at 9999, the first row id
sticks, and the LRU clock refreshes so a 257th sender evicts the
least recently updated aggregate. -}
trackOfflineMemo : Model -> String -> Int -> ( Model, OfflineMemoAgg )
trackOfflineMemo model key rowId =
    let
        order =
            model.memoOrder + 1

        prev =
            Dict.get key model.offlineMemo

        agg =
            { count =
                min maxOfflineMemoCount
                    (Maybe.withDefault 0 (Maybe.map .count prev) + 1)
            , firstMsgId = Maybe.withDefault rowId (Maybe.map .firstMsgId prev)
            , order = order
            }

        inserted =
            Dict.insert key agg model.offlineMemo

        trimmed =
            if Dict.size inserted > maxOfflineMemoConversations then
                case oldestMemoKey inserted of
                    Just oldest ->
                        Dict.remove oldest inserted

                    Nothing ->
                        inserted

            else
                inserted
    in
    ( { model | offlineMemo = trimmed, memoOrder = order }, agg )


{-| Least-recently-updated aggregate key. -}
oldestMemoKey : Dict String OfflineMemoAgg -> Maybe String
oldestMemoKey memos =
    Dict.foldl
        (\key agg found ->
            case found of
                Nothing ->
                    Just ( key, agg.order )

                Just ( _, best ) ->
                    if agg.order < best then
                        Just ( key, agg.order )

                    else
                        found
        )
        Nothing
        memos
        |> Maybe.map Tuple.first


foldStandardReply : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldStandardReply model message =
    case Wire.parseStandardReply message of
        Nothing ->
            ( model, [] )

        Just reply ->
            case foldLabeledFail model message reply of
                Just ( consumed, failOut ) ->
                    -- Labeled FAIL (row dropped, failure logged) or
                    -- an unlabeled messaging FAIL notice; anything
                    -- else falls to the normal fold below. A scheduled
                    -- FAIL carries its settle outbounds.
                    ( consumed, failOut )

                Nothing ->
                    if reply.command == "SESSION" then
                        foldSessionReply model message reply

                    else if reply.command == "MEDIA" then
                        -- Preserve source-supported FAIL/WARN MEDIA handling;
                        -- successful presence arrives through the typed EVENT fold.
                        ( { model
                            | media =
                                Media.foldMediaLine model.media
                                    (Set.fromList (Dict.keys model.channels))
                                    model.isupport.chantypes
                                    message
                            , mediaAvailable = runtimeFeatureReady model "onyx/media"
                          }
                        , []
                        )

                    else if String.toUpper reply.command == "E2EEGROUP" then
                        ( foldE2eGroupReply model reply, [] )

                    else if String.toUpper reply.command == "E2EEKEY" then
                        foldDirectoryFailure model message reply

                    else if reply.command == "SEARCH" && reply.kind == Wire.Fail then
                        foldSearchFail model reply

                    else if reply.command == "CHATHISTORY" && reply.kind == Wire.Fail then
                        foldChathistoryFail model reply

                    else if reply.command == "IDENTIFY" && (reply.kind == Wire.Fail || reply.kind == Wire.Warn) then
                        foldIdentifyReply model reply

                    else if (reply.command == "REGISTER" || reply.command == "VERIFY") && reply.kind == Wire.Fail then
                        foldRegisterFail model reply

                    else if reply.command == "TOTP" && reply.kind == Wire.Fail then
                        foldTotpFail model reply

                    else if reply.command == "RECOVERYCODES" && reply.kind == Wire.Fail then
                        foldRecoveryCodesFail model reply

                    else if reply.command == "ACCOUNTINFO" && reply.kind == Wire.Fail then
                        -- Terminal `FAIL ACCOUNTINFO`: the context dies
                        -- with the attempt (mirrors the oracle's
                        -- transport-gated clear); pending clears too so
                        -- the panel cannot spin forever — the oracle
                        -- leaves it set, which strands its own loader.
                        case model.accountInfoReplyAccount of
                            Nothing ->
                                ( model, [] )

                            Just _ ->
                                ( { model
                                    | accountInfoReplyAccount = Nothing
                                    , accountInfoPending = False
                                  }
                                , []
                                )

                    else if reply.command == "PROP" && reply.kind == Wire.Fail then
                        -- A refused PROP write drops its pending desired value;
                        -- the committed props stay as the server last said.
                        case reply.context of
                            channel :: rest ->
                                ( settlePropWrite model channel (List.head rest), [] )

                            [] ->
                                ( { model | pendingPropWrites = Dict.empty }, [] )

                    else if reply.command == "RENAME" && reply.kind == Wire.Fail then
                        -- A failed channel rename surfaces in the inbox
                        -- (mirroring the oracle `FAIL RENAME` notify).
                        ( addNotification model
                            { kind = NotifError
                            , text =
                                if String.isEmpty reply.description then
                                    "RENAME failed (" ++ reply.code ++ ")"

                                else
                                    reply.description
                            , from = Nothing
                            , channel = Nothing
                            , topic = Nothing
                            }
                        , []
                        )

                    else if reply.command == "IDENTITY" && reply.kind == Wire.Fail && reply.code == "STALE_EPOCH" then
                        -- Another device published ahead of our clock:
                        -- one bounded retry with a bumped epoch floor
                        -- (mirroring the oracle `observe` FAIL arm). A
                        -- user-originated line carries a nick and is
                        -- ignored outright, so a hostile user cannot
                        -- drive extra publishes.
                        if message.nick /= Nothing then
                            ( model, [] )

                        else
                            fireAttribution Attribution.foldStaleEpoch model

                    else if
                        (reply.kind == Wire.Fail || reply.kind == Wire.Warn)
                            && List.member reply.command
                                [ "ACCOUNTSET", "LOGOUT", "RECOVER", "DROP", "KEYTRANS", "CERTADD", "CERTLIST", "CERTDEL" ]
                    then
                        -- Generic account-command failure (mirroring the
                        -- oracle `ACCOUNT_COMMANDS` FAIL/WARN arm:
                        -- IDENTIFY/ACCOUNTINFO/SESSION/E2EEKEY have
                        -- dedicated folds above; the rest land here with
                        -- an action error plus an inbox row).
                        let
                            description =
                                if String.isEmpty reply.description then
                                    reply.code

                                else
                                    reply.description

                            text =
                                if String.isEmpty reply.description then
                                    reply.command ++ " failed (" ++ reply.code ++ ")"

                                else
                                    reply.description
                        in
                        ( { model
                            | accountInfoPending = False
                            , accountActionError =
                                Just
                                    { command = reply.command
                                    , code = reply.code
                                    , description = description
                                    }
                          }
                            |> (\cleared ->
                                    addNotification cleared
                                        { kind = NotifError
                                        , text = text
                                        , from = Nothing
                                        , channel = Nothing
                                        , topic = Nothing
                                        }
                               )
                        , []
                        )

                    else if reply.command /= "WEBAUTHN" then
                        ( model, [] )

                    else
                        foldPasskeyReply model reply


{-| Terminal `FAIL`/`WARN IDENTIFY` answer to a live in-session login.
Mirrors the oracle standard-reply arm: a stale reply (no live
context) is ignored outright; the live attempt's verdict folds into
`accountActionError` with an error inbox row, and the context drops so
a later unrelated 464 cannot be misattributed.
-}
foldIdentifyReply : Model -> Wire.StandardReply -> ( Model, List Outbound )
foldIdentifyReply model reply =
    case model.identifyReplyAccount of
        Nothing ->
            ( model, [] )

        Just _ ->
            let
                description =
                    if String.isEmpty reply.description then
                        reply.code

                    else
                        reply.description

                text =
                    if String.isEmpty reply.description then
                        reply.command ++ " failed (" ++ reply.code ++ ")"

                    else
                        reply.description
            in
            ( { model
                | identifyReplyAccount = Nothing
                , accountActionError = Just { command = reply.command, code = reply.code, description = description }
                -- A failed claim IDENTIFY drops back to idle (retryable)
                -- while the verdict stays readable in the sheet,
                -- mirroring the prompt's identifying effect.
                , guestClaimPhase =
                    if model.guestClaimPhase == ClaimIdentifying then
                        ClaimIdle

                    else
                        model.guestClaimPhase
                , guestClaimIdentifyIssued =
                    if model.guestClaimPhase == ClaimIdentifying then
                        False

                    else
                        model.guestClaimIdentifyIssued
              }
                |> (\cleared ->
                        addNotification cleared
                            { kind = NotifError
                            , text = text
                            , from = Nothing
                            , channel = Nothing
                            , topic = Nothing
                            }
                   )
            , []
            )


{-| Resolve a terminal `FAIL SEARCH` (mirroring the store's FAIL
arm: a pending search with matching context errors with the
server's description; a description-less FAIL still errors; with
nothing pending but stale claims, unclaimed stale entries clear —
a batch already open stays quarantined until close). -}
foldSearchFail : Model -> Wire.StandardReply -> ( Model, List Outbound )
foldSearchFail model reply =
    let
        message =
            if String.isEmpty (String.trim reply.description) then
                "Search failed."

            else
                reply.description
    in
    case model.serverSearchPending of
        Just pending ->
            if model.serverSearchStatus == ServerSearchPending && String.toLower model.serverSearchTarget == pending.targetKey && model.serverSearchQuery == pending.query then
                ( { model
                    | serverSearchPending = Nothing
                    , serverSearchStatus = ServerSearchError
                    , serverSearchError = Just message
                    , serverSearchNotice = Nothing
                    , serverSearchResults = []
                  }
                , []
                )

            else
                ( model, [] )

        Nothing ->
            if Dict.isEmpty model.staleServerSearches then
                ( model, [] )

            else
                ( { model | staleServerSearches = clearUnclaimedStale model }, [] )


{-| Drop stale-search claims no open batch still holds (mirroring
the FAIL arm's `openRefs.size === 0` cleanup). -}
clearUnclaimedStale : Model -> Dict String Int
clearUnclaimedStale model =
    let
        heldKeys =
            Dict.foldl
                (\_ collector keys ->
                    case collector.kind of
                        PlainHistory ->
                            keys

                        GenericBatch ->
                            keys

                        LabeledResponse ->
                            keys

                        _ ->
                            Set.insert (String.toLower collector.target) keys
                )
                Set.empty
                model.historyBatches
    in
    Dict.filter (\key _ -> Set.member key heldKeys) model.staleServerSearches


{-| First-wins server-prefix learning for trusted directory dispatch,
mirroring the bridge: a duplicate or forged 001 never retargets it.
-}
learnServerPrefix : Maybe String -> Maybe String -> Maybe String
learnServerPrefix current incoming =
    case current of
        Just _ ->
            current

        Nothing ->
            incoming


{-| First-wins endpoint learning for signer-pin scoping. Empty urls
never clobber a learned endpoint.
-}
learnEndpoint : Maybe String -> String -> Maybe String
learnEndpoint current url =
    case current of
        Just _ ->
            current

        Nothing ->
            if String.isEmpty (String.trim url) then
                Nothing

            else
                Just url


{-| Extract a trusted-server `E2EEKEY` body from a NOTICE. The prefix
must equal the 001-learned server prefix, the target must not be a
channel, and the body must start at `E2EEKEY` — mirroring
`e2eeKeyBodyFromTrustedServer`. Anything else stays on the chat path.
-}
directoryNoticeBody : Model -> Wire.IrcMessage -> Maybe String
directoryNoticeBody model message =
    case model.serverPrefix of
        Nothing ->
            Nothing

        Just trusted ->
            case ( message.prefix, message.params ) of
                ( Just prefix, target :: body :: _ ) ->
                    if prefix /= trusted then
                        Nothing

                    else if String.isEmpty target || String.startsWith "#" target || String.startsWith "&" target then
                        Nothing

                    else if body == "E2EEKEY" || String.startsWith "E2EEKEY " body then
                        Just body

                    else
                        Nothing

                _ ->
                    Nothing


snapshotAccount : GroupDirectory.SnapshotLine -> String
snapshotAccount line =
    case line of
        GroupDirectory.DeviceLine device ->
            device.account

        GroupDirectory.EndLine end ->
            end.account


{-| Run publisher effects into outbound intentions. -}
runPublisherEffects : List GroupPublisher.Effect -> List Outbound
runPublisherEffects effects =
    List.concatMap
        (\fx ->
            case fx of
                GroupPublisher.RequestIdentity ->
                    [ GroupPublisherProject ]

                GroupPublisher.Publish verified ->
                    [ SendLine (GroupPublisher.publishLine verified) ]

                GroupPublisher.ScheduleRetry ->
                    [ GroupPublisherRetryAfter ]
        )
        effects


{-| The attribution session with the owner-scoped server URL synced
from the live endpoint (mirroring the controller's construction
serverUrl; an empty endpoint fails closed in ports, never sends). -}
withAttributionServer : Model -> Attribution.AttributionSession
withAttributionServer model =
    let
        session =
            model.attribution

        serverUrl =
            String.trim (Maybe.withDefault "" model.endpoint)
    in
    if session.serverUrl == serverUrl then
        session

    else
        { session | serverUrl = serverUrl }


{-| Run one attribution step: fold the synced session and lift the
single effect into outbound intentions. -}
fireAttribution : (Attribution.AttributionSession -> ( Attribution.AttributionSession, Attribution.AttributionEffect )) -> Model -> ( Model, List Outbound )
fireAttribution step model =
    let
        ( next, fx ) =
            step (withAttributionServer model)
    in
    ( { model | attribution = next }, runAttributionEffects [ fx ] )


{-| Run attribution effects into outbound intentions. Unsigned
material never leaves Elm except through the ports requests; the
signed `IDENTITY` lines ride the normal `SendLine` path. -}
runAttributionEffects : List Attribution.AttributionEffect -> List Outbound
runAttributionEffects effects =
    List.concatMap
        (\fx ->
            case fx of
                Attribution.NoEffect ->
                    []

                Attribution.RequestEnroll req ->
                    [ AttributionEnrollRequest req ]

                Attribution.RequestResidenceSign req ->
                    [ AttributionResidenceRequest req ]

                Attribution.SendIdentityAdd add ->
                    [ SendLine (Wire.formatIrcLine "IDENTITY" [ "ADD", add.label, add.publicHex, add.sig ]) ]

                Attribution.SendIdentityResidence res ->
                    [ SendLine
                        (Wire.formatIrcLine "IDENTITY"
                            [ "RESIDENCE"
                            , res.nodeHex
                            , String.fromInt (round res.epoch)
                            , String.fromInt (round res.expiryMs)
                            , res.sig
                            ]
                        )
                    ]

                Attribution.ConfirmEnrolled confirm ->
                    [ AttributionConfirmEnrolled confirm ]
        )
        effects


{-| Roster rows as stewardship sees them: nick plus mode letters
(mirroring the oracle `membersOf` snapshot). -}
stewardMembersOf : Model -> String -> List Stewardship.StewardMember
stewardMembersOf model channel =
    case Dict.get (String.toLower channel) model.channels of
        Nothing ->
            []

        Just room ->
            List.map
                (\member ->
                    { nick = member.nick
                    , modes = List.map String.fromChar (Set.toList member.modes)
                    }
                )
                (Dict.values room.members)


{-| Canonical room name for wire lines (the roster's own casing;
the raw argument when we hold no room). -}
stewardRoomName : Model -> String -> String
stewardRoomName model channel =
    case Dict.get (String.toLower channel) model.channels of
        Just room ->
            room.name

        Nothing ->
            channel


{-| The live transfer offer for a room (mirroring `transferFor`). -}
stewardOfferFor : Model -> String -> Maybe Stewardship.RoomTransferOffer
stewardOfferFor model channel =
    Stewardship.transferFor channel model.roomTransfers


{-| One panel's worth of room-care state (mirroring the oracle sheet
memos: live roster, ranks, the pending offer, and who it targets). -}
type alias StewardView =
    { channel : String
    , live : Bool
    , isOwner : Bool
    , owners : List String
    , helpers : List String
    , count : Int
    , offer : Maybe Stewardship.RoomTransferOffer
    , offeredToUs : Bool
    }


stewardViewFor : Model -> String -> StewardView
stewardViewFor model channel =
    let
        members =
            stewardMembersOf model channel

        offer =
            stewardOfferFor model channel
    in
    { channel = stewardRoomName model channel
    , live = model.connection == Live
    , isOwner = Stewardship.actorIsOwner members model.ourNick
    , owners = Stewardship.listOwners members
    , helpers = Stewardship.listCoAdmins members
    , count = Stewardship.memberCount members
    , offer = offer
    , offeredToUs =
        case offer of
            Just current ->
                Stewardship.nickKey current.to == Stewardship.nickKey model.ourNick

            Nothing ->
                False
    }


{-| The connected-owner gate shared by the mutating verbs (mirroring
`ownerMembers`: offline or non-owner refuses with status copy). -}
stewardOwnerMembers : Model -> String -> Result String (List Stewardship.StewardMember)
stewardOwnerMembers model channel =
    if model.connection /= Live then
        Err "Reconnect to change this room."

    else
        let
            members =
                stewardMembersOf model channel
        in
        if Stewardship.actorIsOwner members model.ourNick then
            Ok members

        else
            Err "Only the owner can do that."


{-| Refuse into the panel status line (mirroring the oracle `note`). -}
stewardRefused : Model -> String -> ( Model, List Outbound )
stewardRefused model reason =
    ( { model | stewardStatus = reason }, [] )


{-| Owner adds a co-admin: `MODE +o` (mirroring `addRoomCoAdmin` over
`opMember`). -}
requestStewardAddHelper : Model -> String -> String -> ( Model, List Outbound )
requestStewardAddHelper model channel candidate =
    case stewardOwnerMembers model channel of
        Err reason ->
            stewardRefused model reason

        Ok members ->
            case Stewardship.rejectThirdCoAdmin members model.ourNick candidate of
                Stewardship.StewardRefused reason ->
                    stewardRefused model reason

                Stewardship.StewardOk nick ->
                    ( { model | stewardStatus = "", stewardHelper = "" }
                    , [ SendLine (Wire.formatIrcLine "MODE" [ stewardRoomName model channel, "+o", nick ]) ]
                    )


{-| Owner removes a co-admin: `MODE -o` (mirroring
`removeRoomCoAdmin`). -}
requestStewardRemoveHelper : Model -> String -> String -> ( Model, List Outbound )
requestStewardRemoveHelper model channel nick =
    case stewardOwnerMembers model channel of
        Err reason ->
            stewardRefused model reason

        Ok members ->
            if List.any (\name -> Stewardship.nickKey name == Stewardship.nickKey nick) (Stewardship.listCoAdmins members) then
                ( { model | stewardStatus = "" }
                , [ SendLine (Wire.formatIrcLine "MODE" [ stewardRoomName model channel, "-o", String.trim nick ]) ]
                )

            else
                stewardRefused model "They do not help with this room."


{-| Owner offers the room to a successor: memory-only until accept
(mirroring `offerRoomOwnership`). -}
requestStewardOfferTransfer : Model -> String -> String -> ( Model, List Outbound )
requestStewardOfferTransfer model channel successor =
    case stewardOwnerMembers model channel of
        Err reason ->
            stewardRefused model reason

        Ok members ->
            case
                Stewardship.offerTransfer
                    { current = stewardOfferFor model channel
                    , channel = stewardRoomName model channel
                    , from = model.ourNick
                    , to = successor
                    , members = members
                    }
            of
                Nothing ->
                    stewardRefused model "Pick someone in this room."

                Just offer ->
                    ( { model
                        | roomTransfers = Stewardship.writeTransfer (Just offer) channel model.roomTransfers
                        , stewardStatus = ""
                        , stewardSuccessor = ""
                      }
                    , []
                    )


{-| The named successor accepts: still no wire — the owner still
grants (mirroring `acceptRoomOwnership`). -}
requestStewardAcceptTransfer : Model -> String -> ( Model, List Outbound )
requestStewardAcceptTransfer model channel =
    case
        Stewardship.acceptTransfer
            { current = stewardOfferFor model channel
            , channel = channel
            , acceptor = model.ourNick
            }
    of
        Nothing ->
            stewardRefused model "There is nothing to accept."

        Just offer ->
            ( { model
                | roomTransfers = Stewardship.writeTransfer (Just offer) channel model.roomTransfers
                , stewardStatus = ""
              }
            , []
            )


{-| Either side walks away from the offer (mirroring
`declineRoomOwnership`: always ok). -}
requestStewardDeclineTransfer : Model -> String -> ( Model, List Outbound )
requestStewardDeclineTransfer model channel =
    ( { model
        | roomTransfers =
            Stewardship.writeTransfer
                (Stewardship.declineTransfer
                    { current = stewardOfferFor model channel
                    , channel = channel
                    , actor = model.ourNick
                    }
                )
                channel
                model.roomTransfers
        , stewardStatus = ""
        , stewardTransferAttempts = Dict.remove (Stewardship.channelKey channel) model.stewardTransferAttempts
      }
    , []
    )


{-| Owner completes an accepted transfer: `+q` for the successor and
`-q` for themselves when they still hold it (mirroring
`grantRoomOwnership` over `transferModeCommands`). -}
requestStewardGrantTransfer : Model -> String -> ( Model, List Outbound )
requestStewardGrantTransfer model channel =
    case ( ( stewardOwnerMembers model channel, stewardOfferFor model channel ), ( model.runtimeOwnerStamp, Dict.get (Stewardship.channelKey channel) model.stewardTransferAttempts ) ) of
        ( ( Err reason, _ ), _ ) ->
            stewardRefused model reason

        ( ( _, Nothing ), _ ) ->
            stewardRefused model Stewardship.stewardshipCopy.transferWait

        ( ( _, Just _ ), ( Nothing, _ ) ) ->
            stewardRefused model "Reconnect before completing this ownership transfer."

        ( ( Ok members, Just offer ), ( Just owner, previous ) ) ->
            let
                retryAllowed =
                    case previous of
                        Just attempt ->
                            attempt.owner == owner
                                && List.member attempt.status [ "reconciled", "observed" ]
                                && Stewardship.channelKey attempt.channel == Stewardship.channelKey channel
                                && Stewardship.nickKey attempt.from == Stewardship.nickKey offer.from
                                && Stewardship.nickKey attempt.to == Stewardship.nickKey offer.to

                        Nothing ->
                            True

                stillNeeded command =
                    case Stewardship.findMember members command.nick of
                        Nothing ->
                            command.modes == "+q"

                        Just member ->
                            if command.modes == "+q" then
                                not (List.member "q" member.modes)

                            else if command.modes == "-q" then
                                List.member "q" member.modes

                            else
                                False
            in
            if Stewardship.nickKey offer.from /= Stewardship.nickKey model.ourNick then
                stewardRefused model "Reconnect as the original transfer owner before completing this handover."

            else if not offer.accepted then
                stewardRefused model Stewardship.stewardshipCopy.transferWait

            else if not retryAllowed then
                stewardRefused model "Refresh the room roster before retrying an incomplete handover."

            else
                case Stewardship.transferModeCommands (Just offer) members of
                    Nothing ->
                        stewardRefused model Stewardship.stewardshipCopy.transferWait

                    Just plan ->
                        let
                            needed =
                                List.filter stillNeeded plan.commands

                            newlyExpected =
                                List.map (\command -> { adding = command.modes == "+q", nick = command.nick }) needed

                            expected =
                                case previous of
                                    Just oldAttempt ->
                                        List.foldl
                                            (\delta acc ->
                                                if List.any (\present -> present.adding == delta.adding && Stewardship.nickKey present.nick == Stewardship.nickKey delta.nick) acc then
                                                    acc

                                                else
                                                    acc ++ [ delta ]
                                            )
                                            oldAttempt.expected
                                            newlyExpected

                                    Nothing ->
                                        newlyExpected

                            previouslyAccepted =
                                previous |> Maybe.map .accepted |> Maybe.withDefault []

                            attempt =
                                { owner = owner
                                , channel = stewardRoomName model channel
                                , from = offer.from
                                , to = offer.to
                                , expected = expected
                                , accepted = previouslyAccepted
                                , status = if List.isEmpty needed then "observed" else "pending"
                                , deadline = model.nowMs + 30000
                                , reconcileAt = Nothing
                                , reconcileSawNames = False
                                }

                            next =
                                { model
                                    | stewardTransferAttempts = Dict.insert (Stewardship.channelKey channel) attempt model.stewardTransferAttempts
                                    , stewardStatus =
                                        if List.isEmpty needed then
                                            "The requested ranks are visible in the current roster. The earlier command outcome is not confirmed."

                                        else
                                            "Waiting for the server to confirm the owner rank changes."
                                }
                        in
                        ( next
                        , List.map
                            (\command ->
                                SendLine (Wire.formatIrcLine "MODE" [ stewardRoomName model channel, command.modes, command.nick ])
                            )
                            needed
                        )


requestStewardReconcileTransfer : Model -> String -> ( Model, List Outbound )
requestStewardReconcileTransfer model channel =
    case ( model.runtimeOwnerStamp, Dict.get (Stewardship.channelKey channel) model.stewardTransferAttempts, Dict.get (String.toLower channel) model.channels ) of
        ( Just owner, Just attempt, Just room ) ->
            if attempt.owner /= owner
                || Stewardship.channelKey attempt.channel /= Stewardship.channelKey channel
                || Stewardship.nickKey attempt.from /= Stewardship.nickKey model.ourNick
                || model.connection /= Live
                || not (List.member attempt.status [ "unknown", "partial", "reconciling", "observed" ]) then
                stewardRefused model "This handover cannot be refreshed under the current owner."

            else
                let
                    refreshed =
                        beginNamesBurst model room.name

                    nextAttempt =
                        { attempt
                            | status = "reconciling"
                            , reconcileAt = Just model.nowMs
                            , reconcileSawNames = False
                            , deadline = model.nowMs + 30000
                        }
                in
                ( { refreshed
                    | stewardTransferAttempts = Dict.insert (Stewardship.channelKey channel) nextAttempt refreshed.stewardTransferAttempts
                    , stewardStatus = "Requesting a roster refresh. No ownership command has been resent."
                  }
                , [ SendLine (Wire.formatIrcLine "NAMES" [ room.name ]) ]
                )

        _ ->
            stewardRefused model "There is no incomplete handover to refresh."


stewardTransferDeltaKey : Bool -> String -> String
stewardTransferDeltaKey adding nick =
    (if adding then
        "+q:"

     else
        "-q:"
    )
        ++ Stewardship.nickKey nick


settleStewardTransferRoster : Model -> Wire.IrcMessage -> Model
settleStewardTransferRoster model message =
    case message.params of
        _ :: channel :: _ ->
            let
                key =
                    Stewardship.channelKey channel
            in
            case ( Dict.get key model.stewardTransferAttempts, model.runtimeOwnerStamp, Dict.get (String.toLower channel) model.channels ) of
                ( Just attempt, Just owner, Just _ ) ->
                    case attempt.status of
                        "reconciling" ->
                            if attempt.owner == owner && Stewardship.channelKey attempt.channel == key && attempt.reconcileSawNames then
                                let
                                    ranksObserved =
                                        stewardTransferDesiredStateObserved model attempt

                                in
                                { model
                                    | stewardTransferAttempts = Dict.insert key { attempt | status = "observed", reconcileAt = Nothing, reconcileSawNames = False } model.stewardTransferAttempts
                                    , stewardStatus =
                                        if ranksObserved then
                                            "The requested ranks are visible in the current roster. The earlier command outcome remains unknown; review and explicitly confirm any remaining change."

                                        else
                                            "A roster reply was received, but this protocol does not correlate it to the refresh request. Review the visible ranks; any remaining change needs your explicit confirmation. Nothing was resent."
                                }

                            else
                                model

                        _ ->
                            model

                _ ->
                    model

        _ ->
            model


stewardTransferDesiredStateObserved : Model -> StewardTransferAttempt -> Bool
stewardTransferDesiredStateObserved model attempt =
    let
        hasOwnerRank nick =
            Stewardship.findMember (stewardMembersOf model attempt.channel) nick
                |> Maybe.map (\member -> List.member "q" member.modes)
                |> Maybe.withDefault False

        priorReleased =
            if List.any (\delta -> not delta.adding && Stewardship.nickKey delta.nick == Stewardship.nickKey attempt.from) attempt.expected then
                not (hasOwnerRank attempt.from)

            else
                True
    in
    hasOwnerRank attempt.to && priorReleased


markStewardReconcileNamesSeen : Model -> Wire.IrcMessage -> Model
markStewardReconcileNamesSeen model message =
    case namesTarget message.params of
        Just ( channel, _ ) ->
            let
                key =
                    Stewardship.channelKey channel
            in
            case ( Dict.get key model.stewardTransferAttempts, model.runtimeOwnerStamp ) of
                ( Just attempt, Just owner ) ->
                    if attempt.owner == owner && attempt.status == "reconciling" && Stewardship.channelKey attempt.channel == key then
                        { model | stewardTransferAttempts = Dict.insert key { attempt | reconcileSawNames = True } model.stewardTransferAttempts }

                    else
                        model

                _ ->
                    model

        Nothing ->
            model


settleStewardTransferModeEcho : Model -> Wire.IrcMessage -> String -> String -> List String -> Model
settleStewardTransferModeEcho model message channel modeStr modeArgs =
    let
        key =
            Stewardship.channelKey channel

        expectedDelta =
            case ( modeStr, List.head modeArgs ) of
                ( "+q", Just nick ) ->
                    Just ( True, nick )

                ( "-q", Just nick ) ->
                    Just ( False, nick )

                _ ->
                    Nothing

        selfAuthored =
            Maybe.withDefault False (Maybe.map (\nick -> Stewardship.nickKey nick == Stewardship.nickKey model.ourNick) message.nick)
    in
    case ( Dict.get key model.stewardTransferAttempts, model.runtimeOwnerStamp, expectedDelta ) of
        ( Just attempt, Just owner, Just ( adding, nick ) ) ->
            let
                deltaKey =
                    stewardTransferDeltaKey adding nick

                isExpected =
                    List.any
                        (\delta -> delta.adding == adding && Stewardship.nickKey delta.nick == Stewardship.nickKey nick)
                        attempt.expected

                rankObserved =
                    Stewardship.findMember (stewardMembersOf model channel) nick
                        |> Maybe.map (\member -> List.member "q" member.modes == adding)
                        |> Maybe.withDefault False

                channelMatches =
                    Stewardship.channelKey attempt.channel == Stewardship.channelKey channel

                authorized =
                    attempt.owner == owner
                        && channelMatches
                        && Stewardship.nickKey attempt.from == Stewardship.nickKey model.ourNick
                        && selfAuthored
                        && isExpected
                        && rankObserved
                        && List.member attempt.status [ "pending", "partial", "unknown", "reconciled", "observed" ]
            in
            if not authorized then
                model

            else
                let
                    accepted =
                        if List.member deltaKey attempt.accepted then
                            attempt.accepted

                        else
                            deltaKey :: attempt.accepted

                    allAccepted =
                        not (List.isEmpty attempt.expected)
                            && List.all (\delta -> List.member (stewardTransferDeltaKey delta.adding delta.nick) accepted) attempt.expected

                    updatedAttempt =
                        { attempt | accepted = accepted, status = if allAccepted then "complete" else "partial", reconcileAt = Nothing }

                    withAttempt =
                        { model | stewardTransferAttempts = Dict.insert key updatedAttempt model.stewardTransferAttempts }
                in
                if allAccepted then
                    { withAttempt
                        | stewardTransferAttempts = Dict.remove key withAttempt.stewardTransferAttempts
                        , roomTransfers = Stewardship.writeTransfer Nothing channel withAttempt.roomTransfers
                        , stewardStatus = "The server confirmed both ownership rank changes."
                    }

                else
                    { withAttempt | stewardStatus = "The server confirmed part of the handover. Review the roster before continuing." }

        _ ->
            model


{-| Owner locks the room: the existing secret + invite-only flags
(mirroring `closeConsumerRoom`). No dedicated close on the wire. -}
requestStewardCloseRoom : Model -> String -> ( Model, List Outbound )
requestStewardCloseRoom model channel =
    case stewardOwnerMembers model channel of
        Err reason ->
            stewardRefused model reason

        Ok _ ->
            ( { model | stewardStatus = "", stewardClosing = False }
            , [ SendLine (Wire.formatIrcLine "MODE" [ stewardRoomName model channel, "+si" ]) ]
            )


{-| Owner deletes the room: the typed name must match, then
`CHANNEL DROP` plus the goodbye PART (mirroring
`deleteConsumerRoom`). Dispatchers never mutate — the server's PART
echo drops the room. -}
requestStewardDeleteRoom : Model -> String -> ( Model, List Outbound )
requestStewardDeleteRoom model channel =
    case stewardOwnerMembers model channel of
        Err reason ->
            stewardRefused model reason

        Ok _ ->
            if
                Stewardship.canDeleteRoom
                    { actorIsOwner = True
                    , typedName = model.stewardTypedName
                    , room = stewardRoomName model channel
                    }
            then
                -- A confirmed delete closes the panel with the room
                -- (mirroring the oracle sheet close on ok).
                ( { model
                    | roomTransfers = Stewardship.writeTransfer Nothing channel model.roomTransfers
                    , stewardStatus = ""
                    , stewardTypedName = ""
                    , stewardDeleting = False
                    , stewardRoom = Nothing
                  }
                , [ SendLine (Wire.formatIrcLine "CHANNEL" [ "DROP", stewardRoomName model channel ])
                  , SendLine (Wire.formatIrcLine "PART" [ stewardRoomName model channel, "Goodbye" ])
                  ]
                )

            else
                stewardRefused model "Type the room name to delete it."


{-| Owner-only webhook verbs (mirroring `webhookCreate`/`webhookList`/
`webhookDelete` over `sendRaw`: the store actions send unconditionally
and the settings UI gates on op + connected — here the Room-care
sheet is owner-only already, and the shared connected-owner gate
covers offline). -}
requestWebhookCreate : Model -> String -> ( Model, List Outbound )
requestWebhookCreate model channel =
    case stewardOwnerMembers model channel of
        Err reason ->
            stewardRefused model reason

        Ok _ ->
            let
                name =
                    String.trim model.webhookName
            in
            ( { model | stewardStatus = "" }
            , [ SendLine
                    (Wire.formatIrcLine "WEBHOOK"
                        (if String.isEmpty name then
                            [ "CREATE", stewardRoomName model channel ]

                         else
                            [ "CREATE", stewardRoomName model channel, String.left Webhook.maxCreateNameChars name ]
                        )
                    )
              ]
            )


requestWebhookList : Model -> String -> ( Model, List Outbound )
requestWebhookList model channel =
    case stewardOwnerMembers model channel of
        Err reason ->
            stewardRefused model reason

        Ok _ ->
            ( { model | stewardStatus = "" }
            , [ SendLine (Wire.formatIrcLine "WEBHOOK" [ "LIST", stewardRoomName model channel ]) ]
            )


requestWebhookDelete : Model -> String -> ( Model, List Outbound )
requestWebhookDelete model channel =
    case stewardOwnerMembers model channel of
        Err reason ->
            stewardRefused model reason

        Ok _ ->
            let
                id =
                    String.trim model.webhookDeleteId
            in
            if String.isEmpty id then
                -- Mirroring `deleteWebhook`: a blank id sends
                -- nothing (and keeps the draft).
                ( model, [] )

            else
                ( { model | stewardStatus = "", webhookDeleteId = "" }
                , [ SendLine (Wire.formatIrcLine "WEBHOOK" [ "DELETE", id ]) ]
                )


{-| The newest webhook service-log rows, newest first (mirroring the
settings sheet's `serviceNotices().filter(source === 'Webhook')`
`.slice(-4).reverse()` over an oldest-first list; the Elm
`serviceLog` is newest-first, so take-4 is the same window).
-}
webhookNotices : Model -> List String
webhookNotices model =
    List.take 4 (List.filter (String.startsWith "Webhook: ") model.serviceLog)


{-| Fold one inbound binary socket frame: validate the Cadence
header fail-closed and hand valid datagrams to the host media
engine (mirroring the `onBinary` dispatch — decode before ingest).
Misshapen frames drop silently; Elm never plays media itself.
-}
foldMediaBinary : Model -> List Int -> ( Model, List Outbound )
foldMediaBinary model bytes =
    case Cadence.decodeFrame bytes of
        Nothing ->
            ( model, [] )

        Just _ ->
            ( model, [ MediaEngineFrame { bytes = bytes } ] )


{-| Strict push owner (account-only — guests never subscribe),
mirroring `signedInPushOwnerKey`. Empty fields fail closed in ports
with the sign-in reason. -}
webPushOwner : Model -> { serverUrl : String, account : String }
webPushOwner model =
    { serverUrl = String.trim (Maybe.withDefault "" model.endpoint)
    , account = Maybe.withDefault "" model.accountName
    }


{-| Reconcile the push bit with the browser whenever the account
owner may have changed (mirroring the oracle recovery effect: the
bit refreshes, and recovery with intent follows from the reply).
Signed out clears the bit with no outbound. Opt-in only: a login
never queries push state for users who never enabled it. -}
requestWebPushCheck : Model -> ( Model, List Outbound )
requestWebPushCheck model =
    let
        owner =
            webPushOwner model
    in
    if model.runtimeOwnerStamp /= Nothing then
        case makeRuntimeDomainOutbound model RuntimeDomain.PushReconcile of
            ( updated, Just command ) ->
                ( updated, [ command ] )

            ( updated, Nothing ) ->
                ( updated, [] )

    else if String.isEmpty owner.account then
        ( { model | webPushOn = False }, [] )

    else if not model.webPushOn then
        ( model, [] )

    else
        ( model, [ WebPushCheckActive owner ] )


{-| The push toggle: off unsubscribes at once; on probes the browser
first so the Elm-side gates run before any permission prompt
(mirroring `handleWebPushToggle`). -}
toggleWebPush : Model -> ( Model, List Outbound )
toggleWebPush model =
    if model.webPushBusy then
        ( model, [] )

    else if model.runtimeOwnerStamp /= Nothing then
        if model.webPushOn then
            case makeRuntimeDomainOutbound { model | webPushBusy = True, webPushError = Nothing } RuntimeDomain.PushDisable of
                ( updated, Just command ) -> ( updated, [ command ] )
                ( updated, Nothing ) -> ( { updated | webPushBusy = False, webPushError = Just "The current local owner is unavailable." }, [] )

        else
            let
                consentRef =
                    model.runtimeDomainResult
                        |> Maybe.andThen
                            (\result ->
                                if result.domain == "platform" && result.action == "push-inspect" then
                                    result.items |> List.filter (\item -> String.startsWith "push:" item.state && not (String.endsWith "registered" item.state)) |> List.head

                                else
                                    Nothing
                            )
                        |> Maybe.map .ref
                        |> Maybe.andThen (\ref -> if String.isEmpty ref then Nothing else Just ref)
            in
            case consentRef of
                Just ref ->
                    case makeRuntimeDomainOutbound { model | webPushBusy = True, webPushError = Nothing } (RuntimeDomain.PushEnable ref) of
                        ( updated, Just command ) -> ( updated, [ command ] )
                        ( updated, Nothing ) -> ( { updated | webPushBusy = False, webPushError = Just "The current local owner is unavailable." }, [] )

                Nothing ->
                    case makeRuntimeDomainOutbound { model | webPushBusy = True, webPushError = Nothing } RuntimeDomain.InspectPush of
                        ( updated, Just command ) -> ( updated, [ command ] )
                        ( updated, Nothing ) -> ( { updated | webPushBusy = False, webPushError = Just "The current local owner is unavailable." }, [] )

    else if model.webPushOn then
        ( { model | webPushBusy = True, webPushError = Nothing }
        , [ WebPushDisable (webPushOwner model) ]
        )

    else
        ( { model | webPushBusy = True, webPushError = Nothing }
        , [ WebPushProbe ]
        )


pushToast : ToastVariant -> String -> String -> Model -> Model
pushToast variant title description model =
    addToast
        { variant = variant
        , title = title
        , description = Just description
        , duration = Nothing
        , groupKey = Nothing
        , undo = Nothing
        }
        model.nowMs
        model


{-| The probe answered: run the Elm-side enable gates (a stale probe
with no enable in flight only records support). -}
foldWebPushProbed : Model -> { supported : Bool, permission : String } -> ( Model, List Outbound )
foldWebPushProbed model probed =
    let
        withProbe =
            { model | webPushSupported = Just probed.supported }
    in
    if not model.webPushBusy || model.webPushOn then
        ( withProbe, [] )

    else
        case
            Push.enableReadiness
                { supported = probed.supported
                , account = model.accountName
                , connected = model.connection == Live
                , vapid = model.isupport.vapid
                }
        of
            Err reason ->
                let
                    toast =
                        Push.pushUnavailableToast reason
                in
                ( pushToast ToastWarning toast.title toast.description { withProbe | webPushBusy = False, webPushError = Just reason }
                , []
                )

            Ok _ ->
                ( withProbe
                , [ WebPushEnable
                        { serverUrl = String.trim (Maybe.withDefault "" model.endpoint)
                        , account = Maybe.withDefault "" model.accountName
                        , vapidKey = model.isupport.vapid
                        }
                  ]
                )


{-| The enable finished: report exactly what happened, never a
silent no-op (mirroring the toggle toasts). -}
foldWebPushEnabled : Model -> { ok : Bool, reason : Maybe String } -> ( Model, List Outbound )
foldWebPushEnabled model reply =
    if reply.ok then
        ( pushToast ToastSuccess Push.pushOnToast.title Push.pushOnToast.description
            { model | webPushBusy = False, webPushOn = True, webPushError = Nothing }
        , []
        )

    else
        let
            reason =
                Maybe.withDefault "Push unavailable." reply.reason

            toast =
                Push.pushUnavailableToast reason
        in
        ( pushToast ToastWarning toast.title toast.description { model | webPushBusy = False, webPushError = Just reason }
        , []
        )


{-| The disable finished (mirroring the toggle toasts). -}
foldWebPushDisabled : Model -> { ok : Bool, reason : Maybe String } -> ( Model, List Outbound )
foldWebPushDisabled model reply =
    if reply.ok then
        ( pushToast ToastInfo Push.pushOffToast.title Push.pushOffToast.description
            { model | webPushBusy = False, webPushOn = False, webPushError = Nothing }
        , []
        )

    else
        let
            reason =
                Maybe.withDefault "Turning off push failed. Try again." reply.reason

            toast =
                Push.pushUnavailableToast reason
        in
        ( pushToast ToastWarning toast.title toast.description { model | webPushBusy = False, webPushError = Just reason }
        , []
        )


{-| Silent recovery settled: the bit follows the outcome, no toast
(mirroring the recovery effect). -}
foldWebPushRecovered : Model -> { ok : Bool, reason : Maybe String } -> ( Model, List Outbound )
foldWebPushRecovered model reply =
    ( { model | webPushOn = reply.ok }, [] )


{-| The browser answered the active check: refresh the bit, then
recover when an opt-in has no live endpoint (never while a toggle
is in flight, never offline, never without VAPID). -}
foldWebPushActiveState : Model -> { active : Bool, intentDesired : Bool } -> ( Model, List Outbound )
foldWebPushActiveState model state =
    let
        next =
            { model | webPushOn = state.active }

        owner =
            webPushOwner next
    in
    if
        not state.active
            && state.intentDesired
            && not next.webPushBusy
            && next.connection == Live
            && not (String.isEmpty owner.account)
            && not (String.isEmpty next.isupport.vapid)
    then
        ( next
        , [ WebPushRecover
                { serverUrl = owner.serverUrl
                , account = owner.account
                , vapidKey = next.isupport.vapid
                }
          ]
        )

    else
        ( next, [] )


{-| Observe one server NOTICE for attribution confirmations
(`IDENTITY ADDED label=…`, `IDENTITY RESIDENCE PUBLISHED`). A
user-originated line carries a nick and is ignored outright, so a
hostile user cannot forge confirmations to poison the enrolled
marker (mirroring the oracle `observe` boundary). A pre-pass:
unrelated lines leave no outbounds so they keep flowing to chat. -}
observeAttributionNotice : Model -> Wire.IrcMessage -> ( Model, List Outbound )
observeAttributionNotice model message =
    if message.nick /= Nothing then
        ( model, [] )

    else
        case List.head (List.drop 1 message.params) of
            Just text ->
                if String.startsWith "IDENTITY ADDED label=" text then
                    fireAttribution
                        (\session ->
                            Attribution.foldAddedNotice session
                                (String.trim (String.dropLeft (String.length "IDENTITY ADDED label=") text))
                        )
                        model

                else if String.startsWith "IDENTITY RESIDENCE PUBLISHED " text then
                    fireAttribution Attribution.foldPublishedNotice model

                else
                    ( model, [] )

            Nothing ->
                ( model, [] )


{-| Assemble a ports-side public projection into a publishable identity.
The ODD1 build runs through the single Elm codec (`encodeEntry`, which
rejects zero signers and misshapen keys); the `ogc1-…` binding check
then runs in `identityProjected`. Anything unparsable is `Nothing` and
fails the publication without sending.
-}
projectToIdentity : { signerPub : String, encryptionPub : String, deviceId : String } -> Maybe GroupPublisher.Identity
projectToIdentity projected =
    case ( Base64Url.decode projected.signerPub, Base64Url.decode projected.encryptionPub ) of
        ( Just signer, Just enc ) ->
            case GroupDirectory.encodeEntry { signerPub = signer, encryptionPub = enc } of
                Just directory ->
                    Just { deviceId = projected.deviceId, directory = directory }

                Nothing ->
                    Nothing

        _ ->
            Nothing


{-| Fold one trusted `E2EEKEY` body. An `ADDED` confirm for the pending
publication is consumed silently (it only proves the server emitted an
ack for this id/algorithm); snapshot lines feed the bounded per-account
collector; complete snapshots land in the directory as provisional
(untrusted) rows. Anything else is an unscoped server notice and joins
the service log like WALLOPS. Mirrors the bridge: ADDED never poisons
an in-flight collector.
-}
foldDirectoryNotice : Model -> String -> ( Model, List Outbound )
foldDirectoryNotice model body =
    let
        ( nextPublisher, acked ) =
            GroupPublisher.trustedBody body model.publisher
    in
    if acked then
        -- Our device id is now server-confirmed: rescan buffered pairs,
        -- since the recipient gate may now open.
        let
            ( rescan, rescanFx ) =
                tryOpenPairs { model | publisher = nextPublisher }
        in
        ( rescan, rescanFx )

    else
        case GroupDirectory.parseSnapshotLine body of
        Nothing ->
            ( logService model body, [] )

        Just line ->
            let
                account =
                    snapshotAccount line

                collector =
                    Maybe.withDefault GroupDirectory.blankCollector
                        (Dict.get account model.groupCollectors)

                ( next, _ ) =
                    GroupDirectory.acceptLine body collector
            in
            if GroupDirectory.isComplete next then
                case GroupDirectory.finishCollector next of
                    Just snapshot ->
                        let
                            key =
                                String.toLower account
                        in
                        ( { model
                            | groupCollectors = Dict.remove account model.groupCollectors
                            , groupDirectory = Dict.insert key snapshot.devices model.groupDirectory
                          }
                        , [ GroupDirectoryDerive
                                { account = key
                                , rows =
                                    List.map
                                        (\row -> { deviceId = row.deviceId, publicKey = row.publicKey })
                                        snapshot.devices
                                }
                            ]
                        )

                    Nothing ->
                        ( { model | groupCollectors = Dict.remove account model.groupCollectors }
                            |> (\m -> logService m ("Group directory snapshot for " ++ account ++ " failed."))
                        , []
                        )

            else if GroupDirectory.isFailed next then
                ( { model | groupCollectors = Dict.remove account model.groupCollectors }
                    |> (\m -> logService m ("Group directory snapshot for " ++ account ++ " failed."))
                , []
                )

            else
                ( { model | groupCollectors = Dict.insert account next model.groupCollectors }, [] )


{-| `FAIL E2EEKEY <code>` from the trusted server prefix. Codes are
open (`[A-Z0-9_]{1,64}`), mirroring `e2eeKeyFailureFromTrustedServer`.
-}
foldDirectoryFailure : Model -> Wire.IrcMessage -> Wire.StandardReply -> ( Model, List Outbound )
foldDirectoryFailure model message reply =
    case model.serverPrefix of
        Nothing ->
            ( model, [] )

        Just trusted ->
            if message.prefix /= Just trusted then
                ( model, [] )

            else if String.isEmpty reply.code || String.length reply.code > 64 || not (List.all (\c -> Char.isAlphaNum c || c == '_') (String.toList reply.code)) then
                ( model, [] )

            else if model.publisher.status == GroupPublisher.Sent then
                -- A FAIL while our ADD is unacknowledged belongs to the
                -- publisher (transient re-arms one retry, anything else
                -- latches reject); it is consumed, never logged as a
                -- directory error. Mirrors the bridge dispatch.
                let
                    ( nextPublisher, pubFx ) =
                        GroupPublisher.trustedFailure reply.code model.publisher
                in
                ( { model | publisher = nextPublisher }, runPublisherEffects pubFx )

            else
                ( logService model ("Group directory: " ++ String.toUpper reply.code ++ "."), [] )


{-| Dotted `E2EE.KEYPACKAGE` / `E2EE.COMMIT` / `E2EE.WELCOME` deliveries
arrive with an empty parsed command (the `Wire` grammar rejects dots),
so the fallback branch re-parses the raw bytes. Only routing metadata
reaches the service log — payloads stay opaque. Account-less legacy
records resolve against no caller here and are dropped fail-closed.
-}
foldGroupDelivery : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldGroupDelivery model message =
    if message.command /= "" then
        ( model, [] )

    else
        case GroupControl.parseDeliveryMessage message Nothing of
            Nothing ->
                ( model, [] )

            Just delivery ->
                requestGroupInstall (logGroupDelivery model delivery) delivery


logGroupDelivery : Model -> GroupControl.Delivery -> Model
logGroupDelivery model delivery =
    let
        kindWord =
            GroupControl.kindToString delivery.kind
    in
    if delivery.locked then
        let
            reasonWord =
                case delivery.lockReason of
                    Just GroupControl.MissingAccount ->
                        "account-less legacy record"

                    Just GroupControl.LegacyOgc1 ->
                        "legacy payload version"

                    Just GroupControl.BadPayload ->
                        "unreadable payload"

                    Nothing ->
                        "withheld payload"
        in
        logService model
            ("Locked group " ++ kindWord ++ " for " ++ delivery.channel ++ " (" ++ reasonWord ++ "); payload withheld.")

    else
        logService model
            ("Received group " ++ kindWord ++ " for " ++ delivery.channel ++ " from " ++ delivery.fromAccount ++ ".")


{-| Flight key for a control-install round trip: room + epoch. -}
groupInstallKey : String -> Int -> String
groupInstallKey room epoch =
    room ++ "|" ++ String.fromInt epoch


{-| Payloads of a welcome-open attempt in flight to ports, keyed by
pair key. Mirrors the adapter's `inFlight` map: a re-delivery while
the open is unresolved coalesces on matching payloads and equivocates
otherwise, instead of buffering a shadow pair. -}
type alias GroupOpenAttempt =
    { commitPayload : String
    , welcomePayload : String
    }


{-| A consumed pair the adapter remembers, newest first. Exact
re-deliveries coalesce silently; divergent ones reject the room.
Mirrors the adapter's bounded `completed` map. -}
type alias CompletedGroupPair =
    { key : String
    , attempt : GroupOpenAttempt
    }


{-| Completed-pair retention, mirroring
`GROUP_CONTROL_ADAPTER_MAX_PENDING` (oldest entries fall off). -}
maxCompletedGroupPairs : Int
maxCompletedGroupPairs =
    64


{-| Room-table retention, mirroring
`GROUP_CONTROL_RUNTIME_MAX_ROOMS`: only untracked rooms are refused,
tracked rooms always update. -}
maxGroupControlRooms : Int
maxGroupControlRooms =
    64


{-| Session-table retention, mirroring
`GROUP_CONTROL_RUNTIME_MAX_SESSIONS`. Installs always track their
room too, so a full session table coincides with a full room table;
the guard stays as defense-in-depth. -}
maxGroupControlSessions : Int
maxGroupControlSessions =
    64


{-| True when a room is already tracked or the room table has a free
slot (mirrors the oracle `admitRoom` refusal). -}
roomTrackedOrAdmissible : Model -> String -> Bool
roomTrackedOrAdmissible model room =
    Dict.member room model.groupRooms
        || Dict.size model.groupRooms < maxGroupControlRooms


{-| True when a room already holds an installed epoch or the session
table has a free slot. -}
sessionAdmissibleFor : Model -> String -> Bool
sessionAdmissibleFor model room =
    Dict.member room model.groupInstalledEpochs
        || Dict.size model.groupInstalledEpochs < maxGroupControlSessions


{-| Remember a consumed pair, newest first, re-keying a repeated key
and dropping the oldest past the cap. -}
rememberCompletedGroupPair : CompletedGroupPair -> List CompletedGroupPair -> List CompletedGroupPair
rememberCompletedGroupPair pair pairs =
    List.take maxCompletedGroupPairs (pair :: List.filter (\entry -> entry.key /= pair.key) pairs)


{-| True when an intake payload matches the recorded half for its kind. -}
completedPartMatches : GroupOpenAttempt -> Bool -> String -> Bool
completedPartMatches recorded isCommit payload =
    if isCommit then
        recorded.commitPayload == payload

    else
        recorded.welcomePayload == payload


appliedGroupEpoch : Model -> String -> Int
appliedGroupEpoch model room =
    Dict.get room model.groupRooms
        |> Maybe.andThen .epoch
        |> Maybe.withDefault -1


{-| Ask ports to verify an unlocked delivery's OGC1 signature. Stale
epochs (at or below the projected one) and in-flight duplicates emit
nothing — the oracle's exact-once replay metadata lives server-side.
-}
requestGroupInstall : Model -> GroupControl.Delivery -> ( Model, List Outbound )
requestGroupInstall model delivery =
    case GroupControl.installInfo delivery.payload of
        Nothing ->
            ( model, [] )

        Just info ->
            let
                room =
                    String.toLower delivery.channel

                key =
                    groupInstallKey room info.epoch
            in
            if appliedGroupEpoch model room >= info.epoch || Set.member key model.groupControlInFlight then
                ( model, [] )

            else
                ( { model | groupControlInFlight = Set.insert key model.groupControlInFlight }
                , [ GroupControlInstall
                        { channel = delivery.channel
                        , kind = GroupControl.kindToString delivery.kind
                        , fromAccount = delivery.fromAccount
                        , fromDevice = delivery.fromDevice
                        , toAccount = delivery.toAccount
                        , toDevice = delivery.toDevice
                        , payload = delivery.payload
                        , epoch = info.epoch
                        , signerB64 = info.signerB64
                        , localAccount = model.ourNick
                        , endpoint = model.endpoint
                        }
                    ]
                )


{-| Admit one signature-verified room against the marked directory. A
by-signer admission advances it to `RoomControlApplied` and clears the
pending intent; anything else leaves it parked. The port pins a
first-use signer before it reports the trust verdict, so this fold
only consumes `pinned` and `first-use`.
-}
tryAdmitPending : Model -> String -> ( Model, List Outbound )
tryAdmitPending model room =
    case Dict.get room model.groupPending of
        Nothing ->
            ( model, [] )

        Just pending ->
            case Dict.get pending.fromAccount model.groupDirectory of
                Nothing ->
                    ( model, [] )

                Just rows ->
                    case GroupDirectory.admitSigner rows pending.fromAccount pending.fromDevice pending.signerB64 of
                        GroupDirectory.Rejected _ ->
                            ( model, [] )

                        GroupDirectory.Admitted _ ->
                            bufferPairable
                                { model
                                    | groupPending = Dict.remove room model.groupPending
                                    , groupRooms =
                                        Dict.insert room
                                            { status = GroupControl.RoomControlApplied
                                            , epoch = Just pending.epoch
                                            }
                                            model.groupRooms
                                }
                                room
                                { room = room
                                , kind = pending.kind
                                , fromAccount = pending.fromAccount
                                , fromDevice = pending.fromDevice
                                , toAccount = pending.toAccount
                                , toDevice = pending.toDevice
                                , payload = pending.payload
                                , signerB64 = pending.signerB64
                                , epoch = pending.epoch
                                }


{-| Highest epoch with an installed key for a room. Admission marks
the projection `RoomControlApplied` before any key exists, so the
installed ledger stays separate: a welcome at or below it is a replay
and drops.
-}
installedGroupEpoch : Model -> String -> Int
installedGroupEpoch model room =
    Maybe.withDefault -1 (Dict.get room model.groupInstalledEpochs)


{-| Welcome half addressed to us: the target account (lowercased)
must equal the 900-learned account and the target device must equal
our publisher-projected device id. Anything else is a foreign pair we
can never open — it stays buffered. Mirrors the adapter's recipient
gate (`welcome.routing.toAccount/toDevice` vs the session identity).
-}
welcomeForUs : Model -> GroupControl.ControlPair -> Maybe GroupControl.PairRecord
welcomeForUs model pair =
    case ( model.accountName, model.publisher.deviceId ) of
        ( Just account, Just deviceId ) ->
            List.head
                (List.filter
                    (\rec -> rec.toDevice == Just deviceId && Maybe.map String.toLower rec.toAccount == Just account)
                    (Dict.values pair.welcomes)
                )

        _ ->
            Nothing


{-| Drop one buffered pair without touching the projection. -}
dropPair : Model -> String -> Model
dropPair model key =
    { model | groupPairs = GroupControl.removePair model.groupPairs key }


{-| Attempt to open one buffered pair: needs a commit half plus our
welcome half, a strictly newer epoch than applied, no open already in
flight, a decodable OGCMT2 commit, and a well-framed OGW1 welcome. The
pair is consumed by the attempt (replays coalesce at admission, so a
lost response only loses a duplicate); the epoch key itself is opened
and installed ports-side and never crosses into Elm. Stale pairs drop
silently; foreign or half pairs stay buffered.
-}
tryOpenPair : Model -> String -> ( Model, List Outbound )
tryOpenPair model key =
    case GroupControl.getPair model.groupPairs key of
        Nothing ->
            ( model, [] )

        Just pair ->
            if pair.quarantined || Dict.member key model.groupWelcomeInFlight then
                ( model, [] )

            else if pair.epoch <= installedGroupEpoch model pair.room then
                ( dropPair model key, [] )

            else
                case ( pair.commit, welcomeForUs model pair ) of
                    ( Just commitRec, Just welcomeRec ) ->
                        case GroupCommit.decodeGroupCommitBase64url commitRec.payload of
                            Nothing ->
                                ( dropPair (rejectControl model pair.room ("Group commit for " ++ pair.room ++ " unreadable; ignored.")) key, [] )

                            Just commit ->
                                case GroupWelcome.decodeEnvelope welcomeRec.payload of
                                    Nothing ->
                                        ( dropPair (rejectControl model pair.room ("Group welcome for " ++ pair.room ++ " malformed; ignored.")) key, [] )

                                    Just _ ->
                                        ( { model
                                            | groupPairs = GroupControl.removePair model.groupPairs key
                                            , groupWelcomeInFlight =
                                                Dict.insert key
                                                    { commitPayload = commitRec.payload
                                                    , welcomePayload = welcomeRec.payload
                                                    }
                                                    model.groupWelcomeInFlight
                                          }
                                        , [ GroupWelcomeOpen
                                                { key = key
                                                , room = pair.room
                                                , fromAccount = pair.sender
                                                , fromDevice = pair.fromDevice
                                                , toAccount = Maybe.withDefault "" welcomeRec.toAccount
                                                , toDevice = Maybe.withDefault "" welcomeRec.toDevice
                                                , epoch = pair.epoch
                                                , commitIdB64 = Base64Url.encode commit.commitId
                                                , membershipB64 = Base64Url.encode commit.membershipDigest
                                                , commitmentB64 = Base64Url.encode commit.newEpochKeyCommitment
                                                , welcomeB64 = welcomeRec.payload
                                                }
                                          ]
                                        )

                    _ ->
                        ( model, [] )


{-| Drop half-pairs older than the TTL (mirroring `expireHalfPairs`
on intake: rooms the ledger still tracks fall back to
recovery-required with an installed session, else locked — the
expiry itself stays silent like the oracle bump, surfacing through
the projection).
-}
sweepExpiredGroupPairs : Model -> Model
sweepExpiredGroupPairs model =
    let
        swept =
            GroupControl.expireHalfPairs (floor model.nowMs) model.groupPairs

        fallBack rooms acc =
            case rooms of
                [] ->
                    acc

                room :: rest ->
                    case Dict.get room acc.groupRooms of
                        Nothing ->
                            fallBack rest acc

                        Just projection ->
                            let
                                status =
                                    if Dict.member room acc.groupInstalledEpochs then
                                        GroupControl.RoomRecoveryRequired

                                    else
                                        GroupControl.RoomLocked
                            in
                            fallBack rest
                                { acc
                                    | groupRooms =
                                        Dict.insert room { status = status, epoch = projection.epoch } acc.groupRooms
                                }
    in
    let
        fallen =
            fallBack swept.expired model
    in
    { fallen | groupPairs = swept.buffer }


{-| Scan every buffered pair for an openable welcome. Idempotent:
in-flight, foreign, half, and stale pairs are left alone. Runs when a
pair becomes ready and when our device identity lands (projection or
ack), since the recipient gate needs it.
-}
tryOpenPairs : Model -> ( Model, List Outbound )
tryOpenPairs model =
    let
        swept =
            sweepExpiredGroupPairs model
    in
    List.foldl
        (\key ( accModel, accFx ) ->
            let
                ( nextModel, fx ) =
                    tryOpenPair accModel key
            in
            ( nextModel, accFx ++ fx )
        )
        ( swept, [] )
        swept.groupPairs.order


{-| Record a successful welcome open: the room applies and its epoch
installs, unless a table is full (mirroring the oracle
`registerProvisionedSession` capacity refusal — rooms first, then
sessions; a refused room skips both, so unprovisioned seals keep
failing closed).
-}
applyInstall : Model -> String -> { key : String, room : String, epoch : Int, ok : Bool, reason : String } -> ( Model, List Outbound )
applyInstall settled room result =
    if not (roomTrackedOrAdmissible settled room) then
        ( logService settled ("Group control room table full; record for " ++ result.room ++ " ignored."), [] )

    else if not (sessionAdmissibleFor settled room) then
        ( logService settled ("Group control session table full; install for " ++ result.room ++ " ignored."), [] )

    else
        ( logService
            { settled
                | groupRooms =
                    Dict.insert room { status = GroupControl.RoomControlApplied, epoch = Just result.epoch } settled.groupRooms
                , groupInstalledEpochs =
                    Dict.insert room result.epoch settled.groupInstalledEpochs
            }
            ("Group encryption active for " ++ result.room ++ " (epoch " ++ String.fromInt result.epoch ++ ").")
        , []
        )


{-| Fold a ports welcome-open verdict. A successful install advances
the projection (never resurrecting a quarantined room) and the room
can seal from the new epoch; a missing recipient key stays locked and
latched loudly; any other failure rejects the room like the oracle's
rejected adapter outcomes.
-}
foldGroupWelcomeOpened : Model -> { key : String, room : String, epoch : Int, ok : Bool, reason : String } -> ( Model, List Outbound )
foldGroupWelcomeOpened model result =
    let
        attempt =
            Dict.get result.key model.groupWelcomeInFlight

        settled =
            { model
                | groupWelcomeInFlight = Dict.remove result.key model.groupWelcomeInFlight
                , groupCompletedPairs =
                    -- Terminal outcomes memoize the consumed pair (exact
                    -- re-deliveries coalesce, divergent ones equivocate);
                    -- retryable locks (`recipient-key-unavailable`,
                    -- `unavailable`) stay retryable through re-delivery,
                    -- mirroring the adapter's `shouldRetry`/`memoizeResult`.
                    case attempt of
                        Just flight ->
                            if result.ok || (result.reason /= "recipient-key-unavailable" && result.reason /= "unavailable") then
                                rememberCompletedGroupPair { key = result.key, attempt = flight } model.groupCompletedPairs

                            else
                                model.groupCompletedPairs

                        Nothing ->
                            model.groupCompletedPairs
            }

        room =
            String.toLower result.room
    in
    if result.ok then
        case Dict.get room settled.groupRooms of
            Just projection ->
                if projection.status == GroupControl.RoomRejected then
                    ( logService settled ("Group welcome for " ++ result.room ++ " opened after quarantine; ignored."), [] )

                else
                    applyInstall settled room result

            Nothing ->
                applyInstall settled room result

    else if result.reason == "recipient-key-unavailable" || result.reason == "unavailable" then
        ( logService settled ("Group welcome for " ++ result.room ++ " cannot open yet; locked."), [] )

    else
        ( rejectControl settled room ("Group welcome for " ++ result.room ++ " failed (" ++ result.reason ++ "); ignored."), [] )


{-| Buffer an admitted delivery into its commit+welcome pair. A ready
pair attempts the welcome open at once (installing nothing Elm-side);
an equivocation rejects the room like the oracle's quarantine path,
and a full buffer is logged rather than evicting live pairs.
-}
bufferPairable : Model -> String -> GroupControl.Pairable -> ( Model, List Outbound )
bufferPairable model room item =
    let
        ( pairs, event ) =
            GroupControl.bufferDelivery (floor model.nowMs) model.groupPairs item

        buffered =
            { model | groupPairs = pairs }
    in
    case event of
        GroupControl.PairReady key _ ->
            let
                ( opened, fx ) =
                    tryOpenPair buffered key
            in
            if List.isEmpty fx then
                ( opened, [] )

            else
                ( logService opened ("Opening group welcome for " ++ room ++ " (epoch " ++ String.fromInt item.epoch ++ ")."), fx )

        GroupControl.PairEquivocated _ ->
            ( rejectControl buffered
                room
                ("Conflicting group records for " ++ room ++ "; quarantined.")
            , []
            )

        GroupControl.PairFull _ ->
            ( logService buffered
                ("Group control pair buffer full; record for " ++ room ++ " ignored.")
            , []
            )

        _ ->
            ( logService buffered
                ("Group encryption active for " ++ room ++ ".")
            , []
            )


{-| Fold ports derivation verdicts: mark the snapshot rows, then retry
every pending admission. Verdicts for unknown accounts touch nothing.
-}
foldGroupDerived : Model -> { account : String, rows : List GroupDirectory.DerivedRow } -> ( Model, List Outbound )
foldGroupDerived model derived =
    let
        key =
            String.toLower derived.account

        marked =
            case Dict.get key model.groupDirectory of
                Nothing ->
                    model.groupDirectory

                Just rows ->
                    Dict.insert key (GroupDirectory.markDerived rows derived.rows) model.groupDirectory

        admitted =
            { model | groupDirectory = marked }
    in
    List.foldl
        (\room ( accModel, accFx ) ->
            let
                ( nextModel, fx ) =
                    tryAdmitPending accModel room
            in
            ( nextModel, accFx ++ fx )
        )
        ( admitted, [] )
        (Dict.keys admitted.groupPending)


{-| Reject a room projection with a message, preserving any projected
epoch and dropping the pending intent. Rejection never writes pins.
-}
rejectControl : Model -> String -> String -> Model
rejectControl model room message =
    let
        epoch =
            case Dict.get room model.groupRooms of
                Just projection ->
                    projection.epoch

                Nothing ->
                    Nothing
    in
    logService
        { model
            | groupPending = Dict.remove room model.groupPending
            , groupRooms =
                -- A full room table stays shut: the refusal is logged
                -- but the room goes untracked like the oracle `setRoom`
                -- no-op.
                if roomTrackedOrAdmissible model room then
                    Dict.insert room
                        { status = GroupControl.RoomRejected
                        , epoch = epoch
                        }
                        model.groupRooms

                else
                    model.groupRooms
        }
        message


{-| Fold a ports signature verdict. A valid signature with a pinned
or first-use signer parks the room as directory-pending and attempts
admission; key-changed, removed-device, and store-unavailable verdicts
reject without touching pins. Stale epochs never move the projection
backwards.
-}
foldGroupVerified : Model -> { channel : String, epoch : Int, signerB64 : String, fromAccount : String, fromDevice : String, toAccount : Maybe String, toDevice : Maybe String, kind : String, payload : String, signatureValid : Bool, trust : String } -> ( Model, List Outbound )
foldGroupVerified model result =
    let
        swept =
            sweepExpiredGroupPairs model

        room =
            String.toLower result.channel

        key =
            groupInstallKey room result.epoch

        settled =
            { swept | groupControlInFlight = Set.remove key swept.groupControlInFlight }

        prior =
            Dict.get room settled.groupRooms

        priorEpoch =
            Maybe.withDefault -1 (Maybe.andThen .epoch prior)
    in
    if not result.signatureValid then
        if result.epoch <= priorEpoch && priorEpoch >= 0 then
            ( settled, [] )

        else
            ( rejectControl settled
                room
                ("Group control record for " ++ result.channel ++ " failed verification; ignored.")
            , []
            )

    else
        case result.trust of
            "pinned" ->
                admitValid settled room result

            "first-use" ->
                admitValid settled room result

            "key-changed" ->
                ( rejectControl settled
                    room
                    ("Group device key for " ++ result.fromAccount ++ "/" ++ result.fromDevice ++ " changed; control record ignored.")
                , []
                )

            "device-absent" ->
                ( rejectControl settled
                    room
                    ("Group device " ++ result.fromDevice ++ " for " ++ result.fromAccount ++ " was removed; control record ignored.")
                , []
                )

            _ ->
                ( rejectControl settled
                    room
                    ("Group signer store unavailable; control record for " ++ result.channel ++ " ignored.")
                , []
                )


{-| A trust-admitted delivery: deliveries matching an in-flight or
consumed pair coalesce silently on identical payloads and reject the
room as equivocation on divergence (mirroring the adapter's
in-flight/completed checks); otherwise coalesce exact buffered
replays silently, park forward epochs as directory-pending with their
routing retained, and buffer stale epochs without moving the
projection.
-}
admitValid : Model -> String -> { channel : String, epoch : Int, signerB64 : String, fromAccount : String, fromDevice : String, toAccount : Maybe String, toDevice : Maybe String, kind : String, payload : String, signatureValid : Bool, trust : String } -> ( Model, List Outbound )
admitValid settled room result =
    let
        key =
            GroupControl.pairBaseKey room (String.toLower result.fromAccount) result.fromDevice result.epoch

        isCommit =
            Maybe.withDefault GroupControl.Commit (GroupControl.kindFromString result.kind) == GroupControl.Commit

        diverge =
            ( rejectControl settled room ("Conflicting group records for " ++ result.channel ++ "; rejected."), [] )
    in
    case Dict.get key settled.groupWelcomeInFlight of
        Just flight ->
            if completedPartMatches flight isCommit result.payload then
                ( settled, [] )

            else
                diverge

        Nothing ->
            case List.filter (\entry -> entry.key == key) settled.groupCompletedPairs |> List.head of
                Just done ->
                    if completedPartMatches done.attempt isCommit result.payload then
                        ( settled, [] )

                    else
                        diverge

                Nothing ->
                    admitValidBuffered settled room result key


{-| A trust-admitted delivery with no in-flight or completed pair for
its key: coalesce exact buffered replays silently, park forward
epochs as directory-pending with their routing retained, and buffer
stale epochs without moving the projection.
-}
admitValidBuffered : Model -> String -> { channel : String, epoch : Int, signerB64 : String, fromAccount : String, fromDevice : String, toAccount : Maybe String, toDevice : Maybe String, kind : String, payload : String, signatureValid : Bool, trust : String } -> String -> ( Model, List Outbound )
admitValidBuffered settled room result key =
    let
        item =
            { room = room
            , kind =
                Maybe.withDefault GroupControl.Commit
                    (GroupControl.kindFromString result.kind)
            , fromAccount = String.toLower result.fromAccount
            , fromDevice = result.fromDevice
            , toAccount = result.toAccount
            , toDevice = result.toDevice
            , payload = result.payload
            , signerB64 = result.signerB64
            , epoch = result.epoch
            }
    in
    if GroupControl.pairHasPayload settled.groupPairs key result.payload then
        ( settled, [] )

    else if result.epoch >= appliedGroupEpoch settled room then
        if roomTrackedOrAdmissible settled room then
            tryAdmitPending
                (logService
                    { settled
                        | groupRooms =
                            Dict.insert room
                                { status = GroupControl.RoomDirectoryPending
                                , epoch = Just result.epoch
                                }
                                settled.groupRooms
                        , groupPending =
                            Dict.insert room
                                { epoch = result.epoch
                                , signerB64 = result.signerB64
                                , fromAccount = String.toLower result.fromAccount
                                , fromDevice = result.fromDevice
                                , toAccount = result.toAccount
                                , toDevice = result.toDevice
                                , payload = result.payload
                                , kind =
                                    Maybe.withDefault GroupControl.Commit
                                        (GroupControl.kindFromString result.kind)
                                }
                                settled.groupPending
                    }
                    ("Group control signature verified for " ++ result.channel ++ "; signer trust pending.")
                )
                room

        else
            -- Room table full: the pair still buffers under its own cap,
            -- but the room stays untracked like the oracle `admitRoom`
            -- refusal. The refusal logs last so it heads the log.
            let
                ( buffered, fx ) =
                    bufferPairable settled room item
            in
            ( logService buffered ("Group control room table full; record for " ++ result.channel ++ " ignored."), fx )

    else
        bufferPairable settled
            room
            item


{-| `FAIL` / `WARN E2EEGROUP <code>` eligibility matrix from the v2
contract. Unknown codes still surface (bounded by the reply grammar)
so a server refusal is never silent.
-}
foldE2eGroupReply : Model -> Wire.StandardReply -> Model
foldE2eGroupReply model reply =
    case GroupControl.parseE2eGroupFail reply.code of
        Just fail ->
            logService model
                ("Group encryption: " ++ GroupControl.e2eGroupFailText fail ++ " (" ++ String.toUpper reply.code ++ ").")

        Nothing ->
            logService model
                ("Group encryption: unexpected response " ++ String.toUpper reply.code ++ ".")


logService : Model -> String -> Model
logService model text =
    if String.isEmpty (String.trim text) then
        model

    else
        { model | serviceLog = List.take maxServiceLog (text :: model.serviceLog) }


foldPasskeyReply : Model -> Wire.StandardReply -> ( Model, List Outbound )
foldPasskeyReply model reply =
    let
        before =
            model.passkey

        ( session, effect ) =
            Passkey.foldPasskeyReply before reply

        outs =
            passkeyOut effect

        settle =
            case ( before.pendingAuth, session.pendingAuth ) of
                ( Nothing, Just _ ) ->
                    [ PasskeySettleRequest ]

                _ ->
                    []
    in
    ( { model | passkey = session }
    , outs ++ settle
    )


passkeyOut : Passkey.PasskeyEffect -> List Outbound
passkeyOut effect =
    case effect of
        Passkey.NoEffect ->
            []

        Passkey.RunCreateCeremony args ->
            [ PasskeyCreate args ]

        Passkey.RunGetCeremony args ->
            [ PasskeyGet args ]

        Passkey.SendLine line ->
            [ SendLine line ]

        Passkey.ReportError _ ->
            []


{-| Append one service/whisper row. Whisper delivery counts toward
unread like any chat row when asked (the oracle's `whisper`
message type); service notes never count. -}
type DeliveryFate
    = DeliverDrop
    | DeliverPlaceholder
    | DeliverQuiet
    | DeliverNormal


{-| One delivery decision for an inbound row (mirroring the oracle's
ignore/mute guards): ignored senders drop silently on channels;
ignored-sender DMs (never our own) stay visible as a placeholder and
never count; muted DMs store normally but never count. -}
deliveryFate : Model -> String -> String -> DeliveryFate
deliveryFate model target from =
    let
        senderLower =
            String.toLower from

        senderIgnored =
            Set.member senderLower model.ignoredUsers

        own =
            senderLower == String.toLower model.ourNick

        channelTarget =
            isChannelName model target

        -- DM buckets key by wire target, so the peer may be the sender
        -- (inbound rows addressed to us) or the bucket itself.
        dmMuted =
            Set.member (String.toLower target) model.mutedDMs || Set.member senderLower model.mutedDMs
    in
    if senderIgnored && channelTarget then
        DeliverDrop

    else if senderIgnored && not channelTarget && not own then
        DeliverPlaceholder

    else if not channelTarget && dmMuted then
        DeliverQuiet

    else
        DeliverNormal


appendChat : Model -> String -> String -> String -> Bool -> Bool -> String -> Model
appendChat model target from body whisper countUnread msgType =
    -- History merges store verbatim (mirroring `mergeHistory`, which
    -- bypasses delivery): drops/placeholders are live-delivery only.
    case
        if model.historyMerging then
            DeliverNormal

        else
            deliveryFate model target from
    of
        DeliverDrop ->
            model

        fate ->
            case admitLiveDelivery model target of
                Nothing ->
                    model

                Just admitted ->
                    let
                        placeholder =
                            fate == DeliverPlaceholder

                        effectiveBody =
                            if placeholder then
                                "Message from ignored user"

                            else
                                body

                        rowHighlight =
                            if placeholder then
                                False

                            else
                                classifyHighlight model target from body

                        appended =
                            updateChannel admitted
                                target
                                (\c ->
                                    { c
                                        | messages =
                                            List.take (messageRetentionFor admitted target)
                                                ({ id = model.messageSeq
                                                 , from = from
                                                 , body = effectiveBody
                                                 , whisper = whisper
                                                 , audience = Nothing
                                                 , highlight = rowHighlight
                                                 , outboxId = Nothing
                                                 , pending = False
                                                 , plaintext = Nothing
                                                 , at = floor model.nowMs
                                                 , msgid = Nothing
                                                 , reactions = []
                                                 , edited = False
                                                 , deleted = False
                                                 , redacted = False
                                                 , topic = ""
                                                 , msgType = msgType
                                                 , replyTo = Nothing
                                                 }
                                                    :: c.messages
                                                )
                                    }
                                )
                                |> (\m -> { m | messageSeq = m.messageSeq + 1 })
                    in
                    -- A stored DM row voids or proves the device-history privacy
                    -- proof (mirroring the vault-write invalidation that keeps a
                    -- `plain` proof from outliving a mutation).
                    if countUnread && fate == DeliverNormal then
                        trackVaultDmPrivacy (trackUnread appended target model.messageSeq from body rowHighlight Nothing) target body

                    else
                        trackVaultDmPrivacy appended target body


{-| NAMES burst phase (mirroring the oracle `NamesBurst`: only a
burst we initiated — phase `expect` — authorizes the next 353 to
REPLACE the roster; everything else appends).
-}
type NamesBurstPhase
    = BurstExpect
    | BurstAppending
    | BurstSettled


{-| Per-channel NAMES burst tracking: phase plus the live
removals/renames a stale later 353 must not resurrect.
-}
type alias NamesBurst =
    { phase : NamesBurstPhase
    , at : Float
    , excluded : Set String
    }


{-| A burst older than this (its 366 was lost) counts as finished. -}
namesBurstTtlMs : Float
namesBurstTtlMs =
    15000


{-| Roster-sized ceiling for live channel membership, mirroring
`MAX_LIVE_CHANNEL_USERS`. -}
maxLiveChannelUsers : Int
maxLiveChannelUsers =
    4096


{-| Minimum gap between two client-initiated roster refreshes for one
channel (mirroring `_ROSTER_REFRESH_MS`). -}
rosterRefreshMs : Float
rosterRefreshMs =
    8000


{-| Slow reconcile poll interval (mirroring `_ROSTER_POLL_MS`): every
room re-issues JOIN + NAMES so a half-applied netsplit heals without
a manual switch. -}
rosterPollMs : Float
rosterPollMs =
    45000


{-| Reconcile one channel's roster against server truth (mirroring
`_refreshChannelRoster`): skipped while a burst is already open or
the per-channel throttle holds, otherwise the burst arms and a NAMES
goes out. An absent throttle entry means "never refreshed", never
timestamp zero.
-}
refreshChannelRoster : Model -> String -> ( Model, List Outbound )
refreshChannelRoster model name =
    case Dict.get (String.toLower name) model.channels of
        Nothing ->
            ( model, [] )

        Just channel ->
            let
                key =
                    String.toLower name
            in
            if model.connection /= Live then
                ( model, [] )

            else if recentNamesBurst model key /= Nothing then
                ( model, [] )

            else
                case Dict.get key model.lastRosterRefresh of
                    Just last ->
                        if model.nowMs - last < rosterRefreshMs then
                            ( model, [] )

                        else
                            sendRosterRefresh model channel key

                    Nothing ->
                        sendRosterRefresh model channel key


sendRosterRefresh : Model -> Channel -> String -> ( Model, List Outbound )
sendRosterRefresh model channel key =
    let
        armed =
            beginNamesBurst
                { model | lastRosterRefresh = Dict.insert key model.nowMs model.lastRosterRefresh }
                channel.name
    in
    ( armed, [ SendLine (Wire.formatIrcLine "NAMES" [ channel.name ]) ] )


{-| NAMES after our own JOIN when the server suppresses the automatic
353 burst (mirroring the oracle self-JOIN arm: a client that negotiated
`draft/no-implicit-names` or `no-implicit-names` must request the
authoritative roster itself). The burst is already armed by `foldJoin`,
so ordering matches the oracle's arm-before-send. Never sent on legacy
JOINs: duplicate interleaved bursts can collapse mesh nicklists. The
client never REQs either cap (`Session.wantedCaps` excludes it, like the
oracle `client.ts` refusal) — this arm only covers a server that enabled
it anyway.
-}
namesAfterSelfJoin : Model -> String -> List Outbound
namesAfterSelfJoin model channel =
    if Session.hasCapability model.caps "no-implicit-names" then
        [ SendLine (Wire.formatIrcLine "NAMES" [ channel ]) ]

    else
        []


{-| Slow reconcile poll (mirroring the oracle `_startRosterPoll`): a
NAMES-only refresh of the active room view through
`refreshChannelRoster` (burst + throttle guards intact). Never a
JOIN: membership is established by JOIN echoes and the 001
reconnect storm, and re-JOINing every room on a timer would refetch
every history buffer (each self-JOIN echo pulls CHATHISTORY) plus
send protocol-invalid `JOIN <nick>` lines for DM shells. A DM
active view polls nothing, like the oracle's `view.kind ===
'channel'` gate. -}
pollChannelRosters : Model -> ( Model, List Outbound )
pollChannelRosters model =
    if model.connection /= Live then
        ( model, [] )

    else
        case model.activeChannel of
            Just name ->
                if isChannelName model name then
                    let
                        ( refreshed, outs ) =
                            refreshChannelRoster model name
                    in
                    ( { refreshed | lastRosterPollMs = model.nowMs }, outs )

                else
                    ( { model | lastRosterPollMs = model.nowMs }, [] )

            Nothing ->
                ( { model | lastRosterPollMs = model.nowMs }, [] )


{-| Reconnect re-JOIN storm (mirroring the oracle `onConnected`
`hasRegistered` arm): a 001 landing with rooms still shown
re-establishes every room server-side — JOIN, then the burst arm so
the reconciling NAMES replaces instead of appending, then NAMES —
because a reconnect is a brand-new session server-side (a guest's
especially) and anything sent to an unrejoined room is silently
dropped while the UI pretends all is well. Suppressed when
`onyx/session-sync` is negotiated (the server itself replays JOIN +
NAMES + topic + CHATHISTORY, and a client storm would race that
reclaim) and vacuous on a first registration (no rooms yet; its
JOINs already pull fresh NAMES). DM shells never JOIN: only
`isChannelName` rooms storm. Fires at 001 rather than on the
oracle's 600ms timer because CAP already settled the session-sync
gate by registration — no race remains. -}
rejoinLiveChannels : Model -> ( Model, List Outbound )
rejoinLiveChannels model =
    if List.member "onyx/session-sync" model.caps then
        ( model, [] )

    else
        let
            step channel ( acc, outs ) =
                if isChannelName acc channel.name then
                    ( beginNamesBurst acc (String.toLower channel.name)
                    , outs
                        ++ [ SendLine (Wire.formatIrcLine "JOIN" [ channel.name ])
                           , SendLine (Wire.formatIrcLine "NAMES" [ channel.name ])
                           ]
                    )

                else
                    ( acc, outs )
        in
        List.foldl step ( model, [] ) (Dict.values model.channels)


{-| Recent burst state for a channel, or nothing when no burst is
open or its 366 was lost past the TTL. -}
recentNamesBurst : Model -> String -> Maybe NamesBurst
recentNamesBurst model channel =
    case Dict.get (ircCaseKey model channel) model.namesBursts of
        Just burst ->
            if model.nowMs - burst.at >= namesBurstTtlMs then
                Nothing

            else
                Just burst

        Nothing ->
            Nothing


{-| Arm a client-initiated NAMES burst: the next 353 for the channel
may REPLACE the roster. Mid-burst calls only refresh the TTL and
keep the exclusion set (re-arming `expect` mid-flight is what used
to collapse mesh nicklists to a partial subset).
-}
beginNamesBurst : Model -> String -> Model
beginNamesBurst model channel =
    let
        key =
            ircCaseKey model channel
    in
    case recentNamesBurst model key of
        Just burst ->
            case burst.phase of
                BurstSettled ->
                    { model
                        | namesBursts =
                            Dict.insert key { phase = BurstExpect, at = model.nowMs, excluded = burst.excluded } model.namesBursts
                    }

                _ ->
                    { model
                        | namesBursts = Dict.insert key { burst | at = model.nowMs } model.namesBursts
                    }

        Nothing ->
            { model
                | namesBursts =
                    Dict.insert key { phase = BurstExpect, at = model.nowMs, excluded = Set.empty } model.namesBursts
            }


{-| A live removal/rename wins over any stale 353 still in flight. -}
excludeBurstNick : Model -> String -> String -> Model
excludeBurstNick model channel nick =
    if String.isEmpty nick then
        model

    else
        let
            key =
                ircCaseKey model channel

            nickKey =
                ircCaseKey model nick
        in
        case recentNamesBurst model key of
            Just burst ->
                { model
                    | namesBursts =
                        Dict.insert key { burst | excluded = Set.insert nickKey burst.excluded } model.namesBursts
                }

            Nothing ->
                model


{-| A later live JOIN/NICK makes this nick current again. -}
includeBurstNick : Model -> String -> String -> Model
includeBurstNick model channel nick =
    if String.isEmpty nick then
        model

    else
        let
            key =
                ircCaseKey model channel

            nickKey =
                ircCaseKey model nick
        in
        case recentNamesBurst model key of
            Just burst ->
                { model
                    | namesBursts =
                        Dict.insert key { burst | excluded = Set.remove nickKey burst.excluded } model.namesBursts
                }

            Nothing ->
                model


{-| Drop NAMES bursts whose 366 was lost past the TTL. -}
pruneNamesBursts : Float -> Dict String NamesBurst -> Dict String NamesBurst
pruneNamesBursts nowMs bursts =
    Dict.filter (\_ burst -> nowMs - burst.at < namesBurstTtlMs) bursts


{-| Fetch the channel prop registry at end-of-NAMES on IRCX
(mirroring the oracle 366 arm's `requestChannelProps`: a bare
`PROP <channel>` whenever the channel token is non-empty — no
membership gate on either side).
-}
requestPropsOnNamesEnd : Model -> Wire.IrcMessage -> List Outbound
requestPropsOnNamesEnd model message =
    case message.params of
        _ :: chan :: _ ->
            if String.isEmpty chan || not model.isupport.ircx then
                []

            else
                [ SendLine (Wire.formatIrcLine "PROP" [ chan ]) ]

        _ ->
            []


{-| RPL_ENDOFNAMES 366: settle the burst rather than discarding it.
A mesh reply can interleave so an early 366 is followed by another
stale 353 — keeping the live-removal tombstones for one bounded TTL
stops that late line from resurrecting a PART/QUIT/NICK target, and
the settled burst stays refresh-active until TTL so re-arming before
late lines drain cannot let a stale partial replace the roster.
-}
settleNamesBurst : Model -> Wire.IrcMessage -> Model
settleNamesBurst model message =
    case message.params of
        _ :: chan :: _ ->
            let
                key =
                    String.toLower chan
            in
            case recentNamesBurst model key of
                Just burst ->
                    { model
                        | namesBursts =
                            Dict.insert key { burst | phase = BurstSettled, at = model.nowMs } model.namesBursts
                    }

                Nothing ->
                    model

        _ ->
            model


{-| Split a 353 param block into its channel and names trailing
(mirroring the oracle visibility rule: RFC 2812 `=/*/@` takes
params[2]/params[3]; the RFC 1459 form without a visibility char
takes params[1]/params[2] — only the single trailing param carries
names, never the joined rest).
-}
namesTarget : List String -> Maybe ( String, String )
namesTarget params =
    case params of
        _ :: second :: rest ->
            if second == "=" || second == "*" || second == "@" then
                case rest of
                    chan :: namesRest ->
                        Just ( chan, Maybe.withDefault "" (List.head namesRest) )

                    [] ->
                        Nothing

            else
                Just ( second, Maybe.withDefault "" (List.head rest) )

        _ ->
            Nothing


{-| Scan ceiling for one 353 names trailing (mirroring
`MAX_NAMES_SCAN_CHARS`). -}
maxNamesScanChars : Int
maxNamesScanChars =
    262144


{-| Per-token ceiling inside one 353 line (mirroring
`MAX_NAMES_TOKEN_LENGTH`: overlong tokens drop, the line
survives). -}
maxNamesTokenLength : Int
maxNamesTokenLength =
    512


{-| Canonical keys for IRC nick and target identity follow the active
server CASEMAPPING. This is deliberately separate from account IDs,
display text, and arbitrary search strings.
-}
ircCaseKey : Model -> String -> String
ircCaseKey model value =
    Wire.normalizeCase value model.isupport.casemapping


{-| Tokenize one 353 names trailing (mirroring
`_boundedNamesTokens`: space-split — a tab stays inside its token
for the per-nick gate to reject — overlong tokens drop, at most
`maxLiveChannelUsers` tokens survive, and a token the scan ceiling
cuts through is dropped rather than invented truncated).
-}
boundNamesTokens : String -> List String
boundNamesTokens value =
    let
        over =
            String.length value > maxNamesScanChars

        sliced =
            if over then
                String.left maxNamesScanChars value
            else
                value

        nextChar =
            String.slice maxNamesScanChars (maxNamesScanChars + 1) value

        rawWords =
            List.filter (not << String.isEmpty) (String.split " " sliced)

        complete =
            if over && not (String.endsWith " " sliced) && nextChar /= " " then
                List.take (List.length rawWords - 1) rawWords

            else
                rawWords
    in
    complete
        |> List.filter (\token -> String.length token <= maxNamesTokenLength)
        |> List.take maxLiveChannelUsers


{-| NAMES 353: the first line of a burst we initiated REPLACES the
roster (dropping departed members); every other line — later burst
lines, overlapping bursts, stray or late lines with no burst entry —
only APPENDS, so a partial can never collapse the roster. Nicks a
live removal excluded stay out, hostile tokens never plant members,
and unknown channels seed nothing.
-}
foldNames : Model -> Wire.IrcMessage -> Model
foldNames model message =
    case namesTarget message.params of
        Nothing ->
            model

        Just ( chan, namesParam ) ->
            if not (validWireToken chan 512) || not (isChannelName model chan) then
                model

            else
                let
                    key =
                        ircCaseKey model chan
                in
                case Dict.get key model.channels of
                    Nothing ->
                        -- A 353 is a roster reply, not a JOIN: a delayed
                        -- reply after our PART must never recreate the room.
                        model

                    Just channel ->
                        let
                            nicks =
                                boundNamesTokens namesParam

                            prefixMap =
                                model.isupport.prefixToMode

                            burst =
                                recentNamesBurst model key

                            ( armed, base ) =
                                case burst of
                                    Just open ->
                                        if open.phase == BurstExpect then
                                            ( { model | namesBursts = Dict.insert key { open | phase = BurstAppending, at = model.nowMs } model.namesBursts }
                                            , Dict.empty
                                            )

                                        else
                                            ( model, channel.members )

                                    Nothing ->
                                        ( model, channel.members )

                            excluded =
                                Maybe.map .excluded burst |> Maybe.withDefault Set.empty

                            addNick rawNick acc =
                                let
                                    parsed =
                                        Wire.parseNamesPrefix rawNick prefixMap

                                    memberKey =
                                        ircCaseKey model parsed.nick
                                in
                                if not (validWireToken parsed.nick 256) || Set.member memberKey excluded then
                                    -- Hostile roster tokens (`:lead`,
                                    -- commas, overlongs) never plant
                                    -- members — mirroring the oracle
                                    -- per-nick gate.
                                    acc

                                else
                                    case Dict.get memberKey acc of
                                        Just member ->
                                            Dict.insert memberKey { member | modes = Set.union member.modes parsed.modes } acc

                                        Nothing ->
                                            if Dict.size acc >= maxLiveChannelUsers then
                                                acc

                                            else
                                                Dict.insert memberKey { nick = parsed.nick, modes = parsed.modes, away = False } acc
                        in
                        { armed | channels = Dict.insert key { channel | members = List.foldl addNick base nicks } armed.channels }


{-| Append one live system row without touching unread (mirroring
the oracle's direct `_appendBoundedChannelMessage` for membership
traffic — those rows never count). -}
appendLiveRow : Model -> String -> String -> Wire.IrcMessage -> Model
appendLiveRow model channel body message =
    updateChannel { model | messageSeq = model.messageSeq + 1 } channel
        (\c ->
            { c
                | messages =
                    List.take (messageRetentionFor model channel)
                        ({ id = model.messageSeq
                         , from = ""
                         , body = body
                         , whisper = False
                         , audience = Nothing
                         , highlight = False
                         , outboxId = Nothing
                         , pending = False
                         , plaintext = Nothing
                         , at = rowTime model message
                         , msgid = msgidOf message
                         , reactions = []
                         , edited = False
                         , deleted = False
                         , redacted = False
                         , topic = ""
                          , msgType = "system"
                         , replyTo = Nothing
                         }
                            :: c.messages
                        )
            }
        )


foldJoin : Model -> Wire.IrcMessage -> Model
foldJoin model message =
    case message.params of
        chan :: _ ->
            let
                nick =
                    Maybe.withDefault "" message.nick
            in
            if not (validWireToken chan 512) || not (isChannelName model chan) || not (validWireToken nick 256) then
                -- Invalid channels (`:lead`, lists) and invalid nicks
                -- seed nothing — mirroring the oracle break, so a
                -- hostile JOIN can neither plant members nor conjure
                -- rooms.
                model

            else if ircCaseKey model nick == ircCaseKey model model.ourNick then
                -- Our own JOIN creates the room but writes no row and
                -- logs no event (mirroring the oracle self branch) —
                -- the buffer stays empty so join backfill still fires.
                -- A self-JOIN after a settled burst starts a new
                -- membership generation (tombstones drop); either way
                -- the server's automatic NAMES is armed to replace.
                let
                    joined =
                        updateChannel model chan
                            (\c ->
                                if Dict.member (ircCaseKey model nick) c.members then
                                    c

                                else
                                    { c | members = Dict.insert (ircCaseKey model nick) { nick = nick, modes = Set.empty, away = False } c.members }
                            )

                    key =
                        ircCaseKey model chan

                    generation =
                        case recentNamesBurst joined key of
                            Just burst ->
                                if burst.phase == BurstSettled then
                                    { joined | namesBursts = Dict.remove key joined.namesBursts, lastRosterRefresh = Dict.remove key joined.lastRosterRefresh }

                                else
                                    includeBurstNick joined chan nick

                            Nothing ->
                                includeBurstNick joined chan nick
                in
                beginNamesBurst generation chan

            else
                case Dict.get (ircCaseKey model chan) model.channels of
                    Nothing ->
                        -- A stranger's JOIN for a room outside the live
                        -- session seeds nothing.
                        model

                    Just channel ->
                        if Dict.member (ircCaseKey model nick) channel.members then
                            includeBurstNick model chan nick

                        else
                            includeBurstNick
                                (addChannelEvent
                                    (appendLiveRow
                                            (updateChannel model chan
                                            (\c -> { c | members = Dict.insert (ircCaseKey model nick) { nick = nick, modes = Set.empty, away = False } c.members })
                                        )
                                        chan
                                        (nick ++ " joined")
                                        message
                                    )
                                    chan
                                    EventJoin
                                    nick
                                    (nick ++ " joined")
                                )
                                chan
                                nick

        [] ->
            model


{-| Fetch recent history on our own JOIN (mirroring the oracle's
unconditional `loadHistory` kick plus `MARKREAD` when negotiated:
single flight, exhausted-aware, cap-gated; `CHATHISTORY LATEST
<target> * 50`). Retained scrollback never suppresses the refresh —
only an in-flight fetch, proven exhaustion, an open batch, or a
server-search-owned target skips it. Without the capability the
target marks exhausted immediately (mirroring `setHistoryExhausted`),
so later joins skip a fetch that could never run. -}
requestJoinHistory : Model -> String -> ( Model, List Outbound )
requestJoinHistory model target =
    let
        key =
            ircCaseKey model target
    in
    if not (hasChatHistoryCap model) then
        ( { model | historyExhausted = Set.insert key model.historyExhausted }, [] )

    else
        fetchJoinHistory model target key


{-| Send one join-triggered backfill fetch unless a fetch is already
open, the target proved exhausted, or the pending server search
owns it (mirroring the `requestHistory` early returns). -}
fetchJoinHistory : Model -> String -> String -> ( Model, List Outbound )
fetchJoinHistory model target key =
    if Set.member key model.historyLoading || Set.member key model.historyExhausted || historyBatchOpenFor model key || serverSearchOwnsTarget model target then
        ( model, [] )

    else
        let
            markRead =
                if Session.hasCapability model.caps "draft/read-marker" then
                    [ SendLine (Wire.formatIrcLine "MARKREAD" [ target ]) ]

                else
                    []
        in
        ( { model
            | historyLoading = Set.insert key model.historyLoading
            , pendingHistoryRequests = Dict.insert (String.toLower target) { direction = HistoryLatestRequest, connectionGeneration = model.physicalConnectionGeneration } model.pendingHistoryRequests
          }
        , markRead ++ [ SendLine (Wire.formatIrcLine "CHATHISTORY" [ "LATEST", target, "*", String.fromInt historyPageSize ]) ]
        )


{-| Active named conversation for a channel, if any (mirrors
`activeChannelTopics`: the validated registry label). -}
activeChannelTopic : Model -> String -> Maybe String
activeChannelTopic model channel =
    Dict.get (ircCaseKey model channel) model.activeChannelTopics


{-| Whether the forum stays open for a room (mirroring oracle
`forumPinned`: the open channel with its lowercase name in the
forum set). -}
forumPinnedFor : Model -> String -> Bool
forumPinnedFor model channel =
    Set.member (ircCaseKey model channel) model.forumChannels


{-| Whether the follow toggle reads active (mirroring oracle
`followActive`: the channel plus its active topic, if any, is
followed). -}
followActiveFor : Model -> String -> Bool
followActiveFor model channel =
    Set.member (followKey channel (activeChannelTopic model channel)) model.followed


{-| Whether one forum card reads followed (mirroring oracle
`topicFollowed`: the open channel plus the card's topic). -}
topicFollowedFor : Model -> String -> String -> Bool
topicFollowedFor model channel topic =
    Set.member (followKey channel (Just topic)) model.followed


{-| `onyx/topic` send tag for the target's active conversation
(mirrors `topicMessageTag`: channels only, validated labels). -}
topicTagFor : Model -> String -> Dict String String
topicTagFor model target =
    if not (isChannelName model target) then
        Dict.empty

    else
        case activeChannelTopic model target of
            Nothing ->
                Dict.empty

            Just label ->
                case topicMessageTag label of
                    Just tag ->
                        Dict.singleton "onyx/topic" tag

                    Nothing ->
                        Dict.empty


{-| `onyx/topic` tag value for a label (mirrors
`topicMessageTag`: valid labels pass through, others refuse). -}
topicMessageTag : String -> Maybe String
topicMessageTag label =
    if isValidTopicLabel label then
        Just label

    else
        Nothing


{-| Resolve a requested named conversation (mirrors
`resolveKnownChannelTopic`: registry hit keeps canonical case,
else a retained message topic, else nothing falls back to the
whole room). -}
resolveKnownChannelTopic : Model -> String -> String -> Maybe String
resolveKnownChannelTopic model channel requested =
    let
        clean =
            String.trim requested
    in
    if not (isValidTopicLabel clean) then
        Nothing

    else
        let
            key =
                String.toLower channel

            wanted =
                String.toLower clean

            registry =
                Maybe.withDefault [] (Dict.get key model.topicHistory)
        in
        case List.filter (\t -> String.toLower t == wanted) registry of
            found :: _ ->
                Just found

            [] ->
                case Dict.get key model.channels of
                    Nothing ->
                        Nothing

                    Just ch ->
                        List.foldl
                            (\m found ->
                                case found of
                                    Just _ ->
                                        found

                                    Nothing ->
                                        let
                                            t =
                                                String.trim m.topic
                                        in
                                        if isValidTopicLabel t && String.toLower t == wanted then
                                            Just t

                                        else
                                            Nothing
                            )
                            Nothing
                            ch.messages


{-| Rows visible under the active conversation (mirrors the
oracle topic filter: no selection shows everything; a selection
shows only matching rows). -}
topicVisibleRows : Model -> String -> List ChatMessage -> List ChatMessage
topicVisibleRows model channel rows =
    case activeChannelTopic model channel of
        Nothing ->
            rows

        Just selected ->
            let
                wanted =
                    String.toLower (String.trim selected)
            in
            List.filter (\m -> not (String.isEmpty (String.trim m.topic)) && String.toLower (String.trim m.topic) == wanted) rows


{-| History reference for a rewind fetch (mirrors
`historyReference`: server msgids anchor with `msgid=`; local-only
rows anchor with their stamp). -}
historyReferenceRow : ChatMessage -> String
historyReferenceRow row =
    case row.msgid of
        Just id ->
            if String.startsWith "msgid=" id || String.startsWith "timestamp=" id then
                id

            else
                "msgid=" ++ id

        Nothing ->
            "timestamp=" ++ millisToIso (toFloat row.at)


{-| Fetch older history on scroll-up (mirrors the oracle
`loadHistory(target, before)`: server-search-owned, in-flight, and
exhausted targets skip; without the capability the target marks
exhausted immediately; otherwise `CHATHISTORY BEFORE <target>
<reference> 50` anchored at the oldest buffered row). -}
requestRewindHistory : Model -> String -> ( Model, List Outbound )
requestRewindHistory model target =
    let
        key =
            String.toLower target
    in
    if model.connection /= Live || serverSearchOwnsTarget model target || Set.member key model.historyLoading || Set.member key model.historyExhausted then
        ( model, [] )

    else if not (hasChatHistoryCap model) then
        ( { model | historyExhausted = Set.insert key model.historyExhausted }, [] )

    else
        case Dict.get key model.channels of
            Nothing ->
                ( model, [] )

            Just channel ->
                case List.head (List.reverse channel.messages) of
                    Nothing ->
                        ( model, [] )

                    Just oldest ->
                        ( { model
                            | historyLoading = Set.insert key model.historyLoading
                            , pendingHistoryRequests = Dict.insert key { direction = HistoryBeforeRequest, connectionGeneration = model.physicalConnectionGeneration } model.pendingHistoryRequests
                          }
                        , [ SendLine (Wire.formatIrcLine "CHATHISTORY" [ "BEFORE", target, historyReferenceRow oldest, String.fromInt historyPageSize ]) ]
                        )


{-| Fetch history after the newest locally accepted row. This is an explicit
catch-up path distinct from LATEST and BEFORE; the server's timestamp paging
may still omit equal-time rows, so the UI does not describe this as a complete
reconciliation proof.
-}
requestCatchUpHistory : Model -> String -> ( Model, List Outbound )
requestCatchUpHistory model target =
    let
        key = String.toLower target
    in
    if model.connection /= Live || not (hasChatHistoryCap model) || serverSearchOwnsTarget model target || Set.member key model.historyLoading || historyBatchOpenFor model key then
        ( model, [] )
    else
        case Dict.get key model.channels |> Maybe.andThen (.messages >> List.head) of
            Nothing ->
                requestJoinHistory model target

            Just newest ->
                ( { model
                    | historyLoading = Set.insert key model.historyLoading
                    , pendingHistoryRequests = Dict.insert key { direction = HistoryAfterRequest, connectionGeneration = model.physicalConnectionGeneration } model.pendingHistoryRequests
                  }
                , [ SendLine (Wire.formatIrcLine "CHATHISTORY" [ "AFTER", target, historyReferenceRow newest, String.fromInt historyPageSize ]) ]
                )


{-| Request the interval between the oldest and newest loaded message. The
server may still return an incomplete interval for equal-time pagination; the
caller keeps that limitation visible and does not claim a closed gap.
-}
requestHistoryBetween : Model -> String -> ( Model, List Outbound )
requestHistoryBetween model target =
    let
        key = String.toLower target
    in
    if model.connection /= Live || not (hasChatHistoryCap model) || serverSearchOwnsTarget model target || Set.member key model.historyLoading || historyBatchOpenFor model key then
        ( model, [] )
    else
        case Dict.get key model.channels of
            Nothing ->
                ( model, [] )

            Just channel ->
                case ( List.head channel.messages, List.reverse channel.messages |> List.head ) of
                    ( Just oldest, Just newest ) ->
                        if oldest.msgid == newest.msgid && oldest.at == newest.at then
                            ( model, [] )
                        else
                            ( { model
                                | historyLoading = Set.insert key model.historyLoading
                                , pendingHistoryRequests = Dict.insert key { direction = HistoryBetweenRequest, connectionGeneration = model.physicalConnectionGeneration } model.pendingHistoryRequests
                              }
                            , [ SendLine (Wire.formatIrcLine "CHATHISTORY" [ "BETWEEN", target, historyReferenceRow oldest, historyReferenceRow newest, String.fromInt historyPageSize ]) ]
                            )

                    _ ->
                        ( model, [] )


{-| Fetch one pinned message's window (mirrors `requestPinnedMessage`.
The `CHATHISTORY AROUND msgid=` send uses the same single-flight
guards plus a pending-travel and pending-pin check; a refused send
leaves no pending pin behind, like the oracle `admitted == false` path.
-}
requestPinnedMessage : Model -> String -> String -> ( Model, List Outbound )
requestPinnedMessage model channel messageId =
    let
        target =
            String.trim channel

        pinId =
            String.trim messageId

        key =
            String.toLower target

        pendingTravelKey =
            Maybe.map .target model.pendingTravel
    in
    if String.isEmpty target
        || not (isChannelName model target)
        || not (validWireToken target maxVaultTargetLength)
        || not (Dict.member key model.channels)
        || String.isEmpty pinId
        || pinId /= messageId
        || not (validWireToken pinId maxVaultMessageIdLength)
        || not (hasChatHistoryCap model)
        || Set.member key model.historyLoading
        || historyBatchOpenFor model key
        || pendingTravelKey == Just key
        || Dict.member key model.pendingPins
        || Dict.size model.historyBatches >= maxHistoryBatches then
        ( model, [] )

    else
        ( { model
            | pendingPins = Dict.insert key pinId model.pendingPins
            , historyLoading = Set.insert key model.historyLoading
            , pendingHistoryRequests = Dict.insert key { direction = HistoryAroundRequest, connectionGeneration = model.physicalConnectionGeneration } model.pendingHistoryRequests
          }
        , [ SendLine (Wire.formatIrcLine "CHATHISTORY" [ "AROUND", target, "msgid=" ++ pinId, String.fromInt historyPageSize ]) ]
        )


{-| PART names comma-separated channels sharing one reason
(contract v2 `presence.part`): withdraw exactly the named channels.
-}
foldPart : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldPart model message =
    case message.params of
        chan :: rest ->
            let
                nick =
                    Maybe.withDefault "" message.nick

                reason =
                    boundSystemEventText (Maybe.withDefault "" (List.head rest))
            in
            if not (validWireToken chan 512) || not (isChannelName model chan) || not (validWireToken nick 256) then
                -- A channel list (`#a,#b`), a non-channel, or an
                -- invalid nick drops the whole line — mirroring the
                -- oracle break (never a per-channel split).
                ( model, [] )

            else
                let
                    key =
                        String.toLower chan
                in
                if String.toLower nick == String.toLower model.ourNick then
                    -- Our own PART drops the whole room and
                    -- deactivates it (mirroring the oracle self
                    -- branch, including the join-scoped ACCESS
                    -- release) — no row, no event — and drops the
                    -- activity stream opt-in like the oracle
                    -- UNSUBSCRIBE.
                    let
                        access =
                            model.access

                        dropped =
                            { model
                                | channels = Dict.remove key model.channels
                                , firstUnreadId = Dict.remove key model.firstUnreadId
                                , namesBursts = Dict.remove key model.namesBursts
                                , lastRosterRefresh = Dict.remove key model.lastRosterRefresh
                                , activeChannel =
                                    case model.activeChannel of
                                        Just active ->
                                            if String.toLower active == key then
                                                Nothing

                                            else
                                                model.activeChannel

                                        Nothing ->
                                            Nothing
                                , access =
                                    { access
                                        | lists = Dict.remove key access.lists
                                        , buffers = Dict.remove key access.buffers
                                        , loading = Set.remove key access.loading
                                    }
                            }
                    in
                    case activitySubscribeLine "UNSUBSCRIBE" chan of
                        Just line ->
                            ( dropped, [ SendLine line ] )

                        Nothing ->
                            ( dropped, [] )

                else
                    case Dict.get key model.channels of
                        Just channel ->
                            if Dict.member (String.toLower nick) channel.members then
                                ( excludeBurstNick
                                    (addChannelEvent
                                        (appendLiveRow
                                            { model
                                                | channels =
                                                    Dict.insert key
                                                        { channel | members = Dict.remove (String.toLower nick) channel.members }
                                                        model.channels
                                            }
                                            chan
                                            (partEventText nick reason)
                                            message
                                        )
                                        chan
                                        EventPart
                                        nick
                                        (partEventText nick reason)
                                    )
                                    chan
                                    nick
                                , []
                                )

                            else
                                ( model, [] )

                        Nothing ->
                            ( model, [] )

        [] ->
            ( model, [] )


{-| PART event text (`X left (reason)` / `X left`). -}
partEventText : String -> String -> String
partEventText nick reason =
    if String.isEmpty reason then
        nick ++ " left"

    else
        nick ++ " left (" ++ reason ++ ")"


{-| QUIT is identity-wide (contract v2 `presence.quit`): one QUIT
withdraws the nick from every channel.
-}
foldQuit : Model -> Wire.IrcMessage -> Model
foldQuit model message =
    case message.nick of
        Nothing ->
            model

        Just nick ->
            let
                reason =
                    boundSystemEventText (Maybe.withDefault "" (List.head message.params))

                drop key acc =
                    case Dict.get key acc.channels of
                        Just channel ->
                            if Dict.member (String.toLower nick) channel.members then
                                excludeBurstNick
                                    (addChannelEvent
                                        (appendLiveRow
                                            { acc
                                                | channels =
                                                    Dict.insert key
                                                        { channel | members = Dict.remove (String.toLower nick) channel.members }
                                                        acc.channels
                                            }
                                            channel.name
                                            (quitRowText nick reason)
                                            message
                                        )
                                        channel.name
                                        EventQuit
                                        nick
                                        (quitEventText nick reason)
                                    )
                                    channel.name
                                    nick

                            else
                                acc

                        Nothing ->
                            acc
            in
            List.foldl drop model (Dict.keys model.channels)


{-| QUIT event text (`X quit (reason)` / `X quit`). -}
quitEventText : String -> String -> String
quitEventText nick reason =
    if String.isEmpty reason then
        nick ++ " quit"

    else
        nick ++ " quit (" ++ reason ++ ")"


{-| QUIT row text (`X quit: reason` / `X quit` — the row keeps the
colon form while the event parenthesizes). -}
quitRowText : String -> String -> String
quitRowText nick reason =
    if String.isEmpty reason then
        nick ++ " quit"

    else
        nick ++ " quit: " ++ reason


{-| A server-enforced guest nick: `Guest<digits>` (case-insensitive,
digits required — bare `Guest` is just a nick). -}
isGuestNick : String -> Bool
isGuestNick nick =
    let
        lower =
            String.toLower nick

        suffix =
            String.dropLeft 5 lower
    in
    String.startsWith "guest" lower
        && not (String.isEmpty suffix)
        && String.all Char.isDigit suffix


{-| Whether a self-rename is nick ENFORCEMENT: the new nick is a
guest nick the old one was not (mirroring the oracle
`forcedGuest` test — a Guest→Guest change is not enforcement).
-}
forcedGuestRename : String -> String -> Bool
forcedGuestRename oldNick newNick =
    isGuestNick newNick && not (isGuestNick oldNick)


{-| Nick reclaim retry cadence (mirroring the oracle 30s interval:
a zombie session may not read dead yet when the first NICK lands).
-}
nickReclaimIntervalMs : Float
nickReclaimIntervalMs =
    30000


{-| (Re)arm nick reclaim for `desired`: when still on an alias nick
it sends NICK at once and retries on the Tick until the zombie
releases it; otherwise any running reclaim stops (mirroring
`_startNickReclaim` / the `_stopNickReclaim` else-branch).
-}
startNickReclaim : Model -> String -> ( Model, List Outbound )
startNickReclaim model desired =
    if model.currentNickIsAlias && String.toLower model.ourNick /= String.toLower desired then
        ( { model
            | nickReclaimTarget = Just desired
            , nickReclaimDueMs = model.nowMs + nickReclaimIntervalMs
          }
        , [ SendLine (Wire.formatIrcLine "NICK" [ desired ]) ]
        )

    else
        ( { model | nickReclaimTarget = Nothing }, [] )


{-| Stop a running reclaim (self-NICK, logout, disconnect). -}
stopNickReclaim : Model -> Model
stopNickReclaim model =
    { model | nickReclaimTarget = Nothing }


{-| Fire a due reclaim retry on the Tick (mirroring the interval
body: sends while still aliased, stops itself the moment the flag
clears, stays quiet offline).
-}
fireNickReclaim : Model -> ( Model, List Outbound )
fireNickReclaim model =
    case model.nickReclaimTarget of
        Nothing ->
            ( model, [] )

        Just desired ->
            if model.connection /= Live then
                ( model, [] )

            else if not model.currentNickIsAlias then
                ( stopNickReclaim model, [] )

            else if model.nowMs < model.nickReclaimDueMs then
                ( model, [] )

            else
                ( { model | nickReclaimDueMs = model.nowMs + nickReclaimIntervalMs }
                , [ SendLine (Wire.formatIrcLine "NICK" [ desired ]) ]
                )


{-| Latest error notification text, newest-first — mirroring the
connect form's `lastErrorText` scan that detects a nick-in-use
without touching the store.
-}
lastErrorText : Model -> String
lastErrorText model =
    List.foldl
        (\note acc ->
            if note.kind == NotifError then
                note.text

            else
                acc
        )
        ""
        model.notifications


{-| Whether `text` reports a nick-in-use (`/nick(?:name)?\s+in\s+use/i`
in the oracle): lowercased, whitespace runs squashed, then either
spelling. `String.words` splits on every whitespace run, so tabs and
newlines collapse exactly like `\s+`.
-}
nickInUsePhrase : String -> Bool
nickInUsePhrase text =
    let
        squashed =
            String.words (String.toLower text) |> String.join " "
    in
    String.contains "nick in use" squashed || String.contains "nickname in use" squashed


{-| Whether our nick is taken: parked on an alias (or a forced guest
nick, which also sets the alias flag) or the latest error says so —
mirroring the oracle `nickInUse` memo behind the reclaim dialog.
-}
nickInUse : Model -> Bool
nickInUse model =
    model.currentNickIsAlias || nickInUsePhrase (lastErrorText model)


{-| The nick a reclaim would take back: the account nick while parked
on an alias. The connect form reclaims its typed nick pre-connect;
Elm auto-connects, so the in-session equivalent is the authenticated
(or SASL-announced) account nick — never a stranger's name from an
error line.
-}
reclaimTarget : Model -> Maybe String
reclaimTarget model =
    if not model.currentNickIsAlias then
        Nothing

    else
        case model.accountName of
            Just account ->
                if String.isEmpty account then
                    model.saslAccount

                else
                    Just account

            Nothing ->
                model.saslAccount


{-| Submit the reclaim dialog: GHOST the stale holder and NICK to the
account nick at once (reusing `reclaimNickWithPassword`, the Elm form
of the oracle `reclaimNick`), arm the 30s NICK retry the 900 path
would have armed, then close and forget the password. Empty passwords
and dead sockets are silent no-ops — the button is disabled there,
and offline lines would be phantoms. A missing target closes without
sending: there is nothing to take back.
-}
submitReclaim : Model -> ( Model, List Outbound )
submitReclaim model =
    if not model.reclaimOpen then
        ( model, [] )

    else
        case reclaimTarget model of
            Nothing ->
                ( { model | reclaimOpen = False, reclaimPassword = "" }, [] )

            Just target ->
                if String.isEmpty (String.trim model.reclaimPassword) then
                    ( model, [] )

                else
                    case reclaimNickWithPassword model target (String.trim model.reclaimPassword) of
                        [] ->
                            ( model, [] )

                        lines ->
                            ( { model
                                | nickReclaimTarget = Just target
                                , nickReclaimDueMs = model.nowMs + nickReclaimIntervalMs
                                , reclaimOpen = False
                                , reclaimPassword = ""
                              }
                            , lines
                            )


{- Guest claim flow, mirroring `GuestClaimPrompt.tsx` + the
`registerAccount` / `verifyAccount` store actions: a guest (no authed
account) already chatting gets a dismissible chip offering to keep the
nick; the sheet runs `REGISTER nick email|* password` → optional
`VERIFY nick code` → `IDENTIFY nick password` on the live socket, never
disconnecting.

Wire replies arrive as bare `REGISTER SUCCESS|VERIFICATION_REQUIRED`
and `VERIFY SUCCESS` commands (the server sends no NOTICE-plane
register replies) and as terminal `FAIL REGISTER|VERIFY` standard
replies. Both gate on a live attempt context (`registerReplyAccount`
/ `verifyReplyAccount`, the Elm analog of the oracle's
transport-currency check) so stray replies never flip
`registerPending`.

The phase machine mirrors the prompt's `ClaimPhase`: the sheet submits
REGISTER, captures nick + password (never re-read live, and forgotten
on reset), VERIFICATION_REQUIRED promotes to verifying, VERIFY SUCCESS
IDENTIFies once (`guestClaimIdentifyIssued` guards the double), and 900
closes + resets while a FAIL IDENTIFY drops back to idle. Busy (pending
or identifying) refuses sheet dismiss, mirroring the Sheet guard.

Chip dismissal persists per owner through the `guest-claim-dismissed`
ports slot (`onyx:guest-claim-dismissed` + owner suffix, mirroring the
oracle key). A guest first-hour handoff hides the chip until that
session is finished (`shouldSuppressGuestClaim` in
`src/lib/firstHour/firstHour.ts`).
-}
type GuestClaimPhase
    = ClaimIdle
    | ClaimRegistering
    | ClaimVerifying
    | ClaimIdentifying


guestClaimMinPassword : Int
guestClaimMinPassword =
    8


isGuestClaimBusy : Model -> Bool
isGuestClaimBusy model =
    model.registerPending || model.guestClaimPhase == ClaimIdentifying


guestClaimVisible : Model -> Bool
guestClaimVisible model =
    model.accountName == Nothing
        && not model.guestClaimDismissed
        && not (String.isEmpty (String.trim model.ourNick))
        && not (FirstHour.shouldSuppressGuestClaim model.firstHourSeen model.firstHourHandoff)


resetGuestClaim : Model -> Model
resetGuestClaim model =
    { model
        | guestClaimPhase = ClaimIdle
        , guestClaimOpen = False
        , guestClaimEmail = ""
        , guestClaimPassword = ""
        , guestClaimVerifyCode = ""
        , guestClaimNick = ""
        , guestClaimPasswordHeld = ""
        , guestClaimIdentifyIssued = False
        , guestClaimError = Nothing
    }


requestRegister : Model -> String -> String -> String -> ( Model, List Outbound )
requestRegister model account email password =
    let
        acct =
            String.trim account

        mail =
            String.trim email

        mailParam =
            if String.isEmpty mail then
                "*"

            else
                mail
    in
    if model.connection /= Live then
        ( model, [] )

    else if String.isEmpty acct || String.isEmpty password then
        ( model, [] )

    else
        case Services.register acct mailParam password of
            Nothing ->
                ( model, [] )

            Just line ->
                ( { model
                    | registerPending = True
                    , registerError = Nothing
                    , verifyRequired = False
                    , registerReplyAccount = Just acct
                  }
                , [ SendLine line ]
                )


requestVerify : Model -> String -> String -> ( Model, List Outbound )
requestVerify model account code =
    let
        acct =
            String.trim account

        trimmed =
            String.trim code
    in
    if model.connection /= Live then
        ( model, [] )

    else if String.isEmpty acct || String.isEmpty trimmed then
        ( model, [] )

    else
        case Services.verifyCode acct trimmed of
            Nothing ->
                ( model, [] )

            Just line ->
                ( { model
                    | registerPending = True
                    , registerError = Nothing
                    , verifyReplyAccount = Just acct
                  }
                , [ SendLine line ]
                )


chainClaimIdentify : Model -> ( Model, List Outbound )
chainClaimIdentify model =
    if model.guestClaimIdentifyIssued then
        ( model, [] )

    else if String.isEmpty model.guestClaimNick || String.isEmpty model.guestClaimPasswordHeld then
        ( { model | guestClaimError = Just "Missing credentials for sign-in after registration.", guestClaimPhase = ClaimIdle }, [] )

    else
        let
            ( identified, out ) =
                requestIdentify model model.guestClaimNick model.guestClaimPasswordHeld
        in
        if List.isEmpty out then
            ( { model | guestClaimError = Just "Reconnect required — the connection was lost before sign-in could start.", guestClaimPhase = ClaimIdle }, [] )

        else
            ( { identified | guestClaimPhase = ClaimIdentifying, guestClaimIdentifyIssued = True }, out )


{-| Fold a bare `REGISTER <sub>` command (mirrors the oracle arm:
the server reports `REGISTER SUCCESS <account>` as a command, not a
notice — the earlier NOTICE-plane shape matched nothing the server
sends. A context-less reply is ignored; SUCCESS clears the pending
leg (chaining IDENTIFY for a live claim), VERIFICATION_REQUIRED
promotes to verifying).
-}
foldRegisterCommand : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldRegisterCommand model message =
    case model.registerReplyAccount of
        Nothing ->
            ( model, [] )

        Just _ ->
            case message.params of
                sub :: _ ->
                    case String.toUpper sub of
                        "SUCCESS" ->
                            let
                                settled =
                                    { model | registerPending = False, registerError = Nothing, verifyRequired = False, registerReplyAccount = Nothing }
                            in
                            if model.guestClaimPhase == ClaimRegistering then
                                chainClaimIdentify settled

                            else
                                ( settled, [] )

                        "VERIFICATION_REQUIRED" ->
                            let
                                settled =
                                    { model | registerPending = False, registerError = Nothing, verifyRequired = True, registerReplyAccount = Nothing }
                            in
                            if model.guestClaimPhase == ClaimRegistering then
                                ( { settled | guestClaimPhase = ClaimVerifying }, [] )

                            else
                                ( settled, [] )

                        _ ->
                            ( model, [] )

                _ ->
                    ( model, [] )


{-| Fold a bare `VERIFY SUCCESS` command (mirrors the oracle arm: a
context-less reply is ignored; SUCCESS clears the pending leg,
chaining IDENTIFY for a live verification).
-}
foldVerifyCommand : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldVerifyCommand model message =
    case model.verifyReplyAccount of
        Nothing ->
            ( model, [] )

        Just _ ->
            case message.params of
                sub :: _ ->
                    if String.toUpper sub /= "SUCCESS" then
                        ( model, [] )

                    else
                        let
                            settled =
                                { model | registerPending = False, registerError = Nothing, verifyRequired = False, verifyReplyAccount = Nothing }
                        in
                        if model.guestClaimPhase == ClaimVerifying then
                            chainClaimIdentify settled

                        else
                            ( settled, [] )

                _ ->
                    ( model, [] )


{-| Fold an inbound `INVITE <invitee> <channel>` (mirrors the oracle
arm: an empty channel stays silent; an invite for our nick raises a
system inbox notification, otherwise the channel gains a join event
for context).
-}
foldInvite : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldInvite model message =
    case message.params of
        invitee :: channel :: _ ->
            if String.isEmpty channel then
                ( model, [] )

            else
                let
                    inviter =
                        Maybe.withDefault "someone" message.nick
                in
                if String.toLower invitee == String.toLower model.ourNick then
                    ( addNotification model
                        { kind = NotifSystem
                        , text = inviter ++ " invited you to " ++ channel
                        , from = Just inviter
                        , channel = Just channel
                        , topic = Nothing
                        }
                    , []
                    )

                else
                    ( addChannelEvent model channel EventJoin inviter (inviter ++ " invited " ++ invitee ++ " to " ++ channel)
                    , []
                    )

        _ ->
            ( model, [] )


{-| Admit one `308 RPL_RULES` line (mirrors the oracle arm: the last
param carries the rule text, bounded like other system text, capped
at 256 lines).
-}
maxServerRuleLines : Int
maxServerRuleLines =
    256


admitServerRule : Model -> String -> ( Model, List Outbound )
admitServerRule model line =
    let
        bounded =
            boundSystemEventText line
    in
    if String.isEmpty bounded then
        ( model, [] )

    else if List.length model.serverRules >= maxServerRuleLines then
        ( model, [] )

    else
        ( { model | serverRules = model.serverRules ++ [ bounded ] }, [] )


{-| A presence-tracked friend (`FriendEntry`: nick, network-derived
online flag, optional note) and a WATCH-list entry (nick, online
flag, last-seen stamp), mirroring `contactPresenceMemory.ts`. The
oracle drives both from `MONITOR` traffic and persists them
owner-keyed; nothing in the oracle UI writes them yet either, so the
verbs below are the only writers on both sides.
-}
type alias FriendEntry =
    { nick : String
    , online : Bool
    , note : Maybe String
    }


type alias WatchEntry =
    { nick : String
    , online : Bool
    , lastSeenMs : Maybe Int
    }


maxContacts : Int
maxContacts =
    256


maxContactNickLength : Int
maxContactNickLength =
    128


maxFriendNoteLength : Int
maxFriendNoteLength =
    512


maxMonitorNumericTargets : Int
maxMonitorNumericTargets =
    256


maxMonitorNumericTargetLength : Int
maxMonitorNumericTargetLength =
    512


maxMonitorNumericLimit : Int
maxMonitorNumericLimit =
    1000000


maxMonitorNumericDescriptionLength : Int
maxMonitorNumericDescriptionLength =
    1024


{-| A character that may never appear in a MONITOR-tracked nick
(mirrors `UNSAFE_MONITOR_NICK`: whitespace, commas, C0 controls,
DEL — plus the non-ASCII spaces JS `\s` rejects, which Elm's
`Char` comparisons would otherwise admit).
-}
isUnsafeMonitorChar : Char -> Bool
isUnsafeMonitorChar c =
    let
        n =
            Char.toCode c
    in
    c <= ' '
        || c == ','
        || n == 127
        || n == 0xA0
        || n == 0x1680
        || (n >= 0x2000 && n <= 0x200A)
        || n == 0x2028
        || n == 0x2029
        || n == 0x202F
        || n == 0x205F
        || n == 0x3000
        || n == 0xFEFF


{-| Normalize a contact nick like `normalizedNick`: trim, then refuse
empties, overlongs, and monitor-unsafe characters.
-}
normalizeContactNick : String -> Maybe String
normalizeContactNick value =
    let
        nick =
            String.trim value
    in
    if String.isEmpty nick then
        Nothing

    else if String.length nick > maxContactNickLength then
        Nothing

    else if String.any isUnsafeMonitorChar nick then
        Nothing

    else
        Just nick


{-| Decode one stored friend record (mirrors `parseFriends`: nick
gate, lowercase-key dedupe, presence reset, verbatim note within
its bound).
-}
decodeFriendRecord : Decode.Value -> Maybe ( String, FriendEntry )
decodeFriendRecord value =
    case Decode.decodeValue (Decode.field "nick" Decode.string) value of
        Err _ ->
            Nothing

        Ok rawNick ->
            case normalizeContactNick rawNick of
                Nothing ->
                    Nothing

                Just nick ->
                    let
                        note =
                            case Decode.decodeValue (Decode.field "note" Decode.string) value of
                                Ok text ->
                                    if String.length text <= maxFriendNoteLength then
                                        Just text

                                    else
                                        Nothing

                                Err _ ->
                                    Nothing
                    in
                    Just ( String.toLower nick, { nick = nick, online = False, note = note } )


{-| Decode the persisted friends list (mirrors `parseFriends`:
non-arrays and over-cap tails stay dropped, first nick wins).
-}
decodeFriends : Decode.Value -> Dict String FriendEntry
decodeFriends value =
    case Decode.decodeValue (Decode.list Decode.value) value of
        Err _ ->
            Dict.empty

        Ok raws ->
            List.foldl
                (\raw acc ->
                    if Dict.size acc >= maxContacts then
                        acc

                    else
                        case decodeFriendRecord raw of
                            Just ( key, entry ) ->
                                if Dict.member key acc then
                                    acc

                                else
                                    Dict.insert key entry acc

                            Nothing ->
                                acc
                )
                Dict.empty
                raws


{-| Decode one stored WATCH record (mirrors `parseWatchList`: nick
gate, lowercase dedupe, presence reset, ISO last-seen within its
bound — Elm's ISO parser is strict-er than `Date`, so exotic date
spellings stay dropped, the standing date divergence).
-}
decodeWatchRecord : Decode.Value -> Maybe ( String, WatchEntry )
decodeWatchRecord value =
    case Decode.decodeValue (Decode.field "nick" Decode.string) value of
        Err _ ->
            Nothing

        Ok rawNick ->
            case normalizeContactNick rawNick of
                Nothing ->
                    Nothing

                Just nick ->
                    let
                        lastSeenMs =
                            case Decode.decodeValue (Decode.field "lastSeen" Decode.string) value of
                                Err _ ->
                                    Nothing

                                Ok text ->
                                    if String.length text > 64 then
                                        Nothing

                                    else
                                        Maybe.map floor (parseIso8601Ms text)
                    in
                    Just ( String.toLower nick, { nick = nick, online = False, lastSeenMs = lastSeenMs } )


{-| Decode the persisted WATCH list (mirrors `parseWatchList`).
-}
decodeWatchList : Decode.Value -> List WatchEntry
decodeWatchList value =
    case Decode.decodeValue (Decode.list Decode.value) value of
        Err _ ->
            []

        Ok raws ->
            List.foldl
                (\raw ( acc, seen ) ->
                    if List.length acc >= maxContacts then
                        ( acc, seen )

                    else
                        case decodeWatchRecord raw of
                            Just ( key, entry ) ->
                                if Set.member key seen then
                                    ( acc, seen )

                                else
                                    ( acc ++ [ entry ], Set.insert key seen )

                            Nothing ->
                                ( acc, seen )
                )
                ( [], Set.empty )
                raws
                |> Tuple.first


{-| Encode friends for the owner-keyed slot (mirrors `saveFriends`:
nick + note only — presence never persists).
-}
encodeFriendsForSave : Dict String FriendEntry -> String
encodeFriendsForSave friends =
    Encode.encode 0
        (Encode.list
            (\entry ->
                case entry.note of
                    Just note ->
                        Encode.object [ ( "nick", Encode.string entry.nick ), ( "note", Encode.string note ) ]

                    Nothing ->
                        Encode.object [ ( "nick", Encode.string entry.nick ) ]
            )
            (Dict.values friends)
        )


{-| Encode the WATCH list for its slot (mirrors `saveWatchList`:
nick + a persisted `online: false`).
-}
encodeWatchListForSave : List WatchEntry -> String
encodeWatchListForSave entries =
    Encode.encode 0
        (Encode.list
            (\entry ->
                Encode.object [ ( "nick", Encode.string entry.nick ), ( "online", Encode.bool False ) ]
            )
            entries
        )


{-| All contact-owned MONITOR targets: friends first, then watch
entries the friends do not already cover (mirrors
`_ownedMonitorContacts`).
-}
ownedMonitorContacts : Model -> List String
ownedMonitorContacts model =
    let
        friendNicks =
            List.map .nick (Dict.values model.friends)

        friendKeys =
            Set.fromList (List.map String.toLower friendNicks)

        watchNicks =
            List.filterMap
                (\entry ->
                    if Set.member (String.toLower entry.nick) friendKeys then
                        Nothing

                    else
                        Just entry.nick
                )
                model.watchList
    in
    friendNicks ++ watchNicks


{-| Subscribe one nick to MONITOR presence (mirrors `monitorAdd`: a
nick already tracked stays silent; the record lands even offline,
but the wire leg needs a live socket — the oracle's
`client?.sendRaw` equivalent).
-}
monitorAddContact : Model -> String -> ( Model, List Outbound )
monitorAddContact model nick =
    let
        key =
            String.toLower nick
    in
    if Set.member key model.monitoredNicks then
        ( model, [] )

    else
        let
            tracked =
                { model | monitoredNicks = Set.insert key model.monitoredNicks }
        in
        if model.connection /= Live then
            ( tracked, [] )

        else
            case Services.monitorAdd nick of
                Nothing ->
                    ( tracked, [] )

                Just line ->
                    ( tracked, [ SendLine line ] )


{-| Drop a MONITOR subscription the friends, the WATCH list, and the
DM shells no longer need (mirrors
`_removeMonitorContactIfUnused`: the `-` leg fires only while
live).
-}
removeMonitorContactIfUnused : Model -> String -> ( Model, List Outbound )
removeMonitorContactIfUnused model nick =
    let
        key =
            String.toLower nick

        stillWanted =
            Dict.member key model.friends
                || List.any (\entry -> String.toLower entry.nick == key) model.watchList
                || Dict.member key model.channels
    in
    if stillWanted then
        ( model, [] )

    else
        let
            untracked =
                { model | monitoredNicks = Set.remove key model.monitoredNicks }
        in
        if model.connection /= Live then
            ( untracked, [] )

        else
            case Services.monitorRemove nick of
                Nothing ->
                    ( untracked, [] )

                Just line ->
                    ( untracked, [ SendLine line ] )


{-| Persist the friends list to the owner's slot (mirrors
`saveFriends`: an empty list removes the key — `Nothing` tells the
bridge to remove instead of write).
-}
saveFriendsFor : DeviceMemoryOwner -> Dict String FriendEntry -> Outbound
saveFriendsFor owner friends =
    FriendsSave
        { serverUrl = owner.serverUrl
        , identity = owner.identity
        , entries =
            if Dict.isEmpty friends then
                Nothing

            else
                Just (encodeFriendsForSave friends)
        }


{-| Persist the WATCH list the same way (mirrors `saveWatchList`).
-}
saveWatchListFor : DeviceMemoryOwner -> List WatchEntry -> Outbound
saveWatchListFor owner entries =
    WatchListSave
        { serverUrl = owner.serverUrl
        , identity = owner.identity
        , entries =
            if List.isEmpty entries then
                Nothing

            else
                Just (encodeWatchListForSave entries)
        }


{-| Add a friend (mirrors `addFriend`: refused without an owner or
an unparseable nick; persists and subscribes on success).
-}
requestFriendAdd : Model -> String -> ( Model, List Outbound )
requestFriendAdd model nick =
    case deviceMemoryOwner model of
        Nothing ->
            ( model, [] )

        Just owner ->
            case normalizeContactNick nick of
                Nothing ->
                    ( model, [] )

                Just clean ->
                    let
                        key =
                            String.toLower clean

                        next =
                            Dict.insert key { nick = clean, online = False, note = Nothing } model.friends

                        ( tracked, monitorOut ) =
                            monitorAddContact { model | friends = next } clean
                    in
                    ( tracked, saveFriendsFor owner next :: monitorOut )


{-| Remove a friend (mirrors `removeFriend`: persists and releases
the MONITOR subscription when nothing else wants it).
-}
requestFriendRemove : Model -> String -> ( Model, List Outbound )
requestFriendRemove model nick =
    case deviceMemoryOwner model of
        Nothing ->
            ( model, [] )

        Just owner ->
            case normalizeContactNick nick of
                Nothing ->
                    ( model, [] )

                Just clean ->
                    let
                        next =
                            Dict.remove (String.toLower clean) model.friends

                        ( released, monitorOut ) =
                            removeMonitorContactIfUnused { model | friends = next } clean
                    in
                    ( released, saveFriendsFor owner next :: monitorOut )


{-| Add a WATCH entry (mirrors `addToWatchList`: duplicates and the
256-contact cap stay silent; persists and subscribes on success).
-}
requestWatchAdd : Model -> String -> ( Model, List Outbound )
requestWatchAdd model nick =
    case deviceMemoryOwner model of
        Nothing ->
            ( model, [] )

        Just owner ->
            case normalizeContactNick nick of
                Nothing ->
                    ( model, [] )

                Just clean ->
                    let
                        key =
                            String.toLower clean
                    in
                    if List.any (\entry -> String.toLower entry.nick == key) model.watchList then
                        ( model, [] )

                    else if List.length model.watchList >= maxContacts then
                        ( model, [] )

                    else
                        let
                            next =
                                model.watchList ++ [ { nick = clean, online = False, lastSeenMs = Nothing } ]

                            ( tracked, monitorOut ) =
                                monitorAddContact { model | watchList = next } clean
                        in
                        ( tracked, saveWatchListFor owner next :: monitorOut )


{-| Remove a WATCH entry (mirrors `removeFromWatchList`).
-}
requestWatchRemove : Model -> String -> ( Model, List Outbound )
requestWatchRemove model nick =
    case deviceMemoryOwner model of
        Nothing ->
            ( model, [] )

        Just owner ->
            case normalizeContactNick nick of
                Nothing ->
                    ( model, [] )

                Just clean ->
                    let
                        key =
                            String.toLower clean

                        next =
                            List.filter (\entry -> String.toLower entry.nick /= key) model.watchList

                        ( released, monitorOut ) =
                            removeMonitorContactIfUnused { model | watchList = next } clean
                    in
                    ( released, saveWatchListFor owner next :: monitorOut )


{-| Mark a friend online/offline (mirrors `setFriendOnline`:
unknown nicks stay untouched).
-}
setFriendOnline : Model -> String -> Bool -> Model
setFriendOnline model nick online =
    let
        key =
            String.toLower nick
    in
    case Dict.get key model.friends of
        Nothing ->
            model

        Just entry ->
            { model | friends = Dict.insert key { entry | online = online } model.friends }


{-| Mark a WATCH entry online/offline (mirrors `setWatchOnline`:
going online keeps the old stamp; going offline stamps the
supplied time, defaulting to now exactly like the oracle
`time ?? new Date()` — so `605` stamps now too).
-}
setWatchOnline : Model -> String -> Bool -> Maybe Int -> Model
setWatchOnline model nick online lastSeenMs =
    { model
        | watchList =
            List.map
                (\entry ->
                    if String.toLower entry.nick /= String.toLower nick then
                        entry

                    else
                        { entry
                            | online = online
                            , lastSeenMs =
                                if online then
                                    entry.lastSeenMs

                                else
                                    case lastSeenMs of
                                        Just _ ->
                                            lastSeenMs

                                        Nothing ->
                                            entry.lastSeenMs
                        }
                )
                model.watchList
    }


{-| Resubscribe this identity's contact-owned MONITOR targets
(mirrors `_replaceOwnedMonitorContacts`: `clearRemote` sends
`MONITOR C` first; one bounded nick per `+` leg; offline retires
the local subscriptions with no wire legs — a new socket owns no
server-side MONITOR state).
-}
syncMonitorContacts : Bool -> Model -> ( Model, List Outbound )
syncMonitorContacts clearRemote model =
    if model.connection /= Live then
        ( { model | monitoredNicks = Set.empty }, [] )

    else
        let
            base =
                ownedMonitorContacts model

            -- A same-owner reconnect restores DM presence watches opened
            -- during the prior connection: extras already tracked locally
            -- rejoin the union (mirroring the oracle's `!clearRemote`
            -- merge; an owner change quarantines first, so `True` needs
            -- no merge).
            contacts =
                if clearRemote then
                    base

                else
                    let
                        baseKeys =
                            Set.fromList (List.map String.toLower base)
                    in
                    base
                        ++ List.filter
                            (\key -> not (Set.member key baseKeys))
                            (Set.toList model.monitoredNicks)

            targets =
                List.filterMap
                    (\nick ->
                        case Services.monitorAdd nick of
                            Just line ->
                                Just ( nick, line )

                            Nothing ->
                                Nothing
                    )
                    contacts
        in
        ( { model | monitoredNicks = Set.fromList (List.map (String.toLower << Tuple.first) targets) }
        , (if clearRemote then
            [ SendLine Services.monitorClear ]

           else
            []
          )
            ++ List.map (\( _, line ) -> SendLine line) targets
        )


{-| Split a MONITOR numeric target list (mirrors
`parseMonitorTargets`: an overlong list or one bad entry voids the
whole list; duplicates collapse case-insensitively).
-}
parseMonitorTargets : String -> List String
parseMonitorTargets value =
    if String.isEmpty value then
        []

    else if String.length value > maxMonitorNumericTargets * (maxMonitorNumericTargetLength + 1) then
        []

    else
        let
            raws =
                String.split "," value
        in
        if List.length raws > maxMonitorNumericTargets then
            []

        else
            List.foldl
                (\raw acc ->
                    case acc of
                        Nothing ->
                            Nothing

                        Just ( seen, kept ) ->
                            let
                                target =
                                    String.trim raw
                            in
                            if String.isEmpty target then
                                Nothing

                            else if String.length target > maxMonitorNumericTargetLength then
                                Nothing

                            else if String.any isUnsafeMonitorChar target then
                                Nothing

                            else
                                let
                                    key =
                                        String.toLower target
                                in
                                if Set.member key seen then
                                    Just ( seen, kept )

                                else
                                    Just ( Set.insert key seen, kept ++ [ target ] )
                )
                (Just ( Set.empty, [] ))
                raws
                |> Maybe.map Tuple.second
                |> Maybe.withDefault []


{-| Parse an `ERR_MONLISTFULL` limit (mirrors `parseMonitorNumeric`:
ASCII digits without leading zeros, a safe integer within the
advertised cap).
-}
parseMonitorLimit : String -> Maybe Int
parseMonitorLimit raw =
    let
        digits =
            String.toList raw
    in
    if List.isEmpty digits then
        Nothing

    else if not (List.all (\c -> c >= '0' && c <= '9') digits) then
        Nothing

    else if List.length digits > 1 && List.head digits == Just '0' then
        Nothing

    else
        case String.toInt raw of
            Just n ->
                if n >= 0 && n <= maxMonitorNumericLimit then
                    Just n

                else
                    Nothing

            Nothing ->
                Nothing


{-| Fold `600`/`604` (WATCH/MONITOR online): the watched nick sits
at params[1], like the oracle arms.
-}
foldContactOnline : Model -> Wire.IrcMessage -> Model
foldContactOnline model message =
    case message.params of
        _ :: nick :: _ ->
            if String.isEmpty nick then
                model

            else
                setWatchOnline model nick True Nothing

        _ ->
            model


{-| Fold `601`/`605` offline: last-seen always stamps now
(mirroring the oracle `time ?? new Date()` default — a missing
stamp still means now, never the old stamp).
-}
foldContactOffline : Model -> Wire.IrcMessage -> Model
foldContactOffline model message =
    case message.params of
        _ :: nick :: _ ->
            if String.isEmpty nick then
                model

            else
                setWatchOnline model nick False (Just (floor model.nowMs))

        _ ->
            model


{-| DM-shell away bit for a nick that already has a conversation.
Unknown nicks and channel names are ignored, matching `store.ts`
which only updates `dms.get`. Online removes the bit.
-}
setDmShellAway : Model -> String -> Bool -> Model
setDmShellAway model nick away =
    let
        key =
            String.toLower (String.trim nick)
    in
    if String.isEmpty key || isChannelName model nick then
        model

    else
        case Dict.get key model.channels of
            Nothing ->
                model

            Just _ ->
                { model
                    | dmAway =
                        if away then
                            Dict.insert key True model.dmAway

                        else
                            Dict.remove key model.dmAway
                }


{-| Fold `730 RPL_MONONLINE`: every target's nick half clears to
online for known friends, and an existing DM shell drops its away
bit (`store.ts` sets `dm.away = false`).
-}
foldMonitorOnline : Model -> Wire.IrcMessage -> Model
foldMonitorOnline model message =
    case message.params of
        _ :: rawTargets :: _ ->
            List.foldl
                (\fullhost acc ->
                    let
                        nick =
                            firstOfBang fullhost
                    in
                    setDmShellAway (setFriendOnline acc nick True) nick False
                )
                model
                (parseMonitorTargets rawTargets)

        _ ->
            model


{-| Fold `731 RPL_MONOFFLINE` the same way, clearing presence and
marking an existing DM shell away (`store.ts` sets `dm.away = true`).
-}
foldMonitorOffline : Model -> Wire.IrcMessage -> Model
foldMonitorOffline model message =
    case message.params of
        _ :: rawTargets :: _ ->
            List.foldl
                (\monNick acc ->
                    setDmShellAway (setFriendOnline acc monNick False) monNick True
                )
                model
                (parseMonitorTargets rawTargets)

        _ ->
            model


{-| Nick half of a `nick!user@host` mask (the oracle splits on the
first `!`; a bare nick has no `!` and survives whole).
-}
firstOfBang : String -> String
firstOfBang fullhost =
    case String.split "!" fullhost of
        first :: _ ->
            first

        [] ->
            fullhost


{-| Fold `734 ERR_MONLISTFULL` (mirrors the oracle arm: the
configured limit renders when it parses, else the server
description — bounded like other error text — else the fallback).
-}
foldMonitorFull : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldMonitorFull model message =
    let
        description =
            String.left maxMonitorNumericDescriptionLength (trailingParam message.params)

        text =
            case Maybe.andThen parseMonitorLimit (secondParam message.params) of
                Just limit ->
                    "MONITOR list is full (" ++ String.fromInt limit ++ " targets)"

                Nothing ->
                    if String.isEmpty description then
                        "MONITOR list is full"

                    else
                        description
    in
    ( addNotification model { kind = NotifError, text = text, from = Nothing, channel = Nothing, topic = Nothing }
    , []
    )


foldRegisterFail : Model -> Wire.StandardReply -> ( Model, List Outbound )
foldRegisterFail model reply =
    let
        live =
            case String.toUpper reply.command of
                "REGISTER" ->
                    model.registerReplyAccount /= Nothing

                "VERIFY" ->
                    model.verifyReplyAccount /= Nothing

                _ ->
                    False
    in
    if not live then
        ( model, [] )

    else
        let
            description =
                if String.isEmpty reply.description then
                    reply.code

                else
                    reply.description
        in
        ( { model
            | registerPending = False
            , registerError = Just description
            , verifyRequired = False
            , registerReplyAccount = Nothing
            , verifyReplyAccount = Nothing
            , guestClaimPhase = ClaimIdle
          }
        , []
        )


submitGuestClaim : Model -> ( Model, List Outbound )
submitGuestClaim model =
    let
        nick =
            String.trim model.ourNick

        pass =
            model.guestClaimPassword
    in
    if String.isEmpty nick then
        ( { model | guestClaimError = Just "You need a name on this connection before claiming." }, [] )

    else if String.isEmpty pass then
        ( { model | guestClaimError = Just "Choose a password to protect the account." }, [] )

    else if String.length pass < guestClaimMinPassword then
        ( { model | guestClaimError = Just ("Use at least " ++ String.fromInt guestClaimMinPassword ++ " characters.") }, [] )

    else if model.connection /= Live then
        ( { model | guestClaimError = Just "Reconnect required — the connection was lost before registration could start." }, [] )

    else
        let
            ( sent, out ) =
                requestRegister model nick model.guestClaimEmail pass
        in
        if List.isEmpty out then
            ( { model | guestClaimError = Just "Reconnect required — the connection was lost before registration could start." }, [] )

        else
            ( { sent
                | guestClaimPhase = ClaimRegistering
                , guestClaimNick = nick
                , guestClaimPasswordHeld = pass
                , guestClaimIdentifyIssued = False
                , guestClaimError = Nothing
              }
            , out
            )


submitGuestVerify : Model -> ( Model, List Outbound )
submitGuestVerify model =
    let
        code =
            String.trim model.guestClaimVerifyCode

        nick =
            if String.isEmpty model.guestClaimNick then
                String.trim model.ourNick

            else
                model.guestClaimNick
    in
    if isGuestClaimBusy model then
        ( model, [] )

    else if String.isEmpty code then
        ( { model | guestClaimError = Just "Enter the verification code from your email." }, [] )

    else if String.isEmpty nick then
        ( { model | guestClaimError = Just "Missing name for verification." }, [] )

    else if model.connection /= Live then
        ( { model | guestClaimError = Just "Reconnect required — the connection was lost before verification could start." }, [] )

    else
        let
            ( sent, out ) =
                requestVerify model nick code
        in
        if List.isEmpty out then
            ( { model | guestClaimError = Just "Reconnect required — the connection was lost before verification could start." }, [] )

        else
            ( { sent | guestClaimPhase = ClaimVerifying, guestClaimIdentifyIssued = False, guestClaimError = Nothing }, out )


persistGuestClaimDismiss : Model -> List Outbound
persistGuestClaimDismiss model =
    case deviceMemoryOwner model of
        Nothing ->
            []

        Just owner ->
            [ GuestClaimDismissSave { serverUrl = owner.serverUrl, identity = owner.identity } ]


{-| `IDENTIFY <account> <password>` — in-session login for a nick that is
not yet authenticated (success returns as 900 `RPL_LOGGEDIN`, failure
as 464 or terminal `FAIL IDENTIFY`). Mirrors the oracle `identify`:
silent unless live with a trimmed non-empty account and a non-empty
password; clears the prior verdict and captures the reply account so
only the live attempt's 464/FAIL folds into `accountActionError`. The
context dies with the socket (`WsClosed`), on login (`foldAccount`),
and on the terminal reply — a later unrelated 464 can never be
misattributed. The guest claim sheet below supplies credentials
in-session through `submitGuestClaim`.
-}
{- Credential transparency: `KEYTRANS STATUS` / `KEYTRANS PROOF`
round-trips whose replies arrive on the NOTICE plane (mirrors the
oracle's `keyTransparencyStatus` / `keyTransparencyProof` plus the
`key-transparency` security-reply gate — presence-gated like TOTP,
so stray bodies never surface; the replies carry no client state,
only the service-log line).
-}
requestKeytransStatus : Model -> ( Model, List Outbound )
requestKeytransStatus model =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            if model.connection /= Live then
                ( model, [] )

            else
                ( { model | keytransReplyAccount = Just acct }
                , [ SendLine Services.keyTransparencyStatus ]
                )


{-| `KEYTRANS PROOF <position>` (mirrors `keyTransparencyProof`:
non-negative positions only).
-}
requestKeytransProof : Model -> Int -> ( Model, List Outbound )
requestKeytransProof model position =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            if model.connection /= Live then
                ( model, [] )

            else
                case Services.keyTransparencyProof position of
                    Nothing ->
                        ( model, [] )

                    Just line ->
                        ( { model | keytransReplyAccount = Just acct }
                        , [ SendLine line ]
                        )


{-| Strip the oracle's `[Account]:` reply prefix (mirrors
`text.replace(/^\[?Account\]?:?\s+/i, '')`: the marker needs
trailing whitespace to count).
-}
stripAccountReplyPrefix : String -> String
stripAccountReplyPrefix text =
    let
        trimmed =
            String.trimLeft text

        upper =
            String.toUpper trimmed

        dropIfSpace len =
            let
                rest =
                    String.dropLeft len trimmed
            in
            if String.trimLeft rest /= rest then
                String.trimLeft rest

            else
                trimmed
    in
    if String.startsWith "[ACCOUNT]:" upper then
        dropIfSpace 10

    else if String.startsWith "[ACCOUNT]" upper then
        dropIfSpace 9

    else if String.startsWith "ACCOUNT:" upper then
        dropIfSpace 8

    else if String.startsWith "ACCOUNT" upper then
        dropIfSpace 7

    else
        trimmed


{-| The oracle's `/^KEYTRANS\b/i` head test on the unprefixed body. -}
isKeytransBody : String -> Bool
isKeytransBody text =
    let
        body =
            stripAccountReplyPrefix text
    in
    if not (String.startsWith "KEYTRANS" (String.toUpper body)) then
        False

    else
        case String.uncons (String.dropLeft 8 body) of
            Nothing ->
                True

            Just ( next, _ ) ->
                not
                    ((next >= 'a' && next <= 'z')
                        || (next >= 'A' && next <= 'Z')
                        || (next >= '0' && next <= '9')
                        || next == '_'
                    )


{-| Fold a server `KEYTRANS …` notice (`:server NOTICE me :KEYTRANS
…`, mirrors the oracle `key-transparency` security-reply arm:
presence-gated on the live request context, consumed into the
service log as `Account: …` with no client state).
-}
foldKeytransNotice : Model -> Wire.IrcMessage -> Maybe ( Model, List Outbound )
foldKeytransNotice model message =
    case message.params of
        target :: text :: _ ->
            if message.nick /= Nothing || isChannelName model target then
                Nothing

            else if not (isKeytransBody text) then
                Nothing

            else
                case model.keytransReplyAccount of
                    Nothing ->
                        Nothing

                    Just _ ->
                        Just ( logService model ("Account: " ++ text), [] )

        _ ->
            Nothing


{-| Structured `ACCOUNTINFO` fields (mirrors `AccountInfoFields` in
`src/lib/irc/parser.ts`: every field optional at parse time; the
state record requires the attributed account name).
-}
type alias AccountInfoFields =
    { account : Maybe String
    , flags : Maybe Int
    , email : Maybe String
    , secure : Maybe Bool
    , enforce : Maybe Bool
    , registered : Maybe String
    }


type alias AccountInfo =
    { account : String
    , flags : Maybe Int
    , email : Maybe String
    , secure : Maybe Bool
    , enforce : Maybe Bool
    , registered : Maybe String
    }


maxAccountInfoTextLength : Int
maxAccountInfoTextLength =
    4 * 1024


maxAccountInfoPairs : Int
maxAccountInfoPairs =
    64


maxAccountInfoAccountLength : Int
maxAccountInfoAccountLength =
    128


maxAccountInfoEmailLength : Int
maxAccountInfoEmailLength =
    320


maxAccountInfoRegisteredLength : Int
maxAccountInfoRegisteredLength =
    64


maxAccountInfoFlags : Int
maxAccountInfoFlags =
    4294967295


accountInfoPairRegex : Regex.Regex
accountInfoPairRegex =
    Regex.fromString "(\\w+)=([^\\s]+)"
        |> Maybe.withDefault Regex.never


validAccountInfoToken : String -> Int -> Bool
validAccountInfoToken value maxLength =
    String.length value
        > 0
        && String.length value
        <= maxLength
        && not
            (String.any
                (\c -> c == ',' || Char.toCode c <= 0x20 || Char.toCode c == 0x7F)
                value
            )


parseAccountBool : String -> Maybe Bool
parseAccountBool value =
    case String.toLower (String.trim value) of
        "on" ->
            Just True

        "true" ->
            Just True

        "yes" ->
            Just True

        "1" ->
            Just True

        "off" ->
            Just False

        "false" ->
            Just False

        "no" ->
            Just False

        "0" ->
            Just False

        _ ->
            Nothing


parseAccountFlags : String -> Maybe Int
parseAccountFlags value =
    if String.isEmpty value then
        Nothing

    else if value == "0" then
        Just 0

    else if String.startsWith "0" value || not (String.all Char.isDigit value) then
        Nothing

    else
        List.foldl
            (\c acc ->
                case acc of
                    Nothing ->
                        Nothing

                    Just n ->
                        let
                            next =
                                n * 10 + (Char.toCode c - Char.toCode '0')
                        in
                        if next > maxAccountInfoFlags then
                            Nothing

                        else
                            Just next
            )
            (Just 0)
            (String.toList value)


type alias AccountInfoAcc =
    { seen : Set String
    , pairs : Int
    , fields : AccountInfoFields
    , matched : Bool
    }


blankAccountInfoFields : AccountInfoFields
blankAccountInfoFields =
    { account = Nothing
    , flags = Nothing
    , email = Nothing
    , secure = Nothing
    , enforce = Nothing
    , registered = Nothing
    }


foldAccountInfoPair : Regex.Match -> Maybe AccountInfoAcc -> Maybe AccountInfoAcc
foldAccountInfoPair match acc =
    case acc of
        Nothing ->
            Nothing

        Just state ->
            let
                pairs =
                    state.pairs + 1
            in
            if pairs > maxAccountInfoPairs then
                Nothing

            else
                case match.submatches of
                    [ Just rawKey, Just value ] ->
                        applyAccountInfoPair (String.toLower rawKey) value { state | pairs = pairs }

                    _ ->
                        Just { state | pairs = pairs }


applyAccountInfoPair : String -> String -> AccountInfoAcc -> Maybe AccountInfoAcc
applyAccountInfoPair key value state =
    let
        fields =
            state.fields

        seen =
            state.seen
    in
    if Set.member key seen then
        case key of
            "account" ->
                Nothing

            "flags" ->
                Nothing

            "email" ->
                Nothing

            "secure" ->
                Nothing

            "enforce" ->
                Nothing

            "registered" ->
                Nothing

            _ ->
                Just state

    else
        case key of
            "account" ->
                if validAccountInfoToken value maxAccountInfoAccountLength then
                    Just
                        { state
                            | seen = Set.insert key seen
                            , fields = { fields | account = Just value }
                            , matched = True
                        }

                else
                    Nothing

            "flags" ->
                case parseAccountFlags value of
                    Just n ->
                        Just
                            { state
                                | seen = Set.insert key seen
                                , fields = { fields | flags = Just n }
                                , matched = True
                            }

                    Nothing ->
                        Nothing

            "email" ->
                if validAccountInfoToken value maxAccountInfoEmailLength then
                    Just
                        { state
                            | seen = Set.insert key seen
                            , fields = { fields | email = Just value }
                            , matched = True
                        }

                else
                    Nothing

            "secure" ->
                case parseAccountBool value of
                    Just b ->
                        Just
                            { state
                                | seen = Set.insert key seen
                                , fields = { fields | secure = Just b }
                                , matched = True
                            }

                    Nothing ->
                        Nothing

            "enforce" ->
                case parseAccountBool value of
                    Just b ->
                        Just
                            { state
                                | seen = Set.insert key seen
                                , fields = { fields | enforce = Just b }
                                , matched = True
                            }

                    Nothing ->
                        Nothing

            "registered" ->
                if validAccountInfoToken value maxAccountInfoRegisteredLength then
                    Just
                        { state
                            | seen = Set.insert key seen
                            , fields = { fields | registered = Just value }
                            , matched = True
                        }

                else
                    Nothing

            _ ->
                Just state


{-| Parse an `ACCOUNTINFO` reply body (mirrors `parseAccountInfo`:
null unless at least one recognised pair survives the bounds).
-}
parseAccountInfo : String -> Maybe AccountInfoFields
parseAccountInfo text =
    if String.isEmpty text || String.length text > maxAccountInfoTextLength then
        Nothing

    else
        case
            List.foldl foldAccountInfoPair
                (Just
                    { seen = Set.empty
                    , pairs = 0
                    , fields = blankAccountInfoFields
                    , matched = False
                    }
                )
                (Regex.find accountInfoPairRegex text)
        of
            Just state ->
                if state.matched then
                    Just state.fields

                else
                    Nothing

            Nothing ->
                Nothing


{-| Attribute parsed fields to the live request (mirrors
`_applyAccountInfo`: transport-currency is the presence gate; a
response naming another account is rejected, as is a nameless reply
answering nobody current; success clears the context, commits the
info, and drops busy + the error).
-}
applyAccountInfo : Model -> AccountInfoFields -> Maybe Model
applyAccountInfo model fields =
    case model.accountInfoReplyAccount of
        Nothing ->
            Nothing

        Just req ->
            let
                respKey =
                    accountOwnerKey fields.account

                reqKey =
                    accountOwnerKey (Just req)

                currentKey =
                    accountOwnerKey model.accountName

                attributed =
                    case respKey of
                        Just name ->
                            Just name == reqKey

                        Nothing ->
                            reqKey == currentKey
            in
            if not attributed then
                Nothing

            else
                Just
                    { model
                        | accountInfoReplyAccount = Nothing
                        , accountInfo =
                            Just
                                { account = Maybe.withDefault req fields.account
                                , flags = fields.flags
                                , email = fields.email
                                , secure = fields.secure
                                , enforce = fields.enforce
                                , registered = fields.registered
                                }
                        , accountInfoPending = False
                        , accountActionError = Nothing
                    }


{-| `ACCOUNTINFO [account]` (mirrors `accountInfo_fetch`: no arg
means the own account; refused with nowhere to attribute a reply).
-}
requestAccountInfo : Model -> Maybe String -> ( Model, List Outbound )
requestAccountInfo model account =
    let
        trimmed =
            Maybe.withDefault "" (Maybe.map String.trim account)

        target =
            if String.isEmpty trimmed then
                model.accountName

            else
                Just trimmed
    in
    case target of
        Nothing ->
            ( model, [] )

        Just name ->
            if model.connection /= Live then
                ( model, [] )

            else
                case
                    Services.accountInfo
                        (if String.isEmpty trimmed then
                            Nothing

                         else
                            Just trimmed
                        )
                of
                    Nothing ->
                        ( model, [] )

                    Just line ->
                        ( { model
                            | accountInfoPending = True
                            , accountActionError = Nothing
                            , accountInfoReplyAccount = Just name
                          }
                        , [ SendLine line ]
                        )


{-| Fold a server `account=…` notice (`:server NOTICE me
:account=kai flags=…`, mirrors the oracle NOTICE arm: attributed
through the live request context, consumed into the service log as
`Account: …`).
-}
foldAccountInfoNotice : Model -> Wire.IrcMessage -> Maybe ( Model, List Outbound )
foldAccountInfoNotice model message =
    case message.params of
        target :: text :: _ ->
            if message.nick /= Nothing || isChannelName model target then
                Nothing

            else
                case parseAccountInfo text of
                    Nothing ->
                        Nothing

                    Just fields ->
                        case applyAccountInfo model fields of
                            Nothing ->
                                Nothing

                            Just settled ->
                                Just ( logService settled ("Account: " ++ text), [] )

        _ ->
            Nothing


{-| Fold a server webhook notice (mirrors the oracle `serviceSource`
`Webhook` arm: a non-channel, non-CTCP NOTICE naming a whole
`WEBHOOK` word lands in the service log instead of chat, where the
Room-care webhooks section reads it back).
-}
foldWebhookNotice : Model -> Wire.IrcMessage -> Maybe ( Model, List Outbound )
foldWebhookNotice model message =
    case message.params of
        target :: text :: _ ->
            if String.startsWith "\u{0001}" text || isChannelName model target then
                Nothing

            else if Webhook.containsWebhookWord text then
                -- Create replies may contain a one-time bearer URL. Keep the
                -- entire server body out of Elm logs and history; the private
                -- runtime owns any correlated secret presentation.
                Just ( logService model "Webhook service replied; secret values are shown only in the private one-time presentation.", [] )

            else
                Nothing

        _ ->
            Nothing


{-| `LOGOUT` (mirrors `logout`: silent unless live; the 901 fold
clears the account).
-}
requestLogout : Model -> ( Model, List Outbound )
requestLogout model =
    if model.connection /= Live then
        ( model, [] )

    else
        ( { model | accountActionError = Nothing }
        , [ SendLine Services.logout ]
        )


{-| Extract the `SESSION LIST` leg so the Account open-refresh shares
it with `SessionListRequested` (mirrors `refreshAccountSessions`).
-}
requestSessionList : Model -> ( Model, List Outbound )
requestSessionList model =
    update SessionListRequested model


sessionResumePending : Model -> Bool
sessionResumePending model =
    case model.sessionReclaim of
        Just notice ->
            notice.phase == Restoring

        Nothing ->
            False


{-| Open the Account panel with a fresh refresh (mirrors the panel
mount fetches: own info + session roster; TOTP/recovery STATUS join
in C2/C3 with their sections).
-}
openAccountPanel : Model -> ( Model, List Outbound )
openAccountPanel model =
    if model.accountOpen then
        ( model, [] )

    else
        let
            ( withInfo, infoOut ) =
                requestAccountInfo model Nothing

            -- Mirror the oracle's open-refresh (`accountInfo_fetch`
            -- + `totpStatus` + `keyTransparencyStatus` +
            -- `recoveryCodesStatus` + `vhostList`):
            -- every leg self-gates on signed-in + live, so guests and
            -- dead sockets stay silent.
            ( withTotp, totpOut ) =
                requestTotpStatus withInfo

            ( withKeytrans, keytransOut ) =
                requestKeytransStatus withTotp

            ( withRecovery, recoveryOut ) =
                requestRecoveryCodesStatus withKeytrans

            -- Passkey inventory is private runtime metadata. It is
            -- refreshed through the explicit PasskeyListRequested
            -- action so it cannot race the account-open session lease.
            withPasskeys =
                withRecovery

            passkeyListOut =
                []

            ( withE2ee, e2eeOut ) =
                requestE2eeKeyStatus withPasskeys

            ( withVhost, vhostOut ) =
                requestVhostList withE2ee
        in
        ( { withVhost | accountOpen = True, accountEmail = seedAccountEmail withVhost }
        , infoOut ++ totpOut ++ keytransOut ++ recoveryOut ++ passkeyListOut ++ e2eeOut ++ vhostOut
        )


{-| Seed the email field from the latest info when empty, mirroring
the oracle's open effect — never clobbering an in-progress edit.
-}
seedAccountEmail : Model -> String
seedAccountEmail model =
    if not (String.isEmpty model.accountEmail) then
        model.accountEmail

    else
        case model.accountInfo of
            Just info ->
                Maybe.withDefault "" info.email

            Nothing ->
                ""


{-| Bound the TOTP confirm input like the oracle's `boundedTotpCode`:
digits only, capped at the 6-digit shape.
-}
boundTotpCode : String -> String
boundTotpCode value =
    String.filter Char.isDigit value
        |> String.left totpCodeLength


{-| The latest certificate replies for the Account panel: the
`Account:`-sourced service-log lines matching the oracle's
`/CERT|fingerprint|SHA256/i` filter, newest first, capped at 4.
-}
accountCertNotices : Model -> List String
accountCertNotices model =
    let
        lowered =
            List.map (\line -> ( String.toLower line, line )) model.serviceLog
    in
    List.filterMap
        (\( low, line ) ->
            if
                String.startsWith "account: " low
                    && (String.contains "cert" low
                            || String.contains "fingerprint" low
                            || String.contains "sha256" low
                       )
            then
                Just line

            else
                Nothing
        )
        lowered
        |> List.take 4


{-| The latest transparency replies for the Account panel: the
`Account:`-sourced service-log lines matching the oracle's
`/\b(E2EEKEY|KEYTRANS)\b/i` filter, newest first, capped at 6.
-}
accountKeytransNotices : Model -> List String
accountKeytransNotices model =
    let
        lowered =
            List.map (\line -> ( String.toLower line, line )) model.serviceLog
    in
    List.filterMap
        (\( low, line ) ->
            if String.startsWith "account: " low && hasAccountWord low then
                Just line

            else
                Nothing
        )
        lowered
        |> List.take 6


{-| Word-boundary test for the transparency filter: split on
non-alphanumerics so `monkeytrans` never matches `keytrans`.
-}
hasAccountWord : String -> Bool
hasAccountWord low =
    let
        words =
            String.map
                (\c ->
                    if Char.isAlphaNum c then
                        c

                    else
                        ' '
                )
                low
                |> String.words
    in
    List.member "e2eekey" words || List.member "keytrans" words


{-| Minimum account password length, mirroring the oracle's
`MIN_PASSWORD_LEN` on the password-change form.
-}
minAccountPasswordLength : Int
minAccountPasswordLength =
    8


{-| Email shape check mirroring the oracle's
`/^[^\s@]+@[^\s@]+\.[^\s@]+$/` gate on the email-change form.
-}
isValidAccountEmail : String -> Bool
isValidAccountEmail value =
    let
        trimmed =
            String.trim value

        hasBlank =
            String.any (\c -> c == ' ' || c == '\t' || c == '\n' || c == '\r') trimmed
    in
    if String.isEmpty trimmed || hasBlank then
        False

    else
        case String.split "@" trimmed of
            [ local, domain ] ->
                case String.split "." domain of
                    _ :: _ :: _ ->
                        not (String.isEmpty local)
                            && List.all (not << String.isEmpty) (String.split "." domain)

                    _ ->
                        False

            _ ->
                False


{-| Bound a passkey label like the oracle's `boundedPasskeyLabel`:
strip control characters, cap at the wire length. Elm strings are
codepoints, so no lone-surrogate trim is owed.
-}
boundedPasskeyLabel : String -> String
boundedPasskeyLabel value =
    String.filter
        (\c ->
            let
                n =
                    Char.toCode c
            in
            n >= 32 && n /= 127
        )
        value
        |> String.left Passkey.maxLabelLength


{-| `WEBAUTHN LIST` (mirrors `listPasskeys`: account + live + a
browser that can run ceremonies; begins the pending-list
accumulator and clears the error).
-}
requestPasskeyList : Model -> ( Model, List Outbound )
requestPasskeyList model =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just _ ->
            if model.connection /= Live then
                ( model, [] )

            else if model.passkeyBrowserSupported == Just False then
                ( model, [] )

            else
                update (RuntimeDomainActionRequested RuntimeDomain.PasskeyList) model


{-| `WEBAUTHN REGISTER [label]` (mirrors `registerPasskey`: arms
busy and clears notice/error; the challenge reply runs the
ceremony through the existing fold).
-}
requestPasskeyRegister : Model -> String -> ( Model, List Outbound )
requestPasskeyRegister model label =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just _ ->
            if model.connection /= Live then
                ( model, [] )

            else if model.passkeyBrowserSupported == Just False then
                let
                    session =
                        model.passkey
                in
                ( { model
                    | passkey =
                        { session
                            | error = Just "This browser does not support passkeys."
                            , notice = Nothing
                        }
                  }
                , []
                )

            else
                let
                    session =
                        model.passkey
                in
                ( { model
                    | passkey =
                        { session
                            | busy = True
                            , error = Nothing
                            , notice = Nothing
                            , lastAction = Just Passkey.ActionRegister
                        }
                  }
                , [ SendLine (Passkey.webauthnRegister (Just label)) ]
                )


{-| `WEBAUTHN REMOVE <id>` (mirrors `removePasskey`: blank targets
refused locally; busy + error/notice cleared).
-}
requestPasskeyRemove : Model -> String -> ( Model, List Outbound )
requestPasskeyRemove model target =
    let
        trimmed =
            String.trim target
    in
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just _ ->
            if model.connection /= Live || String.isEmpty trimmed then
                ( model, [] )

            else if model.passkeyBrowserSupported == Just False then
                let
                    session =
                        model.passkey
                in
                ( { model
                    | passkey =
                        { session
                            | error = Just "This browser does not support passkeys."
                            , notice = Nothing
                        }
                  }
                , []
                )

            else
                case Passkey.webauthnRemove trimmed of
                    Nothing ->
                        ( model, [] )

                    Just line ->
                        let
                            session =
                                model.passkey
                        in
                        ( { model
                            | passkey =
                                { session
                                    | busy = True
                                    , error = Nothing
                                    , notice = Nothing
                                    , lastAction = Just Passkey.ActionRemove
                                }
                          }
                        , [ SendLine line ]
                        )


{-| `WEBAUTHN RENAME <id> <label>` (mirrors `renamePasskey`: the
label is the trailing param so it may contain spaces; blank ids
and blank labels refused locally).
-}
requestPasskeyRename : Model -> String -> String -> ( Model, List Outbound )
requestPasskeyRename model id label =
    let
        target =
            String.trim id

        next =
            String.trim label
    in
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just _ ->
            if model.connection /= Live || String.isEmpty target || String.isEmpty next then
                ( model, [] )

            else if model.passkeyBrowserSupported == Just False then
                let
                    session =
                        model.passkey
                in
                ( { model
                    | passkey =
                        { session
                            | error = Just "This browser does not support passkeys."
                            , notice = Nothing
                        }
                  }
                , []
                )

            else
                case Passkey.webauthnRename target next of
                    Nothing ->
                        ( model, [] )

                    Just line ->
                        let
                            session =
                                model.passkey
                        in
                        ( { model
                            | passkey =
                                { session
                                    | busy = True
                                    , error = Nothing
                                    , notice = Nothing
                                    , lastAction = Just Passkey.ActionRename
                                }
                          }
                        , [ SendLine line ]
                        )


{-| `ACCOUNTSET <account> <password> email <value>` (mirrors the
oracle's email-change submit: shape-checked locally with the
oracle's error copy; the verifying password clears on send).
-}
requestAccountSetEmail : Model -> ( Model, List Outbound )
requestAccountSetEmail model =
    let
        value =
            String.trim model.accountEmail
    in
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            if model.connection /= Live then
                ( model, [] )

            else if not (isValidAccountEmail value) then
                ( { model | accountEmailError = Just "Enter a valid email address." }, [] )

            else if String.isEmpty model.accountEmailPassword then
                ( { model | accountEmailError = Just "Your account password is required to change email." }, [] )

            else
                case Services.accountSet acct model.accountEmailPassword "email" value of
                    Nothing ->
                        ( model, [] )

                    Just line ->
                        ( { model | accountEmailError = Nothing, accountEmailPassword = "" }
                        , [ SendLine line ]
                        )


{-| `ACCOUNTSET <account> <current> password <new>` (mirrors the
oracle's password-change submit; all three fields clear on send).
-}
requestAccountSetPassword : Model -> ( Model, List Outbound )
requestAccountSetPassword model =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            if model.connection /= Live then
                ( model, [] )

            else if String.length model.accountNewPassword < minAccountPasswordLength then
                ( { model | accountPasswordError = Just ("Use at least " ++ String.fromInt minAccountPasswordLength ++ " characters.") }, [] )

            else if model.accountNewPassword /= model.accountConfirmPassword then
                ( { model | accountPasswordError = Just "Passwords do not match." }, [] )

            else if String.isEmpty model.accountCurrentPassword then
                ( { model | accountPasswordError = Just "Your current password is required." }, [] )

            else
                case Services.accountSet acct model.accountCurrentPassword "password" model.accountNewPassword of
                    Nothing ->
                        ( model, [] )

                    Just line ->
                        ( { model
                            | accountPasswordError = Nothing
                            , accountNewPassword = ""
                            , accountConfirmPassword = ""
                            , accountCurrentPassword = ""
                          }
                        , [ SendLine line ]
                        )


{-| The DROP danger gate, mirroring the oracle's `dropReady`: armed,
confirm matches the account, and a password is present.
-}
dropReady : Model -> Bool
dropReady model =
    case model.accountName of
        Nothing ->
            False

        Just acct ->
            model.dropArmed
                && String.trim model.dropConfirm == acct
                && not (String.isEmpty model.dropPassword)


{-| `DROP <account> <password>` (mirrors `dropAccount`: irreversible;
the server logs the session out on success, so a sent DROP clears
the confirm state and closes the panel).
-}
requestDropAccount : Model -> ( Model, List Outbound )
requestDropAccount model =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            if model.connection /= Live || not (dropReady model) then
                ( model, [] )

            else
                case Services.dropAccount acct model.dropPassword of
                    Nothing ->
                        ( model, [] )

                    Just line ->
                        ( { model | dropConfirm = "", dropPassword = "", dropArmed = False, accountOpen = False }
                        , [ SendLine line ]
                        )


{-| `E2EEKEY STATUS` (mirrors `e2eeKeyStatus`: context-free send,
account + live gated).
-}
requestE2eeKeyStatus : Model -> ( Model, List Outbound )
requestE2eeKeyStatus model =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just _ ->
            if model.connection /= Live then
                ( model, [] )

            else
                ( model, [ SendLine Services.e2eeKeyStatus ] )


{-| `E2EEKEY LIST` for our own account (mirrors `e2eeKeyList`).
-}
requestE2eeKeyList : Model -> ( Model, List Outbound )
requestE2eeKeyList model =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            if model.connection /= Live then
                ( model, [] )

            else
                ( model, [ SendLine (Services.e2eeKeyList (Just acct)) ] )


{-| Manual "publish this device key" (mirrors `publishThisDeviceKey`
minus the crypto: arms busy single-flight and asks ports-side for
the registry id + public point; `E2eeDeviceIdentityReceived`
finishes the `E2EEKEY ADD`).
-}
requestE2eeKeyPublish : Model -> ( Model, List Outbound )
requestE2eeKeyPublish model =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just _ ->
            if model.connection /= Live || model.e2eePublishBusy then
                ( model, [] )

            else
                ( { model | e2eePublishBusy = True }, [ E2eeDeviceIdentityRequest ] )


{-| `E2EEKEY DEL browser` — remove the legacy shared browser entry
(mirrors the oracle's remove-legacy button).
-}
requestE2eeKeyDeleteLegacy : Model -> ( Model, List Outbound )
requestE2eeKeyDeleteLegacy model =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just _ ->
            if model.connection /= Live then
                ( model, [] )

            else
                case Services.e2eeKeyDel "browser" of
                    Nothing ->
                        ( model, [] )

                    Just line ->
                        ( model, [ SendLine line ] )


{-| Client-cert bindings: `CERTADD` / `CERTLIST` / `CERTDEL` whose
replies arrive on the NOTICE plane (mirrors the oracle's `certAdd` /
`certList` / `certDel` plus the `certificate` security-reply gate —
presence-gated like KEYTRANS; the Account panel renders them by
filtering the service log, so the fold keeps no client state).
-}
requestCertAdd : Model -> ( Model, List Outbound )
requestCertAdd model =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            case certAddLine model of
                [] ->
                    ( model, [] )

                outs ->
                    ( { model | certReplyAccount = Just acct }, outs )


{-| `CERTLIST` — list bound fingerprints (mirrors `certList`). -}
requestCertList : Model -> ( Model, List Outbound )
requestCertList model =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            if model.connection /= Live then
                ( model, [] )

            else
                ( { model | certReplyAccount = Just acct }
                , [ SendLine Services.certList ]
                )


{-| `CERTDEL <fingerprint>` — unbind one fingerprint (mirrors
`certDel`: blank fingerprints refused locally).
-}
requestCertDel : Model -> String -> ( Model, List Outbound )
requestCertDel model fingerprint =
    let
        trimmed =
            String.trim fingerprint
    in
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            if model.connection /= Live then
                ( model, [] )

            else if String.isEmpty trimmed then
                ( model, [] )

            else
                case Services.certDel trimmed of
                    Nothing ->
                        ( model, [] )

                    Just line ->
                        ( { model | certReplyAccount = Just acct }
                        , [ SendLine line ]
                        )


{-| The oracle's `/^(?:CERT(?:IFICATE|ADD|LIST|DEL)?|FINGERPRINT)\b/i`
head test on the unprefixed body. -}
isCertBody : String -> Bool
isCertBody text =
    let
        upper =
            String.toUpper (stripAccountReplyPrefix text)

        wordHead word =
            if not (String.startsWith word upper) then
                False

            else
                case String.uncons (String.dropLeft (String.length word) upper) of
                    Nothing ->
                        True

                    Just ( next, _ ) ->
                        not
                            ((next >= 'A' && next <= 'Z')
                                || (next >= '0' && next <= '9')
                                || next == '_'
                            )
    in
    List.any wordHead
        [ "CERTIFICATE", "CERTADD", "CERTLIST", "CERTDEL", "CERT", "FINGERPRINT" ]


{-| Fold a server certificate notice (`:server NOTICE me :CERTLIST
<fp>` / `:Certificate fingerprint …`, mirrors the oracle
`certificate` security-reply arm: presence-gated, consumed into the
service log as `Account: …` with no client state).
-}
foldCertNotice : Model -> Wire.IrcMessage -> Maybe ( Model, List Outbound )
foldCertNotice model message =
    case message.params of
        target :: text :: _ ->
            if message.nick /= Nothing || isChannelName model target then
                Nothing

            else if not (isCertBody text) then
                Nothing

            else
                case model.certReplyAccount of
                    Nothing ->
                        Nothing

                    Just _ ->
                        Just ( logService model ("Account: " ++ text), [] )

        _ ->
            Nothing


{-| A claimed Guise persona row, mirroring the oracle
`PersonasState.personas` entries (`VHOST persona <name> = <host>
(<source>)`).
-}
type alias Persona =
    { name : String
    , host : String
    , source : String
    }


{-| A wearable persona template offer, mirroring the oracle
`PersonasState.offers` entries (`VHOST offer <template> :<label>`).
-}
type alias PersonaOffer =
    { template : String
    , label : String
    }


maxPersonaEntries : Int
maxPersonaEntries =
    64


maxPersonaNameLength : Int
maxPersonaNameLength =
    64


maxPersonaHostLength : Int
maxPersonaHostLength =
    256


maxPersonaSourceLength : Int
maxPersonaSourceLength =
    128


maxPersonaLabelLength : Int
maxPersonaLabelLength =
    256


{-| Normalize a persona token like the oracle's
`normalizedAccountToken`: trim, then refuse empties, overlongs,
controls/whitespace, and a leading colon (which would reframe the
wire param).
-}
normalizePersonaToken : String -> Int -> Maybe String
normalizePersonaToken value maxLength =
    let
        token =
            String.trim value
    in
    if String.isEmpty token then
        Nothing

    else if String.length token > maxLength then
        Nothing

    else if String.startsWith ":" token then
        Nothing

    else if String.any (\c -> c <= ' ' || Char.toCode c == 127) token then
        Nothing

    else
        Just token


{-| Bound a persona label like the oracle's `boundedAccountLabel`:
strip controls, cap at the wire length. Elm strings are codepoints,
so the oracle's lone-surrogate trim has no equivalent here.
-}
boundPersonaLabel : String -> Int -> String
boundPersonaLabel value maxLength =
    String.filter
        (\c ->
            let
                n =
                    Char.toCode c
            in
            n >= 32 && n /= 127
        )
        value
        |> String.left maxLength


vhostPersonaPattern : Regex.Regex
vhostPersonaPattern =
    Regex.fromString "^VHOST persona (\\S+) = (\\S+) \\(([^)]*)\\)$"
        |> Maybe.withDefault Regex.never


vhostOfferPattern : Regex.Regex
vhostOfferPattern =
    Regex.fromString "^VHOST offer (\\S+) :?(.*)$"
        |> Maybe.withDefault Regex.never


vhostConfirmationPattern : Regex.Regex
vhostConfirmationPattern =
    keywordRegex "now wearing|claimed|persona off|removed"


{-| Parse one `VHOST persona <name> = <host> (<source>)` notice
(mirrors the oracle grammar exactly — the patterns run on the real
regex engine, so `\S` and the end anchor behave like the oracle —
then the slots pass through the persona token/label bounds).
-}
parseVhostPersona : String -> Maybe Persona
parseVhostPersona text =
    case keywordGroups vhostPersonaPattern text of
        Just [ Just rawName, Just rawHost, Just rawSource ] ->
            case
                ( normalizePersonaToken rawName maxPersonaNameLength
                , normalizePersonaToken rawHost maxPersonaHostLength
                )
            of
                ( Just name, Just host ) ->
                    Just
                        { name = name
                        , host = host
                        , source = boundPersonaLabel rawSource maxPersonaSourceLength
                        }

                _ ->
                    Nothing

        _ ->
            Nothing


{-| Parse one `VHOST offer <template> :<label>` notice (mirrors the
oracle grammar: the template slot takes the host bound, the label
stays raw behind one optional colon).
-}
parseVhostOffer : String -> Maybe PersonaOffer
parseVhostOffer text =
    case keywordGroups vhostOfferPattern text of
        Just [ Just rawTemplate, Just rawLabel ] ->
            case normalizePersonaToken rawTemplate maxPersonaHostLength of
                Just template ->
                    Just
                        { template = template
                        , label = boundPersonaLabel rawLabel maxPersonaLabelLength
                        }

                Nothing ->
                    Nothing

        _ ->
            Nothing


{-| Admit a persona row like the oracle LIST fold: dedupe by
lowercased name, then refuse past the entry cap (keeping what is
already worn rather than evicting it).
-}
admitPersona : List Persona -> Persona -> List Persona
admitPersona current persona =
    let
        key =
            String.toLower persona.name

        kept =
            List.filter (\p -> String.toLower p.name /= key) current
    in
    if List.length kept >= maxPersonaEntries then
        kept

    else
        kept ++ [ persona ]


{-| Admit an offer row the same way, keyed on the lowercased
template.
-}
admitPersonaOffer : List PersonaOffer -> PersonaOffer -> List PersonaOffer
admitPersonaOffer current offer =
    let
        key =
            String.toLower offer.template

        kept =
            List.filter (\o -> String.toLower o.template /= key) current
    in
    if List.length kept >= maxPersonaEntries then
        kept

    else
        kept ++ [ offer ]


{-| `VHOST LIST` (mirrors `vhostList`: account + live; captures the
reply context and clears the wardrobe — the rows arrive as
follow-up notices).
-}
requestVhostList : Model -> ( Model, List Outbound )
requestVhostList model =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            if model.connection /= Live then
                ( model, [] )

            else
                ( { model
                    | vhostReplyAccount = Just acct
                    , personas = []
                    , personaOffers = []
                  }
                , [ SendLine Services.vhostList ]
                )


{-| `VHOST USE <persona>` (mirrors `vhostUse`: the name slot is
refused locally when the persona token gate rejects it).
-}
requestVhostUse : Model -> String -> ( Model, List Outbound )
requestVhostUse model name =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            if model.connection /= Live then
                ( model, [] )

            else
                case normalizePersonaToken name maxPersonaNameLength of
                    Nothing ->
                        ( model, [] )

                    Just target ->
                        case Services.vhostUse target of
                            Nothing ->
                                ( model, [] )

                            Just line ->
                                ( { model | vhostReplyAccount = Just acct }
                                , [ SendLine line ]
                                )


{-| `VHOST CLAIM <host>` (mirrors `vhostClaim`: the host slot takes
the host bound and is refused locally when the gate rejects it).
-}
requestVhostClaim : Model -> String -> ( Model, List Outbound )
requestVhostClaim model host =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            if model.connection /= Live then
                ( model, [] )

            else
                case normalizePersonaToken host maxPersonaHostLength of
                    Nothing ->
                        ( model, [] )

                    Just target ->
                        case Services.vhostClaim target of
                            Nothing ->
                                ( model, [] )

                            Just line ->
                                ( { model | vhostReplyAccount = Just acct }
                                , [ SendLine line ]
                                )


{-| `VHOST OFF` (mirrors `vhostOff`: context + send only).
-}
requestVhostOff : Model -> ( Model, List Outbound )
requestVhostOff model =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            if model.connection /= Live then
                ( model, [] )

            else
                ( { model | vhostReplyAccount = Just acct }
                , [ SendLine Services.vhostOff ]
                )


{-| Fold one server `VHOST ...` account notice (mirrors the oracle
arm: a context-less notice is ignored; a persona row and an offer
row collect into the wardrobe without a service line; anything else
logs to Account, and a wear/claim confirmation schedules the 300ms
re-list — the pending account is remembered so the timer only
re-lists for the account that confirmed).
-}
foldVhostNotice : Model -> Wire.IrcMessage -> Maybe ( Model, List Outbound )
foldVhostNotice model message =
    case message.params of
        target :: text :: _ ->
            if message.nick /= Nothing || isChannelName model target then
                Nothing

            else if not (String.startsWith "VHOST" text) then
                Nothing

            else
                case model.vhostReplyAccount of
                    Nothing ->
                        Nothing

                    Just _ ->
                        case parseVhostPersona text of
                            Just persona ->
                                Just
                                    ( { model | personas = admitPersona model.personas persona }
                                    , []
                                    )

                            Nothing ->
                                case parseVhostOffer text of
                                    Just offer ->
                                        Just
                                            ( { model | personaOffers = admitPersonaOffer model.personaOffers offer }
                                            , []
                                            )

                                    Nothing ->
                                        let
                                            logged =
                                                logService model ("Account: " ++ text)
                                        in
                                        if Regex.contains vhostConfirmationPattern text then
                                            Just
                                                ( { logged | vhostRefreshAccount = model.vhostReplyAccount }
                                                , [ VhostRefreshRequest ]
                                                )

                                        else
                                            Just ( logged, [] )

        _ ->
            Nothing


{- Offline recovery codes, driven by the server's `RECOVERYCODES:`
notices (mirrors the oracle `RecoveryCodesState`; the Account panel
reads it, and the verbs below are its only writers — unlike TOTP
there is no reply context: the oracle folds every such notice and
every `FAIL RECOVERYCODES` unconditionally).
-}
type alias RecoveryCodesState =
    { remaining : Maybe Int
    , freshCodes : List String
    , busy : Bool
    , error : Maybe String
    , info : Maybe String
    }


blankRecoveryCodes : RecoveryCodesState
blankRecoveryCodes =
    { remaining = Nothing
    , freshCodes = []
    , busy = False
    , error = Nothing
    , info = Nothing
    }


minRecoveryCodeLength : Int
minRecoveryCodeLength =
    8


{-| `RECOVERYCODES STATUS` (mirrors `recoveryCodesStatus`: busy;
silent unless live).
-}
requestRecoveryCodesStatus : Model -> ( Model, List Outbound )
requestRecoveryCodesStatus model =
    if model.connection /= Live then
        ( model, [] )

    else
        let
            current =
                model.recoveryCodes
        in
        ( { model | recoveryCodes = { current | busy = True, error = Nothing } }
        , [ SendLine Services.recoveryCodesStatus ]
        )


{-| `RECOVERYCODES GENERATE [password]` (mirrors
`recoveryCodesGenerate`: a fresh batch forgets shown codes; a
password the wire gate refuses sends nothing and touches nothing).
-}
requestRecoveryCodesGenerate : Model -> Maybe String -> ( Model, List Outbound )
requestRecoveryCodesGenerate model password =
    if model.connection /= Live then
        ( model, [] )

    else
        case Services.recoveryCodesGenerate password of
            Nothing ->
                ( model, [] )

            Just line ->
                let
                    current =
                        model.recoveryCodes
                in
                ( { model
                    | recoveryCodes =
                        { current | busy = True, error = Nothing, info = Nothing, freshCodes = [] }
                  }
                , [ SendLine line ]
                )


{-| `RECOVERYCODES CLEAR [password]` (mirrors `recoveryCodesClear`).
-}
requestRecoveryCodesClear : Model -> Maybe String -> ( Model, List Outbound )
requestRecoveryCodesClear model password =
    if model.connection /= Live then
        ( model, [] )

    else
        case Services.recoveryCodesClear password of
            Nothing ->
                ( model, [] )

            Just line ->
                let
                    current =
                        model.recoveryCodes
                in
                ( { model
                    | recoveryCodes =
                        { current | busy = True, error = Nothing, info = Nothing }
                  }
                , [ SendLine line ]
                )


{-| `RECOVERYCODES LOGIN <account> <code>` (mirrors
`recoveryCodesLogin`: the code normalizes dash/space-insensitively
and must keep 8+ characters; off-socket the leg queues until 001,
mirroring `_pendingRecoveryLogin`).
-}
requestRecoveryCodesLogin : Model -> String -> String -> ( Model, List Outbound )
requestRecoveryCodesLogin model account code =
    let
        acct =
            String.trim account

        raw =
            RecoveryCodes.normalizeRecoveryCodeInput code
    in
    if String.isEmpty acct || String.length raw < minRecoveryCodeLength then
        ( model, [] )

    else if model.connection /= Live then
        let
            current =
                model.recoveryCodes
        in
        ( { model
            | pendingRecoveryLogin = Just { account = acct, code = raw }
            , recoveryCodes =
                { current | busy = True, error = Nothing, info = Nothing }
          }
        , []
        )

    else
        case Services.recoveryCodesLogin acct raw of
            Nothing ->
                ( model, [] )

            Just line ->
                let
                    current =
                        model.recoveryCodes
                in
                ( { model
                    | recoveryCodes =
                        { current | busy = True, error = Nothing, info = Nothing }
                  }
                , [ SendLine line ]
                )


{-| Forget shown fresh codes (mirrors `recoveryCodesDismissFresh`).
-}
dismissRecoveryCodesFresh : Model -> Model
dismissRecoveryCodesFresh model =
    let
        current =
            model.recoveryCodes
    in
    { model | recoveryCodes = { current | freshCodes = [], info = Nothing } }


{-| Flush a Connect-queued recovery login on 001 (mirrors the
oracle's `_pendingRecoveryLogin` flush: send once, drop the queue
even when the builder refuses — a refused line is never retried).
-}
flushPendingRecoveryLogin : Model -> ( Model, List Outbound )
flushPendingRecoveryLogin model =
    case model.pendingRecoveryLogin of
        Nothing ->
            ( model, [] )

        Just pending ->
            case Services.recoveryCodesLogin pending.account pending.code of
                Nothing ->
                    ( { model | pendingRecoveryLogin = Nothing }, [] )

                Just line ->
                    ( { model | pendingRecoveryLogin = Nothing }, [ SendLine line ] )


{-| The free-text tail of a `RECOVERYCODES:` notice (mirrors
`text.slice('RECOVERYCODES:'.length).trim()`).
-}
recoveryCodesInfoText : String -> String
recoveryCodesInfoText text =
    String.trim (String.dropLeft 14 text)


{-| Settle one server `RECOVERYCODES:` notice body (mirrors the
oracle ladder: status → generated → code line → cleared → login-ok
→ free-text info; every arm drops busy and the error, like the
oracle's shared `{ ...busy: false, error: null }`).
-}
settleRecoveryCodesBody : RecoveryCodesState -> String -> RecoveryCodesState
settleRecoveryCodesBody current text =
    let
        cleared =
            { current | busy = False, error = Nothing }
    in
    case RecoveryCodes.parseRecoveryCodesStatus text of
        Just status ->
            { cleared | remaining = Just status.remaining, info = Nothing }

        Nothing ->
            if RecoveryCodes.isRecoveryCodesGenerated text then
                { cleared | freshCodes = [], info = Just (recoveryCodesInfoText text) }

            else
                case RecoveryCodes.parseRecoveryCodeLine text of
                    Just codeLine ->
                        let
                            fresh =
                                if List.member codeLine.code cleared.freshCodes then
                                    cleared.freshCodes

                                else
                                    cleared.freshCodes ++ [ codeLine.code ]
                        in
                        { cleared | freshCodes = fresh, remaining = Just (List.length fresh) }

                    Nothing ->
                        if RecoveryCodes.isRecoveryCodesCleared text then
                            { cleared
                                | remaining = Just 0
                                , freshCodes = []
                                , info = Just (recoveryCodesInfoText text)
                            }

                        else if RecoveryCodes.isRecoveryCodesLoginOk text then
                            { cleared
                                | remaining =
                                    case cleared.remaining of
                                        Just n ->
                                            if n > 0 then
                                                Just (n - 1)

                                            else
                                                Just n

                                        Nothing ->
                                            Nothing
                                , info = Just (recoveryCodesInfoText text)
                            }

                        else
                            { cleared | info = Just (recoveryCodesInfoText text) }


{-| Fold a server `RECOVERYCODES:` notice (`:server NOTICE me
:RECOVERYCODES: …`, mirrors the oracle branch: ungated, like the
oracle's — a stray body still settles and lands in the service log
as `Account: …`, mirroring `addServiceNotice('Account', text)`).
-}
foldRecoveryCodesNotice : Model -> Wire.IrcMessage -> Maybe ( Model, List Outbound )
foldRecoveryCodesNotice model message =
    case message.params of
        target :: text :: _ ->
            if message.nick /= Nothing || isChannelName model target then
                Nothing

            else if not (String.startsWith "RECOVERYCODES:" text) then
                Nothing

            else
                Just
                    ( logService
                        { model | recoveryCodes = settleRecoveryCodesBody model.recoveryCodes text }
                        ("Account: " ++ text)
                    , []
                    )

        _ ->
            Nothing


{-| Resolve a terminal `FAIL RECOVERYCODES` (mirrors the oracle arm:
ungated — busy clears and the error carries the server description
with the `Recovery codes command failed` fallback, state-only).
-}
foldRecoveryCodesFail : Model -> Wire.StandardReply -> ( Model, List Outbound )
foldRecoveryCodesFail model reply =
    let
        current =
            model.recoveryCodes

        message =
            if String.isEmpty reply.description then
                "Recovery codes command failed"

            else
                reply.description
    in
    ( { model | recoveryCodes = { current | busy = False, error = Just message } }
    , []
    )


{- TOTP two-factor state, driven by the server's `TOTP:` notices
(mirrors the oracle `TotpState`: unknown until a STATUS round-trip
or an enroll/confirm/disable leg settles it; the Account panel reads
it, and the verbs below are its only writers).
-}
type TotpStatus
    = TotpUnknown
    | TotpDisabled
    | TotpPending
    | TotpActive


type alias TotpState =
    { status : TotpStatus
    , secret : Maybe String
    , otpauth : Maybe String
    , error : Maybe String
    , busy : Bool
    }


blankTotp : TotpState
blankTotp =
    { status = TotpUnknown
    , secret = Nothing
    , otpauth = Nothing
    , error = Nothing
    , busy = False
    }


maxTotpSecretLength : Int
maxTotpSecretLength =
    256


maxTotpUriLength : Int
maxTotpUriLength =
    2048


totpCodeLength : Int
totpCodeLength =
    6


isTotpCode : String -> Bool
isTotpCode code =
    String.length code == totpCodeLength
        && String.all (\c -> c >= '0' && c <= '9') code


isBase32Char : Char -> Bool
isBase32Char c =
    (c >= 'A' && c <= 'Z') || (c >= '2' && c <= '7')


containsFolded : String -> String -> Bool
containsFolded needle haystack =
    String.contains (String.toLower needle) (String.toLower haystack)


endsWithFolded : String -> String -> Bool
endsWithFolded needle haystack =
    String.endsWith (String.toLower needle) (String.toLower haystack)


{-| `secret <BASE32>` body (mirrors `/^secret ([A-Z2-7]+)$/` plus the
256 bound; anything else falls through to the status-word chain,
exactly like the oracle's if/else ladder).
-}
parseTotpSecret : String -> Maybe String
parseTotpSecret body =
    case String.split " " body of
        [ "secret", code ] ->
            if
                String.length code
                    > 0
                    && String.length code
                    <= maxTotpSecretLength
                    && String.all isBase32Char code
            then
                Just code

            else
                Nothing

        _ ->
            Nothing


{-| `otpauth://…` body (mirrors the oracle: prefix + 2048 bound +
no C0/space/DEL).
-}
isTotpOtpauth : String -> Bool
isTotpOtpauth body =
    String.startsWith "otpauth://" body
        && String.length body
        <= maxTotpUriLength
        && not
            (String.any
                (\c -> Char.toCode c <= 0x20 || Char.toCode c == 0x7F)
                body
            )


{-| `TOTP ENROLL` (mirrors `totpEnroll`: busy + forget any shown
secret/otpauth; refused off-socket or with no account, since the
server's TOTP verbs are account verbs).
-}
requestTotpEnroll : Model -> ( Model, List Outbound )
requestTotpEnroll model =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            if model.connection /= Live then
                ( model, [] )

            else
                let
                    current =
                        model.totp
                in
                ( { model
                    | totp = { current | busy = True, error = Nothing, secret = Nothing, otpauth = Nothing }
                    , totpReplyAccount = Just acct
                  }
                , [ SendLine Services.totpEnroll ]
                )


{-| `TOTP CONFIRM <code>` (mirrors `totpConfirm`: the 6-digit shape
is refused locally, like the oracle's `/^\d{6}$/u` guard; a shown
secret survives the confirm leg).
-}
requestTotpConfirm : Model -> String -> ( Model, List Outbound )
requestTotpConfirm model code =
    let
        trimmed =
            String.trim code
    in
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            if model.connection /= Live then
                ( model, [] )

            else if not (isTotpCode trimmed) then
                ( model, [] )

            else
                case Services.totpConfirm trimmed of
                    Nothing ->
                        ( model, [] )

                    Just line ->
                        let
                            current =
                                model.totp
                        in
                        ( { model
                            | totp = { current | busy = True, error = Nothing }
                            , totpReplyAccount = Just acct
                          }
                        , [ SendLine line ]
                        )


{-| `TOTP DISABLE` (mirrors `totpDisable`: busy; the clearing
happens on the `disabled` notice).
-}
requestTotpDisable : Model -> ( Model, List Outbound )
requestTotpDisable model =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            if model.connection /= Live then
                ( model, [] )

            else
                let
                    current =
                        model.totp
                in
                ( { model
                    | totp = { current | busy = True, error = Nothing }
                    , totpReplyAccount = Just acct
                  }
                , [ SendLine Services.totpDisable ]
                )


{-| `TOTP STATUS` (mirrors `totpStatus`: context + send only, never
sets busy).
-}
requestTotpStatus : Model -> ( Model, List Outbound )
requestTotpStatus model =
    case model.accountName of
        Nothing ->
            ( model, [] )

        Just acct ->
            if model.connection /= Live then
                ( model, [] )

            else
                ( { model | totpReplyAccount = Just acct }
                , [ SendLine Services.totpStatus ]
                )


{-| Settle one server `TOTP:` notice body (mirrors the oracle
ladder: secret → otpauth → now-ACTIVE (clearing) → is-active →
pending → disabled (clearing) → authenticator-hint → ignore; every
arm drops busy, like the oracle's shared `{ ...st.totp, busy: false }`).
-}
settleTotpBody : TotpState -> String -> TotpState
settleTotpBody current body =
    case parseTotpSecret body of
        Just secret ->
            { current | secret = Just secret }

        Nothing ->
            if isTotpOtpauth body then
                { current | otpauth = Just body }

            else if containsFolded "now active" body then
                { current | status = TotpActive, secret = Nothing, otpauth = Nothing }

            else if endsWithFolded "is active" body then
                { current | status = TotpActive }

            else if containsFolded "pending" body then
                { current | status = TotpPending }

            else if containsFolded "disabled" body || containsFolded "was not enabled" body then
                { current | status = TotpDisabled, secret = Nothing, otpauth = Nothing }

            else if containsFolded "add this to your authenticator" body then
                { current | status = TotpPending }

            else
                current


{-| Fold a server `TOTP:` notice (`:server NOTICE me :TOTP: …`,
mirrors the oracle branch: presence-gated on the live TOTP reply
context — the Elm analog of the transport-currency check, matching
`foldRegisterNotice` — so stray bodies never touch `totp`; the
context survives notices and dies only on FAIL / auth transitions,
like the oracle's, and the text lands in the service log as
`Account: …`, mirroring `addServiceNotice('Account', text)`).
-}
foldTotpNotice : Model -> Wire.IrcMessage -> Maybe ( Model, List Outbound )
foldTotpNotice model message =
    case message.params of
        target :: text :: _ ->
            if message.nick /= Nothing || isChannelName model target then
                Nothing

            else if not (String.startsWith "TOTP:" text) then
                Nothing

            else
                case model.totpReplyAccount of
                    Nothing ->
                        Nothing

                    Just _ ->
                        let
                            body =
                                String.trim (String.dropLeft 5 text)

                            settled =
                                settleTotpBody model.totp body
                        in
                        Just
                            ( logService
                                { model | totp = { settled | busy = False } }
                                ("Account: " ++ text)
                            , []
                            )

        _ ->
            Nothing


{-| Resolve a terminal `FAIL TOTP` (mirrors the oracle arm: a
context-less FAIL is ignored; otherwise the context drops, busy
clears, and the error carries the server description with the
`TOTP command failed` fallback — state-only, like the oracle's
`return` before the generic service-notice line).
-}
foldTotpFail : Model -> Wire.StandardReply -> ( Model, List Outbound )
foldTotpFail model reply =
    case model.totpReplyAccount of
        Nothing ->
            ( model, [] )

        Just _ ->
            let
                current =
                    model.totp

                message =
                    if String.isEmpty reply.description then
                        "TOTP command failed"

                    else
                        reply.description
            in
            ( { model
                | totpReplyAccount = Nothing
                , totp = { current | busy = False, error = Just message }
              }
            , []
            )


requestIdentify : Model -> String -> String -> ( Model, List Outbound )
requestIdentify model account password =
    let
        acct =
            String.trim account
    in
    if model.connection /= Live then
        ( model, [] )

    else if String.isEmpty acct || String.isEmpty password then
        ( model, [] )

    else
        case Services.identify acct password of
            Nothing ->
                ( model, [] )

            Just line ->
                ( { model | accountActionError = Nothing, identifyReplyAccount = Just acct }
                , [ SendLine line ]
                )


{-| `GHOST <nick> <password>` — disconnect a stale session occupying a nick
that belongs to the caller's account (password-verified server-side;
`server.zig handleGhost`: success replies as a NOTICE, failure as numerics,
both surfacing through the normal message path). Mirrors the oracle
`ghost`: silent unless live (the `!client` guard). The in-session
reclaim dialog is `View.Topbar.reclaimDialog` (`submitReclaim`).
-}
ghostNick : Model -> String -> String -> List Outbound
ghostNick model nick password =
    if model.connection /= Live then
        []

    else
        [ SendLine (Wire.formatIrcLine "GHOST" [ nick, password ]) ]


{-| GHOST the stale session holding `nick`, then re-NICK to it. Mirrors
the oracle `reclaimNick`: trims, refuses a blank target (no lines, same as
the `false` return), otherwise emits GHOST immediately followed by NICK so
the periodic reclaim timer only has to cover the zombie-drain delay. The
password is intentionally never stored — `View.Topbar.reclaimDialog`
supplies it per attempt.
-}
reclaimNickWithPassword : Model -> String -> String -> List Outbound
reclaimNickWithPassword model nick password =
    let
        target =
            String.trim nick
    in
    if String.isEmpty target then
        []

    else if model.connection /= Live then
        []

    else
        [ SendLine (Wire.formatIrcLine "GHOST" [ target, password ])
        , SendLine (Wire.formatIrcLine "NICK" [ target ])
        ]


{-| `CERTADD` — bind the TLS client-cert fingerprint presented on this
connection to the logged-in account (`server.zig handleCertAdd`), enabling
future password-less SASL EXTERNAL logins. Takes no params; the server
fails (`FAIL CERTADD NO_CLIENT_CERT`) when the connection presented none.
Mirrors the oracle `certAdd`. `FAIL CERTADD` folds into
`accountActionError` with the other account commands.
-}
certAddLine : Model -> List Outbound
certAddLine model =
    if model.connection /= Live then
        []

    else
        [ SendLine (Wire.formatIrcLine "CERTADD" []) ]


{-| Owner comparison for `ACCOUNT` (mirroring the oracle's `_accountKey`:
trimmed, lowercased, empty collapses to `Nothing`). -}
accountOwnerKey : Maybe String -> Maybe String
accountOwnerKey value =
    case value of
        Nothing ->
            Nothing

        Just raw ->
            let
                normalized =
                    String.toLower (String.trim raw)
            in
            if String.isEmpty normalized then
                Nothing

            else
                Just normalized


retainedDraftLocked : Model -> Bool
retainedDraftLocked model =
    model.retiredDraftOwner /= Nothing


retainedDraftBlocksRuntimeAction : RuntimeDomain.Action -> Bool
retainedDraftBlocksRuntimeAction action =
    case action of
        RuntimeDomain.LoadDraft _ ->
            True

        RuntimeDomain.SaveDraft _ _ _ ->
            True

        RuntimeDomain.QueueMessage _ _ _ _ _ _ ->
            True

        RuntimeDomain.ScheduledCreate _ _ _ _ _ _ _ _ ->
            True

        RuntimeDomain.ScheduledEdit _ _ _ _ _ _ _ ->
            True

        RuntimeDomain.DraftDiscard _ _ ->
            True

        RuntimeDomain.DraftRecover _ ->
            True

        RuntimeDomain.DraftRecoveryList ->
            True

        _ ->
            False


draftRecoveryActionMatches : RuntimeDomain.Action -> Model -> Bool
draftRecoveryActionMatches action model =
    case action of
        RuntimeDomain.DraftRecover ref ->
            case ( model.activeChannel, model.draftRecoveryView ) of
                ( Just target, Just view ) ->
                    List.any (\item -> item.draftRef == ref && item.conversationId == target) view.items

                _ ->
                    False

        _ ->
            True


armRetainedDraftAutosaves : Model -> ( Model, List Outbound )
armRetainedDraftAutosaves model =
    case model.runtimeOwnerStamp of
        Nothing ->
            ( model, [] )

        Just stamp ->
            let
                revisions =
                    Dict.foldl
                        (\key _ current ->
                            if Dict.member key current then
                                current

                            else
                                Dict.insert key 1 current
                        )
                        model.composerDraftVersions
                        model.composerDrafts

                targetFor key =
                    model.channels
                        |> Dict.values
                        |> List.filter (\channel -> ircCaseKey model channel.name == key)
                        |> List.head
                        |> Maybe.map .name
                        |> Maybe.withDefault key

                autosaves =
                    model.composerDrafts
                        |> Dict.keys
                        |> List.filterMap
                            (\key ->
                                Dict.get key revisions
                                    |> Maybe.map
                                        (\revision ->
                                            RuntimeDraftAutosaveTimerStarted
                                                { target = targetFor key
                                                , revision = revision
                                                , delayMs = 100
                                                , ownerRef = stamp.ownerRef
                                                , accountGeneration = stamp.accountGeneration
                                                , connectionGeneration = stamp.connectionGeneration
                                                }
                                        )
                            )
            in
            ( { model | composerDraftVersions = revisions }, autosaves )


{-| Fold an `ACCOUNT` notify (mirroring the oracle arm: only our own
ACCOUNT describes the top-bar identity — a peer's, including a peer's
`ACCOUNT *` logout, is ignored so another user's logout can never flip
the local UI to Guest. `*` means logged out. An owner change drops the
old account's account-bound and message-derived state (own metadata
rows, custom status, sessions, topic history, ban transport, outbox
budget, channel buffers, DM shells, typing, edits, history cursors,
outgoing scheduled rows),
points SASL at the new account, reloads the new owner's identity
profile, re-projects our activity, and either reclaims an aliased nick
(`NICK` now plus retry) or stops a stale reclaim. Owned contact loads, the identity profile, and
`GroupPublisher.setAccount` (the `setAuthenticatedAccount` handoff)
run on this fold. Owner-scoped device slots reload when the friends
request announces the new owner and `DeviceSlotsLoaded` lands. -}
foldAccount : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldAccount model message =
    case ( message.nick, message.params ) of
        ( Just nick, raw :: _ ) ->
            if String.toLower nick /= String.toLower model.ourNick then
                ( model, [] )

            else
                let
                    next =
                        if raw == "*" then
                            Nothing

                        else
                            GroupPublisher.canonicalAccount (Just raw)

                    ownerChanged =
                        accountOwnerKey model.accountName /= accountOwnerKey next

                    -- An owner change retires the outgoing identity's
                    -- scheduled rows so their plaintext bodies never
                    -- linger in storage (mirroring the
                    -- `_resetAccountPrivateMessageState` purge). The
                    -- history vault stays owner-namespaced, matching
                    -- the oracle, which does not delete it here.
                    ( unpurged, purgeOut ) =
                        if ownerChanged then
                            purgeScheduledForOwner model (scheduleOwner model)

                        else
                            ( model, [] )

                    reset =
                        if ownerChanged then
                            let
                                quarantined =
                                    quarantineOwnerChange unpurged
                            in
                            { quarantined | saslAccount = next }

                        else
                            model

                    based =
                        { reset
                            | accountName = next
                            -- Accepted login drops any pending identify
                            -- reply context so a later unrelated 464
                            -- cannot be attributed to it.
                            , identifyReplyAccount = Nothing
                            -- A new login generation retires any live
                            -- TOTP leg with it, mirroring the oracle's
                            -- reply-context invalidation.
                            , totpReplyAccount = Nothing
                            , keytransReplyAccount = Nothing
                            , certReplyAccount = Nothing
                            , vhostReplyAccount = Nothing
                            , accountInfoReplyAccount = Nothing
                            , currentNickIsAlias =
                                case next of
                                    Just account ->
                                        String.toLower reset.ourNick /= String.toLower account

                                    Nothing ->
                                        False
                        }

                    ( withProfile, profileOutbound ) =
                        requestIdentityProfile model.identityProfileOwner based

                    synced =
                        syncOwnCustomStatusActivity withProfile Nothing

                    -- An account switch quarantines the old identity's
                    -- MONITOR subscriptions: clear remote and subscribe
                    -- the new union, mirroring the oracle's clearRemote
                    -- replace on identity change. The fresh union
                    -- backfills as the owned contact loads land (each
                    -- re-subscribes additively).
                    ( withMonitor, monitorOut ) =
                        if ownerChanged then
                            syncMonitorContacts True synced

                        else
                            ( synced, [] )
                in
                let
                    ( handed, handOut ) =
                        if withMonitor.currentNickIsAlias then
                            case next of
                                Just account ->
                                    let
                                        ( reclaimed, reclaimOut ) =
                                            startNickReclaim withMonitor account
                                    in
                                    ( reclaimed, purgeOut ++ profileOutbound ++ reclaimOut ++ monitorOut )

                                Nothing ->
                                    ( stopNickReclaim withMonitor, purgeOut ++ profileOutbound ++ monitorOut )

                        else
                            ( stopNickReclaim withMonitor, purgeOut ++ profileOutbound ++ monitorOut )

                    -- Load after the new account is installed, so the
                    -- storage key is not still the previous owner.
                    ( withNav, navOut ) =
                        if ownerChanged then
                            takeNavigationLoad handed

                        else
                            ( handed, [] )
                in
                ( withNav, handOut ++ navOut )

        _ ->
            ( model, [] )


{-| Fold a live NICK (mirroring the oracle arm, plus the
`_syncOwnCustomStatusActivity` rekey on a self-change; a self-change
also reloads the new owner's identity profile, so a changed owner
emits an `IdentityProfileRequest`). -}
foldNick : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldNick model message =
    case ( message.nick, message.params ) of
        ( Just oldNick, newNick :: _ ) ->
            if not (validWireToken oldNick 256) || not (validWireToken newNick 256) then
                ( model, [] )

            else
                let
                    selfChanged =
                        ircCaseKey model oldNick == ircCaseKey model model.ourNick

                    withSelf =
                        if selfChanged then
                            -- A rename to Guest<digits> we never asked
                            -- for is the server's nick ENFORCEMENT
                            -- evicting us from a protected nick; like
                            -- any account-mismatched nick it counts as
                            -- an alias instead of silently becoming it.
                            let
                                aliased =
                                    forcedGuestRename oldNick newNick
                                        || (case model.accountName of
                                                Just account ->
                                                    String.toLower newNick /= String.toLower account

                                                Nothing ->
                                                    False
                                           )

                                -- A forced guest rename (ENFORCEMENT evicting us
                                -- from a protected nick) also says what
                                -- happened: an error toast plus a system
                                -- inbox notice, mirroring the oracle NICK
                                -- arm. Account-mismatch aliases stay silent.
                                enforced =
                                    forcedGuestRename oldNick newNick

                                renamed =
                                    stopNickReclaim
                                        (syncOwnCustomStatusActivity
                                            { model
                                                | ourNick = newNick
                                                , currentNickIsAlias = aliased
                                                , connectionNickDraft = newNick
                                                , connectionNickPending = Nothing
                                                , connectionNickNotice =
                                                    if Maybe.map String.toLower model.connectionNickPending == Just (String.toLower newNick) then Just ("Your chat name is now " ++ newNick ++ ".") else Nothing
                                                , connectionDialogError = Nothing
                                            }
                                            (Just oldNick)
                                        )

                                announced =
                                    if enforced then
                                        addNotification
                                            (addToast
                                                { variant = ToastError
                                                , title = "Renamed to " ++ newNick
                                                , description = Just (oldNick ++ " is a protected nick — sign in to the account to use it.")
                                                , duration = Nothing
                                                , groupKey = Nothing
                                                , undo = Nothing
                                                }
                                                model.nowMs
                                                renamed
                                            )
                                            { kind = NotifSystem
                                            , text = "The server renamed you to " ++ newNick ++ ": \u{201C}" ++ oldNick ++ "\u{201D} is protected. Sign in (or /IDENTIFY) to reclaim it."
                                            , from = Nothing
                                            , channel = Nothing
                                            , topic = Nothing
                                            }

                                    else
                                        renamed
                            in
                            announced

                        else
                            model

                    rename key acc =
                        case Dict.get key acc.channels of
                            Just channel ->
                                case Dict.get (ircCaseKey acc oldNick) channel.members of
                                    Just member ->
                                        includeBurstNick
                                            (excludeBurstNick
                                                (addChannelEvent
                                                    (appendLiveRow
                                                        { acc
                                                            | channels =
                                                                Dict.insert key
                                                                    { channel
                                                                        | members =
                                                                            Dict.insert (ircCaseKey acc newNick)
                                                                                { member | nick = newNick }
                                                                                (Dict.remove (ircCaseKey acc oldNick) channel.members)
                                                                    }
                                                                    acc.channels
                                                        }
                                                        channel.name
                                                        (oldNick ++ " → " ++ newNick)
                                                        message
                                                    )
                                                    channel.name
                                                    EventNick
                                                    oldNick
                                                    (oldNick ++ " → " ++ newNick)
                                                )
                                                channel.name
                                                oldNick
                                            )
                                            channel.name
                                            newNick

                                    Nothing ->
                                        acc

                            Nothing ->
                                acc
                in
                let
                    renamed =
                        List.foldl rename withSelf (Dict.keys withSelf.channels)
                in
                if selfChanged then
                    -- A self-rename can retire the schedule owner
                    -- (a guest nick IS the identity, so any guest
                    -- rename changes it; an authenticated rename
                    -- keeps the account owner): purge the outgoing
                    -- identity's rows, mirroring the oracle NICK arm.
                    let
                        outgoing =
                            scheduleOwner model

                        ( unpurged, purgeOut ) =
                            if scheduleOwner renamed /= outgoing then
                                purgeScheduledForOwner renamed outgoing

                            else
                                ( renamed, [] )

                        -- A self-rename that changes the device-memory
                        -- owner (guest-to-guest, or any auth-status flip)
                        -- quarantines the old identity exactly like the
                        -- oracle NICK arm, then resubscribes MONITOR for
                        -- the new one.
                        ownerChanged =
                            deviceMemoryOwner unpurged /= deviceMemoryOwner model

                        quarantined =
                            if ownerChanged then
                                quarantineOwnerChange unpurged

                            else
                                unpurged

                        ( withProfile, profileOut ) =
                            requestIdentityProfile model.identityProfileOwner quarantined

                        ( withMonitor, monitorOut ) =
                            if ownerChanged then
                                syncMonitorContacts True withProfile

                            else
                                ( withProfile, [] )

                        ( withNav, navOut ) =
                            if ownerChanged then
                                takeNavigationLoad withMonitor

                            else
                                ( withMonitor, [] )
                    in
                    ( withNav, purgeOut ++ profileOut ++ monitorOut ++ navOut )

                else
                    ( renamed, [] )

        _ ->
            ( model, [] )


{-| Fold a live KICK (mirroring the oracle arm: token validation,
replay already diverted above, self-kick drops the whole room and
deactivates it, other kicks drop the member only when present with
a kick event, and the kick audit plus `KICK` moderation entry land
either way). -}
foldKick : Model -> Wire.IrcMessage -> Model
foldKick model message =
    case message.params of
        ch :: target :: rest ->
            let
                actor =
                    Maybe.withDefault "server" message.nick

                reason =
                    boundSystemEventText (Maybe.withDefault "" (List.head rest))
            in
            if
                not (validWireToken ch 512)
                    || not (validWireToken target 256)
                    || not (validWireToken actor 256)
                    || not (isChannelName model ch)
            then
                model

            else
                let
                    key =
                        String.toLower ch

                    removed =
                        case Dict.get key model.channels of
                            Just channel ->
                                Dict.member (String.toLower target) channel.members

                            Nothing ->
                                False

                    afterRoster =
                        if String.toLower target == String.toLower model.ourNick then
                            { model
                                | channels = Dict.remove key model.channels
                                , firstUnreadId = Dict.remove key model.firstUnreadId
                                , namesBursts = Dict.remove key model.namesBursts
                                , lastRosterRefresh = Dict.remove key model.lastRosterRefresh
                                , activeChannel =
                                    case model.activeChannel of
                                        Just active ->
                                            if String.toLower active == key then
                                                Nothing

                                            else
                                                model.activeChannel

                                        Nothing ->
                                            Nothing
                            }

                        else if removed then
                            excludeBurstNick
                                (updateChannel model ch
                                    (\c -> { c | members = Dict.remove (String.toLower target) c.members })
                                )
                                ch
                                target

                        else
                            model

                    withEvent =
                        if removed && String.toLower target /= String.toLower model.ourNick then
                            addChannelEvent
                                (appendLiveRow afterRoster
                                    ch
                                    (kickRowText target actor reason)
                                    message
                                )
                                ch
                                EventKick
                                target
                                (kickEventText target actor reason)

                        else
                            afterRoster

                    withAudit =
                        addAuditEntry withEvent
                            AuditKick
                            actor
                            (Just target)
                            (Just ch)
                            (Just reason)
                in
                addModerationEntry withAudit "KICK" target actor ch

        _ ->
            model


{-| KICK event text (`target was kicked by actor (reason)` /
`target was kicked by actor`). -}
kickEventText : String -> String -> String -> String
kickEventText target actor reason =
    if String.isEmpty reason then
        target ++ " was kicked by " ++ actor

    else
        target ++ " was kicked by " ++ actor ++ " (" ++ reason ++ ")"


{-| KICK row text (`actor kicked target: reason` / `actor kicked
target` — the row keeps the colon form while the event
parenthesizes). -}
kickRowText : String -> String -> String -> String
kickRowText target actor reason =
    if String.isEmpty reason then
        actor ++ " kicked " ++ target

    else
        actor ++ " kicked " ++ target ++ ": " ++ reason


{-| Fold an inbound channel `RENAME` (mirroring the oracle: both names
required, the old room must exist, and its record moves under the new
key with a bounded rename note appended; the active target, unread
anchor, notify level (+persisted), props, history sets, typing, and
read markers move with it — like the oracle, which emits no
audit/moderation/event entries for a rename). -}
foldRename : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldRename model message =
    case message.params of
        oldName :: newName :: rest ->
            let
                actor =
                    Maybe.withDefault "server" message.nick

                reason =
                    boundSystemEventText (reasonParam rest)
            in
            if
                not (validWireToken oldName 512)
                    || not (validWireToken newName 512)
                    || not (validWireToken actor 256)
                    || not (isChannelName model oldName)
                    || not (isChannelName model newName)
            then
                ( model, [] )

            else
                case Dict.get (String.toLower oldName) model.channels of
                    Nothing ->
                        ( model, [] )

                    Just _ ->
                        let
                            oldKey =
                                String.toLower oldName

                            newKey =
                                String.toLower newName

                            renamer =
                                actor

                            note =
                                boundSystemEventText
                                    (renamer
                                        ++ " renamed "
                                        ++ oldName
                                        ++ " → "
                                        ++ newName
                                        ++ (if String.isEmpty reason then
                                                ""

                                            else
                                                " (" ++ reason ++ ")"
                                           )
                                    )

                            noted =
                                appendLiveRow model oldName note message

                            movedChannels =
                                case Dict.get oldKey noted.channels of
                                    Just channel ->
                                        Dict.insert newKey
                                            { channel | name = newName }
                                            (Dict.remove oldKey noted.channels)

                                    Nothing ->
                                        noted.channels

                            moveEntry dict =
                                case Dict.get oldKey dict of
                                    Just value ->
                                        Dict.insert newKey value (Dict.remove oldKey dict)

                                    Nothing ->
                                        dict

                            moveMember set =
                                if Set.member oldKey set then
                                    Set.insert newKey (Set.remove oldKey set)

                                else
                                    set

                            props =
                                noted.props

                            moved =
                                { noted
                                    | channels = movedChannels
                                    , activeChannel =
                                        case noted.activeChannel of
                                            Just active ->
                                                if String.toLower active == oldKey then
                                                    Just newKey

                                                else
                                                    noted.activeChannel

                                            Nothing ->
                                                Nothing
                                    , firstUnreadId = moveEntry noted.firstUnreadId
                                    , channelNotify = moveEntry noted.channelNotify
                                    , typingUsers = moveEntry noted.typingUsers
                                    , readMarkers = moveEntry noted.readMarkers
                                    , historyLoading = moveMember noted.historyLoading
                                    , pendingHistoryRequests = moveEntry noted.pendingHistoryRequests
                                    , historyExhausted = moveMember noted.historyExhausted
                                    , props = { props | channelProps = moveEntry props.channelProps }
                                }
                        in
                        ( moved
                        , [ ChannelNotifySave
                                { entries =
                                    List.map
                                        (\( ch, lv ) -> { channel = ch, level = lv })
                                        (Dict.toList moved.channelNotify)
                                }
                          ]
                        )

        _ ->
            ( model, [] )


foldMode : Model -> Wire.IrcMessage -> Model
foldMode model message =
    case message.params of
        target :: rest ->
            let
                modeStr =
                    Maybe.withDefault "" (List.head rest)

                modeArgs =
                    Maybe.withDefault [] (List.tail rest)

                modeText =
                    boundSystemEventText (String.join " " rest)

                actor =
                    Maybe.withDefault "server" message.nick
            in
            if isChannelName model target then
                if Dict.member (String.toLower target) model.channels then
                    let
                        row =
                            { id = model.messageSeq
                            , from = ""
                            , body = actor ++ " set mode " ++ modeText
                            , whisper = False
                            , audience = Nothing
                            , highlight = False
                            , outboxId = Nothing
                            , pending = False
                            , plaintext = Nothing
                            , at = rowTime model message
                            , msgid = Nothing
                            , reactions = []
                            , edited = False
                            , deleted = False
                            , redacted = False
                            , topic = ""
                            , msgType = "mode"
                            , replyTo = Nothing
                            }

                        folded =
                            updateChannel { model | messageSeq = model.messageSeq + 1 } target
                                (\c ->
                                    { c
                                        | modes =
                                            Modes.applyChannelModeDelta c.modes
                                                modeStr
                                                modeArgs
                                                model.isupport.chanGroups
                                                (Set.fromList (Dict.keys model.isupport.modeToPrefix))
                                        , members = foldStatusModes model c modeStr modeArgs
                                        , messages = List.take (messageRetentionFor model target) (row :: c.messages)
                                    }
                                )
                    in
                    foldModeEntries folded target modeStr modeArgs actor modeText
                        |> (\withAudit -> settleStewardTransferModeEcho withAudit message target modeStr modeArgs)

                else
                    -- A delayed or unsolicited MODE for a room outside
                    -- the live session must not seed channel state.
                    model

            else if String.toLower target == String.toLower model.ourNick then
                foldOwnUserMode model message modeStr modeText

            else
                model

        _ ->
            model


{-| Authoritative channel modes (`324 me #chan +modes [args…]`,
mirroring `RPL_CHANNELMODEIS`): rebuilds from empty so the reply is
fully authoritative, and only touches rooms already in the live
session — never seeds. Silent: no row, no toast, no outbounds. -}
foldChannelModeIs : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldChannelModeIs model message =
    case message.params of
        _ :: rawTarget :: rest ->
            if isChannelName model rawTarget && Dict.member (String.toLower rawTarget) model.channels then
                let
                    modeStr =
                        Maybe.withDefault "" (List.head rest)

                    modeArgs =
                        Maybe.withDefault [] (List.tail rest)

                    rebuilt =
                        Modes.applyChannelModeDelta ""
                            modeStr
                            modeArgs
                            model.isupport.chanGroups
                            (Set.fromList (Dict.keys model.isupport.modeToPrefix))
                in
                ( updateChannel model rawTarget (\c -> { c | modes = rebuilt }), [] )

            else
                ( model, [] )

        _ ->
            ( model, [] )


{-| Room creation time (`329 me #chan <unix>`, mirroring
`RPL_CREATIONTIME`): strict digits-only stamp within
`[1, 4102444800]`, stored as ms; unknown rooms and bad stamps drop
silently. -}
foldCreationTime : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldCreationTime model message =
    case message.params of
        _ :: rawTarget :: rest ->
            case ( List.head rest, Dict.get (String.toLower rawTarget) model.channels ) of
                ( Just stamp, Just _ ) ->
                    case parseBoundedUnix stamp of
                        Just unix ->
                            if unix <= 0 then
                                ( model, [] )

                            else
                                ( updateChannel model rawTarget (\c -> { c | createdAt = Just (unix * 1000) }), [] )

                        Nothing ->
                            ( model, [] )

                _ ->
                    ( model, [] )

        _ ->
            ( model, [] )


{-| Strict unsigned stamp (mirroring `boundedUnsignedInteger`:
digits-only, no leading zeros except `0` itself, safe, within max). -}
parseBoundedUnix : String -> Maybe Int
parseBoundedUnix value =
    let
        chars =
            String.toList value

        digitsOnly =
            not (List.isEmpty chars) && List.all (\c -> c >= '0' && c <= '9') chars

        canonical =
            value == "0"
                || (case List.head chars of
                        Just head ->
                            head >= '1' && head <= '9'

                        Nothing ->
                            False
                   )
    in
    if digitsOnly && canonical then
        case String.toInt value of
            Just n ->
                if n >= 0 && n <= maxCreationUnix then
                    Just n

                else
                    Nothing

            Nothing ->
                Nothing

    else
        Nothing


{-| Newest creation stamp the server attests (mirroring the 329
`boundedUnsignedInteger(_, 4_102_444_800)` ceiling). -}
maxCreationUnix : Int
maxCreationUnix =
    4102444800


{-| Own user MODE (`MODE <ownnick> ...`): `+o` raises the oper badge,
`-o` clears it together with the network-admin badge (a label that
outlives the privilege would keep presenting admin UI from a
downgraded session), and every self MODE lands one server-log line —
mirroring the oracle branch line for line. -}
foldOwnUserMode : Model -> Wire.IrcMessage -> String -> String -> Model
foldOwnUserMode model message modeStr modeText =
    let
        operSet =
            if String.contains "+" modeStr && String.contains "o" modeStr then
                { model | isOper = True }

            else
                model

        withOper =
            if String.contains "-" modeStr && String.contains "o" modeStr then
                { operSet | isOper = False, isNetworkAdmin = False }

            else
                operSet

        byWhom =
            case message.nick of
                Just nick ->
                    if String.toLower nick /= String.toLower model.ourNick then
                        nick ++ " set "

                    else
                        ""

                Nothing ->
                    ""

        line =
            String.trim (byWhom ++ "your user mode: " ++ modeText)
    in
    { withOper | serviceLog = List.take maxServiceLog (line :: withOper.serviceLog) }


foldStatusModes : Model -> Channel -> String -> List String -> Dict String Member
foldStatusModes model channel modeStr args =
    let
        prefixModes =
            Set.fromList (Dict.keys model.isupport.modeToPrefix)

        go letters adding argRest members =
            case letters of
                [] ->
                    members

                ch :: tail ->
                    if ch == '+' then
                        go tail True argRest members

                    else if ch == '-' then
                        go tail False argRest members

                    else if Set.member ch prefixModes then
                        case argRest of
                            nick :: nickRest ->
                                go tail adding nickRest
                                    (applyStatus members nick ch adding)

                            [] ->
                                go tail adding [] members

                    else
                        let
                            -- Ban masks always consume an argument even
                            -- before ISUPPORT's CHANMODES tuple arrives.
                            consumes =
                                ch == 'b' || Modes.modeConsumesArg model.isupport.chanGroups prefixModes ch adding
                        in
                        go tail adding
                            (if consumes then
                                List.drop 1 argRest

                             else
                                argRest
                            )
                            members
    in
    go (String.toList modeStr) True args channel.members


applyStatus : Dict String Member -> String -> Char -> Bool -> Dict String Member
applyStatus members nick mode adding =
    case Dict.get (String.toLower nick) members of
        Nothing ->
            members

        Just member ->
            Dict.insert (String.toLower nick)
                { member
                    | modes =
                        if adding then
                            Set.insert mode member.modes

                        else
                            Set.remove mode member.modes
                }
                members


{-| Audit/moderation/event entries for a live channel MODE (mirroring
the oracle second walk: ban masks log `ban`/`unban` audits plus
`BAN`/`UNBAN` moderation rows; status grants on present members log
`GRANT`/`TAKE`; `z` and other status letters log a `MODE` action;
any non-ban change logs one `mode` audit; and the change lands a
`mode` channel event. Ban rows themselves arrive on 367/368.). -}
foldModeEntries : Model -> String -> String -> List String -> String -> String -> Model
foldModeEntries model target modeStr modeArgs actor modeText =
    let
        prefixModes =
            Set.fromList (Dict.keys model.isupport.modeToPrefix)

        members =
            case Dict.get (String.toLower target) model.channels of
                Just channel ->
                    channel.members

                Nothing ->
                    Dict.empty

        walk letters adding argRest sawBan sawOther acc =
            case letters of
                [] ->
                    ( acc, sawBan, sawOther )

                ch :: tail ->
                    if ch == '+' then
                        walk tail True argRest sawBan sawOther acc

                    else if ch == '-' then
                        walk tail False argRest sawBan sawOther acc

                    else
                        let
                            consumes =
                                ch == 'b' || Modes.modeConsumesArg model.isupport.chanGroups prefixModes ch adding

                            arg =
                                if consumes then
                                    List.head argRest

                                else
                                    Nothing

                            nextArgs =
                                if consumes then
                                    Maybe.withDefault [] (List.tail argRest)

                                else
                                    argRest
                        in
                        if ch == 'b' then
                            let
                                mask =
                                    Maybe.withDefault "" arg

                                detail =
                                    String.trim ((if adding then "+" else "-") ++ "b " ++ mask)

                                audited =
                                    addAuditEntry acc
                                        (if adding then
                                            AuditBan

                                         else
                                            AuditUnban
                                        )
                                        actor
                                        arg
                                        (Just target)
                                        (Just detail)

                                moderated =
                                    addModerationEntry audited
                                        (if adding then
                                            "BAN"

                                         else
                                            "UNBAN"
                                        )
                                        mask
                                        actor
                                        target

                                tracked =
                                    applyLiveBan moderated target adding mask actor
                            in
                            -- A pure ban logs only the ban audit: the
                            -- trailing `mode` audit fires on non-ban
                            -- changes (or mixed lines), mirroring the
                            -- oracle `sawBan`/`sawOtherMode` pair exactly.
                            walk tail adding nextArgs True sawOther tracked

                        else
                            let
                                userExists =
                                    case arg of
                                        Just nick ->
                                            Dict.member (String.toLower nick) members

                                        Nothing ->
                                            False

                                moderated =
                                    case arg of
                                        Just nick ->
                                            if Set.member ch prefixModes && userExists then
                                                addModerationEntry acc
                                                    ((if adding then
                                                        "GRANT +"

                                                      else
                                                        "TAKE +"
                                                     )
                                                        ++ String.fromChar ch
                                                    )
                                                    nick
                                                    actor
                                                    target

                                            else if ch == 'z' || Set.member ch prefixModes then
                                                addModerationEntry acc
                                                    "MODE"
                                                    ((if adding then
                                                        "+"

                                                      else
                                                        "-"
                                                     )
                                                        ++ String.fromChar ch
                                                        ++ " "
                                                        ++ nick
                                                    )
                                                    actor
                                                    target

                                            else
                                                acc

                                        Nothing ->
                                            if ch == 'z' || Set.member ch prefixModes then
                                                addModerationEntry acc
                                                    "MODE"
                                                    ((if adding then
                                                        "+"

                                                      else
                                                        "-"
                                                     )
                                                        ++ String.fromChar ch
                                                    )
                                                    actor
                                                    target

                                            else
                                                acc
                            in
                            walk tail adding nextArgs sawBan True moderated

        ( withMods, _, sawOtherMode ) =
            walk (String.toList modeStr) True modeArgs False False model

        withAudit =
            if sawOtherMode then
                addAuditEntry withMods AuditMode actor Nothing (Just target) (Just modeText)

            else
                withMods
    in
    addChannelEvent withAudit target EventMode actor (actor ++ " set mode " ++ modeText)


{-| Live-conversation matches for the open panel (mirroring the
hook's `results`: the active channel's rows through the bounded
live filter; anything else scopes server/vault tiers, which stay
ahead). -}
searchResults : Model -> List Search.SearchResult
searchResults model =
    case model.activeChannel of
        Nothing ->
            []

        Just name ->
            case Dict.get (String.toLower name) model.channels of
                Nothing ->
                    []

                Just channel ->
                    Search.filterLive model.searchQuery channel.messages


{-| Device-only lexical pivots for the open panel (mirroring
`recallSuggestions` over live results; vault hits join the input
once vault recall lands). -}
searchRecallTerms : Model -> List String
searchRecallTerms model =
    Search.recallSuggestions model.searchQuery (List.map .text (searchResults model) ++ List.map .text (vaultHits model))


{-| Minimum trimmed query length before device-memory search runs
(mirrors the `query.length < 2` idle gate). -}
vaultSearchMinChars : Int
vaultSearchMinChars =
    2


{-| Debounce between keystrokes and the IndexedDB scan (mirrors the
200ms `vaultTimer`). -}
vaultSearchDebounceMs : Float
vaultSearchDebounceMs =
    200


{-| Raw hits requested per scan (mirrors `searchVault(query, 80)`). -}
vaultSearchLimit : Int
vaultSearchLimit =
    80


{-| Hits shown after loaded-row de-dupe (mirrors the `.slice(0, 25)`). -}
vaultHitsShown : Int
vaultHitsShown =
    25


{-| Fire the debounced scan once its deadline passes (the Tick sets
`dueAt` to 0 so later ticks do not refire while the response is in
flight; the echoed `seq` drops stale arrivals). -}
vaultSearchFire : Model -> ( Model, List Outbound )
vaultSearchFire model =
    if model.searchOpen && model.vaultStatus == VaultSearchPending && model.vaultSearchDueAt > 0 && model.nowMs >= model.vaultSearchDueAt then
        let
            fields = runtimeOwnerFields model
        in
        ( { model | vaultSearchDueAt = 0 }
        , [ VaultSearch
                { query = model.vaultSearchQuery
                , limit = vaultSearchLimit
                , seq = model.vaultSearchSeq
                , mode = vaultSearchModeToString model.vaultSearchMode
                , activeTarget = model.activeChannel
                , selfNick = model.ourNick
                , nowMs = model.nowMs
                , ownerRef = fields.ownerRef
                , accountGeneration = fields.accountGeneration
                , connectionGeneration = fields.connectionGeneration
                }
          ]
        )

    else
        ( model, [] )


{-| Arm (or clear) the debounced device-memory scan for the current
query. Short/closed queries idle and clear, mirroring the effect's
early return; otherwise the status goes pending immediately while the
previous hits stay visible until the new scan resolves. -}
scheduleVaultSearch : Model -> Model
scheduleVaultSearch model =
    let
        query =
            String.trim model.searchQuery
    in
    if not model.searchOpen || String.length query < vaultSearchMinChars then
        { model | vaultRawHits = [], vaultStatus = VaultSearchIdle, vaultSearchDueAt = 0, vaultSearchQuery = "" }

    else
        { model
            | vaultStatus = VaultSearchPending
            , vaultSearchSeq = model.vaultSearchSeq + 1
            , vaultSearchDueAt = model.nowMs + vaultSearchDebounceMs
            , vaultSearchQuery = query
        }


{-| Invalidate any scheduled or in-flight scan (mirrors the effect
cleanup on close: timer cleared, abort fired, sequence bumped so a late
response drops). -}
invalidateVaultSearch : Model -> Model
invalidateVaultSearch model =
    { model | vaultRawHits = [], vaultStatus = VaultSearchIdle, vaultSearchSeq = model.vaultSearchSeq + 1, vaultSearchDueAt = 0, vaultSearchQuery = "" }


{-| Project one scanned row onto a hit, dropping ciphertext envelopes
for non-channel (DM) targets — mirrors the oracle's post-limit filter
(channel targets may legitimately discuss envelope prefixes in
plaintext, so only DM-shaped targets drop envelope text). -}
vaultHitFromRow : Model -> String -> VaultRow -> Maybe VaultHit
vaultHitFromRow model query row =
    if String.isEmpty row.id || String.isEmpty row.target then
        Nothing

    else if (DmCipher.isEnvelope row.body || GroupEnvelope.isGroupEnvelope row.body) && not (isChannelName model row.target) then
        Nothing

    else
        Just
            { id = row.id
            , from = row.from
            , text = Search.resultText row.body query
            , at = row.at
            , target = row.target
            }


{-| Device-memory hits with live-loaded rows de-duped (mirrors
`vaultHits`, sliced to 25). Reactive: incoming messages re-filter
cheaply without re-running the scan. Narrowing: the oracle compares
stable string ids (`target + "\\n" + id` — server msgids survive its
merges), but Elm re-indexes rows to `Int` on every merge, so the
vault row id never equals a live id. Dedupe instead compares the
vault row's trailing `:seq` (via `rowSeq`) against live `Int` ids on
the same target — exact for same-session persist-then-scan overlap;
a restored-then-rescanned row can over-dedupe on a seq collision. -}
vaultHits : Model -> List VaultHit
vaultHits model =
    let
        activeTarget =
            Maybe.map String.toLower model.activeChannel

        liveIds =
            case model.activeChannel of
                Nothing ->
                    Set.empty

                Just name ->
                    case Dict.get (String.toLower name) model.channels of
                        Nothing ->
                            Set.empty

                        Just channel ->
                            List.map .id channel.messages
                                |> Set.fromList

        loaded hit =
            case activeTarget of
                Nothing ->
                    False

                Just target ->
                    if String.toLower hit.target /= target then
                        False

                    else
                        case rowSeq target hit.id of
                            Just seq ->
                                Set.member seq liveIds

                            Nothing ->
                                False
    in
    List.filter (\hit -> not (loaded hit)) model.vaultRawHits
        |> List.take vaultHitsShown


{-| Accessible device-memory progress line (mirrors
`vaultLifecycleLabel`: pending names the query, done names the hit
count, error reports failure). -}
vaultStatusLabel : Model -> String
vaultStatusLabel model =
    let
        query =
            String.trim model.searchQuery
    in
    if String.isEmpty query || String.length query < vaultSearchMinChars then
        ""

    else
        case model.vaultStatus of
            VaultSearchIdle ->
                ""

            VaultSearchPending ->
                "Searching device memory for " ++ Search.announcedQuery query ++ "."

            VaultSearchError ->
                "Device-memory search could not be completed."

            VaultSearchIncomplete ->
                "Device-memory search is incomplete because a target’s retention policy is unknown."

            VaultSearchDone ->
                let
                    count =
                        List.length (vaultHits model)
                in
                if count == 0 then
                    "Device-memory search complete with no remembered matches."

                else
                    "Device-memory search complete with " ++ String.fromInt count ++ " remembered match" ++ (if count == 1 then
                        "."

                     else
                        "es."
                    )


{-| Highlighted match id, if the panel is open on a live match
(mirroring `activeResultId`). -}
searchActiveId : Model -> Maybe Int
searchActiveId model =
    if not model.searchOpen then
        Nothing

    else
        let
            results =
                searchResults model
        in
        List.drop (Search.clampIndex (List.length results) model.searchIndex) results
            |> List.head
            |> Maybe.map .id


{-| Earlier-paging growth step (mirroring `WINDOW_STEP_ROWS`:
the tail capacity grows by this much per reveal, up to the
render ceiling; off-tail pages page instead of growing). -}
threadWindowStep : Int
threadWindowStep =
    200


{-| Re-open the live trailing window (mirroring the
conversation-switch reset: base capacity, no explicit page; fresh
opens may use the unread anchor again). -}
resetThreadWindow : Model -> Model
resetThreadWindow model =
    { model
        | threadFollowing = True
        , threadWindowSize = MessageWindow.defaultWindowSize
        , threadPageStart = Nothing
        , ignoreUnreadAnchor = False
        , forceUnreadNav = False
        , historyLanding = Nothing
    }


{-| Explicitly sending or returning to latest overrides old reading anchors. -}
resumeLatestReading : Model -> Model
resumeLatestReading model =
    let
        trailed = resetThreadWindow model
    in
    invalidateVaultSearch { trailed | ignoreUnreadAnchor = True, searchOpen = False }


{-| Chronological position of one row id (Elm buffers newest-first;
window indices count from the oldest row, like the oracle). -}
threadRowIndex : List ChatMessage -> Int -> Maybe Int
threadRowIndex newestFirst rowId =
    let
        total =
            List.length newestFirst

        go pos remaining =
            case remaining of
                [] ->
                    Nothing

                row :: rest ->
                    if row.id == rowId then
                        Just (total - 1 - pos)

                    else
                        go (pos + 1) rest
    in
    go 0 newestFirst


threadChronologicalRowIndex : List ChatMessage -> Int -> Maybe Int
threadChronologicalRowIndex chronological rowId =
    let
        go pos found remaining =
            case remaining of
                [] ->
                    found

                row :: rest ->
                    go
                        (pos + 1)
                        (if row.id == rowId then
                            Just pos

                         else
                            found
                        )
                        rest
    in
    go 0 Nothing chronological


{-| The single must-show row for a conversation window (mirroring
the anchor memo: active search hit, then a time-travel landing whose
msgid is already a chat row, then the unread divider while the feed
is in live-tail mode or an explicit New jump set `forceUnreadNav`). -}
threadAnchorIndex : Model -> Channel -> Maybe Int
threadAnchorIndex model channel =
    let
        indexOfRow =
            threadRowIndex channel.messages

        searchIdx =
            Maybe.andThen indexOfRow (searchActiveId model)

        landingIdx =
            model.historyLanding
                |> Maybe.andThen (\wanted -> List.filter (\row -> row.msgid == Just wanted) channel.messages |> List.head)
                |> Maybe.andThen (\row -> indexOfRow row.id)

        unreadIdx =
            if model.ignoreUnreadAnchor then
                Nothing

            else
                case model.activeChannel of
                    Nothing ->
                        Nothing

                    Just active ->
                        -- The captured divider wins over the live
                        -- first-unread id.
                        case Dict.get (String.toLower active) model.viewUnreadDividerId of
                            Just dividerId ->
                                indexOfRow dividerId

                            Nothing ->
                                Maybe.andThen indexOfRow (Dict.get (String.toLower active) model.firstUnreadId)
    in
    MessageWindow.selectMessageAnchorIndex
        { searchIndex = Maybe.map toFloat searchIdx
        , landingIndex = Maybe.map toFloat landingIdx
        , unreadIndex = Maybe.map toFloat unreadIdx
        , pageStart = Maybe.map toFloat model.threadPageStart
        , forceUnread = model.forceUnreadNav
        }


threadAnchorIndexForChronological : Model -> List ChatMessage -> Maybe Int
threadAnchorIndexForChronological model chronological =
    let
        indexOfRow =
            threadChronologicalRowIndex chronological

        searchIdx =
            Maybe.andThen indexOfRow (searchActiveId model)

        landingIdx =
            model.historyLanding
                |> Maybe.andThen
                    (\wanted ->
                        List.foldl
                            (\row found ->
                                if row.msgid == Just wanted then
                                    Just row

                                else
                                    found
                            )
                            Nothing
                            chronological
                    )
                |> Maybe.andThen (\row -> indexOfRow row.id)

        unreadIdx =
            if model.ignoreUnreadAnchor then
                Nothing

            else
                case model.activeChannel of
                    Nothing ->
                        Nothing

                    Just active ->
                        case Dict.get (String.toLower active) model.viewUnreadDividerId of
                            Just dividerId ->
                                indexOfRow dividerId

                            Nothing ->
                                Maybe.andThen indexOfRow (Dict.get (String.toLower active) model.firstUnreadId)
    in
    MessageWindow.selectMessageAnchorIndex
        { searchIndex = Maybe.map toFloat searchIdx
        , landingIndex = Maybe.map toFloat landingIdx
        , unreadIndex = Maybe.map toFloat unreadIdx
        , pageStart = Maybe.map toFloat model.threadPageStart
        , forceUnread = model.forceUnreadNav
        }


{-| Reuse the chronological projection already prepared by the view.
-}
threadWindowFor : Model -> Channel -> MessageWindow.MessageWindow
threadWindowFor model channel =
    threadWindowForRows model (threadVisibleRows model channel)


threadWindowForRows : Model -> List ChatMessage -> MessageWindow.MessageWindow
threadWindowForRows model chronological =
    MessageWindow.computeMessageWindow
        { total = toFloat (List.length chronological)
        , windowSize = toFloat model.threadWindowSize
        , anchorIndex = Maybe.map toFloat (threadAnchorIndexForChronological model chronological)
        , anchorContext = Nothing
        , pageStart = Maybe.map toFloat model.threadPageStart
        }


{-| The same chronological rows drive window math and rendering, so a
filtered conversation never inherits offsets from hidden messages.
Avoid a full collapse filter allocation when no senders are collapsed.
-}
threadVisibleRows : Model -> Channel -> List ChatMessage
threadVisibleRows model channel =
    let
        chronological =
            List.reverse channel.messages

        topicVisible =
            topicVisibleRows model channel.name chronological
    in
    if Set.isEmpty model.collapsedNicks then
        topicVisible

    else
        List.filter
            (\row ->
                String.isEmpty (String.trim row.from)
                    || not (Set.member (String.toLower (String.trim row.from)) model.collapsedNicks)
            )
            topicVisible


{-| Panel scope line (mirroring `targetLabel`: a channel name, a DM
`@nick`, or every remembered conversation when nothing is open). -}
searchTargetLabel : Model -> String
searchTargetLabel model =
    case model.activeChannel of
        Nothing ->
            "all remembered conversations"

        Just name ->
            let
                label =
                    case Dict.get (String.toLower name) model.channels of
                        Just channel ->
                            channel.name

                        Nothing ->
                            name
            in
            if isChannelName model label then
                label

            else
                "@" ++ label


{-| A live self-echo: our own nick on an inbound PRIVMSG while the
`echo-message` cap is not negotiated. Sends already rendered
optimistically (see `ComposerSend`), so the untagged echo carries
nothing new and is dropped — mirroring the oracle's "we already
echoed our own messages" break. NOTICEs keep folding (the oracle
rule is PRIVMSG-only). A replayed own message carries a server
msgid, so it is history rather than an echo and folds through the
rewind dedup below instead of dropping here. -}
isLiveSelfEcho : Model -> Wire.IrcMessage -> Bool
isLiveSelfEcho model message =
    model.connection == Live
        && not (List.member "echo-message" model.caps)
        && not (hasMsgid message)
        && (case message.nick of
                Nothing ->
                    False

                Just nick ->
                    String.toLower nick == String.toLower model.ourNick
           )


{-| Server msgid on a chat line (the rewind identity — `Nothing` for
untagged live lines and non-chat commands). -}
hasMsgid : Wire.IrcMessage -> Bool
hasMsgid message =
    case msgidOf message of
        Just _ ->
            True

        Nothing ->
            False


msgidOf : Wire.IrcMessage -> Maybe String
msgidOf message =
    if message.command == "PRIVMSG" || message.command == "NOTICE" then
        case Dict.get "msgid" message.tags of
            Just raw ->
                if String.isEmpty raw then
                    Nothing

                else
                    Just raw

            Nothing ->
                Nothing

    else
        Nothing


{-| Server `time`-tag on any line as epoch milliseconds — `Nothing` for
untagged lines and bounded-but-unparseable tags (mirroring the oracle
`eventTime`: valid tag wins, otherwise receipt time, so a hostile tag
can never poison ordering). -}
serverTimeMsOf : Wire.IrcMessage -> Maybe Int
serverTimeMsOf message =
    case Dict.get "time" message.tags of
        Just raw ->
            Wire.parseServerTime raw

        Nothing ->
            Nothing


{-| Stamp for a freshly folded chat row: authoritative server time when
the line carries a valid `time` tag, otherwise the fold (receipt) moment.
`nowMs` is fixed per update so every row stamped in one fold agrees. -}
rowTime : Model -> Wire.IrcMessage -> Int
rowTime model message =
    Maybe.withDefault (floor model.nowMs) (serverTimeMsOf message)


{-| Per-target rewind window, newest first (mirroring
`HISTORY_BATCH_MESSAGE_MAX = 400`). -}
maxSeenMsgids : Int
maxSeenMsgids =
    400


{-| A bouncer/session-sync replay of an already-folded line: the
server msgid is on file for the target, so the line carries nothing
new and drops before the store and the vault — mirroring the
oracle's msgid-merge dedup. -}
isRepeatDelivery : Model -> Wire.IrcMessage -> Bool
isRepeatDelivery model message =
    case ( msgidOf message, repeatTargetOf message ) of
        ( Just msgid, Just key ) ->
            case Dict.get key model.seenMsgids of
                Just seen ->
                    List.member msgid seen

                Nothing ->
                    False

        _ ->
            False


repeatTargetOf : Wire.IrcMessage -> Maybe String
repeatTargetOf message =
    case message.params of
        target :: _ ->
            let
                key =
                    String.toLower target
            in
            if String.isEmpty key then
                Nothing

            else
                Just key

        [] ->
            Nothing


{-| File a delivery's server msgid for rewind dedup (bounded per
target; untagged lines leave no trace). -}
rememberDelivery : Model -> Wire.IrcMessage -> Model
rememberDelivery model message =
    case ( msgidOf message, repeatTargetOf message ) of
        ( Just msgid, Just key ) ->
            let
                filed =
                    case Dict.get key model.seenMsgids of
                        Just seen ->
                            List.take maxSeenMsgids (msgid :: List.filter (\known -> known /= msgid) seen)

                        Nothing ->
                            [ msgid ]
            in
            { model | seenMsgids = Dict.insert key filed model.seenMsgids }

        _ ->
            model


{-| Validated inbound `@label=` value, fail-closed: only a
well-formed label may touch the pending registry (mirroring
`_takePendingLabeledSend`, which refuses anything `isValidLabel`
rejects). -}
labelOf : Wire.IrcMessage -> Maybe String
labelOf message =
    case Dict.get "label" message.tags of
        Just raw ->
            if Labels.isValidLabel raw then
                Just raw

            else
                Nothing

        Nothing ->
            Nothing


{-| Mint + register a labeled correlation for one single-part send,
evicting the oldest first past `Labels.maxPendingLabeledSends`
(retiring response correlation into delivery-unknown, mirroring the
bounded registration policy). The
counter keeps running across reconnects like the oracle's module
counter, so a label is never re-minted within a session. -}
registerLabeledSend : Model -> String -> List Int -> String -> ( Model, String )
registerLabeledSend model target messageIds text =
    let
        seq =
            model.labelCounter + 1

        label =
            Labels.nextClientLabel (floor model.nowMs) seq

        entry =
            { messageIds = messageIds
            , target = target
            , targetKey = String.toLower target
            , text = text
            , seq = seq
            , generation = model.physicalConnectionGeneration
            , deadline = model.nowMs + historyBatchTimeoutMs
            , ownerStamp = model.runtimeOwnerStamp
            }
    in
    ( insertPendingLabel { model | labelCounter = seq } label entry, label )


{-| Insert one label correlation, evicting the oldest first past
`Labels.maxPendingLabeledSends` (mirroring
`_registerPendingLabeledSend`). -}
insertPendingLabel : Model -> String -> PendingLabeledSend -> Model
insertPendingLabel model label entry =
    let
        total =
            Dict.size model.pendingLabels + Dict.size model.uncertainLabels

        withRoom =
            if total < Labels.maxPendingLabeledSends then
                model

            else
                case oldestPendingLabel model.uncertainLabels of
                    Just oldestUncertain ->
                        { model | uncertainLabels = Dict.remove oldestUncertain model.uncertainLabels }

                    Nothing ->
                        case oldestPendingLabel model.pendingLabels of
                            Nothing ->
                                model

                            Just oldestActive ->
                                let
                                    unknown =
                                        markLabeledUnknown model (Just oldestActive)
                                in
                                { unknown | uncertainLabels = Dict.remove oldestActive unknown.uncertainLabels }
    in
    { withRoom | pendingLabels = Dict.insert label entry withRoom.pendingLabels }


{-| Ask ports to walk the durable queue. `labeled` is decided
Elm-side (ports never sees caps): with `labeled-response` every sent
row carries a ports-minted `@label=`, reported back under
`sentLabels` for correlation. -}
flushRequest : Model -> Outbound
flushRequest model =
    case model.runtimeOwnerStamp of
        Just stamp ->
            let
                requestId =
                    "journalFlush" ++ String.padLeft 12 '0' (String.fromInt (model.eventClock + floor model.nowMs))
            in
            RuntimeJournalFlush { ownerRef = stamp.ownerRef, accountGeneration = stamp.accountGeneration, connectionGeneration = stamp.connectionGeneration, requestId = requestId }

        Nothing ->
            OutboxFlush { labeled = List.member "labeled-response" model.caps }


{-| Locate an outbox placeholder row by its durable id. -}
findOutboxRow : Model -> String -> Maybe { targetKey : String, messageId : Int, text : String }
findOutboxRow model oid =
    Dict.toList model.channels
        |> List.concatMap (\( key, c ) -> List.map (\m -> ( key, m )) c.messages)
        |> List.filterMap
            (\( key, m ) ->
                case m.outboxId of
                    Just x ->
                        if x == oid then
                            Just { targetKey = key, messageId = m.id, text = m.body }

                        else
                            Nothing

                    Nothing ->
                        Nothing
            )
        |> List.head


{-| Correlate ports-labeled flush sends: keep each sent placeholder
(pending, still outbox-linked) and register it under the reported
label so the server's echo, ACK, or FAIL resolves it like any other
labeled send. Invalid labels and rows with no placeholder are
ignored, fail-closed. -}
registerFlushedLabels : Model -> List { id : String, label : String } -> Model
registerFlushedLabels model pairs =
    List.foldl
        (\pair acc ->
            if not (Labels.isValidLabel pair.label) then
                acc

            else
                case findOutboxRow acc pair.id of
                    Nothing ->
                        acc

                    Just found ->
                        let
                            flagged =
                                updateChannel acc
                                    found.targetKey
                                    (\c ->
                                        { c
                                            | messages =
                                                List.map
                                                    (\m ->
                                                        if m.id == found.messageId then
                                                            { m | pending = True }

                                                        else
                                                            m
                                                    )
                                                    c.messages
                                        }
                                    )

                            entry =
                                { messageIds = [ found.messageId ]
                                , target = found.targetKey
                                , targetKey = found.targetKey
                                , text = found.text
                                , seq = flagged.labelCounter
                                , generation = flagged.physicalConnectionGeneration
                                , deadline = flagged.nowMs + historyBatchTimeoutMs
                                , ownerStamp = flagged.runtimeOwnerStamp
                                }
                        in
                        insertPendingLabel flagged pair.label entry
        )
        model
        pairs


{-| Retire the oldest in-flight response label (smallest mint seq).
Its row remains pending with an explicit delivery-unknown state so a
bounded registry never turns missing evidence into acceptance. -}
evictOldestLabel : Model -> Model
evictOldestLabel model =
    case oldestPendingLabel model.pendingLabels of
        Nothing ->
            model

        Just label ->
            promoteLabeledSend model label


oldestPendingLabel : Dict String PendingLabeledSend -> Maybe String
oldestPendingLabel registry =
    List.foldl
        (\( label, entry ) best ->
            case best of
                Nothing ->
                    Just ( label, entry.seq )

                Just ( _, bestSeq ) ->
                    if entry.seq < bestSeq then
                        Just ( label, entry.seq )

                    else
                        best
        )
        Nothing
        (Dict.toList registry)
        |> Maybe.map Tuple.first


{-| Confirm a send's rows in place, wherever they sit in their
target's buffer: the pending flag clears and the outbox link drops
(flush placeholders become ordinary confirmed rows, mirroring the
oracle's promote, which rebuilds the row without the outbox id).
Online rows never carry an outbox id, so the unlink is a no-op for
them. -}
clearPendingRows : Model -> String -> List Int -> Model
clearPendingRows model target messageIds =
    updateChannel { model | deliveryUnknownIds = List.foldl Set.remove model.deliveryUnknownIds messageIds }
        target
        (\c ->
            { c
                | messages =
                    List.map
                        (\m ->
                            if List.member m.id messageIds then
                                { m | pending = False, outboxId = Nothing }

                            else
                                m
                        )
                        c.messages
            }
        )


{-| Move one response label into delivery-unknown state. The row keeps
its id and pending marker; only a later exact self-echo with a real
msgid can settle acceptance. -}
promoteLabeledSend : Model -> String -> Model
promoteLabeledSend model label =
    markLabeledUnknown model (Just label)


markLabeledUnknown : Model -> Maybe String -> Model
markLabeledUnknown model maybeLabel =
    case maybeLabel |> Maybe.andThen (\label -> Dict.get label model.pendingLabels |> Maybe.map (Tuple.pair label)) of
        Nothing ->
            model

        Just ( label, pending ) ->
            let
                keepEchoCorrelation =
                    pending.generation == model.physicalConnectionGeneration
                        && pending.ownerStamp == model.runtimeOwnerStamp
                        && Dict.size model.uncertainLabels < Labels.maxPendingLabeledSends

                flagged =
                    updateChannel
                        { model
                            | pendingLabels = Dict.remove label model.pendingLabels
                            , uncertainLabels =
                                if keepEchoCorrelation then
                                    Dict.insert label pending model.uncertainLabels

                                else
                                    model.uncertainLabels
                            , deliveryUnknownIds = List.foldl Set.insert model.deliveryUnknownIds pending.messageIds
                        }
                        pending.target
                        (\channel ->
                            { channel
                                | messages =
                                    List.map
                                        (\row -> if List.member row.id pending.messageIds then { row | pending = True } else row)
                                        channel.messages
                            }
                        )
            in
            pruneDeliveryUnknown flagged


markAllLabeledUnknown : Model -> Model
markAllLabeledUnknown model =
    List.foldl (\( label, _ ) acc -> markLabeledUnknown acc (Just label)) model (Dict.toList model.pendingLabels)


isDeliveryUnknown : Model -> ChatMessage -> Bool
isDeliveryUnknown model message =
    Set.member message.id model.deliveryUnknownIds


pruneDeliveryUnknown : Model -> Model
pruneDeliveryUnknown model =
    let
        retainedIds =
            model.channels
                |> Dict.values
                |> List.concatMap (\channel -> List.map .id channel.messages)
                |> Set.fromList
    in
    { model | deliveryUnknownIds = Set.filter (\id -> Set.member id retainedIds) model.deliveryUnknownIds }


{-| Retire every in-flight response label on disconnect. Rows remain
pending and explicitly delivery-unknown; old-generation correlation
is fenced before the next socket opens. -}
promoteAllLabeled : Model -> Model
promoteAllLabeled model =
    markAllLabeledUnknown model


{-| Live labeled self-echo: our own nick on PRIVMSG/NOTICE carrying a
registered `@label=`. The optimistic row is confirmed in place with
the authoritative server body and the delivery files its msgid for
rewind dedup, mirroring `_resolveLabeledChatEcho`. One label names
one logical send (the oracle's singular `messageId`): when several
part rows share it — a multiline send's optimistic parts — the
oldest part keeps its position with the echo body and the rest drop,
so the close synthetic collapses to one message. Sealed-send echoes
never reach here (sealed paths don't register). Consumed lines return
`Just`; anything else falls through to the normal fold. -}
resolveLabeledEcho : Model -> Wire.IrcMessage -> Maybe Model
resolveLabeledEcho model message =
    if message.command /= "PRIVMSG" && message.command /= "NOTICE" then
        Nothing

    else
        case message.nick of
            Nothing ->
                Nothing

            Just nick ->
                if String.toLower nick /= String.toLower model.ourNick then
                    Nothing

                else
                    case labelOf message of
                        Nothing ->
                            Nothing

                        Just label ->
                            case pendingLabelFor model label of
                                Nothing ->
                                    Nothing

                                Just pending ->
                                    case message.params of
                                        target :: body :: _ ->
                                            if
                                                pending.generation /= model.physicalConnectionGeneration
                                                    || pending.ownerStamp /= model.runtimeOwnerStamp
                                                    || String.toLower target /= pending.targetKey
                                                    || String.isEmpty (Maybe.withDefault "" (Dict.get "msgid" message.tags))
                                            then
                                                Nothing

                                            else
                                                let
                                                    without =
                                                        { model
                                                            | pendingLabels = Dict.remove label model.pendingLabels
                                                            , uncertainLabels = Dict.remove label model.uncertainLabels
                                                            , deliveryUnknownIds = List.foldl Set.remove model.deliveryUnknownIds pending.messageIds
                                                        }

                                                    confirmed =
                                                        updateChannel without
                                                            pending.target
                                                            (collapseEchoRows pending.messageIds body)

                                                    accepted =
                                                        rememberDelivery confirmed message
                                                in
                                                Just accepted

                                        _ ->
                                            Nothing


pendingLabelFor : Model -> String -> Maybe PendingLabeledSend
pendingLabelFor model label =
    case Dict.get label model.pendingLabels of
        Just active ->
            Just active

        Nothing ->
            Dict.get label model.uncertainLabels


{-| Confirm one logical send's optimistic rows with the echo body:
the oldest matching row keeps its position, confirmed in place;
any newer placeholder rows for the same send drop. A single row
behaves exactly like the old in-place confirm. -}
collapseEchoRows : List Int -> String -> Channel -> Channel
collapseEchoRows messageIds body channel =
    let
        oldestKept =
            List.foldl
                (\m found ->
                    if List.member m.id messageIds then
                        Just m.id

                    else
                        found
                )
                Nothing
                channel.messages
    in
    case oldestKept of
        Nothing ->
            channel

        Just keepId ->
            { channel
                | messages =
                    List.filterMap
                        (\m ->
                            if not (List.member m.id messageIds) then
                                Just m

                            else if m.id == keepId then
                                Just { m | body = body, pending = False, outboxId = Nothing }

                            else
                                Nothing
                        )
                        channel.messages
            }


{-| Whole-token keyword match (mirroring `matchesKeyword`:
case-insensitive exact tokens, punctuation as boundaries, with
multi-word runs matched consecutively; tokenization is ASCII
letters/digits/underscore where the oracle splits on Unicode
`\p{L}\p{N}_` — a documented narrowing). -}
matchesKeyword : String -> String -> Bool
matchesKeyword text keyword =
    let
        needle =
            keywordTokens keyword

        haystack =
            keywordTokens text
    in
    case needle of
        [] ->
            False

        [ token ] ->
            List.member token haystack

        _ ->
            containsRun needle haystack


keywordTokens : String -> List String
keywordTokens text =
    String.words (String.map tokenChar (String.toLower text))


tokenChar : Char -> Char
tokenChar c =
    if Char.isAlphaNum c || c == '_' then
        c

    else
        ' '


containsRun : List String -> List String -> Bool
containsRun needle haystack =
    case haystack of
        [] ->
            List.isEmpty needle

        _ :: rest ->
            if List.take (List.length needle) haystack == needle then
                True

            else
                containsRun needle rest


{-| Nick mention as a whole token (mirroring `mentionsMe`: the
`\bnick\b` case-insensitive word-boundary test, ASCII tokens). -}
mentionsMe : String -> String -> Bool
mentionsMe text nick =
    if String.isEmpty nick then
        False

    else
        matchesKeyword text nick


{-| Delivery-time highlight flag (mirroring the chatMsg
`highlight`: DMs always highlight; sealed bodies never yield a
match from ciphertext; otherwise the nick mention decides — the
`@everyone`/`@here`/keyword pass counts toward unread/highlights
without rewriting the row flag, mirroring
`isChannelUnreadHighlight`). -}
classifyHighlight : Model -> String -> String -> String -> Bool
classifyHighlight model target from body =
    if isChannelName model target then
        if DmCipher.isEnvelope body || GroupEnvelope.isGroupEnvelope body then
            False

        else
            mentionsMe body model.ourNick

    else
        True


{-| Shared highlight counting (mirroring
`isChannelUnreadHighlight`: the row flag, channel-wide pings, or a
saved keyword). -}
isHighlightWorthy : Model -> String -> Bool
isHighlightWorthy model body =
    let
        lowered =
            String.toLower body
    in
    String.contains "@everyone" lowered
        || String.contains "@here" lowered
        || List.any (matchesKeyword body) model.highlightWords


{-| Room notify level (`all` default, mirroring the oracle's
`channelNotify.get(key) ?? 'all'`). -}
notifyLevel : Model -> String -> String
notifyLevel model target =
    Maybe.withDefault "all" (Dict.get (String.toLower target) model.channelNotify)


{-| Whether a channel row is already on the visible surface
(mirroring `isChannelMessageVisible`: a room that is not open is
never visible; an open room without a topic selection shows every
row; a selection shows only rows whose trimmed label matches
case-insensitively — other-topic and untagged rows stay hidden). -}
isTopicVisibleConversation : Model -> String -> Maybe String -> Bool
isTopicVisibleConversation model target rowTopic =
    case model.activeChannel of
        Nothing ->
            False

        Just active ->
            if String.toLower active /= String.toLower target then
                False

            else
                case Dict.get (String.toLower target) model.activeChannelTopics of
                    Nothing ->
                        True

                    Just selected ->
                        case rowTopic of
                            Nothing ->
                                False

                            Just label ->
                                String.toLower (String.trim label) == String.toLower (String.trim selected)


{-| A stored row's topic as a label option: the empty string marks an
untagged row, so it maps to `Nothing` like an absent tag. -}
topicOrNothing : String -> Maybe String
topicOrNothing topic =
    if String.isEmpty topic then
        Nothing

    else
        Just topic


{-| Count one delivered row toward unread (mirroring
`_addChannelMessage` counting: history merges never count here —
the discovery path counts instead; own rows never count; a row on
the visible surface stays zeroed like the oracle's active-room
reset, so a topic selection keeps its own rows read while
other-topic and untagged rows still count; `none` stores only;
`mentions` admits only highlight-worthy rows). The counted
highlight is the shared classifier (row flag, channel-wide pings,
saved keywords), mirroring `isChannelUnreadHighlight`. -}
trackUnread : Model -> String -> Int -> String -> String -> Bool -> Maybe String -> Model
trackUnread model target rowId from body highlight rowTopic =
    if model.historyMerging then
        model

    else if String.toLower from == String.toLower model.ourNick then
        model

    else if isTopicVisibleConversation model target rowTopic then
        model

    else
        let
            worthy =
                highlight || isHighlightWorthy model body
        in
        bumpUnread model target rowId worthy


{-| Bump one background conversation (mirroring the counter arms:
`unread + 1`, `highlights + highlight`, first id remembered while
absent). -}
bumpUnread : Model -> String -> Int -> Bool -> Model
bumpUnread model target rowId highlight =
    case notifyLevel model target of
        "none" ->
            model

        "mentions" ->
            if highlight then
                addUnread model target rowId True

            else
                model

        _ ->
            addUnread model target rowId highlight


addUnread : Model -> String -> Int -> Bool -> Model
addUnread model target rowId highlight =
    let
        key =
            String.toLower target

        counted =
            updateChannel model target
                (\c ->
                    { c
                        | unread = c.unread + 1
                        , highlights =
                            if highlight then
                                c.highlights + 1

                            else
                                c.highlights
                    }
                )
    in
    -- The first-unread cursor remembers the oldest counted row
    -- while absent (mirroring `firstUnreadId`).
    case Dict.get key counted.firstUnreadId of
        Just _ ->
            counted

        Nothing ->
            { counted | firstUnreadId = Dict.insert key rowId counted.firstUnreadId }


{-| Re-derive unread + highlights from a stored read marker (mirroring
`_applyReadMarker`): the marker always lands in `readMarkers`; when it
parses, countable rows newer than the marker stay unread — zeroed when
the room is open. -}
applyReadMarker : Model -> String -> String -> Model
applyReadMarker model target iso =
    let
        key =
            String.toLower target

        marked =
            { model | readMarkers = Dict.insert key iso model.readMarkers }

        -- Account read markers only move forward: a marker older than
        -- the stored one (a stale relay or a reordered GET reply) is
        -- ignored, leaving the stored marker and unread counts alone.
        regresses =
            case ( Maybe.andThen Wire.parseServerTime (Dict.get key model.readMarkers), Wire.parseServerTime iso ) of
                ( Just storedMs, Just incomingMs ) ->
                    incomingMs < storedMs

                _ ->
                    False
    in
    if regresses then
        model

    else
    case Wire.parseServerTime iso of
        Nothing ->
            marked

        Just markerMs ->
            let
                ourLower =
                    String.toLower marked.ourNick

                countable row =
                    String.toLower row.from /= ourLower

                ours channel =
                    List.filter (\row -> countable row && row.at > markerMs) channel.messages

                openActive =
                    case marked.activeChannel of
                        Just active ->
                            String.toLower active == key

                        Nothing ->
                            False
            in
            case Dict.get key marked.channels of
                Nothing ->
                    marked

                Just channel ->
                    let
                        still =
                            ours channel

                        unread =
                            if openActive then
                                0

                            else
                                List.length still

                        mentions =
                            if openActive then
                                0

                            else
                                List.length (List.filter .highlight still)
                    in
                    updateChannel marked
                        channel.name
                        (\c -> { c | unread = unread, highlights = mentions })


{-| Fold one inbound `MARKREAD` (mirroring the server-echo / GET-reply /
other-session relay arm): only the server or our own nick acts; `*` (or
a missing token) drops the stored marker without touching counts. -}
foldMarkread : Model -> Maybe String -> List String -> ( Model, List Outbound )
foldMarkread model maybeNick params =
    case params of
        [] ->
            ( model, [] )

        target :: rest ->
            let
                self =
                    case maybeNick of
                        Nothing ->
                            True

                        Just nick ->
                            String.toLower nick == String.toLower model.ourNick
            in
            if not self then
                ( model, [] )

            else
                case rest of
                    [] ->
                        ( { model | readMarkers = Dict.remove (String.toLower target) model.readMarkers }, [] )

                    token :: _ ->
                        if token == "*" then
                            ( { model | readMarkers = Dict.remove (String.toLower target) model.readMarkers }, [] )

                        else
                            let
                                iso =
                                    if String.startsWith "timestamp=" token then
                                        String.dropLeft (String.length "timestamp=") token

                                    else
                                        token

                                -- A marker landing while a named conversation
                                -- is open persists its consumed boundary
                                -- first (mirroring the MARKREAD arm).
                                ( marked, markOuts ) =
                                    case activeMarkerTopic model target of
                                        Just topic ->
                                            markLatestChannelTopicRead model target topic

                                        Nothing ->
                                            ( model, [] )
                            in
                            ( applyReadMarker marked target iso, markOuts )


{-| The open named conversation for a MARKREAD target, if the target is
the active room with a topic selection. -}
activeMarkerTopic : Model -> String -> Maybe String
activeMarkerTopic model target =
    let
        key =
            String.toLower target
    in
    case model.activeChannel of
        Just active ->
            if String.toLower active == key then
                Dict.get key model.activeChannelTopics

            else
                Nothing

        Nothing ->
            Nothing


{-| Record the local read position when a room opens (mirroring the
local half of `markRead`): counters clear, the first-unread cursor and
`lastReadAt` stamp land, and `MARKREAD` goes out only when
`draft/read-marker` negotiated. -}
captureUnreadDivider : Model -> String -> Model
captureUnreadDivider model name =
    -- Snapshot the unread boundary before the open clears it
    -- (mirroring `captureUnreadDivider`/`markViewedRead`: the
    -- divider id is the first-unread id, or nothing when caught
    -- up — re-opening with no unread clears a stale divider).
    case Dict.get (String.toLower name) model.firstUnreadId of
        Nothing ->
            { model | viewUnreadDividerId = Dict.remove (String.toLower name) model.viewUnreadDividerId }

        Just dividerId ->
            { model | viewUnreadDividerId = Dict.insert (String.toLower name) dividerId model.viewUnreadDividerId }


recordLocalReadMarker : Model -> String -> ( Model, List Outbound )
recordLocalReadMarker model name =
    case Dict.get (String.toLower name) model.channels of
        Nothing ->
            ( model, [] )

        Just _ ->
            let
                iso =
                    millisToIso model.nowMs

                divided =
                    captureUnreadDivider model name

                cleared =
                    updateChannel divided
                        name
                        (\c -> { c | unread = 0, highlights = 0 })

                marked =
                    { cleared
                        | readMarkers = Dict.insert (String.toLower name) iso cleared.readMarkers
                        , viewedReadMarkers = Dict.insert (String.toLower name) iso cleared.viewedReadMarkers
                        , lastReadAt = Dict.insert (String.toLower name) (round model.nowMs) cleared.lastReadAt
                        , firstUnreadId = Dict.remove (String.toLower name) cleared.firstUnreadId
                    }

                newestVisibleId =
                    Dict.get (String.toLower name) model.channels
                        |> Maybe.andThen (.messages >> List.head >> Maybe.map .id)

                ( markedWithRequest, anchorRequest ) =
                    makeRuntimeDomainOutbound marked (RuntimeDomain.AnchorViewed name (Maybe.map String.fromInt newestVisibleId) (Just iso))

                sync =
                    if Session.hasCapability marked.caps "draft/read-marker" then
                        [ SendLine (Wire.formatIrcLine "MARKREAD" [ name, "timestamp=" ++ iso ]) ]

                    else
                        []
            in
            ( markedWithRequest, sync ++ Maybe.withDefault [] (Maybe.map List.singleton anchorRequest) )


makeRuntimeDomainOutbound : Model -> RuntimeDomain.Action -> ( Model, Maybe Outbound )
makeRuntimeDomainOutbound model action =
    case model.runtimeOwnerStamp of
        Nothing ->
            ( model, Nothing )

        Just stamp ->
            let
                nextClock =
                    model.eventClock + 1
            in
            case (( Ids.requestIdFromRuntime ("domainRequest" ++ String.padLeft 12 '0' (String.fromInt nextClock)), Ids.ownerRefFromRuntime stamp.ownerRef ), ( Ids.accountGenerationFromInt stamp.accountGeneration, Ids.connectionGenerationFromInt stamp.connectionGeneration )) of
                ( ( Just requestId, Just ownerRef ), ( Just accountGeneration, Just connectionGeneration ) ) ->
                    let
                        capturedQueueDraft =
                            case action of
                                RuntimeDomain.QueueMessage target _ content _ _ _ ->
                                    if model.composer == content && Maybe.map (ircCaseKey model) model.activeChannel == Just (ircCaseKey model target) then
                                        Dict.insert (Ids.requestIdToRuntime requestId)
                                            { target = target
                                            , revision = Maybe.withDefault 0 (Dict.get (ircCaseKey model target) model.composerDraftVersions)
                                            , text = content
                                            }
                                            model.queuedDraftRevisions

                                    else
                                        model.queuedDraftRevisions

                                _ ->
                                    model.queuedDraftRevisions
                    in
                    ( { model
                        | eventClock = nextClock
                        , runtimeDomainPending = Just requestId
                        , runtimeDomainPendingAction = Just action
                        , runtimeDomainResult = Nothing
                        , queuedDraftRevisions = capturedQueueDraft
                      }
                    , Just
                        (RuntimeDomainCommand
                            { requestId = requestId
                            , ownerRef = ownerRef
                            , accountGeneration = accountGeneration
                            , connectionGeneration = connectionGeneration
                            , action = action
                            }
                        )
                    )

                _ ->
                    ( model, Nothing )


makeDraftDiscardOutbound : Model -> String -> Int -> ( Model, List Outbound )
makeDraftDiscardOutbound model target revision =
    case model.runtimeOwnerStamp of
        Nothing ->
            ( model, [] )

        Just stamp ->
            let
                nextClock = model.eventClock + 1
            in
            case (( Ids.requestIdFromRuntime ("draftClear" ++ String.padLeft 12 '0' (String.fromInt nextClock)), Ids.ownerRefFromRuntime stamp.ownerRef ), ( Ids.accountGenerationFromInt stamp.accountGeneration, Ids.connectionGenerationFromInt stamp.connectionGeneration )) of
                ( ( Just requestId, Just ownerRef ), ( Just accountGeneration, Just connectionGeneration ) ) ->
                    ( { model | eventClock = nextClock }
                    , [ RuntimeDraftAutosaveTimerCancelled
                            { target = target
                            , revision = revision
                            , ownerRef = stamp.ownerRef
                            , accountGeneration = stamp.accountGeneration
                            , connectionGeneration = stamp.connectionGeneration
                            }
                      ,
                        (RuntimeDomainCommand
                            { requestId = requestId
                            , ownerRef = ownerRef
                            , accountGeneration = accountGeneration
                            , connectionGeneration = connectionGeneration
                            , action = RuntimeDomain.DraftDiscard target revision
                            }
                        )
                      ]
                    )

                _ ->
                    ( model, [] )


normalizePublicBackupRoom : String -> Maybe String
normalizePublicBackupRoom candidate =
    let
        trimmed = String.trim candidate
    in
    if trimmed /= candidate
        || String.length candidate < 2
        || String.length candidate > 512
        || not (String.startsWith "#" candidate)
        || String.any (\char -> Char.toCode char <= 32 || Char.toCode char == 127) candidate
        || Ids.conversationIdFromWire candidate == Nothing then
        Nothing

    else
        Just candidate


{-| Normalize an untrusted persisted nick blocklist (mirroring
`parseIgnoredUsers` / `parseMutedDMs`): trim + lowercase, drop
empties, overlong names, and control carriers, cap the set size. -}
parseNameBlocklist : Int -> Int -> List String -> Set String
parseNameBlocklist maxCount maxNick raw =
    List.foldl
        (\name acc ->
            if Set.size acc >= maxCount then
                acc

            else
                let
                    nick =
                        String.toLower (String.trim name)
                in
                if String.isEmpty nick || String.length nick > maxNick || String.any (\c -> Char.toCode c <= 0x1F || Char.toCode c == 0x7F) nick then
                    acc

                else
                    Set.insert nick acc
        )
        Set.empty
        raw


{-| Persist both blocklists after any ignore/mute change (mirroring
the per-action saves; the port writes the `onyx:ignored-users` /
`onyx:muted-dms` keys and, once an owner is known, the matching
`…:owner:…` documents). -}
blocklistsSaveOut : Model -> List Outbound
blocklistsSaveOut model =
    [ BlocklistsSave { ignored = Set.toList model.ignoredUsers, muted = Set.toList model.mutedDMs } ]


{-| Highlight-term bounds (mirroring `highlightMemory.ts`). -}
maxHighlightWords : Int
maxHighlightWords =
    128


maxHighlightWordLength : Int
maxHighlightWordLength =
    256


{-| Canonical lowercase highlight term, or nothing when the raw term
is empty, overlong, or carries a control character (mirroring
`normalizeKeyword`: C0 + DEL, like the blocklist scrub). -}
normalizeHighlightWord : String -> Maybe String
normalizeHighlightWord raw =
    let
        word =
            String.toLower (String.trim raw)
    in
    if String.isEmpty word || String.length word > maxHighlightWordLength || String.any (\c -> Char.toCode c <= 0x1F || Char.toCode c == 0x7F) word then
        Nothing

    else
        Just word


{-| Normalize an untrusted highlight-term list into a bounded unique
list, first-wins (mirroring `parseHighlightWords`). -}
parseHighlightWords : List String -> List String
parseHighlightWords raws =
    List.foldl
        (\raw acc ->
            case normalizeHighlightWord raw of
                Nothing ->
                    acc

                Just word ->
                    if List.member word acc || List.length acc >= maxHighlightWords then
                        acc

                    else
                        acc ++ [ word ]
        )
        []
        raws


{-| Persist the highlight list after any change (mirroring the
per-action saves; the port writes the `onyx:highlight-words` key,
removing it when empty). -}
highlightWordsSaveOut : Model -> List Outbound
highlightWordsSaveOut model =
    [ HighlightWordsSave { words = model.highlightWords } ]


{-| Fold the highlight-term actions (mirroring `addHighlightWord` /
`removeHighlightWord`: normalized add, exact-match remove, always
persist — the settings control toasts nothing itself, so neither do
these; slash commands toast at their own call site). -}
addHighlightWord : Model -> String -> ( Model, List Outbound )
addHighlightWord model raw =
    let
        updated =
            { model | highlightWords = parseHighlightWords (model.highlightWords ++ [ raw ]) }
    in
    ( updated, highlightWordsSaveOut updated )


removeHighlightWord : Model -> String -> ( Model, List Outbound )
removeHighlightWord model raw =
    let
        updated =
            case normalizeHighlightWord raw of
                Nothing ->
                    { model | highlightWords = parseHighlightWords model.highlightWords }

                Just word ->
                    { model | highlightWords = parseHighlightWords (List.filter (\w -> w /= word) model.highlightWords) }
    in
    ( updated, highlightWordsSaveOut updated )


{-| Fold the ignore/mute actions (mirroring `ignoreUser` /
`unignoreUser` / `muteDM` / `unmuteDM`): sets update normalized and
persist; muting also zeroes the conversation counters and drops the
first-unread cursor. -}
foldBlocklistAction : Model -> Msg -> ( Model, List Outbound )
foldBlocklistAction model msg =
    applyBlocklistAction True model msg


{-| Blocklist fold with a notify switch: direct user actions toast
with undo data (mirroring `IgnoredUsersControl.tsx`), while undo
replay stays silent — otherwise firing an undo would toast its own
inverse forever.
-}
applyBlocklistAction : Bool -> Model -> Msg -> ( Model, List Outbound )
applyBlocklistAction notify model msg =
    case msg of
        IgnoreUser nick ->
            let
                updated =
                    { model | ignoredUsers = parseNameBlocklist 512 128 (nick :: Set.toList model.ignoredUsers), messageMenu = Nothing }

                toasted =
                    if notify then
                        addToast
                            { variant = ToastUndo
                            , title = "Blocked " ++ nick
                            , description = Just "You will not see them on this device. They are not told."
                            , duration = Nothing
                            , groupKey = Nothing
                            , undo = Just (UndoUnignoreUser nick)
                            }
                            model.nowMs
                            updated

                    else
                        updated
            in
            ( toasted, blocklistsSaveOut updated )

        UnignoreUser nick ->
            let
                updated =
                    { model | ignoredUsers = Set.remove (String.toLower (String.trim nick)) model.ignoredUsers, messageMenu = Nothing }

                toasted =
                    if notify then
                        addToast
                            { variant = ToastUndo
                            , title = "Unblocked " ++ nick
                            , description = Just "Messages and notifications from this name resume on this device."
                            , duration = Nothing
                            , groupKey = Nothing
                            , undo = Just (UndoIgnoreUser nick)
                            }
                            model.nowMs
                            updated

                    else
                        updated
            in
            ( toasted, blocklistsSaveOut updated )

        MuteDm nick ->
            let
                key =
                    String.toLower (String.trim nick)

                muted =
                    { model
                        | mutedDMs = parseNameBlocklist 512 128 (nick :: Set.toList model.mutedDMs)
                    }

                -- Muting clears the peer conversation only (mirroring
                -- the `dms`-map update: channels are never touched).
                quieted =
                    if isChannelName model nick then
                        muted

                    else
                        updateChannel muted
                            nick
                            (\c -> { c | unread = 0, highlights = 0 })

                cleared =
                    { quieted | firstUnreadId = Dict.remove key quieted.firstUnreadId }

                -- The DM mute/unmute toasts live in the oracle's ribbon
                -- component around the plain store calls (mirroring the
                -- block/unblock undo-toast precedent one slice back).
                toasted =
                    if notify then
                        addToast
                            { variant = ToastInfo
                            , title = "Mute conversation"
                            , description = Just "Stay in the room. We will not tap you."
                            , duration = Nothing
                            , groupKey = Nothing
                            , undo = Nothing
                            }
                            model.nowMs
                            cleared

                    else
                        cleared
            in
            ( toasted, blocklistsSaveOut cleared )

        UnmuteDm nick ->
            let
                updated =
                    { model | mutedDMs = Set.remove (String.toLower (String.trim nick)) model.mutedDMs }

                toasted =
                    if notify then
                        addToast
                            { variant = ToastInfo
                            , title = "Unmute conversation"
                            , description = Just "Conversation notifications resume on this device."
                            , duration = Nothing
                            , groupKey = Nothing
                            , undo = Nothing
                            }
                            model.nowMs
                            updated

                    else
                        updated
            in
            ( toasted, blocklistsSaveOut updated )

        FollowConversation { target, topic } ->
            let
                updated =
                    { model | followed = Set.insert (followKey target topic) model.followed }
            in
            ( updated, [ FollowedSave { keys = Set.toList updated.followed } ] )

        UnfollowConversation { target, topic } ->
            let
                updated =
                    { model | followed = Set.remove (followKey target topic) model.followed }
            in
            ( updated, [ FollowedSave { keys = Set.toList updated.followed } ] )

        NotifyPermissionChanged raw ->
            let
                updated =
                    { model | notifyPermission = parseNotifyPermission raw }
            in
            -- A fresh grant may unblock recovery for a prior opt-in
            -- (mirroring the permission-monitor epoch bump).
            if parseNotifyPermission raw == Notify.Granted && updated.accountName /= Nothing then
                requestWebPushCheck updated

            else
                ( updated, [] )

        VisibilityChanged { visible, focused } ->
            let
                present =
                    { model | pageVisible = visible, appFocused = focused }
            in
            -- Returning to a visible, focused tab reconciles the
            -- active room against server truth (throttled, and never
            -- while its burst is already open). A DM active view
            -- reconciles nothing: NAMES takes a room, mirroring the
            -- oracle's channel-view-only poll.
            if visible && focused then
                case present.activeChannel of
                    Just name ->
                        if isChannelName present name then
                            refreshChannelRoster present name

                        else
                            ( present, [] )

                    Nothing ->
                        ( present, [] )

            else
                ( present, [] )

        RequestNotifyPermission ->
            ( model, [ NotifyPermissionRequest ] )

        _ ->
            ( model, [] )


{-| Normalized followed-conversation key (mirroring `followKey`):
`target` or `target/topic`, trimmed + lowercased. -}
followKey : String -> Maybe String -> String
followKey target topic =
    let
        normalizedTarget =
            String.toLower (String.trim target)

        normalizedTopic =
            case topic of
                Just raw ->
                    String.toLower (String.trim raw)

                Nothing ->
                    ""
    in
    if String.isEmpty normalizedTopic then
        normalizedTarget

    else
        normalizedTarget ++ "/" ++ normalizedTopic


{-| Normalize an untrusted persisted followed set (mirroring
`boundedFollowedKeys`: nonempty keys of at most 160 chars, 256 max). -}
parseFollowedKeys : List String -> Set String
parseFollowedKeys raw =
    List.foldl
        (\value acc ->
            if Set.size acc >= 256 then
                acc

            else
                let
                    key =
                        followKey value Nothing
                in
                if String.isEmpty key || String.length key > 160 then
                    acc

                else
                    Set.insert key acc
        )
        Set.empty
        raw


{-| Replace the session copies of owner-scoped device lists from one
loaded document. A missing or malformed field becomes empty, matching
the oracle loaders (they do not keep the previous account's rows). -}
applyDeviceSlots : Decode.Value -> Model -> Model
applyDeviceSlots value model =
    let
        strings key =
            Decode.decodeValue (Decode.field key (Decode.list Decode.string)) value
                |> Result.withDefault []

        pairs key =
            Decode.decodeValue (Decode.field key (Decode.keyValuePairs Decode.string)) value
                |> Result.withDefault []
    in
    { model
        | ignoredUsers = parseNameBlocklist 512 128 (strings "ignored")
        , mutedDMs = parseNameBlocklist 512 128 (strings "muted")
        , highlightWords = parseHighlightWords (strings "highlight")
        , channelNotify =
            parseChannelNotifyEntries
                (List.map (\( channel, level ) -> { channel = channel, level = level }) (pairs "notify"))
        , autoJoinChannels = parseAutoJoinChannels (strings "autoJoin")
        , channelColors =
            parseChannelColorEntries
                (List.map (\( channel, color ) -> { channel = channel, color = color }) (pairs "colors"))
        , followed = parseFollowedKeys (strings "followed")
    }


{-| Server named-conversation tag (`TOPIC_TAG`): the `onyx/topic`
label carried on channel traffic. -}
topicTagName : String
topicTagName =
    "onyx/topic"


{-| Max label bytes (`MAX_TOPIC_LABEL_BYTES`). -}
maxTopicLabelBytes : Int
maxTopicLabelBytes =
    50


{-| UTF-8 byte length of a string (mirroring `TextEncoder().encode().length`:
ASCII is 1 byte, astral codepoints are 4). -}
utf8ByteLength : String -> Int
utf8ByteLength value =
    List.foldl
        (\c acc ->
            let
                code =
                    Char.toCode c
            in
            acc
                + (if code < 0x80 then
                    1

                   else if code < 0x800 then
                    2

                   else if code < 0x10000 then
                    3

                   else
                    4
                  )
        )
        0
        (String.toList value)


{-| Label validity (mirroring `isValidTopicLabel`): nonempty, no comma,
no C0/DEL controls, 1..50 UTF-8 bytes. -}
isValidTopicLabel : String -> Bool
isValidTopicLabel label =
    if String.isEmpty label || String.contains "," label then
        False

    else if List.any (\c -> Char.toCode c < 0x20 || Char.toCode c == 0x7F) (String.toList label) then
        False

    else
        let
            bytes =
                utf8ByteLength label
        in
        bytes >= 1 && bytes <= maxTopicLabelBytes


{-| Ciphertext-safe inbox text (mirroring `lockedPlaceholderForText`:
group envelopes read the room placeholder, Mooring envelopes the DM
placeholder — wire ciphertext never reaches notification rows, which
render `text` directly). Plain bodies pass through for `addNotification`
to bound. -}
safeNotifyText : String -> String
safeNotifyText body =
    if GroupEnvelope.isGroupEnvelope body then
        GroupEnvelope.groupLockedPlaceholder

    else if DmCipher.isEnvelope body then
        DmCipher.lockedPlaceholder

    else
        body


{-| The named conversation a channel row arrived in (mirroring
`parseMessageTopic`): the trimmed `onyx/topic` tag when it is a valid
label, else nothing. -}
parseMessageTopic : Dict.Dict String String -> Maybe String
parseMessageTopic tags =
    case Dict.get topicTagName tags of
        Nothing ->
            Nothing

        Just raw ->
            let
                label =
                    String.trim raw
            in
            if isValidTopicLabel label then
                Just label

            else
                Nothing


{-| Follow decision for a live channel row (mirroring the oracle
follow arms): `Nothing` fires nothing; `Just narrowed` records a
follow notification carrying the narrower destination — the matched
topic when the row's conversation is followed, else no topic for a
room-wide follow. A `none` notify level never fires. -}
followNotifyTopic : Model -> String -> Maybe String -> Maybe (Maybe String)
followNotifyTopic model target topic =
    if notifyLevel model target == "none" then
        Nothing

    else
        case topic of
            Just label ->
                if Set.member (followKey target (Just label)) model.followed then
                    Just (Just label)

                else if Set.member (followKey target Nothing) model.followed then
                    Just Nothing

                else
                    Nothing

            Nothing ->
                if Set.member (followKey target Nothing) model.followed then
                    Just Nothing

                else
                    Nothing


{-| Record a follow inbox row for a live channel message (mirroring the
`type: 'follow'` arm: skipped for our own rows and for rows on the
visible surface — an open room with no selection, or a selected
topic the row belongs to — with the topic-narrowed destination when
the row's conversation matches). Mention and DM inbox rows stay with
the wider producer gap. -}
recordFollowNotification : Model -> String -> String -> String -> Maybe String -> Model
recordFollowNotification model target sender body topic =
    if String.toLower sender == String.toLower model.ourNick then
        model

    else if isTopicVisibleConversation model target topic then
        model

    else
        recordFollowNotificationRow model target sender body topic


recordFollowNotificationRow : Model -> String -> String -> String -> Maybe String -> Model
recordFollowNotificationRow model target sender body topic =
    case followNotifyTopic model target topic of
        Nothing ->
            model

        Just narrowed ->
            addNotification model
                { kind = NotifFollow
                , text = safeNotifyText body
                , from = Just sender
                , channel = Just target
                , topic = narrowed
                }


{-| Record a mention inbox row for a live channel message (mirroring the
`type: 'mention'` arm: the classified highlight decides, with the
`effectiveHighlight` gates — never our own rows, never under a `none`
notify level — and no visibility gate, so an open-room mention still
records). -}
recordMentionNotification : Model -> String -> String -> String -> Bool -> Model
recordMentionNotification model target sender body highlight =
    if not highlight then
        model

    else if String.toLower sender == String.toLower model.ourNick then
        model

    else if notifyLevel model target == "none" then
        model

    else
        addNotification model
            { kind = NotifMention
            , text = safeNotifyText body
            , from = Just sender
            , channel = Just target
            , topic = Nothing
            }


{-| Record a DM inbox row for a live peer message (mirroring the
`type: 'dm'` arms: Mooring-encrypted rows stay silent until the
ports-side open reports plaintext; group-locked rows record the room
placeholder immediately; plain rows record verbatim — even for ignored
senders, whose filed row is the placeholder but whose notification
carries the wire text like the oracle's `displayText`). Muted peers
stay silent on every arm. -}
recordDmNotification : Model -> String -> String -> Model
recordDmNotification model sender body =
    if String.toLower sender == String.toLower model.ourNick then
        model

    else if Set.member (String.toLower sender) model.mutedDMs then
        model

    else if DmCipher.isEnvelope body then
        model

    else if GroupEnvelope.isGroupEnvelope body then
        addNotification model
            { kind = NotifDm
            , text = GroupEnvelope.groupLockedPlaceholder
            , from = Just sender
            , channel = Nothing
            , topic = Nothing
            }

    else
        addNotification model
            { kind = NotifDm
            , text = body
            , from = Just sender
            , channel = Nothing
            , topic = Nothing
            }


{-| Record a DM inbox row once a ports-side open reports plaintext
(mirroring the post-decrypt arm: the ciphertext told us nothing at
receive time, so the notification fires now with the plaintext —
still silent for our own rows and muted peers). -}
notifyDmPlaintext : Model -> Int -> String -> String -> Model
notifyDmPlaintext model messageId envelope plaintext =
    let
        rowFrom channel =
            List.filter (\m -> m.id == messageId && m.body == envelope) channel.messages
                |> List.head
                |> Maybe.map .from

        sender =
            List.foldl
                (\channel acc ->
                    case acc of
                        Just _ ->
                            acc

                        Nothing ->
                            rowFrom channel
                )
                Nothing
                (Dict.values model.channels)
    in
    case sender of
        Nothing ->
            model

        Just peer ->
            recordDmPlaintextNotification model peer plaintext


recordDmPlaintextNotification : Model -> String -> String -> Model
recordDmPlaintextNotification model peer plaintext =
    if String.toLower peer == String.toLower model.ourNick then
        model

    else if Set.member (String.toLower peer) model.mutedDMs then
        model

    else
        addNotification model
            { kind = NotifDm
            , text = plaintext
            , from = Just peer
            , channel = Nothing
            , topic = Nothing
            }


{-| Parse a ports-reported notification permission (mirroring
`getDesktopNotificationPermission`; anything unknown denies desktop
like `default`). -}
parseNotifyPermission : String -> Notify.Permission
parseNotifyPermission raw =
    case raw of
        "granted" ->
            Notify.Granted

        "denied" ->
            Notify.Denied

        "unsupported" ->
            Notify.Unsupported

        _ ->
            Notify.Default


{-| Whether quiet mode suppresses alerts. Manual DND, a live snooze,
and the standing local quiet-hours window are separate axes. The
window follows `isDndActive` (`src/lib/store/store.ts`): it does not
consult `dndEnabled`. -}
notifyDndActive : Model -> Bool
notifyDndActive model =
    model.dndEnabled
        || (case model.dndUntil of
                Just until ->
                    round model.nowMs < until

                Nothing ->
                    False
           )
        || QuietHours.isQuietHoursActive
            { enabled = True
            , startMinute = model.dndQuietStart * 60
            , endMinute = model.dndQuietEnd * 60
            }
            (QuietHours.localMinuteOfDay model.zone (Time.millisToPosix (floor model.nowMs)))


{-| OS-alert body (mirroring `notificationBodyFor`): envelopes fail
closed to the neutral placeholder even when whitespace-prefixed;
anything else truncates at 180 chars. -}
notificationBodyFor : String -> String
notificationBodyFor text =
    let
        trimmed =
            String.trimLeft text
    in
    if DmCipher.isEnvelope trimmed || GroupEnvelope.isGroupEnvelope trimmed then
        "New encrypted message"

    else if String.length text > 180 then
        String.slice 0 177 text ++ "..."

    else
        text


{-| Maybe emit one desktop/sound alert for a live delivered row
(mirroring the notification-runtime decision inputs): only background
rows of mention/DM/follow kind decide; the outbound goes out only when
the decision grants desktop or sound, and the per-target throttle
stamps land on grant. Topic-specific follows alert like room follows
(the narrower match only changes the inbox destination). -}
alertForDelivery : Model -> String -> String -> String -> Bool -> Maybe String -> ( Model, List Outbound )
alertForDelivery model target sender body highlight topic =
    let
        key =
            String.toLower target

        openRoom =
            case model.activeChannel of
                Just active ->
                    String.toLower active == key

                Nothing ->
                    False

        channelTarget =
            isChannelName model target
    in
    if openRoom || String.toLower sender == String.toLower model.ourNick then
        ( model, [] )

    else
        let
            kind =
                if not channelTarget then
                    Just Notify.Dm

                else if highlight then
                    Just Notify.Mention

                else
                    case followNotifyTopic model target topic of
                        Just _ ->
                            Just Notify.Follow

                        Nothing ->
                            Nothing
        in
        case kind of
            Nothing ->
                ( model, [] )

            Just alertKind ->
                let
                    muted =
                        if channelTarget then
                            notifyLevel model target == "none"

                        else
                            Set.member key model.mutedDMs || Set.member (String.toLower sender) model.mutedDMs

                    decision =
                        Notify.shouldNotify
                            { kind = alertKind
                            , isSelf = False
                            , muted = muted
                            , smartMuted = Set.member (String.toLower sender) model.ignoredUsers
                            , pushEnabled = model.pushEnabled
                            , soundEnabled = model.soundEnabled
                            , dnd = notifyDndActive model
                            , permission = model.notifyPermission
                            , pageVisible = model.pageVisible
                            , appFocused = model.appFocused
                            , nowMs = model.nowMs
                            , lastDesktopAtMs = Dict.get key model.lastDesktopAt
                            , lastSoundAtMs = Dict.get key model.lastSoundAt
                            , desktopThrottleMs = Nothing
                            , soundThrottleMs = Nothing
                            }
                in
                if not decision.desktop && not decision.sound then
                    ( model, [] )

                else
                    let
                        title =
                            case alertKind of
                                Notify.Dm ->
                                    "Direct message from " ++ sender

                                Notify.Follow ->
                                    sender ++ " posted in " ++ target

                                _ ->
                                    sender ++ " mentioned you in " ++ target

                        stamped =
                            { model
                                | lastDesktopAt =
                                    if decision.desktop then
                                        Dict.insert key model.nowMs model.lastDesktopAt

                                    else
                                        model.lastDesktopAt
                                , lastSoundAt =
                                    if decision.sound then
                                        Dict.insert key model.nowMs model.lastSoundAt

                                    else
                                        model.lastSoundAt
                            }
                    in
                    ( stamped
                    , [ NotifyAlert
                            { title = title
                            , body = notificationBodyFor body
                            , tag = "onyx-" ++ key
                            , desktop = decision.desktop
                            , sound = decision.sound
                            , volume = model.soundVolume
                            }
                      ]
                    )


{-| Whether a command is a person-to-person chat command for
failure-toast purposes, mirroring the oracle's `_isMessagingCommand`. -}
isMessagingCommand : String -> Bool
isMessagingCommand command =
    case String.toUpper command of
        "PRIVMSG" ->
            True

        "NOTICE" ->
            True

        "TAGMSG" ->
            True

        "WHISPER" ->
            True

        _ ->
            False


{-| Operator-actionable copy for send FAILs, mirroring
`_humanizeMeshSendFail`. Matching is case-insensitive over the server
description; never empty. -}
humanizeSendFail : String -> String -> String -> String
humanizeSendFail command code description =
    let
        desc =
            String.trim description

        lowered =
            String.toLower desc
    in
    if String.toUpper code == "TEMPORARILY_UNAVAILABLE" && isMessagingCommand command then
        if String.contains "mesh durable admit failed" lowered || String.contains "could not durably admit" lowered then
            if String.isEmpty desc then
                "The network is busy or peers are down — message was not sent. Retry in a moment."

            else
                desc

        else if String.contains "mesh authority rejected" lowered || String.contains "authority rejected" lowered then
            if String.isEmpty desc then
                "The network rejected the message — it was not delivered."

            else
                desc

        else if String.isEmpty desc then
            "Server temporarily unavailable — message not sent. Retry shortly."

        else
            desc

    else if String.isEmpty desc then
        command ++ " failed (" ++ code ++ ")"

    else
        desc


{-| Labeled FAIL for an in-flight send, mirroring
`_failLabeledPending`: the optimistic row is dropped, the failure is
logged, and the `Message not delivered` error toast fires.
Unlabeled messaging FAILs toast the same way (mirroring the oracle
toast) while letting the normal fold continue. Returns `Just` only
when the line is fully consumed. -}
foldLabeledFail : Model -> Wire.IrcMessage -> Wire.StandardReply -> Maybe ( Model, List Outbound )
foldLabeledFail model message reply =
    if reply.command == "EDIT" && message.command == "FAIL" && reply.kind == Wire.Fail then
        foldLabeledEditFail model message

    else if message.command /= "FAIL" then
        Nothing

    else
        case labelOf message of
            Nothing ->
                if isMessagingCommand reply.command then
                    let
                        notice =
                            humanizeSendFail reply.command reply.code reply.description
                    in
                    if String.isEmpty notice then
                        Nothing

                    else
                        Just ( notDeliveredToast (logService model (boundSystemEventText notice)) notice, [] )

                else
                    Nothing

            Just label ->
                case takeScheduledLabel model label of
                    ( unlinked, Just link ) ->
                        -- A scheduled send's FAIL rejects its claim: the
                        -- row stays queued for a later round, never
                        -- toasted, mirroring the dispatcher's async
                        -- rejection.
                        Just (rejectScheduledSend unlinked link)

                    ( _, Nothing ) ->
                        case Dict.get label model.pendingLabels of
                            Nothing ->
                                Nothing

                            Just pending ->
                                let
                                    removed =
                                        updateChannel
                                            { model | pendingLabels = Dict.remove label model.pendingLabels }
                                            pending.target
                                            (\c ->
                                                { c
                                                    | messages =
                                                        List.filter (\m -> not (List.member m.id pending.messageIds)) c.messages
                                                }
                                            )

                                    notice =
                                        humanizeSendFail reply.command reply.code reply.description
                                in
                                Just
                                    ( notDeliveredToast
                                        (logService removed (boundSystemEventText ("Message not delivered: " ++ notice)))
                                        notice
                                    , []
                                    )


foldLabeledEditFail : Model -> Wire.IrcMessage -> Maybe ( Model, List Outbound )
foldLabeledEditFail model message =
    case ( labelOf message, model.runtimeOwnerStamp ) of
        ( Just label, Just owner ) ->
            model.pendingMessageEdits
                |> Dict.toList
                |> List.filter
                    (\( _, pending ) ->
                        pending.label == Just label
                            && pending.owner == owner
                            && pending.generation == model.physicalConnectionGeneration
                    )
                |> List.head
                |> Maybe.map
                    (\( key, _ ) ->
                        ( { model
                            | pendingMessageEdits = Dict.remove key model.pendingMessageEdits
                            , composerError = Just "The server rejected this edit. Your replacement text and original message were kept."
                          }
                        , []
                        )
                    )

        _ ->
            Nothing


{-| Cap on tracked own-echo batch refs. Past the cap a newly
opened echo batch still resolves its rows, but its inner lines are
not suppressed (they fold as live lines) — a deliberate ceiling for
a pathological simultaneous-multiline flood, mirroring the oracle's
bounded-collector philosophy. -}
maxOwnEchoBatches : Int
maxOwnEchoBatches =
    16


{-| Whether a line carries our own nick, for echo correlation. -}
isSelfLine : Model -> Wire.IrcMessage -> Bool
isSelfLine model message =
    case message.nick of
        Nothing ->
            False

        Just nick ->
            String.toLower nick == String.toLower model.ourNick


{-| A chat line inside one of our own tracked echo batches: already
rendered optimistically, so the echo inner carries nothing new and
drops. Only self lines ever suppress — anyone else's content in the
batch still folds. -}
isOwnEchoInner : Model -> Wire.IrcMessage -> Bool
isOwnEchoInner model message =
    (message.command == "PRIVMSG" || message.command == "NOTICE")
        && isSelfLine model message
        && (case Dict.get "batch" message.tags of
                Just ref ->
                    Set.member ref model.ownEchoBatches

                Nothing ->
                    False
           )


{-| One open batch collector. Plain chathistory buffers raw children
for the close-merge; a search batch collects validated result rows
(mirroring `BatchCollector` kind `search`); quarantine diverts and
drops (mirroring `search-quarantine`); a multiline batch reassembles
its inner PRIVMSGs into one message on close (mirroring kind
`multiline`). Labeled-response / history-targets kinds stay deferred. -}
type HistoryBatchKind
    = PlainHistory
    | SearchHistory { generation : Int }
    | MultilineHistory
    | TargetsHistory
    | LabeledResponse
    | GenericBatch
    | Quarantined


type HistoryRequestDirection
    = HistoryLatestRequest
    | HistoryBeforeRequest
    | HistoryAfterRequest
    | HistoryBetweenRequest
    | HistoryAroundRequest


type alias PendingHistoryRequest =
    { direction : HistoryRequestDirection
    , connectionGeneration : Int
    }


{-| First inner line's provenance, reused for the assembled synthetic
PRIVMSG (mirroring `BatchCollector.src`). -}
type alias MultilineSrc =
    { tags : Dict String String
    , prefix : Maybe String
    , nick : Maybe String
    , host : Maybe String
    }


type alias HistoryBatch =
    { target : String
    , kind : HistoryBatchKind
    , parentRef : Maybe String
    , depth : Int
    , openedAt : Float
    , deadline : Float
    , connectionGeneration : Int
    , requestDirection : Maybe HistoryRequestDirection
    , incomplete : Bool
    , query : String
    , raws : List Wire.IrcMessage
    , hits : List VaultHit
    , seenIds : List String
    , receivedRows : Int
    , resultLimited : Bool
    , processingLimited : Bool
    , textTruncated : Bool
    , invalidDropped : Bool
    , duplicateDropped : Bool
    , encryptedDropped : Bool
    , parts : List Multiline.Part
    , multilineChars : Int
    , multilineRejected : Bool
    , multilineSrc : Maybe MultilineSrc
    , responseLabel : Maybe String
    , targetsRows : Dict String HistoryTarget
    , targetsSweepAt : Maybe Int
    , discovery : Maybe HistoryTarget
    , replayEvents : List ReplayEvent
    }


{-| One membership-presence line replayed inside a history batch
(stamp + human text + dedupe key; merged as a plain row at close,
mirroring the `sysMsg` collector entries). -}
type alias ReplayEvent =
    { at : Int
    , body : String
    , key : String
    , msgid : Maybe String
    }


{-| Dedupe key for one replayed line (mirroring `replayEventId`:
a history msgid wins; otherwise target + stamp + text). -}
replayEventKey : Maybe String -> Wire.IrcMessage -> Int -> String -> String
replayEventKey maybeTarget message at body =
    case Dict.get "msgid" message.tags of
        Just msgid ->
            if String.isEmpty msgid then
                compositeReplayKey maybeTarget at body

            else
                "history-event:" ++ msgid

        Nothing ->
            compositeReplayKey maybeTarget at body


compositeReplayKey : Maybe String -> Int -> String -> String
compositeReplayKey maybeTarget at body =
    "history-event:"
        ++ String.toLower (Maybe.withDefault "" maybeTarget)
        ++ ":"
        ++ millisToIso (toFloat at)
        ++ ":"
        ++ body


messageAccessibleLabelFor : Model -> ChatMessage -> String
messageAccessibleLabelFor model message =
    if isDeliveryUnknown model message then
        "Delivery outcome unknown. " ++ messageAccessibleLabel { message | pending = False }

    else
        messageAccessibleLabel message


blankHistoryBatch : String -> HistoryBatch
blankHistoryBatch target =
    { target = target
    , kind = PlainHistory
    , parentRef = Nothing
    , depth = 0
    , openedAt = 0
    , deadline = 0
    , connectionGeneration = 0
    , requestDirection = Nothing
    , incomplete = False
    , query = ""
    , raws = []
    , hits = []
    , seenIds = []
    , receivedRows = 0
    , resultLimited = False
    , processingLimited = False
    , textTruncated = False
    , invalidDropped = False
    , duplicateDropped = False
    , encryptedDropped = False
    , parts = []
    , multilineChars = 0
    , multilineRejected = False
    , multilineSrc = Nothing
    , responseLabel = Nothing
    , targetsRows = Dict.empty
    , targetsSweepAt = Nothing
    , discovery = Nothing
    , replayEvents = []
    }


{-| Open plain-history batch ref for one target, if any (mirroring
the per-target half of `_isHistoryReplay`). -}
openPlainBatchRefFor : Model -> String -> Maybe String
openPlainBatchRefFor model target =
    let
        key =
            String.toLower target
    in
    Dict.foldl
        (\ref collector found ->
            case found of
                Just _ ->
                    found

                Nothing ->
                    if collector.kind == PlainHistory && String.toLower collector.target == key then
                        Just ref

                    else
                        Nothing
        )
        Nothing
        model.historyBatches


{-| First open plain-history batch ref, if any (mirroring the
channel-less `_openChathistoryByTarget` fallback; Elm dictionaries
are key-ordered where the oracle map keeps insertion order —
recorded in COVERAGE). -}
firstOpenPlainBatchRef : Model -> Maybe String
firstOpenPlainBatchRef model =
    Dict.foldl
        (\ref collector found ->
            case found of
                Just _ ->
                    found

                Nothing ->
                    if collector.kind == PlainHistory then
                        Just ref

                    else
                        Nothing
        )
        Nothing
        model.historyBatches


{-| History batch owning one replayed membership line, if any
(mirroring `_isHistoryReplay`: a batch tag into an open batch, or
an untagged line with a history msgid while its target's batch is
open; only plain collectors take replay events). -}
historyReplayRef : Model -> Wire.IrcMessage -> Maybe String -> Maybe String
historyReplayRef model message maybeTarget =
    case Dict.get "batch" message.tags of
        Just ref ->
            case Dict.get ref model.historyBatches of
                Just collector ->
                    if collector.kind == PlainHistory then
                        Just ref

                    else
                        Nothing

                Nothing ->
                    Nothing

        Nothing ->
            if not (Dict.member "msgid" message.tags) then
                Nothing

            else
                case maybeTarget of
                    Just target ->
                        openPlainBatchRefFor model target

                    Nothing ->
                        firstOpenPlainBatchRef model


{-| File one replayed membership line into its batch (mirroring
`_pushReplayEvent`/`_collectHistoryMessage`: plain collectors
only, past the 400-row ceiling drops, collected keys dedupe). -}
pushReplayEvent : Model -> String -> ReplayEvent -> Model
pushReplayEvent model ref event =
    case Dict.get ref model.historyBatches of
        Nothing ->
            model

        Just collector ->
            if collector.kind /= PlainHistory then
                model

            else if List.length collector.raws + List.length collector.replayEvents >= maxHistoryBatchRows then
                model

            else if List.any (\existing -> existing.key == event.key) collector.replayEvents then
                model

            else
                { model
                    | historyBatches =
                        Dict.insert ref
                            { collector | replayEvents = collector.replayEvents ++ [ event ] }
                            model.historyBatches
                }


{-| Divert one replayed membership line into its history batch
(mirroring the seven `_pushReplayEvent` sites: JOIN, PART, QUIT,
KICK, TOPIC, NICK, MODE render into scrollback at their
historical position and never touch live state). Returns `Just`
the updated model when diverted. -}
divertReplayEvent : Model -> Wire.IrcMessage -> Maybe Model
divertReplayEvent model message =
    let
        replayTo target text =
            case historyReplayRef model message target of
                Nothing ->
                    Nothing

                Just ref ->
                    let
                        at =
                            rowTime model message
                    in
                    Just (pushReplayEvent model ref { at = at, body = text, key = replayEventKey target message at text, msgid = msgidOf message })

        nickOr what =
            case message.nick of
                Just nick ->
                    if String.isEmpty nick then
                        what

                    else
                        nick

                Nothing ->
                    what
    in
    case message.command of
        "JOIN" ->
            case ( message.nick, message.params ) of
                ( Just joiner, chan :: _ ) ->
                    if not (validWireToken chan 512) || not (isChannelName model chan) || not (validWireToken joiner 256) then
                        Nothing

                    else
                        replayTo (Just chan) (joiner ++ " joined")

                _ ->
                    Nothing


        "PART" ->
            case ( message.nick, message.params ) of
                ( Just parter, chan :: rest ) ->
                    if not (validWireToken chan 512) || not (isChannelName model chan) || not (validWireToken parter 256) then
                        Nothing

                    else
                        let
                            reason =
                                boundSystemEventText (reasonParam rest)
                        in
                        replayTo (Just chan)
                            (parter
                                ++ " left"
                                ++ (if String.isEmpty reason then
                                        ""

                                    else
                                        " (" ++ reason ++ ")"
                                   )
                            )

                _ ->
                    Nothing

        "QUIT" ->
            case ( message.nick, message.params ) of
                ( Just quitter, rest ) ->
                    if not (validWireToken quitter 256) then
                        Nothing

                    else
                        let
                            reason =
                                boundSystemEventText (reasonParam rest)
                        in
                        replayTo Nothing
                            (quitter
                                ++ " quit"
                                ++ (if String.isEmpty reason then
                                        ""

                                    else
                                        ": " ++ reason
                                   )
                            )

                _ ->
                    Nothing

        "KICK" ->
            case message.params of
                chan :: target :: rest ->
                    let
                        actor =
                            nickOr "server"
                    in
                    if not (validWireToken chan 512) || not (isChannelName model chan) || not (validWireToken target 256) || not (validWireToken actor 256) then
                        Nothing

                    else
                        let
                            reason =
                                boundSystemEventText (reasonParam rest)
                        in
                        replayTo (Just chan)
                            (target
                                ++ " was kicked by "
                                ++ actor
                                ++ (if String.isEmpty reason then
                                        ""

                                    else
                                        " (" ++ reason ++ ")"
                                   )
                            )

                _ ->
                    Nothing

        "TOPIC" ->
            case message.params of
                chan :: rest ->
                    if not (validWireToken chan 512) then
                        Nothing

                    else
                        replayTo (Just chan)
                            (nickOr "someone" ++ " set the topic: " ++ reasonParam rest)

                _ ->
                    Nothing

        "NICK" ->
            case ( message.nick, message.params ) of
                ( Just oldNick, newNick :: _ ) ->
                    if not (validWireToken oldNick 256) || not (validWireToken newNick 256) then
                        Nothing

                    else
                        replayTo Nothing (oldNick ++ " is now known as " ++ newNick)

                _ ->
                    Nothing

        "MODE" ->
            case message.params of
                target :: modeStr :: rest ->
                    if not (isChannelName model target) then
                        Nothing

                    else
                        replayTo (Just target)
                            (nickOr "server" ++ " set mode " ++ boundSystemEventText (String.join " " (modeStr :: rest)))

                _ ->
                    Nothing

        _ ->
            Nothing


{-| Trailing reason text: the param after the target argument
(PART/KICK carry it second, QUIT/TOPIC first). -}
reasonParam : List String -> String
reasonParam rest =
    Maybe.withDefault "" (List.head rest)


{-| Merge collected replay lines into the conversation buffer at
close (mirroring the `sysMsg` collector entries: plain rows from
an empty sender, stamped at the replayed time, sequenced through
the id allocator so the stamp sort stays total). -}
mergeReplayEvents : Model -> String -> List ReplayEvent -> Model
mergeReplayEvents model target events =
    case events of
        [] ->
            model

        _ ->
            let
                key =
                    String.toLower target

                rows =
                    List.indexedMap
                        (\i event ->
                            { id = model.messageSeq + i
                            , from = ""
                            , body = event.body
                            , whisper = False
                            , audience = Nothing
                            , highlight = False
                            , outboxId = Nothing
                            , pending = False
                            , plaintext = Nothing
                            , at = event.at
                            , msgid = event.msgid
                            , reactions = []
                            , edited = False
                            , deleted = False
                            , redacted = False
                            , topic = ""
                            , msgType = "system"
                            , replyTo = Nothing
                            }
                        )
                        events

                withRows =
                    updateChannel model target (\c -> { c | messages = List.take (messageRetentionFor model target) (rows ++ c.messages) })
            in
            sortChannelByStamp
                { withRows | messageSeq = model.messageSeq + List.length events }
                key


{-| Cap on collected multiline parts per batch (mirroring
`MULTILINE_BATCH_PART_MAX = 64`). -}
maxMultilineBatchParts : Int
maxMultilineBatchParts =
    64


{-| Cap on assembled multiline characters per batch (mirroring
`MULTILINE_BATCH_TEXT_MAX = 64 * 1024`; lengths are UTF-16 units on
both sides of the port). -}
maxMultilineBatchChars : Int
maxMultilineBatchChars =
    64 * 1024


{-| Async server-search lifecycle (mirrors `serverStatus`:
idle/pending/done/error). -}
type ServerSearchStatus
    = ServerSearchIdle
    | ServerSearchPending
    | ServerSearchDone
    | ServerSearchError


{-| Validated SEARCH target (mirroring the `cleanTarget` gate:
bounded, trimmed, no CTLs/space/comma, never `:`-led). -}
cleanSearchTarget : String -> Maybe String
cleanSearchTarget target =
    let
        trimmed =
            String.trim target
    in
    if String.isEmpty trimmed || String.length trimmed > maxBatchTargetLength then
        Nothing

    else if String.startsWith ":" trimmed then
        Nothing

    else if String.any (\c -> Char.toCode c <= 0x20 || Char.toCode c == 0x7F || c == ',') trimmed then
        Nothing

    else
        Just trimmed


{-| Whether the deep-search button may run (mirrors
`canServerSearch`: connected, `draft/search` negotiated, a target,
and no E2EE block). -}
canRunServerSearch : Model -> Bool
canRunServerSearch model =
    model.connection == Live
        && List.member "draft/search" model.caps
        && model.activeChannel /= Nothing
        && not (serverSearchBlockedByE2ee model)


{-| Whether server search is deliberately withheld for an encrypted
DM (mirrors `serverSearchBlockedByE2ee`: designated DMs keep query
text off the wire; the vault-privacy-classification clause stays
ahead with hybrid/semantic modes). -}
serverSearchBlockedByE2ee : Model -> Bool
serverSearchBlockedByE2ee model =
    case model.activeChannel of
        Nothing ->
            False

        Just target ->
            not (isChannelName model target) && dmDesignated model target


{-| A history batch is open for this target (mirroring the
`historyLoading` / `_openChathistoryByTarget` conflict: one
in-flight history stream per conversation). -}
historyBatchOpenFor : Model -> String -> Bool
historyBatchOpenFor model targetKey =
    Dict.foldl
        (\_ collector found -> found || String.toLower collector.target == targetKey)
        False
        model.historyBatches


{-| Run one server-side history search (`SEARCH <target> :<query>`,
mirroring `searchServerHistory` + `runServerSearch`: single flight,
validated target, E2EE/stale/history conflicts error, generation
tracking, 6s deadline). -}
runServerSearch : Model -> ( Model, List Outbound )
runServerSearch model =
    let
        query =
            String.trim model.searchQuery
    in
    case model.activeChannel of
        Nothing ->
            ( model, [] )

        Just target ->
            if String.isEmpty query || model.connection /= Live || not (List.member "draft/search" model.caps) then
                ( model, [] )

            else if model.serverSearchStatus == ServerSearchPending then
                ( model, [] )

            else
                case cleanSearchTarget target of
                    Nothing ->
                        ( model, [] )

                    Just clean ->
                        if not (isChannelName model clean) && dmDesignated model clean then
                            failServerSearch model "Encrypted conversation search stays on this device."

                        else if not (isChannelName model clean) && vaultPrivacyFor model clean == DmPrivacyUnknown then
                            -- Unproven device history withholds the query and
                            -- starts the proof scan (mirroring the
                            -- `privacyUnknown` arm: never hold or replay the
                            -- sensitive query, the user retries after the
                            -- target is synchronously known plain).
                            let
                                ( failed, _ ) =
                                    failServerSearch model "Checking device history before server search. Try again shortly."
                            in
                            ( failed, [ ClassifyVaultDm { target = clean } ] )

                        else if Dict.member (String.toLower clean) model.staleServerSearches then
                            failServerSearch model "A prior search response is still ambiguous. Reconnect before searching again."

                        else if historyBatchOpenFor model (String.toLower clean) then
                            failServerSearch model "Wait for the current history request to finish before searching this conversation."

                        else
                            startServerSearch model clean query


failServerSearch : Model -> String -> ( Model, List Outbound )
failServerSearch model message =
    ( { model
        | serverSearchStatus = ServerSearchError
        , serverSearchError = Just message
        , serverSearchNotice = Nothing
        , serverSearchResults = []
      }
    , []
    )


startServerSearch : Model -> String -> String -> ( Model, List Outbound )
startServerSearch model target query =
    let
        generation =
            model.serverSearchGen + 1

        pending =
            { generation = generation
            , target = target
            , targetKey = String.toLower target
            , query = query
            , batchRef = Nothing
            , deadline = model.nowMs + serverSearchTimeoutMs
            }
    in
    ( { model
        | serverSearchTarget = target
        , serverSearchQuery = query
        , serverSearchStatus = ServerSearchPending
        , serverSearchResults = []
        , serverSearchError = Nothing
        , serverSearchNotice = Nothing
        , serverSearchGen = generation
        , serverSearchPending = Just pending
      }
    , [ SendLine (Wire.formatIrcLine "SEARCH" [ target, query ]) ]
    )


{-| Expire a timed-out search: open collectors of its generation
quarantine and the request errors (mirroring the 6s timeout arm;
resolves on the 1s Tick). -}
expireServerSearch : Model -> Model
expireServerSearch model =
    case model.serverSearchPending of
        Nothing ->
            model

        Just pending ->
            if model.nowMs < pending.deadline then
                model

            else
                let
                    quarantined =
                        Dict.map
                            (\_ collector ->
                                case collector.kind of
                                    SearchHistory entry ->
                                        if entry.generation == pending.generation then
                                            { collector | kind = Quarantined }

                                        else
                                            collector

                                    _ ->
                                        collector
                            )
                            model.historyBatches
                in
                { model
                    | historyBatches = quarantined
                    , serverSearchPending = Nothing
                    , staleServerSearches = Dict.insert pending.targetKey pending.generation model.staleServerSearches
                    , serverSearchStatus = ServerSearchError
                    , serverSearchError = Just "No response from the server. Late results will be discarded."
                    , serverSearchNotice = Nothing
                }


expirePendingLabelRequests : Model -> Model
expirePendingLabelRequests model =
    Dict.toList model.pendingLabels
        |> List.filter (\( _, pending ) -> pending.generation == model.physicalConnectionGeneration && model.nowMs >= pending.deadline)
        |> List.foldl (\( label, _ ) current -> markLabeledUnknown current (Just label)) model


expirePendingMessageEdits : Model -> Model
expirePendingMessageEdits model =
    { model
        | pendingMessageEdits =
            Dict.map
                (\_ pending ->
                    if pending.deadline <= model.nowMs then
                        { pending | outcomeUnknown = True }

                    else
                        pending
                )
                model.pendingMessageEdits
    }


markPendingEditUnknown : String -> Model -> Model
markPendingEditUnknown label model =
    { model
        | pendingMessageEdits =
            Dict.map
                (\_ pending ->
                    if pending.label == Just label then
                        { pending | outcomeUnknown = True }

                    else
                        pending
                )
                model.pendingMessageEdits
    }


expireHistoryBatches : Model -> ( Model, List Outbound )
expireHistoryBatches model =
    let
        due =
            model.historyBatches
                |> Dict.toList
                |> List.filter (\( _, batch ) -> batch.connectionGeneration == model.physicalConnectionGeneration && batch.deadline > 0 && model.nowMs >= batch.deadline)
                |> List.sortBy (\( _, batch ) -> batch.openedAt)
    in
    List.foldl
        (\( ref, _ ) ( current, outs ) ->
            case Dict.get ref current.historyBatches of
                Nothing ->
                    ( current, outs )

                Just collector ->
                    let
                        ( next, nextOuts ) =
                            expireOneHistoryBatch current ref collector
                    in
                    ( next, outs ++ nextOuts )
        )
        ( model, [] )
        due


retireOpenHistoryBatches : Model -> ( Model, List Outbound )
retireOpenHistoryBatches model =
    model.historyBatches
        |> Dict.toList
        |> List.sortBy (\( _, batch ) -> batch.openedAt)
        |> List.foldl
            (\( ref, _ ) ( current, outs ) ->
                case Dict.get ref current.historyBatches of
                    Just collector ->
                        let
                            ( next, nextOuts ) =
                                expireOneHistoryBatch current ref collector
                        in
                        ( next, outs ++ nextOuts )

                    Nothing ->
                        ( current, outs )
            )
            ( model, [] )


expireOneHistoryBatch : Model -> String -> HistoryBatch -> ( Model, List Outbound )
expireOneHistoryBatch model ref collector =
    let
        retiredRefs =
            model.historyBatches
                |> Dict.toList
                |> List.filter (\( candidate, _ ) -> isNestedBatch model ref candidate)
                |> List.map Tuple.first

        withoutDescendants =
            { model
                | historyBatches = List.foldl Dict.remove model.historyBatches retiredRefs
                , ownEchoBatches = List.foldl Set.remove model.ownEchoBatches retiredRefs
            }

        base =
            case collector.responseLabel of
                Just label ->
                    markLabeledUnknown withoutDescendants (Just label)

                Nothing ->
                    withoutDescendants
    in
    case collector.kind of
        PlainHistory ->
            let
                timed =
                    { collector | incomplete = True }

                withTimedParent =
                    case collector.parentRef |> Maybe.andThen (\parent -> Dict.get parent base.historyBatches) of
                        Just parent ->
                            { base | historyBatches = Dict.insert (Maybe.withDefault "" collector.parentRef) { parent | incomplete = True } base.historyBatches }

                        Nothing ->
                            base
            in
            closeHistoryBatch { withTimedParent | historyBatches = Dict.insert ref timed withTimedParent.historyBatches } ref

        _ ->
            let
                dropped =
                    { base
                        | historyBatches = Dict.remove ref base.historyBatches
                        , historyLoading = Set.remove (String.toLower collector.target) base.historyLoading
                    }
            in
            ( addToast
                { variant = ToastError
                , title = "History response incomplete"
                , description = Just "The server did not finish this history batch. Incomplete messages were discarded."
                , duration = Nothing
                , groupKey = Just ("history-incomplete:" ++ String.toLower collector.target)
                , undo = Nothing
                }
                dropped.nowMs
                dropped
            , []
            )


isNestedBatch : Model -> String -> String -> Bool
isNestedBatch model parentRef candidate =
    case Dict.get candidate model.historyBatches |> Maybe.andThen .parentRef of
        Just parent ->
            parent == parentRef || isNestedBatch model parentRef parent

        Nothing ->
            False


{-| Whether the settled server results belong to the live panel
context (mirrors `serverSearchMatchesContext`: pending always
shows; done/error only under the same target and query). -}
serverSearchMatchesContext : Model -> Bool
serverSearchMatchesContext model =
    not (String.isEmpty model.serverSearchTarget)
        && (case model.activeChannel of
                Nothing ->
                    False

                Just target ->
                    String.length target == String.length model.serverSearchTarget && String.toLower target == String.toLower model.serverSearchTarget
           )
        && model.serverSearchQuery == String.trim model.searchQuery


{-| Panel-facing server status (mirrors `serverStatus`). -}
serverStatusForPanel : Model -> ServerSearchStatus
serverStatusForPanel model =
    if model.serverSearchStatus == ServerSearchPending then
        ServerSearchPending

    else if serverSearchMatchesContext model then
        model.serverSearchStatus

    else
        ServerSearchIdle


{-| Panel-facing archived results (mirrors `serverResults`: context
match plus the target/envelope UI boundary, so injected or stale
store state can never jump conversations or render ciphertext). -}
serverResultsForPanel : Model -> List VaultHit
serverResultsForPanel model =
    if not (serverSearchMatchesContext model) then
        []

    else
        case model.activeChannel of
            Nothing ->
                []

            Just target ->
                List.filter
                    (\hit ->
                        String.length hit.target == String.length target && String.toLower hit.target == String.toLower target && not (DmCipher.isEnvelope hit.text) && not (GroupEnvelope.isGroupEnvelope hit.text)
                    )
                    model.serverSearchResults


{-| Accessible full-history progress line (mirrors the oracle's
server lifecycle label). -}
serverStatusLabel : Model -> String
serverStatusLabel model =
    case serverStatusForPanel model of
        ServerSearchIdle ->
            ""

        ServerSearchPending ->
            "Searching full server history for " ++ Search.announcedQuery model.searchQuery ++ " in " ++ searchTargetLabel model ++ "."

        ServerSearchError ->
            "Full-history search failed. " ++ Maybe.withDefault "Search failed." model.serverSearchError

        ServerSearchDone ->
            let
                count =
                    List.length (serverResultsForPanel model)

                completion =
                    if count == 0 then
                        "Full-history search complete with no archived matches."

                    else
                        "Full-history search complete with " ++ String.fromInt count ++ " archived match" ++ (if count == 1 then
                            "."

                         else
                            "es."
                        )
            in
            case model.serverSearchNotice of
                Just notice ->
                    if serverSearchMatchesContext model then
                        completion ++ " " ++ notice

                    else
                        completion

                Nothing ->
                    completion


{-| One in-flight server search (mirrors `PendingServerSearch`;
`batchRef` fills in when its batch opens). -}
type alias PendingServerSearch =
    { generation : Int
    , target : String
    , targetKey : String
    , query : String
    , batchRef : Maybe String
    , deadline : Float
    }


{-| Cap on tracked open chathistory batches (mirroring
`OPEN_BATCH_COLLECTOR_MAX = 64`). -}
maxHistoryBatches : Int
maxHistoryBatches =
    64


maxBatchDepth : Int
maxBatchDepth =
    8


historyBatchTimeoutMs : Float
historyBatchTimeoutMs =
    30000


{-| Cap on collected server results per search (mirroring
`SERVER_SEARCH_RESULT_MAX = 200`). -}
maxServerSearchResults : Int
maxServerSearchResults =
    200


{-| Cap on processed server rows per search (mirroring
`SERVER_SEARCH_ROW_MAX = 400`). -}
maxServerSearchRows : Int
maxServerSearchRows =
    400


{-| Result id ceiling (mirroring `SERVER_SEARCH_ID_MAX = 256`). -}
maxServerSearchIdLength : Int
maxServerSearchIdLength =
    256


{-| Sender ceiling (mirroring `SERVER_SEARCH_FROM_MAX = 128`). -}
maxServerSearchFromLength : Int
maxServerSearchFromLength =
    128


{-| Archived body ceiling before windowing (mirroring
`SERVER_SEARCH_TEXT_MAX = 8 * 1024`). -}
maxServerSearchTextLength : Int
maxServerSearchTextLength =
    8192


{-| Server-search reply timeout (mirroring
`SERVER_SEARCH_TIMEOUT_MS = 6000`; resolves on the 1s Tick like the
vault debounce). -}
serverSearchTimeoutMs : Float
serverSearchTimeoutMs =
    6000


{-| Cap on buffered children per batch (mirroring
`HISTORY_BATCH_MESSAGE_MAX = 400`; extras drop like the oracle's
early return). -}
maxHistoryBatchRows : Int
maxHistoryBatchRows =
    400


{-| History page size (mirroring `HISTORY_PAGE_SIZE = 50`): backfill
fetches ask for this many rows, and a close answering with fewer
proves the top of history was reached. -}
historyPageSize : Int
historyPageSize =
    50


{-| Whether the top of a conversation's history was reached
(mirroring `historyExhausted`: sticky per target — once proven,
no refetch runs). -}
isHistoryExhausted : Model -> String -> Bool
isHistoryExhausted model target =
    Set.member (String.toLower target) model.historyExhausted


{-| Prove a conversation exhausted (mirroring
`setHistoryExhausted`). -}
markHistoryExhausted : Model -> String -> Model
markHistoryExhausted model target =
    { model | historyExhausted = Set.insert (String.toLower target) model.historyExhausted }


{-| Byte cap on a batch ref (mirroring `BATCH_REF_MAX = 128`). -}
maxBatchRefLength : Int
maxBatchRefLength =
    128


{-| Target cap on a batch envelope (mirroring
`SERVER_SEARCH_TARGET_MAX = 512`). -}
maxBatchTargetLength : Int
maxBatchTargetLength =
    512


{-| Validated batch ref: non-empty, bounded, no CTLs or space
(mirroring `_validBatchRef`: `[\u0000-\u0020\u007f]` rejected). -}
validBatchRef : String -> Bool
validBatchRef ref =
    not (String.isEmpty ref)
        && String.length ref <= maxBatchRefLength
        && not (String.any (\c -> Char.toCode c <= 0x20 || Char.toCode c == 0x7F) ref)


{-| Validated batch envelope: valid ref plus a non-empty bounded
target with no CTLs (mirroring `_validBatchEnvelope`: space `\u0020`
stays legal in targets, unlike refs). -}
validBatchEnvelope : String -> String -> Bool
validBatchEnvelope ref target =
    validBatchRef ref
        && not (String.isEmpty target)
        && String.length target <= maxBatchTargetLength
        && not (String.any (\c -> Char.toCode c <= 0x1F || Char.toCode c == 0x7F) target)


{-| Fold a `BATCH` line for echo correlation only (search /
history-targets batch machinery stays deferred; chathistory and
multiline opens are handled by the history fold first). An opening
line carrying one of our in-flight labels confirms that send's rows
and tracks the ref so the echo inners suppress; the close forgets
it. A ref owned by a multiline collector is left alone — its
opening label resolves at the close. Foreign batches are ignored. -}
foldEchoBatch : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldEchoBatch model message =
    case message.params of
        refParam :: _ ->
            if String.startsWith "+" refParam then
                openEchoBatch model message (String.dropLeft 1 refParam)

            else if String.startsWith "-" refParam then
                ( { model | ownEchoBatches = Set.remove (String.dropLeft 1 refParam) model.ownEchoBatches }, [] )

            else
                ( model, [] )

        [] ->
            ( model, [] )


openEchoBatch : Model -> Wire.IrcMessage -> String -> ( Model, List Outbound )
openEchoBatch model message ref =
    if String.isEmpty ref then
        ( model, [] )

    else
        case Dict.get ref model.historyBatches of
            Just collector ->
                if collector.kind == MultilineHistory then
                    -- A multiline collector owns this ref: the opening
                    -- label stays pending until the close synthetic
                    -- resolves it (mirroring `responseLabel`), so the
                    -- echo fold must neither consume the label nor
                    -- suppress the diverted inners here.
                    ( model, [] )

                else
                    trackEchoBatch model message ref

            Nothing ->
                trackEchoBatch model message ref


trackEchoBatch : Model -> Wire.IrcMessage -> String -> ( Model, List Outbound )
trackEchoBatch model message ref =
    case labelOf message of
        Nothing ->
            ( model, [] )

        Just label ->
            if Dict.member label model.pendingLabels || Dict.member label model.uncertainLabels then
                let
                    tracked =
                        if Set.size model.ownEchoBatches >= maxOwnEchoBatches then
                            model

                        else
                            { model | ownEchoBatches = Set.insert ref model.ownEchoBatches }
                in
                ( tracked, [] )

            else
                ( model, [] )


{-| Fold a `BATCH` line for chathistory collect/merge
(`draft/chathistory` + `chathistory`, bound to the pending search as
a result collector or quarantine when the target matches), and
multiline reassembly (`draft/multiline`; labeled-response is covered
by the echo fold, history-targets needs TARGETS discovery). Opens
validate the envelope, dedupe refs, and cap open batches like the
oracle; chathistory closes fold buffered children oldest-first
through the normal path and re-sort the target newest-first by
stamp; multiline closes re-dispatch one assembled synthetic PRIVMSG. -}
foldHistoryBatch : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldHistoryBatch model message =
    case message.params of
        refParam :: rest ->
            if String.startsWith "+" refParam then
                openHistoryBatch model message (String.dropLeft 1 refParam) (List.head rest) (List.head (List.drop 2 message.params))

            else if String.startsWith "-" refParam then
                closeHistoryBatch model (String.dropLeft 1 refParam)

            else
                ( model, [] )

        [] ->
            ( model, [] )


{-| Open dispatch keyed on the batch type. Chathistory opens route
through the search/plain collector choice; multiline opens register
a reassembler; a targets discovery open registers its control
collector (it carries no target, so it bypasses the envelope gate
and validates the ref itself, mirroring the open arm). Other kinds
ignore the line. The opening line rides along so a multiline batch
can preserve the correlation label (mirroring the `label` read on
the `draft/multiline` open). -}
openHistoryBatch : Model -> Wire.IrcMessage -> String -> Maybe String -> Maybe String -> ( Model, List Outbound )
openHistoryBatch model message ref maybeType maybeTarget =
    let
        parentRef =
            Dict.get "batch" message.tags

        parentDepth =
            parentRef
                |> Maybe.andThen (\parent -> Dict.get parent model.historyBatches)
                |> Maybe.map .depth
                |> Maybe.withDefault -1

        allowed =
            validBatchRef ref
                && not (Dict.member ref model.historyBatches)
                && Dict.size model.historyBatches < maxHistoryBatches
                && (parentRef == Nothing || parentDepth >= 0 && parentDepth < maxBatchDepth - 1)

        opened =
            if not allowed then
                ( model, [] )

            else
                case maybeType of
                    Just "draft/chathistory-targets" ->
                        if parentRef == Nothing then
                            openHistoryTargetsBatch model ref

                        else
                            insertWrapperBatch model message ref (inheritedWrapperKind model parentRef)

                    Just "labeled-response" ->
                        insertWrapperBatch model message ref (inheritedLabeledResponseKind model parentRef)

                    _ ->
                        case ( maybeType, maybeTarget ) of
                            ( Just batchType, Just target ) ->
                                if not (validBatchEnvelope ref target) then
                                    insertWrapperBatch model message ref (inheritedWrapperKind model parentRef)

                                else if batchType == "draft/chathistory" || batchType == "chathistory" then
                                    case parentRef |> Maybe.andThen (\parent -> Dict.get parent model.historyBatches) of
                                        Just parent ->
                                            case parent.kind of
                                                PlainHistory ->
                                                    if String.toLower parent.target == String.toLower target then
                                                        insertPlainBatch model ref parent.target

                                                    else
                                                        insertQuarantinedBatch model ref target

                                                Quarantined ->
                                                    insertQuarantinedBatch model ref target

                                                _ ->
                                                    openBatchCollector model ref target

                                        Nothing ->
                                            openBatchCollector model ref target

                                else if batchType == "draft/multiline" then
                                    insertMultilineBatch model message ref target

                                else
                                    insertWrapperBatch model message ref (inheritedWrapperKind model parentRef)

                            _ ->
                                insertWrapperBatch model message ref (inheritedWrapperKind model parentRef)
    in
    if not allowed then
        ( model, [] )

    else
        case Dict.get ref (Tuple.first opened).historyBatches of
            Nothing ->
                opened

            Just collector ->
                let
                    decorated =
                        { collector
                            | parentRef = parentRef
                            , depth = parentDepth + 1
                            , openedAt = model.nowMs
                            , deadline = model.nowMs + historyBatchTimeoutMs
                            , connectionGeneration = model.physicalConnectionGeneration
                        }

                    openedModel =
                        Tuple.first opened
                in
                ( { openedModel | historyBatches = Dict.insert ref decorated openedModel.historyBatches }, Tuple.second opened )


insertWrapperBatch : Model -> Wire.IrcMessage -> String -> HistoryBatchKind -> ( Model, List Outbound )
insertWrapperBatch model message ref kind =
    let
        target =
            case Dict.get "batch" message.tags |> Maybe.andThen (\parent -> Dict.get parent model.historyBatches) of
                Just parent ->
                    parent.target

                Nothing ->
                    ""

        base =
            blankHistoryBatch target

        responseLabel =
            Dict.get "label" message.tags
                |> Maybe.andThen (\label -> if Labels.isValidLabel label then Just label else Nothing)
    in
    ( { model
        | historyBatches = Dict.insert ref { base | kind = kind, responseLabel = responseLabel } model.historyBatches
      }
    , []
    )


inheritedWrapperKind : Model -> Maybe String -> HistoryBatchKind
inheritedWrapperKind model parentRef =
    case parentRef |> Maybe.andThen (\parent -> Dict.get parent model.historyBatches) of
        Just parent ->
            case parent.kind of
                PlainHistory ->
                    PlainHistory

                Quarantined ->
                    Quarantined

                SearchHistory _ ->
                    Quarantined

                _ ->
                    GenericBatch

        Nothing ->
            GenericBatch


inheritedLabeledResponseKind : Model -> Maybe String -> HistoryBatchKind
inheritedLabeledResponseKind model parentRef =
    case parentRef |> Maybe.andThen (\parent -> Dict.get parent model.historyBatches) of
        Just parent ->
            case parent.kind of
                PlainHistory ->
                    PlainHistory

                Quarantined ->
                    Quarantined

                SearchHistory _ ->
                    Quarantined

                _ ->
                    LabeledResponse

        Nothing ->
            LabeledResponse


{-| Register one validated multiline batch: the inner PRIVMSGs
reassemble into ONE message when the batch closes (echo of our own
sends included). A client label on the opening BATCH is preserved so
the assembled synthetic PRIVMSG can resolve optimistic rows
(mirroring the `responseLabel` capture). -}
insertMultilineBatch : Model -> Wire.IrcMessage -> String -> String -> ( Model, List Outbound )
insertMultilineBatch model message ref target =
    let
        base =
            blankHistoryBatch target

        responseLabel =
            case Dict.get "label" message.tags of
                Just raw ->
                    if Labels.isValidLabel raw then
                        Just raw

                    else
                        Nothing

                Nothing ->
                    Nothing
    in
    ( { model
        | historyBatches =
            Dict.insert ref { base | kind = MultilineHistory, responseLabel = responseLabel } model.historyBatches
      }
    , []
    )


{-| Register one validated chathistory batch: a batch for the pending
search's target becomes a result collector (or quarantine when it
overlaps an already-bound batch or follows a timed-out search);
anything else is plain playback. -}
openBatchCollector : Model -> String -> String -> ( Model, List Outbound )
openBatchCollector model ref target =
    let
        targetKey =
            String.toLower target

        openRefForTarget =
            Dict.foldl
                (\otherRef collector found ->
                    case found of
                        Just _ ->
                            found

                        Nothing ->
                            if String.toLower collector.target == targetKey then
                                Just otherRef

                            else
                                Nothing
                )
                Nothing
                model.historyBatches
    in
    case model.serverSearchPending of
        Just pending ->
            if pending.targetKey /= targetKey then
                insertPlainBatch model ref target

            else if Dict.member pending.targetKey model.staleServerSearches then
                insertQuarantinedBatch model ref target

            else
                case pending.batchRef of
                    Just _ ->
                        -- A bound search already owns a batch; anything
                        -- else is overlap (a normally-closed bound batch
                        -- resolves the search first).
                        quarantineOverlappingBatch model ref target pending

                    Nothing ->
                        case openRefForTarget of
                            Just _ ->
                                quarantineOverlappingBatch model ref target pending

                            Nothing ->
                                insertSearchBatch model ref target pending

        Nothing ->
            if Dict.member targetKey model.staleServerSearches then
                insertQuarantinedBatch model ref target

            else
                insertPlainBatch model ref target


insertPlainBatch : Model -> String -> String -> ( Model, List Outbound )
insertPlainBatch model ref target =
    let
        base =
            blankHistoryBatch target

        key =
            String.toLower target

        capturedRequest =
            case Dict.get key model.pendingHistoryRequests of
                Just request ->
                    if request.connectionGeneration == model.physicalConnectionGeneration && Set.member key model.historyLoading then
                        Just request.direction

                    else
                        Nothing

                Nothing ->
                    Nothing

        pendingRequests =
            -- A matching-target collector is the terminal query boundary
            -- for this single-flight request, even when its saved
            -- generation/loading fence is stale. It receives direction
            -- authority only through `capturedRequest`; stale provenance
            -- is retired instead of being left available to a later batch.
            Dict.remove key model.pendingHistoryRequests

        ( discovery, discoveries ) =
            case Dict.get key model.pendingDiscoveries of
                Just row ->
                    ( Just row, Dict.remove key model.pendingDiscoveries )

                Nothing ->
                    ( Nothing, model.pendingDiscoveries )
    in
    ( { model
        | historyBatches = Dict.insert ref { base | discovery = discovery, requestDirection = capturedRequest } model.historyBatches
        , pendingHistoryRequests = pendingRequests
        , pendingDiscoveries = discoveries
      }
    , []
    )


insertSearchBatch : Model -> String -> String -> PendingServerSearch -> ( Model, List Outbound )
insertSearchBatch model ref target pending =
    let
        base =
            blankHistoryBatch target

        collector =
            { base | kind = SearchHistory { generation = pending.generation }, query = pending.query }
    in
    ( { model
        | historyBatches = Dict.insert ref collector model.historyBatches
        , serverSearchPending = Just { pending | batchRef = Just ref }
      }
    , []
    )


insertQuarantinedBatch : Model -> String -> String -> ( Model, List Outbound )
insertQuarantinedBatch model ref target =
    let
        base =
            blankHistoryBatch target
    in
    ( { model | historyBatches = Dict.insert ref { base | kind = Quarantined } model.historyBatches }, [] )


{-| Overlapping history batches for one search target: the newcomer
and any open search collector quarantine, and the search errors
(mirroring the overlap arm: results discarded, late rows dropped). -}
quarantineOverlappingBatch : Model -> String -> String -> PendingServerSearch -> ( Model, List Outbound )
quarantineOverlappingBatch model ref target pending =
    let
        quarantined =
            Dict.map
                (\_ collector ->
                    case collector.kind of
                        SearchHistory entry ->
                            if entry.generation == pending.generation then
                                { collector | kind = Quarantined }

                            else
                                collector

                        _ ->
                            collector
                )
                model.historyBatches

        base =
            blankHistoryBatch target

        errored =
            { model
                | historyBatches = Dict.insert ref { base | kind = Quarantined } quarantined
                , serverSearchPending = Nothing
                , serverSearchStatus = ServerSearchError
                , serverSearchError = Just "The server returned overlapping history batches, so search results were discarded."
                , serverSearchNotice = Nothing
            }
    in
    ( errored, [] )


closeHistoryBatch : Model -> String -> ( Model, List Outbound )
closeHistoryBatch model ref =
    case Dict.get ref model.historyBatches of
        Nothing ->
            ( model, [] )

        Just collector ->
            let
                descendants =
                    model.historyBatches
                        |> Dict.toList
                        |> List.filter (\( candidate, _ ) -> isNestedBatch model ref candidate)
                        |> List.map Tuple.first

                withoutOpenChildren =
                    { model | historyBatches = List.foldl Dict.remove model.historyBatches descendants }

                closing =
                    if List.isEmpty descendants then
                        collector

                    else
                        { collector | incomplete = True }
            in
            case collector.parentRef |> Maybe.andThen (\parentRef -> Dict.get parentRef withoutOpenChildren.historyBatches) of
                Just parent ->
                    let
                        parentRef =
                            Maybe.withDefault "" collector.parentRef

                        parentWithStatus =
                            if List.isEmpty descendants then
                                parent

                            else
                                { parent | incomplete = True }

                        parentUpdated =
                            { withoutOpenChildren | historyBatches = Dict.insert parentRef parentWithStatus withoutOpenChildren.historyBatches }
                    in
                    closeNestedHistoryBatch parentUpdated ref closing parentWithStatus

                Nothing ->
                    closeUnparentedHistoryBatch withoutOpenChildren ref closing


closeUnparentedHistoryBatch : Model -> String -> HistoryBatch -> ( Model, List Outbound )
closeUnparentedHistoryBatch model ref collector =
    case collector.kind of
                PlainHistory ->
                    closePlainBatch model ref collector

                SearchHistory entry ->
                    closeSearchBatch model ref collector entry.generation

                MultilineHistory ->
                    closeMultilineBatch model ref collector

                TargetsHistory ->
                    closeHistoryTargetsBatch model ref collector

                LabeledResponse ->
                    closeWrapperBatch model ref collector

                GenericBatch ->
                    closeWrapperBatch model ref collector

                Quarantined ->
                    ( forgetQuarantinedBatch model ref collector, [] )


closeNestedHistoryBatch : Model -> String -> HistoryBatch -> HistoryBatch -> ( Model, List Outbound )
closeNestedHistoryBatch model ref collector parent =
    if parent.kind == Quarantined then
        ( forgetQuarantinedBatch model ref collector, [] )

    else if parent.kind == PlainHistory then
        let
            removed =
                { model | historyBatches = Dict.remove ref model.historyBatches }

            nestedRows =
                case collector.kind of
                    MultilineHistory ->
                        case ( collector.multilineRejected, collector.parts, collector.multilineSrc ) of
                            ( False, _ :: _, Just src ) ->
                                if collector.incomplete then
                                    []

                                else
                                    [ assembledMultilineMessage collector src ]

                            _ ->
                                []

                    _ ->
                        collector.raws

            appended =
                appendCappedBatchRows parent.raws nestedRows

            parentRef =
                Maybe.withDefault "" collector.parentRef
        in
        ( { removed | historyBatches = Dict.insert parentRef { parent | raws = appended } removed.historyBatches }, [] )

    else if collector.kind == LabeledResponse then
        -- A labeled wrapper nested in another nonhistorical wrapper
        -- still carries its own exact response correlation. It may
        -- settle only through the exact self-echo resolver; wrapper
        -- ancestry never sends children through live reducers.
        settleLabeledResponse (forgetQuarantinedBatch model ref collector) collector

    else
        ( forgetQuarantinedBatch model ref collector, [] )


closeWrapperBatch : Model -> String -> HistoryBatch -> ( Model, List Outbound )
closeWrapperBatch model ref collector =
    let
        removed =
            { model | historyBatches = Dict.remove ref model.historyBatches }

        marked =
            if collector.incomplete then
                addToast
                    { variant = ToastError
                    , title = "History response incomplete"
                    , description = Just "The server closed a wrapper before its nested batches finished. Incomplete messages were discarded."
                    , duration = Nothing
                    , groupKey = Just "history-incomplete:wrapper"
                    , undo = Nothing
                    }
                    removed.nowMs
                    removed

            else
                removed
    in
    case collector.parentRef |> Maybe.andThen (\parent -> Dict.get parent marked.historyBatches) of
        Just parent ->
            let
                appended =
                    appendCappedBatchRows parent.raws collector.raws
            in
            ( { marked | historyBatches = Dict.insert (Maybe.withDefault "" collector.parentRef) { parent | raws = appended } marked.historyBatches }, [] )

        Nothing ->
            case ( collector.kind, collector.responseLabel ) of
                ( LabeledResponse, Just label ) ->
                    -- Labeled-response children are buffered so the
                    -- batch tag cannot send them through live folds.
                    -- At close, only the existing exact self-echo
                    -- resolver may settle the captured label; the
                    -- wrapper itself never confirms delivery. Any
                    -- response still outstanding when the wrapper
                    -- completes becomes explicitly delivery-unknown.
                    settleLabeledResponse marked collector

                _ ->
                    -- An unparented generic wrapper has no historical
                    -- or delivery authority. Its children remain
                    -- consumed.
                    ( marked, [] )


settleLabeledResponse : Model -> HistoryBatch -> ( Model, List Outbound )
settleLabeledResponse model collector =
    case collector.responseLabel of
        Just label ->
            let
                ( resolved, outs ) =
                    List.foldl (resolveLabeledWrapperChild label) ( model, [] ) collector.raws

                completed =
                    markPendingEditUnknown label (markLabeledUnknown resolved (Just label))
            in
            ( completed, outs )

        Nothing ->
            ( model, [] )


resolveLabeledWrapperChild : String -> Wire.IrcMessage -> ( Model, List Outbound ) -> ( Model, List Outbound )
resolveLabeledWrapperChild label raw ( model, outs ) =
    let
        correlated =
            { raw
                | tags = raw.tags |> Dict.remove "batch" |> Dict.insert "label" label
            }
    in
    case Wire.parseStandardReply correlated of
        Just reply ->
            if correlated.command == "FAIL" && reply.kind == Wire.Fail && reply.command == "EDIT" then
                case foldLabeledEditFail model correlated of
                    Just ( rejected, failOuts ) ->
                        ( rejected, outs ++ failOuts )

                    Nothing ->
                        ( model, outs )

            else
                resolveLabeledEditOrMessage model correlated outs

        Nothing ->
            resolveLabeledEditOrMessage model correlated outs


resolveLabeledEditOrMessage : Model -> Wire.IrcMessage -> List Outbound -> ( Model, List Outbound )
resolveLabeledEditOrMessage model correlated outs =
    case settlePendingEditEcho model correlated of
        Just ( settled, target ) ->
            let
                ( flushed, flushOuts ) =
                    flushVaultBuffer settled target
            in
            ( flushed, outs ++ flushOuts )

        Nothing ->
            ( resolveLabeledEcho model correlated |> Maybe.withDefault model, outs )


appendCappedBatchRows : List Wire.IrcMessage -> List Wire.IrcMessage -> List Wire.IrcMessage
appendCappedBatchRows existing incoming =
    List.take maxHistoryBatchRows (existing ++ incoming)


removeBatchTag : Wire.IrcMessage -> Wire.IrcMessage
removeBatchTag message =
    { message | tags = Dict.remove "batch" message.tags }


closePlainBatch : Model -> String -> HistoryBatch -> ( Model, List Outbound )
closePlainBatch model ref collector =
    let
        unbatched =
            { model
                | historyBatches = Dict.remove ref model.historyBatches
                , historyLoading = Set.remove (String.toLower collector.target) model.historyLoading
                , historyMerging = True
            }

        step raw ( m, outs ) =
            let
                ( m2, o2 ) =
                    foldParsed m (removeBatchTag raw)
            in
            ( m2, outs ++ o2 )

        ( merging, out ) =
            List.foldl step ( unbatched, [] ) collector.raws

        merged =
            { merging | historyMerging = False }

        sorted =
            sortChannelByStamp merged collector.target

        seen =
            case collector.discovery of
                Just _ ->
                    -- Replaying history does not mean the user viewed
                    -- the newest DM. Only an explicit view action may
                    -- advance this read boundary.
                    sorted

                Nothing ->
                    sorted

        key =
            String.toLower collector.target

        beforeIds =
            case Dict.get key unbatched.channels of
                Just channel ->
                    Set.fromList (List.map .id channel.messages)

                Nothing ->
                    Set.empty

        addedRows =
            case Dict.get key seen.channels of
                Just channel ->
                    List.filter (\m -> not (Set.member m.id beforeIds)) channel.messages

                Nothing ->
                    []

        -- Discovery replay bumps background rows — unless a server
        -- read marker already positions this room (mirroring the
        -- `!readMarkers.has` gate). Ignored senders never bump
        -- channels, and muted or ignored-peer DMs never bump at all.
        counted =
            case collector.discovery of
                Just _ ->
                    if Dict.member key model.readMarkers then
                        seen

                    else if not (isChannelName model collector.target) && (Set.member key model.mutedDMs || Set.member key model.ignoredUsers) then
                        seen

                    else
                        List.foldl
                            (\row acc -> trackUnread acc collector.target row.id row.from row.body row.highlight (topicOrNothing row.topic))
                            seen
                            (List.filter (\row -> not (Set.member (String.toLower row.from) model.ignoredUsers)) addedRows)

                Nothing ->
                    seen

        -- Replay may re-derive counts from an existing server marker,
        -- but closing a history collector is not a user view and must
        -- never create or persist a new read boundary.
        remarked =
            case Dict.get key counted.readMarkers of
                Just iso ->
                    applyReadMarker counted collector.target iso

                Nothing ->
                    counted

        -- Replayed membership lines merge into the buffer at
        -- their historical stamps (mirroring the `sysMsg`
        -- collector entries).
        replayed =
            mergeReplayEvents remarked collector.target collector.replayEvents

        -- Only a completed, locally owned LATEST or BEFORE request
        -- can prove older-history exhaustion from a short page. AFTER
        -- and BETWEEN describe newer/ bounded intervals; unsolicited
        -- or mismatched batches carry no completion authority. A
        -- travel close is a middle slice and never exhausts history.
        traveling =
            case model.pendingTravel of
                Just pending ->
                    String.toLower pending.target == String.toLower collector.target

                Nothing ->
                    False

        provesOlderHistoryExhaustion =
            case collector.requestDirection of
                Just HistoryLatestRequest ->
                    True

                Just HistoryBeforeRequest ->
                    True

                _ ->
                    False

        exhausted =
            if collector.incomplete then
                replayed

            else if traveling then
                replayed

            else if not provesOlderHistoryExhaustion then
                replayed

            else if List.length collector.raws + List.length collector.replayEvents < historyPageSize then
                markHistoryExhausted replayed collector.target

            else
                replayed
        traveled =
            if traveling then
                { exhausted | pendingTravel = Nothing }

            else
                exhausted

        -- The collector answering a pin jump's AROUND request settles
        -- that pin: it lands on the row when the batch brought it, and
        -- otherwise reports it unavailable. Either way the pending pin
        -- clears so a later jump can retry; rows, pins, and exhaustion
        -- stay as merged above.
        settled =
            case ( collector.requestDirection, Dict.get key traveled.pendingPins ) of
                ( Just HistoryAroundRequest, Just pinId ) ->
                    let
                        cleared =
                            { traveled | pendingPins = Dict.remove key traveled.pendingPins }

                        landed =
                            case Dict.get key cleared.channels of
                                Just channel ->
                                    List.any (\row -> row.msgid == Just pinId) channel.messages

                                Nothing ->
                                    False
                    in
                    if landed then
                        { cleared | historyLanding = Just pinId, pinsLoadFeedback = "" }

                    else
                        { cleared | pinsLoadFeedback = "Pinned message could not be loaded from history. Try again." }

                _ ->
                    traveled

        withNotice =
            if collector.incomplete then
                addToast
                    { variant = ToastError
                    , title = "History response incomplete"
                    , description = Just "The server did not finish this history batch. Received messages were kept."
                    , duration = Nothing
                    , groupKey = Just ("history-incomplete:" ++ String.toLower collector.target)
                    , undo = Nothing
                    }
                    settled.nowMs
                    settled

            else
                settled
    in
    ( withNotice, out )


{-| Settle a search batch: time-ordered results plus the limit/drop
notice land only when this batch still owns the pending search for
the current query and target (mirroring the close arm's ownership
check); anything else just drops the collector. -}
closeSearchBatch : Model -> String -> HistoryBatch -> Int -> ( Model, List Outbound )
closeSearchBatch model ref collector generation =
    let
        unbatched =
            { model | historyBatches = Dict.remove ref model.historyBatches }

        sorted =
            List.sortWith
                (\a b ->
                    case compare a.at b.at of
                        LT ->
                            LT

                        EQ ->
                            compare a.id b.id

                        GT ->
                            GT
                )
                collector.hits
    in
    case unbatched.serverSearchPending of
        Just pending ->
            if pending.generation == generation && pending.batchRef == Just ref && unbatched.serverSearchStatus == ServerSearchPending && String.toLower pending.target == String.toLower unbatched.serverSearchTarget && pending.query == unbatched.serverSearchQuery then
                ( { unbatched
                    | serverSearchPending = Nothing
                    , serverSearchStatus = ServerSearchDone
                    , serverSearchResults = sorted
                    , serverSearchError = Nothing
                    , serverSearchNotice = serverSearchNotice collector
                  }
                , []
                )

            else
                ( unbatched, [] )

        Nothing ->
            ( unbatched, [] )


{-| Admit one multiline inner into its collector (mirroring
`_collectMultilinePart`): concat joins without a separator, anything
else counts a newline separator toward the text ceiling. Past 64
parts or 64k chars the batch rejects — parts, chars, and provenance
all clear so the close can never assemble hostile content. The first
accepted line's tags/prefix/nick/host become the synthetic PRIVMSG's
provenance. -}
collectMultilinePart : HistoryBatch -> Wire.IrcMessage -> HistoryBatch
collectMultilinePart collector message =
    if collector.multilineRejected then
        collector

    else
        let
            text =
                trailingParam message.params

            concat =
                Dict.member "draft/multiline-concat" message.tags
                    || Dict.member "+draft/multiline-concat" message.tags

            separatorChars =
                if List.isEmpty collector.parts || concat then
                    0

                else
                    1

            nextChars =
                collector.multilineChars + separatorChars + String.length text
        in
        if List.length collector.parts >= maxMultilineBatchParts || nextChars > maxMultilineBatchChars then
            { collector | parts = [], multilineChars = 0, multilineRejected = True, multilineSrc = Nothing }

        else
            { collector
                | parts = collector.parts ++ [ { text = text, concat = concat } ]
                , multilineChars = nextChars
                , multilineSrc =
                    case collector.multilineSrc of
                        Just _ ->
                            collector.multilineSrc

                        Nothing ->
                            Just
                                { tags = message.tags
                                , prefix = message.prefix
                                , nick = message.nick
                                , host = message.host
                                }
            }


{-| Settle a multiline batch: the parts reassemble into ONE synthetic
PRIVMSG re-dispatched through the full delivery path (highlights,
unread, DM routing, labeled-echo resolution, vault) exactly like a
plain message, mirroring the close arm. The batch framing tags come
off and the opening-BATCH label goes on as the correlation id. A
rejected or empty batch retires its response label as delivery
unknown; it never implies acceptance. -}
closeMultilineBatch : Model -> String -> HistoryBatch -> ( Model, List Outbound )
closeMultilineBatch model ref collector =
    let
        unbatched =
            { model | historyBatches = Dict.remove ref model.historyBatches }
    in
    case ( collector.multilineRejected, collector.parts, collector.multilineSrc ) of
        ( False, _ :: _, Just src ) ->
            foldParsed unbatched (assembledMultilineMessage collector src)

        _ ->
            case collector.responseLabel of
                Just _ ->
                    ( markLabeledUnknown unbatched collector.responseLabel, [] )

                Nothing ->
                    ( unbatched, [] )


assembledMultilineMessage : HistoryBatch -> MultilineSrc -> Wire.IrcMessage
assembledMultilineMessage collector src =
    let
        untagged =
            src.tags
                |> Dict.remove "batch"
                |> Dict.remove "draft/multiline-concat"

        assembledTags =
            case collector.responseLabel of
                Just label ->
                    Dict.insert "label" label untagged

                Nothing ->
                    untagged
    in
    { tags = assembledTags
    , prefix = src.prefix
    , nick = src.nick
    , host = src.host
    , command = "PRIVMSG"
    , params = [ collector.target, Multiline.assembleMultilineText collector.parts ]
    , raw = ""
    }


{-| Archived-results notice from the collector flags (mirroring
`_serverSearchNotice`). -}
serverSearchNotice : HistoryBatch -> Maybe String
serverSearchNotice collector =
    let
        notices =
            List.filterMap identity
                [ if collector.resultLimited then
                    Just ("Results were limited to " ++ String.fromInt maxServerSearchResults ++ ".")

                  else
                    Nothing
                , if collector.processingLimited then
                    Just ("Only the first " ++ String.fromInt maxServerSearchRows ++ " server rows were processed.")

                  else
                    Nothing
                , if collector.textTruncated then
                    Just "Oversized message text was shortened."

                  else
                    Nothing
                , if collector.invalidDropped then
                    Just "Invalid search rows were omitted."

                  else
                    Nothing
                , if collector.duplicateDropped then
                    Just "Duplicate search rows were removed."

                  else
                    Nothing
                , if collector.encryptedDropped then
                    Just "Encrypted history rows were omitted and remain device-only."

                  else
                    Nothing
                ]
    in
    if List.isEmpty notices then
        Nothing

    else
        Just (String.join " " notices)


{-| Forget a quarantined batch, releasing its stale-search claim once
no sibling batch still holds it (mirroring the openRefs-empty
cleanup). -}
forgetQuarantinedBatch : Model -> String -> HistoryBatch -> Model
forgetQuarantinedBatch model ref collector =
    let
        unbatched =
            { model | historyBatches = Dict.remove ref model.historyBatches }

        targetKey =
            String.toLower collector.target

        siblingHolds =
            Dict.foldl
                (\_ other found ->
                    found
                        || (String.toLower other.target == targetKey && other.kind /= PlainHistory)
                )
                False
                unbatched.historyBatches
    in
    case Dict.get targetKey unbatched.staleServerSearches of
        Just _ ->
            if siblingHolds then
                unbatched

            else
                { unbatched | staleServerSearches = Dict.remove targetKey unbatched.staleServerSearches }

        Nothing ->
            unbatched


{-| One discovered history target (mirroring
`HistoryTargetDiscovery`: the wire name plus its latest retained
stamp). -}
type alias HistoryTarget =
    { target : String
    , latestAt : Int
    }


{-| Cap on collected TARGETS rows per reply (mirroring
`HISTORY_TARGET_DISCOVERY_MAX = 64`: the server caps one reply
there, mirrored as the client work bound). -}
maxHistoryTargets : Int
maxHistoryTargets =
    64


{-| Sweep window fuzz each side (mirroring
`HISTORY_TARGET_FUZZ_MS = 10_000`). -}
historyTargetFuzzMs : Int
historyTargetFuzzMs =
    10000


{-| Bound on inbound TARGETS row names (mirroring
`MAX_VAULT_TARGET_LENGTH = 512`). -}
maxHistoryTargetLength : Int
maxHistoryTargetLength =
    512


{-| Whether the chathistory capability is negotiated (mirroring
`hasChatHistoryCap`: `draft/chathistory` or `chathistory`). -}
hasChatHistoryCap : Model -> Bool
hasChatHistoryCap model =
    List.member "draft/chathistory" model.caps || List.member "chathistory" model.caps


{-| Request a TARGETS sweep on registration (mirroring
`_requestHistoryTargetDiscovery`: single flight; the window runs
from the last committed sweep minus fuzz — epoch when never — to
now plus fuzz). -}
requestHistoryTargetDiscovery : Model -> ( Model, List Outbound )
requestHistoryTargetDiscovery model =
    if not (hasChatHistoryCap model) || model.historyTargetsPending || model.historyTargetsBatchRef /= Nothing then
        ( model, [] )

    else
        let
            nowMs =
                floor model.nowMs

            lowerMs =
                case model.lastHistoryTargetsSweepAt of
                    Nothing ->
                        0

                    Just sweepAt ->
                        max 0 (sweepAt - historyTargetFuzzMs)

            upperMs =
                nowMs + historyTargetFuzzMs

            line =
                Wire.formatIrcLine "CHATHISTORY"
                    [ "TARGETS"
                    , "timestamp=" ++ millisToIso (toFloat lowerMs)
                    , "timestamp=" ++ millisToIso (toFloat upperMs)
                    , String.fromInt maxHistoryTargets
                    ]
        in
        ( { model | historyTargetsPending = True, historyTargetsStartedAt = Just nowMs }
        , [ SendLine line ]
        )


{-| Open a `draft/chathistory-targets` batch (mirroring the open
arm: only the pending request's batch opens, validated as a ref;
the target runs `*`). Anything else ignores the line. -}
openHistoryTargetsBatch : Model -> String -> ( Model, List Outbound )
openHistoryTargetsBatch model ref =
    if not model.historyTargetsPending then
        ( model, [] )

    else if not (validBatchRef ref) || Dict.member ref model.historyBatches || Dict.size model.historyBatches >= maxHistoryBatches then
        ( model, [] )

    else
        ( { model
            | historyTargetsPending = False
            , historyTargetsBatchRef = Just ref
            , historyBatches = Dict.insert ref (targetsCollector model.historyTargetsStartedAt) model.historyBatches
            , historyTargetsStartedAt = Nothing
          }
        , []
        )


{-| Blank targets collector for one open reply (the sweep boundary
rides along and commits only when the complete batch closes,
mirroring `historyTargetsSweepAt`). -}
targetsCollector : Maybe Int -> HistoryBatch
targetsCollector sweepAt =
    let
        base =
            blankHistoryBatch "*"
    in
    { base | kind = TargetsHistory, targetsSweepAt = sweepAt, targetsRows = Dict.empty }


{-| Collect one `CHATHISTORY TARGETS` row into the open targets
batch (mirroring the collect arm: server lines carry no nick; the
`@batch` tag correlates, falling back to the open reply the server
that omits it; the timestamp token has the strict millis shape and
must survive an ISO round-trip; first-seen name wins ties only
toward newer stamps; 64 fresh rows max). -}
collectHistoryTarget : Model -> Wire.IrcMessage -> Model
collectHistoryTarget model message =
    case model.historyTargetsBatchRef of
        Nothing ->
            model

        Just openRef ->
            case message.params of
                [ subcommand, target, timestampToken ] ->
                    if String.toUpper subcommand /= "TARGETS" || message.nick /= Nothing then
                        model

                    else
                        let
                            correlated =
                                case Dict.get "batch" message.tags of
                                    Just ref ->
                                        ref == openRef

                                    Nothing ->
                                        True
                        in
                        if not correlated then
                            model

                        else
                            case parseHistoryTargetStamp timestampToken of
                                Nothing ->
                                    model

                                Just latestAt ->
                                    if not (validHistoryTargetName model target) then
                                        model

                                    else
                                        insertHistoryTargetRow model openRef target latestAt

                _ ->
                    model


{-| Strict `timestamp=<ISO>` millis token (mirroring the collect
arm's regex plus `toISOString` round-trip): the `timestamp=` prefix
plus exactly `YYYY-MM-DDTHH:MM:SS.mmmZ`, parsed and re-emitted
equal. -}
parseHistoryTargetStamp : String -> Maybe Int
parseHistoryTargetStamp token =
    case String.split "=" token of
        [ "timestamp", stamp ] ->
            if String.length stamp /= 24 then
                Nothing

            else
                case Wire.parseServerTime stamp of
                    Nothing ->
                        Nothing

                    Just parsed ->
                        if millisToIso (toFloat parsed) == stamp then
                            Just parsed

                        else
                            Nothing

        _ ->
            Nothing


{-| Inbound TARGETS row name (mirroring `_validInboundWireToken`
plus the arm's extra rules: bounded, no CTLs/space, never
`:`-led, no commas, never ourselves). -}
validHistoryTargetName : Model -> String -> Bool
validHistoryTargetName model target =
    not (String.isEmpty target)
        && String.length target <= maxHistoryTargetLength
        && not (String.any (\c -> Char.toCode c <= 0x20 || Char.toCode c == 0x7F) target)
        && not (String.startsWith ":" target)
        && not (String.contains "," target)
        && String.toLower target /= String.toLower model.ourNick


{-| File one validated TARGETS row (newest stamp wins; 64 fresh
rows per reply max, mirroring the collect arm). -}
insertHistoryTargetRow : Model -> String -> String -> Int -> Model
insertHistoryTargetRow model openRef target latestAt =
    case Dict.get openRef model.historyBatches of
        Just collector ->
            case collector.kind of
                TargetsHistory ->
                    let
                        key =
                            String.toLower target

                        rows =
                            collector.targetsRows

                        capped =
                            case Dict.get key rows of
                                Just _ ->
                                    False

                                Nothing ->
                                    Dict.size rows >= maxHistoryTargets
                    in
                    if capped then
                        model

                    else
                        let
                            next =
                                case Dict.get key rows of
                                    Just existing ->
                                        if latestAt > existing.latestAt then
                                            Dict.insert key { target = target, latestAt = latestAt } rows

                                        else
                                            rows

                                    Nothing ->
                                        Dict.insert key { target = target, latestAt = latestAt } rows
                        in
                        { model | historyBatches = Dict.insert openRef { collector | targetsRows = next } model.historyBatches }

                _ ->
                    model

        Nothing ->
            model


{-| Whether the pending server search owns this target (mirroring
`_serverSearchOwnsTarget`: same length plus case-insensitive
equality, so near-miss casings never claim ownership). -}
serverSearchOwnsTarget : Model -> String -> Bool
serverSearchOwnsTarget model target =
    case model.serverSearchPending of
        Nothing ->
            False

        Just pending ->
            String.length target == String.length pending.target && String.toLower target == String.toLower pending.target


{-| Backfill one discovered target (mirroring the per-row half of
`_applyHistoryTargetDiscovery`): channel rows only enrich a shell
the JOIN/session-sync already established — never a phantom room;
DM rows establish a shell carrying the discovery stamp. Targets
already loading, already requested, holding an open batch, or
owned by the pending server search are skipped. The fetch runs
`MARKREAD` (when negotiated) plus `CHATHISTORY LATEST <target>
<reference> 50`, with `*` for an empty buffer and a fuzzed stamp
otherwise. -}
applyHistoryTarget : HistoryTarget -> ( Model, List Outbound ) -> ( Model, List Outbound )
applyHistoryTarget row ( model, outs ) =
    let
        key =
            String.toLower row.target
    in
    if Set.member key model.historyLoading || Set.member key model.historyExhausted || Dict.member key model.pendingDiscoveries || historyBatchOpenFor model key || serverSearchOwnsTarget model row.target then
        ( model, outs )

    else if isChannelName model row.target then
        case Dict.get key model.channels of
            Nothing ->
                ( model, outs )

            Just channel ->
                requestTargetBackfill model channel.name (latestChannelAt channel) row outs

    else if key == String.toLower model.ourNick then
        ( model, outs )

    else
        -- A new DM shell joins the bounded working set (mirroring the
        -- discovery half of the 256-DM cap: evict the oldest read
        -- inactive shell, or refuse the row entirely when every DM is
        -- unread or open — server history recovers it later).
        -- Existing entries only refresh their stamp, never evict.
        case Dict.get key model.channels of
            Just channel ->
                requestTargetBackfill
                    (updateChannel model channel.name (\c -> { c | lastSeen = Just row.latestAt }))
                    row.target
                    Nothing
                    row
                    outs

            Nothing ->
                case ensureDmShellCapacity model row.target of
                    ( _, False ) ->
                        ( model, outs )

                    ( room, True ) ->
                        requestTargetBackfill
                            { room
                                | channels =
                                    Dict.insert key
                                        { name = row.target
                                        , topic = ""
                                        , members = Dict.empty
                                        , modes = ""
                                        , messages = []
                                        , lastSeen = Just row.latestAt
                                        , unread = 0
                                        , highlights = 0
                                        , createdAt = Nothing
                                        }
                                        room.channels
                            }
                            row.target
                            Nothing
                            row
                            outs


{-| Bound on live DM conversations (mirroring
`MAX_LIVE_DM_CONVERSATIONS`): the working set never exceeds 256
peer conversations, so unsolicited discovery can never flood
device memory — server history recovers a refused shell later. -}
maxLiveDmConversations : Int
maxLiveDmConversations =
    256


{-| Bound on live rooms (mirroring `MAX_LIVE_CHANNELS`): a self-JOIN
for an unknown room is refused outright once 256 rooms are held. -}
maxLiveChannels : Int
maxLiveChannels =
    256


{-| Live room count: channel-kind keys held in `channels` (the
oracle counts its rooms-only map; Elm files DMs alongside, so
DM keys are excluded here). -}
liveChannelCount : Model -> Int
liveChannelCount model =
    Dict.foldl
        (\key _ n ->
            if isChannelName model key then
                n + 1

            else
                n
        )
        0
        model.channels


{-| Whether a self-JOIN must be refused (mirroring the join-branch
break: only an unknown room past the bound refuses). -}
channelJoinRefused : Model -> String -> Bool
channelJoinRefused model target =
    not (Dict.member (String.toLower target) model.channels)
        && liveChannelCount model >= maxLiveChannels


{-| Live DM working-set size: non-channel keys held in `channels`
(the oracle counts its separate `dms` map; Elm files DMs and rooms
in one dictionary, so channels are excluded here). -}
dmConversationCount : Model -> Int
dmConversationCount model =
    Dict.foldl
        (\key _ n ->
            if isChannelName model key then
                n

            else
                n + 1
        )
        0
        model.channels


{-| Newest stamp buffered on one conversation, or 0 when empty
(mirroring the `messages.at(-1)` read with its non-finite → 0
fallback). -}
dmLastTime : Channel -> Int
dmLastTime channel =
    case channel.messages of
        [] ->
            0

        newest :: _ ->
            if newest.at >= 0 then
                newest.at

            else
                0


{-| Oldest read inactive DM key (mirroring
`_evictOldestReadInactiveDM`): the active conversation and every
unread one are preserved; among the rest the oldest last-message
stamp loses. Ties break key-first — the oracle's map keeps
insertion order, Elm's dictionary is key-ordered (recorded in
COVERAGE). -}
evictOldestReadInactiveDm : Model -> Maybe String
evictOldestReadInactiveDm model =
    let
        activeKey =
            Maybe.map String.toLower model.activeChannel

        consider key channel best =
            if Just key == activeKey || channel.unread > 0 then
                best

            else
                let
                    stamp =
                        dmLastTime channel
                in
                case best of
                    Nothing ->
                        Just ( key, stamp )

                    Just ( _, bestStamp ) ->
                        if stamp < bestStamp then
                            Just ( key, stamp )

                        else
                            best
    in
    Maybe.map Tuple.first
        (Dict.foldl
            (\key channel best ->
                if isChannelName model key then
                    best

                else
                    consider key channel best
            )
            Nothing
            model.channels
        )


{-| Admit one live-delivery row (mirroring `_addChannelMessage` +
`_addDMMessage`: a channel row lands only in a known room —
unsolicited traffic for an unjoined room drops instead of conjuring
a phantom; a DM row passes through the 256-conversation
evict-or-refuse. History merges store verbatim and skip admission). -}
admitLiveDelivery : Model -> String -> Maybe Model
admitLiveDelivery model target =
    if model.historyMerging then
        Just model

    else if isChannelName model target then
        if Dict.member (String.toLower target) model.channels then
            Just model

        else
            Nothing

    else
        case ensureDmShellCapacity model target of
            ( room, True ) ->
                Just room

            ( _, False ) ->
                Nothing


{-| Room for one more DM shell (mirroring the TARGETS-discovery
half of the cap: an existing entry or a count below the bound
passes; otherwise the oldest read inactive DM is evicted with its
first-unread mark, and a set with nothing evictable refuses the
new shell). -}
ensureDmShellCapacity : Model -> String -> ( Model, Bool )
ensureDmShellCapacity model target =
    let
        key =
            String.toLower target
    in
    if Dict.member key model.channels || dmConversationCount model < maxLiveDmConversations then
        ( model, True )

    else
        case evictOldestReadInactiveDm model of
            Nothing ->
                ( model, False )

            Just evicted ->
                ( { model
                    | channels = Dict.remove evicted model.channels
                    , firstUnreadId = Dict.remove evicted model.firstUnreadId
                  }
                , True
                )


{-| Newest stamp buffered on a channel, if any (mirroring
`_latestFiniteMessageTime` over the live rows). -}
latestChannelAt : Channel -> Maybe Int
latestChannelAt channel =
    List.foldl
        (\message found ->
            case found of
                Nothing ->
                    Just message.at

                Just best ->
                    Just (max best message.at)
        )
        Nothing
        channel.messages


{-| Emit the backfill fetch and mark the target loading + requested
(mirroring the request tail: `MARKREAD` only with
`draft/read-marker`; a failed send releases both — Elm sends queue
through ports, so both commit together). -}
requestTargetBackfill : Model -> String -> Maybe Int -> HistoryTarget -> List Outbound -> ( Model, List Outbound )
requestTargetBackfill model target maybeLatest row outs =
    let
        reference =
            case maybeLatest of
                Nothing ->
                    "*"

                Just latest ->
                    "timestamp=" ++ millisToIso (toFloat (max 0 (latest - historyTargetFuzzMs)))

        markRead =
            if Session.hasCapability model.caps "draft/read-marker" then
                [ SendLine (Wire.formatIrcLine "MARKREAD" [ target ]) ]

            else
                []

        fetch =
            SendLine (Wire.formatIrcLine "CHATHISTORY" [ "LATEST", target, reference, String.fromInt historyPageSize ])
    in
    ( { model
        | historyLoading = Set.insert (String.toLower target) model.historyLoading
        , pendingHistoryRequests = Dict.insert (String.toLower target) { direction = HistoryLatestRequest, connectionGeneration = model.physicalConnectionGeneration } model.pendingHistoryRequests
        , pendingDiscoveries = Dict.insert (String.toLower target) row model.pendingDiscoveries
      }
    , outs ++ markRead ++ [ fetch ]
    )


{-| Settle a TARGETS batch: the sweep boundary commits, every row
fans out to a backfill fetch, and the rows merge into the discovery
ledger (newest stamp wins; the ledger holds the newest 64,
mirroring the per-reply work bound). Discovery unread bumps land
when the following plain LATEST batch closes (`closePlainBatch`),
not in this transport close. -}
closeHistoryTargetsBatch : Model -> String -> HistoryBatch -> ( Model, List Outbound )
closeHistoryTargetsBatch model ref collector =
    let
        unbatched =
            { model
                | historyBatches = Dict.remove ref model.historyBatches
                , historyTargetsBatchRef =
                    case model.historyTargetsBatchRef of
                        Just openRef ->
                            if openRef == ref then
                                Nothing

                            else
                                Just openRef

                        Nothing ->
                            Nothing
            }

        swept =
            case collector.targetsSweepAt of
                Just sweepAt ->
                    { unbatched | lastHistoryTargetsSweepAt = Just sweepAt }

                Nothing ->
                    unbatched

        ( applied, requestOut ) =
            List.foldl applyHistoryTarget ( swept, [] ) (List.take maxHistoryTargets (Dict.values collector.targetsRows))

        merged =
            Dict.foldl
                (\key row acc ->
                    case Dict.get key acc of
                        Just existing ->
                            if row.latestAt > existing.latestAt then
                                Dict.insert key row acc

                            else
                                acc

                        Nothing ->
                            Dict.insert key row acc
                )
                applied.historyTargets
                collector.targetsRows

        trimmed =
            merged
                |> Dict.values
                |> List.sortBy .latestAt
                |> List.reverse
                |> List.take maxHistoryTargets
                |> List.foldl (\row acc -> Dict.insert (String.toLower row.target) row acc) Dict.empty
    in
    ( { applied | historyTargets = trimmed }, requestOut )


{-| Release a failed CHATHISTORY fetch (mirroring the FAIL arm: a
channel context clears that target's loading; a failed AROUND pin
lookup drops its pending pin but proves nothing about exhaustion,
so only non-pin failures mark exhausted; anything else clears the
TARGETS transport so a later reconnect can retry, and releases
every named discovery fetch). -}
foldChathistoryFail : Model -> Wire.StandardReply -> ( Model, List Outbound )
foldChathistoryFail model reply =
    case List.filter (isChannelName model) reply.context of
        channel :: _ ->
            let
                key =
                    String.toLower channel

                unloaded =
                    { model
                        | historyLoading = Set.remove key model.historyLoading
                        , pendingHistoryRequests = Dict.remove key model.pendingHistoryRequests
                    }
            in
            if Dict.member key model.pendingPins then
                ( { unloaded | pendingPins = Dict.remove key unloaded.pendingPins }, [] )

            else
                ( markHistoryExhausted unloaded channel, [] )

        [] ->
            let
                transportCleared =
                    if model.historyTargetsPending || model.historyTargetsBatchRef /= Nothing then
                        case model.historyTargetsBatchRef of
                            Just openRef ->
                                { model
                                    | historyTargetsPending = False
                                    , historyTargetsStartedAt = Nothing
                                    , historyTargetsBatchRef = Nothing
                                    , historyBatches = Dict.remove openRef model.historyBatches
                                }

                            Nothing ->
                                { model | historyTargetsPending = False, historyTargetsStartedAt = Nothing }

                    else
                        model
            in
            ( List.foldl
                (\token released ->
                    { released
                        | pendingDiscoveries = Dict.remove (String.toLower token) released.pendingDiscoveries
                        , historyLoading = Set.remove (String.toLower token) released.historyLoading
                    }
                )
                transportCleared
                reply.context
            , []
            )


{-| Newest-first re-sort of one channel by stamp (mirrors the oracle's
close-merge time sort; ties break on fresher row id, so same-stamp
rows keep fold order with the newest fold first). A missing channel
stays missing like the oracle's `if (c)` skip — the sort must never
conjure a conversation. -}
sortChannelByStamp : Model -> String -> Model
sortChannelByStamp model target =
    case Dict.get (String.toLower target) model.channels of
        Nothing ->
            model

        Just _ ->
            updateChannel model
                target
                (\c ->
                    { c
                        | messages =
                            List.sortWith
                                (\a b ->
                                    case compare a.at b.at of
                                        LT ->
                                            GT

                                        EQ ->
                                            compare b.id a.id

                                        GT ->
                                            LT
                                )
                                c.messages
                    }
                )


{-| Divert a `batch`-tagged chat child into its open collector
(spec path of `_isHistoryReplay`). Untagged lines and children of
unknown/foreign batches fall through to the normal fold. Plain
children buffer for the close-merge (msgids stay unfiled until the
close re-fold files them, so an unclosed batch can never poison the
rewind ledger); search children validate into result rows; multiline
children accumulate reassembly parts under the 64-part / 64k-char
ceilings; quarantined children divert-and-drop. -}
divertHistoryBatch : Model -> Wire.IrcMessage -> Maybe Model
divertHistoryBatch model message =
    if message.command == "BATCH" then
        Nothing

    else
        case Dict.get "batch" message.tags of
        Nothing ->
            Nothing

        Just ref ->
            case Dict.get ref model.historyBatches of
                Nothing ->
                    -- Unknown or retired @batch references are
                    -- consumed before any live reducer sees them.
                    Just model

                Just collector ->
                    if message.command /= "PRIVMSG" && message.command /= "NOTICE" then
                        if collector.kind == LabeledResponse
                            && List.member message.command [ "FAIL", "WARN" ]
                            && Wire.parseStandardReply message /= Nothing
                            && List.length collector.raws < maxHistoryBatchRows then
                            Just { model | historyBatches = Dict.insert ref { collector | raws = appendCappedBatchRows collector.raws [ message ] } model.historyBatches }

                        else if collector.kind == TargetsHistory && message.command == "CHATHISTORY" then
                            Just (collectHistoryTarget model message)

                        else
                            case divertReplayEvent model message of
                                Just replayed ->
                                    Just replayed

                                Nothing ->
                                    Just model

                    else
                        case collector.kind of
                            PlainHistory ->
                                if List.length collector.raws >= maxHistoryBatchRows then
                                    Just model

                                else
                                    Just { model | historyBatches = Dict.insert ref { collector | raws = collector.raws ++ [ message ] } model.historyBatches }

                            SearchHistory _ ->
                                Just { model | historyBatches = Dict.insert ref (collectServerRow model collector message) model.historyBatches }

                            MultilineHistory ->
                                Just { model | historyBatches = Dict.insert ref (collectMultilinePart collector message) model.historyBatches }

                            TargetsHistory ->
                                -- A chat line tagged into the control
                                -- batch is malformed: divert-and-drop
                                -- like quarantine (mirroring the
                                -- `history-targets` arm).
                                Just model

                            LabeledResponse ->
                                Just { model | historyBatches = Dict.insert ref { collector | raws = appendCappedBatchRows collector.raws [ message ] } model.historyBatches }

                            GenericBatch ->
                                Just { model | historyBatches = Dict.insert ref { collector | raws = appendCappedBatchRows collector.raws [ message ] } model.historyBatches }

                            Quarantined ->
                                Just model


{-| One validated search-batch row outcome (mirroring the
`_collectServerSearchMessage` drop flags that feed the notice). -}
type ServerRowOutcome
    = ServerRowHit VaultHit
    | ServerRowInvalid
    | ServerRowDuplicate
    | ServerRowEncrypted


{-| Validate one search-batch row into its collector (mirroring
`_collectServerSearchMessage`: row/result caps with flags, msgid +
server-time required, id/from bounds, target equality, per-batch
dedupe, envelope drop, 8k truncation before query windowing). -}
collectServerRow : Model -> HistoryBatch -> Wire.IrcMessage -> HistoryBatch
collectServerRow model collector message =
    let
        received =
            collector.receivedRows + 1

        counted =
            { collector | receivedRows = received }
    in
    if received > maxServerSearchRows then
        { counted | processingLimited = True }

    else if List.length counted.hits >= maxServerSearchResults then
        { counted | resultLimited = True }

    else
        case collectServerHit model counted message of
            ServerRowHit hit ->
                flagTruncatedHit counted (trailingParam message.params) hit

            ServerRowInvalid ->
                { counted | invalidDropped = True }

            ServerRowDuplicate ->
                { counted | duplicateDropped = True }

            ServerRowEncrypted ->
                { counted | encryptedDropped = True }


collectServerHit : Model -> HistoryBatch -> Wire.IrcMessage -> ServerRowOutcome
collectServerHit model collector message =
    case ( msgidOf message, serverTimeMsOf message, message.params ) of
        ( Just rawId, Just at, childTarget :: body :: _ ) ->
            let
                sender =
                    Maybe.withDefault "" message.nick

                invalid =
                    String.isEmpty rawId
                        || String.length rawId > maxServerSearchIdLength
                        || String.any (\c -> Char.toCode c <= 0x1F || Char.toCode c == 0x7F) rawId
                        || String.isEmpty sender
                        || String.length sender > maxServerSearchFromLength
                        || String.any (\c -> Char.toCode c <= 0x1F || Char.toCode c == 0x7F) sender
                        || String.toLower childTarget /= String.toLower collector.target
            in
            if invalid then
                ServerRowInvalid

            else if List.member rawId collector.seenIds then
                ServerRowDuplicate

            else if DmCipher.isEnvelope body || GroupEnvelope.isGroupEnvelope body then
                ServerRowEncrypted

            else
                ServerRowHit
                    { id = rawId
                    , from = sender
                    , text = Search.resultText (Search.safeSlice maxServerSearchTextLength body) collector.query
                    , at = at
                    , target = collector.target
                    }

        _ ->
            ServerRowInvalid


{-| Flag a collected hit's 8k truncation (mirroring `textTruncated`:
set when the ceiling shortens the body; result windowing is display
and never flags). -}
flagTruncatedHit : HistoryBatch -> String -> VaultHit -> HistoryBatch
flagTruncatedHit collector body hit =
    { collector
        | hits = collector.hits ++ [ hit ]
        , seenIds = hit.id :: collector.seenIds
        , textTruncated = collector.textTruncated || Search.safeSlice maxServerSearchTextLength body /= body
    }


{-| Render our own just-sent texts immediately (no `echo-message`
cap): one channel row per part plus a vault persist through the
normal path, mirroring the oracle's optimistic `_addMessage`. The
untagged server echo is then dropped by `isLiveSelfEcho`, so a send
renders exactly once. A `Just` label marks every row pending and the
caller must have registered it via `registerLabeledSend`; the labeled
echo, ACK, or FAIL then resolves it. -}
renderOptimisticSend : Model -> String -> List String -> List Outbound -> Maybe String -> Maybe Char -> ( Model, List Outbound )
renderOptimisticSend model target texts outgoing label audience =
    let
        key =
            String.toLower target

        step text ( rendered, rows ) =
            let
                messageId =
                    rendered.messageSeq

                chatMessage =
                    { id = messageId
                    , from = rendered.ourNick
                    , body = text
                    , whisper = False
                    , audience = audience
                    , highlight = False
                    , outboxId = Nothing
                    , pending = label /= Nothing
                    , plaintext = Nothing
                    , at = floor rendered.nowMs
                    , msgid = Nothing
                    , reactions = []
                    , edited = False
                    , deleted = False
                    , redacted = False
                    , topic = Maybe.withDefault "" (activeChannelTopic rendered target)
                    , msgType = "msg"
                    , replyTo = Nothing
                    }

                vaultRow =
                    { id = key ++ ":" ++ String.fromInt messageId
                    , wireMessageId = Nothing
                    , target = key
                    , from = rendered.ourNick
                    , body = text
                    , at = floor rendered.nowMs
                    , rowType = "msg"
                    , deleted = False
                    , redacted = False
                    , replyTo = Nothing
                    }
            in
            ( updateChannel { rendered | messageSeq = messageId + 1, ownedRowIds = markOwnedRow messageId rendered.ownedRowIds } target
                (\c ->
                    { c | messages = List.take (messageRetentionFor rendered target) (chatMessage :: c.messages) }
                )
            , rows ++ [ vaultRow ]
            )

        ( withRows, vaultRows ) =
            List.foldl step ( model, [] ) texts

        -- Own sends fetch their links' previews too (mirroring the
        -- oracle render-time fetch, which covers own rows as well as
        -- inbound ones — the same prefs/media gates apply).
        ( previewed, previewOuts ) =
            requestPreviewsForTexts withRows texts

        -- A dispatched send stops our typing signal (mirroring
        -- the oracle `resetAfterSend`).
        ( stopped, stopOut ) =
            sendTyping (rememberVaultIds previewed vaultRows) target False
    in
    ( stopped
    , outgoing ++ [ vaultPersistOutbound model key vaultRows ] ++ previewOuts ++ stopOut
    )


{-| Bare channel for a `STATUSMSG` target (`@#chan` → `#chan`)
when the network advertises the prefix; anything else passes through
verbatim. The server relays status messages with the prefix intact,
addressed to the whole channel's rank slice — filing under the bare
channel keeps one conversation per room instead of a phantom DM.
Unadvertised networks never strip.
-}
stripStatusmsgTarget : Model -> String -> String
stripStatusmsgTarget model target =
    case Isupport.statusmsgChannel model.isupport target of
        Just split ->
            split.channel

        Nothing ->
            target


{-| Person token for people-first copy: control bytes stripped,
trimmed, capped (mirroring `sanitizePersonToken`). -}
sanitizePersonToken : String -> Int -> String
sanitizePersonToken value max =
    String.left max
        (String.trim
            (String.filter
                (\c ->
                    let
                        code =
                            Char.toCode c
                    in
                    code >= 0x20 && code /= 0x7F
                )
                value
            )
        )


blockedDmComposeCopy : String -> { title : String, description : String }
blockedDmComposeCopy nick =
    { title = "You blocked " ++ sanitizePersonToken nick 128
    , description = "Unblock them on this device to send a message."
    }


{-| True when the target is a DM nick on the local ignore/block list
(mirroring `isBlockedDmTarget`: channel prefixes from ISUPPORT
CHANTYPES never match, and the lookup is case-insensitive). -}
isBlockedDmTarget : Model -> String -> Bool
isBlockedDmTarget model target =
    let
        nick =
            String.trim target
    in
    if String.isEmpty nick then
        False

    else
        case String.toList nick of
            lead :: _ ->
                if String.contains (String.fromChar lead) model.isupport.chantypes then
                    False

                else
                    Set.member (String.toLower nick) model.ignoredUsers

            [] ->
                False


{-| Refuse a DM send to a blocked nick: the draft stays, the inline
error lands, and the info toast mirrors the oracle composer gate. -}
refuseBlockedDm : Model -> String -> ( Model, List Outbound )
refuseBlockedDm model target =
    let
        copy =
            blockedDmComposeCopy target
    in
    ( addToast
        { variant = ToastInfo
        , title = copy.title
        , description = Just copy.description
        , duration = Nothing
        , groupKey = Nothing
        , undo = Nothing
        }
        model.nowMs
        { model | composerError = Just copy.description }
    , []
    )


{-| Wire target for a channel send under the composer's audience:
the audience prefix plus the room when set and advertised, the room
itself with no audience. Returns `Nothing` when an audience is set
but no longer honorable (room left, prefix withdrawn) — sending bare
would widen an ops-only message to everyone, so the send refuses
instead of downgrading.
-}
composerSendTarget : Model -> String -> Maybe String
composerSendTarget model target =
    case model.composerAudience of
        Nothing ->
            Just target

        Just prefix ->
            if isChannelName model target && String.contains (String.fromChar prefix) model.isupport.statusmsg then
                Just (String.fromChar prefix ++ target)

            else
                Nothing


{-| Whether the composer may offer the audience toggle: an open
channel whose policy sends plaintext and a network advertising
status prefixes. Sealed rooms and DMs cannot honor an audience, so
the toggle stays hidden there instead of promising what the send
cannot keep.
-}
composerAudienceOffered : Model -> Bool
composerAudienceOffered model =
    case model.activeChannel of
        Nothing ->
            False

        Just target ->
            isChannelName model target
                && not (String.isEmpty model.isupport.statusmsg)
                && roomEncryptionPolicy model target
                /= RequiredPolicy


{-| Step the composer audience through the advertised prefixes and
back to everyone. A stale selection (prefix withdrawn mid-compose)
restarts the cycle instead of sticking.
-}
nextComposerAudience : Model -> Maybe Char
nextComposerAudience model =
    let
        options =
            String.toList model.isupport.statusmsg
    in
    case model.composerAudience of
        Nothing ->
            List.head options

        Just current ->
            let
                step list =
                    case list of
                        a :: b :: _ ->
                            if a == current then
                                Just b

                            else
                                step (List.drop 1 list)

                        _ ->
                            Nothing
            in
            step options


{-| Audience toggle copy: rank names follow the server's
`statusPrefixRank` ladder (founder > owner > op > voice); unknown
symbols fall back to the wire character.
-}
audienceLabel : Maybe Char -> String
audienceLabel audience =
    case audience of
        Nothing ->
            "Everyone"

        Just '!' ->
            "Founders"

        Just '.' ->
            "Owners"

        Just '@' ->
            "Ops"

        Just '+' ->
            "Voice"

        Just other ->
            String.fromChar other


{-| Audience badge tooltip: who can see the row. -}
audienceTitle : Maybe Char -> String
audienceTitle audience =
    case audience of
        Nothing ->
            ""

        Just _ ->
            "Only visible to " ++ String.toLower (audienceLabel audience)


{-| Peer bucket for filing a live DM row (mirroring the oracle
`msgTarget`: channels keep the wire target; our own echo stays under
its wire target; any other DM lands in the sender's bucket — never a
shared own-nick bucket. An empty sender keeps the wire target; the
oracle drops that line on the token guard instead, which Elm covers
on its own delivery-fate path). -}
dmFileBucket : Model -> String -> String -> String
dmFileBucket model target sender =
    let
        bare =
            stripStatusmsgTarget model target
    in
    if isChannelName model bare then
        bare

    else if String.toLower sender == String.toLower model.ourNick then
        target

    else if String.isEmpty sender then
        target

    else
        sender


{-| Peer bucket for addressing a DM row from a mutation command
(mirroring the oracle TAGMSG/REACT/REDACT/EDIT arms: when the wire
target is our own nick the peer actor owns the bucket; our own echo
and channel targets keep the wire target). -}
dmMutateBucket : Model -> String -> String -> String
dmMutateBucket model target actor =
    let
        bare =
            stripStatusmsgTarget model target
    in
    if isChannelName model bare then
        bare

    else if String.toLower target == String.toLower model.ourNick && not (String.isEmpty actor) then
        actor

    else
        target


foldChat : Model -> Wire.IrcMessage -> Bool -> ( Model, List Outbound )
foldChat model message isNotice =
    -- A REDACT that outran its original (live or replayed) left a
    -- pending (bucket, msgid) mark: the original files with the fixed
    -- redaction copy in place of its body, so the secret text never
    -- reaches a row, a notification, or the vault.
    case pendingRedactionFor model message of
        Just mark ->
            let
                cleared =
                    { model | pendingRedactions = List.filter ((/=) mark) model.pendingRedactions }

                scrubbed =
                    case message.params of
                        target :: _ :: rest ->
                            { message | params = target :: redactedBody :: rest }

                        _ ->
                            message

                ( folded, outs ) =
                    foldChatRow cleared scrubbed isNotice
            in
            ( markRowRedacted folded mark, outs )

        Nothing ->
            foldChatRow model message isNotice


{-| The pending redaction mark an inbound chat line answers, if any. -}
pendingRedactionFor : Model -> Wire.IrcMessage -> Maybe ( String, String )
pendingRedactionFor model message =
    case ( msgidOf message, message.params ) of
        ( Just msgid, target :: _ :: _ ) ->
            let
                mark =
                    ( String.toLower (dmFileBucket model (stripStatusmsgTarget model target) (Maybe.withDefault "" message.nick)), msgid )
            in
            if List.member mark model.pendingRedactions then
                Just mark

            else
                Nothing

        _ ->
            Nothing


markRowRedacted : Model -> ( String, String ) -> Model
markRowRedacted model ( key, msgid ) =
    case Dict.get key model.channels of
        Nothing ->
            model

        Just ch ->
            { model
                | channels =
                    Dict.insert key
                        { ch
                            | messages =
                                List.map
                                    (\m ->
                                        if m.msgid == Just msgid then
                                            { m | redacted = True, body = redactedBody }

                                        else
                                            m
                                    )
                                    ch.messages
                        }
                        model.channels
            }


{-| Bounded memory of redactions whose original has not arrived yet. -}
maxPendingRedactions : Int
maxPendingRedactions =
    256


rememberPendingRedaction : Model -> String -> String -> Model
rememberPendingRedaction model key msgid =
    { model | pendingRedactions = List.take maxPendingRedactions (( key, msgid ) :: List.filter ((/=) ( key, msgid )) model.pendingRedactions) }


foldChatRow : Model -> Wire.IrcMessage -> Bool -> ( Model, List Outbound )
foldChatRow model message isNotice =
    case resolveLabeledEcho model message of
        Just resolved ->
            ( resolved, [] )

        Nothing ->
            if isOwnEchoInner model message then
                -- Our own echo-batch inner: already rendered
                -- optimistically, so the replayed line drops here
                -- (its msgid is already filed by `foldParsed`).
                ( model, [] )

            else if not isNotice && isLiveSelfEcho model message then
                ( model, [] )

            else
                case message.params of
                target :: body :: _ ->
                    let
                        -- A STATUSMSG line keeps its audience prefix on
                        -- the wire (`@#chan`); everything below files,
                        -- highlights, and narrows under the bare channel.
                        bareTarget =
                            stripStatusmsgTarget model target

                        statusAudience =
                            Maybe.map .prefix (Isupport.statusmsgChannel model.isupport target)

                        sender =
                            Maybe.withDefault "" message.nick

                        ( resolvedBody, inboundReply ) =
                            resolveInboundReply model (dmFileBucket model bareTarget sender) message body
                    in
                    case
                        if model.historyMerging then
                            Nothing

                        else
                            parseCtcpMutation resolvedBody
                    of
                        Just parsed ->
                            ( foldCtcpMutation model bareTarget sender parsed, [] )

                        Nothing ->
                            case foldScreenshareCtcp model sender resolvedBody of
                                Just done ->
                                    -- Inbound CTCP SCREENSHARE wrapper:
                                    -- START notifies, STOP swallows, both
                                    -- file no row — mirroring the oracle
                                    -- arms ahead of the query path.
                                    done

                                Nothing ->
                                    if isCtcpQueryBody isNotice sender model.ourNick resolvedBody then
                                        -- Inbound non-self CTCP query (or unknown
                                        -- CTCP, ACTION included): answer the four
                                        -- known queries, swallow the row either
                                        -- way — mirroring the oracle `break`.
                                        ( model, foldCtcpQuery model sender resolvedBody )

                                    else
                                        case
                                            if model.historyMerging then
                                                DeliverNormal

                                            else
                                            deliveryFate model bareTarget sender
                                    of
                                        DeliverDrop ->
                                            -- Ignored-sender channel rows file
                                            -- nothing, but the oracle notifies
                                            -- before it files (and drops) — so
                                            -- mention/follow inbox rows still
                                            -- record here.
                                            let
                                                dropped =
                                                    recordMentionNotification
                                                        (recordFollowNotification model bareTarget sender resolvedBody (parseMessageTopic message.tags))
                                                        bareTarget
                                                        sender
                                                        resolvedBody
                                                        (classifyHighlight model bareTarget sender resolvedBody)
                                            in
                                            ( dropped, [] )

                                        fate ->
                                            let
                                                bucket =
                                                    dmFileBucket model bareTarget sender
                                            in
                                            case admitLiveDelivery model bucket of
                                                Nothing ->
                                                    ( model, [] )

                                                Just admitted ->
                                                    let
                                                        placeholder =
                                                            fate == DeliverPlaceholder

                                                        effectiveBody =
                                                            if placeholder then
                                                                "Message from ignored user"

                                                            else if isNotice then
                                                                -- NOTICE bodies that are Discord webhook JSON flatten to
                                                                -- IRC-safe text (mirroring `formatWebhookNoticeBody` over
                                                                -- the notice display text; highlight classification below
                                                                -- reads the resolved body like `mentionsMe(resolvedText)`).
                                                                Webhook.formatNoticeBody resolvedBody

                                                            else
                                                                resolvedBody

                                                        rowHighlight =
                                                            if placeholder then
                                                                False

                                                            else
                                                                classifyHighlight model bareTarget sender resolvedBody

                                                        next =
                                                            updateChannel admitted bucket
                                                                (\c ->
                                                                    { c
                                                                        | messages =
                                                                            List.take (messageRetentionFor admitted bucket)
                                                                                ({ id = model.messageSeq
                                                                                 , from = sender
                                                                                 , body = effectiveBody
                                                                                 , whisper = False
                                                                                 , audience = statusAudience
                                                                                 , highlight = rowHighlight
                                                                                 , outboxId = Nothing
                                                                                 , pending = False
                                                                                 , plaintext = Nothing
                                                                                 , at = rowTime model message
                                                                                 , msgid = msgidOf message
                                                                                 , reactions = []
                                                                                 , edited = False
                                                                                 , deleted = False
                                                                                 , redacted = False
                                                                                 , topic = Maybe.withDefault "" (parseMessageTopic message.tags)
                                                                                 , msgType =
                                                                                    if isNotice then
                                                                                        "notice"

                                                                                    else
                                                                                        "msg"
                                                                                 , replyTo = inboundReply
                                                                                 }
                                                                                    :: c.messages
                                                                                )
                                                                    }
                                                                )
                                                                |> (\m -> { m | messageSeq = m.messageSeq + 1, ownedRowIds = if ownsInboundRow model message sender then markOwnedRow model.messageSeq m.ownedRowIds else m.ownedRowIds })

                                                        -- A pinned forum re-opens on topic arrival
                                                        -- (mirroring the forum effect: a pinned
                                                        -- room with labeled rows forces the forum
                                                        -- open, on delivery as on navigation).
                                                        forumOpened =
                                                            case Dict.get (String.toLower bucket) next.channels of
                                                                Just ch ->
                                                                    if isChannelName model bucket && forumPinnedFor next bucket && List.any (\row -> not (String.isEmpty row.topic)) ch.messages && Maybe.map String.toLower next.activeChannel == Just (String.toLower bucket) then
                                                                        { next | forumView = Dict.insert (String.toLower bucket) True next.forumView }

                                                                    else
                                                                        next

                                                                Nothing ->
                                                                    next

                                                        counted =
                                                            if fate == DeliverNormal then
                                                                trackUnread forumOpened bucket model.messageSeq sender resolvedBody rowHighlight (parseMessageTopic message.tags)

                                                            else
                                                                forumOpened

                                                        -- A row delivered into the selected named
                                                        -- conversation is already visible: only its
                                                        -- device cursor advances, then the parent
                                                        -- room re-projects (mirroring the delivery
                                                        -- arm; history merges never mark here).
                                                        ( topicMarked, topicOuts ) =
                                                            if fate == DeliverNormal && not model.historyMerging && isChannelName model bucket then
                                                                markDeliveredTopicRead counted bucket sender resolvedBody rowHighlight (parseMessageTopic message.tags) (msgidOf message) (rowTime model message)

                                                            else
                                                                ( counted, [] )
                                                    in
                                                    let
                                                        ( marked, roomOuts ) =
                                                            foldRoomEnvelope topicMarked bucket effectiveBody model.messageSeq

                                                        rowTopic =
                                                            parseMessageTopic message.tags

                                                        ( alerted, alertOuts ) =
                                                            if fate == DeliverNormal && not model.historyMerging then
                                                                alertForDelivery marked bucket sender effectiveBody rowHighlight rowTopic

                                                            else
                                                                ( marked, [] )

                                                        recorded =
                                                            if model.historyMerging then
                                                                alerted

                                                            else if isChannelName model bucket then
                                                                if fate == DeliverNormal then
                                                                    recordMentionNotification
                                                                        (recordFollowNotification alerted bucket sender effectiveBody rowTopic)
                                                                        bucket
                                                                        sender
                                                                        resolvedBody
                                                                        rowHighlight

                                                                else
                                                                    alerted

                                                            else if fate == DeliverNormal || fate == DeliverPlaceholder then
                                                                recordDmNotification alerted sender resolvedBody

                                                            else
                                                                alerted
                                                    in
                                                    let
                                                        ( previewed, previewOuts ) =
                                                            requestPreviewForBody recorded effectiveBody
                                                    in
                                                    ( previewed
                                                    , openForEnvelope marked bucket effectiveBody model.messageSeq message ++ topicOuts ++ roomOuts ++ alertOuts ++ previewOuts
                                                    )

                _ ->
                    ( model, [] )


{-| An inbound envelope stays ciphertext in the store (the vault
persists the raw wire body untouched) and renders as the locked placeholder until
a port open fills `plaintext`. Kick one open per envelope when the
peer's primary key is already known; late keys retry via the
directory-update rescan, mirroring the oracle's WHOIS-late path.
Channel traffic never carries envelopes, so channel targets emit
nothing.
-}
openForEnvelope : Model -> String -> String -> Int -> Wire.IrcMessage -> List Outbound
openForEnvelope model target body messageId message =
    if not (DmCipher.isEnvelope body) then
        []

    else if isChannelName model target then
        []

    else
        let
            sender =
                Maybe.withDefault "" message.nick

            peerKey =
                if String.toLower target == String.toLower model.ourNick then
                    String.toLower sender

                else
                    String.toLower target
        in
        if String.isEmpty sender then
            []

        else
            case Dict.get peerKey model.dmDirectory.primary of
                Nothing ->
                    []

                Just presented ->
                    [ DmOpenRequested { peer = peerKey, presentedKey = presented, messageId = messageId, envelope = body, owner = deviceMemoryOwner model, runtimeOwnerRef = Maybe.map .ownerRef model.runtimeOwnerStamp, accountGeneration = Maybe.map .accountGeneration model.runtimeOwnerStamp, connectionGeneration = Maybe.map .connectionGeneration model.runtimeOwnerStamp } ]


{-| Open requests for every still-locked envelope stored for one peer
— the directory-update retry for keys that arrived after the message
(WHOIS-late), mirroring the oracle's `_decryptDm` rescan. Inbound DMs
fold under our own nick bucket while our echoes fold under the peer,
so both buckets are scanned; ids are globally unique.
-}
pendingOpensFor : Model -> String -> List Outbound
pendingOpensFor model nickKey =
    case Dict.get nickKey model.dmDirectory.primary of
        Nothing ->
            []

        Just presented ->
            let
                buckets =
                    List.filterMap (\key -> Dict.get key model.channels)
                        [ String.toLower model.ourNick, nickKey ]
            in
            List.concatMap
                (\channel ->
                    List.filterMap
                        (\m ->
                            if m.plaintext == Nothing && DmCipher.isEnvelope m.body then
                                Just (DmOpenRequested { peer = nickKey, presentedKey = presented, messageId = m.id, envelope = m.body, owner = deviceMemoryOwner model, runtimeOwnerRef = Maybe.map .ownerRef model.runtimeOwnerStamp, accountGeneration = Maybe.map .accountGeneration model.runtimeOwnerStamp, connectionGeneration = Maybe.map .connectionGeneration model.runtimeOwnerStamp })

                            else
                                Nothing
                        )
                        channel.messages
                )
                buckets


{-| Fold a live TOPIC change (mirroring the oracle TOPIC arm: the
room topic updates when the room is live — never conjuring one —
and a nick-attributed change lands a topic audit entry; the 332/331
initial-topic path in `foldTopic` stays audit-free like the
oracle). -}
foldLiveTopic : Model -> Wire.IrcMessage -> Model
foldLiveTopic model message =
    case message.params of
        chan :: rest ->
            let
                topic =
                    Maybe.withDefault "" (List.head rest)

                updated =
                    case Dict.get (String.toLower chan) model.channels of
                        Nothing ->
                            model

                        Just _ ->
                            updateChannel model chan (\c -> { c | topic = topic })

                recorded =
                    if String.isEmpty topic then
                        updated

                    else
                        recordTopicHistory updated chan topic
            in
            case message.nick of
                Nothing ->
                    recorded

                Just nick ->
                    addAuditEntry recorded AuditTopic nick Nothing (Just chan) (Just topic)

        _ ->
            model


{-| Per-room topic history bounds (mirroring `topicHistory.ts`:
128 rooms, 10 topics each, 128-char channel keys, 2 KiB bodies).
-}
maxTopicHistoryChannels : Int
maxTopicHistoryChannels =
    128


maxTopicsPerChannel : Int
maxTopicsPerChannel =
    10


maxTopicHistoryChannelLength : Int
maxTopicHistoryChannelLength =
    128


maxTopicHistoryTextLength : Int
maxTopicHistoryTextLength =
    2048


{-| Normalize a topic-history room key: trimmed, lowercased
`#`/`&` room without whitespace, commas, or controls.
-}
normalizeTopicHistoryChannel : String -> Maybe String
normalizeTopicHistoryChannel value =
    let
        channel =
            String.toLower (String.trim value)
    in
    if String.isEmpty channel || String.length channel > maxTopicHistoryChannelLength then
        Nothing

    else
        case String.uncons channel of
            Just ( first, _ ) ->
                if first /= '#' && first /= '&' then
                    Nothing

                else if String.any isTopicHistoryChannelBad channel then
                    Nothing

                else
                    Just channel

            Nothing ->
                Nothing


isTopicHistoryChannelBad : Char -> Bool
isTopicHistoryChannelBad c =
    let
        code =
            Char.toCode c
    in
    c == ',' || code <= 0x20 || code == 0x7F


{-| Normalize a topic-history body: trimmed, non-empty, no NUL/CR/LF/DEL,
capped at 2 KiB. Tabs survive, exactly like the oracle.
-}
normalizeTopicHistoryText : String -> Maybe String
normalizeTopicHistoryText value =
    let
        topic =
            String.trim value
    in
    if String.isEmpty topic then
        Nothing

    else if String.any isTopicHistoryTextBad topic then
        Nothing

    else
        Just (String.slice 0 maxTopicHistoryTextLength topic)


isTopicHistoryTextBad : Char -> Bool
isTopicHistoryTextBad c =
    let
        code =
            Char.toCode c
    in
    code == 0x00 || code == 0x0D || code == 0x0A || code == 0x7F


{-| Record a room topic: newest-first, de-duplicated, capped per room;
a new room is dropped once 128 rooms hold history (mirroring
`recordTopicHistory`). Needs no membership — the oracle records for
any normalized room, joined or not.
-}
recordTopicHistory : Model -> String -> String -> Model
recordTopicHistory model channel topic =
    case ( normalizeTopicHistoryChannel channel, normalizeTopicHistoryText topic ) of
        ( Just key, Just entry ) ->
            let
                existing =
                    Maybe.withDefault [] (Dict.get key model.topicHistory)
            in
            if List.isEmpty existing && Dict.size model.topicHistory >= maxTopicHistoryChannels then
                model

            else
                { model
                    | topicHistory =
                        Dict.insert key
                            (List.take maxTopicsPerChannel (entry :: List.filter (\t -> t /= entry) existing))
                            model.topicHistory
                }

        _ ->
            model


{-| Cap on stored rows scanned on a history load (mirroring
`MAX_TOPIC_HISTORY_PARSE_CHANNELS`). -}
maxTopicHistoryParseChannels : Int
maxTopicHistoryParseChannels =
    4096


{-| Load owner-scoped topic history from an untrusted stored value
(mirroring `parseTopicHistory`: non-objects read empty; at most 4096
rooms scanned; keys and bodies re-normalized; per-room dedupe with 10
kept; rooms past 128 dropped. Scan order follows Elm's key order
rather than the oracle's insertion order, and past 128 rooms later
duplicate keys still overwrite where the oracle stops scanning —
both recorded, not hidden). -}
parseTopicHistoryValue : Decode.Value -> Dict String (List String)
parseTopicHistoryValue value =
    case Decode.decodeValue (Decode.dict (Decode.list Decode.string)) value of
        Err _ ->
            Dict.empty

        Ok rows ->
            List.take maxTopicHistoryParseChannels (Dict.toList rows)
                |> List.foldl
                    (\( rawChannel, rawTopics ) acc ->
                        case normalizeTopicHistoryChannel rawChannel of
                            Nothing ->
                                acc

                            Just key ->
                                if not (Dict.member key acc) && Dict.size acc >= maxTopicHistoryChannels then
                                    acc

                                else
                                    let
                                        topics =
                                            List.foldl
                                                (\rawTopic kept ->
                                                    case normalizeTopicHistoryText rawTopic of
                                                        Nothing ->
                                                            kept

                                                        Just entry ->
                                                            if List.member entry kept || List.length kept >= maxTopicsPerChannel then
                                                                kept

                                                            else
                                                                kept ++ [ entry ]
                                                )
                                                []
                                                rawTopics
                                    in
                                    if List.isEmpty topics then
                                        acc

                                    else
                                        Dict.insert key topics acc
                    )
                    Dict.empty


{-| Encode history for the owner-scoped slot (mirroring the
`saveTopicHistory` payload: the ports bridge re-parses on read, so
encoding is verbatim). -}
encodeTopicHistory : Dict String (List String) -> Encode.Value
encodeTopicHistory history =
    Encode.dict identity (Encode.list Encode.string) history


{-| Persist history after a record (mirroring `addTopicHistory`'s
`saveTopicHistory`: a changed history persists under the current
owner; ownerless models never touch storage). -}
persistTopicHistory : Model -> Model -> List Outbound
persistTopicHistory before after =
    if after.topicHistory == before.topicHistory then
        []

    else
        case deviceMemoryOwner after of
            Nothing ->
                []

            Just owner ->
                [ TopicHistorySave
                    { serverUrl = owner.serverUrl
                    , identity = owner.identity
                    , history = encodeTopicHistory after.topicHistory
                    }
                ]


foldTopic : Model -> Wire.IrcMessage -> Model
foldTopic model message =
    case message.params of
        _ :: chan :: topic :: _ ->
            case Dict.get (String.toLower chan) model.channels of
                Nothing ->
                    -- A 332 is a topic reply, not a JOIN: it seeds
                    -- history but never membership.
                    recordTopicHistory model chan topic

                Just _ ->
                    recordTopicHistory
                        (updateChannel model chan (\c -> { c | topic = topic }))
                        chan
                        topic

        _ :: _ :: [] ->
            case message.params of
                _ :: chan :: _ ->
                    case Dict.get (String.toLower chan) model.channels of
                        Nothing ->
                            model

                        Just _ ->
                            updateChannel model chan (\c -> { c | topic = "" })

                _ ->
                    model

        _ ->
            model


ensureChannel : Model -> String -> Channel
ensureChannel model name =
    Maybe.withDefault
        { name = name, topic = "", members = Dict.empty, modes = "", messages = [], lastSeen = Nothing, unread = 0, highlights = 0, createdAt = Nothing }
        (Dict.get (ircCaseKey model name) model.channels)


updateChannel : Model -> String -> (Channel -> Channel) -> Model
updateChannel model name fn =
    let
        key =
            ircCaseKey model name
    in
    { model | channels = Dict.insert key (fn (ensureChannel model name)) model.channels }


isChannelName : Model -> String -> Bool
isChannelName model target =
    case String.uncons target of
        Just ( first, _ ) ->
            String.contains (String.fromChar first) model.isupport.chantypes

        Nothing ->
            False


{-| Re-open a pinned forum that has topics (mirroring the
pinned-forum effect: a pinned room with at least one labeled row
opens its forum on navigation; a first topic arriving live does
not re-trigger it — that stays a narrowing).
-}
openPinnedForum : Model -> String -> Model
openPinnedForum model channel =
    if not (forumPinnedFor model channel) then
        model

    else
        case Dict.get (String.toLower channel) model.channels of
            Nothing ->
                model

            Just ch ->
                if List.any (\row -> not (String.isEmpty row.topic)) ch.messages then
                    { model | forumView = Dict.insert (String.toLower channel) True model.forumView }

                else
                    model


{-| Buffer-scoped row id for the topic-read projector: the server msgid
when the row carries one, otherwise a `row:<buffer id>` synthetic id.
Synthetic ids never exact-match a stored marker across sessions (buffer
ids restart), so those rows fall to the timestamp arm — the oracle
missing-marker behavior — while unmarked topics count off the room
boundary either way. Markers are only ever written from real msgids. -}
topicReadRowId : ChatMessage -> String
topicReadRowId row =
    Maybe.withDefault ("row:" ++ String.fromInt row.id) row.msgid


{-| Per-unfurl-instance consent key (mirroring the oracle per-component
`externalAllowed` signal: each rendered unfurl owns its consent, so the
same URL in two rows stays independent where a bare URL key would leak
consent across instances). -}
previewConsentKey : ChatMessage -> String -> String
previewConsentKey row url =
    topicReadRowId row ++ "\n" ++ url


{-| Eligibility for the topic-read projection (mirroring
`isEligibleChannelUnread`: the oracle's msg/action/notice/whisper gate
reduces to msg/notice here — Elm folds actions into msg rows and has no
whisper rows — own rows never count, `none` suppresses the room, and a
mentions-only room admits only highlight-worthy rows). -}
topicReadExcluded : Model -> String -> ChatMessage -> Bool
topicReadExcluded model target row =
    if row.msgType /= "msg" && row.msgType /= "notice" then
        True

    else if String.toLower row.from == String.toLower model.ourNick then
        True

    else
        case notifyLevel model target of
            "none" ->
                True

            "mentions" ->
                not (row.highlight || isHighlightWorthy model row.body)

            _ ->
                False


{-| One buffer row projected onto the ledger row shape (the exclusion and
highlight classifications ride the flags, mirroring the caller predicates
the oracle threads through `projectRoomTopicUnread`). -}
topicReadRow : Model -> String -> ChatMessage -> TopicRead.TopicReadMessage
topicReadRow model target row =
    { id = topicReadRowId row
    , topic = topicOrNothing row.topic
    , at = row.at
    , system = topicReadExcluded model target row
    , highlight = row.highlight || isHighlightWorthy model row.body
    }


{-| Oldest-first index of the first row newer than an ISO read-marker
stamp (mirroring the `readMarkers` arm of `roomUnreadBoundaryIndex`;
unparseable stamps behave as no marker). -}
topicReadMarkerIndex : String -> List ChatMessage -> Int
topicReadMarkerIndex iso newestFirst =
    case SavedSearches.parseIsoMillis iso of
        Nothing ->
            List.length newestFirst

        Just markerMs ->
            let
                step row ( index, found ) =
                    case found of
                        Just _ ->
                            ( index + 1, found )

                        Nothing ->
                            if toFloat row.at > markerMs then
                                ( index + 1, Just index )

                            else
                                ( index + 1, Nothing )
            in
            Maybe.withDefault (List.length newestFirst) (Tuple.second (List.foldl step ( 0, Nothing ) (List.reverse newestFirst)))


{-| Universal room boundary for markerless topics (mirroring
`roomUnreadBoundaryIndex` without the override arm: the first-unread
cursor wins, then the stored MARKREAD stamp, else the end of the list). -}
topicReadBoundaryIndex : Model -> String -> Int
topicReadBoundaryIndex model channel =
    let
        key =
            String.toLower channel
    in
    case Dict.get key model.channels of
        Nothing ->
            0

        Just ch ->
            case Dict.get key model.firstUnreadId of
                Just firstId ->
                    Maybe.withDefault (List.length ch.messages) (threadRowIndex ch.messages firstId)

                Nothing ->
                    case Dict.get key model.readMarkers of
                        Just iso ->
                            topicReadMarkerIndex iso ch.messages

                        Nothing ->
                            List.length ch.messages


{-| Re-project one room's unread state through the device-local topic
cursors (mirroring `_reconcileChannelTopicUnread`: the whole open room
uses the end of the buffer as its boundary, otherwise the room boundary
is a universal lower bound; counts, highlights, and the first-unread
cursor re-derive from the projection — Elm keeps no separate
channelUnread/channelMentions maps or mention totals, those derive at
render). -}
reconcileChannelTopicUnread : Model -> String -> Model
reconcileChannelTopicUnread model channel =
    case Dict.get (String.toLower channel) model.channels of
        Nothing ->
            model

        Just ch ->
            let
                key =
                    String.toLower channel

                wholeRoom =
                    Maybe.map String.toLower model.activeChannel == Just key && Dict.get key model.activeChannelTopics == Nothing

                fallback =
                    if wholeRoom then
                        List.length ch.messages

                    else
                        topicReadBoundaryIndex model key

                rows =
                    List.map (topicReadRow model key) (List.reverse ch.messages)

                projection =
                    TopicRead.projectRoomTopicUnread channel rows model.topicReadLedger fallback

                cursor =
                    case projection.earliestUnreadMessageId of
                        Nothing ->
                            Dict.remove key model.firstUnreadId

                        Just earliest ->
                            case List.filter (\row -> topicReadRowId row == earliest) ch.messages of
                                found :: _ ->
                                    Dict.insert key found.id model.firstUnreadId

                                [] ->
                                    Dict.remove key model.firstUnreadId
            in
            updateChannel model channel (\c -> { c | unread = projection.totalUnread, highlights = projection.highlightCount })
                |> (\m -> { m | firstUnreadId = cursor })


{-| Persist one topic mark when the device owner is known (mirroring the
`markTopicRead` write: unchanged ledgers emit nothing). -}
persistTopicReadMark : Model -> String -> String -> String -> Int -> ( Model, List Outbound )
persistTopicReadMark model channel topic msgid atMs =
    case deviceMemoryOwner model of
        Nothing ->
            ( model, [] )

        Just owner ->
            let
                next =
                    TopicRead.markTopicRead channel topic msgid atMs model.topicReadLedger
            in
            if next == model.topicReadLedger then
                ( model, [] )

            else
                ( { model | topicReadLedger = next }
                , [ TopicReadSave
                        { serverUrl = owner.serverUrl
                        , identity = owner.identity
                        , markers = TopicRead.encodeTopicReadMarkers next
                        }
                  ]
                )


{-| Advance one topic to its newest countable row carrying a real msgid
(mirroring `markLatestTopicRead`: buffers run newest-first, so the head
of the filtered rows is the latest; rows without a msgid can never
anchor an exact boundary, so they never move the cursor). -}
markLatestChannelTopicRead : Model -> String -> String -> ( Model, List Outbound )
markLatestChannelTopicRead model channel topic =
    case Dict.get (String.toLower channel) model.channels of
        Nothing ->
            ( model, [] )

        Just ch ->
            let
                wanted =
                    String.toLower (String.trim topic)

                latest =
                    List.filter
                        (\row ->
                            not (topicReadExcluded model (String.toLower channel) row)
                                && String.toLower row.topic == wanted
                        )
                        ch.messages
                        |> List.filterMap
                            (\row ->
                                case row.msgid of
                                    Just msgid ->
                                        Just ( msgid, row.at )

                                    Nothing ->
                                        Nothing
                            )
                        |> List.head
            in
            case latest of
                Nothing ->
                    ( model, [] )

                Just ( msgid, atMs ) ->
                    persistTopicReadMark model channel topic msgid atMs


{-| Advance every named topic to its latest countable row (mirroring the
`navigate` whole-room arm: `markAllTopicsRead` over the loaded buffer
with the ledger exclusion, so a later topic filter cannot resurrect
rows already consumed in the All view). -}
markAllChannelTopicsRead : Model -> String -> ( Model, List Outbound )
markAllChannelTopicsRead model channel =
    case ( Dict.get (String.toLower channel) model.channels, deviceMemoryOwner model ) of
        ( Just ch, Just owner ) ->
            let
                rows =
                    List.map (topicReadRow model (String.toLower channel)) (List.reverse ch.messages)

                next =
                    TopicRead.markAllTopicsRead channel rows model.topicReadLedger
            in
            if next == model.topicReadLedger then
                ( model, [] )

            else
                ( { model | topicReadLedger = next }
                , [ TopicReadSave
                        { serverUrl = owner.serverUrl
                        , identity = owner.identity
                        , markers = TopicRead.encodeTopicReadMarkers next
                        }
                  ]
                )

        _ ->
            ( model, [] )


{-| Advance the selected named conversation for one delivered row
(mirroring the delivery arm: the row is already visible, so only its
device cursor advances, then the parent room re-projects so hidden
sibling and untagged rows keep their state; rows without a msgid
re-project without moving the cursor). -}
markDeliveredTopicRead : Model -> String -> String -> String -> Bool -> Maybe String -> Maybe String -> Int -> ( Model, List Outbound )
markDeliveredTopicRead model bucket sender resolvedBody rowHighlight rowTopic msgid atMs =
    case ( Dict.get (String.toLower bucket) model.activeChannelTopics, rowTopic ) of
        ( Just selected, Just label ) ->
            if String.toLower (String.trim label) /= String.toLower (String.trim selected) then
                ( model, [] )

            else if String.toLower sender == String.toLower model.ourNick then
                ( model, [] )

            else
                case notifyLevel model bucket of
                    "none" ->
                        ( reconcileChannelTopicUnread model bucket, [] )

                    "mentions" ->
                        if rowHighlight || isHighlightWorthy model resolvedBody then
                            markDeliveredMark model bucket selected msgid atMs

                        else
                            ( reconcileChannelTopicUnread model bucket, [] )

                    _ ->
                        markDeliveredMark model bucket selected msgid atMs

        _ ->
            ( model, [] )


markDeliveredMark : Model -> String -> String -> Maybe String -> Int -> ( Model, List Outbound )
markDeliveredMark model bucket selected msgid atMs =
    case msgid of
        Just id ->
            let
                ( marked, outs ) =
                    persistTopicReadMark model bucket selected id atMs
            in
            ( reconcileChannelTopicUnread marked bucket, outs )

        Nothing ->
            ( reconcileChannelTopicUnread model bucket, [] )


{-| Open a conversation by name (the `ChannelSelect` body, shared with
the deep-link join echo — see `firePendingDeepLinkJoin`). -}
selectChannel : Model -> String -> ( Model, List Outbound )
selectChannel model name =
    let
        fetch =
            case Dict.get (String.toLower name) model.channels of
                Just channel ->
                    if List.isEmpty channel.messages then
                        [ vaultFetchOutbound model (String.toLower name) keepMessages ]

                    else
                        []

                Nothing ->
                    []

        -- Opening a DM fetches the peer's device key when none
        -- is known, so DMs to them can seal. Cheap; the 761
        -- reply lands in the directory. Pref-gated like the
        -- oracle (`preferences().e2eeDms`).
        keyFetch =
            if not model.e2eeDms then
                []

            else if isChannelName model name || Dict.member (String.toLower name) model.dmDirectory.primary then
                []

            else
                [ SendLine (Wire.formatIrcLine "METADATA" [ name, "GET", "ocean.dm-key" ]) ]

        -- Opening a conversation marks it read (mirroring
        -- `markRead`): counters clear, the local marker and
        -- last-read stamp land, and MARKREAD syncs when
        -- negotiated. An unknown name selects without
        -- conjuring a room.
        ( read, markOut ) =
            recordLocalReadMarker model name

        -- A plain channel navigation persists every consumed
        -- named-conversation boundary first (mirroring the
        -- `navigate` whole-room arm); DMs carry no topics.
        ( navigated, navOut ) =
            if isChannelName model name then
                markAllChannelTopicsRead read name

            else
                ( read, [] )
    in
    -- A new conversation restarts match navigation at the
    -- first hit and re-opens the live trailing window
    -- (mirroring the conversation-switch reset: fresh opens
    -- may use the unread anchor again). Opening a room we
    -- moderate while live also loads its block list, mirroring
    -- the ban panel's connected-and-op fetch effect.
    let
        ( opened, banOut ) =
            if navigated.connection == Live && isChannelOp navigated name then
                requestBanList navigated name

            else
                ( navigated, [] )

        -- Opening a DM tracks the peer's presence via MONITOR
        -- (mirroring the oracle's `monitorAdd` on DM open; channels
        -- never subscribe). Already-tracked peers no-op; offline opens
        -- track for the next sync.
        ( watched, watchOut ) =
            if isChannelName model name then
                ( opened, [] )

            else
                monitorAddContact opened name
    in
    -- The tail also swaps the per-target composer draft (the swap
    -- sets the channel, so the record update lives inside it).
    let
        openedChannel =
            resetThreadWindow (clearOfflineMemo (swapComposerDraft watched name) name)

        ( focused, focusOut ) =
            noteFirstHourFocus openedChannel

        ( draftModel, draftOut ) =
            makeDraftLoadOutbound focused name False

        ( anchorModel, anchorOut ) =
            makeAnchorLoadOutbound draftModel name
    in
    ( anchorModel
    , fetch ++ keyFetch ++ markOut ++ navOut ++ banOut ++ watchOut ++ focusOut ++ Maybe.withDefault [] (Maybe.map List.singleton draftOut) ++ Maybe.withDefault [] (Maybe.map List.singleton anchorOut)
    )


makeDraftLoadOutbound : Model -> String -> Bool -> ( Model, Maybe Outbound )
makeDraftLoadOutbound model conversationId force =
    case ( retainedDraftLocked model, model.runtimeOwnerStamp ) of
        ( True, _ ) ->
            ( model, Nothing )

        ( False, Nothing ) ->
            ( model, Nothing )

        ( False, Just stamp ) ->
            let
                key = ircCaseKey model conversationId
                version = Maybe.withDefault 0 (Dict.get key model.composerDraftVersions)
                hasCurrentDraft = Dict.member key model.composerDrafts
            in
            if (not force && Set.member key model.hydratedDraftTargets) || hasCurrentDraft || activeEditFor model conversationId /= Nothing then
                ( model, Nothing )
            else
                let
                    nextClock = model.eventClock + 1
                in
                case (( Ids.requestIdFromRuntime ("draftLoad" ++ String.padLeft 13 '0' (String.fromInt nextClock)), Ids.ownerRefFromRuntime stamp.ownerRef ), ( Ids.accountGenerationFromInt stamp.accountGeneration, Ids.connectionGenerationFromInt stamp.connectionGeneration )) of
                    ( ( Just requestId, Just ownerRef ), ( Just accountGeneration, Just connectionGeneration ) ) ->
                        ( { model | eventClock = nextClock, draftLoadPending = Just { requestId = requestId, target = conversationId, version = version } }
                        , Just
                            (RuntimeDomainCommand
                                { requestId = requestId
                                , ownerRef = ownerRef
                                , accountGeneration = accountGeneration
                                , connectionGeneration = connectionGeneration
                                , action = RuntimeDomain.LoadDraft conversationId
                                }
                            )
                        )

                    _ ->
                        ( model, Nothing )


makeAnchorLoadOutbound : Model -> String -> ( Model, Maybe Outbound )
makeAnchorLoadOutbound model conversationId =
    case model.runtimeOwnerStamp of
        Nothing ->
            ( model, Nothing )

        Just stamp ->
            let
                nextClock = model.eventClock + 1
            in
            case (( Ids.requestIdFromRuntime ("anchorLoad" ++ String.padLeft 12 '0' (String.fromInt nextClock)), Ids.ownerRefFromRuntime stamp.ownerRef ), ( Ids.accountGenerationFromInt stamp.accountGeneration, Ids.connectionGenerationFromInt stamp.connectionGeneration )) of
                ( ( Just requestId, Just ownerRef ), ( Just accountGeneration, Just connectionGeneration ) ) ->
                    ( { model | eventClock = nextClock, anchorLoadPending = Just { requestId = requestId, conversationId = conversationId } }
                    , Just
                        (RuntimeDomainCommand
                            { requestId = requestId
                            , ownerRef = ownerRef
                            , accountGeneration = accountGeneration
                            , connectionGeneration = connectionGeneration
                            , action = RuntimeDomain.AnchorLoad conversationId
                            }
                        )
                    )

                _ ->
                    ( model, Nothing )


{-| Drop the pending deep-link triple outright. -}
clearPendingDeepLink : Model -> Model
clearPendingDeepLink model =
    { model | pendingDeepLinkJoin = Nothing, pendingDeepLinkAt = Nothing, pendingDeepLinkTopic = Nothing }


{-| Fire the pending `?join=` link on registration (mirroring the
oracle 001 arm's JOIN). The triple rides until the self-JOIN echo
opens the room — the oracle clears a topic-less triple at send
time, but its self-JOIN echo activates the room anyway, so Elm
keeps the triple to drive the same open and clears it there. The
end state matches: joined, opened, nothing pending. `?at=` time
travel stays pending for the travel slice.
-}
firePendingDeepLinkJoin : Model -> ( Model, List Outbound )
firePendingDeepLinkJoin model =
    case model.pendingDeepLinkJoin of
        Nothing ->
            ( model, [] )

        Just channel ->
            ( model
            , [ SendLine (Wire.formatIrcLine "JOIN" [ channel ]) ]
            )


{-| In-flight server time-travel (`?at=` deep link): the AROUND
answer merges through the ordinary plain-batch close, which clears
this when its target lands. -}
type alias PendingTravel =
    { target : String
    , at : Float
    }


{-| Travel to a moment in a room's history (mirroring `travelTo`):
the vault paints first via `VaultFetchAround` (its merge sets the
landing), then a server `CHATHISTORY AROUND` refines it when the
cap is negotiated. A server-search-owned target never travels.
-}
requestTravelTo : Model -> String -> Float -> ( Model, List Outbound )
requestTravelTo model target at =
    if serverSearchOwnsTarget model target then
        ( model, [] )

    else
        let
            vaultOut =
                [ vaultFetchAroundOutbound model (String.toLower target) (round at) keepMessages ]

            serverOut =
                if hasChatHistoryCap model then
                    [ SendLine
                        (Wire.formatIrcLine "CHATHISTORY"
                            [ "AROUND"
                            , target
                            , "timestamp=" ++ millisToIso at
                            , String.fromInt historyPageSize
                            ]
                        )
                    ]

                else
                    []
        in
        ( { model | pendingTravel = Just { target = String.toLower target, at = at } }
        , vaultOut ++ serverOut
        )


{-| Protected-DM refusal copy (mirrors `DM_ATTACHMENT_BLOCKED` in
`dmPrivacyChrome.ts`: encrypted uploads do not exist yet, so
attachments refuse with the draft kept). -}
dmAttachmentBlocked : String
dmAttachmentBlocked =
    "Attachments are disabled in protected DMs until encrypted uploads are available. Your message draft stays here."


{-| Offline-attachment refusal copy (mirrors the oracle composer
guard: edits and uploads need the network now). -}
offlineAttachmentBlocked : String
offlineAttachmentBlocked =
    "Attachments need a connection — remove them to queue the text."


{-| Pick files into the staging area (mirrors the oracle
`uploadPick` request; bytes stay ports-side under the key). -}
pickAttachments : Model -> ( Model, List Outbound )
pickAttachments model =
    let
        key =
            "att-" ++ String.fromInt model.attachmentSeq
    in
    ( { model | attachmentSeq = model.attachmentSeq + 1 }
    , [ UploadPick { key = key, accept = "", multiple = True } ]
    )


{-| Stage picked files under the cap plan (mirrors `addFiles` +
`planAttachmentAccept`; per-file photo sniffing stays a later
slice — originals stage as-is). -}
stagePicked : Model -> String -> List { name : String, size : Float, mime : String } -> Model
stagePicked model key files =
    let
        decision =
            Upload.planAttachmentAccept
                (List.map (\f -> { name = f.name, size = f.size }) files)
                (List.length model.attachments)

        staged =
            List.filterMap
                (\( index, file ) ->
                    if List.member index decision.acceptIndexes then
                        Just
                            { id = model.attachmentSeq + index
                            , key = key
                            , position = index
                            , name = Maybe.withDefault "file" (Upload.sanitizeFileName (Just file.name))
                            , size = file.size
                            , mime = file.mime
                            , status = StagedReady
                            , progress = Nothing
                            }

                    else
                        Nothing
                )
                (List.indexedMap Tuple.pair files)
    in
    { model
        | attachments = model.attachments ++ staged
        , attachmentSeq = model.attachmentSeq + List.length files
        , composerError = decision.error
    }


{-| Send path with staged attachments (mirrors the oracle composer
send: offline and protected-DM refuse with the draft kept;
otherwise every ready item uploads, and the receipts send as one
captioned message once all complete). -}
sendWithAttachments : Model -> String -> ( Model, List Outbound )
sendWithAttachments model target =
    if isBlockedDmTarget model target then
        refuseBlockedDm model target

    else if Result.toMaybe (Wire.validateSemanticMessage model.composer) == Nothing then
        ( { model | composerError = Just "The attachment caption contains a character the client cannot send; your caption and attachments were kept." }, [] )

    else if model.connection /= Live then
        ( { model | composerError = Just offlineAttachmentBlocked }, [] )

    else if dmDesignated model target then
        ( { model | composerError = Just dmAttachmentBlocked }, [] )

    else
        case Upload.buildUploadEndpoint model.mediaUrl of
            Err err ->
                ( { model | composerError = Just err }, [] )

            Ok endpoint ->
                let
                    ready =
                        List.filter (\a -> a.status == StagedReady) model.attachments
                in
                if List.isEmpty ready && List.isEmpty model.attachments then
                    sendComposerText model target

                else if not (List.isEmpty model.attachments) && List.all (\item ->
                    case item.status of
                        StagedUploaded _ ->
                            True

                        _ ->
                            False
                ) model.attachments then
                    finishUploadedAttachments model target model.composer

                else
                    let
                        mark item =
                            case item.status of
                                StagedReady ->
                                    { item | status = StagedUploading, progress = Just 0 }

                                _ ->
                                    item

                        sends =
                            List.map
                                (\item -> UploadSend { key = item.key, endpoint = endpoint, fieldName = "file", index = item.position })
                                ready
                    in
                    ( { model
                        | attachments = List.map mark model.attachments
                        , attachmentEndpoint = endpoint
                        , pendingAttachmentSend = Just { target = target, caption = model.composer }
                        , composerError = Nothing
                      }
                    , sends
                    )


{-| Apply one progress event to the matching in-flight row (mirrors
the oracle composer `onProgress`: only `uploading` rows move, and
the percent is null while the total is unknown). -}
applyUploadProgress : List StagedAttachment -> { key : String, index : Int, loaded : Int, total : Maybe Int } -> List StagedAttachment
applyUploadProgress items prog =
    List.map
        (\item ->
            if item.key == prog.key && item.position == prog.index && item.status == StagedUploading then
                { item | progress = Upload.progressPercent prog.loaded prog.total }

            else
                item
        )
        items


{-| Live unfurl privacy from display preferences (mirrors
`liveUnfurlPrivacy`: https-only + host blocklist ride along). -}
liveUnfurlPrivacy : Model -> Upload.UnfurlPrefs
liveUnfurlPrivacy model =
    Upload.unfurlPrivacyFromLinkPreviews model.prefs.linkPreviews
        { httpsOnly = model.prefs.httpsOnly
        , blockedHosts = model.prefs.blockedHosts
        }


{-| Pick the preview URL for a message body and queue one fetch
(mirrors the oracle `previewUrl` memo + `fetchLinkPreview` cache:
preference-gated, media-kind hrefs left for media unfurls, one
in-flight fetch per URL). -}
requestPreviewForBody : Model -> String -> ( Model, List Outbound )
requestPreviewForBody model body =
    let
        privacy =
            liveUnfurlPrivacy model

        hrefs =
            List.filter
                (\href -> Upload.classifyAttachmentKind href Nothing == Upload.KindFile)
                (Upload.extractHttpUrls body)
    in
    if not privacy.linkPreviews then
        ( model, [] )

    else
        case Upload.pickPreviewUrl hrefs privacy of
            Nothing ->
                ( model, [] )

            Just url ->
                if Dict.member url model.linkPreviews || Set.member url model.linkPreviewInflight then
                    ( model, [] )

                else
                    ( { model | linkPreviewInflight = Set.insert url model.linkPreviewInflight }
                    , [ PreviewFetch { key = url, endpoint = "/linkpreview", url = url } ]
                    )


{-| Preview requests for a batch of sent texts (multiline sends fold
left so one in-flight fetch per URL covers repeats). -}
requestPreviewsForTexts : Model -> List String -> ( Model, List Outbound )
requestPreviewsForTexts model texts =
    List.foldl
        (\text ( current, outs ) ->
            let
                ( next, fx ) =
                    requestPreviewForBody current text
            in
            ( next, outs ++ fx )
        )
        ( model, [] )
        texts


{-| Settle one preview fetch (mirrors `fetchLinkPreview` settle:
fail-closed nulls never touch the cache slot... settled cards —
and stable empty answers — fill it with oldest-first eviction at
the cap; transient network failures only clear the in-flight mark
so a later message retries). -}
settlePreviewArrived : Model -> { key : String, ok : Bool, status : Int, body : String } -> Model
settlePreviewArrived model arrived =
    let
        unflown =
            { model | linkPreviewInflight = Set.remove arrived.key model.linkPreviewInflight }
    in
    if not arrived.ok then
        unflown

    else
        case Decode.decodeString Decode.value arrived.body of
            Err _ ->
                unflown

            Ok value ->
                let
                    card =
                        Upload.normalizePreview value arrived.key

                    pruned =
                        if Dict.member arrived.key unflown.linkPreviews then
                            unflown

                        else if Dict.size unflown.linkPreviews < Upload.linkPreviewCacheCap then
                            unflown

                        else
                            case unflown.linkPreviewOrder of
                                oldest :: rest ->
                                    { unflown
                                        | linkPreviews = Dict.remove oldest unflown.linkPreviews
                                        , linkPreviewOrder = rest
                                    }

                                [] ->
                                    unflown
                in
                { pruned
                    | linkPreviews = Dict.insert arrived.key card pruned.linkPreviews
                    , linkPreviewOrder =
                        if List.member arrived.key pruned.linkPreviewOrder then
                            pruned.linkPreviewOrder

                        else
                            pruned.linkPreviewOrder ++ [ arrived.key ]
                }


{-| Release preview keys and fetched metadata at an account/session
boundary (mirrors `clearLinkPreviewCache`). -}
clearLinkPreviews : Model -> Model
clearLinkPreviews model =
    { model
        | linkPreviews = Dict.empty
        , linkPreviewInflight = Set.empty
        , linkPreviewOrder = []
        , previewImagesAllowed = Set.empty
        , previewMediaFailed = Set.empty
        , mediaLightbox = Nothing
        , mediaIndexOpen = False
        , mediaIndexFilter = RoomMedia.Pictures
        , mediaIndexTarget = ""
        , mediaIndexVault = []
        , mediaIndexVaultState = MediaVaultLoading
        , mediaIndexOwner = ""
        , mediaPictureAllowed = Set.empty
    }


{-| Settle one finished upload (mirrors `uploadPendingAttachments`:
a failure aborts the send with the draft kept; completion builds
the captioned receipt message). -}
settleAttachmentUpload : Model -> { key : String, index : Int, ok : Bool, status : Int, body : String, contentType : Maybe String } -> ( Model, List Outbound )
settleAttachmentUpload model done =
    let
        settled =
            List.map
                (\item ->
                    if item.key == done.key && item.position == done.index then
                        if not done.ok then
                            { item | status = StagedFailed, progress = Nothing }

                        else
                            case Upload.parseUploadResponse model.attachmentEndpoint done.body (Maybe.withDefault "" done.contentType) of
                                Ok url ->
                                    { item | status = StagedUploaded url, progress = Just 100 }

                                Err _ ->
                                    { item | status = StagedFailed, progress = Nothing }

                    else
                        item
                )
                model.attachments

        failed =
            List.any (\item -> item.status == StagedFailed) settled
    in
    if failed then
        ( { model
            | attachments = settled
            , pendingAttachmentSend = Nothing
            , composerError = Just Upload.attachmentSendFailed
          }
        , []
        )

    else
        case model.pendingAttachmentSend of
            Nothing ->
                ( { model | attachments = settled }, [] )

            Just pending ->
                if List.all (\item -> item.status /= StagedReady && item.status /= StagedUploading) settled then
                    finishUploadedAttachments { model | attachments = settled } pending.target pending.caption

                else
                    ( { model | attachments = settled }, [] )


finishUploadedAttachments : Model -> String -> String -> ( Model, List Outbound )
finishUploadedAttachments model target caption =
    let
        receiptCandidates =
            List.filterMap
                (\item ->
                    case item.status of
                        StagedUploaded url ->
                            Just
                                (Upload.buildAttachmentMessage
                                    { url = url
                                    , name = Just item.name
                                    , mime = Just item.mime
                                    , sizeBytes = Just item.size
                                    , caption = Nothing
                                    }
                                )

                        _ ->
                            Nothing
                )
                model.attachments

        receipts =
            List.filterMap identity receiptCandidates

        receiptBuildFailed =
            List.any ((==) Nothing) receiptCandidates

        captionIsValid =
            Result.toMaybe (Wire.validateSemanticMessage caption) /= Nothing

        trimmedCaption =
            String.trim caption

        bodyParts =
            (if String.isEmpty trimmedCaption then
                []

             else
                [ trimmedCaption ]
            )
                ++ receipts

        body =
            String.join "\n" bodyParts

        legacySeparateMessages =
            model.runtimeOwnerStamp == Nothing
                && not (Session.hasCapability model.caps "draft/multiline")

        deniedAudience =
            model.composerAudience /= Nothing && composerSendTarget model target == Nothing

        refusal current =
            ( { current
                | composer = caption
                , pendingAttachmentSend = Nothing
                , composerError = Just "The attachment message could not be sent; your caption and attachments were kept."
              }
            , []
            )

        hasMessageIntent outbounds =
            List.any
                (\outbound ->
                    case outbound of
                        SendLine _ ->
                            True

                        RuntimeDomainCommand _ ->
                            True

                        _ ->
                            False
                )
                outbounds

        planParts parts =
            let
                planPart part accumulated =
                    Maybe.andThen
                        (\( current, outbounds ) ->
                            let
                                prepared =
                                    { current
                                        | composer = part
                                        , composerAudience = model.composerAudience
                                        , composerError = Nothing
                                    }

                                ( plannedModel, plannedOutbounds ) =
                                    sendComposerText prepared target

                                safeOutbounds =
                                    Result.toMaybe (validateComposerOutbounds plannedOutbounds) /= Nothing

                                admittedIntent =
                                    hasMessageIntent plannedOutbounds
                            in
                            if plannedModel.composerError /= Nothing || not safeOutbounds || not admittedIntent then
                                Nothing

                            else
                                Just ( plannedModel, outbounds ++ plannedOutbounds )
                        )
                        accumulated
            in
            List.foldl planPart (Just ( model, [] )) parts
    in
    if not captionIsValid || receiptBuildFailed then
        refusal model

    else if List.isEmpty bodyParts then
        ( { model | pendingAttachmentSend = Nothing, composerError = Just Upload.attachmentSendFailed }, [] )

    else if deniedAudience then
        ( { model | composerError = Just "Status audience unavailable here — message not sent." }, [] )

    else if legacySeparateMessages then
        case planParts bodyParts of
            Nothing ->
                refusal model

            Just ( plannedModel, plannedOutbounds ) ->
                ( { plannedModel
                    | attachments = []
                    , pendingAttachmentSend = Nothing
                    , composerAudience = Nothing
                    , composerError = Nothing
                  }
                , plannedOutbounds
                )

    else
        let
            ( plannedModel, plannedOutbounds ) =
                sendComposerText { model | composer = body, composerError = Nothing } target
        in
        if plannedModel.composerError /= Nothing || Result.toMaybe (validateComposerOutbounds plannedOutbounds) == Nothing || not (hasMessageIntent plannedOutbounds) then
            refusal model

        else
            ( { plannedModel | attachments = [], pendingAttachmentSend = Nothing }, plannedOutbounds )


composerSendUpdate : Model -> ( Model, List Outbound )
composerSendUpdate model =
    case ( retainedDraftLocked model, model.activeChannel ) of
        ( True, _ ) ->
            ( { model | composerError = Just "This retained draft is locked to its previous owner. Reauthorize it or clear it before sending." }, [] )

        ( False, Nothing ) ->
            ( model, [] )

        ( False, Just target ) ->
            case activeEditFor model target of
                Just edit ->
                    -- Edit mode: send becomes save (mirror the
                    -- oracle `handleSend` edit branch; edit
                    -- mode never carries staged attachments —
                    -- the send button is disabled there, and an
                    -- empty draft cannot save).
                    if String.isEmpty (String.trim model.composer) then
                        ( model, [] )

                    else
                        let
                            ( edited, out ) =
                                requestEdit model target edit.msgid model.composer
                        in
                        if List.isEmpty out then
                            -- Refused (cap, transport, or the row
                            -- changed under us): like the oracle
                            -- `editMessage` refused path, the arm
                            -- and the draft stay for retry and the
                            -- refusal copy coaches (Elm has no
                            -- admit-uncertain tier — every refusal
                            -- here is a pre-send gate).
                            ( { edited | composerError = Just "Edit was refused. Your replacement text is still here." }, [] )

                        else
                            if Dict.member (messageMutationKey target edit.msgid) edited.pendingMessageEdits then
                                ( edited, out )

                            else
                                ( { edited | editingMessage = Nothing, composer = "", composerDrafts = Dict.remove (ircCaseKey edited target) edited.composerDrafts }, out )

                Nothing ->
                    if not (List.isEmpty model.attachments) then
                        sendWithAttachments model target

                    else if String.isEmpty (String.trim model.composer) then
                        ( model, [] )

                    else
                        let
                            trimmed =
                                String.trim model.composer

                    -- Text-only conveniences (`/shrug` family)
                    -- expand to ordinary text first, mirroring the
                    -- oracle composer (`expandSlashTextCommand`
                    -- over the trimmed draft); anything else
                        -- passes through byte-identical.
                            outgoing =
                                if String.startsWith "/" trimmed then
                                    expandSlashTextCommand trimmed

                                else
                                    model.composer

                            sending =
                                { model | composer = outgoing }
                        in
                        if isBlockedDmTarget sending target then
                            -- A DM to a locally blocked nick refuses before
                            -- anything else (mirroring the oracle composer
                            -- gate): the draft stays for unblock-and-send.
                            refuseBlockedDm sending target

                        else if sending.composerAudience /= Nothing && composerSendTarget sending target == Nothing then
                            -- A set audience that can no longer be honored
                            -- (room left, prefix withdrawn) refuses instead of
                            -- widening an ops-only message to everyone.
                            ( logService sending "Status audience unavailable here — message not sent.", [] )

                        else if String.startsWith "/" outgoing && sending.connection /= Live then
                            -- Real commands never queue from the offline
                            -- outbox (mirroring the oracle composer
                            -- guard): the draft stays, the inline error
                            -- coaches, nothing emits.
                            ( { model | composerError = Just "Commands can't be queued. Reconnect to run this command." }, [] )

                        else
                            case parseSlashLocal outgoing of
                                Just ( verb, nickArg ) ->
                                    -- Local slash commands never hit the wire
                                    -- (online or offline, sealed or not —
                                    -- mirroring the oracle slash dispatch,
                                    -- which runs ahead of delivery). The
                                    -- stored draft drops with the dispatch
                                    -- (a kept visible draft re-seeds it on
                                    -- the next input or switch).
                                    Tuple.mapFirst (dropStoredDraftFor target) (runSlashLocal sending target verb nickArg)

                                Nothing ->
                                    if model.runtimeOwnerStamp /= Nothing && String.startsWith "/me " outgoing then
                                        queueRuntimeMessage sending target (String.dropLeft 4 outgoing) "action"

                                    else if String.startsWith "/" outgoing then
                                        -- Unhandled verbs go out as raw
                                        -- uppercase IRC (mirroring the
                                        -- oracle `sendRaw` fallthrough).
                                        sendRawSlashCommand sending target outgoing

                                    else
                                        sendComposerText sending target


runtimeVerifiedGroupHead : Model -> String -> Maybe ( Int, String )
runtimeVerifiedGroupHead model conversationId =
    model.runtimeDomainResult
        |> Maybe.andThen
            (\result ->
                if result.domain /= "group" then
                    Nothing

                else
                    result.items
                        |> List.filter (\item -> item.ref == conversationId && item.state == "author-ready")
                        |> List.head
                        |> Maybe.andThen
                            (\item ->
                                case item.extra of
                                    epochText :: hash :: _ ->
                                        case String.toInt epochText of
                                            Just epoch ->
                                                if epoch >= 0 && String.length hash == 64 && String.all isLowerHex hash then
                                                    Just ( epoch, hash )
                                                else
                                                    Nothing

                                            Nothing ->
                                                Nothing

                                    _ ->
                                        Nothing
                            )
            )


openNotificationConversation : Model -> String -> Maybe ( Model, List Outbound )
openNotificationConversation model conversationId =
    let
        key =
            ircCaseKey model conversationId
    in
    if Dict.member key model.channels then
        Just (selectChannel model conversationId)

    else
        Nothing


openNotificationDm : Model -> String -> Maybe ( Model, List Outbound )
openNotificationDm model conversationId =
    let
        key =
            ircCaseKey model conversationId
    in
    if Dict.member key model.channels then
        Just (selectChannel model conversationId)

    else if isChannelName model conversationId then
        -- A DM notification cannot synthesize an unjoined channel.
        Nothing

    else
        case normalizeContactNick conversationId of
            Nothing ->
                Nothing

            Just peer ->
                let
                    ( roomCapacity, canOpen ) =
                        ensureDmShellCapacity model peer
                in
                if canOpen then
                    -- Cold-tab DM notification navigation may create a
                    -- local conversation shell and hydrate it through the
                    -- ordinary selection path. This does not send JOIN,
                    -- answer a call, or establish any new network route.
                    Just (selectChannel (updateChannel roomCapacity peer identity) peer)

                else
                    Nothing


