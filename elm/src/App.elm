            case normalizeCustomStatus req.status of
                Nothing ->
                    ( model, [] )

                Just status ->
                    let
                        stored =
                            { model
                                | customStatus = status
                                , customStatusExpiry = normalizeCustomStatusExpiry req.expiryMs
                            }
                    in
                    ( syncOwnCustomStatusActivity stored Nothing, [] )

