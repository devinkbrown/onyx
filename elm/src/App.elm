        ThreadOpen { channel, parentId } ->
            -- Open the replies panel for one message (mirroring
            -- `openThread`).
            ( { model | threadPanel = Just { channel = channel, parentId = parentId } }, [] )

        ThreadClose ->
            ( { model | threadPanel = Nothing }, [] )

        ThreadReplyParent { channel, parentId } ->
            -- Reply from the panel (mirroring `replyFromThread`:
            -- the panel closes and the composer arms on the parent;
            -- parents without a server msgid cannot arm, so the
            -- panel just closes for those).
            let
                closed =
                    { model | threadPanel = Nothing }

                parentMsgid =
                    case Dict.get (String.toLower channel) model.channels of
                        Nothing ->
                            Nothing

                        Just room ->
                            case List.filter (\m -> m.id == parentId) room.messages |> List.head of
                                Just parent ->
                                    parent.msgid

                                Nothing ->
                                    Nothing
            in
            case parentMsgid of
                Just msgid ->
                    let
                        armed =
                            armReply closed channel msgid
                    in
                    ( { armed | editingMessage = Nothing, messageMenu = Nothing }, [] )

                Nothing ->
                    ( closed, [] )

        TopicDraftInput draft ->
            ( { model | topicDraft = draft }, [] )

        TopicCreateSubmit channel ->
            -- Start a named conversation (mirroring `startTopic`:
            -- invalid labels keep the draft and the forum state,
            -- valid labels select and clear the draft; the label
            -- does not need to exist yet).
            let
                label =
                    String.trim model.topicDraft
            in
            if not (isValidTopicLabel label) then
                ( model, [] )

            else
                ( { model
                    | activeChannelTopics = Dict.insert (String.toLower channel) label model.activeChannelTopics
                    , forumView = Dict.remove (String.toLower channel) model.forumView
                    , topicDraft = ""
                  }
                , []
                )

        ForumToggle channel ->
            let
                key =
                    String.toLower channel

                open =
                    not (Maybe.withDefault False (Dict.get key model.forumView))
            in
            ( { model
                | forumView =
                    if open then
                        Dict.insert key True model.forumView

                    else
                        Dict.remove key model.forumView
              }
            , []
            )

        ForumOpenTopic { channel, topic } ->
            -- Open a topic from its forum card (mirroring
            -- `openTopic`: validated select plus closing the forum,
            -- the consumed boundary persisted, and the focus handed
            -- to the now-active filter chip via the focus port,
            -- which runs after render like the oracle
            -- `queueMicrotask`).
            case resolveKnownChannelTopic model channel topic of
                Just valid ->
                    let
                        key =
                            String.toLower channel

                        opened =
                            { model
                                | activeChannelTopics = Dict.insert key valid model.activeChannelTopics
                                , forumView = Dict.remove key model.forumView
                            }

                        ( marked, markOuts ) =
                            markLatestChannelTopicRead opened channel valid
                    in
                    ( reconcileChannelTopicUnread marked key, markOuts ++ [ TopicChipFocus ] )

                Nothing ->
                    ( { model | forumView = Dict.remove (String.toLower channel) model.forumView }, [] )

        ForumChannelToggle channel ->
            -- Pin or unpin the forum projection (mirroring
            -- `toggleForumChannel` plus the `setForumView(true)`
            -- tail: toggling always opens the forum, and unpinning
            -- leaves an open forum open).
            let
                key =
                    String.toLower (String.trim channel)
            in
            if not (isValidNotifyChannel key) then
                ( model, [] )

            else
                let
                    updated =
                        { model
                            | forumChannels =
                                if Set.member key model.forumChannels then
                                    Set.remove key model.forumChannels

                                else
                                    Set.insert key model.forumChannels
                            , forumView = Dict.insert key True model.forumView
                        }
                in
                ( updated, forumChannelsSaveOut updated )

        FollowTopicToggle { channel, topic } ->
            -- Follow or unfollow one conversation (mirroring
            -- `toggleActiveFollow`/`followTopic`: the channel plus
            -- its topic, if any, through the shared follow folds).
            let
                key =
                    followKey channel topic

                updated =
                    if Set.member key model.followed then
                        { model | followed = Set.remove key model.followed }

                    else
                        { model | followed = Set.insert key model.followed }
            in
            ( updated, [ FollowedSave { keys = Set.toList updated.followed } ] )

        ModerationConfirm ->
            -- Confirm re-validates and invalidates on disconnect or
            -- lost room authority (mirroring the review `canSend`
            -- gate); nothing is sent until all three hold.
            case model.moderationDraft of
                Nothing ->
                    ( model, [] )

                Just draft ->
                    case Moderation.validateDraft draft model.ourNick of
                        Err _ ->
                            ( model, [] )

                        Ok { action } ->
                            if model.connection /= Live then
                                ( model, [] )

                            else if not (isChannelOp model draft.channel) then
                                ( model, [] )

                            else
                                ( { model | moderationDraft = Nothing }
                                , applyModerationAction action
                                )

        MessageEditRequested target messageId newText ->
            requestEdit model target messageId newText

        MessageDeleteRequested target messageId ->
            Tuple.mapFirst (\m -> { m | messageMenu = Nothing }) (requestDelete model target messageId)

        OwnMetadataSet key value ->
            setOwnMetadata model key value

        PasskeyCreated fields ->
            case Passkey.webauthnRegisterFinish fields.credId fields.clientDataJSON fields.authData of
                Just line ->
                    ( model, [ SendLine line ] )

                Nothing ->
                    ( { model | passkey = failPasskey model.passkey "Malformed ceremony response." }, [] )

        PasskeyAssertion fields ->
            case Passkey.webauthnAuthFinish fields.credId fields.clientDataJSON fields.authData fields.signature of
                Just line ->
                    ( model, [ SendLine line ] )

                Nothing ->
                    ( { model | passkey = failPasskey model.passkey "Malformed ceremony response." }, [] )

        PasskeyFailed { message } ->
            ( { model | passkey = failPasskey model.passkey message }, [] )

        PasskeySettle ->
            let
                ( session, effect ) =
                    Passkey.settleAuth model.passkey
            in
            ( { model | passkey = session }, passkeyOut effect )

        DmSealed { target, envelope, schedId } ->
            case schedId of
                Just sid ->
                    admitScheduledSeal model sid target envelope

                Nothing ->
                    case Dict.get (String.toLower target) model.pendingSeals of
                        Nothing ->
                            -- No matching in-flight seal (stale generation): drop
                            -- rather than send unattributed ciphertext.
                            ( model, [] )

                        Just pending ->
                            let
                                key =
                                    String.toLower target

                                -- The directory may have rotated while the seal
                                -- was in flight: never admit ciphertext under a
                                -- device set the live directory no longer claims
                                -- (the oracle's `liveMatches` exact-set check —
                                -- flag-only, like a seal-time key change).
                                liveKeys =
                                    sealKeysFor model target

                                sealedSet =
                                    Set.fromList pending.keys

                                liveMatches =
                                    List.length liveKeys
                                        == List.length pending.keys
                                        && List.all (\k -> Set.member k sealedSet) liveKeys

                                text =
                                    pending.text
                            in
                            -- A rotated directory drops the seal silently
                            -- (flag-only); otherwise the labeled sealed send
                            -- stamps `@label=`, mirroring the oracle's
                            -- encrypted `commitLabeledOptimistic` with the
                            -- local plaintext kept on the row so the
                            -- ciphertext-only echo resolves against it.
                            if not liveMatches then
                                -- v3/gap-pwa-safety: the text goes back to
                                -- the draft (held, never resent on its own).
                                ( { model | pendingSeals = Dict.remove key model.pendingSeals }
                                    |> flagPeerKeyChange target
                                    |> restoreHeldDraft target text
                                , []
                                )

                            else
                                let
                                    useLabel =
                                        List.member "labeled-response" model.caps

                                    cleared =
                                        { model | pendingSeals = Dict.remove key model.pendingSeals, replyingTo = Nothing }

                                    ( registered, label ) =
                                        if useLabel then
                                            registerLabeledSend cleared target [ model.messageSeq ] text

                                        else
                                            ( cleared, "" )

                                    tags =
                                        (if List.member "onyx/e2ee" model.caps then
                                            Dict.singleton "+onyx/e2ee" "mls"

                                         else
                                            Dict.empty
                                        )
                                            |> (if useLabel then
                                                    Dict.insert "label" label

                                                else
                                                    identity
                                               )

                                    line =
                                        Wire.formatTaggedLine (Dict.union tags (Dict.union (replyTagFor model target) (topicTagFor model target))) "PRIVMSG" [ target, envelope ]

                                    -- Sealed outbound rows persist the envelope only
                                    -- (never the transient plaintext), mirroring the
                                    -- oracle vault write — otherwise our sealed sends
                                    -- would vanish on reload without echo-message.
                                    vaultRow =
                                        { id = String.toLower target ++ ":" ++ String.fromInt model.messageSeq
                                        , target = String.toLower target
                                        , from = model.ourNick
                                        , body = envelope
                                        , at = floor model.nowMs
                                        , rowType = "msg"
                                        , deleted = False
                                        , redacted = False
                                        , replyTo = Nothing
                                        }

                                    filed =
                                        updateChannel registered
                                            target
                                            (\c ->
                                                { c
                                                    | messages =
                                                        List.take keepMessages
                                                            (normalizeActionRow { id = model.messageSeq
                                                             , from = model.ourNick
                                                             , body = envelope
                                                             , whisper = False
                                                             , audience = Nothing
                                                             , highlight = False
                                                             , outboxId = Nothing
                                                             , pending = useLabel
                                                             , plaintext = Just text
                                                             , at = floor model.nowMs
                                                             , msgid = Nothing
                                                             , reactions = []
                                                             , edited = False
                                                             , deleted = False
                                                             , redacted = False
                                                             , topic = ""
                                                             , msgType = "msg"
                                                             , replyTo = Nothing
                                                             }
                                                                :: c.messages
                                                            )
                                                }
                                            )
                                            |> (\m -> { m | messageSeq = m.messageSeq + 1 })
                                in
                            let
                                ( previewed, previewOuts ) =
                                    requestPreviewForBody filed text
                            in
                            ( rememberVaultIds previewed [ vaultRow ]
                            , [ SendLine line, VaultPersist { target = String.toLower target, rows = [ vaultRow ] } ] ++ previewOuts
                            )

        DmSealFailed { target, keyChanged, schedId } ->
            -- A failed DM seal never downgrades to plaintext. A
            -- seal-time key change flags the peer and drops the pending
            -- seal with no toast (the oracle's flag-only path — the
            -- key-change banner is the signal, never coaching to turn
            -- E2EE off). Other failures toast + notify verbatim from
            -- the oracle seal-failure path. Scheduled seals hold their
            -- durable claim uncertain instead (never auto-retried).
            case schedId of
                Just sid ->
                    rejectScheduledSeal model sid keyChanged

                Nothing ->
                        if keyChanged then
                            -- v3/gap-pwa-safety: the dropped seal's text
                            -- returns to the draft and the send is held.
                            let
                                held =
                                    Dict.get (String.toLower target) model.pendingSeals
                                        |> Maybe.map .text
                                        |> Maybe.withDefault ""
                            in
                            ( { model | pendingSeals = Dict.remove (String.toLower target) model.pendingSeals }
                                |> flagPeerKeyChange target
                                |> restoreHeldDraft target held
                            , []
                            )

                        else
                            let
                                toasted =
                                    addToast
                                        { variant = ToastError
                                        , title = "Encryption unavailable"
                                        , description =
                                            Just
                                                ("Your message to "
                                                    ++ target
                                                    ++ " was NOT sent — the encrypted DM could not be sealed. Try again."
                                                )
                                        , duration = Nothing
                                        , groupKey = Nothing
                                        , undo = Nothing
                                        }
                                        model.nowMs
                                        model
                            in
                            ( addNotification toasted
                                { kind = NotifError
                                , text =
                                    "Encryption unavailable — message to "
                                        ++ target
                                        ++ " was not sent (the encrypted DM could not be sealed)."
                                , from = Nothing
                                , channel = Nothing
                                , topic = Nothing
                                }
                            , []
                            )

        DmOpenResult { messageId, envelope, plaintext } ->
            ( notifyDmPlaintext (fillPlaintext model messageId envelope plaintext) messageId envelope plaintext, [] )

        DmOpenFailed { peer, keyChanged } ->
            if keyChanged then
                ( flagPeerKeyChange peer model, [] )

            else
                ( model, [] )

        RoomSealed { room, envelope } ->
            case Dict.get (String.toLower room) model.roomSeals of
                Nothing ->
                    ( model, [] )

                Just text ->
                    let
                        -- Same labeled treatment as the DM seal path
                        -- above: stamp, register, render pending.
                        useLabel =
                            List.member "labeled-response" model.caps

                        cleared =
                            { model | roomSeals = Dict.remove (String.toLower room) model.roomSeals, replyingTo = Nothing }

                        ( registered, label ) =
                            if useLabel then
                                registerLabeledSend cleared room [ model.messageSeq ] text

                            else
                                ( cleared, "" )

                        -- Sealed room sends always carry the e2ee tag
                        -- (the oracle stamps `e2eeMessageTag('mls')`
                        -- unconditionally here — unlike the DM arm,
                        -- which gates on the cap).
                        tags =
                            Dict.singleton "+onyx/e2ee" "mls"
                                |> (if useLabel then
                                        Dict.insert "label" label

                                    else
                                        identity
                                   )

                        line =
                            Wire.formatTaggedLine (Dict.union tags (Dict.union (replyTagFor model room) (topicTagFor model room))) "PRIVMSG" [ room, envelope ]

                        -- Like the DM seal path: persist the envelope
                        -- only, never the transient plaintext.
                        vaultRow =
                            { id = String.toLower room ++ ":" ++ String.fromInt model.messageSeq
                            , target = String.toLower room
                            , from = model.ourNick
                            , body = envelope
                            , at = floor model.nowMs
                            , rowType = "msg"
                            , deleted = False
                            , redacted = False
                            , replyTo = Nothing
                            }

                        filed =
                            updateChannel registered
                                room
                                (\c ->
                                    { c
                                        | messages =
                                            List.take keepMessages
                                                (normalizeActionRow { id = model.messageSeq
                                                 , from = model.ourNick
                                                 , body = envelope
                                                 , whisper = False
                                                 , audience = Nothing
                                                 , highlight = False
                                                 , outboxId = Nothing
                                                 , pending = useLabel
                                                 , plaintext = Just text
                                                 , at = floor model.nowMs
                                                 , msgid = Nothing
                                                 , reactions = []
                                                 , edited = False
                                                 , deleted = False
                                                 , redacted = False
                                                 , topic = ""
                                                 , msgType = "msg"
                                                 , replyTo = Nothing
                                                 }
                                                    :: c.messages
                                                )
                                    }
                                )
                                |> (\m -> { m | messageSeq = m.messageSeq + 1 })
                    in
                    (let
                        ( previewed, previewOuts ) =
                            requestPreviewForBody filed text
                     in
                     ( rememberVaultIds previewed [ vaultRow ]
                     , [ SendLine line, VaultPersist { target = String.toLower room, rows = [ vaultRow ] } ] ++ previewOuts
                     )
                    )

        RoomSealFailed { room, recoveryRequired, notProvisioned } ->
            -- Three oracle copies: no room session at all (toast only,
            -- like the no-bridge arm), recovery-needed, and not-ready
            -- (both toast + error inbox notice, like the seal-failure
            -- arm). A sealed-room failure is silent on the wire by
            -- design, so chrome is the only user-visible signal.
            if notProvisioned then
                ( addToast
                    { variant = ToastError
                    , title = "Encrypted room is locked"
                    , description = Just ("Your message was not sent. Reconnect or wait for " ++ room ++ "'s encryption setup to finish, then try again.")
                    , duration = Nothing
                    , groupKey = Nothing
                    , undo = Nothing
                    }
                    model.nowMs
                    { model | roomSeals = Dict.remove (String.toLower room) model.roomSeals }
                , []
                )

            else
                let
                    lockedDescription =
                        if recoveryRequired then
                            "Your message was not sent. This room needs encryption recovery before sending."

                        else
                            "Your message was not sent. Wait for the room encryption status to become ready, then try again."

                    logged =
                        { model
                            | roomSeals = Dict.remove (String.toLower room) model.roomSeals
                            , serviceLog =
                                List.take maxServiceLog
                                    ((if recoveryRequired then
                                        "Encrypted room is locked: this room needs encryption recovery before sending."

                                      else
                                        "Encrypted room is locked: wait for the room encryption status to become ready, then try again."
                                     )
                                        :: model.serviceLog
                                    )
                        }

                    toasted =
                        addToast
                            { variant = ToastError
                            , title = "Encrypted room is locked"
                            , description = Just lockedDescription
                            , duration = Nothing
                            , groupKey = Nothing
                            , undo = Nothing
                            }
                            model.nowMs
                            logged
                in
                ( addNotification toasted
                    { kind = NotifError
                    , text = "Encryption unavailable — message to " ++ room ++ " was not sent."
                    , from = Nothing
                    , channel = Nothing
                    , topic = Nothing
                    }
                , []
                )

        RoomOpenResult { room, messageId, envelope, plaintext } ->
            ( fillPlaintext model messageId envelope plaintext
                |> (\m -> clearRoomFlight m room messageId envelope)
            , []
            )

        RoomOpenFailed { room, messageId, envelope } ->
            ( clearRoomFlight model room messageId envelope, [] )

        GroupControlVerified result ->
            foldGroupVerified model result

        GroupDirectoryDerived derived ->
            foldGroupDerived model derived

        GroupWelcomeOpened result ->
            foldGroupWelcomeOpened model result

        GroupPublisherIdentity projected ->
            -- Ports-side public projection resolved: assemble the ODD1
            -- record through the Elm codec and let the publisher verify
            -- before it sends anything. A new device id may unblock
            -- buffered welcomes, so rescan the pairs too.
            let
                ( nextPublisher, pubFx ) =
                    GroupPublisher.identityProjected (Maybe.andThen projectToIdentity projected) model.publisher

                ( rescan, rescanFx ) =
                    tryOpenPairs { model | publisher = nextPublisher }
            in
            ( rescan, runPublisherEffects pubFx ++ rescanFx )

        GroupPublisherRetry ->
            let
                ( nextPublisher, pubFx ) =
                    GroupPublisher.retryDue model.publisher
            in
            ( { model | publisher = nextPublisher }, runPublisherEffects pubFx )

        AttributionEnrollReply reply ->
            -- Ports answered the enroll request. `Nothing` (or a stale
            -- generation inside the fold) fails closed: nothing is
            -- sent and the account stays on the UID path.
            case reply of
                Nothing ->
                    ( model, [] )

                Just enroll ->
                    let
                        ( next, fx ) =
                            Attribution.foldEnrollReply (withAttributionServer model) model.nowMs enroll
                    in
                    ( { model | attribution = next }, runAttributionEffects [ fx ] )

        AttributionResidenceReply reply ->
            case reply of
                Nothing ->
                    ( model, [] )

                Just residence ->
                    let
                        ( next, fx ) =
                            Attribution.foldResidenceReply (withAttributionServer model) model.nowMs residence
                    in
                    ( { model | attribution = next }, runAttributionEffects [ fx ] )

        StewardOpen channel ->
            ( { model
                | stewardRoom = Just channel
                , stewardHelper = ""
                , stewardSuccessor = ""
                , stewardTypedName = ""
                , stewardStatus = ""
                , stewardClosing = False
                , stewardDeleting = False
              }
            , []
            )

        StewardClose ->
            ( { model | stewardRoom = Nothing, stewardStatus = "", stewardClosing = False, stewardDeleting = False }
            , []
            )

        StewardHelperInput value ->
            ( { model | stewardHelper = value }, [] )

        StewardSuccessorInput value ->
            ( { model | stewardSuccessor = value }, [] )

        StewardTypedNameInput value ->
            ( { model | stewardTypedName = value }, [] )

        StewardAskClose ->
            ( { model | stewardClosing = True, stewardDeleting = False }, [] )

        StewardAskDelete ->
            ( { model | stewardDeleting = True, stewardClosing = False }, [] )

        StewardCancelAsk ->
            ( { model | stewardClosing = False, stewardDeleting = False }, [] )

        StewardAddHelper channel ->
            requestStewardAddHelper model channel model.stewardHelper

        StewardRemoveHelper channel nick ->
            requestStewardRemoveHelper model channel nick

        StewardOfferTransfer channel ->
            requestStewardOfferTransfer model channel model.stewardSuccessor

        StewardAcceptTransfer channel ->
            requestStewardAcceptTransfer model channel

        StewardDeclineTransfer channel ->
            requestStewardDeclineTransfer model channel

        StewardDeclineAndClose channel ->
            -- The take-view "Not now" walks away and closes the
            -- panel (mirroring the oracle sheet close on decline).
            let
                ( declined, out ) =
                    requestStewardDeclineTransfer model channel
            in
            ( { declined | stewardRoom = Nothing }, out )

        WebPushToggle ->
            toggleWebPush model

        WebPushProbed probed ->
            foldWebPushProbed model probed

        WebPushEnabled reply ->
            foldWebPushEnabled model reply

        WebPushRecovered reply ->
            foldWebPushRecovered model reply

        WebPushDisabled reply ->
            foldWebPushDisabled model reply

        WebPushActiveState state ->
            foldWebPushActiveState model state

        WebPushRecoveryHint ->
            -- The service worker changed under us: re-run recovery
            -- without a reload (mirroring `controllerchange`).
            requestWebPushCheck model

        MediaBinaryReceived req ->
            foldMediaBinary model req.bytes

        StewardGrantTransfer channel ->
            requestStewardGrantTransfer model channel

        StewardConfirmClose channel ->
            requestStewardCloseRoom model channel

        StewardConfirmDelete channel ->
            requestStewardDeleteRoom model channel

        WebhookNameInput value ->
            ( { model | webhookName = value }, [] )

        WebhookDeleteIdInput value ->
            ( { model | webhookDeleteId = value }, [] )

        WebhookCreate channel ->
            requestWebhookCreate model channel

        WebhookList channel ->
            requestWebhookList model channel

        WebhookDelete channel ->
            requestWebhookDelete model channel


{-| Record a ceremony-side failure: busy clears, error shows. -}
failPasskey : Passkey.PasskeySession -> String -> Passkey.PasskeySession
failPasskey session message =
    { session | busy = False, error = Just message }


-- v3/gap-usermodes ────────────────────────────────────────────────────────
--
-- Glue between the pure `UserModes` core and the model: the context it folds
-- against, the effects it asks for, the owner-scoped storage slot, and the
-- small hooks the older folds call (ignore ↔ SILENCE, autojoin ↔ AUTOJOIN,
-- send-later ↔ DEFER). Views read `model.userModes` directly.


{-| The live facts the user-mode core folds against. -}
userModesCtx : Model -> UserModes.Ctx
userModesCtx model =
    { nick = model.ourNick
    , account = model.accountName
    , live = model.connection == Live
    , nowMs = model.nowMs
    , silenceLimit = model.isupport.silence
    , ignored = model.ignoredUsers
    , isChannel = isChannelName model
    , profileNicks =
        case model.whoisTarget of
            Just nick ->
                Set.singleton (String.toLower nick)

            Nothing ->
                Set.empty
    , dmPeers = \_ -> userModesDmPeers model
    , serverPrefix = model.serverPrefix
    , leaks = destinationsLeak model
    }


{-| Open direct-message conversations, newest first (bounded). -}
userModesDmPeers : Model -> List String
userModesDmPeers model =
    model.channels
        |> Dict.values
        |> List.filter (\c -> not (isChannelName model c.name) && String.toLower c.name /= String.toLower model.ourNick)
        |> List.sortBy (\c -> negate (dmLastTime c))
        |> List.take 24
        |> List.map .name


{-| Fold one parsed line through the user-mode core first. A consumed line
never reaches the older folds; an observed one (004, the own MODE and SETNAME
echoes, a 401 for an open profile) still does. A fresh 001 re-asks the
server for the modes. -}
foldLineUserModes : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldLineUserModes model parsed =
    case UserModes.foldWire (userModesCtx model) parsed model.userModes of
        Just folded ->
            let
                ( applied, outs ) =
                    applyUserModesEffects parsed folded.effects { model | userModes = folded.state }
            in
            if folded.consume then
                ( applied, outs )

            else
                let
                    ( next, more ) =
                        foldLine applied parsed
                in
                ( next, outs ++ more )

        Nothing ->
            let
                ( next, more ) =
                    foldLine model parsed
            in
            if parsed.command == "001" then
                userModesConnected ( next, more )

            else
                ( next, more )


userModesConnected : ( Model, List Outbound ) -> ( Model, List Outbound )
userModesConnected ( model, outs ) =
    let
        ( state, effects ) =
            UserModes.onConnected (userModesCtx model) model.userModes

        ( applied, more ) =
            applyUserModesEffects (Wire.parseIrcMessage "NOTICE") effects { model | userModes = state }
    in
    ( applied, outs ++ more )


{-| A view message: run the core, apply what it asked for. -}
userModesUpdate : UserModes.Msg -> Model -> ( Model, List Outbound )
userModesUpdate sub model =
    let
        ( state, effects ) =
            UserModes.update (userModesCtx model) sub model.userModes

        -- The mailbox is a sheet of its own: opening it from the inbox
        -- puts the inbox away.
        base =
            if sub == UserModes.MemoOpen then
                { model | showNotificationCenter = False }

            else
                model
    in
    applyUserModesEffects (Wire.parseIrcMessage "NOTICE") effects { base | userModes = state }


applyUserModesEffects : Wire.IrcMessage -> List UserModes.Effect -> Model -> ( Model, List Outbound )
applyUserModesEffects message effects model =
    List.foldl
        (\effect ( m, outs ) ->
            let
                ( next, more ) =
                    applyUserModesEffect message effect m
            in
            ( next, outs ++ more )
        )
        ( model, [] )
        effects


applyUserModesEffect : Wire.IrcMessage -> UserModes.Effect -> Model -> ( Model, List Outbound )
applyUserModesEffect message effect model =
    case effect of
        UserModes.Send line ->
            ( model, [ SendLine line ] )

        UserModes.Persist ->
            case deviceMemoryOwner model of
                Just owner ->
                    ( model
                    , [ UserModesSave { serverUrl = owner.serverUrl, identity = owner.identity, json = UserModes.encodeStored model.userModes } ]
                    )

                Nothing ->
                    ( model, [] )

        UserModes.Toast t ->
            ( addToast
                { variant =
                    if t.error then
                        ToastError

                    else
                        ToastInfo
                , title = t.title
                , description =
                    if String.isEmpty t.body then
                        Nothing

                    else
                        Just t.body
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                model
            , []
            )

        UserModes.DmNote note ->
            if Dict.member (String.toLower note.peer) model.channels && not (isChannelName model note.peer) then
                ( appendLiveRow model note.peer ("Not delivered — " ++ note.text) message, [] )

            else
                ( addToast
                    { variant = ToastInfo
                    , title = "Not delivered"
                    , description = Just note.text
                    , duration = Nothing
                    , groupKey = Nothing
                    , undo = Nothing
                    }
                    model.nowMs
                    model
                , []
                )

        UserModes.DeliverMemo memo ->
            if validWireToken memo.from 256 then
                deliverOfflineMemo model message memo.from (boundInboundMessageText memo.text)

            else
                ( model, [] )

        UserModes.DeferSettled settled ->
            userModesDeferSettled settled model

        UserModes.OpenDm nick ->
            updateCore (MemberMessage nick) model

        UserModes.OpenPrivacy ->
            let
                ( opened, outs ) =
                    prefsOpen { model | showNotificationCenter = False }
            in
            ( { opened | prefsCategory = PrefsPanel.Privacy }, outs )

        UserModes.ForgetDeviceAutojoin channel ->
            removeAutoJoin model channel

        UserModes.FocusId id ->
            ( model, [ PrefsFocus { id = id } ] )


{-| The server answered a send-later request: success closes the picker and
clears the draft it held; a refusal keeps the draft and says why. -}
userModesDeferSettled : { ok : Bool, held : UserModes.Held, error : String } -> Model -> ( Model, List Outbound )
userModesDeferSettled settled model =
    if not settled.ok then
        ( { model | scheduleError = Just settled.error }, [] )

    else
        let
            key =
                String.toLower settled.held.channel

            stillHeld =
                String.trim model.composer == settled.held.text && Maybe.map String.toLower model.activeChannel == Just key

            cleared =
                { model
                    | scheduleOpen = False
                    , scheduleWhen = ""
                    , scheduleError = Nothing
                    , composerDrafts = Dict.remove key model.composerDrafts
                    , composer =
                        if stillHeld then
                            ""

                        else
                            model.composer
                }
        in
        ( addToast
            { variant = ToastSuccess
            , title = "Scheduled on the server"
            , description =
                Just
                    ("Sends to "
                        ++ settled.held.channel
                        ++ " "
                        ++ scheduleSendLabel settled.held.sendAt (floor model.nowMs)
                        ++ ", even if you close this tab. It can't be cancelled."
                    )
            , duration = Nothing
            , groupKey = Nothing
            , undo = Nothing
            }
            model.nowMs
            cleared
        , []
        )


{-| The send-later popover's "On the server" route. `Nothing` keeps the
local (cancellable) path: the person did not choose it, or the draft cannot
wait on the server. -}
userModesDeferRoute : Model -> Int -> Maybe ( Model, List Outbound )
userModesDeferRoute model epoch =
    if not model.userModes.deferServer then
        Nothing

    else
        case ( model.activeChannel, userModesDeferCheck model ) of
            ( Just target, UserModes.DeferOk ) ->
                case UserModes.deferSubmit (userModesCtx model) { channel = target, text = model.composer, sendAt = epoch } model.userModes of
                    Err why ->
                        Just ( { model | scheduleError = Just why }, [] )

                    Ok ( state, effects ) ->
                        Just (applyUserModesEffects (Wire.parseIrcMessage "NOTICE") effects { model | userModes = state, scheduleError = Nothing })

            _ ->
                Nothing


{-| Can the current draft wait on the server? -}
userModesDeferCheck : Model -> UserModes.DeferCheck
userModesDeferCheck model =
    case model.activeChannel of
        Nothing ->
            UserModes.DeferRoomOnly

        Just target ->
            UserModes.deferCheck
                { signedIn = model.accountName /= Nothing
                , live = model.connection == Live
                , isChannel = isChannelName model target && model.composerAudience == Nothing
                , member = Dict.member (String.toLower model.ourNick) (ensureChannel model target).members
                , encrypted = roomEncryptionPolicy model target == RequiredPolicy
                , text = model.composer
                }


{-| A new or lifted local block, mirrored to the server when opted in. -}
userModesMirrorIgnore : Bool -> String -> ( Model, List Outbound ) -> ( Model, List Outbound )
userModesMirrorIgnore added nick ( model, outs ) =
    let
        ctx =
            userModesCtx model

        ( state, effects ) =
            if added then
                UserModes.ignoreAdded ctx nick model.userModes

            else
                UserModes.ignoreRemoved ctx nick model.userModes

        ( next, more ) =
            applyUserModesEffects (Wire.parseIrcMessage "NOTICE") effects { model | userModes = state }
    in
    ( next, outs ++ more )


{-| `/autojoin` and `/unautojoin` also reach the account when signed in, so
the server joins the room on every device. -}
userModesAutojoinOut : Model -> String -> String -> List Outbound
userModesAutojoinOut model sub channel =
    if model.accountName == Nothing || model.connection /= Live then
        []

    else
        case UserModes.autojoinLine sub (Just channel) of
            Just line ->
                [ SendLine line ]

            Nothing ->
                []


userModesAutojoinCopy : Model -> Bool -> String
userModesAutojoinCopy model added =
    case ( model.accountName, added ) of
        ( Just _, True ) ->
            "This room will be joined on every device you sign in on."

        ( Just _, False ) ->
            "Sign-in will no longer join this room, on any device."

        ( Nothing, True ) ->
            "This room will be rejoined on this device after reconnect."

        ( Nothing, False ) ->
            "Reconnect will no longer force-join this room from this device."


{-| Post-update step: end in-flight asks with the socket and refresh the
server-held lists when the sheet that shows them opens. The owner's stored
wishes load with the other owner-scoped slots (`requestIdentityProfile`). -}
settleStepUserModes : Msg -> Model -> ( Model, List Outbound ) -> ( Model, List Outbound )
settleStepUserModes msg prior ( model, outs ) =
    let
        closed =
            case msg of
                WsClosed _ ->
                    { model | userModes = UserModes.onDisconnected model.userModes }

                _ ->
                    model

        loading =
            closed

        privacyVisible m =
            m.prefsOpen && m.prefsCategory == PrefsPanel.Privacy

        opened =
            List.concat
                [ if privacyVisible loading && not (privacyVisible prior) then
                    [ UserModes.AcceptRefresh ]

                  else
                    []
                , if loading.notifySheetOpen && not prior.notifySheetOpen && loading.accountName /= Nothing then
                    [ UserModes.SilenceRefresh ]

                  else
                    []
                , if loading.accountOpen && not prior.accountOpen then
                    [ UserModes.AutojoinRefresh ]

                  else
                    []
                , if loading.showNotificationCenter && not prior.showNotificationCenter && loading.userModes.requestsUnseen > 0 then
                    [ UserModes.RequestsSeen ]

                  else
                    []
                ]

        ( refreshed, refreshOuts ) =
            List.foldl
                (\sub ( m, acc ) ->
                    let
                        ( state, effects ) =
                            UserModes.update (userModesCtx m) sub m.userModes

                        ( next, more ) =
                            applyUserModesEffects (Wire.parseIrcMessage "NOTICE") effects { m | userModes = state }
                    in
                    ( next, acc ++ more )
                )
                ( loading, [] )
                opened
    in
    ( refreshed, outs ++ refreshOuts )



{-| Fold one parsed line, lifting wire outbounds to `SendLine` and
persisting channel traffic to the vault. DMs persist under the peer
nick, exactly as they render.
-}
foldParsed : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldParsed model parsed =
    if isRepeatDelivery model parsed then
        -- Bouncer/session-sync rewind of an already-folded line: drop
        -- before the store and the vault (msgid-merge dedup).
        ( model, [] )

    else
        case divertHistoryBatch model parsed of
            Just buffered ->
                -- Batched playback child: held for the close merge,
                -- never folded live.
                ( buffered, [] )

            Nothing ->
                let
                    filed =
                        rememberDelivery model parsed

                    ( next, outbound ) =
                        -- v3/gap-usermodes: the user-mode lines fold first
                        foldLineUserModes filed parsed
                            -- v3/calls-c11
                            |> foldStageWire parsed
                in
                -- A dropped self-echo never reaches the vault: the optimistic send
                -- already persisted it, and a second row would fork history.
                -- A swallowed CTCP wrapper never reaches the vault either
                -- (mirroring the oracle `break` before store and vault).
                if parsed.command == "PRIVMSG" && isLiveSelfEcho model parsed then
                    ( next, outbound )

                else if isSwallowedCtcpWire model.ourNick parsed then
                    ( next, outbound )

                else
                    case persistRow next parsed of
                        Just row ->
                            -- Whole-buffer flush through the signature
                            -- gate (one VaultPersist per content change;
                            -- the seen-ids land as part of the flush).
                            flushVaultBuffer (rememberVaultIds next row.rows) row.target
                                |> (\( flushed, flushOuts ) -> ( flushed, outbound ++ flushOuts ))

                        Nothing ->
                            ( next, outbound )


persistRow : Model -> Wire.IrcMessage -> Maybe { target : String, rows : List VaultRow }
persistRow model parsed =
    case parsed.command of
        "PRIVMSG" ->
            persistChatRow model parsed

        "WHISPER" ->
            persistChatRow model parsed

        "NOTICE" ->
            persistChatRow model parsed

        _ ->
            Nothing


persistChatRow : Model -> Wire.IrcMessage -> Maybe { target : String, rows : List VaultRow }
persistChatRow model parsed =
    case parsed.params of
        target :: body :: _ ->
            let
                key =
                    String.toLower (dmFileBucket model target (Maybe.withDefault "" parsed.nick))

                row =
                    { id = key ++ ":" ++ String.fromInt (model.messageSeq - 1)
                    , target = key
                    , from = Maybe.withDefault "" parsed.nick
                    , body = body
                    , at = rowTime model parsed
                    , rowType =
                        if parsed.command == "NOTICE" then
                            "notice"

                        else if parsed.command == "WHISPER" then
                            "whisper"

                        else
                            "msg"
                    , deleted = False
                    , redacted = False
                    , replyTo = Tuple.second (resolveInboundReply model key parsed body)
                    }
            in
            if Dict.member key model.channels then
                Just { target = key, rows = [ row ] }

            else
                Nothing

        _ ->
            Nothing


{-| Merge vault rows into a channel that has no live messages yet
(initial history load). Channels that already carry live traffic are
left alone so a late vault response can never clobber the live view.
`messageSeq` fast-forwards past the highest stored seq so freshly
folded ids stay unique.
-}
mergeVaultRows : Model -> String -> List VaultRow -> Model
mergeVaultRows model target rows =
    let
        key =
            String.toLower target
    in
    case Dict.get key model.channels of
        Nothing ->
            model

        Just channel ->
            if List.isEmpty channel.messages then
                let
                    toChat index row =
                        normalizeActionRow
                        { id = index
                        , from = row.from
                        , body = row.body
                        , whisper = False
                        , audience = Nothing
                        , highlight = False
                        , outboxId = Nothing
                        , pending = False
                        , plaintext = Nothing
                        , at = row.at
                        , msgid = Nothing
                        , reactions = []
                        , edited = False
                        , deleted = row.deleted
                        , redacted = row.redacted
                        , replyTo = Maybe.map sanitizeReplyRef row.replyTo
                        , topic = ""
                        , msgType = row.rowType
                        }

                    stored =
                        List.map .id rows
                            |> List.filterMap (rowSeq key)
                            |> List.maximum
                            |> Maybe.withDefault -1

                    chats =
                        List.indexedMap toChat rows
                            |> List.reverse
                            |> List.take keepMessages
                in
                updateChannel model key
                    (\c -> { c | messages = chats })
                    |> (\m -> { m | messageSeq = max m.messageSeq (stored + 1) })

            else
                model


rowSeq : String -> String -> Maybe Int
rowSeq key id =
    case String.split ":" id of
        _ :: seqPart :: [] ->
            if String.startsWith (key ++ ":") id then
                String.toInt seqPart

            else
                Nothing

        _ ->
            Nothing


{-| Vault ids already observed this session (persisted live lines plus
loaded windows, newest first, bounded). Time-travel windows dedupe
against these exactly like the oracle's id-keyed history merge — every
live line is persisted synchronously, so an unseen window row is always
older history, never a live duplicate.
-}
maxVaultSeenIds : Int
maxVaultSeenIds =
    2000


rememberVaultIds : Model -> List VaultRow -> Model
rememberVaultIds model rows =
    { model | vaultSeenIds = List.take maxVaultSeenIds (List.map .id rows ++ model.vaultSeenIds) }


{-| Maximum live owner/target watermarks (mirrors
`VAULT_SYNC_TARGET_CACHE_CAP = 512`). -}
vaultSyncTargetCacheCap : Int
vaultSyncTargetCacheCap =
    512


{-| Rows worth persisting (mirrors `persistableRows`: settled
conversation only — optimistic outbox placeholders never reach
the disk, or a stuck-pending ghost plus a duplicate of the
delivered line would survive every hydrate). -}
persistableVaultRows : List ChatMessage -> List ChatMessage
persistableVaultRows messages =
    List.filter (\m -> not m.pending && m.outboxId == Nothing) messages


{-| Exact 32-bit multiply (mirrors `Math.imul`): 16-bit halves
keep every partial product exact where Elm `*` would go float;
the high half adds (it overlaps the low half — OR would drop
carries) and the total wraps mod 2^32. -}
fnvMul : Int -> Int -> Int
fnvMul a b =
    let
        lo =
            Bitwise.and 0xFFFF a * Bitwise.and 0xFFFF b

        mid =
            modBy 65536
                (Bitwise.and 0xFFFF a * Bitwise.shiftRightZfBy 16 b + Bitwise.shiftRightZfBy 16 a * Bitwise.and 0xFFFF b)

        total =
            toFloat lo + toFloat mid * 65536.0
    in
    if total >= 4294967296.0 then
        round (total - 4294967296.0)

    else
        round total


{-| 32-bit FNV-1a mix step (`imul(xor(acc, code), prime)`). -}
fnvMix : Int -> Int -> Int
fnvMix acc code =
    fnvMul (Bitwise.xor acc code) 0x01000193


{-| Mix one string into an FNV-1a accumulator, iterating UTF-16
code units exactly like the oracle's `charCodeAt` loop (astral
characters mix their surrogate pair, never the code point). -}
fnvMixString : Int -> String -> Int
fnvMixString acc value =
    List.foldl fnvMixChar acc (String.toList value)


fnvMixChar : Char -> Int -> Int
fnvMixChar c acc =
    let
        code =
            Char.toCode c
    in
    if code < 0x10000 then
        fnvMix acc code

    else
        let
            sub =
                code - 0x10000
        in
        fnvMix (fnvMix acc (0xD800 + sub // 1024)) (0xDC00 + modBy 1024 sub)


{-| Content signature over the mutation-relevant fields of the
persistable rows (mirrors `bufferSignature`: id + text + edited /
deleted / redacted flags + reactions — a tail-id watermark alone
misses in-place edits, so the hash makes those mutations dirty the
watermark and become durable at rest; `len:base36` rendering). -}
vaultBufferSignature : List ChatMessage -> String
vaultBufferSignature rows =
    let
        mixRow m acc =
            let
                flags =
                    (if m.edited then 1 else 0)
                        + (if m.deleted then 2 else 0)
                        + (if m.redacted then 4 else 0)

                withFlags =
                    Bitwise.xor (fnvMul (fnvMixString (fnvMixString acc (String.fromInt m.id)) m.body) 0x01000193) flags
            in
            List.foldl
                (\r h ->
                    List.foldl (\u hh -> fnvMixString hh u) (fnvMixString h r.emoji) r.users
                )
                withFlags
                m.reactions

        hash =
            List.foldl mixRow -2128831035 rows
    in
    String.fromInt (List.length rows) ++ ":" ++ base36 hash


{-| Unsigned base-36 rendering (mirrors `h.toString(36)`; the
negative-to-unsigned lift is exact — 2^32 fits in a float). -}
base36 : Int -> String
base36 n =
    let
        digits =
            "0123456789abcdefghijklmnopqrstuvwxyz"

        unsigned =
            if n < 0 then
                n + 4294967296

            else
                n
    in
    if unsigned == 0 then
        "0"

    else
        base36Loop unsigned digits ""


base36Loop : Int -> String -> String -> String
base36Loop n digits acc =
    if n == 0 then
        acc

    else
        let
            quo =
                n // 36

            rem =
                n - quo * 36
        in
        base36Loop quo digits (String.slice rem (rem + 1) digits ++ acc)


{-| Project one buffer row to its vault row (`target:seq` id, raw
body — ciphertext for unopened envelopes, never plaintext — plus
the row type the export/import round-trip requires). -}
sanitizeReplyRef : ReplyRef -> ReplyRef
sanitizeReplyRef ref =
    { ref | text = sanitizePersistedReplyPreviewText ref.text }


chatToVaultRow : String -> ChatMessage -> VaultRow
chatToVaultRow target message =
    { id = target ++ ":" ++ String.fromInt message.id
    , target = target
    , from = message.from
    , body = message.body
    , at = message.at
    , rowType = message.msgType
    , deleted = message.deleted
    , redacted = message.redacted
    , replyTo = Maybe.map sanitizeReplyRef message.replyTo
    }


{-| Flush the buffer a non-chat line may have mutated (reactions,
edits, redactions): resolve the bucket like the persist path and
let the signature gate decide. -}
flushVaultForMessage : Model -> Wire.IrcMessage -> ( Model, List Outbound )
flushVaultForMessage model message =
    case message.params of
        target :: _ ->
            let
                key =
                    String.toLower (dmFileBucket model target (Maybe.withDefault "" message.nick))
            in
            if Dict.member key model.channels then
                flushVaultBuffer model key

            else
                ( model, [] )

        [] ->
            ( model, [] )


{-| Flush one buffer to the vault when its content signature moved
(mirrors the `scheduleFlush` settle: unchanged signatures emit
nothing, so steady traffic coalesces instead of stampeding the
DB; the watermark map itself caps at 512 targets, oldest
dropped). -}
flushVaultBuffer : Model -> String -> ( Model, List Outbound )
flushVaultBuffer model target =
    let
        key =
            String.toLower target
    in
    case Dict.get key model.channels of
        Nothing ->
            ( model, [] )

        Just channel ->
            flushVaultBufferFor model key channel.messages


flushVaultBufferFor : Model -> String -> List ChatMessage -> ( Model, List Outbound )
flushVaultBufferFor model key messages =
    let
        settled =
            persistableVaultRows messages

        rows =
            List.map (chatToVaultRow key) settled

        sig =
            vaultBufferSignature settled
    in
    if Dict.get key model.vaultPersistSig == Just sig then
        ( model, [] )

    else
        let
            pruned =
                if Dict.member key model.vaultPersistSig || Dict.size model.vaultPersistSig < vaultSyncTargetCacheCap then
                    model

                else
                    case model.vaultPersistOrder of
                        oldest :: rest ->
                            { model
                                | vaultPersistSig = Dict.remove oldest model.vaultPersistSig
                                , vaultPersistOrder = rest
                            }

                        [] ->
                            model

            stored =
                { pruned
                    | vaultPersistSig = Dict.insert key sig pruned.vaultPersistSig
                    , vaultPersistOrder =
                        List.filter (\k -> k /= key) pruned.vaultPersistOrder ++ [ key ]
                }
        in
        ( rememberVaultIds stored rows, [ VaultPersist { target = key, rows = rows } ] )


{-| Nearest window row to a time-travel anchor: smallest clock
distance, ties breaking older-first — mirroring the oracle's
`loadAround` order (`|Δ|`, then time ascending).
-}
nearestRowId : Int -> List VaultRow -> Maybe String
nearestRowId anchor rows =
    List.sortBy (\row -> ( abs (row.at - anchor), row.at )) rows
        |> List.head
        |> Maybe.map .id


{-| Merge a time-travel window around an anchor moment. Fresh (unseen)
rows land oldest-first ahead of the live tail — every unseen row is
older history by the synchronous-persist invariant — and the nearest
row becomes the scroll landing. An empty window changes nothing except
the seen ledger, mirroring the oracle's early return. Channels the
client never joined stay untouched.
-}
mergeVaultAround : Model -> String -> Int -> List VaultRow -> Model
mergeVaultAround model target anchor rows =
    let
        key =
            String.toLower target

        seen =
            rememberVaultIds model rows
    in
    if List.isEmpty rows then
        seen

    else
        case Dict.get key seen.channels of
            Nothing ->
                seen

            Just channel ->
                let
                    fresh =
                        List.filter (\row -> not (List.member row.id model.vaultSeenIds)) rows

                    toChat index row =
                        normalizeActionRow
                        { id = index
                        , from = row.from
                        , body = row.body
                        , whisper = False
                        , audience = Nothing
                        , highlight = False
                        , outboxId = Nothing
                        , pending = False
                        , plaintext = Nothing
                        , at = row.at
                        , msgid = Nothing
                        , reactions = []
                        , edited = False
                        , deleted = row.deleted
                        , redacted = row.redacted
                        , replyTo = Maybe.map sanitizeReplyRef row.replyTo
                        , topic = ""
                        , msgType = row.rowType
                        }

                    freshChats =
                        List.indexedMap toChat fresh
                            |> List.reverse

                    merged =
                        List.indexedMap (\index chat -> { chat | id = index }) (channel.messages ++ freshChats)
                            |> List.take keepMessages

                    stored =
                        List.map .id rows
                            |> List.filterMap (rowSeq key)
                            |> List.maximum
                            |> Maybe.withDefault -1
                in
                updateChannel seen key
                    (\c -> { c | messages = merged })
                    |> (\m ->
                            { m
                                | messageSeq = max m.messageSeq (stored + 1)
                                , historyLanding = nearestRowId anchor rows
                            }
                       )



-- v3/nav


{-| Primary navigation select (`PrimaryNavigation` `onSelect`): Home
deselects the conversation (the shell's empty state), Rooms / Messages
pick the collection and toggle the mobile drawer, Calls toggles the
existing calls hub, You toggles the hub sheet. Every location choice
closes the hub. `update` reconciles the stored section afterwards.
-}
navSelect : Nav.Id -> Model -> ( Model, List Outbound )
navSelect id model =
    case id of
        Nav.You ->
            ( { model | youHubOpen = not model.youHubOpen }, [] )

        Nav.Home ->
            ( { model
                | navSection = Nav.Home
                , navDrawerOpen = False
                , youHubOpen = False
                , callsOpen = False
                , activeChannel = Nothing
                , searchOpen = False
                , showPinnedMessages = False
                , mediaIndexOpen = False
                , messageMenu = Nothing
                , reactionPicker = Nothing
              }
            , []
            )

        Nav.Calls ->
            updateCore ToggleCalls { model | youHubOpen = False, navDrawerOpen = False }

        _ ->
            ( { model
                | navSection = id
                , -- v3/ui-mobile-shell: with no conversation behind it the
                  -- collection page stays open (a second tap is not "back").
                  navDrawerOpen = model.activeChannel == Nothing || not (model.navSection == id && model.navDrawerOpen)
                , youHubOpen = False
                , callsOpen = False
              }
            , []
            )


{-| You hub entries (`YouSettings` / `YouHubNav`): the hub is already
closed; Account opens the account panel when signed in, otherwise the
guest-claim sheet ("Keep this name" — opened past a dismissed chip,
like the oracle's `openClaimWithoutDisconnect`); route entries push the
URL; Leave is the shell's existing disconnect.
-}
youHubGo : Nav.YouAction -> Model -> ( Model, List Outbound )
youHubGo action model =
    case ( action, Nav.youActionPath action ) of
        ( _, Just path ) ->
            ( model, [ PushUrl path ] )

        ( Nav.YouAccount, _ ) ->
            case model.accountName of
                Just _ ->
                    updateCore (SetAccountOpen True) model

                Nothing ->
                    if String.isEmpty (String.trim model.ourNick) then
                        ( model, [] )

                    else
                        ( { model | guestClaimOpen = True, guestClaimError = Nothing }, [] )

        ( Nav.YouLeave, _ ) ->
            updateCore SessionDisconnect model

        -- v3/prefs
        ( Nav.YouPreferences, _ ) ->
            prefsOpen model

        _ ->
            ( model, [] )

-- v3/composer


{-| Inputs for the composer assist layer: the draft, oper status
(oper verbs hidden otherwise), the active conversation's nick
candidates, and the slash registry.
-}
composerAssistInputs : Model -> ComposerAssist.Inputs { kind : SlashCommandKind, usage : String, description : String }
composerAssistInputs model =
    { draft = model.composer
    , isOper = model.isOper
    , nicks = composerNickCandidates model
    , commands = slashCommands
    }


{-| Nick completion candidates (mirroring the composer
`nickCandidates`: a room's roster, or the DM peer plus self).
-}
composerNickCandidates : Model -> List String
composerNickCandidates model =
    case model.activeChannel of
        Nothing ->
            []

        Just target ->
            if isChannelName model target then
                case Dict.get (String.toLower target) model.channels of
                    Just channel ->
                        Dict.values channel.members
                            |> List.map .nick
                            |> List.filter (not << String.isEmpty)

                    Nothing ->
                        []

            else
                List.filter (not << String.isEmpty) [ target, model.ourNick ]


{-| Write the composer draft for the active conversation without the
typing side effects of `ComposerInput`.
-}
setComposerDraft : Model -> String -> Model
setComposerDraft model draft =
    case model.activeChannel of
        Nothing ->
            { model | composer = draft, composerError = Nothing }

        Just current ->
            { model
                | composer = draft
                , composerError = Nothing
                , composerDrafts = Dict.insert (String.toLower current) draft model.composerDrafts
            }



-- v3/switcher


{-| Palette rows for the current model: joined rooms, DMs, actions. -}
paletteEntries : Model -> List Switcher.Entry
paletteEntries model =
    -- v3/gap-commands: People, the oracle action rows and the query grammar
    Switcher.build (isChannelName model) (paletteContext model) model.palette.query (Dict.values model.channels) (palettePeople model)


{-| Ranked palette rows in display (= navigation) order. -}
paletteMatches : Model -> List Switcher.Matched
paletteMatches model =
    Switcher.matchesWith (paletteRecents model) model.palette.query (paletteEntries model)


{-| Global shell keys only act inside the connected app shell (never on
public pages or behind the connect gate). -}
shellKeysLive : Model -> Bool
shellKeysLive model =
    model.route == Route.App && not (connectGateVisible model)


{-| Palette + shortcuts overlay transitions. The overlay stack is model
state, so Escape is pure: it closes the shortcuts overlay first, then
the palette, and is a no-op with neither open. Running a row closes the
palette and re-enters `updateCore` with the existing intent.
-}
switcherUpdate : Msg -> Model -> ( Model, List Outbound )
switcherUpdate msg model =
    let
        palette =
            model.palette

        count =
            List.length (paletteMatches model)

        open m =
            if shellKeysLive m then
                ( { m | palette = { open = True, query = "", active = 0 }, shortcutsOpen = False }, [] )

            else
                ( m, [] )

        closePalette m =
            { m | palette = Switcher.closed }
    in
    case msg of
        PaletteOpen ->
            open model

        PaletteClose ->
            ( closePalette model, [] )

        PaletteInput query ->
            ( { model | palette = { palette | query = query, active = 0 } }, [] )

        PaletteMove delta ->
            ( { model | palette = { palette | active = Switcher.move delta count (Switcher.clampActive count palette.active) } }, [] )

        PaletteHover index ->
            ( { model | palette = { palette | active = Switcher.clampActive count index } }, [] )

        PaletteRun index ->
            runPaletteEntry index model

        PaletteSubmit ->
            runPaletteEntry (Switcher.clampActive count palette.active) model

        ShortcutsOpen ->
            if shellKeysLive model then
                ( { model | shortcutsOpen = True, palette = Switcher.closed }, [] )

            else
                ( model, [] )

        ShortcutsClose ->
            ( { model | shortcutsOpen = False }, [] )

        ShortcutPressed shortcut ->
            case shortcut of
                Switcher.TogglePalette ->
                    if palette.open then
                        ( closePalette model, [] )

                    else
                        open model

                Switcher.OpenPalette ->
                    if palette.open then
                        ( model, [] )

                    else
                        open model

                Switcher.ShowShortcuts ->
                    switcherUpdate ShortcutsOpen model

                Switcher.Dismiss ->
                    -- v3/frame: the ONE Escape — close the topmost
                    -- overlay from `overlayStack`, else the nav menu.
                    case escapeMsg model of
                        Just close ->
                            updateCore close model

                        Nothing ->
                            updateCore NavMenuEscape model

                -- v3/calls-c11 (C12): call chords
                Switcher.CallChord name ->
                    callChord name model

                -- v3/gap-commands: the shell chords act only in the app
                -- shell, never under the palette or the shortcuts sheet.
                Switcher.AppChord chord ->
                    if shellKeysLive model && not palette.open && not model.shortcutsOpen && not model.commandsHelpOpen then
                        runAppChord chord model

                    else
                        ( model, [] )

                Switcher.SingleKeys enabled ->
                    ( { model | singleKeyShortcuts = enabled }, [] )

                Switcher.UnknownShortcut ->
                    ( model, [] )

        _ ->
            ( model, [] )


runPaletteEntry : Int -> Model -> ( Model, List Outbound )
runPaletteEntry index model =
    case List.head (List.drop index (paletteMatches model)) of
        Nothing ->
            ( model, [] )

        Just matched ->
            let
                -- v3/gap-commands: the run row joins the owner's recents.
                ( shut, recentOut ) =
                    recordPaletteRecent matched.entry { model | palette = Switcher.closed }
            in
            Tuple.mapSecond ((++) recentOut) <|
            case matched.entry.target of
                Switcher.GoRoom name ->
                    updateCore (ChannelSelect name) shut

                Switcher.GoDm name ->
                    updateCore (ChannelSelect name) shut

                Switcher.Do Switcher.BrowseRooms ->
                    updateCore BrowserOpen shut

                Switcher.Do Switcher.StartRoom ->
                    updateCore CreateRoomOpen shut

                Switcher.Do Switcher.NewConversation ->
                    updateCore NewMessageOpen shut

                Switcher.Do Switcher.JumpToDate ->
                    updateCore JumpToDateOpen shut

                Switcher.Do Switcher.Notifications ->
                    updateCore NotifySheetOpen shut

                Switcher.Do Switcher.Appearance ->
                    youHubGo Nav.YouAppearance shut

                Switcher.Do Switcher.YouHub ->
                    ( { shut | youHubOpen = True }, [] )

                Switcher.Do Switcher.KeyboardShortcuts ->
                    ( { shut | shortcutsOpen = True }, [] )

                Switcher.Do Switcher.Leave ->
                    updateCore SessionDisconnect shut

                other ->
                    runGapPaletteTarget other shut

-- v3/gap-commands — the palette, the shell chords, the commands sheet


{-| Everything the palette knows about the shell. -}
paletteContext : Model -> Switcher.Context
paletteContext model =
    let
        active =
            model.activeChannel

        activeIsRoom =
            Maybe.map (isChannelName model) active |> Maybe.withDefault False
    in
    { active = active
    , activeIsRoom = activeIsRoom
    , live = model.connection == Live
    , starred = Maybe.map (isStarredRoom model) active |> Maybe.withDefault False
    , muted = Maybe.map (\name -> notifyLevel model name == "none") active |> Maybe.withDefault False
    , dnd = notifyDndActive model
    , away = model.userStatus /= StatusOnline
    , compact = model.prefs.transcriptDensity == Prefs.TranscriptCompact
    , call =
        if model.calls.lifecycle /= Media.Idle then
            model.calls.channel

        else
            Nothing
    , voice = activeIsRoom && model.prefs.voiceEntry
    , node = Maybe.withDefault "" model.endpoint
    , themes = List.map (\meta -> { id = meta.id, label = meta.label }) ThemeLook.themeMeta
    , theme = model.themeId
    }


isStarredRoom : Model -> String -> Bool
isStarredRoom model name =
    Set.member (String.toLower name) model.starredChannels || Set.member name model.starredChannels


{-| People the palette offers (mirroring the oracle `peopleCommands`:
members of the open room without a DM row yet), then contacts. -}
palettePeople : Model -> List Switcher.Person
palettePeople model =
    let
        dmKeys =
            Dict.values model.channels
                |> List.filter (\c -> not (isChannelName model c.name))
                |> List.map (\c -> String.toLower c.name)
                |> Set.fromList

        self =
            String.toLower model.ourNick

        eligible nick =
            let
                key =
                    String.toLower nick
            in
            not (String.isEmpty key) && key /= self && not (Set.member key dmKeys)

        members =
            case model.activeChannel |> Maybe.andThen (\name -> Dict.get (String.toLower name) model.channels) of
                Just room ->
                    if isChannelName model room.name then
                        Dict.values room.members
                            |> List.map .nick
                            |> List.filter eligible
                            |> List.sortBy String.toLower
                            |> List.take 200
                            |> List.map (\nick -> { nick = nick, hint = "In " ++ room.name })

                    else
                        []

                Nothing ->
                    []

        listed =
            Set.fromList (List.map (\p -> String.toLower p.nick) members)

        contacts =
            Dict.values model.friends
                |> List.filter (\f -> eligible f.nick && not (Set.member (String.toLower f.nick) listed))
                |> List.sortBy (\f -> String.toLower f.nick)
                |> List.take 100
                |> List.map
                    (\f ->
                        { nick = f.nick
                        , hint =
                            if f.online then
                                "Contact · online"

                            else
                                "Contact"
                        }
                    )
    in
    members ++ contacts


{-| Recents belong to the device-memory owner; ownerless sessions keep
them for the session only (key `""`, never persisted). -}
recentsOwnerKey : Model -> String
recentsOwnerKey model =
    case deviceMemoryOwner model of
        Just owner ->
            owner.serverUrl ++ "|" ++ owner.identity

        Nothing ->
            ""


paletteRecents : Model -> List String
paletteRecents model =
    Maybe.withDefault [] (Dict.get (recentsOwnerKey model) model.paletteRecentIds)


recordPaletteRecent : Switcher.Entry -> Model -> ( Model, List Outbound )
recordPaletteRecent entry model =
    case Switcher.recentId entry of
        Nothing ->
            ( model, [] )

        Just id ->
            let
                key =
                    recentsOwnerKey model

                next =
                    Switcher.recordRecent id (paletteRecents model)
            in
            ( { model | paletteRecentIds = Dict.insert key next model.paletteRecentIds }
            , if String.isEmpty key then
                []

              else
                [ PaletteRecentsSave { owner = key, ids = next } ]
            )


{-| Boot snapshot from `ports.js`: `{ recents: { owner: [ids] },
singleKeys: bool }`, validated fail-closed (at most 8 owners, 8 ids
each, bounded strings). -}
foldGapPrefs : Decode.Value -> Model -> Model
foldGapPrefs raw model =
    let
        idList =
            Decode.list Decode.string
                |> Decode.map (List.filter (\id -> not (String.isEmpty id) && String.length id <= 200) >> List.take 8)

        recents =
            Decode.decodeValue (Decode.field "recents" (Decode.keyValuePairs idList)) raw
                |> Result.withDefault []
                |> List.filter (\( owner, _ ) -> not (String.isEmpty owner) && String.length owner <= 600)
                |> List.take 8
                |> Dict.fromList

        singleKeys =
            Decode.decodeValue (Decode.field "singleKeys" Decode.bool) raw
                |> Result.withDefault model.singleKeyShortcuts
    in
    { model | paletteRecentIds = Dict.union model.paletteRecentIds recents, singleKeyShortcuts = singleKeys }


{-| A palette run or a shell chord runs a local verb without touching
the composer draft (the slash path clears it; these never came from
the composer). -}
runLocalVerb : Model -> String -> String -> Maybe String -> ( Model, List Outbound )
runLocalVerb model target verb arg =
    let
        ( ran, out ) =
            runSlashLocal model target verb arg
    in
    ( { ran | composer = model.composer }, out )


{-| Join a room by name (a joined room just opens; a new one opens on
the self-JOIN echo through the pending-join triple). -}
joinRoomByName : Model -> String -> Maybe String -> ( Model, List Outbound )
joinRoomByName model channel key =
    if Dict.member (String.toLower channel) model.channels then
        updateCore (ChannelSelect channel) model

    else if model.connection /= Live then
        ( model, [] )

    else
        ( { model | pendingDeepLinkJoin = Just channel }
        , [ SendLine (Wire.formatIrcLine "JOIN" (channel :: Maybe.withDefault [] (Maybe.map List.singleton key))) ]
        )


{-| Open (or start) a DM from the palette's People rows, mirroring New
conversation: a fresh peer gets its shell; blocked peers coach. -}
openPersonDm : String -> Model -> ( Model, List Outbound )
openPersonDm nick model =
    let
        shelled =
            if isBlockedDmTarget model nick || isChannelName model nick then
                model

            else
                case ensureDmShellCapacity model nick of
                    ( room, True ) ->
                        { room | channels = Dict.insert (String.toLower nick) (ensureChannel room nick) room.channels }

                    ( _, False ) ->
                        model
    in
    updateCore (MemberMessage nick) shelled


{-| Run the palette's v3/gap-commands targets (`shut` already has the
palette closed). -}
runGapPaletteTarget : Switcher.Target -> Model -> ( Model, List Outbound )
runGapPaletteTarget target shut =
    let
        activeTarget =
            Maybe.withDefault "" shut.activeChannel
    in
    case target of
        Switcher.GoPerson nick ->
            openPersonDm nick shut

        Switcher.ViewProfile nick ->
            requestWhois shut nick

        Switcher.Do (Switcher.JoinTyped room) ->
            joinRoomByName shut room Nothing

        Switcher.Do Switcher.Preferences ->
            updateCore PrefsOpen shut

        Switcher.Do Switcher.ThemeStudio ->
            youHubGo Nav.YouAppearance shut

        Switcher.Do Switcher.ScheduledMessages ->
            updateCore (SetShowScheduledMessages True) shut

        Switcher.Do Switcher.SlashCommands ->
            ( { shut | commandsHelpOpen = True, shortcutsOpen = False }, [] )

        Switcher.Do Switcher.SearchMessages ->
            updateCore SearchOpen shut

        Switcher.Do (Switcher.CopyRoomLink room) ->
            ( shut, [ ClipboardCopy { text = roomDeepLink shut room, tag = roomLinkTag ++ room } ] )

        Switcher.Do Switcher.CopyNodeAddress ->
            case shut.endpoint of
                Just node ->
                    ( shut, [ ClipboardCopy { text = node, tag = nodeAddressTag } ] )

                Nothing ->
                    ( shut, [] )

        Switcher.Do (Switcher.InvitePeople room) ->
            updateCore (InviteShareOpen room) shut

        Switcher.Do (Switcher.StartVoice room) ->
            updateCore (CallJoin { channel = room, video = False }) shut

        Switcher.Do Switcher.ReturnToCall ->
            case shut.calls.channel of
                Just room ->
                    updateCore (CallsReturnToCall room) shut

                Nothing ->
                    ( shut, [] )

        Switcher.Do Switcher.MarkAllRead ->
            updateCore HomeMarkAllCaughtUp shut

        Switcher.Do (Switcher.MarkRead name) ->
            runLocalVerb shut name "read" Nothing

        Switcher.Do (Switcher.CatchUp name) ->
            updateCore (ChannelSelect name) shut

        Switcher.Do (Switcher.LeaveRoom room) ->
            if shut.connection == Live then
                ( gapToast ToastInfo ("Leaving " ++ room) "" shut, [ SendLine (Wire.formatIrcLine "PART" [ room ]) ] )

            else
                ( shut, [] )

        Switcher.Do (Switcher.ToggleStar room) ->
            runLocalVerb shut
                room
                (if isStarredRoom shut room then
                    "unstar"

                 else
                    "star"
                )
                Nothing

        Switcher.Do (Switcher.ToggleMute room) ->
            runLocalVerb shut
                room
                (if notifyLevel shut room == "none" then
                    "unmute"

                 else
                    "mute"
                )
                Nothing

        Switcher.Do Switcher.ToggleDnd ->
            updateCore NotifyDndToggle shut

        Switcher.Do (Switcher.PauseAlerts minutes) ->
            runLocalVerb shut activeTarget "snooze" (Just (String.fromInt minutes))

        Switcher.Do Switcher.ToggleAway ->
            toggleAway shut

        Switcher.Do Switcher.ToggleDensity ->
            updateCore
                (AppearanceSetPref
                    { key = "transcriptDensity"
                    , value =
                        if shut.prefs.transcriptDensity == Prefs.TranscriptCompact then
                            "grouped"

                        else
                            "irc"
                    }
                )
                shut

        Switcher.Do (Switcher.SwitchTheme id) ->
            updateCore (AppearanceSetTheme { id = id }) shut

        _ ->
            ( shut, [] )


toggleAway : Model -> ( Model, List Outbound )
toggleAway model =
    if model.userStatus == StatusOnline then
        setUserStatus model StatusIdle
            |> Tuple.mapFirst (gapToast ToastInfo "You're away" "Others see you as away.")

    else
        setUserStatus model StatusOnline
            |> Tuple.mapFirst (gapToast ToastInfo "You're back" "Your away status is cleared.")


{-| One shell chord (the oracle `shortcutsRegistry` handlers). -}
runAppChord : Switcher.AppChord -> Model -> ( Model, List Outbound )
runAppChord chord model =
    let
        order =
            Switcher.conversationOrder (isChannelName model) (isStarredRoom model) (Dict.values model.channels)

        active =
            model.activeChannel

        withActive run =
            case active of
                Just target ->
                    run target

                Nothing ->
                    ( model, [] )

        withRoom run =
            withActive
                (\target ->
                    if isChannelName model target then
                        run target

                    else
                        ( model, [] )
                )

        isUnread name =
            case Dict.get (String.toLower name) model.channels of
                Just c ->
                    c.unread > 0 || c.highlights > 0

                Nothing ->
                    False
    in
    case chord of
        Switcher.ConversationStep delta ->
            case Switcher.stepConversation delta active order of
                Just name ->
                    updateCore (ChannelSelect name) model

                Nothing ->
                    ( model, [] )

        Switcher.UnreadStep delta ->
            case Switcher.stepUnread delta active order isUnread of
                Just name ->
                    updateCore (ChannelSelect name) model

                Nothing ->
                    ( gapToast ToastInfo "All caught up" "No other conversation has unread messages." model, [] )

        Switcher.GoHome ->
            updateCore (NavSelect Nav.Home) model

        Switcher.GoJumpToDate ->
            withActive (\_ -> updateCore JumpToDateOpen model)

        Switcher.OpenPreferences ->
            updateCore PrefsOpen model

        Switcher.OpenAccount ->
            updateCore (SetAccountOpen True) model

        Switcher.MarkConversationRead ->
            withActive (\target -> runLocalVerb model target "read" Nothing)

        Switcher.ToggleDndChord ->
            updateCore NotifyDndToggle model

        Switcher.ToggleRoomMute ->
            withRoom
                (\room ->
                    runLocalVerb model
                        room
                        (if notifyLevel model room == "none" then
                            "unmute"

                         else
                            "mute"
                        )
                        Nothing
                )

        Switcher.ToggleRoomStar ->
            withRoom
                (\room ->
                    runLocalVerb model
                        room
                        (if isStarredRoom model room then
                            "unstar"

                         else
                            "star"
                        )
                        Nothing
                )

        Switcher.AttachFiles ->
            -- The composer's own gates: protected DMs take no uploads.
            withActive
                (\target ->
                    if dmDesignated model target then
                        ( { model | composerError = Just dmAttachmentBlocked }, [] )

                    else
                        updateCore AttachPick model
                )

        Switcher.ScheduleSend ->
            -- The tools tray's gate: a draft to schedule, no edit, no files.
            withActive
                (\_ ->
                    let
                        gate =
                            polishScheduleGate model
                    in
                    if Schedule.canScheduleComposer gate then
                        updateCore ScheduleOpen model

                    else
                        ( gapToast ToastInfo "Send later" (Maybe.withDefault "" (Schedule.scheduleComposerRefusal gate)) model, [] )
                )

        Switcher.ExportTranscript ->
            withActive (\target -> runLocalVerb model target "export" (Just "txt"))

        Switcher.FollowToggle ->
            withActive
                (\target ->
                    let
                        topic =
                            if isChannelName model target then
                                activeChannelTopic model target

                            else
                                Nothing

                        following =
                            Set.member (followKey target topic) model.followed

                        ( next, out ) =
                            if following then
                                updateCore (UnfollowConversation { target = target, topic = topic }) model

                            else
                                updateCore (FollowConversation { target = target, topic = topic }) model
                    in
                    ( gapToast ToastInfo
                        (if following then
                            "Unfollowed " ++ target

                         else
                            "Following " ++ target
                        )
                        (if following then
                            "You'll only hear about mentions here."

                         else
                            "New messages here land in your inbox."
                        )
                        next
                    , out
                    )
                )


{-| `v3/gap-commands` updates (the commands sheet, the single-key
preference, the boot snapshot). -}
gapCommandsUpdate : Msg -> Model -> ( Model, List Outbound )
gapCommandsUpdate msg model =
    case msg of
        CommandsHelpOpen ->
            if shellKeysLive model then
                ( { model | commandsHelpOpen = True, palette = Switcher.closed, shortcutsOpen = False }, [] )

            else
                ( model, [] )

        CommandsHelpClose ->
            ( { model | commandsHelpOpen = False }, [] )

        CommandsHelpInsert verb ->
            case model.activeChannel of
                Just _ ->
                    ( { model | commandsHelpOpen = False, composer = "/" ++ verb ++ " ", composerError = Nothing }, [] )

                Nothing ->
                    ( { model | commandsHelpOpen = False }, [] )

        SingleKeysToggle ->
            let
                next =
                    not model.singleKeyShortcuts
            in
            ( { model | singleKeyShortcuts = next }, [ SingleKeysSave { enabled = next } ] )

        GapPrefsLoaded raw ->
            ( foldGapPrefs raw model, [] )

        _ ->
            ( model, [] )


{-| Clipboard receipts for the room link (`/share`, the palette) and
the node address. -}
settleStepGapCommands : Msg -> Model -> ( Model, List Outbound ) -> ( Model, List Outbound )
settleStepGapCommands msg _ ( m, outs ) =
    case msg of
        ClipboardResult { tag, ok } ->
            if String.startsWith roomLinkTag tag then
                ( gapToast
                    (if ok then
                        ToastSuccess

                     else
                        ToastWarning
                    )
                    (if ok then
                        "Room link copied"

                     else
                        "Copy failed"
                    )
                    (if ok then
                        roomDeepLink m (String.dropLeft (String.length roomLinkTag) tag)

                     else
                        "Could not write the invite link to the clipboard."
                    )
                    m
                , outs
                )

            else if tag == nodeAddressTag then
                ( gapToast
                    (if ok then
                        ToastSuccess

                     else
                        ToastWarning
                    )
                    (if ok then
                        "Node address copied"

                     else
                        "Copy failed"
                    )
                    (if ok then
                        Maybe.withDefault "" m.endpoint

                     else
                        "Could not write the node address to the clipboard."
                    )
                    m
                , outs
                )

            else
                ( m, outs )

        _ ->
            ( m, outs )


{-| The slash commands sheet (`/help`): every verb that works, grouped,
registry order inside each group; operator verbs only for operators. -}
slashHelpGroups : Bool -> List ( String, List SlashCommand )
slashHelpGroups oper =
    let
        named names =
            List.filterMap (\name -> List.head (List.filter (\c -> c.name == name) slashCommands)) names
    in
    [ ( "Messages", named [ "me", "msg", "notice", "ctcp", "ping" ] )
    , ( "Rooms", named [ "join", "part", "topic", "invite", "share", "kick", "ban", "unban", "op", "deop", "voice", "devoice", "mode", "modex", "stage", "event", "webhook" ] )
    , ( "You", named [ "nick", "away", "back", "whois", "ignore", "unignore", "highlight", "unhighlight", "snooze", "dnd" ] )
    , ( "This device", named [ "read", "star", "unstar", "mute", "unmute", "notify", "autojoin", "unautojoin", "color", "clear", "search", "history", "export", "import", "help" ] )
    , ( "Text", named [ "shrug", "tableflip", "unflip", "lenny", "disapprove" ] )
    , ( "Advanced", named [ "quote" ] )
    ]
        ++ (if oper then
                [ ( "Operators", named [ "broadcast", "kill", "rehash", "privs", "events", "observe" ] ) ]

            else
                []
           )


-- v3/frame


{-| Every open overlay, topmost first, with the message that closes it.
This ordered list is the single source of truth for Escape: the global
`shortcut` port's Escape (`Switcher.Dismiss`) closes the head of it.
Sheets that own focus also close themselves on Escape and
`preventDefault`, so `ports.js` never forwards that same key press and
a single Escape never closes two layers.

Order follows stacking: transient chrome over the media lightbox over
the palette layer, then confirmation dialogs over the sheets that
spawned them, then sheets, then drawers/panels and finally inline
chrome (room menu, search, the composer schedule picker).

-}
overlayStack : Model -> List ( String, Msg )
overlayStack model =
    List.filterMap
        (\( key, open, close ) ->
            if open then
                Just ( key, close )

            else
                Nothing
        )
        [ -- v3/calls-c6: a DM ring is modal over everything; Escape
          -- declines / cancels (spec §2.9)
          ( "call-ring-in", model.calls.lifecycle == Media.RingingIn, CallDecline )
        , ( "call-ring-out", model.calls.lifecycle == Media.RingingOut, CallCancel )
        , ( "media-lightbox", model.mediaLightbox /= Nothing, MediaLightboxClose )
        , ( "blockkit", BlockKit.isOpen model.blockKit, BlockKitMsg BlockKit.Escape ) -- v3/gap-import
        , ( "shortcuts", model.shortcutsOpen, ShortcutsClose )
        -- v3/gap-commands
        , ( "commands-help", model.commandsHelpOpen, CommandsHelpClose )
        , ( "palette", model.palette.open, PaletteClose )
        , ( "reaction-picker", model.reactionPicker /= Nothing, ReactionPickerClose )
        , ( "message-menu", model.messageMenu /= Nothing, MessageMenuClose )
        , ( "person-safety", model.personSafety /= Nothing, SafetyClose )
        , ( "moderation-review", model.moderationDraft /= Nothing, ModerationCancel )
        -- v3/calls-c8: the voice settings sheet and the React menu
        , ( "voice-settings", model.voiceSettings.open, VoiceSettingsMsg VoiceSettings.Close )
        , ( "call-privacy", model.callPrivacyOpen, CallPrivacyClose )
        , ( "call-react", model.callOverlay.reactOpen, CallReactClose )
        , ( "call-more", model.callMoreOpen, CallMoreClose )
        -- v3/calls-c4: Escape returns a fullscreen stage to compact.
        , ( "call-fullscreen", model.callStageSize == CallMedia.SizeFullscreen && model.calls.lifecycle /= Media.Idle, CallStageSizeSet CallMedia.SizeCompact )
        -- v3/calls-c11
        , ( "call-leave-confirm", model.callLeaveConfirm && model.calls.lifecycle /= Media.Idle, CallLeaveConfirmClose )
        , ( "stage-hands", stageHandsSheetOpen model, StageHandsClose )
        , ( "reclaim", model.reclaimOpen, ReclaimClose )
        -- v3/gap-shell
        , ( "leave-room", model.gapShell.leaveAsk /= Nothing, GapShellMsg GapShell.LeaveCancel )
        , ( "activity", model.gapShell.activityOpen, GapShellMsg GapShell.ActivityClose )
        , ( "room-invite-share", model.inviteShare /= Nothing, InviteShareClose )
        , ( "new-message", model.newMessageOpen, NewMessageClose )
        , ( "oper-sheet", model.operDeskOpen, OperDeskClose )
        , ( "moderation-cockpit", model.moderationOpen, ModerationSheetClose )
        -- v3/gap-organize: folder picker, row menu, saved messages
        , ( "organize", Organizer.sheetOpen model.organize, OrganizeMsg Organizer.SheetClose )
        , ( "member-card", model.userProfileCard /= Nothing, UserProfileClosed )
        -- v3/roomsettings
        , ( "room-settings", RoomSettings.isOpenFor model.activeChannel model.roomSettings, RoomSettingsMsg RoomSettings.Close )
        , ( "profile", model.whoisTarget /= Nothing, WhoisClose )
        , ( "jump-to-date", model.showJumpToDate, JumpToDateClose )
        , ( "media", model.mediaIndexOpen, MediaIndexClose )
        , ( "pins", model.showPinnedMessages, PinnedMessagesClose )
        , ( "prefs", model.prefsOpen, PrefsClose )
        , ( "notify", model.notifySheetOpen, NotifySheetClose )
        -- v3/account2
        , ( "theme-share", model.themeShareOpen, ThemeShareClose )
        , ( "people", model.peopleOpen, PeopleClose )
        , ( "account", model.accountOpen, SetAccountOpen False )
        , ( "scheduled", model.showScheduledMessages, SetShowScheduledMessages False )
        , ( "browse-rooms", model.browserOpen, BrowserClose )
        , ( "guest-claim", model.guestClaimOpen, GuestClaimClose )
        -- v3/polish: the quiet asks
        , ( "first-run-notify", firstRunNotifyOffered model, PolishMsg Polish.NotifyDismiss )
        , ( "a2hs", a2hsOffered model, PolishMsg Polish.A2hsDismiss )
        , ( "steward", model.stewardRoom /= Nothing, StewardClose )
        , ( "you", model.youHubOpen, YouHubClose )
        , ( "inbox", model.showNotificationCenter, NotificationCenterClosed )
        -- v3/gap-usermodes
        , ( "offline-messages", model.userModes.memoOpen, UserModesMsg UserModes.MemoClose )
        , ( "thread", model.threadPanel /= Nothing, ThreadClose )
        , ( "dm-safety", model.dmSafety.openFor /= Nothing, DmSafetyClose )
        , ( "room-menu", model.roomMenuOpen, RoomMenuClose )
        , ( "search", model.searchOpen, SearchClose )
        -- v3/polish
        , ( "time-scrubber", model.polish.scrubber.open && polishScrubberRoom model /= Nothing, PolishMsg Polish.ScrubberClose )
        , ( "composer-tools", model.polish.toolsOpen, PolishMsg Polish.ToolsClose )
        , ( "schedule", model.scheduleOpen, ScheduleClose )
        -- v3/gap-watch: the start editor sheet, then the inline end confirmation
        , ( "watch-start", model.watch.editor /= Nothing, WatchMsg WatchTogether.EditorClose )
        , ( "watch-end-confirm", model.watch.endConfirm /= Nothing, WatchMsg WatchTogether.CancelEnd )
        ]


{-| The room header's More menu is a disclosure: running one of its
actions, opening any sheet from it, or leaving the room closes it.
-}
settleRoomMenu : Msg -> Model -> Model -> Model
settleRoomMenu msg before after =
    if not after.roomMenuOpen then
        after

    else if before.activeChannel /= after.activeChannel then
        { after | roomMenuOpen = False }

    else
        case msg of
            PinnedMessagesOpen ->
                { after | roomMenuOpen = False }

            MediaIndexOpen ->
                { after | roomMenuOpen = False }

            JumpToDateOpen ->
                { after | roomMenuOpen = False }

            ModerationSheetOpen ->
                { after | roomMenuOpen = False }

            SearchOpen ->
                { after | roomMenuOpen = False }

            InviteShareOpen _ ->
                { after | roomMenuOpen = False }

            -- v3/roomsettings
            RoomSettingsMsg RoomSettings.Open ->
                { after | roomMenuOpen = False }

            _ ->
                after


{-| The message one Escape sends: close the topmost open overlay. -}
escapeMsg : Model -> Maybe Msg
escapeMsg model =
    List.head (overlayStack model) |> Maybe.map Tuple.second



-- v3/prefs


{-| Open the device Preferences sheet and refresh the durable outbox
mirror so `Queued sends` reflects storage, not only the last flush.
-}
prefsOpen : Model -> ( Model, List Outbound )
prefsOpen model =
    ( { model | prefsOpen = True, prefsResetAnnouncement = "" }
    , [ OutboxReview { discard = [], tag = "refresh" } ]
    )


{-| Closing disarms every staged confirmation (mirroring the oracle's
unmount retiring its operation epochs).
-}
prefsClose : Model -> Model
prefsClose model =
    { model
        | prefsOpen = False
        , prefsOutboxConfirm = Nothing
        , prefsOutboxStatus = Nothing
        , prefsDraftsConfirm = Nothing
        , prefsDraftsStatus = Nothing
        , prefsTransferStatus = Nothing
    }


{-| Current value of a boolean preference the sheet toggles. -}
prefsBoolValue : String -> Prefs.Preferences -> Maybe Bool
prefsBoolValue key prefs =
    case key of
        "hideEvents" ->
            Just prefs.hideEvents

        "reduceMotion" ->
            Just prefs.reduceMotion

        "reduceTransparency" ->
            Just prefs.reduceTransparency

        "highContrast" ->
            Just prefs.highContrast

        "readerMode" ->
            Just prefs.readerMode

        -- v3/gap-watch
        "watchTogether" ->
            Just prefs.watchTogether

        _ ->
            Nothing


{-| Flip one boolean preference through the shared `AppearanceSetPref`
fold, so storage + DOM application stay in one place.
-}
prefsTogglePref : String -> Model -> ( Model, List Outbound )
prefsTogglePref key model =
    case prefsBoolValue key model.prefs of
        Just current ->
            updateCore
                (AppearanceSetPref
                    { key = key
                    , value =
                        if current then
                            "false"

                        else
                            "true"
                    }
                )
                model

        Nothing ->
            ( model, [] )


{-| `Background motion` segmented control (mirroring `setSceneMotion`;
unknown ids keep the current motion).
-}
prefsSetSceneMotion : String -> Model -> ( Model, List Outbound )
prefsSetSceneMotion raw model =
    case Prefs.parseSceneMotion raw of
        Just next ->
            if next == model.sceneMotion then
                ( model, [] )

            else
                let
                    updated =
                        { model | sceneMotion = next }
                in
                ( updated
                , [ AppearanceStoreSceneMotion { value = Prefs.sceneMotionToString next }
                  , appearanceApplyFor updated
                  ]
                )

        Nothing ->
            ( model, [] )


{-| `Reset to defaults` (mirroring `resetAllPreferences`: preferences
and scene motion return to their defaults). The announcement alternates
a trailing no-break space so a repeated reset re-announces.
-}
prefsReset : Model -> ( Model, List Outbound )
prefsReset model =
    let
        base =
            "Preferences reset to defaults."

        updated =
            { model
                | prefs = Prefs.defaultPreferences
                , sceneMotion = Prefs.SceneAdaptive
                , prefsResetAnnouncement =
                    if model.prefsResetAnnouncement == base then
                        base ++ "\u{00A0}"

                    else
                        base
            }
    in
    ( updated
    , [ AppearanceStorePrefs { json = Prefs.encodePreferences Prefs.defaultPreferences }
      , AppearanceStoreSceneMotion { value = Prefs.sceneMotionToString Prefs.SceneAdaptive }
      , appearanceApplyFor updated
      ]
    )


{-| `Discard all queued sends` re-checks the staged count first
(mirroring `confirmDiscard`: a drifted count re-stages and asks again;
nothing is deleted until the counts agree).
-}
prefsOutboxDiscardConfirm : Model -> ( Model, List Outbound )
prefsOutboxDiscardConfirm model =
    case model.prefsOutboxConfirm of
        Nothing ->
            ( model, [] )

        Just staged ->
            let
                current =
                    List.length model.outbox
            in
            if model.prefsOutboxBusy then
                ( model, [] )

            else if current /= staged then
                ( { model
                    | prefsOutboxConfirm = Just current
                    , prefsOutboxStatus = Just { message = PrefsPanel.queuedCountChangedCopy current, failure = False }
                  }
                , []
                )

            else
                ( { model | prefsOutboxBusy = True, prefsOutboxStatus = Nothing }
                , [ OutboxReview { discard = List.map .id model.outbox, tag = "all" } ]
                )


{-| Fold a ports-side outbox review. `rows` is the storage truth of
still-unsent rows; removed ids also drop their thread placeholders and
uncertain marks. `tag` says which request this settles: `refresh`
(listing only), `one` (per-row remove), or `all` (confirmed discard —
reported only once storage reads back empty).
-}
prefsOutboxReviewed : { removed : List String, rows : List OutboxEntry, ok : Bool, tag : String } -> Model -> ( Model, List Outbound )
prefsOutboxReviewed { removed, rows, ok, tag } model =
    let
        keepPlaceholder message =
            case message.outboxId of
                Just oid ->
                    not (List.member oid removed)

                Nothing ->
                    True

        settled =
            { model
                | channels =
                    if List.isEmpty removed then
                        model.channels

                    else
                        Dict.map (\_ c -> { c | messages = List.filter keepPlaceholder c.messages }) model.channels
                , outbox =
                    if ok then
                        rows

                    else
                        List.filter (\row -> not (List.member row.id removed)) model.outbox
                , outboxUncertain = List.filter (\id -> not (List.member id removed)) model.outboxUncertain
            }
    in
    case tag of
        "all" ->
            if ok && List.isEmpty rows then
                ( { settled
                    | prefsOutboxBusy = False
                    , prefsOutboxConfirm = Nothing
                    , prefsOutboxStatus = Just { message = PrefsPanel.discardedQueuedCopy (List.length removed), failure = False }
                  }
                , [ PrefsFocus { id = "pref-discard-queued-trigger" } ]
                )

            else if ok then
                ( { settled
                    | prefsOutboxBusy = False
                    , prefsOutboxConfirm = Just (List.length rows)
                    , prefsOutboxStatus = Just { message = PrefsPanel.queuedCountChangedCopy (List.length rows), failure = False }
                  }
                , []
                )

            else
                ( { settled
                    | prefsOutboxBusy = False
                    , prefsOutboxStatus = Just { message = PrefsPanel.queuedDiscardFailedCopy, failure = True }
                  }
                , []
                )

        "one" ->
            ( { settled
                | prefsOutboxBusy = False
                , prefsOutboxConfirm = Nothing
                , prefsOutboxStatus =
                    if ok && not (List.isEmpty removed) then
                        Just { message = PrefsPanel.discardedQueuedCopy (List.length removed), failure = False }

                    else
                        Just { message = "Could not verify that the queued send was discarded. It may still be on this device.", failure = True }
              }
            , []
            )

        _ ->
            ( settled, [] )


{-| Room drafts on this device: stashed per-target drafts plus the live
composer when the open conversation is a room.
-}
prefsRoomDrafts : Model -> List ( String, String )
prefsRoomDrafts model =
    PrefsPanel.roomDrafts
        (Maybe.map (\target -> ( target, model.composer )) model.activeChannel)
        model.composerDrafts


{-| Drop the given room drafts (lower-cased targets); clears the live
composer when the open room is among them. DM drafts are never touched.
-}
prefsDiscardDrafts : List String -> Model -> Model
prefsDiscardDrafts targets model =
    let
        keys =
            targets
                |> List.map String.toLower
                |> List.filter PrefsPanel.isRoomDraftTarget

        activeHit =
            case model.activeChannel of
                Just active ->
                    List.member (String.toLower active) keys

                Nothing ->
                    False

        removed =
            List.length (List.filter (\( target, _ ) -> List.member target keys) (prefsRoomDrafts model))
    in
    { model
        | composerDrafts = List.foldl Dict.remove model.composerDrafts keys
        , composer =
            if activeHit then
                ""

            else
                model.composer
        , prefsDraftsConfirm = Nothing
        , prefsDraftsStatus =
            if removed > 0 then
                Just { message = PrefsPanel.roomDraftsDiscardedCopy removed, failure = False }

            else
                model.prefsDraftsStatus
    }


{-| `Discard room drafts` confirm, with the same count re-check as the
queued-send card.
-}
prefsDraftsDiscardConfirm : Model -> ( Model, List Outbound )
prefsDraftsDiscardConfirm model =
    case model.prefsDraftsConfirm of
        Nothing ->
            ( model, [] )

        Just staged ->
            let
                drafts =
                    prefsRoomDrafts model

                current =
                    List.length drafts
            in
            if current /= staged then
                ( { model
                    | prefsDraftsConfirm = Just current
                    , prefsDraftsStatus = Just { message = "Local draft count changed to " ++ String.fromInt current ++ ". Review the updated count and confirm again.", failure = False }
                  }
                , []
                )

            else
                ( prefsDiscardDrafts (List.map Tuple.first drafts) model
                , [ PrefsFocus { id = "pref-discard-drafts-trigger" } ]
                )



-- v3/account2


{-| Add a friend (`friend = True`) or a WATCH entry from the People
sheet draft. The verbs (`requestFriendAdd` / `requestWatchAdd`) stay
the only writers; this wrapper only explains a refusal the verbs keep
silent (no owner, bad name, duplicate, full list) and clears the draft
on success.
-}
peopleAdd : Bool -> Model -> ( Model, List Outbound )
peopleAdd friend model =
    let
        draft =
            if friend then
                model.peopleFriendDraft

            else
                model.peopleWatchDraft

        notice copy =
            ( { model | peopleNotice = Just copy }, [] )
    in
    case ( deviceMemoryOwner model, normalizeContactNick draft ) of
        ( Nothing, _ ) ->
            notice "Connect first to keep a list of people."

        ( _, Nothing ) ->
            notice "Enter a valid name."

        ( Just _, Just clean ) ->
            let
                key =
                    String.toLower clean
            in
            if friend && Dict.member key model.friends then
                notice (clean ++ " is already a friend.")

            else if not friend && List.any (\entry -> String.toLower entry.nick == key) model.watchList then
                notice (clean ++ " is already on your watch list.")

            else if friend && Dict.size model.friends >= maxContacts then
                notice "Your friends list is full."

            else if not friend && List.length model.watchList >= maxContacts then
                notice "Your watch list is full."

            else if friend then
                let
                    ( next, out ) =
                        requestFriendAdd model clean
                in
                ( { next | peopleFriendDraft = "", peopleNotice = Nothing }, out )

            else
                let
                    ( next, out ) =
                        requestWatchAdd model clean
                in
                ( { next | peopleWatchDraft = "", peopleNotice = Nothing }, out )


{-| Save (or clear, with "") our custom status plus the chosen expiry.
The expiry lands first so the status write persists both together;
clearing the status also clears its expiry.
-}
statusSave : String -> Model -> ( Model, List Outbound )
statusSave draft model =
    case ( normalizeCustomStatus draft, deviceMemoryOwner model ) of
        ( Nothing, _ ) ->
            ( { model | statusError = Just ("Keep it under " ++ String.fromInt maxCustomStatusLength ++ " characters, on one line.") }, [] )

        ( _, Nothing ) ->
            ( { model | statusError = Just "Connect first to set a status." }, [] )

        ( Just clean, Just _ ) ->
            let
                expiry =
                    if String.isEmpty clean then
                        Nothing

                    else
                        Account2.expiryFor model.statusExpiryChoice model.nowMs

                ( withExpiry, expiryOut ) =
                    setCustomStatusExpiry model expiry

                ( withStatus, statusOut ) =
                    setCustomStatus withExpiry clean
            in
            ( { withStatus | statusEditing = Nothing, statusError = Nothing }, expiryOut ++ statusOut )


{-| The residence document for this owner (mirroring
`PortableIdentitySection.exportDoc`: refused without a device-memory
owner). Favorites come from the starred rooms; this client keeps no
folders or quiet hours.
-}
portableExport : Model -> Maybe String
portableExport model =
    case deviceMemoryOwner model of
        Nothing ->
            Nothing

        Just _ ->
            Just
                (Account2.serializePortable
                    { preferences =
                        Decode.decodeString Decode.value (Prefs.encodePreferences model.prefs)
                            |> Result.withDefault Encode.null
                    , bookmarks = Set.toList model.starredChannels
                    , networkHint = Just "Onyx"
                    , exportedAt = millisToIso model.nowMs
                    }
                )


{-| Import a residence document (mirroring `onImport`: fail closed on
a bad document; otherwise replace the favorites with the file's).
Preferences are exported but — as in the oracle — never imported.
-}
portableImportRun : Model -> ( Model, List Outbound )
portableImportRun model =
    if deviceMemoryOwner model == Nothing then
        ( { model | portableError = Just "Sign in before importing residence data.", portableStatus = Nothing }, [] )

    else
        case Account2.parsePortable (\s -> parseIso8601Ms s /= Nothing) model.portableImport of
            Nothing ->
                ( { model | portableError = Just "Invalid residence file — wrong kind, secrets present, or corrupt JSON.", portableStatus = Nothing }, [] )

            Just doc ->
                let
                    starred =
                        List.foldl (\channel m -> Tuple.first (starChannel m channel))
                            { model | starredChannels = Set.empty }
                            doc.bookmarks
                in
                ( { starred
                    | portableImport = ""
                    , portableStatus = Just (Account2.portableImportStatus doc (Set.size starred.starredChannels))
                    , portableError = Nothing
                  }
                , starredSaveOut starred
                )


{-| Route a clipboard receipt this slice owns. A theme-share receipt
after the sheet closed is stale and ignored.
-}
account2ClipboardResult : String -> Bool -> Model -> Model
account2ClipboardResult tag ok model =
    if tag == "theme-share" then
        if model.themeShareOpen then
            { model
                | themeShareCopy =
                    if ok then
                        Account2.CopyDone

                    else
                        Account2.CopyFailed
            }

        else
            model

    else
        { model
            | portableStatus =
                Just
                    (if ok then
                        "Residence JSON copied to clipboard."

                     else
                        "Clipboard copy failed — use Download instead."
                    )
            , portableError = Nothing
        }

-- v3/roomsettings


{-| The active room as the Room settings core sees it: only channels
(a DM has no settings sheet), with that room's IRCX prop map, live
connection and op status (`isChannelOp`: network opers included).
-}
roomSettingsCtx : Model -> RoomSettings.Ctx
roomSettingsCtx model =
    let
        room =
            model.activeChannel
                |> Maybe.andThen
                    (\name ->
                        if isChannelName model name then
                            Dict.get (String.toLower name) model.channels

                        else
                            Nothing
                    )
    in
    { room =
        Maybe.map
            (\ch ->
                { name = ch.name
                , topic = ch.topic
                , modes = ch.modes
                , props = Maybe.withDefault Dict.empty (Dict.get (String.toLower ch.name) model.props.channelProps)
                }
            )
            room
    , connected = model.connection == Live
    , isOp = Maybe.map (\ch -> isChannelOp model ch.name) room |> Maybe.withDefault False
    }


roomSettingsUpdate : RoomSettings.Msg -> Model -> ( Model, List Outbound )
roomSettingsUpdate sub model =
    let
        ( state, effects ) =
            RoomSettings.update (roomSettingsCtx model) sub model.roomSettings
    in
    List.foldl
        (\effect ( m, out ) ->
            let
                ( m2, out2 ) =
                    roomSettingsEffect effect m
            in
            ( m2, out ++ out2 )
        )
        ( { model | roomSettings = state }, [] )
        effects


{-| Interpret one Room settings effect with the existing folds: raw
lines go out as-is; prop writes are optimistic through
`writeChannelProp` and publish as `PROP` while live (mirroring
`_writeChannelProp`); an `ACCESS LIST` marks the room loading and
drops any partial buffer (mirroring `fetchChannelAccess`); insights
reuse the public chanstats detail fetch.
-}
roomSettingsEffect : RoomSettings.Effect -> Model -> ( Model, List Outbound )
roomSettingsEffect effect model =
    case effect of
        RoomSettings.Send line ->
            if model.connection == Live then
                ( model, [ SendLine line ] )

            else
                ( model, [] )

        RoomSettings.WriteProp p ->
            let
                written =
                    writeChannelProp p.channel p.key p.value model.props
            in
            if written == model.props then
                ( model, [] )

            else
                ( { model | props = written }
                , if model.connection == Live then
                    [ SendLine (Wire.formatIrcLine "PROP" [ p.channel, p.key, p.value ]) ]

                  else
                    []
                )

        RoomSettings.RefreshAccess channel ->
            let
                key =
                    String.toLower channel

                access =
                    model.access
            in
            if model.connection /= Live || not (Dict.member key model.channels) then
                ( model, [] )

            else
                case Ircx.accessList channel Nothing Nothing of
                    Just line ->
                        ( { model
                            | access =
                                { access
                                    | loading = Set.insert key access.loading
                                    , buffers = Dict.remove key access.buffers
                                }
                          }
                        , [ SendLine line ]
                        )

                    Nothing ->
                        ( model, [] )

        RoomSettings.LoadInsights channel ->
            requestStatsDetailFor model channel


{-| Leaving the room closes its settings sheet; opening Room care
from the Integrations link hands over to that sheet.
-}
settleRoomSettings : Msg -> Model -> Model
settleRoomSettings msg model =
    let
        settled =
            RoomSettings.settle model.activeChannel model.roomSettings
    in
    case msg of
        StewardOpen _ ->
            { model | roomSettings = RoomSettings.settle Nothing settled }

        _ ->
            { model | roomSettings = settled }


-- v3/dm-key-hold


{-| A DM whose peer key lookup has not been answered while encrypted
DMs are on. Sending would otherwise fall through to plaintext before the
`ocean.dm-key` reply lands (the open-then-send race); such a DM is held
instead. A peer that answered "no key" stays sendable in the clear (the
header shows "Not encrypted"), and the user may explicitly opt one peer
into plaintext for the session (`DmSendUnencrypted`).
-}
dmKeyUnresolved : Model -> String -> Bool
dmKeyUnresolved model target =
    let
        key =
            String.toLower target
    in
    model.e2eeDms
        && not (String.isEmpty (String.trim target))
        && not (isChannelName model target)
        && not (dmDesignated model target)
        && not (Set.member key model.dmKeyAnswered)
        && not (Set.member key model.dmPlainConfirmed)


dmKeyLookupRetryMs : Float
dmKeyLookupRetryMs =
    10000


{-| Ask for the peer's `ocean.dm-key`, at most once per retry window. -}
requestDmKeyLookup : Model -> String -> ( Model, List Outbound )
requestDmKeyLookup model target =
    let
        key =
            String.toLower target

        recent =
            case Dict.get key model.dmKeyPending of
                Just at ->
                    model.nowMs - at < dmKeyLookupRetryMs

                Nothing ->
                    False
    in
    if model.connection /= Live || recent then
        ( model, [] )

    else
        ( { model | dmKeyPending = Dict.insert key model.nowMs model.dmKeyPending }
        , [ SendLine (Wire.formatIrcLine "METADATA" [ target, "GET", "ocean.dm-key" ]) ]
        )


holdDmCopy : String -> String
holdDmCopy peer =
    "Checking whether " ++ peer ++ " can receive encrypted messages. Your message is kept — send again in a moment, or send it unencrypted."


{-| Refuse a send to an unresolved DM: keep the draft, (re)request the
key, and surface the hold with the explicit plaintext choice. -}
holdUnresolvedDm : Model -> String -> ( Model, List Outbound )
holdUnresolvedDm model target =
    let
        ( asked, out ) =
            requestDmKeyLookup model target
    in
    ( { asked | composerError = Just (holdDmCopy target), dmKeyHold = Just target }, out )


{-| A `761`/`766` reply for a peer's DM key. It settles the lookup only
when it is definitive: an empty value (no key) or a key the directory
accepted (the peer is now designated, so sends seal). A malformed key
leaves the lookup unresolved, so a garbled reply can never unlock
plaintext; the user can still consent explicitly. -}
settleDmKeyReply : String -> String -> Model -> Model
settleDmKeyReply key value model =
    if String.isEmpty (String.trim value) || dmDesignated model key then
        markDmKeyAnswered key model

    else
        model


{-| A lookup answered (key, key list, or definitively no key): clear the
pending entry and any matching hold notice. -}
markDmKeyAnswered : String -> Model -> Model
markDmKeyAnswered key model =
    let
        held =
            Maybe.map String.toLower model.dmKeyHold == Just key
    in
    { model
        | dmKeyAnswered = Set.insert key model.dmKeyAnswered
        , dmKeyPending = Dict.remove key model.dmKeyPending
        , dmKeyHold =
            if held then
                Nothing

            else
                model.dmKeyHold
        , composerError =
            if held then
                Nothing

            else
                model.composerError
    }


{-| `FAIL METADATA KEY_NOT_SET|TARGET_INVALID <target> ...` settles a
pending lookup as "no key". Other codes (rate limits, permissions) leave
it unresolved so nothing downgrades on a transient error. -}
settleDmKeyFail : Model -> Wire.IrcMessage -> Model
settleDmKeyFail model message =
    case message.params of
        "METADATA" :: code :: context ->
            if code == "KEY_NOT_SET" || code == "TARGET_INVALID" then
                List.foldl
                    (\param acc ->
                        if Dict.member (String.toLower param) acc.dmKeyPending then
                            markDmKeyAnswered (String.toLower param) acc

                        else
                            acc
                    )
                    model
                    context

            else
                model

        _ ->
            model


{-| `401 <me> <nick>` for a pending lookup: the peer does not exist, so
there is no key to wait for (the send itself will fail visibly). -}
settleDmKeyNoSuchNick : Model -> Wire.IrcMessage -> Model
settleDmKeyNoSuchNick model message =
    case message.params of
        _ :: nick :: _ ->
            if Dict.member (String.toLower nick) model.dmKeyPending then
                markDmKeyAnswered (String.toLower nick) model

            else
                model

        _ ->
            model


{-| Scheduled DM rows held by `dispatchableScheduledRow` trigger their
peer's lookup (rate-limited), so they dispatch once it answers. -}
withScheduledDmLookups : ( Model, List Outbound ) -> ( Model, List Outbound )
withScheduledDmLookups ( model, outs ) =
    List.foldl
        (\row ( acc, accOuts ) ->
            if dmKeyUnresolved acc row.channel then
                let
                    ( asked, out ) =
                        requestDmKeyLookup acc row.channel
                in
                ( asked, accOuts ++ out )

            else
                ( acc, accOuts )
        )
        ( model, outs )
        model.scheduledMessages

-- v3/calls-c11


{-| Stage-mode transitions (C11, `Stage` holds the wire rules). Every
send waits for a live socket — the oracle's `admitRaw` refuses a
closed socket the same way — and starting a stage needs channel-op
standing, since the server would refuse `MODE +m` anyway.
-}
stageUpdate : Msg -> Model -> ( Model, List Outbound )
stageUpdate msg model =
    let
        live =
            model.connection == Live

        apply ( next, lines ) =
            ( { model | stage = next }, List.map SendLine lines )
    in
    case msg of
        StageStart room ->
            if live && isChannelOp model room then
                case Stage.startLines room of
                    Just started ->
                        apply started

                    Nothing ->
                        ( model, [] )

            else
                ( model, [] )

        StageEnd ->
            if model.stage.isHost then
                apply (Stage.endLines model.stage)
                    |> Tuple.mapFirst (\m -> { m | stageHandsOpen = False })

            else
                ( model, [] )

        StageJoinAudience room ->
            if live then
                case Stage.joinLines { member = Dict.member (String.toLower room) model.channels } room of
                    Just joined ->
                        apply joined

                    Nothing ->
                        ( model, [] )

            else
                ( model, [] )

        StageLeave ->
            apply (Stage.leaveLines model.stage)
                |> Tuple.mapFirst (\m -> { m | stageHandsOpen = False })

        StageHandToggle ->
            if live && not model.stage.isSpeaker then
                apply (Stage.handLines (not model.stage.handRaised) model.stage)

            else
                ( model, [] )

        StageInvite nick ->
            if live && model.stage.isHost then
                -- Remember the invite so only its answer can earn voice.
                ( { model | stage = Stage.recordInvite nick model.stage }
                , List.map SendLine (Stage.inviteLine nick model.stage)
                )

            else
                ( model, [] )

        StageDismissHand nick ->
            -- Local only: Onyx Server has no deny verb for a raised
            -- hand, so dismissing clears the row from this host's queue.
            ( { model | stage = Stage.removeRaisedHand nick model.stage }, [] )

        StageAccept ->
            if live && model.stage.pendingInvite /= Nothing then
                apply (Stage.acceptLines model.stage)

            else
                ( model, [] )

        StageDecline ->
            apply (Stage.declineLines model.stage)

        StageHandsOpen ->
            ( { model | stageHandsOpen = True }, [] )

        StageHandsClose ->
            ( { model | stageHandsOpen = False }, [] )

        _ ->
            ( model, [] )


{-| The 375px raised-hands sheet is open (host, live stage, queue). -}
stageHandsSheetOpen : Model -> Bool
stageHandsSheetOpen model =
    model.stageHandsOpen && model.stage.isHost && model.stage.channel /= Nothing


{-| Fold the stage side of one live wire line after `foldLine` (the row
itself is already swallowed as a CTCP wrapper there): inbound STAGE
CTCP, NICK renames, and our own PART / KICK from the stage room.
-}
foldStageWire : Wire.IrcMessage -> ( Model, List Outbound ) -> ( Model, List Outbound )
foldStageWire parsed ( model, out ) =
    if model.historyMerging || model.stage.channel == Nothing then
        ( model, out )

    else
        let
            sender =
                Maybe.withDefault "" parsed.nick

            isSelf name =
                String.toLower name == String.toLower model.ourNick
        in
        case ( parsed.command, parsed.params ) of
            ( "PRIVMSG", target :: body :: _ ) ->
                let
                    memberModes nick =
                        model.stage.channel
                            |> Maybe.andThen (\room -> Dict.get (String.toLower room) model.channels)
                            |> Maybe.andThen (\ch -> Dict.get (String.toLower nick) ch.members)
                            |> Maybe.map .modes
                in
                case
                    Stage.foldCtcp
                        { ourNick = model.ourNick
                        , sender = sender
                        , target = target
                        , body = body
                        , memberModes = memberModes
                        }
                        model.stage
                of
                    Just folded ->
                        let
                            announcer =
                                model.callAnnouncer

                            announced =
                                case ( folded.raised, model.stage.isHost ) of
                                    ( Just nick, True ) ->
                                        { announcer | message = nick ++ " raised a hand" }

                                    _ ->
                                        announcer
                        in
                        ( { model | stage = folded.stage, callAnnouncer = announced }
                        , out ++ List.map SendLine folded.lines
                        )

                    Nothing ->
                        ( model, out )

            ( "NICK", new :: _ ) ->
                ( { model | stage = Stage.foldNick sender new model.stage }, out )

            ( "PART", rooms :: _ ) ->
                if isSelf sender then
                    ( { model | stage = List.foldl Stage.foldSelfLeave model.stage (String.split "," rooms) }, out )

                else
                    ( { model | stage = Stage.removeRaisedHand sender model.stage }, out )

            ( "KICK", room :: victim :: _ ) ->
                if isSelf victim then
                    ( { model | stage = Stage.foldSelfLeave room model.stage }, out )

                else
                    ( { model | stage = Stage.removeRaisedHand victim model.stage }, out )

            ( "QUIT", _ ) ->
                ( { model | stage = Stage.removeRaisedHand sender model.stage }, out )

            _ ->
                ( model, out )


{-| Close the stage / leave-confirm overlays once they have nothing to
show (call idle, host authority gone).
-}
settleStage : Model -> Model
settleStage model =
    let
        confirmed =
            if model.callLeaveConfirm && model.calls.lifecycle == Media.Idle then
                { model | callLeaveConfirm = False }

            else
                model
    in
    if confirmed.stageHandsOpen && not (stageHandsSheetOpen confirmed && not (List.isEmpty confirmed.stage.raisedHands)) then
        { confirmed | stageHandsOpen = False }

    else
        confirmed


{-| C12 call chords from the `shortcut` port (`call-<name>`). Active
only in an established call; while reconnecting only Leave works (the
bar disables the rest the same way). Raise hand drives the stage hand
when this call's room is a stage this client is in the audience of;
outside a stage it toggles the C8 voice hand (v3/calls-c8).
-}
callChord : String -> Model -> ( Model, List Outbound )
callChord name model =
    let
        reconnecting =
            CallDock.reconnecting model.calls (model.connection == Live)

        roster =
            CallUi.callRoster model.media model.calls
    in
    case Stage.chordFromName name of
        Nothing ->
            ( model, [] )

        Just chord ->
            if model.calls.lifecycle /= Media.InCall then
                ( model, [] )

            else if reconnecting && chord /= Stage.ChordLeave then
                ( model, [] )

            else
                case chord of
                    Stage.ChordMute ->
                        updateCore CallToggleMute model

                    Stage.ChordCamera ->
                        updateCore CallToggleCamera model

                    Stage.ChordHand ->
                        case model.calls.channel of
                            Just room ->
                                if Stage.activeFor model.stage room && not model.stage.isSpeaker then
                                    stageUpdate StageHandToggle model

                                else
                                    -- v3/calls-c8: the voice hand
                                    updateCore CallToggleHand model

                            Nothing ->
                                -- v3/calls-c8: a DM call's hand is local
                                updateCore CallToggleHand model

                    -- v3/calls-c8
                    Stage.ChordCaptions ->
                        updateCore CallToggleCaptions model

                    Stage.ChordLeave ->
                        if List.length roster > 2 then
                            ( { model | callLeaveConfirm = True }, [] )

                        else
                            updateCore CallLeave model

                    Stage.ChordLayout ->
                        ( cycleCallLayout model, [] )

                    Stage.ChordSize ->
                        updateCore CallStageSizeCycle model

                    Stage.ChordSpeaker ->
                        let
                            peerSpeaking =
                                Dict.foldl
                                    (\k p acc ->
                                        if p.speaking then
                                            k :: acc

                                        else
                                            acc
                                    )
                                    []
                                    model.callPeers

                            speaking =
                                Set.union model.media.speaking (Set.fromList peerSpeaking)

                            names =
                                roster
                                    |> List.filter (\k -> Set.member (String.toLower k) speaking)
                                    |> List.map (callDisplayName model)

                            announcer =
                                model.callAnnouncer
                        in
                        ( { model | callAnnouncer = { announcer | message = Stage.speakingAnnouncement names } }, [] )


{-| Ctrl+Shift+G: grid → spotlight → (screenshare when one is live) →
grid (spec §3.1).
-}
cycleCallLayout : Model -> Model
cycleCallLayout model =
    let
        shareId =
            CallMedia.buildTiles
                { ourNick = model.ourNick
                , order = model.callTileOrder
                , media = model.media
                , peers = model.callPeers
                , local = model.callLocal
                , selfMuted = model.callSelfMuted
                , pinned = model.callPinned
                , displayName = callDisplayName model
                , roleOf = \_ -> Nothing
                }
                |> .shares
                |> List.head
                |> Maybe.map .id

        current =
            CallMedia.resolveView { layout = model.callLayout, shareId = shareId, optOut = model.callShareOptOut }
    in
    case current of
        CallMedia.ViewScreenshare ->
            { model | callShareOptOut = shareId, callLayout = CallMedia.LayoutGrid }

        CallMedia.ViewGrid ->
            { model | callLayout = CallMedia.LayoutSpotlight }

        CallMedia.ViewSpotlight ->
            case shareId of
                Just _ ->
                    { model | callShareOptOut = Nothing }

                Nothing ->
                    { model | callLayout = CallMedia.LayoutGrid }


-- v3/polish


{-| The composer More-tools trigger id (focus returns here when the
tray closes from Escape, mirroring `closeTools('trigger')`).
-}
polishToolsTriggerId : String
polishToolsTriggerId =
    "shell-composer-more"


polishPulseKeyPrefix : String
polishPulseKeyPrefix =
    "scrubber-pulse-"


polishCopyTag : String
polishCopyTag =
    "scrubber-moment"


{-| The send-later gate the tray shares with the schedule popover. -}
polishScheduleGate : Model -> { target : Maybe String, body : String, editing : Bool, attachmentsStaged : Bool }
polishScheduleGate model =
    { target = model.activeChannel
    , body = model.composer
    , editing = Maybe.andThen (activeEditFor model) model.activeChannel /= Nothing
    , attachmentsStaged = not (List.isEmpty model.attachments)
    }


{-| A call is the Elm build's "current work" that defers an update
reload (the oracle `updateCoordinator` active holders).
-}
polishWorkActive : Model -> Bool
polishWorkActive model =
    model.calls.lifecycle /= Media.Idle


{-| The quiet first-run notifications ask (mirroring
`FirstRunNotifyPrompt`): never while the Notifications sheet is open,
never on an iOS Safari tab, only after a first send on this device.
-}
firstRunNotifyOffered : Model -> Bool
firstRunNotifyOffered model =
    not model.notifySheetOpen
        && Polish.firstRunNotifyCopy model.polish.navigatorStandalone
        /= Nothing
        && Polish.shouldOfferFirstRunNotify
            { sent = model.polish.notifyFirstSend
            , dismissed = model.polish.notifyDismissed
            , permission = model.notifyPermission
            , surface = model.polish.surface
            , hostNotifications = model.polish.hostNotifications
            , navigatorStandalone = model.polish.navigatorStandalone
            }


{-| The day-2 Home Screen courtesy (mirroring `AddToHomeScreenSheet`).
One quiet ask at a time: it waits while the notifications ask is up.
-}
a2hsOffered : Model -> Bool
a2hsOffered model =
    let
        a =
            model.polish.a2hs
    in
    not (firstRunNotifyOffered model)
        && Polish.shouldOfferAddToHomeScreen
            { engaged =
                Polish.hasHomeScreenEngagement
                    { sent = a.sent
                    , returning = a.returning
                    , joinedRoom = List.any (isChannelName model) (Dict.keys model.channels)
                    }
            , dismissed = a.dismissed
            , standalone = a.standalone
            , surface = model.polish.surface
            , platform = a.platform
            , hasCapturedPrompt = a.captured
            }


{-| The scrubber's room: the active conversation when it is a room. -}
polishScrubberRoom : Model -> Maybe String
polishScrubberRoom model =
    case model.activeChannel of
        Just name ->
            if isChannelName model name then
                Just name

            else
                Nothing

        Nothing ->
            Nothing


setPolish : Polish.State -> Model -> Model
setPolish polish model =
    { model | polish = polish }


setScrubber : Polish.Scrubber -> Model -> Model
setScrubber scrubber model =
    let
        polish =
            model.polish
    in
    { model | polish = { polish | scrubber = scrubber } }


polishCloseTools : Model -> Model
polishCloseTools model =
    let
        polish =
            model.polish
    in
    { model | polish = { polish | toolsOpen = False } }


polishUpdate : Polish.Msg -> Model -> ( Model, List Outbound )
polishUpdate pmsg model =
    let
        polish =
            model.polish

        scrubber =
            polish.scrubber
    in
    case pmsg of
        Polish.ToolsToggle ->
            -- Opening never stacks competing transient chrome
            -- (mirroring `toggleTools`: emoji and schedule close).
            if polish.toolsOpen then
                ( polishCloseTools model, [] )

            else if model.activeChannel == Nothing then
                ( model, [] )

            else
                ( { model
                    | polish = { polish | toolsOpen = True }
                    , scheduleOpen = False
                    , scheduleError = Nothing
                    , composerAssist = ComposerAssist.closeEmoji model.composerAssist
                  }
                , []
                )

        Polish.ToolsClose ->
            if polish.toolsOpen then
                ( polishCloseTools model, [ PrefsFocus { id = polishToolsTriggerId } ] )

            else
                ( model, [] )

        Polish.ToolsAttach ->
            updateCore AttachPick (polishCloseTools model)

        Polish.ToolsSchedule ->
            if Schedule.canScheduleComposer (polishScheduleGate model) then
                updateCore ScheduleOpen (polishCloseTools model)

            else
                ( model, [] )

        Polish.ToolsJump ->
            if model.activeChannel == Nothing then
                ( model, [] )

            else
                updateCore JumpToDateOpen (polishCloseTools model)

        Polish.ToolsEmoji ->
            let
                closed =
                    polishCloseTools model
            in
            if model.activeChannel == Nothing || closed.composerAssist.emojiOpen then
                ( closed, [] )

            else
                updateCore ComposerEmojiToggle closed

        Polish.ToolsSlash ->
            -- Command help only seeds a leading slash so the existing
            -- suggestions can teach; nothing runs until Send.
            if model.activeChannel == Nothing then
                ( polishCloseTools model, [] )

            else
                let
                    draft =
                        if String.startsWith "/" model.composer then
                            model.composer

                        else
                            "/" ++ model.composer

                    ( typed, out ) =
                        updateCore (ComposerInput draft) (polishCloseTools model)
                in
                ( typed, out ++ [ PrefsFocus { id = "shell-composer-input" } ] )

        Polish.NotifyEnable ->
            if polish.notifyBusy || not (firstRunNotifyOffered model) then
                ( model, [] )

            else
                ( setPolish { polish | notifyBusy = True } model, [ NotifyPermissionRequest ] )

        Polish.NotifyDismiss ->
            polishDismissNotify model

        Polish.A2hsAdd ->
            let
                a =
                    polish.a2hs
            in
            if not a.captured then
                polishDismissA2hs model

            else
                ( setPolish { polish | a2hs = { a | status = "Opening your browser’s install prompt…" } } model
                , [ PwaInstallPrompt ]
                )

        Polish.A2hsDismiss ->
            polishDismissA2hs model

        Polish.PwaEventReceived raw ->
            let
                a =
                    polish.a2hs

                upd =
                    polish.update
            in
            case Polish.decodePwaEvent raw of
                Polish.InstallAvailable ->
                    ( setPolish { polish | a2hs = { a | captured = True } } model, [] )

                Polish.InstallOutcome outcome ->
                    let
                        status =
                            Polish.a2hsOutcomeStatus outcome

                        ( dismissed, out ) =
                            polishDismissA2hs (setPolish { polish | a2hs = { a | captured = False, status = status } } model)
                    in
                    ( addToast
                        { variant =
                            if outcome == Polish.Accepted then
                                ToastSuccess

                            else
                                ToastInfo
                        , title = "Home Screen"
                        , description = Just status
                        , duration = Nothing
                        , groupKey = Just "a2hs"
                        , undo = Nothing
                        }
                        dismissed.nowMs
                        dismissed
                    , out
                    )

                Polish.UpdateAvailable ->
                    ( setPolish { polish | update = { upd | available = True } } model, [] )

                Polish.UnknownPwaEvent ->
                    ( model, [] )

        Polish.UpdateApprove ->
            let
                upd =
                    polish.update
            in
            if not upd.available || upd.reloading then
                ( model, [] )

            else if polishWorkActive model then
                ( setPolish { polish | update = { upd | approved = True } } model, [] )

            else
                ( setPolish { polish | update = { upd | approved = True, reloading = True } } model, [ PwaUpdateApprove ] )

        Polish.ScrubberOpen ->
            case polishScrubberRoom model of
                Nothing ->
                    ( model, [] )

                Just room ->
                    polishFetchPulse room
                        (setScrubber
                            { scrubber
                                | open = True
                                , channel = String.toLower room
                                , date = Boost.formatUtcDate model.nowMs
                                , followsToday = True
                                , pulse = Nothing
                                , roving = Polish.utcHour model.nowMs
                                , moment = model.nowMs
                                , copy = Polish.CopyIdle
                                , copyFor = Nothing
                            }
                            { model | roomMenuOpen = False }
                        )

        Polish.ScrubberClose ->
            ( setScrubber { scrubber | open = False, copy = Polish.CopyIdle, copyFor = Nothing } model, [] )

        Polish.ScrubberHour hour ->
            polishScrubberJump { scrubber | followsToday = False, roving = modBy 24 hour } scrubber.date hour model

        Polish.ScrubberDate date ->
            polishScrubberJump { scrubber | followsToday = False, date = date } date 12 model

        Polish.ScrubberRove hour ->
            let
                next =
                    modBy 24 hour
            in
            ( setScrubber { scrubber | roving = next } model
            , [ PrefsFocus { id = "time-scrubber-hour-" ++ String.fromInt next } ]
            )

        Polish.ScrubberCopy ->
            case polishScrubberRoom model of
                Nothing ->
                    ( model, [] )

                Just room ->
                    case Invite.buildMomentLink model.origin room scrubber.moment of
                        Just link ->
                            ( setScrubber { scrubber | copy = Polish.CopyIdle, copyFor = Just ( String.toLower room, scrubber.moment ) } model
                            , [ ClipboardCopy { text = link, tag = polishCopyTag } ]
                            )

                        Nothing ->
                            ( setScrubber { scrubber | copy = Polish.CopyFailed, copyFor = Nothing } model, [] )


{-| Jump the active room to `date` at `hour`:00 UTC through the shared
`requestTravelTo` fold. An invalid date only keeps the typed value.
-}
polishScrubberJump : Polish.Scrubber -> String -> Int -> Model -> ( Model, List Outbound )
polishScrubberJump scrubber date hour model =
    case ( polishScrubberRoom model, Boost.dateTimeAtUtc date (Polish.pad2 (clamp 0 23 hour) ++ ":00") ) of
        ( Just room, Just at ) ->
            requestTravelTo
                (setScrubber { scrubber | moment = at, copy = Polish.CopyIdle, copyFor = Nothing } model)
                room
                at

        _ ->
            ( setScrubber scrubber model, [] )


polishFetchPulse : String -> Model -> ( Model, List Outbound )
polishFetchPulse room model =
    let
        scrubber =
            model.polish.scrubber
    in
    case Stats.channelDetailUrl room of
        Nothing ->
            ( setScrubber { scrubber | loading = False, fetchedAt = model.nowMs } model, [] )

        Just url ->
            ( setScrubber { scrubber | loading = True, fetchedAt = model.nowMs } model
            , [ HttpFetch { key = polishPulseKeyPrefix ++ Stats.channelToSlug room, url = url } ]
            )


polishDismissNotify : Model -> ( Model, List Outbound )
polishDismissNotify model =
    let
        polish =
            model.polish
    in
    if polish.notifyDismissed then
        ( setPolish { polish | notifyBusy = False } model, [] )

    else
        ( setPolish { polish | notifyDismissed = True, notifyBusy = False } model
        , [ PolishFlagSave { key = Polish.notifyDismissKey } ]
        )


polishDismissA2hs : Model -> ( Model, List Outbound )
polishDismissA2hs model =
    let
        polish =
            model.polish

        a =
            polish.a2hs
    in
    if a.dismissed then
        ( model, [] )

    else
        ( setPolish { polish | a2hs = { a | dismissed = True } } model
        , [ PolishFlagSave { key = Polish.a2hsDismissKey } ]
        )


{-| Results this slice owns, routed before `updateCore` so the shared
HttpResult / ClipboardResult chains stay untouched.
-}
polishIntercept : Msg -> Model -> Maybe ( Model, List Outbound )
polishIntercept msg model =
    let
        scrubber =
            model.polish.scrubber
    in
    case msg of
        HttpResult r ->
            if String.startsWith polishPulseKeyPrefix r.key then
                if r.key == polishPulseKeyPrefix ++ Stats.channelToSlug scrubber.channel then
                    let
                        pulse =
                            if r.ok then
                                Stats.decodeChannelPulse r.body
                                    |> Maybe.map (\p -> { hours = List.map toFloat p.hours, total = p.total })

                            else
                                Nothing
                    in
                    Just ( setScrubber { scrubber | loading = False, pulse = pulse } model, [] )

                else
                    Just ( model, [] )

            else
                Nothing

        ClipboardResult r ->
            if r.tag == polishCopyTag then
                -- A result for a moment or room that changed since the
                -- copy started is retired (the oracle copy epoch).
                if scrubber.copyFor == Just ( scrubber.channel, scrubber.moment ) then
                    Just
                        ( setScrubber
                            { scrubber
                                | copyFor = Nothing
                                , copy =
                                    if r.ok then
                                        Polish.CopyCopied model.nowMs

                                    else
                                        Polish.CopyFailed
                            }
                            model
                        , []
                        )

                else
                    Just ( model, [] )

            else
                Nothing

        _ ->
            Nothing


{-| Post-update settle: the live latch, the first-send marks (and the
emoji/tools close after a send), the notify answer, the scrubber clock
and the deferred update reload.
-}
polishSettle : Msg -> Model -> Model -> ( Model, List Outbound )
polishSettle msg before after =
    let
        p0 =
            after.polish

        latched =
            if after.connection == Live && not p0.hasBeenLive then
                { after | polish = { p0 | hasBeenLive = True } }

            else
                after

        ( sent, sendOut ) =
            case msg of
                ComposerSend ->
                    polishAfterSend before latched

                _ ->
                    ( latched, [] )

        ( answered, notifyOut ) =
            case msg of
                NotifyPermissionChanged _ ->
                    polishNotifyAnswered sent

                _ ->
                    ( sent, [] )

        ( scrubbed, scrubOut ) =
            polishSettleScrubber answered

        ( reloaded, updateOut ) =
            polishSettleUpdate scrubbed
    in
    ( reloaded, sendOut ++ notifyOut ++ scrubOut ++ updateOut )


polishAfterSend : Model -> Model -> ( Model, List Outbound )
polishAfterSend before after =
    let
        cleared =
            not (String.isEmpty (String.trim before.composer))
                && String.isEmpty (String.trim after.composer)
                && after.composerError == Nothing
    in
    if not cleared then
        ( after, [] )

    else
        let
            polish =
                after.polish

            -- Every successful send closes the emoji picker and the
            -- tools tray (mirroring `resetAfterSend`).
            reset =
                { after
                    | composerAssist = ComposerAssist.closeEmoji after.composerAssist
                    , polish = { polish | toolsOpen = False }
                }

            wasEdit =
                Maybe.andThen (activeEditFor before) before.activeChannel /= Nothing
        in
        if wasEdit || not (Polish.isRealSend before.composer) then
            ( reset, [] )

        else
            let
                p =
                    reset.polish

                a =
                    p.a2hs

                marks =
                    List.filterMap identity
                        [ if p.firstHourPersisted then
                            Nothing

                          else
                            Just (PolishFlagSave { key = Polish.firstHourSeenKey })
                        , if p.notifyFirstSend then
                            Nothing

                          else
                            Just (PolishFlagSave { key = Polish.notifyFirstSendKey })
                        , if a.sent then
                            Nothing

                          else
                            Just (PolishFlagSave { key = Polish.a2hsSentKey })
                        ]
            in
            ( { reset
                | homeCoachDismissed = True
                , polish = { p | firstHourPersisted = True, notifyFirstSend = True, a2hs = { a | sent = True } }
              }
            , marks
            )


polishNotifyAnswered : Model -> ( Model, List Outbound )
polishNotifyAnswered model =
    if not model.polish.notifyBusy then
        ( model, [] )

    else
        let
            ( dismissed, out ) =
                polishDismissNotify model

            toast =
                Polish.notifyArmedToast model.notifyPermission
        in
        if firstRunArmsPush model then
            -- v3/gap-pwa-safety (oracle `armClosedTabNotifications`):
            -- the grant also arms closed-tab push through the one
            -- WebPushToggle machine; its result toast ("Push on" or the
            -- typed reason) reports the outcome instead of this one.
            let
                ( armed, pushOut ) =
                    toggleWebPush dismissed
            in
            ( armed, out ++ pushOut )

        else
            ( addToast
                { variant =
                    if toast.success then
                        ToastSuccess

                    else
                        ToastWarning
                , title = toast.title
                , description = Just toast.description
                , duration = Nothing
                , groupKey = Just "first-run-notify"
                , undo = Nothing
                }
                dismissed.nowMs
                dismissed
            , out
            )


{-| v3/gap-pwa-safety — the first-run Turn on chains closed-tab push
only when nothing the model already knows would refuse it (granted,
signed in, live, VAPID advertised, push off and idle). Anything else
keeps the plain "Notifications allowed" outcome. -}
firstRunArmsPush : Model -> Bool
firstRunArmsPush model =
    model.notifyPermission
        == Notify.Granted
        && not model.webPushOn
        && not model.webPushBusy
        && (case
                Push.enableReadiness
                    { supported = Maybe.withDefault True model.webPushSupported
                    , account = model.accountName
                    , connected = model.connection == Live
                    , vapid = model.isupport.vapid
                    }
            of
                Ok _ ->
                    True

                Err _ ->
                    False
           )


polishSettleScrubber : Model -> ( Model, List Outbound )
polishSettleScrubber model =
    let
        s0 =
            model.polish.scrubber

        s1 =
            case s0.copy of
                Polish.CopyCopied at ->
                    if model.nowMs - at >= Polish.copyResetMs then
                        { s0 | copy = Polish.CopyIdle }

                    else
                        s0

                _ ->
                    s0

        reset =
            if s1 == s0 then
                model

            else
                setScrubber s1 model
    in
    if not s1.open then
        ( reset, [] )

    else
        case polishScrubberRoom reset of
            Nothing ->
                ( reset, [] )

            Just room ->
                if String.toLower room /= s1.channel then
                    -- The room changed under an open scrubber: retire
                    -- the old pulse and copy feedback, fetch the new.
                    polishFetchPulse room
                        (setScrubber
                            { s1
                                | channel = String.toLower room
                                , pulse = Nothing
                                , copy = Polish.CopyIdle
                                , copyFor = Nothing
                            }
                            reset
                        )

                else if reset.nowMs - s1.fetchedAt >= Polish.pulseRefreshMs then
                    -- The 60s refresh; an untouched date follows the
                    -- current UTC day across midnight.
                    polishFetchPulse room
                        (setScrubber
                            (if s1.followsToday then
                                { s1 | date = Boost.formatUtcDate reset.nowMs }

                             else
                                s1
                            )
                            reset
                        )

                else
                    ( reset, [] )


polishSettleUpdate : Model -> ( Model, List Outbound )
polishSettleUpdate model =
    let
        polish =
            model.polish

        upd =
            polish.update
    in
    if upd.approved && not upd.reloading && not (polishWorkActive model) then
        ( setPolish { polish | update = { upd | reloading = True } } model, [ PwaUpdateApprove ] )

    else
        ( model, [] )


{-| Whether plaintext content sent to `target` would bypass protection:
a designated or still-unresolved DM peer, or a required-encryption room.
-}
plaintextWouldLeak : Model -> String -> Bool
plaintextWouldLeak model target =
    if isChannelName model target then
        roomEncryptionPolicy model target == RequiredPolicy

    else
        dmDesignated model target || dmKeyUnresolved model target


{-| Raw slash verbs that carry user content to their first argument. -}
rawContentVerbs : List String
rawContentVerbs =
    [ "PRIVMSG", "NOTICE", "MSG", "QUERY", "ME", "SQUERY", "CPRIVMSG", "CNOTICE", "EDIT", "WHISPER" ]


{-| The destination a raw verb sends user content to, when it does:
the first argument of a content verb, or the account of `MEMO SEND`
(memos are plaintext text to a person, so they obey the same guard).
v3/gap-commands. -}
rawContentDestination : String -> List String -> Maybe String
rawContentDestination command params =
    case ( command, params ) of
        ( "MEMO", sub :: account :: _ ) ->
            if String.toUpper sub == "SEND" then
                Just account

            else
                Nothing

        ( _, dest :: _ ) ->
            if List.member command rawContentVerbs then
                Just dest

            else
                Nothing

        _ ->
            Nothing


rawSlashLeakCopy : String -> String
rawSlashLeakCopy dest =
    "That command would send to " ++ dest ++ " without encryption. Open the conversation and send from the composer instead."



-- v3/gap-import


historyImportCtx : Model -> HistoryImport.Ctx
historyImportCtx model =
    { nowMs = model.nowMs
    , owner = Maybe.map (\o -> o.serverUrl ++ "|" ++ o.identity) (deviceMemoryOwner model)
    , keepFor = Retention.effectiveKeep model.retentionPolicy
    , maxAgeDays = model.retentionPolicy.maxAgeDays
    }


{-| Run one history-import message and interpret its effects. A
confirmed removal also drops the removed rows from open buffers (rows
hydrated from the vault carry no msgid, so they match by fingerprint).
-}
historyImportUpdate : HistoryImport.Msg -> Model -> ( Model, List Outbound )
historyImportUpdate sub model =
    case ( sub, gapImportBlocked model ) of
        -- v3/gap-account: imported history is written under the signed-in
        -- scope and only while local history is on; otherwise the writes
        -- would be dropped, so the review says so instead of claiming it
        -- imported.
        ( HistoryImport.Confirm, Just reason ) ->
            let
                hi =
                    model.historyImport
            in
            ( { model | historyImport = { hi | status = Just { message = reason, failure = True } } }, [] )

        _ ->
            historyImportRun sub model


historyImportRun : HistoryImport.Msg -> Model -> ( Model, List Outbound )
historyImportRun sub model =
    let
        ( next, effects ) =
            HistoryImport.update (historyImportCtx model) sub model.historyImport

        pruned =
            case sub of
                HistoryImport.Removed r ->
                    if r.ok && model.historyImport.removing == Just r.batch then
                        dropImportedRows r.targets (Set.fromList r.prints) model

                    else
                        model

                _ ->
                    model
    in
    List.foldl historyImportEffect ( { pruned | historyImport = next }, [] ) effects


historyImportEffect : HistoryImport.Effect -> ( Model, List Outbound ) -> ( Model, List Outbound )
historyImportEffect effect ( model, outs ) =
    case effect of
        HistoryImport.Pick req ->
            ( model, outs ++ [ HistoryImportPick req ] )

        HistoryImport.CancelJob req ->
            ( model, outs ++ [ HistoryImportCancel req ] )

        HistoryImport.Persist req ->
            ( model, outs ++ [ historyImportPersist req.target req.rows ] )

        HistoryImport.Record req ->
            ( model, outs ++ [ HistoryImportRecord req ] )

        HistoryImport.ListBatches ->
            ( model, outs ++ [ HistoryImportListRequest ] )

        HistoryImport.RemoveBatch req ->
            ( model, outs ++ [ HistoryImportRemove req ] )

        HistoryImport.Touched { targets } ->
            let
                ( touched, fetches ) =
                    historyImportTouched targets model
            in
            ( touched, outs ++ fetches )

        HistoryImport.Focus id ->
            ( model, outs ++ [ PrefsFocus { id = id } ] )


{-| THE vault write for imported history: every imported row reaches
the vault through the normal `VaultPersist` port (whose trim applies
the destination's retention policy). Vault owner scoping lands here. -}
historyImportPersist : String -> List HistoryImport.Row -> Outbound
historyImportPersist target rows =
    VaultPersist
        { target = target
        , rows =
            List.map
                (\row ->
                    { id = row.id
                    , target = target
                    , from = row.from
                    , body = row.body
                    , at = row.at
                    , rowType = row.rowType
                    , deleted = False
                    , redacted = False
                    , replyTo = Maybe.map sanitizeReplyRef row.replyTo
                    }
                )
                rows
        }


{-| Conversations an import or removal touched: their DM privacy proof
is void (like any vault write), and an open, still-empty buffer
hydrates so the history shows without a reload. -}
historyImportTouched : List String -> Model -> ( Model, List Outbound )
historyImportTouched targets model =
    let
        keys =
            List.map String.toLower targets
    in
    ( { model | vaultDmPrivacy = List.foldl Dict.remove model.vaultDmPrivacy keys }
    , List.filterMap
        (\key ->
            case Dict.get key model.channels of
                Just channel ->
                    if List.isEmpty channel.messages then
                        Just (VaultFetch { target = key, limit = keepMessages })

                    else
                        Nothing

                Nothing ->
                    Nothing
        )
        keys
    )


dropImportedRows : List String -> Set String -> Model -> Model
dropImportedRows targets prints model =
    if Set.isEmpty prints then
        model

    else
        List.foldl
            (\key m ->
                if Dict.member key m.channels then
                    updateChannel m
                        key
                        (\c ->
                            { c
                                | messages =
                                    List.filter
                                        (\row -> row.msgid /= Nothing || not (Set.member (HistoryImport.fingerprint row.at row.from row.body) prints))
                                        c.messages
                            }
                        )

                else
                    m
            )
            model
            (List.map String.toLower targets)


{-| Preferences, on Import & export (the review lives there). -}
historyImportShowTransfer : Model -> ( Model, List Outbound )
historyImportShowTransfer model =
    let
        ( opened, out ) =
            if model.prefsOpen then
                ( model, [] )

            else
                prefsOpen model
    in
    ( { opened | prefsCategory = PrefsPanel.Transfer }, out )


historyImportOpen : Model -> ( Model, List Outbound )
historyImportOpen model =
    let
        ( opened, openOut ) =
            historyImportShowTransfer model

        ( chosen, chooseOut ) =
            historyImportUpdate (HistoryImport.Choose HistoryImport.Portable) opened
    in
    ( chosen, openOut ++ chooseOut )


blockKitUpdate : BlockKit.Msg -> Model -> ( Model, List Outbound )
blockKitUpdate sub model =
    let
        ( next, effects ) =
            BlockKit.update model.nowMs sub model.blockKit
    in
    List.foldl blockKitEffect ( { model | blockKit = next }, [] ) effects


blockKitEffect : BlockKit.Effect -> ( Model, List Outbound ) -> ( Model, List Outbound )
blockKitEffect effect ( model, outs ) =
    case effect of
        BlockKit.CopyText req ->
            ( model, outs ++ [ ClipboardCopy req ] )

        BlockKit.SendText prepared ->
            let
                ( sent, out ) =
                    blockKitSend model prepared
            in
            ( sent, outs ++ out )

        BlockKit.FocusId id ->
            ( model, outs ++ [ PrefsFocus { id = id } ] )


{-| Send one reviewed structured-control message as the user, through
the normal composer send (labels, echo, E2EE sealing, offline queue)
without touching the visible composer, its draft, reply or audience.
-}
blockKitSend : Model -> BlockKit.Prepared -> ( Model, List Outbound )
blockKitSend model prepared =
    let
        ( sent, out ) =
            sendComposerText { model | composer = prepared.text, composerAudience = Nothing, replyingTo = Nothing } prepared.target
    in
    ( { sent
        | composer = model.composer
        , composerAudience = model.composerAudience
        , replyingTo = model.replyingTo
        , composerDrafts = model.composerDrafts
      }
    , out
    )


{-| Post-update: BlockKit copy results and their expiry; an owner change
aborts a running or staged import (V48); entering Import & export
refreshes the imported-batch list. -}
settleStepGapImport : Msg -> Model -> ( Model, List Outbound ) -> ( Model, List Outbound )
settleStepGapImport msg prior ( m, outs ) =
    let
        ( copied, copyOut ) =
            case msg of
                ClipboardResult r ->
                    if String.startsWith BlockKit.copyTagPrefix r.tag then
                        blockKitUpdate (BlockKit.CopyResult r) m

                    else
                        ( m, [] )

                Tick _ ->
                    if Dict.isEmpty m.blockKit.copies then
                        ( m, [] )

                    else
                        blockKitUpdate (BlockKit.Tick m.nowMs) m

                _ ->
                    ( m, [] )

        priorOwner =
            (historyImportCtx prior).owner

        ( guarded, ownerOut ) =
            if priorOwner /= Nothing && priorOwner /= (historyImportCtx copied).owner then
                let
                    ( state, effects ) =
                        HistoryImport.ownerChanged copied.historyImport
                in
                List.foldl historyImportEffect ( { copied | historyImport = state }, [] ) effects

            else
                ( copied, [] )

        onTransfer model =
            model.prefsOpen && model.prefsCategory == PrefsPanel.Transfer

        listOut =
            if onTransfer guarded && not (onTransfer prior) then
                [ HistoryImportListRequest ]

            else
                []
    in
    ( guarded, outs ++ copyOut ++ ownerOut ++ listOut )


-- v3/gap-organize


{-| The organize feature's view of the app (`Organizer.Ctx`). -}
organizeCtx : Model -> Organizer.Ctx
organizeCtx model =
    { owner = deviceMemoryOwner model
    , nowMs = model.nowMs
    , active = model.activeChannel
    }


{-| `OrganizeMsg`: run the pure feature update, then perform its
effects (storage, toasts, navigation) in order. -}
organizeUpdate : Organizer.Msg -> Model -> ( Model, List Outbound )
organizeUpdate sub model =
    let
        ( state, effects ) =
            Organizer.update (organizeCtx model) sub model.organize
    in
    List.foldl organizeEffect ( { model | organize = state }, [] ) effects


organizeEffect : Organizer.Effect -> ( Model, List Outbound ) -> ( Model, List Outbound )
organizeEffect effect ( model, outs ) =
    let
        andThen ( next, more ) =
            ( next, outs ++ more )
    in
    case effect of
        Organizer.Store key value ->
            ( model, outs ++ [ OrganizeStore { key = key, value = value } ] )

        Organizer.Toast title description ->
            ( addToast
                { variant = ToastInfo
                , title = title
                , description = description
                , duration = Nothing
                , groupKey = Nothing
                , undo = Nothing
                }
                model.nowMs
                model
            , outs
            )

        Organizer.OpenConversation name ->
            andThen (updateCore (ChannelSelect name) model)

        Organizer.JumpToMessage target msgid ->
            andThen (organizeJumpTo target msgid model)

        Organizer.JumpFirstUnread name ->
            let
                key =
                    String.toLower name

                firstMsgid =
                    Dict.get key model.firstUnreadId
                        |> Maybe.andThen
                            (\rowId ->
                                Dict.get key model.channels
                                    |> Maybe.andThen (\ch -> List.filter (\m -> m.id == rowId) ch.messages |> List.head)
                                    |> Maybe.andThen .msgid
                            )

                ( opened, out ) =
                    updateCore (ChannelSelect name) model
            in
            case firstMsgid of
                Just msgid ->
                    ( focusMessage opened msgid, outs ++ out )

                Nothing ->
                    ( opened, outs ++ out )

        Organizer.LeaveConversation nick ->
            if Maybe.map String.toLower model.activeChannel == Just (String.toLower nick) then
                ( { model
                    | activeChannel = Nothing
                    , navSection = Nav.Messages
                    , navDrawerOpen = True
                    , messageMenu = Nothing
                    , reactionPicker = Nothing
                  }
                , outs
                )

            else
                ( model, outs )


{-| Open a saved message: switch to its conversation, then land on the
row (loaded rows focus at once; a room asks history for the window;
an unloaded DM row says so instead of failing silently). -}
organizeJumpTo : String -> String -> Model -> ( Model, List Outbound )
organizeJumpTo target msgid model =
    let
        ( opened, openOut ) =
            updateCore (ChannelSelect target) model
    in
    case reactionRow opened target msgid of
        Just _ ->
            ( focusMessage opened msgid, openOut )

        Nothing ->
            let
                ( requested, historyOut ) =
                    if isChannelName opened target then
                        requestPinnedMessage opened target msgid

                    else
                        ( opened, [] )
            in
            if List.isEmpty historyOut then
                ( addToast
                    { variant = ToastInfo
                    , title = "Saved message not loaded"
                    , description = Just "It is older than what this device has loaded. Scroll back in the conversation to find it."
                    , duration = Nothing
                    , groupKey = Nothing
                    , undo = Nothing
                    }
                    requested.nowMs
                    requested
                , openOut
                )

            else
                ( requested, openOut ++ historyOut )


{-| Settle: reopen closed DMs that were opened or got a new line from
the other person, bring hidden rooms back on a mention or your own
line, and close the menus an organize action was run from. (Owner
reads leave from `Main.update`, never from here, so an unrelated
update never changes the model or its outbound list.) -}
settleStepOrganize : Msg -> Model -> ( Model, List Outbound ) -> ( Model, List Outbound )
settleStepOrganize msg prior ( m, outs ) =
    let
        live =
            deviceMemoryOwner m

        ( reopened, reopenFx ) =
            Organizer.reopenWhere live (organizeShouldReopen prior m) m.organize

        ( revealed, revealFx ) =
            Organizer.revealWhere live (organizeShouldReveal prior m) reopened

        ( settled, fxOut ) =
            List.foldl organizeEffect ( organizeCloseMenus msg { m | organize = revealed }, [] ) (reopenFx ++ revealFx)
    in
    ( settled, outs ++ fxOut )


{-| A closed DM comes back when you open it, when its unread count
rises, or when a new row from the other person lands after it was
closed (history replays of older rows never reopen it). -}
organizeShouldReopen : Model -> Model -> String -> Float -> Bool
organizeShouldReopen prior m key closedAt =
    let
        before =
            Dict.get key prior.channels
    in
    if Maybe.map String.toLower m.activeChannel == Just key then
        True

    else
        case Dict.get key m.channels of
            Nothing ->
                False

            Just now ->
                let
                    unreadBefore =
                        Maybe.map .unread before |> Maybe.withDefault 0

                    headBefore =
                        before |> Maybe.andThen (.messages >> List.head) |> Maybe.map .id
                in
                now.unread > unreadBefore
                    || (case List.head now.messages of
                            Just row ->
                                Just row.id /= headBefore
                                    && String.toLower row.from /= String.toLower m.ourNick
                                    && toFloat row.at > closedAt

                            Nothing ->
                                False
                       )


{-| A hidden room comes back on a new mention, or when you post in it
(a fresh row of yours, never an old one replayed from history). -}
organizeShouldReveal : Model -> Model -> String -> Bool
organizeShouldReveal prior m key =
    case ( Dict.get key prior.channels, Dict.get key m.channels ) of
        ( Just before, Just now ) ->
            now.highlights > before.highlights
                || (case List.head now.messages of
                        Just row ->
                            Just row.id /= Maybe.map .id (List.head before.messages)
                                && String.toLower row.from == String.toLower m.ourNick
                                && toFloat row.at > m.nowMs - 120000

                        Nothing ->
                            False
                   )

        _ ->
            False


{-| Running an organize action from the room More menu, a message menu
or the You hub closes that surface; muting from the row menu closes
the row menu. -}
organizeCloseMenus : Msg -> Model -> Model
organizeCloseMenus msg m =
    let
        organize =
            m.organize

        rowMenuOpen =
            case organize.sheet of
                Just (Organizer.RowMenu _) ->
                    True

                _ ->
                    False
    in
    case msg of
        OrganizeMsg (Organizer.Loaded _) ->
            m

        OrganizeMsg (Organizer.BookmarkSave _) ->
            { m | messageMenu = Nothing, roomMenuOpen = False }

        OrganizeMsg Organizer.BookmarksOpen ->
            { m | youHubOpen = False, roomMenuOpen = False }

        OrganizeMsg _ ->
            { m | roomMenuOpen = False }

        MuteDm _ ->
            { m
                | roomMenuOpen = False
                , organize =
                    if rowMenuOpen then
                        { organize | sheet = Nothing }

                    else
                        organize
            }

        UnmuteDm _ ->
            { m
                | roomMenuOpen = False
                , organize =
                    if rowMenuOpen then
                        { organize | sheet = Nothing }

                    else
                        organize
            }

        PrefsTogglePref "readerMode" ->
            { m | roomMenuOpen = False }

        _ ->
            m


{-| Gate an alert kind through the notification preset. Power also
lets plain lines in rooms set to All alert (as a follow-style alert);
Calm drops followed-topic alerts. -}
organizePresetKind : Model -> String -> Maybe Notify.NotifyKind -> Maybe Notify.NotifyKind
organizePresetKind model target kind =
    let
        preset =
            model.organize.preset
    in
    case kind of
        Just k ->
            if Attention.allowsAlert preset { dm = k == Notify.Dm, mention = k == Notify.Mention, followed = k == Notify.Follow } then
                Just k

            else
                Nothing

        Nothing ->
            if preset == Attention.Power && isChannelName model target && notifyLevel model target == "all" then
                Just Notify.Follow

            else
                Nothing


{-| Inside today's quiet-hours window (local clock). -}
organizeQuietNow : Model -> Bool
organizeQuietNow model =
    Attention.quietActive model.zone model.nowMs model.organize.quiet


-- v3/gap-account


{-| The four device-memory lists the model holds. -}
gapListsOf : Model -> AccountScope.ListsSnapshot
gapListsOf model =
    { ignored = model.ignoredUsers
    , muted = model.mutedDMs
    , highlights = model.highlightWords
    , notify = model.channelNotify
    }


gapWithLists : AccountScope.ListsSnapshot -> Model -> Model
gapWithLists lists model =
    { model
        | ignoredUsers = lists.ignored
        , mutedDMs = lists.muted
        , highlightWords = lists.highlights
        , channelNotify = lists.notify
    }


gapEmptyLists : AccountScope.ListsSnapshot
gapEmptyLists =
    { ignored = Set.empty, muted = Set.empty, highlights = [], notify = Dict.empty }


setGap : (GapAccount.State -> GapAccount.State) -> Model -> Model
setGap f model =
    { model | gapAccount = f model.gapAccount }


{-| Re-normalize lists exactly like the boot flags (oracle bounds). -}
gapNormalizeLists : AccountScope.ListsSnapshot -> AccountScope.ListsSnapshot
gapNormalizeLists lists =
    { ignored = parseNameBlocklist 512 128 (Set.toList lists.ignored)
    , muted = parseNameBlocklist 512 128 (Set.toList lists.muted)
    , highlights = parseHighlightWords lists.highlights
    , notify = parseChannelNotifyEntries (List.map (\( c, l ) -> { channel = c, level = l }) (Dict.toList lists.notify))
    }


{-| Persist the lists that changed under one scope. -}
gapSaveLists : String -> AccountScope.ListsSnapshot -> AccountScope.ListsSnapshot -> List Outbound
gapSaveLists key before after =
    let
        pick changed v =
            if changed then
                Just v

            else
                Nothing

        payload =
            { ignored = pick (before.ignored /= after.ignored) (Set.toList after.ignored)
            , muted = pick (before.muted /= after.muted) (Set.toList after.muted)
            , highlights = pick (before.highlights /= after.highlights) after.highlights
            , notify = pick (before.notify /= after.notify) (Dict.toList after.notify)
            }
    in
    if payload.ignored == Nothing && payload.muted == Nothing && payload.highlights == Nothing && payload.notify == Nothing then
        []

    else
        [ GapAccountFx (GapAccount.ScopedListsSave { scope = key, lists = GapAccount.encodeLists payload }) ]


gapIsVaultPersist : Outbound -> Bool
gapIsVaultPersist out =
    case out of
        VaultPersist _ ->
            True

        _ ->
            False


{-| A line proving a login on THIS socket: SASL `900`, or the
in-session IDENTIFY notice. -}
gapIsLoginLine : String -> Bool
gapIsLoginLine raw =
    if String.contains " 900 " raw || String.contains "You are now identified as " raw then
        let
            parsed =
                Wire.parseIrcMessage raw
        in
        parsed.nick
            == Nothing
            && (parsed.command
                    == "900"
                    || (parsed.command == "NOTICE" && List.any (String.startsWith "You are now identified as ") parsed.params)
               )

    else
        False


{-| The account authenticated on the current socket (a stale
`accountName` from an earlier socket never counts). -}
gapSocketAccount : Msg -> Model -> Model -> Maybe String
gapSocketAccount msg prior m =
    case msg of
        WsOpened _ ->
            Nothing

        _ ->
            let
                loggedIn =
                    case msg of
                        WsBatchReceived batch ->
                            List.any gapIsLoginLine batch.lines

                        _ ->
                            False
            in
            if m.accountName == Nothing then
                Nothing

            else if loggedIn || prior.accountName /= m.accountName then
                m.accountName

            else
                m.gapAccount.socketAccount


{-| Highest message stamp per conversation: rows at or below it are
never written back after a local-history erase. -}
gapWatermark : Model -> Dict String Int
gapWatermark model =
    Dict.foldl
        (\key ch acc ->
            case List.maximum (List.map .at ch.messages) of
                Just at ->
                    Dict.insert key at acc

                Nothing ->
                    acc
        )
        Dict.empty
        model.channels


gapApplyWatermark : Dict String Int -> Outbound -> Maybe Outbound
gapApplyWatermark marks out =
    case out of
        VaultPersist req ->
            case Dict.get (String.toLower req.target) marks of
                Nothing ->
                    Just out

                Just mark ->
                    case List.filter (\row -> row.at > mark) req.rows of
                        [] ->
                            Nothing

                        rows ->
                            Just (VaultPersist { req | rows = rows })

        _ ->
            Just out


{-| Vault writes go out only with local history on, never in the update
that switched identities (those rows belong to the previous owner's
buffers), and never re-persist rows the user erased this session.
`Main.performIn` additionally refuses any write without a scope. -}
gapGateVault : Bool -> Model -> List Outbound -> List Outbound
gapGateVault scopeChanged m outs =
    if scopeChanged || not m.prefs.localHistory then
        List.filter (not << gapIsVaultPersist) outs

    else if Dict.isEmpty m.gapAccount.clearWatermark then
        outs

    else
        List.filterMap (gapApplyWatermark m.gapAccount.clearWatermark) outs


gapAttention : Model -> Int
gapAttention model =
    AccountScope.attentionCount
        (List.map
            (\ch ->
                let
                    room =
                        isChannelName model ch.name
                in
                { isChannel = room
                , unread = ch.unread
                , highlights = ch.highlights
                , muted = not room && Set.member (String.toLower ch.name) model.mutedDMs
                }
            )
            (Dict.values model.channels)
        )


{-| Scope transitions: resolve the scope from the registered socket,
and on a change clear the previous identity's in-memory lists and vault
views, then ask the bridge for the new scope's lists. -}
gapSettleScope : Msg -> Model -> Model -> ( Model, List Outbound, Bool )
gapSettleScope msg prior m =
    let
        ga =
            m.gapAccount

        -- The scope is re-resolved only when one of its inputs moves
        -- while registered: the socket just registered (001), the
        -- endpoint changed, or the socket's authenticated account
        -- changed (900 / IDENTIFY / logout). Between those events it
        -- sticks — including offline, so queued sends and local reads
        -- keep their owner.
        resolve =
            m.connection
                == Live
                && (prior.connection /= Live || prior.endpoint /= m.endpoint || prior.gapAccount.socketAccount /= ga.socketAccount)

        candidate =
            if resolve then
                AccountScope.scopeFor { endpoint = m.endpoint, account = ga.socketAccount }

            else
                Nothing

        target =
            if resolve then
                Maybe.map AccountScope.scopeKey candidate

            else
                ga.scope

        changed =
            target /= ga.scope

        isLoad =
            case msg of
                GapAccountMsg (GapAccount.ScopedListsLoaded _) ->
                    True

                _ ->
                    False

        priorLists =
            gapListsOf prior

        nowLists =
            gapListsOf m
    in
    if changed then
        let
            -- A guest who signs in / claims the name in this session
            -- keeps the edits made as that guest, and keeps the lists on
            -- screen until the account's own lists load (blocks never
            -- lapse mid-switch).
            guestUpgrade =
                case ( ga.scope, candidate ) of
                    ( Just old, Just cand ) ->
                        cand.account /= Nothing && old == AccountScope.scopeKey { cand | account = Nothing }

                    _ ->
                        False

            carried =
                case ( ga.scope, candidate ) of
                    ( Nothing, _ ) ->
                        -- first scope: edits made while unscoped replay onto it
                        AccountScope.recordDiff priorLists nowLists ga.pendingOps

                    _ ->
                        if guestUpgrade then
                            ga.sessionOps

                        else
                            AccountScope.emptyOps

            -- Any other identity change starts empty, so one identity's
            -- lists are never shown to, or written for, the next.
            base =
                case ga.scope of
                    Nothing ->
                        m

                    Just _ ->
                        if guestUpgrade then
                            m

                        else
                            gapWithLists gapEmptyLists m

            reset =
                { base
                    | vaultRawHits = []
                    , vaultDmPrivacy = Dict.empty
                    , vaultSearchSeq = base.vaultSearchSeq + 1
                    , mediaIndexVault = []
                    , gapAccount =
                        { ga
                            | scope = target
                            , scopeGuest = Maybe.map AccountScope.isGuest candidate == Just True
                            , listsLoadedFor = Nothing
                            , pendingOps = carried
                            , sessionOps = AccountScope.emptyOps
                            , alertQueue = Dict.empty
                            , alertTags = Dict.empty
                            , alertTagOrder = []
                            , clearWatermark = Dict.empty
                            , protectPassword = ""
                            , protectPending = Nothing
                            , protectError = Nothing
                            , protectNotice = Nothing
                            , recoverPending = Nothing
                            , recoverStatus = Nothing
                            , recognize = []
                            , recognizeStatus = Nothing
                            , groupNicks = []
                            , groupStatus = Nothing
                        }
                }

            request =
                case ( target, candidate ) of
                    ( Just key, Just cand ) ->
                        [ GapAccountFx (GapAccount.ScopedListsRequest { scope = key, solidOwners = AccountScope.solidOwnerKeys m.endpoint cand }) ]

                    _ ->
                        []
        in
        ( reset, request, True )

    else if isLoad || priorLists == nowLists then
        ( m, [], False )

    else
        case ( ga.scope, ga.listsLoadedFor ) of
            ( Just key, Just loaded ) ->
                if key == loaded then
                    ( { m
                        | gapAccount =
                            { ga
                                | sessionOps =
                                    if ga.scopeGuest then
                                        AccountScope.recordDiff priorLists nowLists ga.sessionOps

                                    else
                                        ga.sessionOps
                            }
                      }
                    , gapSaveLists key priorLists nowLists
                    , False
                    )

                else
                    ( { m | gapAccount = { ga | pendingOps = AccountScope.recordDiff priorLists nowLists ga.pendingOps } }, [], False )

            _ ->
                ( { m | gapAccount = { ga | pendingOps = AccountScope.recordDiff priorLists nowLists ga.pendingOps } }, [], False )


{-| The encrypted-DM preference takes effect live (every gate reads
`model.e2eeDms`). Turning it on publishes this device's key and asks
for the open DM peer's key; turning it off releases a pending hold's
notice but never sends the held draft — the user sends again, now by
their explicit choice. -}
gapSettleE2ee : Model -> Model -> ( Model, List Outbound )
gapSettleE2ee prior m =
    if prior.prefs.e2eeDms == m.prefs.e2eeDms || m.e2eeDms == m.prefs.e2eeDms then
        ( m, [] )

    else if m.prefs.e2eeDms then
        let
            on =
                { m | e2eeDms = True }

            publish =
                if on.connection == Live then
                    [ DmPublishKey ]

                else
                    []

            ( looked, lookOuts ) =
                case activeDmPeer on of
                    Just peer ->
                        if on.connection == Live && dmKeyUnresolved on peer then
                            requestDmKeyLookup on peer

                        else
                            ( on, [] )

                    Nothing ->
                        ( on, [] )

            queuedDms =
                List.length (List.filter (\row -> not (isChannelName m row.target)) m.outbox)

            warned =
                if queuedDms > 0 then
                    addToast
                        { variant = ToastWarning
                        , title = "Queued direct messages aren't encrypted"
                        , description =
                            Just
                                (String.fromInt queuedDms
                                    ++ " direct message"
                                    ++ (if queuedDms == 1 then
                                            " was"

                                        else
                                            "s were"
                                       )
                                    ++ " queued while encryption was off and will send unencrypted on reconnect. Discard them in Preferences → History & data if you'd rather not."
                                )
                        , duration = Nothing
                        , groupKey = Just "gap-e2ee-queued"
                        , undo = Nothing
                        }
                        m.nowMs
                        looked

                else
                    looked
        in
        ( warned, publish ++ lookOuts )

    else
        let
            heldCopy =
                Maybe.map holdDmCopy m.dmKeyHold
        in
        ( { m
            | e2eeDms = False
            , dmKeyHold = Nothing
            , dmKeyPending = Dict.empty
            , composerError =
                if heldCopy /= Nothing && m.composerError == heldCopy then
                    Nothing

                else
                    m.composerError
          }
        , []
        )


gapSettleSearchStatus : Msg -> Model -> Model
gapSettleSearchStatus msg m =
    let
        status text =
            setGap (\g -> { g | searchStatus = Just text, searchClearConfirm = False }) m
    in
    case msg of
        SearchClearedReceived { cleared } ->
            if cleared then
                status "Saved searches cleared on this device."

            else
                status "Couldn't clear saved searches. Try again."

        SearchImportedReceived { imported } ->
            status ("Imported " ++ GapAccount.savedSearchLabel imported ++ ".")

        SearchExportedReceived { json } ->
            if String.isEmpty json then
                status "Saved searches aren't available in this browser."

            else
                status "Saved searches exported."

        _ ->
            m


{-| Fold the account-protection / name / recognition / group replies
this slice owns from a socket batch. -}
gapFoldReplies : Msg -> Model -> ( Model, List Outbound )
gapFoldReplies msg m =
    case msg of
        WsBatchReceived batch ->
            List.foldl
                (\raw ( acc, outs ) ->
                    if GapAccount.replyLooksRelevant raw then
                        case GapAccount.classifyReply (Wire.parseIrcMessage raw) of
                            Just reply ->
                                let
                                    ( next, more ) =
                                        gapApplyReply reply acc
                                in
                                ( next, outs ++ more )

                            Nothing ->
                                ( acc, outs )

                    else
                        ( acc, outs )
                )
                ( m, [] )
                batch.lines

        _ ->
            ( m, [] )


gapApplyReply : GapAccount.Reply -> Model -> ( Model, List Outbound )
gapApplyReply reply m =
    let
        ga =
            m.gapAccount
    in
    case reply of
        GapAccount.ProtectSaved field ->
            case ga.protectPending of
                Just pending ->
                    if pending.field == field then
                        let
                            ( refreshed, outs ) =
                                requestAccountInfo
                                    (setGap (\g -> { g | protectPending = Nothing, protectError = Nothing, protectNotice = Just (gapProtectSavedCopy pending) }) m)
                                    Nothing
                        in
                        ( refreshed, outs )

                    else
                        ( m, [] )

                Nothing ->
                    ( m, [] )

        GapAccount.ProtectWrongPassword ->
            if ga.protectPending /= Nothing then
                ( setGap (\g -> { g | protectPending = Nothing, protectNotice = Nothing, protectError = Just "That password didn't match. Nothing was changed." }) m, [] )

            else
                ( m, [] )

        GapAccount.ProtectFailed text ->
            if ga.protectPending /= Nothing then
                ( setGap (\g -> { g | protectPending = Nothing, protectNotice = Nothing, protectError = Just text }) m, [] )

            else
                ( m, [] )

        GapAccount.RecoverNotice r ->
            case ga.recoverPending of
                Just pending ->
                    if pending.verb == r.verb then
                        let
                            settled =
                                setGap (\g -> { g | recoverPending = Nothing, recoverStatus = Just { ok = r.ok, text = r.text } }) m

                            -- RECOVER frees the nick and holds it briefly
                            -- for the owner: take it back now.
                            reclaim =
                                if r.verb == "RECOVER" && r.ok && r.nick /= Nothing && String.toLower pending.nick /= String.toLower m.ourNick then
                                    [ SendLine (Wire.formatIrcLine "NICK" [ pending.nick ]) ]

                                else
                                    []
                        in
                        ( settled, reclaim )

                    else
                        ( m, [] )

                Nothing ->
                    ( m, [] )

        GapAccount.RecoverFailed r ->
            case ga.recoverPending of
                Just pending ->
                    if pending.verb == r.verb then
                        ( setGap (\g -> { g | recoverPending = Nothing, recoverStatus = Just { ok = False, text = r.text } }) m, [] )

                    else
                        ( m, [] )

                Nothing ->
                    ( m, [] )

        GapAccount.RecognizeRow mask ->
            if List.member mask ga.recognize || List.length ga.recognize >= GapAccount.maxRecognizeMasks then
                ( setGap (\g -> { g | recognizeLoading = False }) m, [] )

            else
                ( setGap (\g -> { g | recognize = g.recognize ++ [ mask ], recognizeLoading = False }) m, [] )

        GapAccount.RecognizeEmpty ->
            ( setGap (\g -> { g | recognize = [], recognizeLoading = False }) m, [] )

        GapAccount.RecognizeResult r ->
            let
                settled =
                    setGap (\g -> { g | recognizeStatus = Just { ok = r.ok, text = gapRecognizeCopy r } }) m
            in
            if r.ok then
                gapRecognizeList settled

            else
                ( settled, [] )

        GapAccount.RecognizeDenied text ->
            ( setGap (\g -> { g | recognizeLoading = False, recognizeStatus = Just { ok = False, text = text } }) m, [] )

        GapAccount.GroupRow row ->
            ( setGap (\g -> { g | groupNicks = GapAccount.upsertGroupNick row g.groupNicks }) m, [] )

        GapAccount.GroupEnd ->
            ( setGap (\g -> { g | groupLoading = False }) m, [] )

        GapAccount.GroupResult r ->
            let
                settled =
                    setGap (\g -> { g | groupStatus = Just r, groupLoading = False }) m
            in
            if r.ok then
                gapGroupList settled

            else
                ( settled, [] )

        GapAccount.GroupFailed text ->
            ( setGap (\g -> { g | groupLoading = False, groupStatus = Just { ok = False, text = text } }) m, [] )


gapProtectSavedCopy : { field : String, on : Bool } -> String
gapProtectSavedCopy pending =
    case ( pending.field, pending.on ) of
        ( "secure", True ) ->
            "Saved. You're recognised only after you sign in."

        ( "secure", False ) ->
            "Saved. Sign-in is no longer required to be recognised."

        ( "enforce", True ) ->
            "Saved. Guests can't keep your name."

        _ ->
            "Saved. Your name is no longer held for you."


gapRecognizeCopy : { mask : String, ok : Bool, text : String } -> String
gapRecognizeCopy r =
    if String.startsWith "added" r.text then
        r.mask ++ " added."

    else if String.startsWith "removed" r.text then
        r.mask ++ " removed."

    else if String.startsWith "is already" r.text then
        r.mask ++ " is already on your list."

    else if String.startsWith "was not" r.text then
        r.mask ++ " wasn't on your list."

    else if String.contains "full" r.text then
        "Your list is full. Remove an address first."

    else if String.contains "invalid" r.text then
        "That address pattern isn't valid. Use a form like nick!user@host."

    else
        r.text


gapRecognizeList : Model -> ( Model, List Outbound )
gapRecognizeList m =
    if m.connection /= Live || m.accountName == Nothing then
        ( m, [] )

    else
        case GapAccount.recognizeLine "LIST" Nothing of
            Just line ->
                ( setGap (\g -> { g | recognize = [], recognizeLoading = True }) m, [ SendLine line ] )

            Nothing ->
                ( m, [] )


gapGroupList : Model -> ( Model, List Outbound )
gapGroupList m =
    if m.connection /= Live || m.accountName == Nothing then
        ( m, [] )

    else
        case GapAccount.groupLine "LIST" Nothing of
            Just line ->
                ( setGap (\g -> { g | groupNicks = [], groupLoading = True }) m, [ SendLine line ] )

            Nothing ->
                ( m, [] )


{-| Hold a throttled desktop alert so it coalesces instead of being
dropped (mirroring the oracle's `queueCoalesced`). -}
gapQueueAlert : String -> { title : String, label : String, body : String, sender : String, isDm : Bool } -> Model -> Model
gapQueueAlert key alert model =
    let
        private =
            alert.body == "New encrypted message"

        queue =
            model.gapAccount.alertQueue
    in
    case Dict.get key queue of
        Just held ->
            setGap
                (\g ->
                    { g
                        | alertQueue =
                            Dict.insert key
                                { held
                                    | count = min 999 (held.count + 1)
                                    , body = alert.body
                                    , title = alert.title
                                    , sender = alert.sender
                                    , private = held.private || private
                                }
                                queue
                    }
                )
                model

        Nothing ->
            if Dict.size queue >= GapAccount.maxQueuedAlerts then
                model

            else
                setGap
                    (\g ->
                        { g
                            | alertQueue =
                                Dict.insert key
                                    { title = alert.title
                                    , label = alert.label
                                    , body = alert.body
                                    , private = private
                                    , count = 1
                                    , sender = alert.sender
                                    , isDm = alert.isDm
                                    , queuedAt = model.nowMs
                                    }
                                    queue
                        }
                    )
                    model


{-| On each Tick, show queued alerts whose throttle window has passed
— re-deciding against the CURRENT policy (mute, DND, focus, permission
may all have changed since they were queued). -}
gapFlushAlerts : Msg -> Model -> ( Model, List Outbound )
gapFlushAlerts msg m =
    case msg of
        Tick _ ->
            let
                due =
                    Dict.filter
                        (\key _ -> m.nowMs - Maybe.withDefault 0 (Dict.get key m.lastDesktopAt) >= 6000)
                        m.gapAccount.alertQueue
            in
            if Dict.isEmpty due then
                ( m, [] )

            else
                Dict.foldl gapFlushOne
                    ( setGap (\g -> { g | alertQueue = Dict.diff g.alertQueue due }) m, [] )
                    due

        _ ->
            ( m, [] )


gapFlushOne : String -> GapAccount.QueuedAlert -> ( Model, List Outbound ) -> ( Model, List Outbound )
gapFlushOne key alert ( acc, outs ) =
    let
        open =
            Maybe.map String.toLower acc.activeChannel == Just key

        muted =
            if alert.isDm then
                Set.member key acc.mutedDMs || Set.member (String.toLower alert.sender) acc.mutedDMs

            else
                notifyLevel acc key == "none"

        decision =
            Notify.shouldNotify
                { kind =
                    if alert.isDm then
                        Notify.Dm

                    else
                        Notify.Mention
                , isSelf = False
                , muted = muted
                , smartMuted = Set.member (String.toLower alert.sender) acc.ignoredUsers
                , pushEnabled = acc.pushEnabled
                , soundEnabled = False
                , dnd = notifyDndActive acc
                , permission = acc.notifyPermission
                , pageVisible = acc.pageVisible
                , appFocused = acc.appFocused
                , nowMs = acc.nowMs
                , lastDesktopAtMs = Nothing
                , lastSoundAtMs = Nothing
                , desktopThrottleMs = Nothing
                , soundThrottleMs = Nothing
                }
    in
    if decision.desktop && not open then
        ( { acc | lastDesktopAt = Dict.insert key acc.nowMs acc.lastDesktopAt }
        , outs
            ++ [ NotifyAlert
                    { title = GapAccount.coalescedTitle alert
                    , body =
                        if alert.private then
                            "New encrypted message"

                        else
                            alert.body
                    , tag = "onyx-" ++ key
                    , desktop = True
                    , sound = False
                    , volume = acc.soundVolume
                    }
               ]
        )

    else
        ( acc, outs )


{-| Remember which identity raised each desktop alert (click guard). -}
gapRecordAlertTags : List Outbound -> Model -> Model
gapRecordAlertTags outs m =
    List.foldl
        (\out acc ->
            case out of
                NotifyAlert req ->
                    if req.desktop then
                        setGap (GapAccount.rememberAlertTag req.tag (Maybe.withDefault "" acc.gapAccount.scope)) acc

                    else
                        acc

                _ ->
                    acc
        )
        m
        outs


settleStepGapAccount : Msg -> Model -> ( Model, List Outbound ) -> ( Model, List Outbound )
settleStepGapAccount msg prior ( m0, outs0 ) =
    let
        -- The device-global list writers stay in the intent stream
        -- (Main drops them); persistence is per scope, diff-based.
        outs1 =
            outs0

        m1 =
            setGap (\g -> { g | socketAccount = gapSocketAccount msg prior m0 }) m0

        ( m2, scopeOuts, scopeChanged ) =
            gapSettleScope msg prior m1

        ( m3, e2eeOuts ) =
            gapSettleE2ee prior m2

        ( m4, replyOuts ) =
            gapFoldReplies msg m3

        m5 =
            gapSettleSearchStatus msg m4

        ( m6, flushOuts ) =
            gapFlushAlerts msg m5

        -- The Account sheet closing forgets typed secrets and drafts;
        -- opening it lists the recognition masks and grouped names.
        ( m7, panelOuts ) =
            if prior.accountOpen && not m6.accountOpen then
                ( setGap (\g -> { g | protectPassword = "", protectError = Nothing, protectNotice = Nothing, recoverStatus = Nothing, recognizeDraft = "", recognizeStatus = Nothing, groupDraft = "", groupStatus = Nothing }) m6, [] )

            else if not prior.accountOpen && m6.accountOpen then
                let
                    ( listed, recognizeOuts ) =
                        gapRecognizeList m6

                    ( grouped, groupOuts ) =
                        gapGroupList listed
                in
                ( grouped, recognizeOuts ++ groupOuts )

            else
                ( m6, [] )

        outs2 =
            gapGateVault scopeChanged m7 (outs1 ++ e2eeOuts ++ replyOuts ++ flushOuts ++ panelOuts)

        m8 =
            gapRecordAlertTags outs2 m7

        -- The tab title and the installed-app badge read this count
        -- (Main pushes the badge when it moves).
        attention =
            gapAttention m8

        m9 =
            if attention /= m8.gapAccount.badge then
                setGap (\g -> { g | badge = attention }) m8

            else
                m8

        -- Queued sends belong to one scope. A scope that changes on a
        -- LIVE socket (900 / logout) was not covered by the flush the 001
        -- fold already issued, so walk the new owner's queue now (a change
        -- at registration rides that 001 flush; no double walk).
        sessionFlush =
            if scopeChanged && prior.connection == Live && m9.connection == Live && m9.gapAccount.scope /= Nothing then
                [ flushRequest m9 ]

            else
                []
    in
    ( m9, scopeOuts ++ outs2 ++ sessionFlush )


{-| Erase the local vault (turning history off, or Clear). Rows already
in memory are watermarked so they are not written straight back. -}
gapStartErase : Model -> List Outbound -> ( Model, List Outbound )
gapStartErase model outs =
    ( setGap
        (\g ->
            { g
                | erase = GapAccount.Erasing
                , clearConfirm = False
                , historyStatus = Just "Erasing conversations saved in this browser…"
                , clearWatermark = Dict.union (gapWatermark model) g.clearWatermark
            }
        )
        { model | vaultRawHits = [], vaultDmPrivacy = Dict.empty }
    , outs ++ [ GapAccountFx GapAccount.VaultClear ]
    )


{-| Why a confirmed history import cannot be written right now (v3/gap-import
review stays up; nothing is dropped silently). With no scope yet the
bridge refuses the write too, but a scope-less page has no Preferences to
confirm from (the connect gate comes first). -}
gapImportBlocked : Model -> Maybe String
gapImportBlocked model =
    if not model.prefs.localHistory then
        Just "Local history is off, so there's nowhere to import into. Turn it on in History & data first."

    else
        Nothing


gapProtectError : String -> Model -> ( Model, List Outbound )
gapProtectError text model =
    ( setGap (\g -> { g | protectError = Just text, protectNotice = Nothing }) model, [] )


gapRecoverSend : String -> Model -> ( Model, List Outbound )
gapRecoverSend verb model =
    let
        ga =
            model.gapAccount

        nick =
            String.trim
                (if String.isEmpty (String.trim ga.recoverNick) then
                    Maybe.withDefault "" model.accountName

                 else
                    ga.recoverNick
                )

        fail text =
            ( setGap (\g -> { g | recoverStatus = Just { ok = False, text = text } }) model, [] )
    in
    if model.accountName == Nothing then
        fail "Sign in to the account that owns the name first."

    else if model.connection /= Live then
        fail "Reconnect to do this."

    else if ga.recoverPending /= Nothing then
        ( model, [] )

    else if not (GapAccount.isValidNickToken nick) then
        fail "Enter a valid name (no spaces)."

    else
        case
            if verb == "RECOVER" then
                Services.recover nick

            else
                Services.releaseNick nick
        of
            Just line ->
                ( setGap (\g -> { g | recoverPending = Just { verb = verb, nick = nick }, recoverStatus = Nothing }) model, [ SendLine line ] )

            Nothing ->
                fail "Enter a valid name (no spaces)."


updateGapAccount : GapAccount.Msg -> Model -> ( Model, List Outbound )
updateGapAccount sub model =
    let
        ga =
            model.gapAccount
    in
    case sub of
        GapAccount.LocalHistorySet on ->
            if on == model.prefs.localHistory || ga.erase == GapAccount.Erasing then
                ( model, [] )

            else
                let
                    prefs =
                        model.prefs

                    next =
                        { prefs | localHistory = on }

                    updated =
                        { model | prefs = next }

                    stored =
                        [ AppearanceStorePrefs { json = Prefs.encodePreferences next }, appearanceApplyFor updated ]
                in
                if on then
                    ( setGap (\g -> { g | erase = GapAccount.EraseIdle, historyStatus = Just "This browser will remember new conversations again." }) updated, stored )

                else
                    -- Writes stop first (the settle gate reads the pref);
                    -- a failed erase never silently resumes persistence.
                    gapStartErase updated stored

        GapAccount.HistoryClearAsk ->
            ( setGap (\g -> { g | clearConfirm = True, historyStatus = Nothing }) model, [] )

        GapAccount.HistoryClearCancel ->
            ( setGap (\g -> { g | clearConfirm = False }) model, [] )

        GapAccount.HistoryClearConfirm ->
            if ga.erase == GapAccount.Erasing then
                ( model, [] )

            else
                gapStartErase model []

        GapAccount.VaultCleared { ok } ->
            let
                off =
                    not model.prefs.localHistory

                status =
                    case ( ok, off ) of
                        ( True, True ) ->
                            "Local history is off. Conversations saved in this browser were erased."

                        ( True, False ) ->
                            "Local history cleared on this device."

                        ( False, True ) ->
                            "Local history is off, so Onyx won't save new conversations — but stored conversations may remain because the erase couldn't be verified. Try again."

                        ( False, False ) ->
                            "Couldn't clear all local history. Try again after freeing browser storage."
            in
            ( setGap
                (\g ->
                    { g
                        | erase =
                            if ok then
                                GapAccount.EraseVerified

                            else
                                GapAccount.EraseFailed
                        , historyStatus = Just status
                    }
                )
                { model | vaultRawHits = [], vaultDmPrivacy = Dict.empty }
            , []
            )

        GapAccount.SearchClearAsk ->
            ( setGap (\g -> { g | searchClearConfirm = True, searchStatus = Nothing }) model, [] )

        GapAccount.SearchClearCancel ->
            ( setGap (\g -> { g | searchClearConfirm = False }) model, [] )

        GapAccount.SearchClearConfirm ->
            ( setGap (\g -> { g | searchClearConfirm = False, searchStatus = Just "Clearing saved searches…" }) model, [ SearchClearRequest ] )

        GapAccount.SearchExport ->
            ( setGap (\g -> { g | searchStatus = Nothing }) model, [ SearchExportRequest ] )

        GapAccount.SearchImport ->
            ( setGap (\g -> { g | searchStatus = Nothing }) model, [ SearchImportPick ] )

        GapAccount.ExportAsk ->
            ( setGap (\g -> { g | exportConfirm = True }) { model | prefsTransferStatus = Nothing }, [] )

        GapAccount.ExportCancel ->
            ( setGap (\g -> { g | exportConfirm = False }) model, [] )

        GapAccount.ExportConfirm ->
            updateCore PrefsVaultExport (setGap (\g -> { g | exportConfirm = False }) model)

        GapAccount.ProtectPassword value ->
            ( setGap (\g -> { g | protectPassword = String.left 512 value, protectError = Nothing }) model, [] )

        GapAccount.ProtectToggle field on ->
            case model.accountName of
                Nothing ->
                    gapProtectError "Sign in first." model

                Just acct ->
                    if field /= "secure" && field /= "enforce" then
                        ( model, [] )

                    else if model.connection /= Live then
                        gapProtectError "Reconnect to change protection." model

                    else if ga.protectPending /= Nothing then
                        ( model, [] )

                    else if String.isEmpty ga.protectPassword then
                        gapProtectError "Enter your account password to change protection." model

                    else
                        case
                            Services.accountSet acct
                                ga.protectPassword
                                field
                                (if on then
                                    "on"

                                 else
                                    "off"
                                )
                        of
                            Nothing ->
                                -- the secret is cleared either way
                                ( setGap (\g -> { g | protectPassword = "", protectError = Just "That password can't be sent here (it contains spaces or control characters)." }) model, [] )

                            Just line ->
                                ( setGap
                                    (\g ->
                                        { g
                                            | protectPassword = ""
                                            , protectPending = Just { field = field, on = on }
                                            , protectError = Nothing
                                            , protectNotice = Nothing
                                        }
                                    )
                                    model
                                , [ SendLine line ]
                                )

        GapAccount.RecoverNickInput value ->
            ( setGap (\g -> { g | recoverNick = String.left 64 value }) model, [] )

        GapAccount.RecoverSubmit ->
            gapRecoverSend "RECOVER" model

        GapAccount.ReleaseSubmit ->
            gapRecoverSend "RELEASE" model

        GapAccount.RecognizeDraft value ->
            ( setGap (\g -> { g | recognizeDraft = String.left 255 value }) model, [] )

        GapAccount.RecognizeAdd ->
            if model.connection /= Live || model.accountName == Nothing then
                ( model, [] )

            else
                case GapAccount.recognizeLine "ADD" (Just ga.recognizeDraft) of
                    Just line ->
                        ( setGap (\g -> { g | recognizeDraft = "", recognizeStatus = Nothing }) model, [ SendLine line ] )

                    Nothing ->
                        ( setGap (\g -> { g | recognizeStatus = Just { ok = False, text = "Enter one address pattern with no spaces, like nick!user@host." } }) model, [] )

        GapAccount.RecognizeRemove mask ->
            if model.connection /= Live then
                ( model, [] )

            else
                case GapAccount.recognizeLine "DEL" (Just mask) of
                    Just line ->
                        ( setGap (\g -> { g | recognizeStatus = Nothing }) model, [ SendLine line ] )

                    Nothing ->
                        ( model, [] )

        GapAccount.RecognizeRefresh ->
            gapRecognizeList model

        GapAccount.GroupDraft value ->
            ( setGap (\g -> { g | groupDraft = String.left 64 value }) model, [] )

        GapAccount.GroupAdd ->
            if model.connection /= Live || model.accountName == Nothing then
                ( model, [] )

            else
                case GapAccount.groupLine "ADD" (Just ga.groupDraft) of
                    Just line ->
                        ( setGap (\g -> { g | groupDraft = "", groupStatus = Nothing }) model, [ SendLine line ] )

                    Nothing ->
                        ( setGap (\g -> { g | groupStatus = Just { ok = False, text = "Enter one name with no spaces." } }) model, [] )

        GapAccount.GroupRemove nick ->
            gapGroupVerb "DEL" nick model

        GapAccount.GroupPrimary nick ->
            gapGroupVerb "PRIMARY" nick model

        GapAccount.GroupRefresh ->
            gapGroupList model

        GapAccount.ScopedListsLoaded value ->
            case GapAccount.decodeLoaded value of
                Nothing ->
                    ( model, [] )

                Just loaded ->
                    if Just loaded.scope /= ga.scope then
                        -- an answer for a scope we already left
                        ( model, [] )

                    else
                        let
                            stored =
                                { ignored = parseNameBlocklist 512 128 loaded.ignored
                                , muted = parseNameBlocklist 512 128 loaded.muted
                                , highlights = parseHighlightWords loaded.highlights
                                , notify = parseChannelNotifyEntries loaded.notify
                                }

                            merged =
                                gapNormalizeLists (AccountScope.applyOps ga.pendingOps stored)
                        in
                        ( gapWithLists merged
                            (setGap (\g -> { g | listsLoadedFor = Just loaded.scope, pendingOps = AccountScope.emptyOps }) model)
                        , gapSaveLists loaded.scope stored merged
                        )

        GapAccount.NotifyClicked { tag } ->
            case Dict.get tag ga.alertTags of
                Just owner ->
                    if Just owner /= ga.scope then
                        -- raised for another identity: never navigate it
                        ( model, [] )

                    else
                        case Dict.get (String.dropLeft 5 tag) model.channels of
                            Just ch ->
                                let
                                    ( selected, outs ) =
                                        updateCore (ChannelSelect ch.name) { model | searchOpen = False }
                                in
                                ( selected
                                , (if model.route /= Route.App then
                                    [ PushUrl "/app" ]

                                   else
                                    []
                                  )
                                    ++ outs
                                )

                            Nothing ->
                                ( model, [] )

                Nothing ->
                    ( model, [] )


gapGroupVerb : String -> String -> Model -> ( Model, List Outbound )
gapGroupVerb verb nick model =
    if model.connection /= Live then
        ( model, [] )

    else
        case GapAccount.groupLine verb (Just nick) of
            Just line ->
                ( setGap (\g -> { g | groupStatus = Nothing }) model, [ SendLine line ] )

            Nothing ->
                ( model, [] )
