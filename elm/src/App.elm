{-| Channel directory (`LIST` fold), mirroring the oracle `channelList`
slice: `refreshChannelList` sends `LIST` while live (offline keeps the
cached directory and never implies loading; a second refresh while one
is in flight, or while quarantined, is a no-op), `322` rows merge into
the in-flight request only while loading and unquarantined (stray rows
never populate retained UI state), and `323` commits the request over
the visible list.

`mergeChannelListRow` mirrors the oracle exactly: names must open with
`#`/`&` and carry no comma (plus the shared wire-token bound);
duplicates keep the first-seen name, take the max count, and fill a
blank topic only; the request caps at `maxChannelListEntries` (2048)
while duplicates always merge. Counts clamp at zero (Elm `Int` has no
non-safe-integer hole — `String.toInt` failure reads as 0, matching the
oracle's `parseInt || 0` fallback shape); topics bound at
`maxToastTextLength` like other system text.

The 15s watchdog mirrors the oracle timer on the 1s Tick (no new
ports): on expiry the generation turns, the socket quarantines (late
rows drop until its `323` releases it), and the visible list falls back
to the last committed directory. `_resetChannelListTransport` (connect
/ reconnect / ownership change) maps to `resetChannelListTransport`:
generation turns, the deadline clears, quarantine releases. The browser
sheet itself (search/sort/join machine, room formation) stays ahead —
this slice is the directory data plane it will read.
-}
type alias ChannelListEntry =
    { name : String
    , count : Int
    , topic : String
    }


maxChannelListEntries : Int
maxChannelListEntries =
    2048


channelListTimeoutMs : Float
channelListTimeoutMs =
    15000


mergeChannelListRow : List ChannelListEntry -> ChannelListEntry -> List ChannelListEntry
mergeChannelListRow rows next =
    let
        head =
            String.left 1 next.name

        -- A directory row is server-shaped: the shared wire-token gate
        -- (mirroring `_validInboundWireToken`, control class included)
        -- plus the channel sigil, exactly like the oracle merge.
        valid =
            validWireToken next.name 512 && (head == "#" || head == "&")
    in
    if not valid then
        rows

    else
        let
            key =
                String.toLower next.name

            normalized =
                { name = next.name
                , count = max 0 next.count
                , topic = boundSystemEventText next.topic
                }

            mergeInto existing =
                if String.toLower existing.name /= key then
                    existing

                else
                    { name = existing.name
                    , count = max existing.count normalized.count
                    , topic =
                        if String.isEmpty (String.trim existing.topic) then
                            normalized.topic

                        else
                            existing.topic
                    }
        in
        if List.any (\row -> String.toLower row.name == key) rows then
            List.map mergeInto rows

        else if List.length rows < maxChannelListEntries then
            rows ++ [ normalized ]

        else
            rows


parseChannelListRow : List String -> Maybe ChannelListEntry
parseChannelListRow params =
    case params of
        _ :: name :: countRaw :: rest ->
            if String.isEmpty name then
                Nothing

            else
                Just
                    { name = name
                    -- Member counts read like every other wire count
                    -- (mirroring `parseInt` + the safe-integer floor:
                    -- prefixes parse, garbage/overflow/negatives zero).
                    , count = Services.boundedNumber (Just countRaw)
                    , topic = trailingParam rest
                    }

        _ ->
            Nothing


openBrowser : Model -> ( Model, List Outbound )
openBrowser model =
    refreshChannelList { model | browserOpen = True, browserMode = BrowseMode }


statsRoomHref : String -> String
statsRoomHref channel =
