        SearchHotkey ->
            -- Ctrl/Cmd+F (mirroring `handleMessageSearchHotkey` →
            -- `openMessageSearch`): opens the unified panel bare; an
            -- already-open panel stays open with its query intact.
            if model.searchOpen then
                ( model, [] )

            else
                ( scheduleVaultSearch { model | searchOpen = True, composer = "" }, [] )

        RetentionKeepSelected raw ->
            -- Keep-count segmented control (mirroring `setKeep`:
            -- unlisted values fall back to the 400 default).
            case String.toInt (String.trim raw) of
                Just keep ->
                    if List.member keep Retention.keepOptions then
                        let
                            current =
                                model.retentionPolicy
                        in
                        saveRetentionPolicy model { current | keep = keep }

                    else
                        let
                            current =
                                model.retentionPolicy
                        in
                        saveRetentionPolicy model { current | keep = Retention.defaultKeep }

                Nothing ->
                    let
                        current =
                            model.retentionPolicy
                    in
                    saveRetentionPolicy model { current | keep = Retention.defaultKeep }

        RetentionAgeSelected raw ->
            -- Age-cutoff segmented control (mirroring `setAge`:
            -- `none` drops the cutoff, unlisted values drop it too,
            -- per-channel overrides ride along untouched).
            case String.trim raw of
                "7" ->
                    let
                        current =
                            model.retentionPolicy
                    in
                    saveRetentionPolicy model { current | maxAgeDays = Just 7 }

                "30" ->
                    let
                        current =
                            model.retentionPolicy
                    in
                    saveRetentionPolicy model { current | maxAgeDays = Just 30 }

                "90" ->
                    let
                        current =
                            model.retentionPolicy
                    in
                    saveRetentionPolicy model { current | maxAgeDays = Just 90 }

                "365" ->
                    let
                        current =
                            model.retentionPolicy
                    in
                    saveRetentionPolicy model { current | maxAgeDays = Just 365 }

                _ ->
                    let
                        current =
                            model.retentionPolicy
                    in
                    saveRetentionPolicy model { current | maxAgeDays = Nothing }

        RetentionPolicyLoaded value ->
            -- Stored policy adopted silently (mirroring the subscribe
            -- fold: sanitize-then-hold, no status line).
            ( { model | retentionPolicy = Retention.sanitizePolicy (Retention.decodeRawPolicy value) }, [] )

        RetentionRadioKey { group, current, key } ->
            -- Arrow/Home/End move within one retention radio group
            -- (mirroring the Appearance chips: DOM focus travel stays
            -- a documented narrowing).
            case radioTarget (retentionOptionIds group) current key of
                Nothing ->
                    ( model, [] )

                Just target ->
                    if group == "keep" then
                        update (RetentionKeepSelected target) model

                    else
                        update (RetentionAgeSelected target) model

        RetentionPolicyApplied { saved, pruned } ->
            -- Save/prune receipt (mirroring the oracle status branches).
            ( { model
                | retentionStatus =
                    Just
                        (if saved && pruned then
                            "Local history limit saved and existing messages pruned for this device."

                         else if saved then
                            "Local history limit saved; the vault is unavailable in this browser session."

                         else
                            "Limit applied for this session, but this browser could not save it."
                        )
              }
            , []
            )

        SearchQuery { query } ->
            -- Bounded input with spaces preserved; a new query
            -- restarts at the first match (mirroring `setQuery`) and
            -- re-arms the debounced vault scan.
            ( scheduleVaultSearch { model | searchQuery = Search.boundQueryInput query, searchIndex = 0 }, [] )

        SearchNext ->
            ( { model | searchIndex = Search.moveIndex 1 (List.length (searchResults model)) model.searchIndex }, [] )

        CycleVaultSearchMode ->
            -- In-search toggle cycles hybrid → exact → semantic
            -- (mirroring VAULT_MODE_CYCLE) and persists the pick as
            -- the default for fresh searches.
            let
                next =
                    cycleVaultSearchMode model.vaultSearchMode

                switched =
                    scheduleVaultSearch { model | vaultSearchMode = next, vaultSearchModeShown = next }
            in
            ( switched, [ VaultSearchModeSave { mode = vaultSearchModeToString next } ] )

        SetVaultSearchMode mode ->
            let
                switched =
                    scheduleVaultSearch { model | vaultSearchMode = mode, vaultSearchModeShown = mode }
            in
            ( switched, [ VaultSearchModeSave { mode = vaultSearchModeToString mode } ] )

        SearchPrevious ->
            ( { model | searchIndex = Search.moveIndex -1 (List.length (searchResults model)) model.searchIndex }, [] )

        SearchRunSaved { id } ->
            case List.filter (\saved -> saved.id == id) model.savedSearches |> List.head of
                Just saved ->
                    ( scheduleVaultSearch { model | searchQuery = Search.boundQueryInput saved.query, searchIndex = 0 }, [] )

                Nothing ->
                    ( model, [] )

        SearchRunServer ->
            runServerSearch model

        ServerOpenResult { target } ->
            -- Archived hit: navigate to its conversation and close
            -- (mirroring `openVaultResult` minus hydration — server
            -- time-travel needs the CHATHISTORY request half, so no
            -- vault-around approximation lands a possibly wrong
            -- window; the row stays visible in the live view).
            update (ChannelSelect target) (invalidateVaultSearch { model | searchOpen = False })

        SearchDeleteSaved { id } ->
            ( model, [ SearchDelete { id = id } ] )

        SearchSaveName { name } ->
            ( { model | searchSaveName = Search.safeSlice Search.maxSaveLabelLength name }, [] )

        SearchSaveCurrent ->
            let
                label =
                    String.trim model.searchSaveName

                query =
                    String.trim model.searchQuery
            in
            if String.isEmpty label || String.isEmpty query then
                ( model, [] )

            else
                ( { model | searchSaveName = "" }, [ SearchSave { label = label, query = query, mode = "exact" } ] )

        NavMenuEscape ->
            -- Escape closes the nav menu everywhere; on the
            -- appearance route it also cancels a staged background
            -- (mirroring the page's Escape-to-cancel).
            if model.route == Route.Appearance && backgroundDirty model then
                ( { model | navMenuOpen = False, clientRoomsOpen = False, clientMembersOpen = False, backgroundCandidate = model.backgroundId, backgroundPreview = Nothing }, [] )

            else
                ( { model | navMenuOpen = False, clientRoomsOpen = False, clientMembersOpen = False }, [] )

        SelectRoadmapPriority { state } ->
            -- Legend clicks name a known priority; anything else
            -- (including a forged port event) keeps the old one.
            if List.member state roadmapStates then
                ( { model | roadmapPriority = Just state }, [] )

            else
                ( model, [] )

        InviteNameInput value ->
            ( { model | inviteName = value, inviteNameError = Invite.guestNameError value }, [] )

        InviteCopyRequest ->
            -- Single-flight like the oracle's `copyBusy` guard; a stale
            -- result for a non-busy copy is ignored on arrival.
            if model.inviteCopy == CopyBusy then
                ( model, [] )

            else
                ( { model | inviteCopy = CopyBusy }, [ ClipboardCopy { text = (inviteCard model).url, tag = "invite" } ] )

        ClipboardResult { tag, ok } ->
            -- Results route by tag (the port echoes the request tag),
            -- so independent copy buttons never steal each other's
            -- result. A stale result for a non-busy consumer is ignored.
            if tag == "invite" then
                if model.inviteCopy == CopyBusy then
                    ( { model | inviteCopy = (if ok then CopyCopied else CopyFailed) }, [] )

                else
                    ( model, [] )

            else if tag == "guides-plan" then
                if model.guidesShare == ShareCopying then
                    ( { model | guidesShare = (if ok then ShareCopied else ShareFailed) }, [] )

                else
                    ( model, [] )

            else if String.startsWith "dl:" tag then
                ( { model | downloadCopies = Dict.insert (String.dropLeft 3 tag) (downloadCopyResult ok model.nowMs) model.downloadCopies }, [] )

            else if tag == "create-invite" then
                ( foldCreateCopyResult model ok, [] )

            else if tag == "moment" then
                -- Mirrors the menu's moment-link report copy verbatim.
                if ok then
                    ( addToast
                        { variant = ToastSuccess
                        , title = "Moment copied"
                        , description = Just "Moment link copied."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        model
                    , []
                    )

                else
                    ( addToast
                        { variant = ToastError
                        , title = "Copy failed"
                        , description = Just "Allow clipboard access in this browser and try again."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        model
                    , []
                    )

            else if tag == "translation-copy" then
                -- Menu translation copy reports inline (mirroring the
                -- menu copy status, not a toast).
                case model.translationCopyPending of
                    Nothing ->
                        ( model, [] )

                    Just pending ->
                        case Dict.get pending.msgid model.translations of
                            Nothing ->
                                ( { model | translationCopyPending = Nothing }, [] )

                            Just entry ->
                                ( { model
                                    | translationCopyPending = Nothing
                                    , translations =
                                        Dict.insert pending.msgid
                                            (if ok then
                                                { entry | copy = TranslationCopied }

                                             else
                                                { entry | copy = TranslationCopyFailed }
                                            )
                                            model.translations
                                  }
                                , []
                                )

            else if tag == "message-copy" then
                -- Mirrors the menu's message-text report copy verbatim.
                if ok then
                    ( addToast
                        { variant = ToastSuccess
                        , title = "Message copied"
                        , description = Just "Message text copied."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        model
                    , []
                    )

                else
                    ( addToast
                        { variant = ToastError
                        , title = "Copy failed"
                        , description = Just "Allow clipboard access in this browser and try again."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        model
                    , []
                    )

            else if String.startsWith "member-copy:" tag then
                -- Mirrors the card's copy-name report copy verbatim.
                let
                    copied =
                        String.dropLeft (String.length "member-copy:") tag
                in
                if ok then
                    ( addToast
                        { variant = ToastSuccess
                        , title = "Name copied"
                        , description = Just (copied ++ " is on the clipboard.")
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        model
                    , []
                    )

                else
                    ( addToast
                        { variant = ToastWarning
                        , title = "Could not copy name"
                        , description = Just "Clipboard access was denied in this browser."
                        , duration = Nothing
                        , groupKey = Nothing
                        , undo = Nothing
                        }
                        model.nowMs
                        model
                    , []
                    )

            else if tag == "stats-compare" then
                -- A result for a previous selection never announces the
                -- new one: only the in-flight copy owns its result.
                if model.statsShare == StatsShareCopying then
                    ( { model | statsShare = (if ok then StatsShareCopied else StatsShareFailed) }, [] )

                else
                    ( model, [] )

            else if tag == "ts:export" then
                studioCopyResult model "export" ok

            else if tag == "ts:seed" then
                studioCopyResult model "seed" ok

            else if tag == "ts:share" then
                studioCopyResult model "share" ok

            else if tag == "totp-secret" then
                if model.totpSecretCopy == TotpCopyBusy then
                    ( { model | totpSecretCopy = (if ok then TotpCopyCopied else TotpCopyFailed) }, [] )

                else
                    ( model, [] )

            else if tag == "totp-otpauth" then
                if model.totpOtpauthCopy == TotpCopyBusy then
                    ( { model | totpOtpauthCopy = (if ok then TotpCopyCopied else TotpCopyFailed) }, [] )

                else
                    ( model, [] )

            else
                ( model, [] )

        GuidesToggleStep { id } ->
            -- Unknown ids (including forged events) never enter the
            -- set; the write path allowlists again anyway.
            if not (List.member id Guides.guideStepIds) then
                ( model, [] )

            else
                let
                    next =
                        if List.member id model.guidesCompleted then
                            List.filter (\kept -> kept /= id) model.guidesCompleted

                        else
                            model.guidesCompleted ++ [ id ]
                in
                ( { model | guidesCompleted = next, guidesShare = ShareIdle }
                , [ GuidesProgressStore { ids = Guides.filterProgressIds Guides.guideStepIds next } ]
                )

        GuidesResetPlan ->
            ( { model | guidesCompleted = [], guidesShare = ShareIdle }
            , [ GuidesProgressStore { ids = [] } ]
            )

        GuidesCopyPlan ->
            if model.guidesShare == ShareCopying then
                ( model, [] )

            else
                ( { model | guidesShare = ShareCopying }, [ ClipboardCopy { text = guidesPlanExport model, tag = "guides-plan" } ] )

        DownloadCopyRequest { key } ->
            -- Each button copies independently (mirroring the oracle
            -- `CopyButton`); unknown keys and unpublished hashes stay
            -- silent.
            case downloadCopyForKey model key of
                Just text ->
                    ( model, [ ClipboardCopy { text = text, tag = "dl:" ++ key } ] )

                Nothing ->
                    ( model, [] )

        StatsRefetch ->
            -- Manual refresh refetches the index and the followed
            -- room (mirroring the Refresh control); the last good
            -- sample stays painted while the next loads.
            let
                ( withIndex, indexOut ) =
                    requestStatsIndex False model

                followed =
                    statsInspectedChannel withIndex
            in
            if String.isEmpty followed then
                ( withIndex, indexOut )

            else
                let
                    ( withDetail, detailOut ) =
                        requestStatsDetailFor withIndex followed
                in
                ( withDetail, indexOut ++ detailOut )

        StatsSortSelect sort ->
            ( { model | statsRoomSort = sort }, [] )

        StatsScopeSelect scope ->
            ( { model | statsRoomScope = scope }, [] )

        StatsQueryInput value ->
            ( { model | statsRoomQuery = value }, [] )

        StatsInspect { channel } ->
            -- User-activated reveal: the inspector scrolls into view
            -- and takes focus (never on initial load — only here).
            let
                ( withDetail, detailOut ) =
                    requestStatsDetailFor
                        { model | statsInspected = channel, statsShare = StatsShareIdle }
                        channel
            in
            ( withDetail
            , detailOut ++ [ HistoryReplace { url = statsPageUrl withDetail }, StatsRevealInspector ]
            )

        StatsToggleCompare { channel } ->
            let
                key =
                    String.toLower channel

                current =
                    model.statsCompare

                existing =
                    List.filter (\room -> String.toLower room == key) current |> List.head

                next =
                    case existing of
                        Just _ ->
                            List.filter (\room -> String.toLower room /= key) current

                        Nothing ->
                            if List.length current >= Stats.maxCompareRooms then
                                current

                            else
                                current ++ [ channel ]
            in
            if next == current then
                ( model, [] )

            else
                let
                    updated =
                        { model | statsCompare = next, statsShare = StatsShareIdle }
                in
                ( updated, [ HistoryReplace { url = statsPageUrl updated } ] )

        StatsClearCompare ->
            if List.isEmpty model.statsCompare then
                ( model, [] )

            else
                let
                    updated =
                        { model | statsCompare = [], statsShare = StatsShareIdle }
                in
                ( updated, [ HistoryReplace { url = statsPageUrl updated } ] )

        StatsWindowSelect { window } ->
            let
                next =
                    if window == 7 then
                        7

                    else
                        14

                updated =
                    { model | statsWindow = next, statsShare = StatsShareIdle }
            in
            ( updated, [ HistoryReplace { url = statsPageUrl updated } ] )

        StatsCopyCompare ->
            -- Single-flight like the other share buttons; an empty
            -- href (fewer than two valid rooms) copies nothing.
            if model.statsShare == StatsShareCopying then
                ( model, [] )

            else
                let
                    href =
                        statsShareHref model
                in
                if String.isEmpty href then
                    ( model, [] )

                else
                    ( { model | statsShare = StatsShareCopying }
                    , [ ClipboardCopy { text = href, tag = "stats-compare" } ]
                    )

        AppearanceSnapshot raw ->
            -- Boot/mount snapshot from the ports side: five slots,
            -- each validated fail-closed, then one DOM application.
            let
                get name =
                    Decode.decodeValue (Decode.field name Decode.string) raw
                        |> Result.toMaybe
                        |> Maybe.withDefault ""

                customs =
                    ThemeLook.decodeCustomThemeRefs (Maybe.withDefault "" (Decode.decodeValue (Decode.field "customThemesJson" Decode.string) raw |> Result.toMaybe))

                prefs =
                    Prefs.decodePreferences (get "prefsJson")
                        (let
                            legacy =
                                get "legacyContrast"
                         in
                         if String.isEmpty legacy then
                            Nothing

                         else
                            Just legacy
                        )

                motion =
                    Prefs.parseSceneMotion (get "sceneMotion") |> Maybe.withDefault Prefs.SceneAdaptive

                storedTheme =
                    get "themeId"

                theme =
                    ThemeLook.normalizeThemeId storedTheme customs |> Maybe.withDefault ThemeLook.defaultThemeId

                storedBackground =
                    get "backgroundId"

                background =
                    if String.isEmpty storedBackground then
                        ThemeLook.autoBackgroundId

                    else
                        storedBackground

                customsFull =
                    Studio.reviveCustomThemes ThemeTokens.themeIds (get "customThemesJson")

                eyeDropperSupported =
                    Decode.decodeValue (Decode.oneOf [ Decode.field "eyeDropperSupported" Decode.bool, Decode.succeed False ]) raw
                        |> Result.withDefault False

                seeded =
                    { model
                        | prefs = prefs
                        , prefsReady = True
                        , sceneMotion = motion
                        , themeId = theme
                        , customThemes = customs
                        , backgroundId = background
                        , backgroundCandidate = background
                        , backgroundPreview = Nothing
                        , studioCustoms = customsFull
                        , studioEyeDropperSupported = eyeDropperSupported
                        , studioBootTheme = Nothing
                    }
            in
            -- A parked `?theme=` share code imports once the stored
            -- list is revived (mirroring the provider boot import);
            -- the param strips either way so refresh never re-imports.
            case model.studioBootTheme of
                Nothing ->
                    ( seeded, [ appearanceApplyFor seeded ] )

                Just code ->
                    case Studio.decodeThemeShare ThemeTokens.themeIds code of
                        Nothing ->
                            ( seeded, [ appearanceApplyFor seeded, StudioStripShareParam ] )

                        Just parsed ->
                            let
                                ( themeCreated, persisted ) =
                                    Studio.addCustomTheme ThemeTokens.themeIds customsFull parsed.name parsed.base parsed.overrides

                                imported =
                                    { seeded
                                        | studioCustoms = persisted
                                        , customThemes = studioCustomRefs persisted
                                        , themeId = themeCreated.id
                                    }
                            in
                            ( imported
                            , [ StudioStoreCustomThemes { json = encodeStudioCustoms persisted }
                              , AppearanceStoreTheme { id = themeCreated.id }
                              , appearanceApplyFor imported
                              , StudioStripShareParam
                              ]
                            )

        AppearanceSetPref { key, value } ->
            -- Unknown keys and invalid values keep the current
            -- preference (mirroring the typed `setPreference`).
            let
                next =
                    Prefs.updatePreference model.prefs key value
            in
            if next == model.prefs then
                ( model, [] )

            else
                let
                    updated =
                        { model | prefs = next }
                in
                ( updated
                , [ AppearanceStorePrefs { json = Prefs.encodePreferences next }
                  , appearanceApplyFor updated
                  ]
                )

        AppearanceToggleReduceMotion ->
            let
                prefs =
                    model.prefs

                next =
                    { prefs | reduceMotion = not prefs.reduceMotion }

                updated =
                    { model | prefs = next }
            in
            ( updated
            , [ AppearanceStorePrefs { json = Prefs.encodePreferences next }
              , appearanceApplyFor updated
              ]
            )

        AppearanceToggleSceneMotion ->
            -- The page toggles between off and adaptive only
            -- (mirroring the `Use less data` switch).
            let
                next =
                    if model.sceneMotion == Prefs.SceneOff then
                        Prefs.SceneAdaptive

                    else
                        Prefs.SceneOff

                updated =
                    { model | sceneMotion = next }
            in
            ( updated
            , [ AppearanceStoreSceneMotion { value = Prefs.sceneMotionToString next }
              , appearanceApplyFor updated
              ]
            )

        AppearanceSetTheme { id } ->
            -- Unknown ids (including forged events) never apply.
            case ThemeLook.normalizeThemeId id model.customThemes of
                Nothing ->
                    ( model, [] )

                Just valid ->
                    if valid == model.themeId then
                        ( model, [] )

                    else
                        -- A base change clears the studio session
                        -- (mirroring the provider effect) so the new
                        -- theme's values render cleanly.
                        let
                            updated =
                                studioResetSession { model | themeId = valid }
                        in
                        ( updated
                        , [ AppearanceStoreTheme { id = valid }
                          , appearanceApplyFor updated
                          ]
                        )

        AppearanceStageBackground { id } ->
            -- Staging is selection without persistence; unknown ids
            -- (and the auto sentinel, which always resolves) stage
            -- through the same resolver on render.
            if id /= ThemeLook.autoBackgroundId && not (List.any (\option -> option.id == id) ThemeLook.backgroundOptions) then
                ( model, [] )

            else
                -- Staging also cancels any pending hover preview
                -- (mirroring the picker's click clearing its timer).
                ( { model | backgroundCandidate = id, backgroundPreview = Nothing }
                , [ BackgroundPreviewRequest { id = "" } ]
                )

        AppearancePreviewBackground { id } ->
            -- The 160ms hover delay lives ports-side; Elm only asks.
            -- Empty clears the preview.
            ( model, [ BackgroundPreviewRequest { id = id } ] )

        AppearancePreviewed { id } ->
            -- Stale previews (route left, or a newer stage already
            -- landed) never paint.
            if model.route /= Route.Appearance then
                ( model, [] )

            else if String.isEmpty id then
                ( { model | backgroundPreview = Nothing }, [] )

            else
                ( { model | backgroundPreview = Just id }, [] )

        AppearanceApplyBackground ->
            if not (backgroundDirty model) then
                ( model, [] )

            else
                let
                    updated =
                        { model | backgroundId = model.backgroundCandidate, backgroundPreview = Nothing }
                in
                ( updated
                , [ AppearanceStoreBackground { id = updated.backgroundId }
                  , appearanceApplyFor updated
                  ]
                )

        AppearanceCancelBackground ->
            ( { model | backgroundCandidate = model.backgroundId, backgroundPreview = Nothing }, [] )

        AppearanceRadioKey { ids, current, key } ->
            -- Arrow/Home/End move selection within one radio group
            -- (mirroring `moveRadioGroup`'s click; DOM focus travel
            -- stays a documented narrowing, as on the OnyxOS tabs).
            -- The resolved id names its own setter: themes apply,
            -- backgrounds stage, the rest are preferences.
            case radioTarget ids current key of
                Nothing ->
                    ( model, [] )

                Just target ->
                    if ThemeLook.normalizeThemeId target model.customThemes /= Nothing then
                        update (AppearanceSetTheme { id = target }) model

                    else if target == ThemeLook.autoBackgroundId || List.any (\option -> option.id == target) ThemeLook.backgroundOptions then
                        update (AppearanceStageBackground { id = target }) model

                    else
                        update (AppearanceSetPref { key = prefKeyForValue target, value = target }) model

        StudioTokenInput { property, value } ->
            -- Live values apply unvalidated (mirroring
            -- `handleTokenChange`); the save boundary validates.
            let
                updated =
                    { model | studioOverrides = Dict.insert property value model.studioOverrides }
            in
            ( updated, [ appearanceApplyFor updated ] )

        StudioTokenReset { property } ->
            let
                updated =
                    { model | studioOverrides = Dict.remove property model.studioOverrides }
            in
            ( updated, [ appearanceApplyFor updated ] )

        StudioGenerate ->
            let
                updated =
                    studioGenerate model model.studioSeed
            in
            ( updated, [ appearanceApplyFor updated ] )

        StudioSeedScheme { scheme } ->
            -- An unarmed knob only turns the seed (mirroring
            -- `updateSeed` pre-generate); the apply rides live
            -- re-generation once armed.
            if scheme == "dark" || scheme == "light" then
                let
                    updated =
                        studioPatchSeed model (\seed -> { seed | scheme = scheme })
                in
                ( updated, studioSeedOut updated )

            else
                ( model, [] )

        StudioSeedNumber { field, value } ->
            if List.member field seedFieldNames && not (isNaN value) && not (isInfinite value) then
                let
                    updated =
                        studioPatchSeed model (studioSeedField field value)
                in
                ( updated, studioSeedOut updated )

            else
                ( model, [] )

        StudioSeedColor { field, hex } ->
            case Studio.sampledAccentSeed hex of
                Just sampled ->
                    if field == "primary" then
                        let
                            updated =
                                studioPatchSeed model (\seed -> { seed | primaryHue = sampled.hue })
                        in
                        ( updated, studioSeedOut updated )

                    else if field == "accent" then
                        let
                            updated =
                                studioPatchSeed model (\seed -> { seed | accentHue = sampled.hue })
                        in
                        ( updated, studioSeedOut updated )

                    else
                        ( model, [] )

                Nothing ->
                    ( model, [] )

        StudioRandomize ->
            -- `nowMs` millis are the seed entropy (the oracle rolls
            -- `Math.random`; Elm stays pure and the clock differs
            -- every click).
            let
                updated =
                    studioGenerate model (Theme.randomSeed (round model.nowMs))
            in
            ( updated, [ appearanceApplyFor updated ] )

        StudioSeedFromCurrent ->
            ( { model | studioSeed = Theme.seedFromTokens (studioResolvedTokens model) (studioActiveScheme model) }, [] )

        StudioExportSeed ->
            if model.studioSeedBusy then
                ( model, [] )

            else
                ( { model | studioSeedBusy = True, studioSeedCopied = False, studioSeedCopyFailure = Nothing }
                , [ ClipboardCopy { text = Studio.exportThemeSeed (studioThemeLabel model) model.studioSeed, tag = "ts:seed" } ]
                )

        StudioImportSeedRequest ->
            ( model, [ StudioPromptRequest { kind = "seed" } ] )

        StudioImportRequest ->
            ( model, [ StudioPromptRequest { kind = "blob" } ] )

        StudioPromptResult { kind, text } ->
            case text of
                Nothing ->
                    ( model, [] )

                Just raw ->
                    if String.isEmpty raw then
                        ( model, [] )

                    else if kind == "seed" then
                        case Studio.parseThemeSeed raw of
                            Err error ->
                                ( { model | studioImportError = Just error }, [] )

                            Ok parsed ->
                                let
                                    updated =
                                        studioGenerate { model | studioImportError = seedWarningsError parsed.warnings } parsed.seed
                                in
                                ( updated, [ appearanceApplyFor updated ] )

                    else if kind == "blob" then
                        case Studio.parseThemeExport ThemeTokens.themeIds raw of
                            Err error ->
                                ( { model | studioImportError = Just error }, [] )

                            Ok blob ->
                                -- `setTheme` then overrides (the oracle's
                                -- microtask collapses into one fold).
                                let
                                    cleared =
                                        studioResetSession { model | themeId = blob.base, studioImportError = Nothing }

                                    updated =
                                        { cleared | studioOverrides = blob.overrides }
                                in
                                ( updated
                                , [ AppearanceStoreTheme { id = blob.base }
                                  , appearanceApplyFor updated
                                  ]
                                )

                    else
                        ( model, [] )

        StudioAdjustStart ->
            case model.studioAdjustBaseline of
                Just _ ->
                    ( model, [] )

                Nothing ->
                    ( { model | studioAdjustBaseline = Just { resolved = studioResolvedTokens model, overrides = model.studioOverrides } }, [] )

        StudioAdjustPatch { field, value } ->
            if field /= "hueShift" && field /= "saturation" && field /= "warmth" && field /= "contrast" then
                ( model, [] )

            else if not (isNaN value) && not (isInfinite value) then
                let
                    withBaseline =
                        case model.studioAdjustBaseline of
                            Just _ ->
                                model

                            Nothing ->
                                { model | studioAdjustBaseline = Just { resolved = studioResolvedTokens model, overrides = model.studioOverrides } }

                    updated =
                        studioApplyAdjust withBaseline (studioAdjustField field value model.studioAdjust)
                in
                ( updated, [ appearanceApplyFor updated ] )

            else
                ( model, [] )

        StudioAdjustBake ->
            ( { model | studioAdjustBaseline = Nothing, studioAdjust = Studio.adjustIdentity }, [] )

        StudioAdjustRevert ->
            case model.studioAdjustBaseline of
                Nothing ->
                    ( { model | studioAdjust = Studio.adjustIdentity }, [] )

                Just baseline ->
                    let
                        updated =
                            { model | studioAdjustBaseline = Nothing, studioAdjust = Studio.adjustIdentity, studioOverrides = baseline.overrides }
                    in
                    ( updated, [ appearanceApplyFor updated ] )

        StudioAutoFix ->
            let
                updated =
                    { model
                        | studioOverrides =
                            Studio.diffOverrides (studioBaseTokens model)
                                (Theme.enforceAA (studioResolvedTokens model) (studioActiveScheme model))
                    }
            in
            ( updated, [ appearanceApplyFor updated ] )

        StudioReset ->
            let
                updated =
                    studioResetSession model
            in
            ( updated, [ appearanceApplyFor updated ] )

        StudioBeginSave ->
            let
                suggestion =
                    case List.filter (\custom -> custom.id == model.themeId) model.studioCustoms |> List.head of
                        Just custom ->
                            custom.name

                        Nothing ->
                            if Studio.isCustomThemeId model.themeId then
                                "My theme"

                            else
                                Studio.saveSuggestion False
                                    ""
                                    (ThemeLook.themeMeta
                                        |> List.filter (\meta -> meta.id == model.themeId)
                                        |> List.head
                                        |> Maybe.map .label
                                        |> Maybe.withDefault "My"
                                    )
            in
            ( { model | studioSaving = True, studioSaveName = suggestion }, [] )

        StudioSaveNameInput { name } ->
            ( { model | studioSaveName = name }, [] )

        StudioConfirmSave ->
            if String.isEmpty (String.trim model.studioSaveName) then
                ( model, [] )

            else
                let
                    base =
                        Studio.schemeCorrectedBase (studioSchemeOf model) (studioSaveBase model) model.studioSchemeOverride

                    merged =
                        Studio.mergeSaveOverrides (studioSavedOverrides model) model.studioOverrides

                    ( theme, persisted ) =
                        Studio.addCustomTheme ThemeTokens.themeIds model.studioCustoms (String.trim model.studioSaveName) base merged

                    cleared =
                        studioResetSession
                            { model
                                | studioCustoms = persisted
                                , customThemes = studioCustomRefs persisted
                                , studioSaving = False
                                , studioSaveName = ""
                            }

                    updated =
                        { cleared | themeId = theme.id }
                in
                ( updated
                , [ StudioStoreCustomThemes { json = encodeStudioCustoms persisted }
                  , AppearanceStoreTheme { id = theme.id }
                  , appearanceApplyFor updated
                  ]
                )

        StudioCancelSave ->
            ( { model | studioSaving = False, studioSaveName = "" }, [] )

        StudioDeleteCustom { id } ->
            case List.filter (\custom -> custom.id == id) model.studioCustoms |> List.head of
                Nothing ->
                    ( model, [] )

                Just gone ->
                    let
                        persisted =
                            Studio.removeCustomTheme model.studioCustoms id

                        stored =
                            { model | studioCustoms = persisted, customThemes = studioCustomRefs persisted }
                    in
                    if model.themeId == id then
                        let
                            fallback =
                                if List.member gone.base ThemeTokens.themeIds then
                                    gone.base

                                else
                                    ThemeLook.defaultThemeId

                            updated =
                                studioResetSession { stored | themeId = fallback }
                        in
                        ( updated
                        , [ StudioStoreCustomThemes { json = encodeStudioCustoms persisted }
                          , AppearanceStoreTheme { id = fallback }
                          , appearanceApplyFor updated
                          ]
                        )

                    else
                        ( stored, [ StudioStoreCustomThemes { json = encodeStudioCustoms persisted } ] )

        StudioApplyBackground { id } ->
            -- The studio's background chips apply immediately
            -- (mirroring `chooseBackground`), unlike the staged
            -- appearance picker.
            if id /= ThemeLook.autoBackgroundId && not (List.any (\option -> option.id == id) ThemeLook.backgroundOptions) then
                ( model, [] )

            else
                let
                    updated =
                        { model | backgroundId = id, backgroundCandidate = id, backgroundPreview = Nothing }
                in
                ( updated
                , [ AppearanceStoreBackground { id = id }
                  , appearanceApplyFor updated
                  ]
                )

        StudioExport ->
            if model.studioExportBusy then
                ( model, [] )

            else
                let
                    base =
                        Studio.schemeCorrectedBase (studioSchemeOf model) (studioSaveBase model) model.studioSchemeOverride

                    merged =
                        Studio.mergeSaveOverrides (studioSavedOverrides model) model.studioOverrides
                in
                ( { model | studioExportBusy = True, studioExportCopied = False, studioCopyFailure = Nothing }
                , [ ClipboardCopy { text = Studio.encodeThemeExport base merged (millisToIso model.nowMs), tag = "ts:export" } ]
                )

        StudioShare ->
            if model.studioShareBusy then
                ( model, [] )

            else
                case List.filter (\custom -> custom.id == model.themeId) model.studioCustoms |> List.head of
                    Nothing ->
                        ( model, [] )

                    Just theme ->
                        let
                            code =
                                Studio.encodeThemeShare ThemeTokens.themeIds theme
                        in
                        if String.isEmpty code then
                            ( { model | studioCopyFailure = Just "Theme share-link copy failed. Clipboard access may be blocked in this browser." }, [] )

                        else
                            ( { model | studioShareBusy = True, studioShareCopied = False, studioCopyFailure = Nothing }
                            , [ StudioShareCopy { code = code } ]
                            )

        StudioEyeDropperSample ->
            if model.studioEyeDropperBusy || not model.studioEyeDropperSupported then
                ( model, [] )

            else
                ( { model
                    | studioEyeDropperBusy = True
                    , studioEyeDropperStatus = Just { message = "Choose an accent colour from the screen…", failure = False }
                  }
                , [ StudioEyeDropperRequest ]
                )

        StudioEyeDropperResult { state, detail, hex } ->
            if not model.studioEyeDropperBusy then
                ( model, [] )

            else
                let
                    settled =
                        { model | studioEyeDropperBusy = False }
                in
                if state == "selected" then
                    case Studio.sampledAccentSeed hex of
                        Nothing ->
                            ( { settled | studioEyeDropperStatus = Just { message = "The sampled screen colour was invalid. The accent seed was not changed.", failure = True } }, [] )

                        Just sampled ->
                            let
                                updated =
                                    studioPatchSeed settled (\seed -> { seed | accentHue = sampled.hue })
                            in
                            ( { updated | studioEyeDropperStatus = Just { message = "Accent seed sampled from " ++ sampled.hex ++ ".", failure = False } }
                            , if updated.studioFactoryArmed then
                                [ appearanceApplyFor updated ]

                              else
                                []
                            )

                else if state == "cancelled" || state == "unsupported" then
                    ( { settled | studioEyeDropperStatus = Just { message = detail, failure = False } }, [] )

                else
                    ( { settled | studioEyeDropperStatus = Just { message = detail, failure = True } }, [] )

        StudioCustomThemesRefreshed raw ->
            -- Another tab rewrote customs: revive, force a palette
            -- re-apply, and fall back off a deleted active theme.
            let
                json =
                    Decode.decodeValue (Decode.field "json" Decode.string) raw
                        |> Result.withDefault ""

                revived =
                    Studio.reviveCustomThemes ThemeTokens.themeIds json

                stored =
                    { model | studioCustoms = revived, customThemes = studioCustomRefs revived }
            in
            if Studio.isCustomThemeId model.themeId && not (List.any (\custom -> custom.id == model.themeId) revived) then
                let
                    fallback =
                        case List.filter (\custom -> custom.id == model.themeId) model.studioCustoms |> List.head of
                            Just gone ->
                                if List.member gone.base ThemeTokens.themeIds then
                                    gone.base

                                else
                                    ThemeLook.defaultThemeId

                            Nothing ->
                                ThemeLook.defaultThemeId

                    updated =
                        studioResetSession { stored | themeId = fallback }
                in
                ( updated
                , [ AppearanceStoreTheme { id = fallback }
                  , appearanceApplyFor updated
                  ]
                )

            else
                ( stored, [ appearanceApplyFor stored ] )

        StudioTabSelect { id } ->
            if List.any (\group -> group.id == id) Studio.studioGroups then
                ( { model | studioTab = id }, [] )

            else
                ( model, [] )

        GuidesProgressLoaded raw ->
            -- Element-wise string filter, mirroring `readGuideProgress`
            -- (unknown ids drop; malformed payloads land empty).
            case Decode.decodeValue (Decode.list Decode.value) raw of
                Ok values ->
                    ( { model
                        | guidesCompleted =
                            Guides.filterProgressIds Guides.guideStepIds
                                (List.filterMap (\v -> Decode.decodeValue Decode.string v |> Result.toMaybe) values)
                      }
                    , []
                    )

                Err _ ->
                    ( model, [] )

        InviteJoinSubmit ->
            -- Invalid names surface the error instead of navigating
            -- (the oracle also moves focus to the field — a DOM
            -- behaviour with no pure equivalent).
            case Invite.guestNameError model.inviteName of
                Nothing ->
                    ( model, [ LoadUrl (inviteJoinHref model) ] )

                Just err ->
                    ( { model | inviteNameError = Just err }, [] )

        SelectOnyxosStage { stage } ->
            -- Unknown ids (including forged events) keep the old
            -- stage, mirroring the `?? stages[0]` render fallback
            -- without adopting the bad id.
            if List.member stage onyxosStageIds then
                ( { model | onyxosStage = stage }, [] )

            else
                ( model, [] )

        OnyxosStageKey { key } ->
            -- Arrow/Home/End roving; anything else holds. Moving DOM
            -- focus onto the newly selected tab stays ports-side.
            ( { model | onyxosStage = stepOnyxosStage model.onyxosStage key }, [] )

        StatusRefetch ->
            requestStatus model

        HttpResult { key, ok, body } ->
            -- Feed results route by key (the download catalog and its
            -- per-lane sidecars reuse the bridge). A bad sample falls
            -- through to the next feed path; an exhausted list keeps
            -- the last good sample and stops loading, never inventing
            -- health.
            if key == "download-catalog" then
                case ( ok, Download.decodeCatalog body ) of
                    ( True, Just catalog ) ->
                        let
                            availableCards =
                                Download.downloadCards
                                    |> List.filter
                                        (\c ->
                                            Download.downloadAvailability
                                                (Just catalog)
                                                Download.CatalogReady
                                                (Download.activeLaneId c.lane)
                                                == Download.DlAvailable
                                        )

                            fetches =
                                List.map
                                    (\c ->
                                        HttpFetch
                                            { key = Download.checksumKeyForLane c.lane
                                            , url = c.sha256Url
                                            }
                                    )
                                    availableCards

                            pending =
                                List.map (\c -> Download.activeLaneId c.lane) availableCards
                        in
                        ( { model
                            | downloadCatalog = Just catalog
                            , downloadCatalogLoading = False
                            , downloadShaPending = pending
                          }
                        , fetches
                        )

                    _ ->
                        ( { model | downloadCatalogLoading = False }, [] )

            else if key == "stats-index" then
                case ( ok, Stats.decodeStatsIndex body ) of
                    ( True, Just index ) ->
                        let
                            stored =
                                { model | statsIndex = Just index, statsLoading = False, statsFetchedAt = Just model.nowMs }

                            followed =
                                if String.isEmpty stored.statsInspected then
                                    Stats.busiestChannel index.channels
                                        |> Maybe.map .channel
                                        |> Maybe.withDefault ""

                                else
                                    stored.statsInspected
                        in
                        if String.isEmpty followed || String.toLower followed == String.toLower stored.statsDetailRequested then
                            ( stored, [] )

                        else
                            requestStatsDetailFor stored followed

                    _ ->
                        ( { model | statsLoading = False, statsFetchedAt = Just model.nowMs }, [] )

            else if String.startsWith "stats-detail-" key then
                let
                    loaded =
                        { model | statsDetailLoading = False }
                in
                if not ok then
                    ( loaded, [] )

                else
                    case Stats.decodeChannelDetail body model.statsDetailRequested of
                        Just detail ->
                            ( { loaded | statsDetail = Just detail }, [] )

                        Nothing ->
                            ( loaded, [] )

            else if String.startsWith "download-sha256-" key then
                let
                    lane =
                        String.dropLeft (String.length "download-sha256-") key

                    pending =
                        List.filter (\kept -> kept /= lane) model.downloadShaPending

                    shas =
                        if ok then
                            case Download.parseSha256SumText body of
                                Just parsed ->
                                    Dict.insert lane parsed.hash model.downloadShas

                                Nothing ->
                                    model.downloadShas

                        else
                            model.downloadShas
                in
                ( { model | downloadShaPending = pending, downloadShas = shas }, [] )

            else if key /= "network-status" then
                ( model, [] )

            else
                let
                    sample =
                        if ok then
                            Decode.decodeString Decode.value body
                                |> Result.toMaybe
                                |> Maybe.andThen Status.normalizeStatus

                        else
                            Nothing
                in
                case sample of
                    Just status ->
                        ( { model | networkStatus = Just status, statusLoading = False, statusFetchedAt = Just model.nowMs }, [] )

                    Nothing ->
                        let
                            next =
                                model.statusPathAttempt + 1
                        in
                        case List.drop next Status.statusPaths |> List.head of
                            Just path ->
                                ( { model | statusPathAttempt = next }, [ HttpFetch { key = key, url = path } ] )

                            Nothing ->
                                ( { model | statusLoading = False, statusFetchedAt = Just model.nowMs }, [] )

        CallsChooseRoom ->
            -- Choosing a room just reveals the rail (Rooms
            -- collection); joining happens from the hub join buttons.
            ( { model | callsOpen = False }, [] )

        CallsReturnToCall target ->
            -- Navigate to the call channel or DM peer without touching
            -- voice state — exactly the oracle's `onReturnToCall`.
            update (ChannelSelect target) { model | callsOpen = False }

        CallJoin { channel, video } ->
            -- Join one voice/video room (mirroring `joinVoiceChannel`'s
            -- guards: a live socket and a named channel; joining from a
            -- live call leaves it first). Capture, the engine, and the
            -- provisional hub state all resolve through the snapshot
            -- feed, so a missing engine surfaces as a failed outcome
            -- instead of a phantom call.
            if model.connection /= Live || String.isEmpty channel then
                ( model, [] )

            else
                let
                    leaveFirst =
                        case model.calls.channel of
                            Just current ->
                                if model.calls.lifecycle /= Media.Idle then
                                    [ VoiceLeave { channel = current } ]

                                else
                                    []

                            Nothing ->
                                []
                in
                ( { model | callSelfMuted = False, callSelfDeafened = False }
                , leaveFirst ++ [ VoiceJoin { channel = channel, video = video } ]
                )

        CallLeave ->
            -- Leave the live call, if any (mirroring
            -- `leaveVoiceChannel`'s idle no-op).
            case model.calls.channel of
                Just current ->
                    if model.calls.lifecycle /= Media.Idle then
                        update (RuntimeDomainActionRequested (RuntimeDomain.MediaLeave (Just current))) model

                    else
                        ( model, [] )

                Nothing ->
                    ( model, [] )

        CallToggleMute ->
            -- Flip the local capture flag and tell the engine (the
            -- roster-reported `muted` set stays feed-owned).
            let
                next =
                    not model.callSelfMuted
            in
            update (RuntimeDomainActionRequested (RuntimeDomain.MediaMute next)) model

        CallToggleDeafen ->
            update (RuntimeDomainActionRequested (RuntimeDomain.MediaDeafen (not model.callSelfDeafened))) model

        CallHubChanged hub ->
            -- Engine-bridge seam (lands with the engine): lifecycle,
            -- channel, peer, start time, and outcome in one snapshot.
            -- An idle hub releases the local capture flag with it.
            ( { model | calls = hub, callSelfMuted = model.callSelfMuted && hub.lifecycle /= Media.Idle, callSelfDeafened = model.callSelfDeafened && hub.lifecycle /= Media.Idle }, [] )

        CallHubSnapshot raw ->
            -- Voice engine lifecycle feed: validated fail-closed, merged
            -- over the hub (mirroring `onCallState`); an undecodable
            -- snapshot is dropped without touching call state.
            case Media.decodeEngineSnapshot raw of
                Just snap ->
                    let
                        merged =
                            Media.applyEngineSnapshot model.calls snap
                    in
                    ( { model | calls = merged, callSelfMuted = model.callSelfMuted && merged.lifecycle /= Media.Idle, callSelfDeafened = model.callSelfDeafened && merged.lifecycle /= Media.Idle }, [] )

                Nothing ->
                    ( model, [] )

        WhoisRequest nick ->
            requestWhois model nick

        WhoisClose ->
            -- Closing the sheet clears the visible target (mirroring
            -- `closeWhois`); cached rows stay for the next open.
            ( { model | whoisTarget = Nothing }, [] )

        WhoisTimeoutElapsed req ->
            ( settleWhoisTimeout model req, [] )

        TypingStarted target ->
            sendTyping model target True

        TypingStopped target ->
            sendTyping model target False

        ReactionSend target messageId emoji ->
            sendReaction model target messageId emoji

        UserProfileOpened { nick, channel } ->
            ( { model | userProfileCard = Just { nick = nick, channel = channel } }, [] )

        UserProfileClosed ->
            ( { model | userProfileCard = Nothing }, [] )

        MemberMention { nick, channel } ->
            -- A mention appends to the room composer (mirroring
            -- `handleMention`): other conversations select first,
            -- the insert merges in append mode, and the oracle
            -- toast reports room or roomless. Caret/focus motion
            -- stays a narrowing (no caret state).
            let
                insert =
                    ComposerInject.formatMentionInsert nick
            in
            if String.isEmpty insert then
                ( model, [] )

            else
                let
                    injectInto composer =
                        (ComposerInject.mergeComposerInsert composer insert ComposerInject.InjectAppend).text

                    toasted current =
                        let
                            merged =
                                injectInto current.composer

                            description =
                                if String.isEmpty (String.trim channel) then
                                    "Mention is available in a room."

                                else
                                    "Inserted into the composer for this room."
                        in
                        ( addToast
                            { variant = ToastInfo
                            , title = "Mention " ++ nick
                            , description = Just description
                            , duration = Nothing
                            , groupKey = Nothing
                            , undo = Nothing
                            }
                            model.nowMs
                            { current
                                | composer = merged
                                , composerDrafts = Dict.insert (ircCaseKey current channel) merged current.composerDrafts
                            }
                        , []
                        )
                in
                if String.isEmpty (String.trim channel) then
                    toasted model

                else if Maybe.map String.toLower model.activeChannel == Just (String.toLower channel) then
                    toasted model

                else
                    let
                        ( switched, outs ) =
                            selectChannel model channel

                        ( mentioned, _ ) =
                            toasted switched
                    in
                    ( mentioned, outs )

        MemberCopyNick nick ->
            -- Member names copy through the tagged clipboard port
            -- (mirroring `handleCopyNick`); an empty nick copies
            -- nothing.
            if String.isEmpty (String.trim nick) then
                ( model, [] )

            else
                ( model, [ ClipboardCopy { text = String.trim nick, tag = "member-copy:" ++ String.trim nick } ] )

        MemberCardWhois nick ->
            -- The card hands off to the network sheet (mirroring
            -- `handleWhois`): the card closes and the WHOIS request
            -- opens the sheet.
            Tuple.mapFirst (\m -> { m | userProfileCard = Nothing }) (requestWhois model nick)

        MemberMessage nick ->
            -- The card opens a DM unless the peer is blocked
            -- (mirroring `handleDm`); navigating away closes the
            -- card like the oracle popover unmount.
            if isBlockedDmTarget model nick then
                let
                    copy =
                        blockedDmComposeCopy nick
                in
                ( addToast
                    { variant = ToastInfo
                    , title = copy.title
                    , description = Just copy.description
                    , duration = Nothing
                    , groupKey = Nothing
                    , undo = Nothing
                    }
                    model.nowMs
                    model
                , []
                )

            else
                Tuple.mapFirst (\m -> { m | userProfileCard = Nothing }) (selectChannel model nick)

        SafetyOpenBlock { nick, guest } ->
            -- Staging a block confirm (mirroring
            -- `openPersonBlockConfirm`); blank names stage nothing.
            if String.isEmpty (String.trim nick) then
                ( model, [] )

            else
                ( { model
                    | personSafety =
                        Just
                            { pending = PersonSafety.SafetyBlock { nick = String.trim nick, guest = guest }
                            , reason = "harassment"
                            , note = ""
                            }
                  }
                , []
                )

        SafetyOpenReport { nick, guest } ->
            -- Staging a report draft (mirroring
            -- `openPersonReport`); blank names stage nothing.
            if String.isEmpty (String.trim nick) then
                ( model, [] )

            else
                ( { model
                    | personSafety =
                        Just
                            { pending = PersonSafety.SafetyReport { nick = String.trim nick, guest = guest }
                            , reason = "harassment"
                            , note = ""
                            }
                  }
                , []
                )

        SafetyReason value ->
            case model.personSafety of
                Nothing ->
                    ( model, [] )

                Just pending ->
                    ( { model | personSafety = Just { pending | reason = value } }, [] )

        SafetyNote value ->
            case model.personSafety of
                Nothing ->
                    ( model, [] )

                Just pending ->
                    ( { model | personSafety = Just { pending | note = value } }, [] )

        SafetyClose ->
            ( { model | personSafety = Nothing }, [] )

        IdentityOverridesReload ->
            -- Reload the private journals for the current device
            -- owner (mirroring the owner-scoped override loads);
            -- unusable owners load nothing rather than claiming
            -- another account's journals.
            ( model, [ IdentityOverridesRequest (identityOverridesKeys model) ] )

        IdentityOverridesLoaded raw ->
            -- Lenient element-wise decode (unknown shapes drop;
            -- malformed payloads land empty, like the parse
            -- fallbacks behind every override load).
            ( { model
                | softIgnoreList = IdentityOverrides.parseSoftIgnore (IdentityOverrides.stringsAt "softIgnore" raw)
                , nickColorOverrides = IdentityOverrides.parseNickColors (IdentityOverrides.pairsAt "nickColors" raw)
                , displayNameOverrides = IdentityOverrides.parseDisplayNames (IdentityOverrides.pairsAt "displayNames" raw)
              }
            , []
            )

        SafetyConfirmBlock ->
            -- Confirming writes the device ignore with the quiet
            -- sentence (mirroring `confirmBlock`).
            case model.personSafety of
                Just { pending } ->
                    case pending of
                        PersonSafety.SafetyBlock details ->
                            let
                                updated =
                                    { model
                                        | ignoredUsers = parseNameBlocklist 512 128 (details.nick :: Set.toList model.ignoredUsers)
                                        , personSafety = Nothing
                                    }
                            in
                            ( addToast
                                { variant = ToastInfo
                                , title = "Blocked " ++ details.nick
                                , description = Just (PersonSafety.blockBody details.nick)
                                , duration = Nothing
                                , groupKey = Nothing
                                , undo = Nothing
                                }
                                model.nowMs
                                updated
                            , blocklistsSaveOut updated
                            )

                        PersonSafety.SafetyReport _ ->
                            ( model, [] )

                Nothing ->
                    ( model, [] )

        SafetySubmitReport ->
            -- Submitting drafts the note into shared #root
            -- (mirroring `submitReport`): the receipt persists
            -- ports-side, offline warns and preserves nothing
            -- beyond the reset, online joins #root, appends the
            -- draft, and navigates there for user review.
            case model.personSafety of
                Just sheet ->
                    case sheet.pending of
                        PersonSafety.SafetyReport details ->
                            case PersonSafety.reasonFromString sheet.reason of
                                Nothing ->
                                    ( model, [] )

                                Just parsed ->
                                    submitParsedReport model sheet details parsed

                        PersonSafety.SafetyBlock _ ->
                            ( model, [] )

                Nothing ->
                    ( model, [] )

        ModerationPropose { kind, channel, target, mask, reason } ->
            -- A moderation control stages a review draft and closes
            -- the card when one is open (mirroring
            -- `requestModeration`); the review surface validates it
            -- live, so reasons and masks ride along unchecked.
            ( { model
                | userProfileCard = Nothing
                , moderationDraft =
                    Just
                        { kind = kind
                        , channel = channel
                        , target = target
                        , mask = mask
                        , reason = reason
                        }
              }
            , []
            )

        ModerationCancel ->
            ( { model | moderationDraft = Nothing }, [] )

        ModerationDeskMember nick ->
            let
                desk =
                    model.moderationDesk
            in
            ( { model | moderationDesk = { desk | member = nick } }, [] )

        ModerationDeskAction kind ->
            let
                desk =
                    model.moderationDesk
            in
            ( { model | moderationDesk = { desk | action = kind } }, [] )

        ModerationDeskReason reason ->
            let
                desk =
                    model.moderationDesk
            in
            ( { model | moderationDesk = { desk | reason = reason } }, [] )

        ModerationDeskMask mask ->
            let
                desk =
                    model.moderationDesk
            in
            ( { model | moderationDesk = { desk | mask = mask } }, [] )

        ModerationDeskSubmitMember channel ->
            -- The desk member-action form stages a reason-carrying
            -- draft into the shared review (mirroring
            -- `submitMemberAction`); the review re-validates before
            -- anything sends.
            case Moderation.kindFromString model.moderationDesk.action of
                Nothing ->
                    ( model, [] )

                Just kind ->
                    ( { model
                        | userProfileCard = Nothing
                        , moderationDraft =
                            Just
                                { kind = kind
                                , channel = channel
                                , target =
                                    case String.trim model.moderationDesk.member of
                                        "" ->
                                            Nothing

                                        nick ->
                                            Just nick
                                , mask = Nothing
                                , reason =
                                    case String.trim model.moderationDesk.reason of
                                        "" ->
                                            Nothing

                                        reason ->
                                            Just reason
                                }
                      }
                    , []
                    )

        ModerationDeskSubmitBan channel ->
            -- The desk ban-mask form stages a mask draft into the
            -- shared review (mirroring `submitBanMask`); the caller
            -- scope keeps masks inside the channel, verified server-
            -- side.
            ( { model
                | userProfileCard = Nothing
                , moderationDraft =
                    Just
                        { kind = Moderation.Ban
                        , channel = channel
                        , target = Nothing
                        , mask =
                            case String.trim model.moderationDesk.mask of
                                "" ->
                                    Nothing

                                mask ->
                                    Just mask
                        , reason = Nothing
                        }
              }
            , []
            )

        ModerationDeskInvite nick ->
            let
                desk =
                    model.moderationDesk
            in
            ( { model | moderationDesk = { desk | invite = nick } }, [] )

        ModerationDeskSubmitInvite channel ->
            -- The desk invite row sends directly (mirroring
            -- `sendInvite`: RFC order `INVITE <nick> <channel>`,
            -- gated on room authority and a live connection, with
            -- the field cleared after the send).
            case String.trim model.moderationDesk.invite of
                "" ->
                    ( model, [] )

                nick ->
                    if model.connection /= Live || not (isChannelOp model channel) then
                        ( model, [] )

                    else
                        let
                            desk =
                                model.moderationDesk
                        in
                        ( { model | moderationDesk = { desk | invite = "" } }
                        , [ SendLine (Wire.formatIrcLine "INVITE" [ nick, channel ]) ]
                        )

        ModerationDeskToggleMode channel letter ->
            -- A safeguard toggle (mirroring `toggleMode`); only the
            -- three desk letters flip, and only with room authority
            -- on a live connection.
            if model.connection /= Live || not (isChannelOp model channel) then
                ( model, [] )

            else
                case String.uncons letter of
                    Just ( flag, "" ) ->
                        if flag /= 'm' && flag /= 'i' && flag /= 't' then
                            ( model, [] )

                        else
                            let
                                flags =
                                    case Dict.get (String.toLower channel) model.channels of
                                        Nothing ->
                                            []

                                        Just room ->
                                            (Modes.parseChannelModeString room.modes).flags

                                sign =
                                    if List.member flag flags then
                                        "-"

                                    else
                                        "+"
                            in
                            ( model
                            , [ SendLine (Wire.formatIrcLine "MODE" [ channel, sign ++ letter ]) ]
                            )

                    _ ->
                        ( model, [] )

        OverrideToggleSoftIgnore nick ->
            -- Soft-ignore toggle (mirroring `toggleSoftIgnore`:
            -- owner-gated, nick-normalized, field toggled, journal
            -- saved; without an owner nothing moves).
            case IdentityOverrides.normalizeOverrideNick nick of
                Nothing ->
                    ( model, [] )

                Just key ->
                    case (identityOverridesKeys model).softIgnoreKey of
                        Nothing ->
                            ( model, [] )

                        Just _ ->
                            let
                                next =
                                    if Set.member key model.softIgnoreList then
                                        Set.remove key model.softIgnoreList

                                    else
                                        Set.insert key model.softIgnoreList
                            in
                            ( { model | softIgnoreList = next }
                            , identityOverridesSaveOut (identityOverridesKeys model)
                                { softIgnore = Just (IdentityOverrides.encodeSoftIgnore next)
                                , nickColors = Nothing
                                , displayNames = Nothing
                                }
                            )

        OverrideSetNickColor { nick, color } ->
            -- Nick-color set (mirroring `setNickColorOverride`:
            -- owner-gated, nick- and color-normalized).
            case ( IdentityOverrides.normalizeOverrideNick nick, IdentityOverrides.normalizeNickColor color ) of
                ( Just key, Just normalized ) ->
                    case (identityOverridesKeys model).nickColorsKey of
                        Nothing ->
                            ( model, [] )

                        Just _ ->
                            let
                                next =
                                    Dict.insert key normalized model.nickColorOverrides
                            in
                            ( { model | nickColorOverrides = next }
                            , identityOverridesSaveOut (identityOverridesKeys model)
                                { softIgnore = Nothing
                                , nickColors = Just (IdentityOverrides.encodeStringMap next)
                                , displayNames = Nothing
                                }
                            )

                _ ->
                    ( model, [] )

        OverrideClearNickColor nick ->
            -- Nick-color clear (mirroring `clearNickColorOverride`).
            case IdentityOverrides.normalizeOverrideNick nick of
                Nothing ->
                    ( model, [] )

                Just key ->
                    case (identityOverridesKeys model).nickColorsKey of
                        Nothing ->
                            ( model, [] )

                        Just _ ->
                            let
                                next =
                                    Dict.remove key model.nickColorOverrides
                            in
                            ( { model | nickColorOverrides = next }
                            , identityOverridesSaveOut (identityOverridesKeys model)
                                { softIgnore = Nothing
                                , nickColors = Just (IdentityOverrides.encodeStringMap next)
                                , displayNames = Nothing
                                }
                            )

        OverrideSetDisplayName { nick, name } ->
            -- Display-name set (mirroring `setDisplayNameOverride`:
            -- owner-gated, nick- and name-normalized).
            case ( IdentityOverrides.normalizeOverrideNick nick, IdentityOverrides.normalizeDisplayName name ) of
                ( Just key, Just normalized ) ->
                    case (identityOverridesKeys model).displayNamesKey of
                        Nothing ->
                            ( model, [] )

                        Just _ ->
                            let
                                next =
                                    Dict.insert key normalized model.displayNameOverrides
                            in
                            ( { model | displayNameOverrides = next }
                            , identityOverridesSaveOut (identityOverridesKeys model)
                                { softIgnore = Nothing
                                , nickColors = Nothing
                                , displayNames = Just (IdentityOverrides.encodeStringMap next)
                                }
                            )

                _ ->
                    ( model, [] )

        OverrideClearDisplayName nick ->
            -- Display-name clear (mirroring
            -- `clearDisplayNameOverride`).
            case IdentityOverrides.normalizeOverrideNick nick of
                Nothing ->
                    ( model, [] )

                Just key ->
                    case (identityOverridesKeys model).displayNamesKey of
                        Nothing ->
                            ( model, [] )

                        Just _ ->
                            let
                                next =
                                    Dict.remove key model.displayNameOverrides
                            in
                            ( { model | displayNameOverrides = next }
                            , identityOverridesSaveOut (identityOverridesKeys model)
                                { softIgnore = Nothing
                                , nickColors = Nothing
                                , displayNames = Just (IdentityOverrides.encodeStringMap next)
                                }
                            )

        ThreadOpen { channel, parentId } ->
            -- Open the replies panel for one message (mirroring
            -- `openThread`).
            ( { model | threadPanel = Just { channel = channel, parentId = parentId } }, [] )

        ThreadClose ->
            ( { model | threadPanel = Nothing }, [] )

        ThreadReplyParent { channel, parentId } ->
            -- Reply from the panel (mirroring `replyFromThread`:
            -- the panel closes and the composer arms on the parent;
            -- parents without a server msgid cannot arm, so the
            -- panel just closes for those).
            let
                closed =
                    { model | threadPanel = Nothing }

                parentMsgid =
                    case Dict.get (String.toLower channel) model.channels of
                        Nothing ->
                            Nothing

                        Just room ->
                            case List.filter (\m -> m.id == parentId) room.messages |> List.head of
                                Just parent ->
                                    parent.msgid

                                Nothing ->
                                    Nothing
            in
            case parentMsgid of
                Just msgid ->
                    let
                        armed =
                            armReply closed channel msgid
                    in
                    ( { armed | editingMessage = Nothing, messageMenu = Nothing }, [] )

                Nothing ->
                    ( closed, [] )

        TopicDraftInput draft ->
            ( { model | topicDraft = draft }, [] )

        TopicCreateSubmit channel ->
            -- Start a named conversation (mirroring `startTopic`:
            -- invalid labels keep the draft and the forum state,
            -- valid labels select and clear the draft; the label
            -- does not need to exist yet).
            let
                label =
                    String.trim model.topicDraft
            in
            if not (isValidTopicLabel label) then
                ( model, [] )

            else
                ( { model
                    | activeChannelTopics = Dict.insert (String.toLower channel) label model.activeChannelTopics
                    , forumView = Dict.remove (String.toLower channel) model.forumView
                    , topicDraft = ""
                  }
                , []
                )

        ForumToggle channel ->
            let
                key =
                    String.toLower channel

                open =
                    not (Maybe.withDefault False (Dict.get key model.forumView))
            in
            ( { model
                | forumView =
                    if open then
                        Dict.insert key True model.forumView

                    else
                        Dict.remove key model.forumView
              }
            , []
            )

        ForumOpenTopic { channel, topic } ->
            -- Open a topic from its forum card (mirroring
            -- `openTopic`: validated select plus closing the forum,
            -- the consumed boundary persisted, and the focus handed
            -- to the now-active filter chip via the focus port,
            -- which runs after render like the oracle
            -- `queueMicrotask`).
            case resolveKnownChannelTopic model channel topic of
                Just valid ->
                    let
                        key =
                            String.toLower channel

                        opened =
                            { model
                                | activeChannelTopics = Dict.insert key valid model.activeChannelTopics
                                , forumView = Dict.remove key model.forumView
                            }

                        ( marked, markOuts ) =
                            markLatestChannelTopicRead opened channel valid
                    in
                    ( reconcileChannelTopicUnread marked key, markOuts ++ [ TopicChipFocus ] )

                Nothing ->
                    ( { model | forumView = Dict.remove (String.toLower channel) model.forumView }, [] )

        ForumChannelToggle channel ->
            -- Pin or unpin the forum projection (mirroring
            -- `toggleForumChannel` plus the `setForumView(true)`
            -- tail: toggling always opens the forum, and unpinning
            -- leaves an open forum open).
            let
                key =
                    String.toLower (String.trim channel)
            in
            if not (isValidNotifyChannel key) then
                ( model, [] )

            else
                let
                    queued =
                        queueNavigationForum key model

                    updated =
                        { queued | forumView = Dict.insert key True queued.forumView }
                in
                ( updated, forumChannelsSaveOut updated ++ navigationLoadOut model )

        FollowTopicToggle { channel, topic } ->
            -- Follow or unfollow one conversation (mirroring
            -- `toggleActiveFollow`/`followTopic`: the channel plus
            -- its topic, if any, through the shared follow folds).
            let
                key =
                    followKey channel topic

                updated =
                    if Set.member key model.followed then
                        { model | followed = Set.remove key model.followed }

                    else
                        { model | followed = Set.insert key model.followed }
            in
            ( updated, [ FollowedSave { keys = Set.toList updated.followed } ] )

        ModerationConfirm ->
            -- Confirm re-validates and invalidates on disconnect or
            -- lost room authority (mirroring the review `canSend`
            -- gate); nothing is sent until all three hold.
            case model.moderationDraft of
                Nothing ->
                    ( model, [] )

                Just draft ->
                    case Moderation.validateDraft draft model.ourNick of
                        Err _ ->
                            ( model, [] )

                        Ok { action } ->
                            if model.connection /= Live then
                                ( model, [] )

                            else if not (isChannelOp model draft.channel) then
                                ( model, [] )

                            else
                                ( { model | moderationDraft = Nothing }
                                , applyModerationAction action
                                )

        MessageEditRequested target messageId newText ->
            requestEdit model target messageId newText

        MessageDeleteRequested target messageId ->
            let
                ( requested, outbound ) =
                    requestDelete model target messageId
            in
            if List.isEmpty outbound then
                ( requested, outbound )

            else
                ( { requested | messageMenu = Nothing }, outbound )

        OwnMetadataSet key value ->
            setOwnMetadata model key value

        PasskeyCreated fields ->
            case Passkey.webauthnRegisterFinish fields.credId fields.clientDataJSON fields.authData of
                Just line ->
                    ( model, [ SendLine line ] )

                Nothing ->
                    ( { model | passkey = failPasskey model.passkey "Malformed ceremony response." }, [] )

        PasskeyAssertion fields ->
            case Passkey.webauthnAuthFinish fields.credId fields.clientDataJSON fields.authData fields.signature of
                Just line ->
                    ( model, [ SendLine line ] )

                Nothing ->
                    ( { model | passkey = failPasskey model.passkey "Malformed ceremony response." }, [] )

        PasskeyFailed { message } ->
            ( { model | passkey = failPasskey model.passkey message }, [] )

        PasskeySettle ->
            let
                ( session, effect ) =
                    Passkey.settleAuth model.passkey
            in
            ( { model | passkey = session }, passkeyOut effect )

        DmSealed { target, envelope, schedId } ->
            case schedId of
                Just sid ->
                    admitScheduledSeal model sid target envelope

                Nothing ->
                    case Dict.get (String.toLower target) model.pendingSeals of
                        Nothing ->
                            -- No matching in-flight seal (stale generation): drop
                            -- rather than send unattributed ciphertext.
                            ( model, [] )

                        Just pending ->
                            let
                                key =
                                    String.toLower target

                                -- The directory may have rotated while the seal
                                -- was in flight: never admit ciphertext under a
                                -- device set the live directory no longer claims
                                -- (the oracle's `liveMatches` exact-set check —
                                -- flag-only, like a seal-time key change).
                                liveKeys =
                                    sealKeysFor model target

                                sealedSet =
                                    Set.fromList pending.keys

                                liveMatches =
                                    List.length liveKeys
                                        == List.length pending.keys
                                        && List.all (\k -> Set.member k sealedSet) liveKeys

                                text =
                                    pending.text
                            in
                            -- A rotated directory drops the seal silently
                            -- (flag-only); otherwise the labeled sealed send
                            -- stamps `@label=`, mirroring the oracle's
                            -- encrypted `commitLabeledOptimistic` with the
                            -- local plaintext kept on the row so the
                            -- ciphertext-only echo resolves against it.
                            if not liveMatches then
                                ( { model
                                    | pendingSeals = Dict.remove key model.pendingSeals
                                    , peerKeyChanges = Set.insert key model.peerKeyChanges
                                    , serviceLog =
                                        List.take maxServiceLog
                                            (("Peer key changed for " ++ target ++ " — DM stays locked until re-verified.") :: model.serviceLog)
                                  }
                                , []
                                )

                            else
                                let
                                    useLabel =
                                        List.member "labeled-response" model.caps

                                    cleared =
                                        { model | pendingSeals = Dict.remove key model.pendingSeals, replyingTo = Nothing }

                                    ( registered, label ) =
                                        if useLabel then
                                            registerLabeledSend cleared target [ model.messageSeq ] text

                                        else
                                            ( cleared, "" )

                                    tags =
                                        (if runtimeFeatureReady model "onyx/e2ee" then
                                            Dict.singleton "+onyx/e2ee" "mls"

                                         else
                                            Dict.empty
                                        )
                                            |> (if useLabel then
                                                    Dict.insert "label" label

                                                else
                                                    identity
                                               )

                                    line =
                                        Wire.formatTaggedLine (Dict.union tags (Dict.union (replyTagFor model target) (topicTagFor model target))) "PRIVMSG" [ target, envelope ]

                                    -- Sealed outbound rows persist the envelope only
                                    -- (never the transient plaintext), mirroring the
                                    -- oracle vault write — otherwise our sealed sends
                                    -- would vanish on reload without echo-message.
                                    vaultRow =
                                        { id = String.toLower target ++ ":" ++ String.fromInt model.messageSeq
                                        , wireMessageId = Nothing
                                        , target = String.toLower target
                                        , from = model.ourNick
                                        , body = envelope
                                        , at = floor model.nowMs
                                        , rowType = "msg"
                                        , deleted = False
                                        , redacted = False
                                        , replyTo = Nothing
                                        }

                                    filed =
                                        updateChannel registered
                                            target
                                            (\c ->
                                                { c
                                                    | messages =
                                                        List.take (messageRetentionFor registered target)
                                                            ({ id = model.messageSeq
                                                             , from = model.ourNick
                                                             , body = envelope
                                                             , whisper = False
                                                             , audience = Nothing
                                                             , highlight = False
                                                             , outboxId = Nothing
                                                             , pending = useLabel
                                                             , plaintext = Just text
                                                             , at = floor model.nowMs
                                                             , msgid = Nothing
                                                             , reactions = []
                                                             , edited = False
                                                             , deleted = False
                                                             , redacted = False
                                                             , topic = ""
                                                             , msgType = "msg"
                                                             , replyTo = Nothing
                                                             }
                                                                :: c.messages
                                                            )
                                                }
                                            )
                                            |> (\m -> { m | messageSeq = m.messageSeq + 1, ownedRowIds = markOwnedRow model.messageSeq m.ownedRowIds })
                                in
                            let
                                ( previewed, previewOuts ) =
                                    requestPreviewForBody filed text
                            in
                            ( rememberVaultIds previewed [ vaultRow ]
                            , [ SendLine line, vaultPersistOutbound model (String.toLower target) [ vaultRow ] ] ++ previewOuts
                            )

        DmSealFailed { target, keyChanged, schedId } ->
            -- A failed DM seal never downgrades to plaintext. A
            -- seal-time key change flags the peer and drops the pending
            -- seal with no toast (the oracle's flag-only path — the
            -- key-change banner is the signal, never coaching to turn
            -- E2EE off). Other failures toast + notify verbatim from
            -- the oracle seal-failure path. Scheduled seals hold their
            -- durable claim uncertain instead (never auto-retried).
            case schedId of
                Just sid ->
                    rejectScheduledSeal model sid keyChanged

                Nothing ->
                        if keyChanged then
                            ( { model
                                | pendingSeals = Dict.remove (String.toLower target) model.pendingSeals
                                , peerKeyChanges = Set.insert (String.toLower target) model.peerKeyChanges
                                , serviceLog =
                                    List.take maxServiceLog
                                        (("Peer key changed for " ++ target ++ " — DM stays locked until re-verified.") :: model.serviceLog)
                              }
                            , []
                            )

                        else
                            let
                                toasted =
                                    addToast
                                        { variant = ToastError
                                        , title = "Encryption unavailable"
                                        , description =
                                            Just
                                                ("Your message to "
                                                    ++ target
                                                    ++ " was NOT sent — the encrypted DM could not be sealed. Try again."
                                                )
                                        , duration = Nothing
                                        , groupKey = Nothing
                                        , undo = Nothing
                                        }
                                        model.nowMs
                                        model
                            in
                            ( addNotification toasted
                                { kind = NotifError
                                , text =
                                    "Encryption unavailable — message to "
                                        ++ target
                                        ++ " was not sent (the encrypted DM could not be sealed)."
                                , from = Nothing
                                , channel = Nothing
                                , topic = Nothing
                                }
                            , []
                            )

        DmOpenResult { messageId, envelope, plaintext } ->
            ( notifyDmPlaintext (fillPlaintext model messageId envelope plaintext) messageId envelope plaintext, [] )

        DmOpenFailed { peer, keyChanged } ->
            if keyChanged then
                ( { model
                    | peerKeyChanges = Set.insert (String.toLower peer) model.peerKeyChanges
                    , serviceLog =
                        List.take maxServiceLog
                            (("Peer key changed for " ++ peer ++ " — DM stays locked until re-verified.") :: model.serviceLog)
                  }
                , []
                )

            else
                ( model, [] )

        RoomSealed { room, envelope } ->
            case Dict.get (String.toLower room) model.roomSeals of
                Nothing ->
                    ( model, [] )

                Just text ->
                    let
                        -- Same labeled treatment as the DM seal path
                        -- above: stamp, register, render pending.
                        useLabel =
                            List.member "labeled-response" model.caps

                        cleared =
                            { model | roomSeals = Dict.remove (String.toLower room) model.roomSeals, replyingTo = Nothing }

                        ( registered, label ) =
                            if useLabel then
                                registerLabeledSend cleared room [ model.messageSeq ] text

                            else
                                ( cleared, "" )

                        -- Sealed room sends always carry the e2ee tag
                        -- (the oracle stamps `e2eeMessageTag('mls')`
                        -- unconditionally here — unlike the DM arm,
                        -- which gates on the cap).
                        tags =
                            Dict.singleton "+onyx/e2ee" "mls"
                                |> (if useLabel then
                                        Dict.insert "label" label

                                    else
                                        identity
                                   )

                        line =
                            Wire.formatTaggedLine (Dict.union tags (Dict.union (replyTagFor model room) (topicTagFor model room))) "PRIVMSG" [ room, envelope ]

                        -- Like the DM seal path: persist the envelope
                        -- only, never the transient plaintext.
                        vaultRow =
                            { id = String.toLower room ++ ":" ++ String.fromInt model.messageSeq
                            , wireMessageId = Nothing
                            , target = String.toLower room
                            , from = model.ourNick
                            , body = envelope
                            , at = floor model.nowMs
                            , rowType = "msg"
                            , deleted = False
                            , redacted = False
                            , replyTo = Nothing
                            }

                        filed =
                            updateChannel registered
                                room
                                (\c ->
                                    { c
                                        | messages =
                                            List.take (messageRetentionFor registered room)
                                                ({ id = model.messageSeq
                                                 , from = model.ourNick
                                                 , body = envelope
                                                 , whisper = False
                                                 , audience = Nothing
                                                 , highlight = False
                                                 , outboxId = Nothing
                                                 , pending = useLabel
                                                 , plaintext = Just text
                                                 , at = floor model.nowMs
                                                 , msgid = Nothing
                                                 , reactions = []
                                                 , edited = False
                                                 , deleted = False
                                                 , redacted = False
                                                 , topic = ""
                                                 , msgType = "msg"
                                                 , replyTo = Nothing
                                                 }
                                                    :: c.messages
                                                )
                                    }
                                )
                                |> (\m -> { m | messageSeq = m.messageSeq + 1, ownedRowIds = markOwnedRow model.messageSeq m.ownedRowIds })
                    in
                    (let
                        ( previewed, previewOuts ) =
                            requestPreviewForBody filed text
                     in
                     ( rememberVaultIds previewed [ vaultRow ]
                     , [ SendLine line, vaultPersistOutbound model (String.toLower room) [ vaultRow ] ] ++ previewOuts
                     )
                    )

        RoomSealFailed { room, recoveryRequired, notProvisioned } ->
            -- Three oracle copies: no room session at all (toast only,
            -- like the no-bridge arm), recovery-needed, and not-ready
            -- (both toast + error inbox notice, like the seal-failure
            -- arm). A sealed-room failure is silent on the wire by
            -- design, so chrome is the only user-visible signal.
            if notProvisioned then
                ( addToast
                    { variant = ToastError
                    , title = "Encrypted room is locked"
                    , description = Just ("Your message was not sent. Reconnect or wait for " ++ room ++ "'s encryption setup to finish, then try again.")
                    , duration = Nothing
                    , groupKey = Nothing
                    , undo = Nothing
                    }
                    model.nowMs
                    { model | roomSeals = Dict.remove (String.toLower room) model.roomSeals }
                , []
                )

            else
                let
                    lockedDescription =
                        if recoveryRequired then
                            "Your message was not sent. This room needs encryption recovery before sending."

                        else
                            "Your message was not sent. Wait for the room encryption status to become ready, then try again."

                    logged =
                        { model
                            | roomSeals = Dict.remove (String.toLower room) model.roomSeals
                            , serviceLog =
                                List.take maxServiceLog
                                    ((if recoveryRequired then
                                        "Encrypted room is locked: this room needs encryption recovery before sending."

                                      else
                                        "Encrypted room is locked: wait for the room encryption status to become ready, then try again."
                                     )
                                        :: model.serviceLog
                                    )
                        }

                    toasted =
                        addToast
                            { variant = ToastError
                            , title = "Encrypted room is locked"
                            , description = Just lockedDescription
                            , duration = Nothing
                            , groupKey = Nothing
                            , undo = Nothing
                            }
                            model.nowMs
                            logged
                in
                ( addNotification toasted
                    { kind = NotifError
                    , text = "Encryption unavailable — message to " ++ room ++ " was not sent."
                    , from = Nothing
                    , channel = Nothing
                    , topic = Nothing
                    }
                , []
                )

        RoomOpenResult { room, messageId, envelope, plaintext } ->
            ( fillPlaintext model messageId envelope plaintext
                |> (\m -> clearRoomFlight m room messageId envelope)
            , []
            )

        RoomOpenFailed { room, messageId, envelope } ->
            ( clearRoomFlight model room messageId envelope, [] )

        GroupControlVerified result ->
            foldGroupVerified model result

        GroupDirectoryDerived derived ->
            foldGroupDerived model derived

        GroupWelcomeOpened result ->
            foldGroupWelcomeOpened model result

        GroupPublisherIdentity projected ->
            -- Ports-side public projection resolved: assemble the ODD1
            -- record through the Elm codec and let the publisher verify
            -- before it sends anything. A new device id may unblock
            -- buffered welcomes, so rescan the pairs too.
            let
                ( nextPublisher, pubFx ) =
                    GroupPublisher.identityProjected (Maybe.andThen projectToIdentity projected) model.publisher

                ( rescan, rescanFx ) =
                    tryOpenPairs { model | publisher = nextPublisher }
            in
            ( rescan, runPublisherEffects pubFx ++ rescanFx )

        GroupPublisherRetry ->
            let
                ( nextPublisher, pubFx ) =
                    GroupPublisher.retryDue model.publisher
            in
            ( { model | publisher = nextPublisher }, runPublisherEffects pubFx )

        AttributionEnrollReply reply ->
            -- Ports answered the enroll request. `Nothing` (or a stale
            -- generation inside the fold) fails closed: nothing is
            -- sent and the account stays on the UID path.
            case reply of
                Nothing ->
                    ( model, [] )

                Just enroll ->
                    let
                        ( next, fx ) =
                            Attribution.foldEnrollReply (withAttributionServer model) model.nowMs enroll
                    in
                    ( { model | attribution = next }, runAttributionEffects [ fx ] )

        AttributionResidenceReply reply ->
            case reply of
                Nothing ->
                    ( model, [] )

                Just residence ->
                    let
                        ( next, fx ) =
                            Attribution.foldResidenceReply (withAttributionServer model) model.nowMs residence
                    in
                    ( { model | attribution = next }, runAttributionEffects [ fx ] )

        StewardOpen channel ->
            ( { model
                | stewardRoom = Just channel
                , stewardHelper = ""
                , stewardSuccessor = ""
                , stewardTypedName = ""
                , stewardStatus = ""
                , stewardClosing = False
                , stewardDeleting = False
              }
            , []
            )

        StewardClose ->
            ( { model | stewardRoom = Nothing, stewardStatus = "", stewardClosing = False, stewardDeleting = False }
            , []
            )

        StewardHelperInput value ->
            ( { model | stewardHelper = value }, [] )

        StewardSuccessorInput value ->
            ( { model | stewardSuccessor = value }, [] )

        StewardTypedNameInput value ->
            ( { model | stewardTypedName = value }, [] )

        StewardAskClose ->
            ( { model | stewardClosing = True, stewardDeleting = False }, [] )

        StewardAskDelete ->
            ( { model | stewardDeleting = True, stewardClosing = False }, [] )

        StewardCancelAsk ->
            ( { model | stewardClosing = False, stewardDeleting = False }, [] )

        StewardAddHelper channel ->
            requestStewardAddHelper model channel model.stewardHelper

        StewardRemoveHelper channel nick ->
            requestStewardRemoveHelper model channel nick

        StewardOfferTransfer channel ->
            requestStewardOfferTransfer model channel model.stewardSuccessor

        StewardAcceptTransfer channel ->
            requestStewardAcceptTransfer model channel

        StewardDeclineTransfer channel ->
            requestStewardDeclineTransfer model channel

        StewardDeclineAndClose channel ->
            -- The take-view "Not now" walks away and closes the
            -- panel (mirroring the oracle sheet close on decline).
            let
                ( declined, out ) =
                    requestStewardDeclineTransfer model channel
            in
            ( { declined | stewardRoom = Nothing }, out )

        WebPushToggle ->
            toggleWebPush model

        WebPushProbed probed ->
            foldWebPushProbed model probed

        WebPushEnabled reply ->
            foldWebPushEnabled model reply

        WebPushRecovered reply ->
            foldWebPushRecovered model reply

        WebPushDisabled reply ->
            foldWebPushDisabled model reply

        WebPushActiveState state ->
            foldWebPushActiveState model state

        WebPushRecoveryHint ->
            -- The service worker changed under us: re-run recovery
            -- without a reload (mirroring `controllerchange`).
            requestWebPushCheck model

        MediaBinaryReceived req ->
            foldMediaBinary model req.bytes

        StewardGrantTransfer channel ->
            requestStewardGrantTransfer model channel

        StewardReconcileTransfer channel ->
            requestStewardReconcileTransfer model channel

        StewardConfirmClose channel ->
            requestStewardCloseRoom model channel

        StewardConfirmDelete channel ->
            requestStewardDeleteRoom model channel

        WebhookNameInput value ->
            ( { model | webhookName = value }, [] )

        WebhookDeleteIdInput value ->
            ( { model | webhookDeleteId = value }, [] )

        WebhookCreate channel ->
            requestWebhookCreate model channel

        WebhookList channel ->
            requestWebhookList model channel

        WebhookDelete channel ->
            requestWebhookDelete model channel


{-| Record a ceremony-side failure: busy clears, error shows. -}
failPasskey : Passkey.PasskeySession -> String -> Passkey.PasskeySession
failPasskey session message =
    { session | busy = False, error = Just message }


{-| Fold one parsed line, lifting wire outbounds to `SendLine` and
persisting channel traffic to the vault. DMs persist under the peer
nick, exactly as they render.
-}
foldParsed : Model -> Wire.IrcMessage -> ( Model, List Outbound )
foldParsed model parsed =
    case settlePendingEditEcho model parsed of
        Just ( settled, target ) ->
            flushVaultBuffer settled target

        Nothing ->
            case divertHistoryBatch model parsed of
                Just buffered ->
                    -- Batch children are classified before replay dedup or
                    -- live folds, so even an old msgid cannot escape its
                    -- captured history/label/quarantine context.
                    ( buffered, [] )

                Nothing ->
                    case foldAuthoritativeEditEcho model parsed of
                        Just ( edited, target ) ->
                            flushVaultBuffer edited target

                        Nothing ->
                            if isRepeatDelivery model parsed then
                                -- Bouncer/session-sync rewind of an already-folded line: drop
                                -- before the store and vault (msgid-merge dedup).
                                ( model, [] )

                            else
                                let
                                    filed =
                                        rememberDelivery model parsed

                                    ( next, outbound ) =
                                        foldLine filed parsed
                                in
                                if parsed.command == "PRIVMSG" && isLiveSelfEcho model parsed then
                                    ( next, outbound )

                                else if isSwallowedCtcpWire model.ourNick parsed then
                                    ( next, outbound )

                                else if isPrivateServerControlNotice model parsed then
                                    -- Trusted SESSION/MEMO NOTICE records
                                    -- belong to private control or the typed
                                    -- memo fold. Never persist the raw wrapper
                                    -- into a self-target conversation shell.
                                    -- `deliverOfflineMemo` has already filed
                                    -- its single user-visible memo row above.
                                    ( next, outbound )

                                else
                                    case persistRow next parsed of
                                        Just row ->
                                            let
                                                remembered =
                                                    rememberVaultIds next row.rows
                                            in
                                            case remembered.runtimeOwnerStamp of
                                                Just stamp ->
                                                    let
                                                        ( dirty, flushOuts ) =
                                                            markVaultDirty remembered row.target stamp
                                                    in
                                                    ( dirty, outbound ++ flushOuts )

                                                Nothing ->
                                                    flushVaultBuffer remembered row.target
                                                        |> (\( flushed, flushOuts ) -> ( flushed, outbound ++ flushOuts ))

                                        Nothing ->
                                            ( next, outbound )


settlePendingEditEcho : Model -> Wire.IrcMessage -> Maybe ( Model, String )
settlePendingEditEcho model message =
    case ( message.params, message.nick, model.runtimeOwnerStamp ) of
        ( target :: body :: _, Just nick, Just owner ) ->
            let
                editTag =
                    case Dict.get "+draft/edit" message.tags of
                        Just value ->
                            Just value

                        Nothing ->
                            Dict.get "draft/edit" message.tags

                revisionTag =
                    case Dict.get "+draft/revision" message.tags of
                        Just value ->
                            Just value

                        Nothing ->
                            Dict.get "draft/revision" message.tags
                originalId = Maybe.withDefault "" editTag
                label = labelOf message
                conversation = dmMutateBucket model target nick
                targetKey = String.toLower conversation
                key = messageMutationKey target originalId
                pending = Dict.get key model.pendingMessageEdits
            in
            if message.command /= "PRIVMSG"
                || model.connection /= Live
                || Dict.member "batch" message.tags
                || String.isEmpty originalId
                || Dict.get "msgid" message.tags /= Just originalId
                || revisionTag /= Just "1" then
                Nothing

            else
                case Dict.get targetKey model.channels of
                    Nothing ->
                        Nothing

                    Just channel ->
                        case List.filter (\row -> row.msgid == Just originalId) channel.messages |> List.head of
                            Nothing ->
                                Nothing

                            Just original ->
                                let
                                    pendingMatches =
                                        case pending of
                                            Just item ->
                                                item.label /= Nothing
                                                    && item.label == label
                                                    && item.generation == model.physicalConnectionGeneration
                                                    && item.owner == owner
                                                    && item.targetKey == targetKey
                                                    && item.msgid == originalId
                                                    && String.toLower nick == String.toLower model.ourNick

                                            Nothing ->
                                                False

                                    allowedOriginal = not (messageLocked original) && not original.deleted && not original.redacted
                                in
                                if not pendingMatches || not allowedOriginal then
                                    Nothing

                                else
                                    let
                                        messages =
                                            List.map
                                                (\row -> if row.msgid == Just originalId then { row | body = body, edited = True } else row)
                                                channel.messages

                                        composerStillMatches =
                                            case pending of
                                                Just item ->
                                                    item.desiredText == model.composer
                                                        && Dict.get (ircCaseKey model item.target) model.composerDraftVersions == item.draftRevision

                                                Nothing ->
                                                    False
                                        editorMatches = Maybe.map (\edit -> edit.msgid == originalId && String.toLower edit.target == targetKey) model.editingMessage == Just True

                                        next =
                                            { model
                                                | channels = Dict.insert targetKey { channel | messages = messages } model.channels
                                                , editHistory = recordEdit model.editHistory originalId original.body (rowTime model message)
                                                , pendingMessageEdits = Dict.remove key model.pendingMessageEdits
                                                , editingMessage = if composerStillMatches && editorMatches then Nothing else model.editingMessage
                                                , composer = if composerStillMatches && editorMatches then "" else model.composer
                                                , composerDrafts = if composerStillMatches && editorMatches then Dict.remove targetKey model.composerDrafts else model.composerDrafts
                                                , composerError = Nothing
                                            }
                                    in
                                    Just ( next, conversation )

        _ ->
            Nothing


{-| Apply an authoritative EDIT-shaped self-message without treating its body
or fixed revision number as proof that a particular local edit request won.
Only an exact labeled response can settle `pendingMessageEdits`; this path
updates the canonical row and leaves any local edit request unresolved.
-}
foldAuthoritativeEditEcho : Model -> Wire.IrcMessage -> Maybe ( Model, String )
foldAuthoritativeEditEcho model message =
    case ( message.params, message.nick, model.runtimeOwnerStamp ) of
        ( target :: body :: _, Just nick, Just _ ) ->
            let
                originalId =
                    Dict.get "+draft/edit" message.tags |> Maybe.withDefault (Maybe.withDefault "" (Dict.get "draft/edit" message.tags))

                revision =
                    Dict.get "+draft/revision" message.tags |> Maybe.withDefault (Maybe.withDefault "" (Dict.get "draft/revision" message.tags))

                conversation =
                    dmMutateBucket model target nick

                targetKey =
                    String.toLower conversation

                targetChannel =
                    Dict.get targetKey model.channels
            in
            if message.command /= "PRIVMSG"
                || model.connection /= Live
                || Dict.member "batch" message.tags
                || String.isEmpty originalId
                || Dict.get "msgid" message.tags /= Just originalId
                || revision /= "1"
            then
                Nothing

            else
                targetChannel
                    |> Maybe.andThen
                        (\channel ->
                            channel.messages
                                |> List.filter (\row -> row.msgid == Just originalId)
                                |> List.head
                                |> Maybe.andThen
                                    (\original ->
                                        if String.toLower original.from /= String.toLower nick || messageLocked original || original.deleted || original.redacted then
                                            Nothing

                                        else if original.body == body then
                                            Just ( model, conversation )

                                        else
                                            let
                                                messages =
                                                    List.map
                                                        (\row -> if row.msgid == Just originalId then { row | body = body, edited = True } else row)
                                                        channel.messages

                                                next =
                                                    { model
                                                        | channels = Dict.insert targetKey { channel | messages = messages } model.channels
                                                        , editHistory = recordEdit model.editHistory originalId original.body (rowTime model message)
                                                    }
                                            in
                                            Just ( next, conversation )
                                    )
                        )

        _ ->
            Nothing



persistRow : Model -> Wire.IrcMessage -> Maybe { target : String, rows : List VaultRow }
persistRow model parsed =
    case parsed.command of
        "PRIVMSG" ->
            persistChatRow model parsed

        "WHISPER" ->
            persistChatRow model parsed

        "NOTICE" ->
            persistChatRow model parsed

        _ ->
            Nothing


persistChatRow : Model -> Wire.IrcMessage -> Maybe { target : String, rows : List VaultRow }
persistChatRow model parsed =
    case parsed.params of
        target :: body :: _ ->
            let
                key =
                    String.toLower (dmFileBucket model target (Maybe.withDefault "" parsed.nick))

                row =
                    { id = key ++ ":" ++ String.fromInt (model.messageSeq - 1)
                    , wireMessageId = Dict.get "msgid" parsed.tags
                    , target = key
                    , from = Maybe.withDefault "" parsed.nick
                    , body = body
                    , at = rowTime model parsed
                    , rowType =
                        if parsed.command == "NOTICE" then
                            "notice"

                        else if parsed.command == "WHISPER" then
                            "whisper"

                        else
                            "msg"
                    , deleted = False
                    , redacted = False
                    , replyTo = Tuple.second (resolveInboundReply model key parsed body)
                    }
            in
            if Dict.member key model.channels then
                Just { target = key, rows = [ row ] }

            else
                Nothing

        _ ->
            Nothing


{-| Merge vault rows into a channel that has no live messages yet
(initial history load). Channels that already carry live traffic are
left alone so a late vault response can never clobber the live view.
`messageSeq` fast-forwards past the highest stored seq so freshly
folded ids stay unique.
-}
mergeVaultRows : Model -> String -> List VaultRow -> Model
mergeVaultRows model target rows =
    let
        key =
            String.toLower target
    in
    case Dict.get key model.channels of
        Nothing ->
            model

        Just channel ->
            if List.isEmpty channel.messages then
                let
                    toChat index row =
                        { id = index
                        , from = row.from
                        , body = row.body
                        , whisper = False
                        , audience = Nothing
                        , highlight = False
                        , outboxId = Nothing
                        , pending = False
                        , plaintext = Nothing
                        , at = row.at
                        , msgid = row.wireMessageId
                        , reactions = []
                        , edited = False
                        , deleted = row.deleted
                        , redacted = row.redacted
                        , replyTo = Maybe.map sanitizeReplyRef row.replyTo
                        , topic = ""
                        , msgType = row.rowType
                        }

                    stored =
                        List.map .id rows
                            |> List.filterMap (rowSeq key)
                            |> List.maximum
                            |> Maybe.withDefault -1

                    chats =
                        List.indexedMap toChat rows
                            |> List.reverse
                            |> List.take (messageRetentionFor model key)
                in
                updateChannel model key
                    (\c -> { c | messages = chats })
                    |> (\m -> { m | messageSeq = max m.messageSeq (stored + 1) })

            else
                model


rowSeq : String -> String -> Maybe Int
rowSeq key id =
    case String.split ":" id of
        _ :: seqPart :: [] ->
            if String.startsWith (key ++ ":") id then
                String.toInt seqPart

            else
                Nothing

        _ ->
            Nothing


{-| Vault ids already observed this session (persisted live lines plus
loaded windows, newest first, bounded). Time-travel windows dedupe
against these exactly like the oracle's id-keyed history merge. Live
rows enter the bounded dirty-target queue and persist from the current
buffer on Tick; an unseen window row is still history, never a live
duplicate.
-}
rememberVaultIds : Model -> List VaultRow -> Model
rememberVaultIds model rows =
    { model | vaultSeenIds = VaultSeenIds.remember (List.map .id rows) model.vaultSeenIds }


{-| Maximum live owner/target watermarks (mirrors
`VAULT_SYNC_TARGET_CACHE_CAP = 512`). -}
vaultSyncTargetCacheCap : Int
vaultSyncTargetCacheCap =
    512


vaultDirtyTargetsPerTick : Int
vaultDirtyTargetsPerTick =
    4


isWorkspaceMutation : RuntimeDomain.Action -> Bool
isWorkspaceMutation action =
    case action of
        RuntimeDomain.RememberWorkspace _ ->
            True

        RuntimeDomain.SelectWorkspace _ ->
            True

        RuntimeDomain.LockWorkspace ->
            True

        _ ->
            False


clearAllVaultDirtyTargets : Model -> Model
clearAllVaultDirtyTargets model =
    { model | vaultDirtyTargets = Dict.empty, vaultDirtyOrder = [] }


prepareVaultDirtyModel : Msg -> Model -> Model
prepareVaultDirtyModel msg model =
    let
        workspaceResultMatches =
            case msg of
                RuntimeDomainResultReceived result ->
                    result.domain == "workspace"
                        && List.member result.action [ "select", "lock", "remember" ]
                        && Maybe.withDefault False
                            (Maybe.map
                                (\stamp ->
                                    stamp.ownerRef == Ids.ownerRefToRuntime result.ownerRef
                                        && stamp.accountGeneration == Ids.accountGenerationToInt result.accountGeneration
                                        && stamp.connectionGeneration == Ids.connectionGenerationToInt result.connectionGeneration
                                )
                                model.runtimeOwnerStamp
                            )

                _ ->
                    False

        workspaceObservationMatches =
            case msg of
                RuntimeDomainObservationReceived observation ->
                    observation.domain == "workspace"
                        && Maybe.withDefault False
                            (Maybe.map
                                (\stamp ->
                                    stamp.ownerRef == observation.ownerRef
                                        && stamp.accountGeneration == observation.accountGeneration
                                        && stamp.connectionGeneration == observation.connectionGeneration
                                )
                                model.runtimeOwnerStamp
                            )
                        && observation.sequence > Maybe.withDefault 0 (Dict.get "workspace" model.runtimeDomainObservation)

                _ ->
                    False

        ownerChanged =
            case msg of
                RuntimeOwnerStateReceived stamp ->
                    model.runtimeOwnerStamp /= Just stamp

                _ ->
                    False

        workspaceAction =
            case msg of
                RuntimeDomainActionRequested action ->
                    isWorkspaceMutation action

                _ ->
                    False
    in
    if workspaceResultMatches || workspaceObservationMatches || ownerChanged || workspaceAction then
        clearAllVaultDirtyTargets model

    else
        model


clearVaultDirtyTarget : Model -> String -> Model
clearVaultDirtyTarget model target =
    let
        key =
            String.toLower target
    in
    { model
        | vaultDirtyTargets = Dict.remove key model.vaultDirtyTargets
        , vaultDirtyOrder = List.filter ((/=) key) model.vaultDirtyOrder
    }


markVaultDirty : Model -> String -> VaultDirtyOwner -> ( Model, List Outbound )
markVaultDirty model target stamp =
    let
        key =
            String.toLower target

        existing =
            Dict.get key model.vaultDirtyTargets

        base =
            if existing == Just stamp then
                model

            else if existing /= Nothing then
                clearVaultDirtyTarget model key

            else
                model
    in
    if Dict.member key base.vaultDirtyTargets then
        ( base, [] )

    else
        let
            ( available, overflowOut ) =
                if Dict.size base.vaultDirtyTargets < vaultSyncTargetCacheCap then
                    ( base, [] )

                else
                    case base.vaultDirtyOrder of
                        oldest :: _ ->
                            case Dict.get oldest base.vaultDirtyTargets of
                                Just oldStamp ->
                                    if base.runtimeOwnerStamp == Just oldStamp && Dict.member oldest base.channels then
                                        let
                                            ( flushed, outs ) =
                                                flushVaultBuffer base oldest
                                        in
                                        ( clearVaultDirtyTarget flushed oldest, outs )

                                    else
                                        ( clearVaultDirtyTarget base oldest, [] )

                                Nothing ->
                                    ( clearVaultDirtyTarget base oldest, [] )

                        [] ->
                            ( base, [] )

            marked =
                { available
                    | vaultDirtyTargets = Dict.insert key stamp available.vaultDirtyTargets
                    , vaultDirtyOrder = available.vaultDirtyOrder ++ [ key ]
                }
        in
        ( marked, overflowOut )


flushDirtyVaultTargets : Model -> ( Model, List Outbound )
flushDirtyVaultTargets model =
    let
        ( batch, remaining ) =
            List.take vaultDirtyTargetsPerTick model.vaultDirtyOrder
                |> (\targets -> ( targets, List.drop (List.length targets) model.vaultDirtyOrder ))

        detached =
            { model
                | vaultDirtyTargets = List.foldl Dict.remove model.vaultDirtyTargets batch
                , vaultDirtyOrder = remaining
            }

        flushOne target ( current, out ) =
            case Dict.get target model.vaultDirtyTargets of
                Just stamp ->
                    if current.runtimeOwnerStamp == Just stamp && Dict.member target current.channels then
                        let
                            ( flushed, flushOut ) =
                                flushVaultBuffer current target
                        in
                        ( flushed, out ++ flushOut )

                    else
                        ( current, out )

                Nothing ->
                    ( current, out )
    in
    if Maybe.withDefault False (Maybe.map isWorkspaceMutation model.runtimeDomainPendingAction) then
        ( model, [] )

    else
        List.foldl flushOne ( detached, [] ) batch


{-| Rows worth persisting (mirrors `persistableRows`: settled
conversation only — optimistic outbox placeholders never reach
the disk, or a stuck-pending ghost plus a duplicate of the
delivered line would survive every hydrate). -}
persistableVaultRows : List ChatMessage -> List ChatMessage
persistableVaultRows messages =
    List.filter (\m -> not m.pending && m.outboxId == Nothing) messages


{-| Exact 32-bit multiply (mirrors `Math.imul`): 16-bit halves
keep every partial product exact where Elm `*` would go float;
the high half adds (it overlaps the low half — OR would drop
carries) and the total wraps mod 2^32. -}
fnvMul : Int -> Int -> Int
fnvMul a b =
    let
        lo =
            Bitwise.and 0xFFFF a * Bitwise.and 0xFFFF b

        mid =
            modBy 65536
                (Bitwise.and 0xFFFF a * Bitwise.shiftRightZfBy 16 b + Bitwise.shiftRightZfBy 16 a * Bitwise.and 0xFFFF b)

        total =
            toFloat lo + toFloat mid * 65536.0
    in
    if total >= 4294967296.0 then
        round (total - 4294967296.0)

    else
        round total


{-| 32-bit FNV-1a mix step (`imul(xor(acc, code), prime)`). -}
fnvMix : Int -> Int -> Int
fnvMix acc code =
    fnvMul (Bitwise.xor acc code) 0x01000193


{-| Mix one string into an FNV-1a accumulator, iterating UTF-16
code units exactly like the oracle's `charCodeAt` loop (astral
characters mix their surrogate pair, never the code point). -}
fnvMixString : Int -> String -> Int
fnvMixString acc value =
    List.foldl fnvMixChar acc (String.toList value)


fnvMixChar : Char -> Int -> Int
fnvMixChar c acc =
    let
        code =
            Char.toCode c
    in
    if code < 0x10000 then
        fnvMix acc code

    else
        let
            sub =
                code - 0x10000
        in
        fnvMix (fnvMix acc (0xD800 + sub // 1024)) (0xDC00 + modBy 1024 sub)


{-| Content signature over the mutation-relevant fields of the
persistable rows (mirrors `bufferSignature`: id + text + edited /
deleted / redacted flags + reactions — a tail-id watermark alone
misses in-place edits, so the hash makes those mutations dirty the
watermark and become durable at rest; `len:base36` rendering). -}
vaultBufferSignature : List ChatMessage -> String
vaultBufferSignature rows =
    let
        mixRow m acc =
            let
                flags =
                    (if m.edited then 1 else 0)
                        + (if m.deleted then 2 else 0)
                        + (if m.redacted then 4 else 0)

                withFlags =
                    Bitwise.xor (fnvMul (fnvMixString (fnvMixString acc (String.fromInt m.id)) m.body) 0x01000193) flags
            in
            List.foldl
                (\r h ->
                    List.foldl (\u hh -> fnvMixString hh u) (fnvMixString h r.emoji) r.users
                )
                withFlags
                m.reactions

        hash =
            List.foldl mixRow -2128831035 rows
    in
    String.fromInt (List.length rows) ++ ":" ++ base36 hash


{-| Unsigned base-36 rendering (mirrors `h.toString(36)`; the
negative-to-unsigned lift is exact — 2^32 fits in a float). -}
base36 : Int -> String
base36 n =
    let
        digits =
            "0123456789abcdefghijklmnopqrstuvwxyz"

        unsigned =
            if n < 0 then
                n + 4294967296

            else
                n
    in
    if unsigned == 0 then
        "0"

    else
        base36Loop unsigned digits ""


base36Loop : Int -> String -> String -> String
base36Loop n digits acc =
    if n == 0 then
        acc

    else
        let
            quo =
                n // 36

            rem =
                n - quo * 36
        in
        base36Loop quo digits (String.slice rem (rem + 1) digits ++ acc)


{-| Project one buffer row to its vault row (`target:seq` id, raw
body — ciphertext for unopened envelopes, never plaintext — plus
the row type the export/import round-trip requires). -}
sanitizeReplyRef : ReplyRef -> ReplyRef
sanitizeReplyRef ref =
    { ref | text = sanitizePersistedReplyPreviewText ref.text }


chatToVaultRow : String -> ChatMessage -> VaultRow
chatToVaultRow target message =
    { id = target ++ ":" ++ String.fromInt message.id
    , wireMessageId = message.msgid
    , target = target
    , from = message.from
    , body = message.body
    , at = message.at
    , rowType = message.msgType
    , deleted = message.deleted
    , redacted = message.redacted
    , replyTo = Maybe.map sanitizeReplyRef message.replyTo
    }


{-| Flush the buffer a non-chat line may have mutated (reactions,
edits, redactions): resolve the bucket like the persist path and
let the signature gate decide. -}
flushVaultForMessage : Model -> Wire.IrcMessage -> ( Model, List Outbound )
flushVaultForMessage model message =
    case message.params of
        target :: _ ->
            let
                key =
                    String.toLower (dmFileBucket model target (Maybe.withDefault "" message.nick))
            in
            if Dict.member key model.channels then
                flushVaultBuffer model key

            else
                ( model, [] )

        [] ->
            ( model, [] )


{-| Flush one buffer to the vault when its content signature moved
(mirrors the `scheduleFlush` settle: unchanged signatures emit
nothing, so steady traffic coalesces instead of stampeding the
DB; the watermark map itself caps at 512 targets, oldest
dropped). -}
flushVaultBuffer : Model -> String -> ( Model, List Outbound )
flushVaultBuffer model target =
    let
        key =
            String.toLower target

        cleared =
            clearVaultDirtyTarget model key
    in
    case Dict.get key cleared.channels of
        Nothing ->
            ( cleared, [] )

        Just channel ->
            flushVaultBufferFor cleared key channel.messages


flushVaultBufferFor : Model -> String -> List ChatMessage -> ( Model, List Outbound )
flushVaultBufferFor model key messages =
    let
        settled =
            persistableVaultRows messages

        rows =
            List.map (chatToVaultRow key) settled

        sig =
            vaultBufferSignature settled
    in
    if Dict.get key model.vaultPersistSig == Just sig then
        ( model, [] )

    else
        let
            pruned =
                if Dict.member key model.vaultPersistSig || Dict.size model.vaultPersistSig < vaultSyncTargetCacheCap then
                    model

                else
                    case model.vaultPersistOrder of
                        oldest :: rest ->
                            { model
                                | vaultPersistSig = Dict.remove oldest model.vaultPersistSig
                                , vaultPersistOrder = rest
                            }

                        [] ->
                            model

            stored =
                { pruned
                    | vaultPersistSig = Dict.insert key sig pruned.vaultPersistSig
                    , vaultPersistOrder =
                        List.filter (\k -> k /= key) pruned.vaultPersistOrder ++ [ key ]
                }
        in
        ( rememberVaultIds stored rows, [ vaultPersistOutbound model key rows ] )


vaultPersistOutbound : Model -> String -> List VaultRow -> Outbound
vaultPersistOutbound model target rows =
    let fields = runtimeOwnerFields model in
    VaultPersist
        { target = target
        , rows = rows
        , ownerRef = fields.ownerRef
        , accountGeneration = fields.accountGeneration
        , connectionGeneration = fields.connectionGeneration
        }


runtimeOwnerFields : Model -> { ownerRef : Maybe String, accountGeneration : Maybe Int, connectionGeneration : Maybe Int }
runtimeOwnerFields model =
    case model.runtimeOwnerStamp of
        Just stamp ->
            { ownerRef = Just stamp.ownerRef
            , accountGeneration = Just stamp.accountGeneration
            , connectionGeneration = Just stamp.connectionGeneration
            }

        Nothing ->
            { ownerRef = Nothing, accountGeneration = Nothing, connectionGeneration = Nothing }


vaultFetchOutbound : Model -> String -> Int -> Outbound
vaultFetchOutbound model target limit =
    let fields = runtimeOwnerFields model in
    VaultFetch { target = target, limit = limit, ownerRef = fields.ownerRef, accountGeneration = fields.accountGeneration, connectionGeneration = fields.connectionGeneration }


vaultFetchAroundOutbound : Model -> String -> Int -> Int -> Outbound
vaultFetchAroundOutbound model target at limit =
    let fields = runtimeOwnerFields model in
    VaultFetchAround { target = target, at = at, limit = limit, ownerRef = fields.ownerRef, accountGeneration = fields.accountGeneration, connectionGeneration = fields.connectionGeneration }


{-| Nearest window row to a time-travel anchor: smallest clock
distance, ties breaking older-first — mirroring the oracle's
`loadAround` order (`|Δ|`, then time ascending).
-}
nearestRowId : Int -> List VaultRow -> Maybe String
nearestRowId anchor rows =
    List.sortBy (\row -> ( abs (row.at - anchor), row.at )) rows
        |> List.head
        |> Maybe.map .id


{-| Merge a time-travel window around an anchor moment. Fresh (unseen)
rows land oldest-first ahead of the live tail — every unseen row is
older history by the synchronous-persist invariant — and the nearest
row becomes the scroll landing. An empty window changes nothing except
the seen ledger, mirroring the oracle's early return. Channels the
client never joined stay untouched.
-}
mergeVaultAround : Model -> String -> Int -> List VaultRow -> Model
mergeVaultAround model target anchor rows =
    let
        key =
            String.toLower target

        seen =
            rememberVaultIds model rows
    in
    if List.isEmpty rows then
        seen

    else
        case Dict.get key seen.channels of
            Nothing ->
                seen

            Just channel ->
                let
                    fresh =
                        List.filter (\row -> not (VaultSeenIds.member row.id model.vaultSeenIds)) rows

                    toChat index row =
                        { id = index
                        , from = row.from
                        , body = row.body
                        , whisper = False
                        , audience = Nothing
                        , highlight = False
                        , outboxId = Nothing
                        , pending = False
                        , plaintext = Nothing
                        , at = row.at
                        , msgid = Nothing
                        , reactions = []
                        , edited = False
                        , deleted = row.deleted
                        , redacted = row.redacted
                        , replyTo = Maybe.map sanitizeReplyRef row.replyTo
                        , topic = ""
                        , msgType = row.rowType
                        }

                    freshChats =
                        List.indexedMap toChat fresh
                            |> List.reverse

                    merged =
                        List.indexedMap (\index chat -> { chat | id = index }) (channel.messages ++ freshChats)
                            |> List.take (messageRetentionFor seen key)

                    stored =
                        List.map .id rows
                            |> List.filterMap (rowSeq key)
                            |> List.maximum
                            |> Maybe.withDefault -1
                in
                updateChannel seen key
                    (\c -> { c | messages = merged })
                    |> (\m ->
                            { m
                                | messageSeq = max m.messageSeq (stored + 1)
                                , historyLanding = nearestRowId anchor rows
                            }
                       )


isLowerHex : Char -> Bool
isLowerHex char =
    (char >= '0' && char <= '9') || (char >= 'a' && char <= 'f')
