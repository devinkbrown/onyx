{-| One vault row. `id` is `lower-target ++ ":" ++ seq` where `seq` is
the `ChatMessage.id` assigned at fold time, so ids stay monotonic
across sessions without a clock: on load the model fast-forwards
`messageSeq` past the highest stored seq.
-}
type alias VaultRow =
    { id : String
    , wireMessageId : Maybe String
    , target : String
    , from : String
    , body : String
    , at : Int
    , rowType : String
    , deleted : Bool
    , redacted : Bool
    , replyTo : Maybe ReplyRef
    }


{-| One device-memory hit from another conversation (Elm port of the
oracle's `VaultSearchResult`: vault row id, sender, windowed text,
stamp, owning conversation). -}
type alias VaultHit =
    { id : String
    , from : String
    , text : String
    , at : Int
    , target : String
    }


{-| Async device-memory query lifecycle (mirrors `vaultStatus`:
idle/pending/done/error for accessible progress feedback). -}
type VaultSearchStatus
    = VaultSearchIdle
    | VaultSearchPending
    | VaultSearchDone
    | VaultSearchIncomplete
    | VaultSearchError


{-| Device-memory scan mode (mirroring `VaultSearchMode`): exact
substring, on-device semantic neighbors, or the RRF-fused hybrid. -}
type VaultSearchMode
    = ExactVaultSearch
    | SemanticVaultSearch
    | HybridVaultSearch


{-| Wire spelling for the mode (`exact` / `semantic` / `hybrid`). -}
vaultSearchModeToString : VaultSearchMode -> String
vaultSearchModeToString mode =
    case mode of
        ExactVaultSearch ->
            "exact"

        SemanticVaultSearch ->
            "semantic"

        HybridVaultSearch ->
            "hybrid"


{-| Parse a persisted or echoed mode (mirroring
`loadDefaultVaultSearchMode`: unknown reads as the hybrid default). -}
parseVaultSearchMode : String -> VaultSearchMode
parseVaultSearchMode raw =
    case raw of
        "exact" ->
            ExactVaultSearch

        "semantic" ->
            SemanticVaultSearch

        _ ->
            HybridVaultSearch


{-| In-search toggle order (mirroring `VAULT_MODE_CYCLE`). -}
cycleVaultSearchMode : VaultSearchMode -> VaultSearchMode
cycleVaultSearchMode mode =
    case mode of
        HybridVaultSearch ->
            ExactVaultSearch

        ExactVaultSearch ->
            SemanticVaultSearch

        SemanticVaultSearch ->
            HybridVaultSearch


{-| Proven device-history privacy for one DM target (mirroring
`VaultDmSearchPrivacy`): `plain` lets a server search run, `unknown`
withholds it while a proof scan runs, `encrypted` keeps the query off
the wire exactly like an E2EE designation. -}
type VaultDmPrivacy
    = DmPrivacyPlain
    | DmPrivacyUnknown
    | DmPrivacyEncrypted


{-| Wire spelling for the privacy proof (`plain` / `unknown` /
`encrypted`). -}
vaultDmPrivacyToString : VaultDmPrivacy -> String
vaultDmPrivacyToString privacy =
    case privacy of
        DmPrivacyPlain ->
            "plain"

        DmPrivacyUnknown ->
            "unknown"

        DmPrivacyEncrypted ->
            "encrypted"


{-| Parse a host-reported proof (mirroring the classifier commit:
anything unrecognized fails closed to unknown, never plain). -}
parseVaultDmPrivacy : String -> VaultDmPrivacy
parseVaultDmPrivacy raw =
    case String.toLower (String.trim raw) of
        "plain" ->
            DmPrivacyPlain

        "encrypted" ->
            DmPrivacyEncrypted

        _ ->
            DmPrivacyUnknown


{-| Proven privacy for a DM target (mirroring
`getVaultDmSearchPrivacy`: an unproven target reads unknown, so its
first server search triggers the proof scan instead of sending the
query). -}
vaultPrivacyFor : Model -> String -> VaultDmPrivacy
vaultPrivacyFor model target =
    Maybe.withDefault DmPrivacyUnknown
        (Dict.get (String.toLower target) model.vaultDmPrivacy)


{-| Commit a host proof scan (mirroring `commitVaultDmSearchPrivacy`:
the host only reports fresh scans, so the report replaces the entry;
a host-side write already reset the entry by dropping it). -}
foldVaultDmPrivacy : Model -> String -> String -> Model
foldVaultDmPrivacy model target raw =
    { model
        | vaultDmPrivacy =
            Dict.insert (String.toLower target) (parseVaultDmPrivacy raw) model.vaultDmPrivacy
    }


{-| Track a locally appended DM row against the proof (mirroring the
vault-write invalidation: any stored row voids a `plain` proof, and an
envelope row proves `encrypted` outright). -}
trackVaultDmPrivacy : Model -> String -> String -> Model
trackVaultDmPrivacy model target body =
    if isChannelName model target then
        model

    else if DmCipher.isEnvelope body || GroupEnvelope.isGroupEnvelope body then
        { model | vaultDmPrivacy = Dict.insert (String.toLower target) DmPrivacyEncrypted model.vaultDmPrivacy }

    else
        case vaultPrivacyFor model target of
            DmPrivacyPlain ->
                { model | vaultDmPrivacy = Dict.remove (String.toLower target) model.vaultDmPrivacy }

            _ ->
                model


{-| Project a validated import message onto the flat vault row. ms
epochs ride through as integral floats (the same shape the ports
`vaultRowAt` stamp produces), so `floor` round-trips. -}
importVaultRow : VaultImport.VaultImportMessage -> VaultRow
importVaultRow message =
    { id = message.id
    , wireMessageId = Nothing
    , target = message.target
    , from = message.from
    , body = message.body
    , at = floor message.atMs
    , rowType = message.msgType
    , deleted = False
    , redacted = False
    , replyTo = Nothing
    }


{-| One durable outbox row, mirrored from the ports-side store. `id`
is the `ob-…` store key; `queuedAt` is stamped ports-side
(`Date.now()`), mirroring `historyVault.queueOutbox`. -}
type alias OutboxEntry =
    { id : String
    , target : String
    , text : String
    , queuedAt : Float
    }


{-| Known roadmap priority states (`roadmap-<state>` anchors). -}
roadmapStates : List String
roadmapStates =
    [ "now", "next", "later" ]


{-| Roadmap priority from a URL fragment, mirroring
`roadmapPriorityFromHash` (tolerates a leading `#`). -}
priorityFromFragment : Maybe String -> Maybe String
priorityFromFragment fragment =
    case fragment of
        Nothing ->
            Nothing

        Just hash ->
            let
                value =
                    if String.startsWith "#" hash then
                        String.dropLeft 1 hash

                    else
                        hash
            in
            case List.filter (\state -> "roadmap-" ++ state == value) roadmapStates of
                state :: _ ->
                    Just state

                [] ->
                    Nothing


{-| Canonical origin for invite share links, mirroring
`currentOrigin` (`<origin>/invite/`). -}
inviteOrigin : Model -> String
inviteOrigin model =
    model.origin ++ "/invite/"


{-| The invite card for the current query, mirroring the route `card`
memo (`NETWORK_NAME` is `Onyx`). -}
inviteCard : Model -> Invite.InviteCard
inviteCard model =
    Invite.buildInviteCard model.inviteParams model.nowMs { network = "Onyx", origin = inviteOrigin model }


{-| Direct in-app join link for the current card + typed name,
mirroring the `joinHref` memo. -}
inviteJoinHref : Model -> String
inviteJoinHref model =
    let
        card =
            inviteCard model
    in
    -- The join spec carries only channel, name, moment, topic, and
    -- reader mode (inviter/faces stay on the share card).
    (Invite.buildInviteLink
        { channel = Maybe.withDefault "" card.channel
        , guestName = Invite.parseGuestName (Just model.inviteName)
        , at = card.at
        , topic = card.topic
        , reader = card.readerMode
        , inviter = Nothing
        , faces = []
        }
        { network = "Onyx", origin = inviteOrigin model, appOrigin = "/app/" }
        model.nowMs
    ).appHref


{-| Known OnyxOS method stage ids, in tab order. -}
onyxosStageIds : List String
onyxosStageIds =
    [ "oracle", "implementation", "gate", "boot" ]


{-| Step the method stage with wraparound, mirroring the arrow-key
branch of `onTabKeyDown` (`Home`/`End` jump to the ends; anything
else holds). Unknown current ids restart at the first stage
(mirroring the `?? stages[0]` fallback). -}
stepOnyxosStage : String -> String -> String
stepOnyxosStage current key =
    let
        index =
            case indexOf current onyxosStageIds of
                Just i ->
                    i

                Nothing ->
                    0

        last =
            List.length onyxosStageIds - 1

        at i =
            List.drop i onyxosStageIds |> List.head |> Maybe.withDefault "oracle"
    in
    case key of
        "ArrowRight" ->
            at (if index >= last then 0 else index + 1)

        "ArrowDown" ->
            at (if index >= last then 0 else index + 1)

        "ArrowLeft" ->
            at (if index <= 0 then last else index - 1)

        "ArrowUp" ->
            at (if index <= 0 then last else index - 1)

        "Home" ->
            at 0

        "End" ->
            at last

        _ ->
            current


indexOf : String -> List String -> Maybe Int
indexOf target items =
    let
        step item ( found, i ) =
            case found of
                Just _ ->
                    ( found, i + 1 )

                Nothing ->
                    if item == target then
                        ( Just i, i + 1 )

                    else
                        ( Nothing, i + 1 )
    in
    List.foldl step ( Nothing, 0 ) items |> Tuple.first


{-| Local text handoff for the current plan, mirroring
`roomStarterExport` (legacy call note reads with the guide wording). -}
guidesPlanExport : Model -> String
guidesPlanExport model =
    Guides.buildRoomStarterExport Guides.requiredSteps model.guidesCompleted
        |> String.replace Guides.legacyCallRecordingNote Guides.callRecordingNote


{-| Feed state for the status route: loading reads as checking
(mirroring `status.loading ? 'loading'`), otherwise the sample folds
against the clock. -}
statusFeedState : Model -> Status.FeedState
statusFeedState model =
    if model.statusLoading then
        Status.Loading

    else
        Status.feedState model.networkStatus model.nowMs


{-| Start (or restart) the status fetch at the first feed path. -}
requestStatus : Model -> ( Model, List Outbound )
requestStatus model =
    ( { model | statusLoading = True, statusPathAttempt = 0 }
    , [ HttpFetch
            { key = "network-status"
            , url = List.head Status.statusPaths |> Maybe.withDefault "/status.json"
            }
      ]
    )


{-| Theme apply target for one theme id: built-ins resolve to
themselves, customs to their base (mirroring `resolveTheme`'s
`dataTheme`); unknown ids fall back to the default (mirroring the
`normalizeThemeId ?? DEFAULT_THEME_ID` guard in `applyThemeToDom`).
-}
resolveThemeApply : String -> List ThemeLook.CustomThemeRef -> { dataTheme : String, scheme : String }
resolveThemeApply id customs =
    case ThemeLook.normalizeThemeId id customs of
        Just valid ->
            if ThemeLook.isCustomThemeId valid then
                let
                    base =
                        List.filter (\custom -> custom.id == valid) customs
                            |> List.head
                            |> Maybe.map .base
                            |> Maybe.withDefault ThemeLook.defaultThemeId
                in
                { dataTheme = base, scheme = ThemeLook.themeMeta |> List.filter (\meta -> meta.id == base) |> List.head |> Maybe.map .scheme |> Maybe.withDefault "dark" }

            else
                { dataTheme = valid, scheme = ThemeLook.themeMeta |> List.filter (\meta -> meta.id == valid) |> List.head |> Maybe.map .scheme |> Maybe.withDefault "dark" }

        Nothing ->
            { dataTheme = ThemeLook.defaultThemeId, scheme = "dark" }


{-| The full DOM application for the current appearance state
(mirroring `applyPreferences` plus `applyThemeToDom`: prefs attrs,
`data-theme`, effective `color-scheme`, and the full token-var
commit — base/custom tokens overlaid with the studio session
overrides).
-}
appearanceApplyFor : Model -> Outbound
appearanceApplyFor model =
    let
        prefs =
            model.prefs

        target =
            resolveThemeApply model.themeId model.customThemes
    in
    AppearanceApply
        { density = Prefs.densityToString prefs.density
        , fontScale = Prefs.fontScaleToString prefs.fontScale
        , hideEvents = prefs.hideEvents
        , width = Prefs.widthToString prefs.width
        , reader = prefs.readerMode
        , reduceMotion = prefs.reduceMotion
        , reduceTransparency = prefs.reduceTransparency
        , highContrast = prefs.highContrast
        , experienceMode = Prefs.experienceModeToString prefs.experienceMode
        , dataTheme = target.dataTheme
        , scheme = studioActiveScheme model
        , tokens = Dict.toList (studioResolvedTokens model)
        }


{-| Base token set for the active theme: a saved custom theme's base
overlaid with its saved overrides, else the built-in map
(mirroring the studio's `baseTokens`). -}
studioBaseTokens : Model -> Dict String String
studioBaseTokens model =
    case List.filter (\custom -> custom.id == model.themeId) model.studioCustoms |> List.head of
        Just custom ->
            Studio.customThemeTokens (ThemeTokens.tokensFor custom.base) custom

        Nothing ->
            ThemeTokens.tokensFor model.themeId


{-| Scheme of the active base (built-in or a custom theme's base). -}
studioBaseScheme : Model -> String
studioBaseScheme model =
    studioSchemeOf model model.themeId |> Maybe.withDefault "dark"


{-| Scheme for one theme id: customs resolve through their base. -}
studioSchemeOf : Model -> String -> Maybe String
studioSchemeOf model id =
    case List.filter (\custom -> custom.id == id) model.studioCustoms |> List.head of
        Just custom ->
            ThemeLook.themeMeta
                |> List.filter (\meta -> meta.id == custom.base)
                |> List.head
                |> Maybe.map .scheme

        Nothing ->
            ThemeLook.themeMeta
                |> List.filter (\meta -> meta.id == id)
                |> List.head
                |> Maybe.map .scheme


{-| Effective scheme: a generated palette's scheme wins over the
base's (mirroring `activeScheme`). -}
studioActiveScheme : Model -> String
studioActiveScheme model =
    Maybe.withDefault (studioBaseScheme model) model.studioSchemeOverride


{-| The palette as currently rendered: base overlaid with the
session overrides (mirroring `resolvedTokens`). -}
studioResolvedTokens : Model -> Dict String String
studioResolvedTokens model =
    Dict.union model.studioOverrides (studioBaseTokens model)


{-| Picker refs mirroring a validated customs list (storage order). -}
studioCustomRefs : List Studio.CustomTheme -> List ThemeLook.CustomThemeRef
studioCustomRefs customs =
    List.map (\custom -> { id = custom.id, name = custom.name, base = custom.base }) customs


{-| Storage JSON for a validated customs list. -}
encodeStudioCustoms : List Studio.CustomTheme -> String
encodeStudioCustoms customs =
    "[" ++ String.join "," (List.map Studio.encodeCustomTheme customs) ++ "]"


{-| Display label of the active theme for seed export
(`Custom` fallback, mirroring `activeThemeMeta`). -}
studioThemeLabel : Model -> String
studioThemeLabel model =
    case List.filter (\custom -> custom.id == model.themeId) model.studioCustoms |> List.head of
        Just custom ->
            custom.name

        Nothing ->
            ThemeLook.themeMeta
                |> List.filter (\meta -> meta.id == model.themeId)
                |> List.head
                |> Maybe.map .label
                |> Maybe.withDefault "Custom"


{-| The built-in base a save/export anchors on: a custom theme's
saved base, else the active id itself. -}
studioSaveBase : Model -> String
studioSaveBase model =
    if Studio.isCustomThemeId model.themeId then
        case List.filter (\custom -> custom.id == model.themeId) model.studioCustoms |> List.head of
            Just custom ->
                custom.base

            Nothing ->
                "ocean"

    else
        model.themeId


{-| Saved overrides folded into a save/export merge. -}
studioSavedOverrides : Model -> Dict String String
studioSavedOverrides model =
    case List.filter (\custom -> custom.id == model.themeId) model.studioCustoms |> List.head of
        Just custom ->
            custom.overrides

        Nothing ->
            Dict.empty


{-| Seed warnings as one import banner (`Nothing` when clean). -}
seedWarningsError : List String -> Maybe String
seedWarningsError warnings =
    if List.isEmpty warnings then
        Nothing

    else
        Just (String.join " " warnings)


{-| Reset the per-session studio state (mirroring the base-change
effect plus `resetFactoryState`): overrides clear, factory
disarms, copy/eye-dropper traffic settles. Saved customs, the
active theme, and the save draft survive — the oracle clears the
same signals on base change, not the save row.
-}
studioResetSession : Model -> Model
studioResetSession model =
    { model
        | studioOverrides = Dict.empty
        , studioSeed = Theme.defaultSeed
        , studioFactoryArmed = False
        , studioAdjust = Studio.adjustIdentity
        , studioAdjustBaseline = Nothing
        , studioSchemeOverride = Nothing
        , studioImportError = Nothing
        , studioExportBusy = False
        , studioSeedBusy = False
        , studioShareBusy = False
        , studioExportCopied = False
        , studioSeedCopied = False
        , studioShareCopied = False
        , studioExportRevertAt = Nothing
        , studioSeedRevertAt = Nothing
        , studioShareRevertAt = Nothing
        , studioCopyFailure = Nothing
        , studioSeedCopyFailure = Nothing
        , studioEyeDropperBusy = False
        , studioEyeDropperStatus = Nothing
    }


{-| Replace the override set with a generated map (mirroring
`generateNow`): diff against the base, anchor the scheme, arm the
factory, and drop any in-flight adjust session. -}
studioGenerate : Model -> Theme.PaletteSeed -> Model
studioGenerate model seed =
    let
        next =
            Studio.diffOverrides (studioBaseTokens model) (Theme.generatePalette seed)
    in
    { model
        | studioOverrides = next
        , studioSeed = seed
        , studioFactoryArmed = True
        , studioAdjust = Studio.adjustIdentity
        , studioAdjustBaseline = Nothing
        , studioSchemeOverride =
            if seed.scheme == studioBaseScheme model then
                Nothing

            else
                Just seed.scheme
    }


{-| Patch the factory seed; once armed, re-generate live
(mirroring `updateSeed` — the 120ms debounce lives in the
synchronous fold here: `generatePalette` is sub-millisecond, so
dragging a knob recomputes inline with no timer to leak).
-}
studioPatchSeed : Model -> (Theme.PaletteSeed -> Theme.PaletteSeed) -> Model
studioPatchSeed model patch =
    let
        next =
            patch model.studioSeed
    in
    if model.studioFactoryArmed then
        studioGenerate { model | studioSeed = next } next

    else
        { model | studioSeed = next }


{-| Outbound for a seed-knob turn: the DOM apply only rides
live re-generation (mirroring `updateSeed` — pre-arm turns just
move the seed signal). -}
studioSeedOut : Model -> List Outbound
studioSeedOut updated =
    if updated.studioFactoryArmed then
        [ appearanceApplyFor updated ]

    else
        []


{-| Seed field names the studio knobs write. -}
seedFieldNames : List String
seedFieldNames =
    [ "primaryHue", "accentHue", "depth", "vibrancy", "warmth", "contrast" ]
studioSeedField : String -> Float -> Theme.PaletteSeed -> Theme.PaletteSeed
studioSeedField field value seed =
    case field of
        "primaryHue" ->
            { seed | primaryHue = value }

        "accentHue" ->
            { seed | accentHue = value }

        "depth" ->
            { seed | depth = value }

        "vibrancy" ->
            { seed | vibrancy = value }

        "warmth" ->
            { seed | warmth = value }

        "contrast" ->
            { seed | contrast = value }

        _ ->
            seed


{-| Adjust field names the transform knobs write. -}
studioAdjustField : String -> Float -> Studio.AdjustState -> Studio.AdjustState
studioAdjustField field value adjust =
    case field of
        "hueShift" ->
            { adjust | hueShift = value }

        "saturation" ->
            { adjust | saturation = value }

        "warmth" ->
            { adjust | warmth = value }

        "contrast" ->
            { adjust | contrast = value }

        _ ->
            adjust


{-| Apply an adjust patch composing from the drag-start baseline
(mirroring `applyAdjustPatch`): identity restores the baseline
exactly, otherwise the transform runs over the baseline palette. -}
studioApplyAdjust : Model -> Studio.AdjustState -> Model
studioApplyAdjust model next =
    case model.studioAdjustBaseline of
        Nothing ->
            { model | studioAdjust = next }

        Just baseline ->
            if Studio.isAdjustIdentity next then
                { model | studioAdjust = next, studioOverrides = baseline.overrides }

            else
                let
                    transform =
                        { hueShift = next.hueShift
                        , saturation = Just next.saturation
                        , warmth = next.warmth
                        , contrast = next.contrast
                        }
                in
                { model
                    | studioAdjust = next
                    , studioOverrides =
                        Studio.diffOverrides (studioBaseTokens model)
                            (Theme.adjustPalette baseline.resolved transform (studioActiveScheme model))
                }


{-| Millis → `YYYY-MM-DDTHH:MM:SS.mmmZ` (the export `exported`
stamp; the clock arrives as `nowMs`, so the fold formats it).
-}
millisToIso : Float -> String
millisToIso nowMs =
    let
        millis =
            modBy 1000 (round nowMs)

        days =
            floor (nowMs / 86400000)

        secsOfDay =
            modBy 86400 (floor (nowMs / 1000))

        ( year, month, day ) =
            civilFromDays (days + 719468)

        hour =
            secsOfDay // 3600

        minute =
            modBy 60 (secsOfDay // 60)

        second =
            modBy 60 secsOfDay

        pad2 n =
            if n < 10 then
                "0" ++ String.fromInt n

            else
                String.fromInt n

        pad3 n =
            if n < 10 then
                "00" ++ String.fromInt n

            else if n < 100 then
                "0" ++ String.fromInt n

            else
                String.fromInt n
    in
    String.fromInt year ++ "-" ++ pad2 month ++ "-" ++ pad2 day ++ "T" ++ pad2 hour ++ ":" ++ pad2 minute ++ ":" ++ pad2 second ++ "." ++ pad3 millis ++ "Z"


{-| `HH:MM` clock label for a row stamp, UTC — mirrors the oracle's
24-hour `fmtTime` branch (`toTimeString().slice(0, 5)`). Narrowing: the
oracle renders the *local* zone (and honors a 12-hour preference);
`formatRowClock` takes the `Time.here` zone with the `clock`
preference while `formatClockUtc` stays the UTC 24-hour primitive. -}
formatClockUtc : Int -> String
formatClockUtc at =
    let
        -- `floor` division like `millisToIso` (never `//`: the runtime
        -- truncates quotients to 32 bits, which wraps full-ms stamps).
        secsOfDay =
            modBy 86400 (floor (toFloat at / 1000))

        pad2 n =
            String.padLeft 2 '0' (String.fromInt n)
    in
    pad2 (secsOfDay // 3600) ++ ":" ++ pad2 (modBy 60 (secsOfDay // 60))


{-| Message/room-activity clock (mirrors `fmtTime`): the local zone
with a 12-hour shape (`h:MM AM/PM`) or 24-hour `HH:MM` per the
`clock` preference. -}
formatRowClock : Time.Zone -> Prefs.Clock -> Int -> String
formatRowClock zone clock at =
    let
        posix =
            Time.millisToPosix at

        hour =
            Time.toHour zone posix

        minute =
            Time.toMinute zone posix

        pad2 n =
            String.padLeft 2 '0' (String.fromInt n)
    in
    case clock of
        Prefs.Clock24h ->
            pad2 hour ++ ":" ++ pad2 minute

        Prefs.Clock12h ->
            let
                twelve =
                    case modBy 12 hour of
                        0 ->
                            12

                        h ->
                            h
            in
            String.fromInt twelve ++ ":" ++ pad2 minute ++ (if hour < 12 then " AM" else " PM")


{-| Compact send-time label for the sheet (mirroring
`formatRelative`: `just now`, `in 3m/2h/5d`, bare past `3m/2h/5d`).
At and beyond a week the oracle renders a locale calendar date; Elm
has no local-zone clock without an effectful lookup, so the fallback
is a UTC `Mar 4` / `Mar 4, 2027` date instead — the same UTC
convention the thread timestamps already use, with the year break in
UTC rather than local time. Divisions stay `floor`-over-`Float`
(never `//`: the runtime truncates quotients to 32 bits, which wraps
full-ms stamps). -}
scheduleSendLabel : Int -> Int -> String
scheduleSendLabel sendAt nowMs =
    let
        delta =
            sendAt - nowMs

        absDelta =
            abs delta
    in
    if absDelta < 45 * 1000 then
        "just now"

    else if absDelta >= 7 * 24 * 60 * 60 * 1000 then
        scheduleUtcDate sendAt nowMs

    else
        let
            compact =
                if absDelta < 60 * 60 * 1000 then
                    String.fromInt (max 1 (floor (toFloat absDelta / 60000))) ++ "m"

                else if absDelta < 24 * 60 * 60 * 1000 then
                    String.fromInt (floor (toFloat absDelta / 3600000)) ++ "h"

                else
                    String.fromInt (floor (toFloat absDelta / 86400000)) ++ "d"
        in
        if delta > 0 then
            "in " ++ compact

        else
            compact


{-| UTC `Mar 4` / `Mar 4, 2027` fallback for far-future send times
(see `scheduleSendLabel` for the narrowing note). -}
scheduleUtcDate : Int -> Int -> String
scheduleUtcDate sendAt nowMs =
    let
        dayNumber at =
            floor (toFloat at / 86400000) + 719468

        ( year, month, day ) =
            civilFromDays (dayNumber sendAt)

        ( nowYear, _, _ ) =
            civilFromDays (dayNumber nowMs)
    in
    scheduleMonthAbbrev month ++ " " ++ String.fromInt day ++ (if year /= nowYear then ", " ++ String.fromInt year else "")


{-| English month abbreviations for the UTC date fallback. -}
scheduleMonthAbbrev : Int -> String
scheduleMonthAbbrev month =
    case month of
        1 ->
            "Jan"

        2 ->
            "Feb"

        3 ->
            "Mar"

        4 ->
            "Apr"

        5 ->
            "May"

        6 ->
            "Jun"

        7 ->
            "Jul"

        8 ->
            "Aug"

        9 ->
            "Sep"

        10 ->
            "Oct"

        11 ->
            "Nov"

        12 ->
            "Dec"

        _ ->
            ""


{-| Days-since-civil → Gregorian date (Howard Hinnant's algorithm,
`days + 719468` shifts Unix epoch to the civil epoch). -}
civilFromDays : Int -> ( Int, Int, Int )
civilFromDays z =
    let
        era =
            (if z >= 0 then
                z

             else
                z - 146096
            )
                // 146097

        doe =
            z - era * 146097

        yoe =
            (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365

        y =
            yoe + era * 400

        doy =
            doe - (365 * yoe + yoe // 4 - yoe // 100)

        mp =
            (5 * doy + 2) // 153

        d =
            doy - (153 * mp + 2) // 5 + 1

        m =
            if mp < 10 then
                mp + 3

            else
                mp - 9
    in
    ( if m <= 2 then
        y + 1

      else
        y
    , m
    , d
    )


{-| Move one step inside a radio group (mirroring `moveRadioGroup`
index math): arrows wrap, Home/End jump, anything else stays silent.
-}
radioTarget : List String -> String -> String -> Maybe String
radioTarget ids current key =
    case List.head (List.indexedMap (\index id -> ( index, id )) ids |> List.filter (\( _, id ) -> id == current)) of
        Nothing ->
            Nothing

        Just ( index, _ ) ->
            let
                count =
                    List.length ids

                step =
                    if key == "ArrowLeft" || key == "ArrowUp" then
                        -1

                    else if key == "ArrowRight" || key == "ArrowDown" then
                        1

                    else
                        0
            in
            if key == "Home" then
                List.head ids

            else if key == "End" then
                List.head (List.reverse ids)

            else if step == 0 || count == 0 then
                Nothing

            else
                List.drop (modBy count (index + step + count)) ids |> List.head


{-| Preference key for an appearance radio value (font scales and
densities are the only preference radios on the page).
-}
prefKeyForValue : String -> String
prefKeyForValue value =
    if Prefs.fontScaleFromString value /= Nothing then
        "fontScale"

    else
        "density"


{-| Staged background differs from the stored one (mirroring `dirty`).
-}
backgroundDirty : Model -> Bool
backgroundDirty model =
    model.backgroundCandidate /= model.backgroundId


{-| The background id to render: the live preview wins, else the
staged candidate (mirroring `renderedBackground`).
-}
renderedBackground : Model -> String
renderedBackground model =
    ThemeLook.resolveBackgroundId
        (Maybe.withDefault model.backgroundCandidate model.backgroundPreview)
        model.themeId
        model.customThemes


{-| Motion override while staging with scenes off (mirroring
`previewMotion`): still the scene while the choice is unsettled.
-}
appearancePreviewMotion : Model -> Maybe String
appearancePreviewMotion model =
    if model.sceneMotion == Prefs.SceneOff && (model.backgroundPreview /= Nothing || backgroundDirty model) then
        Just "still"

    else
        Nothing


{-| Start (or restart) the stats index fetch. On navigation the
previous export clears (mirroring the resource remount); on poll and
manual refresh the last good sample stays visible while the next one
loads, never inventing activity.
-}
requestStatsIndex : Bool -> Model -> ( Model, List Outbound )
requestStatsIndex fresh model =
    let
        cleared =
            if fresh then
                { model
                    | statsIndex = Nothing
                    , statsDetail = Nothing
                    , statsDetailRequested = ""
                }

            else
                model
    in
    ( { cleared | statsLoading = True }
    , [ HttpFetch { key = "stats-index", url = Stats.statsIndexUrl } ]
    )


{-| Fetch one room's detail file (mirroring `fetchChannelDetail`): an
empty or unsluggable room fetches nothing and reads unavailable.
-}
requestStatsDetailFor : Model -> String -> ( Model, List Outbound )
requestStatsDetailFor model room =
    case Stats.channelDetailUrl room of
        Nothing ->
            ( { model | statsDetailLoading = False }, [] )

        Just url ->
            let
                slug =
                    Stats.channelToSlug room
            in
            ( { model | statsDetailLoading = True, statsDetailRequested = room }
            , [ HttpFetch { key = "stats-detail-" ++ slug, url = url } ]
            )


{-| The room the inspector follows: the explicit `?room=` selection,
else the busiest indexed room (mirroring `inspectedChannel`).
-}
statsInspectedChannel : Model -> String
statsInspectedChannel model =
    if not (String.isEmpty model.statsInspected) then
        model.statsInspected

    else
        case model.statsIndex of
            Nothing ->
                ""

            Just index ->
                Stats.busiestChannel index.channels
                    |> Maybe.map .channel
                    |> Maybe.withDefault ""


{-| The detail document to paint: only the one matching the followed
room (mirroring `matchingChannelDetail` — never another room's detail
while the new selection loads or fails).
-}
statsMatchingDetail : Model -> Maybe Stats.ChannelDetail
statsMatchingDetail model =
    let
        room =
            statsInspectedChannel model
    in
    case ( model.statsDetail, String.isEmpty room ) of
        ( Just detail, False ) ->
            if String.toLower detail.channel == String.toLower room then
                Just detail

            else
                Nothing

        _ ->
            Nothing


{-| True while the followed room has no matching detail yet (either
loading or transitional on a stale document).
-}
statsInspectorAwaiting : Model -> Bool
statsInspectorAwaiting model =
    let
        room =
            statsInspectedChannel model
    in
    if String.isEmpty room || statsMatchingDetail model /= Nothing then
        False

    else if model.statsDetailLoading then
        True

    else
        case model.statsDetail of
            Just stale ->
                String.toLower stale.channel /= String.toLower room

            Nothing ->
                                                False


{-| Feed state for the stats route against the clock.
-}
statsFeedState : Model -> Stats.FeedState
statsFeedState model =
    Stats.feedStateAt model.statsIndex model.statsLoading model.nowMs


{-| Shareable comparison URL (mirroring `comparisonShareHref`): empty
until two valid rooms serialize. The room and non-default window ride
along so the link reproduces the view.
-}
statsShareHref : Model -> String
statsShareHref model =
    let
        serialized =
            Stats.statsCompareQuery model.statsCompare
    in
    if String.isEmpty serialized then
        ""

    else
        let
            params =
                [ if String.isEmpty model.statsInspected then
                    Nothing

                  else
                    Just ("room=" ++ Url.percentEncode model.statsInspected)
                , Just ("compare=" ++ compareParam model.statsCompare)
                , if model.statsWindow == 14 then
                    Nothing

                  else
                    Just ("window=" ++ String.fromInt model.statsWindow)
                ]
                    |> List.filterMap identity
                    |> String.join "&"
        in
        model.origin ++ "/stats/?" ++ params


{-| The `compare` query value: each room encodes alone and commas stay
raw, mirroring `URLSearchParams.set('compare', rooms.join(','))`
(which never escapes `,`).
-}
compareParam : List String -> String
compareParam rooms =
    List.map Url.percentEncode (Stats.statsCompareQuery rooms |> String.split ",")
        |> String.join ","


{-| Stats page URL for `history.replaceState` after a room, compare,
or window change (mirroring the route's URL mutations, which never
navigate).
-}
statsPageUrl : Model -> String
statsPageUrl model =
    let
        params =
            [ if String.isEmpty model.statsInspected then
                Nothing

              else
                Just ("room=" ++ Url.percentEncode model.statsInspected)
            , let
                serialized =
                    Stats.statsCompareQuery model.statsCompare
              in
              if String.isEmpty serialized then
                Nothing

              else
                Just ("compare=" ++ compareParam model.statsCompare)
            , if model.statsWindow == 14 then
                Nothing

              else
                Just ("window=" ++ String.fromInt model.statsWindow)
            ]
                |> List.filterMap identity
    in
    case params of
        [] ->
            "/stats/"

        _ ->
            "/stats/?" ++ String.join "&" params


{-| Start (or restart) the download catalog fetch, mirroring the route
`loadCatalog` resource mount: catalog, sidecar, and copy state reset
so a revisit re-verifies instead of showing stale lanes.
-}
requestDownloadCatalog : Model -> ( Model, List Outbound )
requestDownloadCatalog model =
    ( { model
        | downloadCatalog = Nothing
        , downloadCatalogLoading = True
        , downloadShas = Dict.empty
        , downloadShaPending = []
        , downloadCopies = Dict.empty
      }
    , [ HttpFetch { key = "download-catalog", url = Download.downloadCatalogUrl } ]
    )


{-| Catalog load state for the download route, mirroring the oracle
`catalogState` (`loading` / `ready` / `errored`).
-}
downloadCatalogState : Model -> Download.CatalogState
downloadCatalogState model =
    if model.downloadCatalogLoading then
        Download.CatalogLoading

    else
        case model.downloadCatalog of
            Just _ ->
                Download.CatalogReady

            Nothing ->
                Download.CatalogErrored


{-| Availability of one lane id for the download route.
-}
downloadAvailabilityFor : Model -> String -> Download.Availability
downloadAvailabilityFor model lane =
    Download.downloadAvailability model.downloadCatalog (downloadCatalogState model) lane


{-| Published SHA-256 for one lane id: the sidecar fetch wins, the
catalog checksum is the fallback (mirroring `shaFromFile() ??
checksumFromCatalog(...)`).
-}
downloadShaFor : Model -> String -> Maybe String
downloadShaFor model lane =
    case Dict.get lane model.downloadShas of
        Just hash ->
            Just hash

        Nothing ->
            Download.checksumFromCatalog model.downloadCatalog lane


{-| True while a lane's `.sha256` sidecar fetch is still in flight.
-}
downloadShaLoading : Model -> String -> Bool
downloadShaLoading model lane =
    List.member lane model.downloadShaPending


{-| Copy-button state for one download copy key (`hash-<lane>` /
`install-<lane>`); unknown keys read idle.
-}
downloadCopyState : Model -> String -> DownloadCopy
downloadCopyState model key =
    Dict.get key model.downloadCopies |> Maybe.withDefault DlCopyIdle


{-| Studio copy-button result: success stamps the 2200ms revert
deadline, failure sticks the footer message. A stale result for a
non-busy button is ignored (mirroring the epoch guards). -}
studioCopyResult : Model -> String -> Bool -> ( Model, List Outbound )
studioCopyResult model which ok =
    let
        failureCopy =
            "Theme export copy failed. Clipboard access may be blocked in this browser."
    in
    if which == "export" then
        if not model.studioExportBusy then
            ( model, [] )

        else if ok then
            ( { model | studioExportBusy = False, studioExportCopied = True, studioExportRevertAt = Just (model.nowMs + 2200), studioCopyFailure = Nothing }, [] )

        else
            ( { model | studioExportBusy = False, studioCopyFailure = Just failureCopy }, [] )

    else if which == "seed" then
        if not model.studioSeedBusy then
            ( model, [] )

        else if ok then
            ( { model | studioSeedBusy = False, studioSeedCopied = True, studioSeedRevertAt = Just (model.nowMs + 2200), studioSeedCopyFailure = Nothing }, [] )

        else
            ( { model | studioSeedBusy = False, studioSeedCopyFailure = Just "Theme seed copy failed. Clipboard access may be blocked in this browser." }, [] )

    else if model.studioShareBusy then
        if ok then
            ( { model | studioShareBusy = False, studioShareCopied = True, studioShareRevertAt = Just (model.nowMs + 2200), studioCopyFailure = Nothing }, [] )

        else
            ( { model | studioShareBusy = False, studioCopyFailure = Just "Theme share-link copy failed. Clipboard access may be blocked in this browser." }, [] )

    else
        ( model, [] )


{-| Keep a studio `copied` flag only while its 2200ms revert
deadline stands (mirroring the per-button copy timers). -}
studioCopyKept : Model -> Maybe Float -> Bool -> Bool
studioCopyKept model revertAt copied =
    case revertAt of
        Just deadline ->
            copied && deadline > model.nowMs

        Nothing ->
            False


{-| Drop an elapsed studio revert deadline. -}
studioRevertKept : Model -> Maybe Float -> Maybe Float
studioRevertKept model revertAt =
    case revertAt of
        Just deadline ->
            if deadline > model.nowMs then
                revertAt

            else
                Nothing

        Nothing ->
            Nothing


{-| Revert expired `copied` buttons back to idle (the oracle's 1600ms
timer); failed buttons stick until the next click.
-}
downloadCopiesReverted : Model -> Dict String DownloadCopy
downloadCopiesReverted model =
    Dict.filter
        (\_ copy ->
            case copy of
                DlCopyCopied revertAt ->
                    revertAt > model.nowMs

                _ ->
                    True
        )
        model.downloadCopies


{-| Clipboard text for one download copy key. `Nothing` for unknown
keys or a hash button whose hash is not published — forged events
never reach the clipboard.
-}
downloadCopyForKey : Model -> String -> Maybe String
downloadCopyForKey model key =
    if String.startsWith "install-" key then
        let
            lane =
                String.dropLeft 8 key
        in
        Download.downloadCards
            |> List.filter (\c -> Download.activeLaneId c.lane == lane)
            |> List.head
            |> Maybe.map (\c -> String.join "\n" (Download.installSteps c.lane))

    else if String.startsWith "hash-" key then
        downloadShaFor model (String.dropLeft 5 key)

    else
        Nothing


{-| Copy-button result for the download page: success stamps the
1600ms revert deadline, failure sticks.
-}
downloadCopyResult : Bool -> Float -> DownloadCopy
downloadCopyResult ok nowMs =
    if ok then
        DlCopyCopied (nowMs + 1600)

    else
        DlCopyFailed


{-| True for the `/install` alias path (mirroring the oracle
`installGuide` pathname check — same page, different kicker).
-}
isInstallPath : String -> Bool
isInstallPath path =
    path == "/install" || path == "/install/" || String.startsWith "/install/" path


{-| Sign-in variant of the join link, mirroring `signInHref`. -}
inviteSignInHref : Model -> String
inviteSignInHref model =
    let
        href =
            inviteJoinHref model
    in
    if String.contains "?" href then
        href ++ "&signin=1"

    else
        href ++ "?signin=1"


