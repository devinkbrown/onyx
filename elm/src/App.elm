            -- A busy sheet refuses dismiss (backdrop/Escape/close),
            -- mirroring the Sheet guard; an idle close keeps drafts
            -- (only the phase relaxes) so reopening resumes typing.
            if isGuestClaimBusy model then
                ( model, [] )

            else
                ( { model | guestClaimOpen = False, guestClaimPhase = ClaimIdle }, [] )

