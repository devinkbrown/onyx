{-| Structured verdict of the last account-command failure
(`IDENTIFY` via 464 or terminal `FAIL`/`WARN`), mirroring the oracle
`accountActionError` — the payload a claim prompt reads to leave its
`identifying` state without disconnecting.
-}
type alias AccountActionError =
    { command : String
    , code : String
    , description : String
    }


{-| In-flight optimistic send awaiting its labeled server reply (echo,
ACK, or FAIL) — Elm port of the oracle's `PendingLabeledSend`. `seq`
is the mint counter at registration so eviction drops the oldest
first; the registry itself is unordered. Sealed DM/room sends never
register here (they resolve through their envelope transports), so no
plaintext travels with the entry.
-}
type alias PendingLabeledSend =
    { messageIds : List Int
    , target : String
    , targetKey : String
    , text : String
    , seq : Int
    }


{-| What the view renders for a message: decrypted plaintext when we
hold it, the locked placeholder for unopened envelopes (which also
covers vault-replayed ciphertext), otherwise the raw body. The vault
only ever sees `body`, so E2EE persistence stays ciphertext-only.
-}
deletedPlaceholder : String
deletedPlaceholder =
    "[message deleted]"


{-| Body stored on a REDACTED row (capital-M wire copy, mirroring the
oracle fold; rendering lowercases it via `deletedPlaceholder`). -}
redactedBody : String
redactedBody =
    "[Message deleted]"


{-| The text a row shows. v3/gap-commands: a CTCP ACTION wrapper
(`\x01ACTION waves\x01`, e.g. a sealed `/me` opened from its envelope)
shows its action text only — the row view adds the `* nick` lead. -}
displayBody : ChatMessage -> String
displayBody message =
    let
        raw =
            rawDisplayBody message
    in
    case ctcpActionText raw of
        Just action ->
            action

        Nothing ->
            raw


rawDisplayBody : ChatMessage -> String
rawDisplayBody message =
    if message.redacted || message.deleted then
        deletedPlaceholder

    else if GroupEnvelope.isGroupEnvelope message.body then
        GroupEnvelope.groupMessageDisplayText message.body message.plaintext

    else
        case message.plaintext of
            Just plain ->
                plain

            Nothing ->
                if DmCipher.isEnvelope message.body then
                    DmCipher.lockedPlaceholder

                else
                    message.body


{-| True for an unopened envelope: ciphertext held, no plaintext yet.
-}
messageLocked : ChatMessage -> Bool
messageLocked message =
    message.plaintext
        == Nothing
        && (DmCipher.isEnvelope message.body || GroupEnvelope.isGroupEnvelope message.body)


