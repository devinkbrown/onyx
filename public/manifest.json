{
  "name": "Onyx",
  "short_name": "Onyx",
  "description": "Open rooms, local-first memory, encrypted media, and live Onyx mesh telemetry.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "orientation": "any",
  "background_color": "#000306",
  "theme_color": "#000306",
  "categories": ["social", "productivity", "utilities"],
  "shortcuts": [
    {
      "name": "Open Onyx",
      "short_name": "Chat",
      "description": "Open the Onyx app.",
      "url": "/app"
    },
    {
      "name": "Network status",
      "short_name": "Status",
      "description": "View live mesh node and backup status.",
      "url": "/status"
    },
    {
      "name": "Channel stats",
      "short_name": "Stats",
      "description": "View public channel rhythm and activity.",
      "url": "/stats"
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/app-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Onyx desktop connect screen"
    },
    {
      "src": "/screenshots/app-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Onyx mobile connect screen"
    }
  ]
}
