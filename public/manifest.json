{
  "name": "Onyx",
  "short_name": "Onyx",
  "description": "Rooms, messages, and calls for your people. Open in the browser or keep it on this device.",
  "id": "/app",
  "start_url": "/app/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "orientation": "any",
  "background_color": "#05070a",
  "theme_color": "#05070a",
  "categories": ["social", "productivity", "utilities"],
  "shortcuts": [
    {
      "name": "Open Onyx",
      "short_name": "Chat",
      "description": "Open the Onyx app.",
      "url": "/app/"
    },
    {
      "name": "Network status",
      "short_name": "Status",
      "description": "Check whether Onyx is up.",
      "url": "/status/"
    },
    {
      "name": "House rules",
      "short_name": "Rules",
      "description": "How we treat each other in the rooms.",
      "url": "/guidelines/"
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/app-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Onyx desktop room"
    },
    {
      "src": "/screenshots/app-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Onyx mobile chat"
    }
  ]
}
