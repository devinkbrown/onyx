{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "noEmit": true
  },
  "include": [
    "vitest.setup.ts",
    "vitest.config.ts",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "lib/**/*.ts",
    "hooks/**/*.ts",
    "components/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
