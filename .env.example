# Vite exposes only variables prefixed with VITE_.
# Copy this file to .env.local and restart Vite after editing it.

# Optional: pin the client to one Onyx Server WebSocket endpoint.
# Leave unset to probe the node registry in src/app/nodes.ts.
VITE_IRC_WS=

# Reserved for a future/default-channel entry surface; currently not read.
VITE_DEFAULT_CHANNEL=

# Optional media upload base. Leave unset for same-origin /upload in a
# first-party production build. The endpoint accepts multipart field `file`.
VITE_MEDIA_URL=
